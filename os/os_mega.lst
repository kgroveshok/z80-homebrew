132d			if MALLOC_3 
132d			; https://gist.githubusercontent.com/tomstorey/947a8b084bad69391a4b2a1c5b6d69ca/raw/5a08fb30a480d98c0deb4a6afe2d48961cc8e9d9/z80_malloc.s 
132d			;heap_start        .equ  0x9000      ; Starting address of heap 
132d			;heap_size         .equ  0x0100      ; Number of bytes available in heap 
132d			; 
132d			 ;     .org 0 
132d			  ;    jp    main 
132d			; 
132d			; 
132d			 ;     .org  0x100 
132d			;main: 
132d			 ;     ld    HL, 0x8100 
132d			  ;    ld    SP, HL 
132d			; 
132d			;      call  heap_init 
132d			 
132d			      ; Make some allocations 
132d			;      ld    HL, 12 
132d			;      call  malloc            ; Allocates 0x9004 
132d			; 
132d			 ;     ld    HL, 12 
132d			;      call  malloc            ; Allocates 0x9014 
132d			 
132d			;      ld    HL, 12 
132d			;      call  malloc            ; Allocates 0x9024 
132d			 
132d			      ; Free some allocations 
132d			;      ld    HL, 0x9014 
132d			;      call  free 
132d			 
132d			;      ld    HL, 0x9004 
132d			;      call  free 
132d			; 
132d			;      ld    HL, 0x9024 
132d			;      call  free 
132d			 
132d			 
132d			 ;     halt 
132d			 
132d			 
132d			;------------------------------------------------------------------------------ 
132d			;     heap_init                                                               : 
132d			;                                                                             : 
132d			; Description                                                                 : 
132d			;     Initialise the heap and make it ready for malloc and free operations.   : 
132d			;                                                                             : 
132d			;     The heap is maintained as a linked list, starting with an initial       : 
132d			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
132d			;     the first free block in the heap. Each block then points to the next    : 
132d			;     free block within the heap, and the free list ends at the first block   : 
132d			;     with a null pointer to the next free block.                             : 
132d			;                                                                             : 
132d			; Parameters                                                                  : 
132d			;     Inputs are compile-time only. Two defines which specify the starting    : 
132d			;     address of the heap and its size are required, along with a memory      : 
132d			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
132d			;     principally stores a pointer to the first free block in the heap.       : 
132d			;                                                                             : 
132d			; Returns                                                                     : 
132d			;     Nothing                                                                 : 
132d			;------------------------------------------------------------------------------ 
132d			heap_init: 
132d			      push  HL 
132d			 
132d			      ; Initialise free list struct 
132d			      ld    HL, heap_start 
132d			      ld    (free_list), HL 
132d			      ld    HL, 0 
132d			      ld    (free_list+2), HL 
132d			 
132d			      ; Insert first free block at bottom of heap, consumes entire heap 
132d			      ld    HL, heap_start+heap_size-4 
132d			      ld    (heap_start), HL        ; Next block (end of free list) 
132d			      ld    HL, heap_size-4 
132d			      ld    (heap_start+2), HL      ; Block size 
132d			 
132d			      ; Insert end of free list block at top of heap - two null words will 
132d			      ; terminate the free list 
132d			      ld    HL, 0 
132d			      ld    (heap_start+heap_size-2), HL 
132d			      ld    (heap_start+heap_size-4), HL 
132d			 
132d			      pop   HL 
132d			 
132d			      ret 
132d			 
132d			 
132d			;------------------------------------------------------------------------------ 
132d			;     malloc                                                                  : 
132d			;                                                                             : 
132d			; Description                                                                 : 
132d			;     Allocates the wanted space from the heap and returns the address of the : 
132d			;     first useable byte of the allocation.                                   : 
132d			;                                                                             : 
132d			;     Allocations can happen in one of two ways:                              : 
132d			;                                                                             : 
132d			;     1. A free block may be found which is the exact size wanted. In this    : 
132d			;        case the block is removed from the free list and retuedn to the      : 
132d			;        caller.                                                              : 
132d			;     2. A free block may be found which is larger than the size wanted. In   : 
132d			;        this case, the larger block is split into two. The first portion of  : 
132d			;        this block will become the requested space by the malloc call and    : 
132d			;        is returned to the caller. The second portion becomes a new free     : 
132d			;        block, and the free list is adjusted to maintain continuity via this : 
132d			;        newly created block.                                                 : 
132d			;                                                                             : 
132d			;     malloc does not set any initial value in the allocated space, the       : 
132d			;     caller is required to do this as required.                              : 
132d			;                                                                             : 
132d			;     This implementation of malloc uses the stack exclusively, and is        : 
132d			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
132d			;     advisable to disable interrupts before calling malloc, and recommended  : 
132d			;     to avoid the use of malloc inside ISRs in general.                      : 
132d			;                                                                             : 
132d			;     NOTE: heap_init must be called before malloc and free can be used.      : 
132d			;                                                                             : 
132d			; Parameters                                                                  : 
132d			;     HL  Number of bytes wanted                                              : 
132d			;                                                                             : 
132d			; Returns                                                                     : 
132d			;     HL  Address of the first useable byte of the allocation                 : 
132d			;                                                                             : 
132d			; Flags                                                                       : 
132d			;     Z   Set if the allocation did not succeed, clear otherwise              : 
132d			;                                                                             : 
132d			; Stack frame                                                                 : 
132d			;       |             |                                                       : 
132d			;       +-------------+                                                       : 
132d			;       |     BC      |                                                       : 
132d			;       +-------------+                                                       : 
132d			;       |     DE      |                                                       : 
132d			;       +-------------+                                                       : 
132d			;       |     IX      |                                                       : 
132d			;       +-------------+                                                       : 
132d			;       |  prev_free  |                                                       : 
132d			;   +4  +-------------+                                                       : 
132d			;       |  this_free  |                                                       : 
132d			;   +2  +-------------+                                                       : 
132d			;       |  next_free  |                                                       : 
132d			;   +0  +-------------+                                                       : 
132d			;       |             |                                                       : 
132d			;                                                                             : 
132d			;------------------------------------------------------------------------------ 
132d			malloc: 
132d			      push  BC 
132d			      push  DE 
132d			      push  IX 
132d			 
132d			      ld    A, H                    ; Exit if no space requested 
132d			      or    L 
132d			      jp    Z, malloc_early_exit 
132d			 
132d			      ; Set up stack frame 
132d			      ex    DE, HL 
132d			      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
132d			      add   HL, SP 
132d			      ld    SP, HL 
132d			      ld    IX, 0                   ; Use IX as a frame pointer 
132d			      add   IX, SP 
132d			 
132d			      ; Setup initial state 
132d			      ld    HL, 4                   ; want must also include space used by block struct 
132d			      add   HL, DE 
132d			 
132d			      ld    B, H                    ; Move want to BC 
132d			      ld    C, L 
132d			 
132d			      ld    HL, free_list           ; Store prev_free ptr to stack 
132d			      ld    (IX+4), L 
132d			      ld    (IX+5), H 
132d			 
132d			      ld    E, (HL)                 ; Store this_free ptr to stack 
132d			      inc   HL 
132d			      ld    D, (HL) 
132d			      ld    (IX+2), E 
132d			      ld    (IX+3), D 
132d			      ex    DE, HL                  ; this_free ptr into HL 
132d			 
132d			      ; Loop through free block list to find some space 
132d			malloc_find_space: 
132d			      ld    E, (HL)                 ; Load next_free ptr into DE 
132d			      inc   HL 
132d			      ld    D, (HL) 
132d			 
132d			      ld    A, D                    ; Check for null next_free ptr - end of free list 
132d			      or    E 
132d			      jp    Z, malloc_no_space 
132d			 
132d			      ld    (IX+0), E               ; Store next_free ptr to stack 
132d			      ld    (IX+1), D 
132d			 
132d			      ; Does this block have enough space to make the allocation? 
132d			      inc   HL                      ; Load free block size into DE 
132d			      ld    E, (HL) 
132d			      inc   HL 
132d			      ld    D, (HL) 
132d			 
132d			      ex    DE, HL                  ; Check size of block against want 
132d			      or    A                       ; Ensure carry flag clear 
132d			      sbc   HL, BC 
132d			      push  HL                      ; Store the result for later (new block size) 
132d			 
132d			      jr    Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
132d			      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
132d			 
132d			      ; this_free block is not big enough, setup ptrs to test next free block 
132d			      pop   HL                      ; Discard previous result 
132d			 
132d			      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
132d			      ld    H, (IX+3) 
132d			      ld    (IX+4), L 
132d			      ld    (IX+5), H 
132d			 
132d			      ld    L, (IX+0)               ; Move next_free ptr into this_free 
132d			      ld    H, (IX+1) 
132d			      ld    (IX+2), L 
132d			      ld    (IX+3), H 
132d			 
132d			      jr    malloc_find_space 
132d			 
132d			      ; split a bigger block into two - requested size and remaining size 
132d			malloc_alloc_split: 
132d			      ex    DE, HL                  ; Calculate address of new free block 
132d			      dec   HL 
132d			      dec   HL 
132d			      dec   HL 
132d			      add   HL, BC 
132d			 
132d			      ; Create a new block and point it at next_free 
132d			      ld    E, (IX+0)               ; Load next_free ptr into DE 
132d			      ld    D, (IX+1) 
132d			 
132d			      ld    (HL), E                 ; Store next_free ptr into new block 
132d			      inc   HL 
132d			      ld    (HL), D 
132d			 
132d			      pop   DE                      ; Store size of new block into new block 
132d			      inc   HL 
132d			      ld    (HL), E 
132d			      inc   HL 
132d			      ld    (HL), D 
132d			 
132d			      ; Update this_free ptr to point to new block 
132d			      dec   HL 
132d			      dec   HL 
132d			      dec   HL 
132d			 
132d			      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
132d			      ld    D, (IX+3) 
132d			 
132d			      ld    (IX+2), L               ; Store new block addr as this_free ptr 
132d			      ld    (IX+3), H 
132d			 
132d			      ; Modify this_free block to be allocation 
132d			      ex    DE, HL 
132d			      xor   A                       ; Null the next block ptr of allocated block 
132d			      ld    (HL), A 
132d			      inc   HL 
132d			      ld    (HL), A 
132d			 
132d			      inc   HL                      ; Store want size into allocated block 
132d			      ld    (HL), C 
132d			      inc   HL 
132d			      ld    (HL), B 
132d			      inc   HL 
132d			      push  HL                      ; Address of allocation to return 
132d			 
132d			      jr    malloc_update_links 
132d			 
132d			malloc_alloc_fit: 
132d			      pop   HL                      ; Dont need new block size, want is exact fit 
132d			 
132d			      ; Modify this_free block to be allocation 
132d			      ex    DE, HL 
132d			      dec   HL 
132d			      dec   HL 
132d			      dec   HL 
132d			 
132d			      xor   A                       ; Null the next block ptr of allocated block 
132d			      ld    (HL), A 
132d			      inc   HL 
132d			      ld    (HL), A 
132d			 
132d			      inc   HL                      ; Store address of allocation to return 
132d			      inc   HL 
132d			      inc   HL 
132d			      push  HL 
132d			 
132d			      ; Copy next_free ptr to this_free, remove allocated block from free list 
132d			      ld    L, (IX+0)               ; next_free to HL 
132d			      ld    H, (IX+1) 
132d			 
132d			      ld    (IX+2), L               ; HL to this_free 
132d			      ld    (IX+3), H 
132d			 
132d			 
132d			malloc_update_links: 
132d			      ; Update prev_free ptr to point to this_free 
132d			      ld    L, (IX+4)               ; prev_free ptr to HL 
132d			      ld    H, (IX+5) 
132d			 
132d			      ld    E, (IX+2)               ; this_free ptr to DE 
132d			      ld    D, (IX+3) 
132d			 
132d			      ld    (HL), E                 ; this_free ptr into prev_free 
132d			      inc   HL 
132d			      ld    (HL), D 
132d			 
132d			      ; Clear the Z flag to indicate successful allocation 
132d			      ld    A, D 
132d			      or    E 
132d			 
132d			      pop   DE                      ; Address of allocation 
132d			 
132d			malloc_no_space: 
132d			      ld    HL, 6                   ; Clean up stack frame 
132d			      add   HL, SP 
132d			      ld    SP, HL 
132d			 
132d			      ex    DE, HL                  ; Alloc addr into HL for return 
132d			 
132d			malloc_early_exit: 
132d			      pop   IX 
132d			      pop   DE 
132d			      pop   BC 
132d			 
132d			      ret 
132d			 
132d			 
132d			;------------------------------------------------------------------------------ 
132d			;     free                                                                    : 
132d			;                                                                             : 
132d			; Description                                                                 : 
132d			;     Return the space pointed to by HL to the heap. HL must be an address as : 
132d			;     returned by malloc, otherwise the behaviour is undefined.               : 
132d			;                                                                             : 
132d			;     Where possible, directly adjacent free blocks will be merged together   : 
132d			;     into larger blocks to help ensure that the heap does not become         : 
132d			;     excessively fragmented.                                                 : 
132d			;                                                                             : 
132d			;     free does not clear or set any other value into the freed space, and    : 
132d			;     therefore its contents may be visible through subsequent malloc's. The  : 
132d			;     caller should clear the freed space as required.                        : 
132d			;                                                                             : 
132d			;     This implementation of free uses the stack exclusively, and is          : 
132d			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
132d			;     advisable to disable interrupts before calling free, and recommended    : 
132d			;     to avoid the use of free inside ISRs in general.                        : 
132d			;                                                                             : 
132d			;     NOTE: heap_init must be called before malloc and free can be used.      : 
132d			;                                                                             : 
132d			; Parameters                                                                  : 
132d			;     HL  Pointer to address of first byte of allocation to be freed          : 
132d			;                                                                             : 
132d			; Returns                                                                     : 
132d			;     Nothing                                                                 : 
132d			;                                                                             : 
132d			; Stack frame                                                                 : 
132d			;       |             |                                                       : 
132d			;       +-------------+                                                       : 
132d			;       |     BC      |                                                       : 
132d			;       +-------------+                                                       : 
132d			;       |     DE      |                                                       : 
132d			;       +-------------+                                                       : 
132d			;       |     IX      |                                                       : 
132d			;       +-------------+                                                       : 
132d			;       |  prev_free  |                                                       : 
132d			;   +2  +-------------+                                                       : 
132d			;       |  next_free  |                                                       : 
132d			;   +0  +-------------+                                                       : 
132d			;       |             |                                                       : 
132d			;                                                                             : 
132d			;------------------------------------------------------------------------------ 
132d			free: 
132d			      push  BC 
132d			      push  DE 
132d			      push  IX 
132d			 
132d			      ld    A, H                    ; Exit if ptr is null 
132d			      or    L 
132d			      jp    Z, free_early_exit 
132d			 
132d			      ; Set up stack frame 
132d			      ex    DE, HL 
132d			      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
132d			      add   HL, SP 
132d			      ld    SP, HL 
132d			      ld    IX, 0                   ; Use IX as a frame pointer 
132d			      add   IX, SP 
132d			 
132d			      ; The address in HL points to the start of the useable allocated space, 
132d			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
132d			      ; address of the block itself. 
132d			      ex    DE, HL 
132d			      ld    DE, -4 
132d			      add   HL, DE 
132d			 
132d			      ; An allocated block must have a null next block pointer in it 
132d			      ld    A, (HL) 
132d			      inc   HL 
132d			      or    (HL) 
132d			      jp    NZ, free_done 
132d			 
132d			      dec   HL 
132d			 
132d			      ld    B, H                    ; Copy HL to BC 
132d			      ld    C, L 
132d			 
132d			      ; Loop through the free list to find the first block with an address 
132d			      ; higher than the block being freed 
132d			      ld    HL, free_list 
132d			 
132d			free_find_higher_block: 
132d			      ld    E, (HL)                 ; Load next ptr from free block 
132d			      inc   HL 
132d			      ld    D, (HL) 
132d			      dec   HL 
132d			 
132d			      ld    (IX+0), E               ; Save ptr to next free block 
132d			      ld    (IX+1), D 
132d			      ld    (IX+2), L               ; Save ptr to prev free block 
132d			      ld    (IX+3), H 
132d			 
132d			      ld    A, B                    ; Check if DE is greater than BC 
132d			      cp    D                       ; Compare MSB first 
132d			      jr    Z, $+4                  ; MSB the same, compare LSB 
132d			      jr    NC, free_find_higher_block_skip 
132d			      ld    A, C 
132d			      cp    E                       ; Then compare LSB 
132d			      jr    C, free_found_higher_block 
132d			 
132d			free_find_higher_block_skip: 
132d			      ld    A, D                    ; Reached the end of the free list? 
132d			      or    E 
132d			      jp    Z, free_done 
132d			 
132d			      ex    DE, HL 
132d			 
132d			      jr    free_find_higher_block 
132d			 
132d			free_found_higher_block: 
132d			      ; Insert freed block between prev and next free blocks 
132d			      ld    (HL), C                 ; Point prev free block to freed block 
132d			      inc   HL 
132d			      ld    (HL), B 
132d			 
132d			      ld    H, B                    ; Point freed block at next free block 
132d			      ld    L, C 
132d			      ld    (HL), E 
132d			      inc   HL 
132d			      ld    (HL), D 
132d			 
132d			      ; Check if the freed block is adjacent to the next free block 
132d			      inc   HL                      ; Load size of freed block into HL 
132d			      ld    E, (HL) 
132d			      inc   HL 
132d			      ld    D, (HL) 
132d			      ex    DE, HL 
132d			 
132d			      add   HL, BC                  ; Add addr of freed block and its size 
132d			 
132d			      ld    E, (IX+0)               ; Load addr of next free block into DE 
132d			      ld    D, (IX+1) 
132d			 
132d			      or    A                       ; Clear the carry flag 
132d			      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
132d			      jr    NZ, free_check_adjacent_to_prev 
132d			 
132d			      ; Freed block is adjacent to next, merge into one bigger block 
132d			      ex    DE, HL                  ; Load next ptr from next block into DE 
132d			      ld    E, (HL) 
132d			      inc   HL 
132d			      ld    D, (HL) 
132d			      push  HL                      ; Save ptr to next block for later 
132d			 
132d			      ld    H, B                    ; Store ptr from next block into freed block 
132d			      ld    L, C 
132d			      ld    (HL), E 
132d			      inc   HL 
132d			      ld    (HL), D 
132d			 
132d			      pop   HL                      ; Restore ptr to next block 
132d			      inc   HL                      ; Load size of next block into DE 
132d			      ld    E, (HL) 
132d			      inc   HL 
132d			      ld    D, (HL) 
132d			      push  DE                      ; Save next block size for later 
132d			 
132d			      ld    H, B                    ; Load size of freed block into HL 
132d			      ld    L, C 
132d			      inc   HL 
132d			      inc   HL 
132d			      ld    E, (HL) 
132d			      inc   HL 
132d			      ld    D, (HL) 
132d			      ex    DE, HL 
132d			 
132d			      pop   DE                      ; Restore size of next block 
132d			      add   HL, DE                  ; Add sizes of both blocks 
132d			      ex    DE, HL 
132d			 
132d			      ld    H, B                    ; Store new bigger size into freed block 
132d			      ld    L, C 
132d			      inc   HL 
132d			      inc   HL 
132d			      ld    (HL), E 
132d			      inc   HL 
132d			      ld    (HL), D 
132d			 
132d			free_check_adjacent_to_prev: 
132d			      ; Check if the freed block is adjacent to the prev free block 
132d			      ld    L, (IX+2)               ; Prev free block ptr into HL 
132d			      ld    H, (IX+3) 
132d			 
132d			      inc   HL                      ; Size of prev free block into DE 
132d			      inc   HL 
132d			      ld    E, (HL) 
132d			      inc   HL 
132d			      ld    D, (HL) 
132d			      dec   HL 
132d			      dec   HL 
132d			      dec   HL 
132d			 
132d			      add   HL, DE                  ; Add prev block addr and size 
132d			 
132d			      or    A                       ; Clear the carry flag 
132d			      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
132d			      jr    NZ, free_done 
132d			 
132d			      ; Freed block is adjacent to prev, merge into one bigger block 
132d			      ld    H, B                    ; Load next ptr from freed block into DE 
132d			      ld    L, C 
132d			      ld    E, (HL) 
132d			      inc   HL 
132d			      ld    D, (HL) 
132d			      push  HL                      ; Save freed block ptr for later 
132d			 
132d			      ld    L, (IX+2)               ; Store freed block ptr into prev block 
132d			      ld    H, (IX+3) 
132d			      ld    (HL), E 
132d			      inc   HL 
132d			      ld    (HL), D 
132d			 
132d			      pop   HL                      ; Restore freed block ptr 
132d			      inc   HL                      ; Load size of freed block into DE 
132d			      ld    E, (HL) 
132d			      inc   HL 
132d			      ld    D, (HL) 
132d			      push  DE                      ; Save freed block size for later 
132d			 
132d			      ld    L, (IX+2)               ; Load size of prev block into DE 
132d			      ld    H, (IX+3) 
132d			      inc   HL 
132d			      inc   HL 
132d			      ld    E, (HL) 
132d			      inc   HL 
132d			      ld    D, (HL) 
132d			 
132d			      pop   HL                      ; Add sizes of both blocks 
132d			      add   HL, DE 
132d			      ex    DE, HL 
132d			 
132d			      ld    L, (IX+2)               ; Store new bigger size into prev block 
132d			      ld    H, (IX+3) 
132d			      inc   HL 
132d			      inc   HL 
132d			      ld    (HL), E 
132d			      inc   HL 
132d			      ld    (HL), D 
132d			 
132d			free_done: 
132d			      ld    HL, 4                   ; Clean up stack frame 
132d			      add   HL, SP 
132d			      ld    SP, HL 
132d			 
132d			free_early_exit: 
132d			      pop   IX 
132d			      pop   DE 
132d			      pop   BC 
132d			 
132d			      ret 
132d			 
132d			 
132d			;      .org 0x8000 
132d			; 
132d			;free_list         .dw   0     ; Block struct for start of free list (MUST be 4 bytes) 
132d			 ;                 .dw   0 
132d			 
132d			endif 
132d			 
132d			 
132d			if MALLOC_4 
132d			 
132d			; My memory allocation code. Very very simple.... 
132d			; allocate space under 250 chars 
132d			 
132d			heap_init: 
132d				; init start of heap as zero 
132d				;  
132d			 
132d				ld hl, heap_start 
132d			;	ld a, 0 
132d				ld (hl), 0      ; empty block 
132d				inc hl 
132d			;	ld a, 0 
132d				ld (hl), 0      ; length of block 
132d				; write end of list 
132d				inc hl 
132d				ld a,(hl) 
132d				inc hl 
132d				ld a,(hl) 
132d				 
132d			 
132d				; init some malloc vars 
132d			 
132d				ld hl, 0 
132d				ld (free_list), hl       ; store last malloc location 
132d			 
132d				ld hl, free_list+3      ; flag for 'free' being used and force a rescan for reuse of block  
132d			;	ld a, 0 
132d				ld (hl), 0 
132d			 
132d			 
132d				ld hl, heap_start 
132d				;  
132d				  
132d				ret 
132d			 
132d			 
132d			;    free block marker 
132d			;    requested size  
132d			;    pointer to next block 
132d			;    .... 
132d			;    next block marker 
132d			 
132d			 
132d			; TODO add a flag that is reset on use of free. if flag is reset then start scan from start of heap otherwise use last location 
132d			; 
132d			 
132d			 
132d			malloc:  
132d				push de 
132d				push bc 
132d				push af 
132d			 
132d				; hl space required 
132d				 
132d				ld c, l    ; hold space   (TODO only a max of 255) 
132d			 
132d			;	inc c     ; TODO BUG need to fix memory leak on push str 
132d			;	inc c 
132d			;	inc c 
132d			;	inc c 
132d			;	inc c 
132d			;	inc c 
132d			;	inc c 
132d			 
132d			 
132d			 
132d				; start at heap if a free has been issued so we can reclaim it otherwise continue from last time 
132d			 
132d				ld a, (free_list+3) 
132d			;	cp 0 
132d				or a 
132d				jr z, .contheap 
132d			 
132d				ld hl, (free_list)     ; get last alloc 
132d					if DEBUG_FORTH_MALLOC_INT 
132d						DMARK "mrs" 
132d						CALLMONITOR 
132d					endif 
132d				jr .startalloc 
132d			 
132d			.contheap: 
132d				ld hl, heap_start 
132d			 
132d			.startalloc: 
132d			 
132d					if DEBUG_FORTH_MALLOC_INT 
132d						DMARK "mym" 
132d						CALLMONITOR 
132d					endif 
132d			.findblock: 
132d					if DEBUG_FORTH_MALLOC_INT 
132d						DMARK "mmf" 
132d						CALLMONITOR 
132d					endif 
132d			 
132d				ld a,(hl)  
132d				; if byte is zero then clear to use 
132d			 
132d			;	cp 0 
132d				or a 
132d				jr z, .foundemptyblock 
132d			 
132d				; if byte is not clear 
132d				;     then byte is offset to next block 
132d			 
132d				inc hl 
132d				ld a, (hl) ; get size 
132d			.nextblock:	inc hl 
132d					ld e, (hl) 
132d					inc hl 
132d					ld d, (hl) 
132d					ex de, hl 
132d			;	inc hl  ; move past the store space 
132d			;	inc hl  ; move past zero index  
132d			 
132d				; TODO detect no more space 
132d			 
132d				push hl 
132d				ld de, heap_end 
132d				call cmp16 
132d				pop hl 
132d				jr nc, .nospace 
132d			 
132d				jr .findblock 
132d			 
132d			.nospace: ld hl, 0 
132d				jp .exit 
132d			 
132d			 
132d			.foundemptyblock:	 
132d					if DEBUG_FORTH_MALLOC_INT 
132d						DMARK "mme" 
132d						CALLMONITOR 
132d					endif 
132d			 
132d			; TODO has block enough space if reusing??? 
132d			 
132d				;  
132d			 
132d			; see if this block has been previously used 
132d				inc hl 
132d				ld a, (hl) 
132d				dec hl 
132d			;	cp 0 
132d				or a 
132d				jr z, .newblock 
132d			 
132d					if DEBUG_FORTH_MALLOC_INT 
132d						DMARK "meR" 
132d						CALLMONITOR 
132d					endif 
132d			 
132d			; no reusing previously allocated block 
132d			 
132d			; is it smaller than previously used? 
132d				 
132d				inc hl    ; move to size 
132d				ld a, c 
132d				sub (hl)        ; we want c < (hl) 
132d				dec hl    ; move back to marker 
132d			        jr z, .findblock 
132d			 
132d				; update with the new size which should be lower 
132d			 
132d			        ;inc  hl   ; negate next move. move back to size  
132d			 
132d			.newblock: 
132d				; need to be at marker here 
132d			 
132d					if DEBUG_FORTH_MALLOC_INT 
132d						DMARK "meN" 
132d						CALLMONITOR 
132d					endif 
132d			 
132d			 
132d				ld a, c 
132d			 
132d				ld (free_list+3), a	 ; flag resume from last malloc  
132d				ld (free_list), hl    ; save out last location 
132d			 
132d			 
132d				;inc a     ; space for length byte 
132d				ld (hl), a     ; save block in use marker 
132d			 
132d				inc hl   ; move to space marker 
132d				ld (hl), a    ; save new space 
132d			 
132d				inc hl   ; move to start of allocated area 
132d				 
132d			;	push hl     ; save where we are - 1  
132d			 
132d			;	inc hl  ; move past zero index  
132d				; skip space to set down new marker 
132d			 
132d				; provide some extra space for now 
132d			 
132d				inc a    ; actual is one fewer than bytes requested. correct if zero index is taken into account 
132d				inc a 
132d				inc a 
132d			 
132d				push hl   ; save where we are in the node block 
132d			 
132d				call addatohl 
132d			 
132d				; write linked list point 
132d			 
132d				pop de     ; get our node position 
132d				ex de, hl 
132d			 
132d				ld (hl), e 
132d				inc hl 
132d				ld (hl), d 
132d			 
132d				inc hl 
132d			 
132d				; now at start of allocated data so save pointer 
132d			 
132d				push hl 
132d			 
132d				; jump to position of next node and setup empty header in DE 
132d			 
132d				ex de, hl 
132d			 
132d			;	inc hl ; move past end of block 
132d			 
132d			;	ld a, 0 
132d				ld (hl), 0   ; empty marker 
132d				inc hl 
132d				ld (hl), 0   ; size 
132d				inc hl  
132d				ld (hl), 0   ; ptr 
132d				inc hl 
132d				ld (hl), 0   ; ptr 
132d			 
132d			 
132d				pop hl 
132d			 
132d					if DEBUG_FORTH_MALLOC_INT 
132d						DMARK "mmr" 
132d						CALLMONITOR 
132d					endif 
132d			 
132d			.exit: 
132d				pop af 
132d				pop bc 
132d				pop de  
132d				ret 
132d			 
132d			 
132d			 
132d			 
132d			free:  
132d				push hl 
132d				push af 
132d				; get address in hl 
132d			 
132d					if DEBUG_FORTH_MALLOC_INT 
132d						DMARK "fre" 
132d						CALLMONITOR 
132d					endif 
132d				; data is at hl - move to block count 
132d				dec hl 
132d				dec hl    ; get past pointer 
132d				dec hl 
132d			 
132d				ld a, (hl)    ; need this for a validation check 
132d			 
132d				dec hl    ; move to block marker 
132d			 
132d				; now check that the block count and block marker are the same  
132d			        ; this checks that we are on a malloc node and not random memory 
132d			        ; OK a faint chance this could be a problem but rare - famous last words! 
132d			 
132d				ld c, a 
132d				ld a, (hl)    
132d			 
132d				cp c 
132d				jr nz, .freeignore      ; not a valid malloc node in use so dont break anything 
132d			 
132d				; yes good chance we are on a malloc node 
132d			 
132d			;	ld a, 0      
132d				ld (hl), 0   ; mark as free 
132d			 
132d				ld (free_list+3), a	 ; flag reuse of existing block on next malloc 
132d			 
132d			.freeignore:  
132d			 
132d				pop af 
132d				pop hl 
132d			 
132d				ret 
132d			 
132d			 
132d			 
132d			endif 
132d			 
132d			; eof 
# End of file firmware_memory.asm
