2638					ld (debug_mark+1),a  
2638					ld a, (.dmark+2)  
2638					ld (debug_mark+2),a  
2638				endif  
2638 18 04			jr .pastdmark  
263a ..			.dmark: db "HEP"  
263d				if DEMARK_VERSION = 1  
263d 00					db 0  
263e				endif  
263e				if DEMARK_VERSION = 1  
263e e1			.pastdmark: pop hl  
263f				endif  
263f				if DEMARK_VERSION = 0  
263f			.pastdmark: pop af  
