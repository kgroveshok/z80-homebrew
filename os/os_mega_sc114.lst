8fef dd 66 03		      ld    H, (IX+3) 
8ff2 73			      ld    (HL), E 
8ff3 23			      inc   HL 
8ff4 72			      ld    (HL), D 
8ff5			 
8ff5 e1			      pop   HL                      ; Restore freed block ptr 
8ff6 23			      inc   HL                      ; Load size of freed block into DE 
8ff7 5e			      ld    E, (HL) 
8ff8 23			      inc   HL 
8ff9 56			      ld    D, (HL) 
8ffa d5			      push  DE                      ; Save freed block size for later 
8ffb			 
8ffb dd 6e 02		      ld    L, (IX+2)               ; Load size of prev block into DE 
8ffe dd 66 03		      ld    H, (IX+3) 
