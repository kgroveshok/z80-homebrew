4ce2			; | READ ( -- n  )  Reads next page of current file id and push to stack | DONE 
4ce2			; | | e.g. 
4ce2			; | | $01 OPEN $01 DO READ . LOOP 
4ce2			; | | 
4ce2			; | | As this word only reads one 64 byte block in at a time, if the APPEND word has created extra blocks for the excess, this READ 
4ce2			; | | word is unaware so the long string needs to be joined if the string is a full. A single block read might be what you want, 
4ce2			; | | but if not then writing a word to join blocks will be required. The upshot is a full string will be 62 bytes as the first 
4ce2			; | | two bytes contain the file id and extent. 
4ce2			; | |  
4ce2			; | | Note: There is a flag that enables/disables long block reads called 'store_longread' and a poke of a non-zero value will 
4ce2			; | | enable the code to automatically read futher blocks if full. It is BUGGY so don't use for now. 
4ce2			; | | > [!NOTE] 
4ce2			; | | > Compatible with PicoSPINet  
4ce2			 
4ce2					if DEBUG_FORTH_WORDS_KEY 
4ce2						DMARK "REA" 
4ce2				if DEMARK_VERSION = 1  
4ce2 e5					push hl  
4ce3 21 eb 4c				ld hl, .dmark  
4ce6 22 9b fd				ld (debug_mark), hl  
4ce9				endif  
