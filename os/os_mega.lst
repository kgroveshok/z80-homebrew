53af			 
53af			.VARS: 
53af				CWHEAD .V0 99 "VAR" 3 WORD_FLAG_CODE 
53af 77				db WORD_SYS_CORE+99             
53b0 1e 54			dw .V0            
53b2 04				db 3 + 1 
53b3 .. 00			db "VAR",0              
53b7				endm 
# End of macro CWHEAD
53b7			; | VAR ( u1 -- )  Get the address of the (word) variable referenced on TOS  | DONE 
53b7			; | 
53b7			; | | The variable name should consist of a single letter (a-z). e.g. "a" 
53b7			; | |  
53b7			; | | e.g. 
53b7			; | |         #30 a var ! 
53b7			; | |         a var @ . 
53b7			; | |   
53b7			; | |     Displays the number 30 
53b7			; | | 
53b7			; | | Each variable pointer is a word so can use for any words that use that:  
53b7			; | |  
53b7			; | | e.g. 
53b7			; | |  
53b7			; | |         #30 a var 2! 
53b7			; | |         a var 2@ . 
53b7			; | |   
53b7			; | |     Displays the number 30 
53b7			; | |  
53b7			; | | > [!NOTE]  
53b7			; ! | > If a full string is passed then only the first char is looked at 
53b7			; | | > Any other char could exceed bounds checks!  
53b7			; | | > 
53b7			; | | > Each variable location follows the previous. Watch you don't clobber any others. 
53b7			 
53b7					if DEBUG_FORTH_WORDS_KEY 
53b7						DMARK "VAR" 
53b7				if DEMARK_VERSION = 1  
53b7 e5					push hl  
53b8 21 c0 53				ld hl, .dmark  
53bb 22 9b fd				ld (debug_mark), hl  
53be				endif  
53be				if DEMARK_VERSION = 0  
53be					push af  
53be					ld a, (.dmark)  
53be					ld (debug_mark),a  
53be					ld a, (.dmark+1)  
53be					ld (debug_mark+1),a  
53be					ld a, (.dmark+2)  
53be					ld (debug_mark+2),a  
53be				endif  
53be 18 04			jr .pastdmark  
53c0 ..			.dmark: db "VAR"  
53c3				if DEMARK_VERSION = 1  
53c3 00					db 0  
53c4				endif  
53c4				if DEMARK_VERSION = 1  
53c4 e1			.pastdmark: pop hl  
53c5				endif  
53c5				if DEMARK_VERSION = 0  
53c5			.pastdmark: pop af  
53c5				endif  
53c5			endm  
# End of macro DMARK
53c5						CALLMONITOR 
53c5				if BASE_CPM=1  
53c5					call debug_vector  
53c5				endif  
53c5				if BASE_KEV=1  
53c5 cf					rst 8  
53c6				endif  
53c6				endm  
# End of macro CALLMONITOR
53c6					endif 
53c6			 
53c6					FORTH_DSP_VALUEHL 
53c6				if BASE_CPM=1 
53c6				call macro_dsp_valuehl 
53c6				endif 
53c6				if BASE_KEV=1 
53c6 df					rst $18 
53c7				endif 
53c7				endm 
# End of macro FORTH_DSP_VALUEHL
