92fd			 
92fd			config_fdir: 
92fd				; using the scratch dir go through and release the memory allocated for each string 
92fd				 
92fd				ld hl, scratch 
92fd			.cfdir:	ld e,(hl) 
92fd				inc hl 
92fd				ld d,(hl) 
92fd				inc hl 
92fd			 
92fd				ex de, hl 
92fd				call ishlzero 
92fd				ret z     ; return on null pointer 
92fd				call free 
92fd				ex de, hl 
92fd				jr .cfdir 
92fd			 
92fd			 
92fd				ret 
92fd			 
92fd			 
92fd			config_dir: 
92fd			 
92fd				; for the config menus that need to build a directory of storage call this routine 
92fd				; it will construct a menu in scratch to pass to menu 
92fd			 
92fd				; open storage device 
92fd			 
92fd				; execute DIR to build a list of files and their ids into scratch in menu format 
92fd				; once the menu has finished then will need to call config_fdir to release the strings 
92fd				 
92fd				; c = number items 
92fd			 
92fd				 
92fd				call storage_get_block_0 
92fd			 
92fd				ld hl, store_page     ; get current id count 
92fd				ld b, (hl) 
92fd				ld c, 0    ; count of files   
92fd			 
92fd			 
92fd				ld hl, scratch 
92fd				ld (store_tmp2), hl    ; location to poke strings 
92fd			 
92fd				; check for empty drive 
92fd			 
92fd				ld a, 0 
92fd				cp b 
92fd				jp z, .dirdone 
92fd			 
92fd				 
92fd					if DEBUG_FORTH_WORDS 
92fd						DMARK "Cdc" 
92fd						CALLMONITOR 
92fd					endif 
92fd			 
92fd			 
92fd			.diritem:	 
92fd				push bc 
92fd				; for each of the current ids do a search for them and if found push to stack 
92fd			 
92fd					ld hl, STORE_BLOCK_PHY 
92fd					ld d, 0		 ; look for extent 0 of block id as this contains file name 
92fd					ld e,b 
92fd			 
92fd					call storage_findnextid 
92fd			 
92fd			 
92fd					; if found hl will be non zero 
92fd			 
92fd					call ishlzero 
92fd					jr z, .dirnotfound 
92fd			 
92fd					; increase count 
92fd			 
92fd					pop bc	 
92fd					inc c 
92fd					push bc 
92fd					 
92fd			 
92fd					; get file header and push the file name 
92fd			 
92fd					ld de, store_page 
92fd					call storage_read_block 
92fd			 
92fd					; push file id to stack 
92fd				 
92fd					ld a, (store_page) 
92fd					ld h, 0 
92fd					ld l, a 
92fd			 
92fd					;call forth_push_numhl 
92fd					; TODO store id 
92fd			 
92fd					push hl 
92fd			 
92fd					; push extent count to stack  
92fd				 
92fd					ld hl, store_page+3 
92fd			 
92fd					; get file name length 
92fd			 
92fd					call strlenz   
92fd			 
92fd					inc hl   ; cover zero term 
92fd					inc hl  ; stick the id at the end of the area 
92fd			 
92fd					push hl 
92fd					pop bc    ; move length to bc 
92fd			 
92fd					call malloc 
92fd			 
92fd					; TODO save malloc area to scratch 
92fd			 
92fd					ex de, hl 
92fd					ld hl, (store_tmp2) 
92fd					ld (hl), e 
92fd					inc hl 
92fd					ld (hl), d 
92fd					inc hl 
92fd					ld (store_tmp2), hl 
92fd			 
92fd					 
92fd			 
92fd					;pop hl   ; get source 
92fd			;		ex de, hl    ; swap aronund	 
92fd			 
92fd					ld hl, store_page+3 
92fd					if DEBUG_FORTH_WORDS 
92fd						DMARK "CFd" 
92fd						CALLMONITOR 
92fd					endif 
92fd					ldir 
92fd			 
92fd					; de is past string, move back one and store id 
92fd					 
92fd					dec de 
92fd			 
92fd					; store file id 
92fd			 
92fd					pop hl 
92fd					ex de,hl 
92fd					ld (hl), e 
92fd			 
92fd					if DEBUG_FORTH_WORDS 
92fd						DMARK "Cdi" 
92fd						CALLMONITOR 
92fd					endif 
92fd					 
92fd			.dirnotfound: 
92fd					pop bc     
92fd					djnz .diritem 
92fd				 
92fd			.dirdone:	 
92fd			 
92fd			;		ld a, 0 
92fd					ld hl, (store_tmp2) 
92fd					ld (hl), 0 
92fd					inc hl 
92fd					ld (hl), 0 
92fd					inc hl 
92fd					; push a count of the dir items found 
92fd			 
92fd			;		ld h, 0 
92fd			;		ld l, c 
92fd			 
92fd				ret 
92fd			 
92fd			endif 
