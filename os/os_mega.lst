6a22			; **********************************************************************  
6a22			; **  Alphanumeric LCD support                  by Stephen C Cousins  **  
6a22			; **********************************************************************  
6a22			;  
6a22			; **  Written as a Small Computer Monitor App   
6a22			; **  Version 0.1 SCC 2018-05-16  
6a22			; **  www.scc.me.uk  
6a22			;  
6a22			; **********************************************************************  
6a22			;  
6a22			; This module provides support for alphanumeric LCD modules using with  
6a22			; *  HD44780 (or compatible) controller  
6a22			; *  5 x 7 pixel fonts  
6a22			; *  Up to 80 characters in total (eg. 4 lines of 20 characters)  
6a22			; *  Interface via six digital outputs to the display (see below)  
6a22			;  
6a22			; LCD module pinout:  
6a22			;   1  Vss   0v supply  
6a22			;   2  Vdd   5v supply  
6a22			;   3  Vo    LCD input voltage (near zero volts via potentiometer)  
6a22			;   4  RS    High = data, Low = instruction  
6a22			;   5  R/W   High = Read, Low = Write  
6a22			;   6  E     Enable signal (active high)  
6a22			;   7  DB0   Data bit 0  
6a22			;   8  DB1   Data bit 1  
6a22			;   9  DB2   Data bit 2  
6a22			;  10  DB3   Data bit 3  
6a22			;  11  DB4   Data bit 4  
6a22			;  12  DB5   Data bit 5  
6a22			;  13  DB6   Data bit 6  
6a22			;  14  DB7   Data bit 7  
6a22			;  15  A     Backlight anode (+)  
6a22			;  16  K     Backlight cathode (-)  
6a22			;  
6a22			; This interfacing method uses 4-bit data mode and uses time delays  
6a22			; rather than polling the display's ready status. As a result the   
6a22			; interface only requires 6 simple output lines:  
6a22			;   LCD E   = Microcomputer output port bit <kLCDBitE>  
6a22			;   LCD RS  = Microcomputer output port bit <kLCDBitRS>  
6a22			;   LCD DB4 = Microcomputer output port bit 4  
6a22			;   LCD DB5 = Microcomputer output port bit 5  
6a22			;   LCD DB6 = Microcomputer output port bit 6  
6a22			;   LCD DB7 = Microcomputer output port bit 7  
6a22			; Display's R/W is connected to 0v so it is always in write mode  
6a22			; All 6 connections must be on the same port address <kLCDPrt>  
6a22			; This method also allows a decent length of cable from micro to LCD  
6a22			;  
6a22			; **********************************************************************  
6a22			;  
6a22			; To include the code for any given function provided by this module,   
6a22			; add the appropriate #REQUIRES <FunctionName> statement at the top of   
6a22			; the parent source file.  
6a22			; For example:  #REQUIRES   uHexPrefix  
6a22			;  
6a22			; Also #INCLUDE this file at some point after the #REQUIRES statements  
6a22			; in the parent source file.  
6a22			; For example:  #INCLUDE    ..\_CodeLibrary\Utilities.asm  
6a22			;  
6a22			; These are the function names provided by this module:  
6a22			; fLCD_Init                     ;Initialise LCD  
6a22			; fLCD_Inst                     ;Send instruction to LCD  
6a22			; fLCD_Data                     ;Send data byte to LCD  
6a22			; fLCD_Pos                      ;Position cursor  
6a22			; fLCD_Str                      ;Display string  
6a22			; fLCD_Def                      ;Define custom character  
6a22			;  
6a22			; **********************************************************************  
6a22			;  
6a22			; Requires SCMonAPI.asm to also be included in the project  
6a22			;  
6a22			  
6a22			  
6a22			; **********************************************************************  
6a22			; **  Constants  
6a22			; **********************************************************************  
6a22			  
6a22			; Constants that must be defined externally  
6a22			;kLCDPrt:   EQU 0xc0           ;Port address used for LCD  
6a22			;kLCDBitRS: EQU 2              ;Port bit for LCD RS signal  
6a22			;kLCDBitE:  EQU 3              ;Port bit for LCD E signal  
6a22			;kLCDWidth: EQU 20             ;Width in characters  
6a22			  
6a22			; general line offsets in any frame buffer  
6a22			  
6a22			  
6a22			display_row_1: equ 0  
6a22			display_row_2: equ display_row_1+display_cols  
6a22			display_row_3: equ display_row_2 + display_cols  
6a22			display_row_4: equ display_row_3 + display_cols  
6a22			;display_row_4_eol:   
6a22			  
6a22			  
6a22			; Cursor position values for the start of each line  
6a22			  
6a22			; E  
6a22			kLCD_Line1: EQU 0x00   
6a22			kLCD_Line2: EQU kLCD_Line1+kLCDWidth  
6a22			; E1  
6a22			kLCD_Line3: EQU kLCD_Line2+kLCDWidth  
6a22			kLCD_Line4: EQU kLCD_Line3+kLCDWidth   
6a22			  
6a22			; Instructions to send as A register to fLCD_Inst  
6a22			kLCD_Clear: EQU 00000001b     ;LCD clear  
6a22			kLCD_Off:   EQU 00001000b     ;LCD off  
6a22			kLCD_On:    EQU 00001100b     ;LCD on, no cursor or blink  
6a22			kLCD_Under: EQU 00001110b     ;LCD on, cursor = underscore  
6a22			kLCD_Blink: EQU 00001101b     ;LCD on, cursor = blink block  
6a22			kLCD_Both:  EQU 00001111b     ;LCD on, cursor = under+blink  
6a22			  
6a22			; Constants used by this code module  
6a22			kLCD_Clr:   EQU 00000001b     ;LCD command: Clear display  
6a22			kLCD_Pos:   EQU 10000000b     ;LCD command: Position cursor  
6a22			kLCD_Def:   EQU 01000000b     ;LCD command: Define character  
6a22			  
6a22			  
6a22			  
6a22			; **********************************************************************  
6a22			; **  LCD support functions  
6a22			; **********************************************************************  
6a22			  
6a22			; Initialise alphanumeric LCD module  
6a22			; LCD control register codes:  
6a22			;   DL   0 = 4-bit mode        1 = 8-bit mode  
6a22			;   N    0 = 1-line mode       1 = 2-line mode  
6a22			;   F    0 = Font 5 x 8        1 = Font 5 x 11  
6a22			;   D    0 = Display off       1 = Display on  
6a22			;   C    0 = Cursor off        1 = Cursor on  
6a22			;   B    0 = Blinking off      1 = Blinking on  
6a22			;   ID   0 = Decrement mode    1 = Increment mode  
6a22			;   SH   0 = Entire shift off  1 = Entire shift on  
6a22 3e 28		fLCD_Init:  LD   A, 40  
6a24 cd 65 6b		            CALL LCDDelay       ;Delay 40ms after power up  
6a27			; For reliable reset set 8-bit mode - 3 times  
6a27 cd 35 6b		            CALL WrFn8bit       ;Function = 8-bit mode  
6a2a cd 35 6b		            CALL WrFn8bit       ;Function = 8-bit mode  
6a2d cd 35 6b		            CALL WrFn8bit       ;Function = 8-bit mode  
6a30			; Set 4-bit mode  
6a30 cd 31 6b		            CALL WrFn4bit       ;Function = 4-bit mode  
6a33 cd 63 6b		            CALL LCDDelay1      ;Delay 37 us or more  
6a36			; Function set  
6a36 3e 28		            LD   A, 00101000b  ;Control reg:  0  0  1  DL N  F  x  x  
6a38 cd 5b 6a		            CALL fLCD_Inst      ;2 line, display on  
6a3b			; Display On/Off control  
6a3b 3e 0c		            LD   A, 00001100b  ;Control reg:  0  0  0  0  1  D  C  B   
6a3d cd 5b 6a		            CALL fLCD_Inst      ;Display on, cursor on, blink off  
6a40			; Display Clear  
6a40 3e 01		            LD   A, 00000001b  ;Control reg:  0  0  0  0  0  0  0  1  
6a42 cd 5b 6a		            CALL fLCD_Inst      ;Clear display  
6a45			; Entry mode  
6a45 3e 06		            LD   A, 00000110b  ;Control reg:  0  0  0  0  0  1  ID SH  
6a47 cd 5b 6a		            CALL fLCD_Inst      ;Increment mode, shift off  
6a4a			; Display module now initialised  
6a4a c9			            RET  
6a4b			; ok to here  
6a4b			  
6a4b			; decide on setting bit for LED on or off  
6a4b			; Set correct bit in A  
6a4b e5			IsLED: push hl  
6a4c 21 ad fd			ld hl, hardware_word+1  
6a4f cb 56			bit 2, (hl)    ; led bit  
6a51 20 04			jr nz, .isled1  
6a53 cb 8f			res kLCDBitLED, a  
6a55 18 02			jr .isleddone  
6a57 cb cf		.isled1: set kLCDBitLED, a  
6a59			.isleddone:  	  
6a59 e1				pop hl  
6a5a			  
6a5a c9				ret  
6a5b			  
6a5b			  
6a5b			; Write instruction to LCD  
6a5b			;   On entry: A = Instruction byte to be written  
6a5b			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6a5b f5			fLCD_Inst:  PUSH AF  
6a5c f5			            PUSH AF  
6a5d cd 6f 6a		            CALL Wr4bits       ;Write bits 4 to 7 of instruction  
6a60 f1			            POP  AF  
6a61 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6a62 17			            RLA  
6a63 17			            RLA  
6a64 17			            RLA  
6a65 cd 6f 6a		            CALL Wr4bits       ;Write bits 0 to 3 of instruction  
6a68 3e 02		            LD   A, 2  
6a6a cd 65 6b		            CALL LCDDelay       ;Delay 2 ms to complete   
6a6d f1			            POP  AF  
6a6e c9			            RET  
6a6f			Wr4bits:   
6a6f f5					push af  
6a70 3a fb fa				ld a, (display_lcde1e2)  
6a73 fe 00				cp 0     ; e  
6a75 20 13				jr nz, .wea2	  
6a77 f1					pop af  
6a78 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6a7a cd 4b 6a				call IsLED  
6a7d d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a7f cb df		            SET  kLCDBitE, A	    ; TODO decide which E is being set  
6a81 cb 87		            res  kLCDBitE2, A	    ; TODO decide which E is being set  
6a83 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6a85 cb 9f		            RES  kLCDBitE, A        ; TODO decide which E is being set  
6a87 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a89 c9			            RET  
6a8a f1			.wea2:		pop af  
6a8b e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6a8d cd 4b 6a				call IsLED  
6a90 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a92 cb c7		            SET  kLCDBitE2, A	    ; TODO decide which E is being set  
6a94 cb 9f		            res  kLCDBitE, A	    ; TODO decide which E is being set  
6a96 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6a98 cb 87		            RES  kLCDBitE2, A        ; TODO decide which E is being set  
6a9a d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a9c c9			            RET  
6a9d			  
6a9d			  
6a9d			; Write data to LCD  
6a9d			;   On entry: A = Data byte to be written  
6a9d			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6a9d f5			fLCD_Data:  PUSH AF  
6a9e f5			            PUSH AF  
6a9f cd b1 6a		            CALL Wr4bitsa       ;Write bits 4 to 7 of data byte  
6aa2 f1			            POP  AF  
6aa3 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6aa4 17			            RLA  
6aa5 17			            RLA  
6aa6 17			            RLA  
6aa7 cd b1 6a		            CALL Wr4bitsa       ;Write bits 0 to 3 of data byte  
6aaa 3e 96		            LD   A, 150  
6aac 3d			Wait:      DEC  A              ;Wait a while to allow data   
6aad 20 fd		            JR   NZ, Wait      ;  write to complete  
6aaf f1			            POP  AF  
6ab0 c9			            RET  
6ab1			Wr4bitsa:     
6ab1 f5					push af  
6ab2 3a fb fa				ld a, (display_lcde1e2)  
6ab5 fe 00				cp 0     ; e1  
6ab7 20 19				jr nz, .we2	  
6ab9 f1					pop af  
6aba e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6abc cd 4b 6a				call IsLED  
6abf cb d7		            SET  kLCDBitRS, A  
6ac1 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6ac3 cb df		            SET  kLCDBitE, A      ; TODO Decide which E is being set  
6ac5 cb 87		            res  kLCDBitE2, A      ; TODO Decide which E is being set  
6ac7 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6ac9 cb 9f		            RES  kLCDBitE, A       ; TODO Decide which E is being set  
6acb d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6acd cb 97		            RES  kLCDBitRS, A  
6acf d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6ad1 c9			            RET  
6ad2 f1			.we2:		pop af  
6ad3 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6ad5 cd 4b 6a				call IsLED  
6ad8 cb d7		            SET  kLCDBitRS, A  
6ada d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6adc cb c7		            SET  kLCDBitE2, A      ; TODO Decide which E is being set  
6ade cb 9f		            res  kLCDBitE, A      ; TODO Decide which E is being set  
6ae0 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6ae2 cb 87		            RES  kLCDBitE2, A       ; TODO Decide which E is being set  
6ae4 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6ae6 cb 97		            RES  kLCDBitRS, A  
6ae8 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6aea c9			            RET  
6aeb			  
6aeb			  
6aeb			; Position cursor to specified location  
6aeb			;   On entry: A = Cursor position  
6aeb			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6aeb f5			fLCD_Pos:   PUSH AF  
6aec					; at this point set the E1 or E2 flag depending on position  
6aec			  
6aec c5					push bc  
6aed			;		push af  
6aed 06 00				ld b, 0  
6aef 4f					ld c, a  
6af0 3e 4f				ld a, kLCD_Line3-1  
6af2 b7			 		or a      ;clear carry flag  
6af3 99					sbc a,c    ; TODO may need to sub 80 from a to put in context of current frame    
6af4 38 04				jr c, .pe1  
6af6			  
6af6					; E selection  
6af6 cb 80				res 0, b         ; bit 0 unset e  
6af8			;		pop af    ; before line 3 so recover orig pos  
6af8			;		ld c, a    ; save for poking back  
6af8 18 06				jr .peset	          
6afa			.pe1:          	; E2 selection  
6afa cb c0				set 0, b         ; bit 0 set e1  
6afc 79					ld a, c  
6afd de 4f				sbc a, kLCD_Line3-1  
6aff 4f					ld c, a	         ; save caculated offset  
6b00			;		pop af     ; bin this original value now we have calculated form  
6b00			  
6b00			.peset:		; set bit  
6b00 78					ld a, b  
6b01 32 fb fa				ld (display_lcde1e2), a 	  
6b04 79					ld a, c  
6b05 c1					pop bc  
6b06			  
6b06 f6 80		            OR   kLCD_Pos       ;Prepare position cursor instruction  
6b08 cd 5b 6a		            CALL fLCD_Inst      ;Write instruction to LCD  
6b0b f1			            POP  AF  
6b0c c9			            RET  
6b0d			  
6b0d			  
6b0d			; Output text string to LCD  
6b0d			;   On entry: DE = Pointer to null terminated text string  
6b0d			;   On exit:  BC HL IX IY I AF' BC' DE' HL' preserved  
6b0d 1a			fLCD_Str:   LD   A, (DE)        ;Get character from string  
6b0e b7			            OR   A              ;Null terminator?  
6b0f c8			            RET  Z              ;Yes, so finished  
6b10 cd 9d 6a		            CALL fLCD_Data      ;Write character to display  
6b13 13			            INC  DE             ;Point to next character  
6b14 18 f7		            JR   fLCD_Str       ;Repeat  
6b16 c9					ret  
6b17			  
6b17			; Define custom character  
6b17			;   On entry: A = Character number (0 to 7)  
6b17			;             DE = Pointer to character bitmap data  
6b17			;   On exit:  A = Next character number  
6b17			;             DE = Next location following bitmap  
6b17			;             BC HL IX IY I AF' BC' DE' HL' preserved  
6b17			; Character is   
6b17 c5			fLCD_Def:   PUSH BC  
6b18 f5			            PUSH AF  
6b19 07			            RLCA                ;Calculate location  
6b1a 07			            RLCA                ;  for bitmap data  
6b1b 07			            RLCA                ;  = 8 x CharacterNumber  
6b1c f6 40		            OR   kLCD_Def       ;Prepare define character instruction  
6b1e cd 5b 6a		            CALL fLCD_Inst      ;Write instruction to LCD  
6b21 06 00		            LD   B, 0  
6b23 1a			Loop:      LD   A, (DE)        ;Get byte from bitmap  
6b24 cd 9d 6a		            CALL fLCD_Data      ;Write byte to display  
6b27 13			            INC  DE             ;Point to next byte  
6b28 04			            INC  B              ;Count bytes  
6b29 cb 58		            BIT  3, B           ;Finish all 8 bytes?  
6b2b 28 f6		            JR   Z, Loop       ;No, so repeat  
6b2d f1			            POP  AF  
6b2e 3c			            INC  A              ;Increment character number  
6b2f c1			            POP  BC  
6b30 c9			            RET  
