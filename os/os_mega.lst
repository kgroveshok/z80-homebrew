1004			BYTERD: 
1004 16 00			LD	D,00h		;Set up 
1006 cd 0e 10			CALL	HEXCON		;Get byte and convert to hex 
1009 87				ADD	A,A		;First nibble so 
100a 87				ADD	A,A		;multiply by 16 
100b 87				ADD	A,A		; 
100c 87				ADD	A,A		; 
100d 57				LD	D,A		;Save hi nibble in D 
100e			HEXCON: 
100e 7e				ld a, (hl)		;Get next chr 
100f 23				inc hl 
1010 d6 30			SUB	030h		;Makes '0'-'9' equal 0-9 
1012 fe 0a			CP	00Ah		;Is it 0-9 ? 
1014 38 02			JR	C,NALPHA	;If so miss next bit 
1016 d6 07			SUB	007h		;Else convert alpha 
1018			NALPHA: 
1018 b2				OR	D		;Add hi nibble back 
1019 c9				RET			; 
