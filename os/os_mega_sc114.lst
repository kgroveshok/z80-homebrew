d560 c9				ret 
d561			 
d561			; output char at pos 
d561			fLCD_Data: 
d561			      ;  out (SC114_SIO_1_OUT),a 
d561 c5				push bc 
d562 0e 02			ld c, $02 
d564 f7				rst $30 
d565 c1				pop bc 
d566			 
d566 c9				ret 
d567			 
d567			; ascii cls  
d567			 
d567 1b 5b 48 00	.cls:   db 27, '[', 'H', 0 
d56b			 
d56b			; write the frame buffer given in hl to hardware  
d56b			write_display: 
d56b			 
d56b			API: equ 0 
d56b			 
d56b			if API 
d56b				push bc 
d56b				ld b, 4 
d56b			 
d56b			        ld (display_write_tmp), hl 	  
d56b			 
d56b				; clear and home cursor 
d56b			 
d56b				ld c, 6 
d56b				ld de, .cls 
d56b				rst $30 
d56b			 
d56b			 
d56b			.writeln: 
d56b			 
d56b				ld de, (display_write_tmp) 
d56b				ld c, 6 
d56b				rst $30 
d56b				ld c, 7 
d56b				rst $30 
d56b			 
d56b				ld hl, (display_write_tmp) 
d56b				ld de, display_cols 
d56b				add hl,de 
d56b				ld (display_write_tmp),hl 
d56b			 
d56b				djnz  .writeln 
d56b			 
d56b				pop bc 
d56b			 
d56b			 
d56b				ret 
