6788			 
6788				ld a, display_row_4 
6788				ld de, endprog 
6788			 
6788				call update_display		 
6788			 
6788				ld a, (os_last_cmd) 
6788			;	cp 0 
6788				or a 
6788				jr nz, .startnxt 
6788				call next_page_prompt 
6788			        call clear_display 
6788				call update_display		 
6788			 
6788				; move onto next startup line? 
6788			.startnxt: 
6788			 
6788				call delay250ms 
6788				pop hl 
6788			 
6788				inc hl 
6788				inc hl 
6788			 
6788				push hl 
6788				ld e, (hl) 
6788				inc hl 
