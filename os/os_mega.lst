0c5c			; https://wikiti.brandonw.net/index.php?title=Z80_Routines:Math:Random 
0c5c			 
0c5c			 
0c5c			;-----> Generate a random number 
0c5c			; output a=answer 0<=a<=255 
0c5c			; all registers are preserved except: af 
0c5c			random: 
0c5c e5			        push    hl 
0c5d d5			        push    de 
0c5e 2a db fa		        ld      hl,(randData) 
0c61 ed 5f		        ld      a,r 
0c63 57			        ld      d,a 
0c64 5e			        ld      e,(hl) 
0c65 19			        add     hl,de 
0c66 85			        add     a,l 
0c67 ac			        xor     h 
0c68 22 db fa		        ld      (randData),hl 
0c6b d1			        pop     de 
0c6c e1			        pop     hl 
0c6d c9			        ret 
0c6e			 
0c6e			 
0c6e			; randData here must be a 2 byte seed located in ram. While this is a fast generator, it's generally not considered very good in terms of randomness. 
0c6e			 
0c6e			 
0c6e			 
0c6e			;------LFSR------ 
0c6e			;James Montelongo 
0c6e			;optimized by Spencer Putt 
0c6e			;out: 
0c6e			; a = 8 bit random number 
0c6e			RandLFSR: 
0c6e 21 e1 fa		        ld hl,LFSRSeed+4 
0c71 5e			        ld e,(hl) 
0c72 23			        inc hl 
0c73 56			        ld d,(hl) 
0c74 23			        inc hl 
0c75 4e			        ld c,(hl) 
0c76 23			        inc hl 
0c77 7e			        ld a,(hl) 
0c78 47			        ld b,a 
0c79 cb 13		        rl e  
0c7b cb 12			rl d 
0c7d cb 11		        rl c  
0c7f 17				rla 
0c80 cb 13		        rl e  
0c82 cb 12			rl d 
0c84 cb 11		        rl c  
0c86 17				rla 
0c87 cb 13		        rl e  
0c89 cb 12			rl d 
0c8b cb 11		        rl c  
0c8d 17				rla 
0c8e 67			        ld h,a 
0c8f cb 13		        rl e  
0c91 cb 12			rl d 
0c93 cb 11		        rl c  
0c95 17				rla 
0c96 a8			        xor b 
0c97 cb 13		        rl e  
0c99 cb 12			rl d 
0c9b ac			        xor h 
0c9c a9			        xor c 
0c9d aa			        xor d 
0c9e 21 e3 fa		        ld hl,LFSRSeed+6 
0ca1 11 e4 fa		        ld de,LFSRSeed+7 
0ca4 01 07 00		        ld bc,7 
0ca7 ed b8		        lddr 
0ca9 12			        ld (de),a 
0caa c9			        ret 
0cab			 
0cab			;While this may produces better numbers, it is slower, larger and requires a bigger seed than ionrandom. Assuming theres is a good seed to start, it should generate ~2^56 bytes before repeating. However if there is not a good seed(0 for example), then the numbers created will not be adequate. Unlike Ionrandom and its use of the r register, starting with the same seed the same numbers will be generated. With Ionrandom the code running may have an impact on the number generated. This means this method requires more initialization. 
0cab			 
0cab			;You can initialize with TI-OS's seeds, stored at seed1 and seed2, both are ti-floats but will serve the purpose.  
0cab			 
0cab			 
0cab			;This is a very fast, quality pseudo-random number generator. It combines a 16-bit Linear Feedback Shift Register and a 16-bit LCG. 
0cab			 
0cab			prng16: 
0cab			;Inputs: 
0cab			;   (seed1) contains a 16-bit seed value 
0cab			;   (seed2) contains a NON-ZERO 16-bit seed value 
0cab			;Outputs: 
0cab			;   HL is the result 
0cab			;   BC is the result of the LCG, so not that great of quality 
0cab			;   DE is preserved 
0cab			;Destroys: 
0cab			;   AF 
0cab			;cycle: 4,294,901,760 (almost 4.3 billion) 
0cab			;160cc 
0cab			;26 bytes 
0cab 2a d5 fa		    ld hl,(seed1) 
0cae 44			    ld b,h 
0caf 4d			    ld c,l 
0cb0 29			    add hl,hl 
0cb1 29			    add hl,hl 
0cb2 2c			    inc l 
0cb3 09			    add hl,bc 
0cb4 22 d5 fa		    ld (seed1),hl 
0cb7 2a d3 fa		    ld hl,(seed2) 
0cba 29			    add hl,hl 
0cbb 9f			    sbc a,a 
0cbc e6 2d		    and %00101101 
0cbe ad			    xor l 
0cbf 6f			    ld l,a 
0cc0 22 d3 fa		    ld (seed2),hl 
0cc3 09			    add hl,bc 
0cc4 c9			    ret 
0cc5			 
0cc5			;On their own, LCGs and LFSRs don't produce great results and are generally very cyclical, but they are very fast to compute. The 16-bit LCG in the above example will bounce around and reach each number from 0 to 65535, but the lower bits are far more predictable than the upper bits. The LFSR mixes up the predictability of a given bit's state, but it hits every number except 0, meaning there is a slightly higher chance of any given bit in the result being a 1 instead of a 0. It turns out that by adding together the outputs of these two generators, we can lose the predictability of a bit's state, while ensuring it has a 50% chance of being 0 or 1. As well, since the periods, 65536 and 65535 are coprime, then the overall period of the generator is 65535*65536, which is over 4 billion.  
0cc5			 
0cc5			rand32: 
0cc5			;Inputs: 
0cc5			;   (seed1_0) holds the lower 16 bits of the first seed 
0cc5			;   (seed1_1) holds the upper 16 bits of the first seed 
0cc5			;   (seed2_0) holds the lower 16 bits of the second seed 
0cc5			;   (seed2_1) holds the upper 16 bits of the second seed 
0cc5			;   **NOTE: seed2 must be non-zero 
0cc5			;Outputs: 
0cc5			;   HL is the result 
0cc5			;   BC,DE can be used as lower quality values, but are not independent of HL. 
0cc5			;Destroys: 
0cc5			;   AF 
0cc5			;Tested and passes all CAcert tests 
0cc5			;Uses a very simple 32-bit LCG and 32-bit LFSR 
0cc5			;it has a period of 18,446,744,069,414,584,320 
0cc5			;roughly 18.4 quintillion. 
0cc5			;LFSR taps: 0,2,6,7  = 11000101 
0cc5			;291cc 
0cc5			;seed1_0=$+1 
0cc5			;    ld hl,12345 
0cc5			;seed1_1=$+1 
0cc5			;    ld de,6789 
0cc5			;    ld b,h 
0cc5			;    ld c,l 
0cc5			;    add hl,hl \ rl e \ rl d 
0cc5			;    add hl,hl \ rl e \ rl d 
0cc5			;    inc l 
0cc5			;    add hl,bc 
0cc5			;    ld (seed1_0),hl 
0cc5			;    ld hl,(seed1_1) 
0cc5			;    adc hl,de 
0cc5			;    ld (seed1_1),hl 
0cc5			;    ex de,hl 
0cc5			;seed2_0=$+1 
0cc5			;    ld hl,9876 
0cc5			;seed2_1=$+1 
0cc5			;    ld bc,54321 
0cc5			;    add hl,hl \ rl c \ rl b 
0cc5			;    ld (seed2_1),bc 
0cc5			;    sbc a,a 
0cc5			;    and %11000101 
0cc5			;    xor l 
0cc5			;    ld l,a 
0cc5			;    ld (seed2_0),hl 
0cc5			;    ex de,hl 
0cc5			;    add hl,bc 
0cc5			;    ret 
0cc5			; 
0cc5			 
0cc5			; 16-bit xorshift pseudorandom number generator by John Metcalf 
0cc5			; 20 bytes, 86 cycles (excluding ret) 
0cc5			 
0cc5			; returns   hl = pseudorandom number 
0cc5			; corrupts   a 
0cc5			 
0cc5			; generates 16-bit pseudorandom numbers with a period of 65535 
0cc5			; using the xorshift method: 
0cc5			 
0cc5			; hl ^= hl << 7 
0cc5			; hl ^= hl >> 9 
0cc5			; hl ^= hl << 8 
0cc5			 
0cc5			; some alternative shift triplets which also perform well are: 
0cc5			; 6, 7, 13; 7, 9, 13; 9, 7, 13. 
0cc5			 
0cc5			;  org 32768 
0cc5			 
0cc5			xrnd: 
0cc5 2a d9 fa		  ld hl,(xrandc)       ; seed must not be 0 
0cc8 3e 00		  ld a,0 
0cca bd			  cp l 
0ccb 20 02		  jr nz, .xrnd1 
0ccd 2e 01		  ld l, 1 
0ccf			.xrnd1: 
0ccf			 
0ccf 7c			  ld a,h 
0cd0 1f			  rra 
0cd1 7d			  ld a,l 
0cd2 1f			  rra 
0cd3 ac			  xor h 
0cd4 67			  ld h,a 
0cd5 7d			  ld a,l 
0cd6 1f			  rra 
0cd7 7c			  ld a,h 
0cd8 1f			  rra 
0cd9 ad			  xor l 
0cda 6f			  ld l,a 
0cdb ac			  xor h 
0cdc 67			  ld h,a 
0cdd			 
0cdd 22 d9 fa		  ld (xrandc),hl 
0ce0			 
0ce0 c9			  ret 
