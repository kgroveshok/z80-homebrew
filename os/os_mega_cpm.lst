0bc0			 
0bc0 06 08		     ld b,8          ;7           7 
0bc2 21 00 00		     ld hl,0         ;10         10 
0bc5 29			       add hl,hl     ;11*8       88 
0bc6 07			       rlca          ;4*8        32 
0bc7 30 01		       jr nc,$+3     ;(12|18)*8  96+6x 
0bc9 19			         add hl,de   ;--         -- 
0bca 10 f9		       djnz $-5      ;13*7+8     99 
0bcc c9			ret 
