1dc3			.NMICLR:  
1dc3			 
1dc3			CWHEAD .NMICLREND OPCODE_HEAP "NMICLR" 6 WORD_FLAG_CODE 
1dc3 15				db WORD_SYS_CORE+OPCODE_HEAP             
1dc4 d7 1d			dw .NMICLREND            
1dc6 07				db 6 + 1 
1dc7 .. 00			db "NMICLR",0              
1dce				endm 
# End of macro CWHEAD
1dce			; | NMICLR ( -- ) Clears the use of the NMI switch | DONE 
1dce cd 54 5a			call clear_nmi 
1dd1			 
1dd1				NEXTW 
1dd1 cd 68 ee			call parse_vector 
1dd4 c3 8a 1c			jp macro_next 
1dd7				endm 
# End of macro NEXTW
1dd7			.NMICLREND: 
1dd7			 
1dd7			.NEW: 
1dd7			CWHEAD .HEAP OPCODE_HEAP "NEW" 3 WORD_FLAG_CODE 
1dd7 15				db WORD_SYS_CORE+OPCODE_HEAP             
1dd8 f1 1d			dw .HEAP            
1dda 04				db 3 + 1 
1ddb .. 00			db "NEW",0              
1ddf				endm 
# End of macro CWHEAD
1ddf			; | NEW ( -- ) Clears all user words and stack | DONE 
1ddf				 
1ddf				if MALLOC_4 
1ddf					call  heap_init 
1ddf				endif 
1ddf				; reset uword pointers 
1ddf 21 91 5b			ld hl, baseram 
1de2 22 98 e5			ld (os_last_new_uword), hl 
1de5 cd 17 1c			call user_word_eol 
1de8				; clear stack 
1de8 cd 30 1c			call forth_warmstart 
1deb				NEXTW 
1deb cd 68 ee			call parse_vector 
1dee c3 8a 1c			jp macro_next 
1df1				endm 
# End of macro NEXTW
1df1			 
1df1			.HEAP: 
1df1			CWHEAD .EXEC OPCODE_HEAP "HEAP" 4 WORD_FLAG_CODE 
1df1 15				db WORD_SYS_CORE+OPCODE_HEAP             
1df2 28 1e			dw .EXEC            
1df4 05				db 4 + 1 
1df5 .. 00			db "HEAP",0              
1dfa				endm 
# End of macro CWHEAD
1dfa			; | HEAP ( -- u1 u2 )   Pushes u1 the current number of bytes in the heap and u2 the remaining bytes - Only present if using my MALLOC | DONE 
1dfa			; | | u1 - Current number of bytes in the heap 
1dfa			; | | u2 - Remaining bytes left on the heap 
1dfa			; | |  
1dfa			; | | The heap is used for storing user defined words as well as any values pushed to stack. 
1dfa			 
1dfa			 
1dfa				if DEBUG_FORTH_WORDS_KEY 
1dfa					DMARK "HEP" 
1dfa				if DEMARK_VERSION = 1  
1dfa e5					push hl  
1dfb 21 03 1e				ld hl, .dmark  
1dfe 22 60 ee				ld (debug_mark), hl  
1e01				endif  
1e01				if DEMARK_VERSION = 0  
1e01					push af  
1e01					ld a, (.dmark)  
1e01					ld (debug_mark),a  
1e01					ld a, (.dmark+1)  
1e01					ld (debug_mark+1),a  
1e01					ld a, (.dmark+2)  
1e01					ld (debug_mark+2),a  
