a4ff			; | MONITOR ( -- ) Display system breakpoint/monitor | DONE 
a4ff			; | | At start the current various registers will be displayed with contents. 
a4ff			; | | Top right corner will show the most recent debug marker seen. 
a4ff			; | | The bottom of the screen will also show the values of the data stack pointer (DSP) 
a4ff			; | | and the return stack pointer (RSP). 
a4ff			; | | Pressing: 
a4ff			; | |  
a4ff			; | |    1 - Initial screen 
a4ff			; | |  
a4ff			; | |    2 - Display a data dump of HL 
a4ff			; | |  
a4ff			; | |    3 - Display a data dump of DE 
a4ff			; | |  
a4ff			; | |    4 - Display a data dump of BC 
a4ff			; | |  
a4ff			; | |    5 - Display a data dump of HL 
a4ff			; | |  
a4ff			; | |    6 - Display a data dump of DSP 
a4ff			; | |  
a4ff			; | |    7 - Display a data dump of RSP 
a4ff			; | |  
a4ff			; | |    8 - Display a data dump of what is at DSP 
a4ff			; | |  
a4ff			; | |    9 - Display a data dump of what is at RSP 
a4ff			; | |  
a4ff			; | |    0 - Exit monitor and continue running. This will also enable break points 
a4ff			; | |  
a4ff			; | |    * - Disable break points 
a4ff			; | |  
a4ff			; | |    # - Enter traditional monitor mode 
a4ff			; | |  
a4ff			; | | 
a4ff			; | | Monitor Mode 
a4ff			; | | ------------ 
a4ff			; | | A prompt of '>' will be shown for various commands: 
a4ff			; | |  
a4ff			; | |    D xxxx - Display a data dump starting from hex address xxxx 
a4ff			; | |  
a4ff			; | |    C - Continue display a data dump from the last set address 
a4ff			; | |  
a4ff			; | |    M xxxx - Set start of memory edit at address xx 
a4ff			; | |  
a4ff			; | |    U xx - Poke the hex byte xx into the address set by M and increment the address to the next location 
a4ff			; | |  
a4ff			; | |    G xxxx - Exec code at specific address 
a4ff			; | |  
a4ff			; | |    Q - Return to previous 
a4ff				if DEBUG_FORTH_WORDS_KEY 
a4ff					DMARK "MON" 
a4ff				if DEMARK_VERSION = 1  
a4ff e5					push hl  
a500 21 08 a5				ld hl, .dmark  
a503 22 60 ee				ld (debug_mark), hl  
a506				endif  
a506				if DEMARK_VERSION = 0  
a506					push af  
a506					ld a, (.dmark)  
a506					ld (debug_mark),a  
a506					ld a, (.dmark+1)  
a506					ld (debug_mark+1),a  
a506					ld a, (.dmark+2)  
a506					ld (debug_mark+2),a  
a506				endif  
a506 18 04			jr .pastdmark  
a508 ..			.dmark: db "MON"  
a50b				if DEMARK_VERSION = 1  
a50b 00					db 0  
a50c				endif  
a50c				if DEMARK_VERSION = 1  
a50c e1			.pastdmark: pop hl  
a50d				endif  
a50d				if DEMARK_VERSION = 0  
a50d			.pastdmark: pop af  
a50d				endif  
a50d			endm  
# End of macro DMARK
a50d					CALLMONITOR 
a50d				if BASE_CPM=1  
a50d					call debug_vector  
a50d				endif  
a50d				if BASE_KEV=1  
a50d					rst 8  
a50d				endif  
a50d				endm  
# End of macro CALLMONITOR
a50d				endif 
