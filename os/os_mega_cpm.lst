57ea			 
57ea e5				push hl 
57eb 2a 74 ee			ld hl, (hardware_config+1) 
57ee cb 7e			bit 7, (hl) 
57f0			 
57f0 20 02			jr nz, .dochecks 
57f2			 
57f2 e1				pop hl 
57f3 c9				ret 
