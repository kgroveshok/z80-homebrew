9045				; d = bus data 
9045				 
9045 ed 51			out (c), d 
9047			 
9047 2b				dec hl 
9048 cd e2 8a			call ishlzero 
904b 20 f8			jr nz, tape_osc 
904d				 
904d c9				ret 
904e			 
904e			; output a gap period 
904e			tape_gap:  
904e 3a 47 ea			ld a, (tape_tm_gap) 
9051 cd 39 87			call aDelayInMS 
9054 c9				ret 
