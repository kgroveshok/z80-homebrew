570c			chk_stk_init: 
570c				; a vague random number to check so we dont get any "lucky" hits 
570c 3e 2d			ld a, 45 
570e 6f				ld l, a 
570f 00				nop 
5710 3e 17			ld a, 23 
5712 67				ld h, a 
5713			 
