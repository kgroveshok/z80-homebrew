# End of macro CWHEAD
4516			; | VAR ( u1 -- )  Get the address of the (word) variable referenced on TOS  | DONE 
4516			; | 
4516			; | | The variable name should consist of a single letter (a-z). e.g. "a" 
4516			; | |  
4516			; | | e.g. 
4516			; | |         #30 a var ! 
4516			; | |         a var @ . 
4516			; | |   
4516			; | |     Displays the number 30 
4516			; | | 
4516			; | | Each variable pointer is a word so can use for any words that use that:  
4516			; | |  
4516			; | | e.g. 
4516			; | |  
4516			; | |         #30 a var 2! 
4516			; | |         a var 2@ . 
4516			; | |   
4516			; | |     Displays the number 30 
4516			; | |  
4516			; | | > [!NOTE]  
4516			; ! | > If a full string is passed then only the first char is looked at 
4516			; | | > Any other char could exceed bounds checks!  
4516			; | | > 
4516			; | | > Each variable location follows the previous. Watch you don't clobber any others. 
4516			 
4516					if DEBUG_FORTH_WORDS_KEY 
4516						DMARK "VAR" 
4516				if DEMARK_VERSION = 1  
4516 e5					push hl  
4517 21 1f 45				ld hl, .dmark  
451a 22 60 ee				ld (debug_mark), hl  
451d				endif  
