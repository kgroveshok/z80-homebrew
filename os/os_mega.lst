6a87			; what is at cursor position   
6a87			  
6a87			;get_cursor:	ld de, (cursor_row)   ;  row + col  
6a87			;		call curptr  
6a87			;		ret  
6a87			  
6a87			  
6a87			; take current custor pos in de (d=row,e=col) and return a pointer to the frame buffer  
6a87			  
6a87			curptr:  
6a87 c5				push bc  
6a88 21 e1 fc			ld hl, display_fb0  
6a8b			cpr:	  
6a8b				; loop for cursor whole row  
6a8b 0e 28			ld c, display_cols  
6a8d 23			cpr1:	inc hl  
6a8e 0d				dec c  
6a8f 20 fc			jr nz, cpr1  
6a91 05				dec b  
6a92 20 f7			jr nz, cpr  
6a94			  
6a94				; add col	  
6a94			  
6a94 23			cpr2:	inc hl  
6a95 1d				dec e  
6a96 20 fc			jr nz, cpr2  
6a98			  
6a98 c1				pop bc  
6a99 c9				ret  
6a9a				  
6a9a			  
6a9a			  
6a9a			  
6a9a			  
6a9a			; write the frame buffer given in hl to hardware   
6a9a 22 f9 fa		write_display: ld (display_write_tmp), hl 	   
6a9d 3e 00			ld a, kLCD_Line1  
6a9f cd c5 6b		            CALL fLCD_Pos       ;Position cursor to location in A  
6aa2 06 28			ld b, display_cols  
6aa4 ed 5b f9 fa		ld de, (display_write_tmp)  
6aa8 cd f4 6a			call write_len_string  
6aab				  
6aab				  
6aab 2a f9 fa			ld hl, (display_write_tmp)  
6aae 11 28 00			ld de, display_cols  
6ab1 19				add hl,de  
6ab2 22 f9 fa			ld (display_write_tmp),hl  
6ab5			  
6ab5				  
6ab5 3e 28			ld a, kLCD_Line2  
6ab7 cd c5 6b		            CALL fLCD_Pos       ;Position cursor to location in A  
6aba 06 28			ld b, display_cols  
6abc ed 5b f9 fa		ld de, (display_write_tmp)  
6ac0 cd f4 6a			call write_len_string  
6ac3				  
6ac3 2a f9 fa			ld hl, (display_write_tmp)  
6ac6 11 28 00			ld de, display_cols  
6ac9 19				add hl,de  
6aca 22 f9 fa			ld (display_write_tmp),hl  
6acd			  
6acd				  
6acd 3e 50			ld a, kLCD_Line3  
6acf cd c5 6b		            CALL fLCD_Pos       ;Position cursor to location in A  
6ad2 06 28			ld b, display_cols  
6ad4 ed 5b f9 fa		ld de, (display_write_tmp)  
6ad8 cd f4 6a			call write_len_string  
6adb				  
6adb 2a f9 fa			ld hl, (display_write_tmp)  
6ade 11 28 00			ld de, display_cols  
6ae1 19				add hl,de  
6ae2 22 f9 fa			ld (display_write_tmp),hl  
6ae5			  
6ae5				  
6ae5 3e 78			ld a, kLCD_Line4  
6ae7 cd c5 6b		            CALL fLCD_Pos       ;Position cursor to location in A  
6aea 06 28			ld b, display_cols  
