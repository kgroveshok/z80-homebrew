11f1				ret 
11f1			 
11f1			; hl - points to file name 
11f1			; de - points to strings to add to file 
11f1			 
11f1			.genfile: 
11f1				push hl 
11f1				push de 
11f1			 
11f1				call clear_display 
11f1				ld a, display_row_1 
11f1				ld de, .genfiletxt 
11f1				call str_at_display 
11f1				call update_display 
11f1			 
11f1				pop de 
11f1				pop hl 
11f1			 
11f1			 
11f1				push de 
11f1				call storage_create 
11f1				; id in hl 
11f1				pop de   ; table of strings to add 
11f1			 
11f1			.genloop: 
11f1			 
11f1				push hl ; save id for next time around 
11f1				push de ; save de for next time around 
11f1			 
11f1				ex de, hl 
11f1				call loadwordinhl 
11f1				ex de, hl 
11f1			 
11f1				; need hl to be the id 
11f1				; need de to be the string ptr 
11f1				 
11f1				call storage_append 
11f1			 
11f1				pop de 
11f1				pop hl 
11f1			 
11f1				inc de 
11f1				inc de 
11f1			 
11f1				ld a,(de) 
11f1				cp 0 
11f1				jr nz, .genloop 
11f1				inc de 
11f1				ld a, (de) 
11f1				dec de 
11f1				cp 0 
11f1				jr nz, .genloop	 
11f1			 
11f1				ret 
11f1			 
