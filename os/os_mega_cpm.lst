11f1			 
11f1			config_fdir: 
11f1				; using the scratch dir go through and release the memory allocated for each string 
11f1				 
11f1				ld hl, scratch 
11f1			.cfdir:	ld e,(hl) 
11f1				inc hl 
11f1				ld d,(hl) 
11f1				inc hl 
11f1			 
11f1				ex de, hl 
11f1				call ishlzero 
11f1				ret z     ; return on null pointer 
11f1				call free 
11f1				ex de, hl 
11f1				jr .cfdir 
11f1			 
11f1			 
11f1				ret 
11f1			 
11f1			 
11f1			config_dir: 
11f1			 
11f1				; for the config menus that need to build a directory of storage call this routine 
11f1				; it will construct a menu in scratch to pass to menu 
11f1			 
11f1				; open storage device 
11f1			 
11f1				; execute DIR to build a list of files and their ids into scratch in menu format 
11f1				; once the menu has finished then will need to call config_fdir to release the strings 
11f1				 
11f1				; c = number items 
11f1			 
11f1				 
11f1				call storage_get_block_0 
11f1			 
11f1				ld hl, store_page     ; get current id count 
11f1				ld b, (hl) 
11f1				ld c, 0    ; count of files   
11f1			 
11f1			 
11f1				ld hl, scratch 
11f1				ld (store_tmp2), hl    ; location to poke strings 
11f1			 
11f1				; check for empty drive 
11f1			 
11f1				ld a, 0 
11f1				cp b 
11f1				jp z, .dirdone 
11f1			 
11f1				 
11f1					if DEBUG_FORTH_WORDS 
11f1						DMARK "Cdc" 
11f1						CALLMONITOR 
11f1					endif 
11f1			 
11f1			 
11f1			.diritem:	 
11f1				push bc 
11f1				; for each of the current ids do a search for them and if found push to stack 
11f1			 
11f1					ld hl, STORE_BLOCK_PHY 
11f1					ld d, 0		 ; look for extent 0 of block id as this contains file name 
11f1					ld e,b 
11f1			 
11f1					call storage_findnextid 
11f1			 
11f1			 
11f1					; if found hl will be non zero 
11f1			 
11f1					call ishlzero 
11f1					jr z, .dirnotfound 
11f1			 
11f1					; increase count 
11f1			 
11f1					pop bc	 
11f1					inc c 
11f1					push bc 
11f1					 
11f1			 
11f1					; get file header and push the file name 
11f1			 
11f1					ld de, store_page 
11f1					call storage_read_block 
11f1			 
11f1					; push file id to stack 
11f1				 
11f1					ld a, (store_page) 
11f1					ld h, 0 
11f1					ld l, a 
11f1			 
11f1					;call forth_push_numhl 
11f1					; TODO store id 
11f1			 
11f1					push hl 
11f1			 
11f1					; push extent count to stack  
11f1				 
11f1					ld hl, store_page+3 
11f1			 
11f1					; get file name length 
11f1			 
11f1					call strlenz   
11f1			 
11f1					inc hl   ; cover zero term 
11f1					inc hl  ; stick the id at the end of the area 
11f1			 
11f1					push hl 
11f1					pop bc    ; move length to bc 
11f1			 
11f1					call malloc 
11f1			 
11f1					; TODO save malloc area to scratch 
11f1			 
11f1					ex de, hl 
11f1					ld hl, (store_tmp2) 
11f1					ld (hl), e 
11f1					inc hl 
11f1					ld (hl), d 
11f1					inc hl 
11f1					ld (store_tmp2), hl 
11f1			 
11f1					 
11f1			 
11f1					;pop hl   ; get source 
11f1			;		ex de, hl    ; swap aronund	 
11f1			 
11f1					ld hl, store_page+3 
11f1					if DEBUG_FORTH_WORDS 
11f1						DMARK "CFd" 
11f1						CALLMONITOR 
11f1					endif 
11f1					ldir 
11f1			 
11f1					; de is past string, move back one and store id 
11f1					 
11f1					dec de 
11f1			 
11f1					; store file id 
11f1			 
11f1					pop hl 
11f1					ex de,hl 
11f1					ld (hl), e 
11f1			 
11f1					if DEBUG_FORTH_WORDS 
11f1						DMARK "Cdi" 
11f1						CALLMONITOR 
11f1					endif 
11f1					 
11f1			.dirnotfound: 
11f1					pop bc     
11f1					djnz .diritem 
11f1				 
11f1			.dirdone:	 
11f1			 
11f1			;		ld a, 0 
11f1					ld hl, (store_tmp2) 
11f1					ld (hl), 0 
11f1					inc hl 
11f1					ld (hl), 0 
11f1					inc hl 
11f1					; push a count of the dir items found 
11f1			 
11f1			;		ld h, 0 
11f1			;		ld l, c 
11f1			 
11f1				ret 
11f1			 
11f1			endif 
