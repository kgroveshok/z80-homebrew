8d91			;Number in a to decimal ASCII 
8d91			;adapted from 16 bit found in z80 Bits to 8 bit by Galandros 
8d91			;Example: display a=56 as "056" 
8d91			;input: a = number 
8d91			;Output: a=0,value of a in the screen 
8d91			;destroys af,bc (don't know about hl and de) 
8d91			DispAToASCII: 
8d91 0e 9c			ld	c,-100 
8d93 cd 9d 8d			call	.Na1 
8d96 0e f6			ld	c,-10 
8d98 cd 9d 8d			call	.Na1 
8d9b 0e ff			ld	c,-1 
8d9d 06 2f		.Na1:	ld	b,'0'-1 
8d9f 04			.Na2:	inc	b 
8da0 81				add	a,c 
8da1 38 fc			jr	c,.Na2 
8da3 91				sub	c		;works as add 100/10/1 
8da4 f5				push af		;safer than ld c,a 
8da5 78				ld	a,b		;char is in b 
8da6			;TODO	CALL	PUTCHAR	;plot a char. Replace with bcall(_PutC) or similar. 
8da6 f1				pop af		;safer than ld a,c 
8da7 c9				ret 
