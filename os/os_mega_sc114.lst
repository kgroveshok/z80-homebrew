8f2f			;------------------------------------------------------------------------------ 
8f2f			;     free                                                                    : 
8f2f			;                                                                             : 
8f2f			; Description                                                                 : 
8f2f			;     Return the space pointed to by HL to the heap. HL must be an address as : 
8f2f			;     returned by malloc, otherwise the behaviour is undefined.               : 
8f2f			;                                                                             : 
8f2f			;     Where possible, directly adjacent free blocks will be merged together   : 
8f2f			;     into larger blocks to help ensure that the heap does not become         : 
8f2f			;     excessively fragmented.                                                 : 
8f2f			;                                                                             : 
8f2f			;     free does not clear or set any other value into the freed space, and    : 
8f2f			;     therefore its contents may be visible through subsequent malloc's. The  : 
8f2f			;     caller should clear the freed space as required.                        : 
8f2f			;                                                                             : 
8f2f			;     This implementation of free uses the stack exclusively, and is          : 
8f2f			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
8f2f			;     advisable to disable interrupts before calling free, and recommended    : 
8f2f			;     to avoid the use of free inside ISRs in general.                        : 
8f2f			;                                                                             : 
8f2f			;     NOTE: heap_init must be called before malloc and free can be used.      : 
8f2f			;                                                                             : 
8f2f			; Parameters                                                                  : 
8f2f			;     HL  Pointer to address of first byte of allocation to be freed          : 
8f2f			;                                                                             : 
8f2f			; Returns                                                                     : 
8f2f			;     Nothing                                                                 : 
8f2f			;                                                                             : 
8f2f			; Stack frame                                                                 : 
8f2f			;       |             |                                                       : 
8f2f			;       +-------------+                                                       : 
8f2f			;       |     BC      |                                                       : 
8f2f			;       +-------------+                                                       : 
8f2f			;       |     DE      |                                                       : 
8f2f			;       +-------------+                                                       : 
8f2f			;       |     IX      |                                                       : 
8f2f			;       +-------------+                                                       : 
8f2f			;       |  prev_free  |                                                       : 
8f2f			;   +2  +-------------+                                                       : 
8f2f			;       |  next_free  |                                                       : 
8f2f			;   +0  +-------------+                                                       : 
8f2f			;       |             |                                                       : 
8f2f			;                                                                             : 
8f2f			;------------------------------------------------------------------------------ 
8f2f			free: 
8f2f c5			      push  BC 
8f30 d5			      push  DE 
8f31 dd e5		      push  IX 
8f33			 
8f33 7c			      ld    A, H                    ; Exit if ptr is null 
8f34 b5			      or    L 
8f35 ca f9 8f		      jp    Z, free_early_exit 
8f38			 
8f38			      ; Set up stack frame 
8f38 eb			      ex    DE, HL 
8f39 21 fc ff		      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
8f3c 39			      add   HL, SP 
8f3d f9			      ld    SP, HL 
8f3e dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
8f42 dd 39		      add   IX, SP 
8f44			 
8f44			      ; The address in HL points to the start of the useable allocated space, 
8f44			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
8f44			      ; address of the block itself. 
8f44 eb			      ex    DE, HL 
8f45 11 fc ff		      ld    DE, -4 
8f48 19			      add   HL, DE 
8f49			 
8f49			      ; An allocated block must have a null next block pointer in it 
8f49 7e			      ld    A, (HL) 
8f4a 23			      inc   HL 
8f4b b6			      or    (HL) 
8f4c c2 f4 8f		      jp    NZ, free_done 
8f4f			 
8f4f 2b			      dec   HL 
8f50			 
8f50 44			      ld    B, H                    ; Copy HL to BC 
8f51 4d			      ld    C, L 
8f52			 
8f52			      ; Loop through the free list to find the first block with an address 
8f52			      ; higher than the block being freed 
8f52 21 62 d6		      ld    HL, free_list 
8f55			 
8f55			free_find_higher_block: 
8f55 5e			      ld    E, (HL)                 ; Load next ptr from free block 
8f56 23			      inc   HL 
8f57 56			      ld    D, (HL) 
8f58 2b			      dec   HL 
8f59			 
8f59 dd 73 00		      ld    (IX+0), E               ; Save ptr to next free block 
8f5c dd 72 01		      ld    (IX+1), D 
8f5f dd 75 02		      ld    (IX+2), L               ; Save ptr to prev free block 
8f62 dd 74 03		      ld    (IX+3), H 
8f65			 
8f65 78			      ld    A, B                    ; Check if DE is greater than BC 
8f66 ba			      cp    D                       ; Compare MSB first 
8f67 28 02		      jr    Z, $+4                  ; MSB the same, compare LSB 
8f69 30 04		      jr    NC, free_find_higher_block_skip 
8f6b 79			      ld    A, C 
8f6c bb			      cp    E                       ; Then compare LSB 
8f6d 38 08		      jr    C, free_found_higher_block 
8f6f			 
8f6f			free_find_higher_block_skip: 
8f6f 7a			      ld    A, D                    ; Reached the end of the free list? 
8f70 b3			      or    E 
8f71 ca f4 8f		      jp    Z, free_done 
8f74			 
8f74 eb			      ex    DE, HL 
8f75			 
8f75 18 de		      jr    free_find_higher_block 
8f77			 
8f77			free_found_higher_block: 
8f77			      ; Insert freed block between prev and next free blocks 
8f77 71			      ld    (HL), C                 ; Point prev free block to freed block 
8f78 23			      inc   HL 
8f79 70			      ld    (HL), B 
8f7a			 
8f7a 60			      ld    H, B                    ; Point freed block at next free block 
8f7b 69			      ld    L, C 
8f7c 73			      ld    (HL), E 
8f7d 23			      inc   HL 
8f7e 72			      ld    (HL), D 
8f7f			 
8f7f			      ; Check if the freed block is adjacent to the next free block 
8f7f 23			      inc   HL                      ; Load size of freed block into HL 
8f80 5e			      ld    E, (HL) 
8f81 23			      inc   HL 
8f82 56			      ld    D, (HL) 
8f83 eb			      ex    DE, HL 
8f84			 
8f84 09			      add   HL, BC                  ; Add addr of freed block and its size 
8f85			 
8f85 dd 5e 00		      ld    E, (IX+0)               ; Load addr of next free block into DE 
8f88 dd 56 01		      ld    D, (IX+1) 
8f8b			 
8f8b b7			      or    A                       ; Clear the carry flag 
8f8c ed 52		      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
8f8e 20 22		      jr    NZ, free_check_adjacent_to_prev 
8f90			 
8f90			      ; Freed block is adjacent to next, merge into one bigger block 
8f90 eb			      ex    DE, HL                  ; Load next ptr from next block into DE 
8f91 5e			      ld    E, (HL) 
8f92 23			      inc   HL 
8f93 56			      ld    D, (HL) 
8f94 e5			      push  HL                      ; Save ptr to next block for later 
8f95			 
8f95 60			      ld    H, B                    ; Store ptr from next block into freed block 
8f96 69			      ld    L, C 
8f97 73			      ld    (HL), E 
8f98 23			      inc   HL 
8f99 72			      ld    (HL), D 
8f9a			 
8f9a e1			      pop   HL                      ; Restore ptr to next block 
8f9b 23			      inc   HL                      ; Load size of next block into DE 
8f9c 5e			      ld    E, (HL) 
8f9d 23			      inc   HL 
8f9e 56			      ld    D, (HL) 
8f9f d5			      push  DE                      ; Save next block size for later 
8fa0			 
8fa0 60			      ld    H, B                    ; Load size of freed block into HL 
8fa1 69			      ld    L, C 
8fa2 23			      inc   HL 
8fa3 23			      inc   HL 
8fa4 5e			      ld    E, (HL) 
8fa5 23			      inc   HL 
8fa6 56			      ld    D, (HL) 
8fa7 eb			      ex    DE, HL 
8fa8			 
8fa8 d1			      pop   DE                      ; Restore size of next block 
8fa9 19			      add   HL, DE                  ; Add sizes of both blocks 
8faa eb			      ex    DE, HL 
8fab			 
8fab 60			      ld    H, B                    ; Store new bigger size into freed block 
8fac 69			      ld    L, C 
8fad 23			      inc   HL 
8fae 23			      inc   HL 
8faf 73			      ld    (HL), E 
8fb0 23			      inc   HL 
8fb1 72			      ld    (HL), D 
8fb2			 
8fb2			free_check_adjacent_to_prev: 
8fb2			      ; Check if the freed block is adjacent to the prev free block 
8fb2 dd 6e 02		      ld    L, (IX+2)               ; Prev free block ptr into HL 
8fb5 dd 66 03		      ld    H, (IX+3) 
8fb8			 
8fb8 23			      inc   HL                      ; Size of prev free block into DE 
8fb9 23			      inc   HL 
8fba 5e			      ld    E, (HL) 
8fbb 23			      inc   HL 
8fbc 56			      ld    D, (HL) 
8fbd 2b			      dec   HL 
8fbe 2b			      dec   HL 
8fbf 2b			      dec   HL 
8fc0			 
8fc0 19			      add   HL, DE                  ; Add prev block addr and size 
8fc1			 
8fc1 b7			      or    A                       ; Clear the carry flag 
8fc2 ed 42		      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
8fc4 20 2e		      jr    NZ, free_done 
8fc6			 
8fc6			      ; Freed block is adjacent to prev, merge into one bigger block 
8fc6 60			      ld    H, B                    ; Load next ptr from freed block into DE 
8fc7 69			      ld    L, C 
8fc8 5e			      ld    E, (HL) 
8fc9 23			      inc   HL 
8fca 56			      ld    D, (HL) 
8fcb e5			      push  HL                      ; Save freed block ptr for later 
8fcc			 
8fcc dd 6e 02		      ld    L, (IX+2)               ; Store freed block ptr into prev block 
8fcf dd 66 03		      ld    H, (IX+3) 
8fd2 73			      ld    (HL), E 
8fd3 23			      inc   HL 
8fd4 72			      ld    (HL), D 
8fd5			 
8fd5 e1			      pop   HL                      ; Restore freed block ptr 
8fd6 23			      inc   HL                      ; Load size of freed block into DE 
8fd7 5e			      ld    E, (HL) 
8fd8 23			      inc   HL 
8fd9 56			      ld    D, (HL) 
8fda d5			      push  DE                      ; Save freed block size for later 
8fdb			 
8fdb dd 6e 02		      ld    L, (IX+2)               ; Load size of prev block into DE 
8fde dd 66 03		      ld    H, (IX+3) 
8fe1 23			      inc   HL 
8fe2 23			      inc   HL 
8fe3 5e			      ld    E, (HL) 
8fe4 23			      inc   HL 
8fe5 56			      ld    D, (HL) 
8fe6			 
8fe6 e1			      pop   HL                      ; Add sizes of both blocks 
8fe7 19			      add   HL, DE 
8fe8 eb			      ex    DE, HL 
8fe9			 
8fe9 dd 6e 02		      ld    L, (IX+2)               ; Store new bigger size into prev block 
8fec dd 66 03		      ld    H, (IX+3) 
8fef 23			      inc   HL 
8ff0 23			      inc   HL 
8ff1 73			      ld    (HL), E 
8ff2 23			      inc   HL 
8ff3 72			      ld    (HL), D 
8ff4			 
8ff4			free_done: 
8ff4 21 04 00		      ld    HL, 4                   ; Clean up stack frame 
8ff7 39			      add   HL, SP 
8ff8 f9			      ld    SP, HL 
8ff9			 
8ff9			free_early_exit: 
8ff9 dd e1		      pop   IX 
8ffb d1			      pop   DE 
8ffc c1			      pop   BC 
8ffd			 
8ffd c9			      ret 
