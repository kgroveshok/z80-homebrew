8fb1 5e			      ld    E, (HL) 
8fb2 23			      inc   HL 
8fb3 56			      ld    D, (HL) 
8fb4 e5			      push  HL                      ; Save ptr to next block for later 
8fb5			 
8fb5 60			      ld    H, B                    ; Store ptr from next block into freed block 
8fb6 69			      ld    L, C 
8fb7 73			      ld    (HL), E 
8fb8 23			      inc   HL 
8fb9 72			      ld    (HL), D 
8fba			 
8fba e1			      pop   HL                      ; Restore ptr to next block 
8fbb 23			      inc   HL                      ; Load size of next block into DE 
8fbc 5e			      ld    E, (HL) 
8fbd 23			      inc   HL 
8fbe 56			      ld    D, (HL) 
8fbf d5			      push  DE                      ; Save next block size for later 
8fc0			 
8fc0 60			      ld    H, B                    ; Load size of freed block into HL 
8fc1 69			      ld    L, C 
8fc2 23			      inc   HL 
8fc3 23			      inc   HL 
8fc4 5e			      ld    E, (HL) 
8fc5 23			      inc   HL 
8fc6 56			      ld    D, (HL) 
8fc7 eb			      ex    DE, HL 
8fc8			 
8fc8 d1			      pop   DE                      ; Restore size of next block 
8fc9 19			      add   HL, DE                  ; Add sizes of both blocks 
8fca eb			      ex    DE, HL 
8fcb			 
8fcb 60			      ld    H, B                    ; Store new bigger size into freed block 
8fcc 69			      ld    L, C 
8fcd 23			      inc   HL 
8fce 23			      inc   HL 
8fcf 73			      ld    (HL), E 
8fd0 23			      inc   HL 
8fd1 72			      ld    (HL), D 
