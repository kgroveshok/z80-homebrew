112c			;------------------------------------------------------------------------------ 
112c			;     heap_init                                                               : 
112c			;                                                                             : 
112c			; Description                                                                 : 
112c			;     Initialise the heap and make it ready for malloc and free operations.   : 
112c			;                                                                             : 
112c			;     The heap is maintained as a linked list, starting with an initial       : 
112c			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
112c			;     the first free block in the heap. Each block then points to the next    : 
112c			;     free block within the heap, and the free list ends at the first block   : 
112c			;     with a null pointer to the next free block.                             : 
112c			;                                                                             : 
112c			; Parameters                                                                  : 
112c			;     Inputs are compile-time only. Two defines which specify the starting    : 
112c			;     address of the heap and its size are required, along with a memory      : 
112c			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
112c			;     principally stores a pointer to the first free block in the heap.       : 
112c			;                                                                             : 
112c			; Returns                                                                     : 
112c			;     Nothing                                                                 : 
112c			;------------------------------------------------------------------------------ 
112c			heap_init: 
112c e5			      push  HL 
112d			 
112d			      ; Initialise free list struct 
112d 21 0e 80		      ld    HL, heap_start 
1130 22 0a 80		      ld    (free_list), HL 
1133 21 00 00		      ld    HL, 0 
1136 22 0c 80		      ld    (free_list+2), HL 
1139			 
1139			      ; Insert first free block at bottom of heap, consumes entire heap 
1139 21 af f0		      ld    HL, heap_start+heap_size-4 
113c 22 0e 80		      ld    (heap_start), HL        ; Next block (end of free list) 
113f 21 a1 70		      ld    HL, heap_size-4 
1142 22 10 80		      ld    (heap_start+2), HL      ; Block size 
1145			 
1145			      ; Insert end of free list block at top of heap - two null words will 
1145			      ; terminate the free list 
1145 21 00 00		      ld    HL, 0 
1148 22 b1 f0		      ld    (heap_start+heap_size-2), HL 
114b 22 af f0		      ld    (heap_start+heap_size-4), HL 
114e			 
114e e1			      pop   HL 
114f			 
114f c9			      ret 
