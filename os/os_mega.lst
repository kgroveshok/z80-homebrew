00a0			hardware_init:  
00a0			  
00a0					; Set bit for stack checks (if those features are enabled)  
00a0 2a af fd				ld hl, (hardware_config+1)  
00a3 cb fe				set 7, (hl)  
00a5			  
00a5					;ld a, 0  
00a5					;ld (hardware_diag), a  
00a5			  
00a5					; clear all the buffers  
00a5			  
00a5 21 40 fc				ld hl, display_fb1  
00a8 22 fc fa				ld (display_fb_active), hl  
00ab			  
00ab cd 75 0b				call clear_display  
00ae			  
00ae 21 fe fa				ld hl, display_fb2  
00b1 22 fc fa				ld (display_fb_active), hl  
00b4			  
00b4 cd 75 0b				call clear_display  
00b7			  
00b7					; init primary frame buffer area  
00b7 21 e1 fc				ld hl, display_fb0  
00ba 22 fc fa				ld (display_fb_active), hl  
00bd			  
00bd cd 75 0b				call clear_display  
00c0			  
00c0			  
00c0 cd 52 69				call lcd_init		; lcd hardware first as some screen functions called during key_init e.g. cursor shapes  
00c3			  
00c3 cd 2c 6b			call key_init  
00c6 cd da 02			call storage_init  
00c9				if TAPE_SUPPORT  
00c9 cd 3d 13				call tape_init  
00cc				endif  
00cc				if DART_SUPPORT  
00cc					call dart_init  
00cc				endif  
00cc			  
00cc				; setup malloc functions  
00cc			  
00cc				if MALLOC_1  
00cc cd 63 11				call  heap_init  
00cf				endif  
00cf				if MALLOC_4  
00cf					call  heap_init  
00cf				endif  
00cf			  
00cf				; init sound hardware if present  
00cf			  
00cf				if SOUND_ENABLE  
00cf cd ed 15				call sound_init  
00d2				endif  
00d2			  
00d2				; lcd test sequence  
00d2					  
00d2 cd ad 0b			call update_display  
00d5 cd b4 0a			call delay1s  
00d8 3e 2b			ld a,'+'  
00da cd 7a 0b			call fill_display  
00dd cd ad 0b			call update_display  
00e0 cd b4 0a			call delay1s  
00e3 3e 2a			ld a,'*'  
00e5 cd 7a 0b			call fill_display  
00e8 cd ad 0b			call update_display  
00eb cd b4 0a			call delay1s  
00ee 3e 2d			ld a,'-'  
00f0 cd 7a 0b			call fill_display  
00f3 cd ad 0b			call update_display  
00f6 cd b4 0a			call delay1s  
00f9			  
00f9			; boot splash screen  
00f9			if display_cols == 20	  
00f9			        ld a, display_row_1    
00f9			else  
00f9 3e 0a		        ld a, display_row_1 +10   
00fb			endif  
00fb 11 f2 1b			ld de, prom_bootmsg  
00fe cd 87 0b			call str_at_display  
0101 cd ad 0b			call update_display  
0104			  
0104			  
0104 cd b4 0a			call delay1s  
0107 cd b4 0a			call delay1s  
010a			if display_cols == 20	  
010a			            LD   A, display_row_3+2  
010a			else  
010a 3e 5c		            LD   A, display_row_3+12  
010c			endif  
010c 11 07 1c			ld de, prom_bootmsg1  
010f cd 87 0b			call str_at_display  
0112			; display debug level  
0112 3e 78		            LD   A, display_row_4  
0114 11 03 00			ld de, debuglevel  
0117 cd 87 0b			call str_at_display  
011a			  
