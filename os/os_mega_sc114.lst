8e35			StrictStrCmp: 
8e35				; Load next chars of each string 
8e35 1a				ld a, (de) 
8e36 47				ld b, a 
8e37 7e				ld a, (hl) 
8e38				; Compare 
8e38 b8				cp b 
8e39				; Return non-zero if chars don't match 
8e39 c0				ret nz 
8e3a				; Check for end of both strings 
8e3a fe 00			cp "\0" 
8e3c				; Return if strings have ended 
8e3c c8				ret z 
8e3d				; Otherwise, advance to next chars 
8e3d 23				inc hl 
8e3e 13				inc de 
8e3f 18 f4			jr StrictStrCmp 
