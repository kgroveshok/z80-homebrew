1cae ed 5b 18 ea		ld de,(cli_origptr)   ; move to next token to parse in the input stream 
1cb2 2a 9c e5			ld hl,(os_tok_ptr)   ; move to next token to parse in the input stream 
1cb5			if DEBUG_FORTH_PARSE_EXEC 
1cb5				DMARK "}AA" 
1cb5				CALLMONITOR 
1cb5			endif	 
1cb5 c3 9a 1d			jp execnext 
