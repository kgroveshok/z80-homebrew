105c			; Decimal Unsigned Version 
105c			 
105c			;Number in a to decimal ASCII 
105c			;adapted from 16 bit found in z80 Bits to 8 bit by Galandros 
105c			;Example: display a=56 as "056" 
105c			;input: a = number 
105c			;Output: a=0,value of a in the screen 
105c			;destroys af,bc (don't know about hl and de) 
105c			DispAToASCII: 
105c 0e 9c			ld	c,-100 
105e cd 68 10			call	.Na1 
1061 0e f6			ld	c,-10 
1063 cd 68 10			call	.Na1 
1066 0e ff			ld	c,-1 
1068 06 2f		.Na1:	ld	b,'0'-1 
106a 04			.Na2:	inc	b 
106b 81				add	a,c 
106c 38 fc			jr	c,.Na2 
106e 91				sub	c		;works as add 100/10/1 
106f f5				push af		;safer than ld c,a 
1070 78				ld	a,b		;char is in b 
1071			;TODO	CALL	PUTCHAR	;plot a char. Replace with bcall(_PutC) or similar. 
1071 f1				pop af		;safer than ld a,c 
1072 c9				ret 
