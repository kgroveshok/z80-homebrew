161b			 
161b			; see 595 for the shift bit flags 
161b			 
161b			; sound is complete when the shift reg is latched 
161b			;sound_bit_d2: equ 3 
161b			 
161b			; A contains byte to send 
161b			note_byte: 
161b 0e 00			ld c, SOUND_DEVICE 
161d cd 7c 1d			call shift_byte 
