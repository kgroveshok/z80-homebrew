249d			;WORD_SYS_LOWPRIM: equ 4    ; Offset for low level prim words opcode 
249d			;WORD_SYS_BRANCH: equ 10    ; Offset for branching and loop words opcode 
249d			WORD_SYS_UWORD: equ 1   ; Opcode for all user words 
249d			WORD_SYS_DELETED: equ 3 ; Op code for a deleted UWORD 
249d			WORD_SYS_ROOT: equ 0   ; Opcode for all user words 
249d			WORD_SYS_END: equ 0   ; Opcode for all user words 
249d			WORD_SYS_CORE: equ 20    ; Offset for dict core words opcode 
249d			WORD_FLAG_CODE: equ 0	   ; opcodeflag to exec pure code for this word 
249d			WORD_FLAG_JP: equ 1	   ; opcodeflag to list zero term jump table words 
249d			 
249d			; Core word preamble macro 
249d			 
249d			CWHEAD:   macro nxtword opcode lit len opflags 
249d				db WORD_SYS_CORE+opcode             
249d				; internal op code number 
249d				dw nxtword            
249d				; link to next dict word block 
249d				db len + 1 
249d				; literal length of dict word inc zero term 
249d				db lit,0              
249d				; literal dict word 
249d			        ; TODO db opflags        
249d				endm 
