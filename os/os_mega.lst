1178			; only care about direct match or not 
1178			; hl and de strings 
1178			; zero set if the same 
1178			 
1178			strcmp: 
1178 1a				ld a, (de) 
1179 be				cp (hl) 
117a 28 02			jr z, .ssame 
117c b7				or a 
117d c9				ret 
117e			 
