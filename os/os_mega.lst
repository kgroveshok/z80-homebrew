6c0b			; **  Private functions  
6c0b			; **********************************************************************  
6c0b			  
6c0b			; Write function to LCD  
6c0b			;   On entry: A = Function byte to be written  
6c0b			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6c0b 3e 20		WrFn4bit:   LD   A, 00100000b  ;4-bit mode  
6c0d 18 02		            JR   WrFunc  
6c0f 3e 30		WrFn8bit:   LD   A, 00110000b  ;8-bit mode  
6c11 f5			WrFunc:     PUSH AF  
6c12 f5					push af  
6c13 3a fb fa				ld a, (display_lcde1e2)  
6c16 fe 00				cp 0     ; e1  
6c18 20 0f				jr nz, .wfea2	  
6c1a f1					pop af  
6c1b d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6c1d cb df		            SET  kLCDBitE, A     ; TODO Decide which E is being set  
6c1f cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6c21 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6c23 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6c25 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6c27 18 0d			jr .wfskip  
6c29 f1			.wfea2:		pop af  
6c2a d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6c2c cb c7		            SET  kLCDBitE2, A     ; TODO Decide which E is being set  
6c2e cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6c30 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6c32 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6c34 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6c36 3e 05		.wfskip:            LD  A, 5  
6c38 cd 3f 6c		            CALL LCDDelay       ;Delay 5 ms to complete  
6c3b f1			            POP  AF  
6c3c c9			            RET  
6c3d			  
6c3d			  
6c3d			; Delay in milliseconds  
6c3d			;   On entry: A = Number of milliseconds delay  
6c3d			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6c3d 3e 01		LCDDelay1:  LD   A, 1           ;Delay by 1 ms  
6c3f d5			LCDDelay:   PUSH DE  
6c40 5f			            LD   E, A           ;Delay by 'A' ms  
6c41 16 00		            LD   D, 0  
6c43 cd 62 0a		            CALL aDelayInMS  
6c46 d1			            POP  DE  
6c47 c9			            RET  
