c084 .. 00			db "VAR",0              
c088				endm 
# End of macro CWHEAD
c088			; | VAR ( u1 -- )  Get the address of the (word) variable referenced on TOS  | DONE 
c088			; | 
c088			; | | The variable name should consist of a single letter (a-z). e.g. "a" 
c088			; | |  
c088			; | | e.g. 
c088			; | |         #30 a var ! 
c088			; | |         a var @ . 
c088			; | |   
c088			; | |     Displays the number 30 
c088			; | | 
c088			; | | Each variable pointer is a word so can use for any words that use that:  
c088			; | |  
c088			; | | e.g. 
c088			; | |  
c088			; | |         #30 a var 2! 
c088			; | |         a var 2@ . 
c088			; | |   
c088			; | |     Displays the number 30 
c088			; | |  
c088			; | | > [!NOTE]  
c088			; ! | > If a full string is passed then only the first char is looked at 
c088			; | | > Any other char could exceed bounds checks!  
c088			; | | > 
c088			; | | > Each variable location follows the previous. Watch you don't clobber any others. 
c088			 
c088					if DEBUG_FORTH_WORDS_KEY 
c088						DMARK "VAR" 
c088				if DEMARK_VERSION = 1  
c088 e5					push hl  
c089 21 91 c0				ld hl, .dmark  
c08c 22 60 ee				ld (debug_mark), hl  
c08f				endif  
c08f				if DEMARK_VERSION = 0  
c08f					push af  
c08f					ld a, (.dmark)  
c08f					ld (debug_mark),a  
c08f					ld a, (.dmark+1)  
c08f					ld (debug_mark+1),a  
c08f					ld a, (.dmark+2)  
c08f					ld (debug_mark+2),a  
c08f				endif  
c08f 18 04			jr .pastdmark  
c091 ..			.dmark: db "VAR"  
c094				if DEMARK_VERSION = 1  
c094 00					db 0  
c095				endif  
c095				if DEMARK_VERSION = 1  
c095 e1			.pastdmark: pop hl  
c096				endif  
c096				if DEMARK_VERSION = 0  
c096			.pastdmark: pop af  
c096				endif  
c096			endm  
# End of macro DMARK
c096						CALLMONITOR 
