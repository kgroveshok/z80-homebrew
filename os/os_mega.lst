69e0			; **  Constants  
69e0			; **********************************************************************  
69e0			  
69e0			; Constants that must be defined externally  
69e0			;kLCDPrt:   EQU 0xc0           ;Port address used for LCD  
69e0			;kLCDBitRS: EQU 2              ;Port bit for LCD RS signal  
69e0			;kLCDBitE:  EQU 3              ;Port bit for LCD E signal  
69e0			;kLCDWidth: EQU 20             ;Width in characters  
69e0			  
69e0			; general line offsets in any frame buffer  
69e0			  
69e0			  
69e0			display_row_1: equ 0  
69e0			display_row_2: equ display_row_1+display_cols  
69e0			display_row_3: equ display_row_2 + display_cols  
69e0			display_row_4: equ display_row_3 + display_cols  
69e0			;display_row_4_eol:   
69e0			  
69e0			  
69e0			; Cursor position values for the start of each line  
69e0			  
69e0			; E  
69e0			kLCD_Line1: EQU 0x00   
69e0			kLCD_Line2: EQU kLCD_Line1+kLCDWidth  
69e0			; E1  
69e0			kLCD_Line3: EQU kLCD_Line2+kLCDWidth  
69e0			kLCD_Line4: EQU kLCD_Line3+kLCDWidth   
69e0			  
69e0			; Instructions to send as A register to fLCD_Inst  
69e0			kLCD_Clear: EQU 00000001b     ;LCD clear  
69e0			kLCD_Off:   EQU 00001000b     ;LCD off  
69e0			kLCD_On:    EQU 00001100b     ;LCD on, no cursor or blink  
69e0			kLCD_Under: EQU 00001110b     ;LCD on, cursor = underscore  
69e0			kLCD_Blink: EQU 00001101b     ;LCD on, cursor = blink block  
69e0			kLCD_Both:  EQU 00001111b     ;LCD on, cursor = under+blink  
69e0			  
69e0			; Constants used by this code module  
69e0			kLCD_Clr:   EQU 00000001b     ;LCD command: Clear display  
69e0			kLCD_Pos:   EQU 10000000b     ;LCD command: Position cursor  
69e0			kLCD_Def:   EQU 01000000b     ;LCD command: Define character  
69e0			  
69e0			  
