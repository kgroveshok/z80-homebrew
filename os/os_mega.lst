0df5 4f			    ld    c, a    ; L = A+L 
0df6 88			    adc   a, b    ; A = A+L+H+carry 
0df7 91			    sub   c       ; A = H+carry 
0df8 47			    ld    b, a    ; H = H+carry 
0df9 c9			ret 
