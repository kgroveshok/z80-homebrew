116c d1			      pop   DE                      ; Restore size of next block 
116d 19			      add   HL, DE                  ; Add sizes of both blocks 
116e eb			      ex    DE, HL 
116f			 
116f 60			      ld    H, B                    ; Store new bigger size into freed block 
1170 69			      ld    L, C 
1171 23			      inc   HL 
1172 23			      inc   HL 
1173 73			      ld    (HL), E 
1174 23			      inc   HL 
1175 72			      ld    (HL), D 
