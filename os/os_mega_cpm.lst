5a78			display_row_3: equ display_row_2 + display_cols 
5a78			display_row_4: equ display_row_3 + display_cols 
5a78			 
5a78			kLCDWidth:  EQU display_cols             ;Width in characters 
5a78			kLCD_Line1: EQU 0x00  
5a78			kLCD_Line2: EQU kLCD_Line1+kLCDWidth 
5a78			; E1 
5a78			kLCD_Line3: EQU kLCD_Line2+kLCDWidth 
5a78			kLCD_Line4: EQU kLCD_Line3+kLCDWidth  
