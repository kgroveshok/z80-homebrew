69a1			include "firmware_lcd_4x40.asm" 
69a1			; **********************************************************************  
69a1			; **  Alphanumeric LCD example                  by Stephen C Cousins  **  
69a1			; **********************************************************************  
69a1			;  
69a1			; **  Written as a Small Computer Monitor App  
69a1			; **  www.scc.me.uk  
69a1			;  
69a1			; History  
69a1			; 2018-05-20  v0.2.0  SCC  Example for LiNC80 SBC1 only  
69a1			; 2018-06-28  v0.3.0  SCC  Added support for RC2014 and Z280RC  
69a1			; 2019-09-14  v0.4.0  SCC  Added support for SC129 digital I/O module  
69a1			;  
69a1			; **********************************************************************  
69a1			;  
69a1			; This program is an example of one of the methods of interfacing an   
69a1			; alphanumeric LCD module.   
69a1			;  
69a1			; In this example the display is connected to either a Z80 PIO or a   
69a1			; simple 8-bit output port.   
69a1			;  
69a1			; This interfacing method uses 4-bit data mode and uses time delays  
69a1			; rather than polling the display's ready status. As a result the   
69a1			; interface only requires 6 simple output lines:  
69a1			;   Output bit 0 = not used  
69a1			;   Output bit 1 = not used  
69a1			;   Output bit 2 = RS         High = data, Low = instruction  
69a1			;   Output bit 3 = E          Active high  
69a1			;   Output bit 4 = DB4  
69a1			;   Output bit 5 = DB5  
69a1			;   Output bit 6 = DB6  
69a1			;   Output bit 7 = DB7  
69a1			; Display's R/W is connected to 0v so it is always in write mode  
69a1			;  
69a1			; This set up should work with any system supporting the RC2014 bus  
69a1			  
69a1			; To set up PIO port A in mode 3 (control) using LiNC80 as example  
69a1			;   I/O address 0x1A = 0b11001111 (0xCF)   Select mode 3 (control)  
69a1			;   I/O address 0x1A = 0b00000000 (0x00)   All pins are output  
69a1			;  
69a1			; **********************************************************************  
69a1			  
69a1			; Additonal for 4x40. E1 and E2 instead of just E   
69a1			; TODO swipe vidout signal on port a to activate E2  
69a1			  
69a1			; **********************************************************************  
69a1			; **  Constants  
69a1			; **********************************************************************  
69a1			; LCD constants required by LCD support module  
69a1			kLCDPrt:    EQU kDataReg       ;LCD port is the PIO port A data reg  
69a1			kLCDBitRS:  EQU 2              ;Port bit for LCD RS signal  
69a1			kLCDBitE:   EQU 3              ;Port bit for LCD E signal             
69a1			kLCDBitE2:   EQU 0              ;Port bit for LCD E2 signal            VICLK  
69a1			kLCDBitLED:   EQU 1              ;Port bit for LCD E2 signal            VIDDO  
69a1			; TODO Decide which E is being set  
69a1			kLCDWidth:  EQU display_cols             ;Width in characters  
69a1			  
69a1			; **********************************************************************  
69a1			; **  Code library usage  
69a1			; **********************************************************************  
69a1			  
69a1			; send character to current cursor position  
69a1			; wraps and/or scrolls screen automatically  
69a1			  
69a1			  
69a1			  
69a1			lcd_init:  
69a1			  
69a1			; SCMonAPI functions used  
69a1			  
69a1			; Alphanumeric LCD functions used  
69a1			; no need to specify specific functions for this module  
69a1			  
69a1 3e cf		            LD   A, 11001111b  
69a3 d3 c2		            OUT  (kContReg), A  ;Port A = PIO 'control' mode  
69a5 3e 00		            LD   A, 00000000b  
69a7 d3 c2		            OUT  (kContReg),A   ;Port A = all lines are outputs  
69a9			  
69a9			; Initialise alphanumeric LCD module  
69a9 3e 00				ld a, 0  
69ab 32 fb fa				ld (display_lcde1e2), a  
69ae cd 2f 6a		            CALL fLCD_Init      ;Initialise LCD module  
69b1 3e 01				ld a, 1  
69b3 32 fb fa				ld (display_lcde1e2), a  
69b6 cd 2f 6a		            CALL fLCD_Init      ;Initialise LCD module  
69b9			  
69b9 c9				ret  
69ba			  
69ba			;  
69ba			;;  
69ba			; lcd functions  
69ba			;  
69ba			;  
69ba			  
69ba			; what is at cursor position   
69ba			  
69ba			;get_cursor:	ld de, (cursor_row)   ;  row + col  
69ba			;		call curptr  
69ba			;		ret  
69ba			  
69ba			  
