15dd 00				nop  
15de 00				nop  
15df 00				nop  
15e0 00				nop  
15e1				; we low 
15e1 d3 00			out (SOUND_DEVICE), a 
15e3			;	ld a, 1 
15e3			;	call aDelayInMS 
15e3 00				nop  
15e4 00				nop  
15e5 00				nop  
15e6 00				nop  
15e7				; we high 
