1120			; https://tutorials.eeems.ca/ASMin28Days/lesson/day16.html#cmp 
1120			 
1120			; String Length 
1120			;With a length-prefixed string, finding the length is trivial. For a null-terminated string, the process is decidedly more involved. This is where CPIR comes in. 
1120			 
1120			; Get the length of the null-terminated string starting at $8000 hl 
1120			;    LD     HL, $8000 
1120			 
1120			strlenz: 
1120			 
1120 af			    XOR    A               ; Zero is the value we are looking for. 
1121 47			    LD     B, A             ; Since we haven't the slightest clue as to the  
1122 4f			    LD     C, A             ; actual size of the string, put 0 in BC to search 
1123			                           ; 65, 536 bytes (the entire addressable memory space). 
1123 ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
1125			 
1125			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
1125 67			    LD     H, A             ; Zero HL (basically set it to 65, 536) to get the 
1126 6f			    LD     L, A             ; number of bytes 
1127 ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
1129 2b			    DEC    HL              ; Compensate for null. 
112a c9				ret 
112b			 
112b			; Get the length of the A terminated string starting at $8000 hl 
112b			;    LD     HL, $8000 
112b			 
112b			strlent: 
112b			 
112b			                  ; A is the value we are looking for. 
112b 06 00		    LD     B, 0             ; Since we haven't the slightest clue as to the  
112d 0e 00		    LD     C, 0             ; actual size of the string, put 0 in BC to search 
112f			                           ; 65, 536 bytes (the entire addressable memory space). 
112f ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
1131			 
1131			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
1131 26 00		    LD     H, 0             ; Zero HL (basically set it to 65, 536) to get the 
1133 2e 00		    LD     L, 0             ; number of bytes 
1135 ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
1137 2b			    DEC    HL              ; Compensate for null. 
1138 c9				ret 
1139			 
1139			 
1139			;Comparing Strings 
1139			 
1139			;IN    HL     Address of string1. 
1139			;      DE     Address of string2. 
1139			 
1139			; doc given but wrong??? 
1139			;OUT   zero   Set if string1 = string2, reset if string1 != string2. 
1139			;      carry  Set if string1 > string2, reset if string1 <= string2. 
1139			; tested 
1139			;OUT   carry set  if string1 = string2, carry  reset if string1 != string2. 
1139			 
1139			strcmp_old: 
1139 e5			    PUSH   HL 
113a d5			    PUSH   DE 
113b			 
113b 1a			    LD     A, (DE)          ; Compare lengths to determine smaller string 
113c be			    CP     (HL)            ; (want to minimize work). 
113d 38 01		    JR     C, Str1IsBigger 
113f 7e			    LD     A, (HL) 
1140			 
1140			Str1IsBigger: 
1140 4f			    LD     C, A             ; Put length in BC 
1141 06 00		    LD     B, 0 
1143 13			    INC    DE              ; Increment pointers to meat of string. 
1144 23			    INC    HL 
1145			 
1145			CmpLoop: 
1145 1a			    LD     A, (DE)          ; Compare bytes. 
1146 ed a1		    CPI 
1148 20 09		    JR     NZ, NoMatch      ; If (HL) != (DE), abort. 
114a 13			    INC    DE              ; Update pointer. 
114b ea 45 11		    JP     PE, CmpLoop 
114e			 
114e d1			    POP    DE 
114f e1			    POP    HL 
1150 1a			    LD     A, (DE)          ; Check string lengths to see if really equal. 
1151 be			    CP     (HL) 
1152 c9			    RET 
1153			 
1153			NoMatch: 
1153 2b			    DEC    HL 
1154 be			    CP     (HL)            ; Compare again to affect carry. 
1155 d1			    POP    DE 
1156 e1			    POP    HL 
1157 c9			    RET 
