# End of macro CWHEAD
53d2			; | VAR ( u1 -- )  Get the address of the (word) variable referenced on TOS  | DONE 
53d2			; | 
53d2			; | | The variable name should consist of a single letter (a-z). e.g. "a" 
53d2			; | |  
53d2			; | | e.g. 
53d2			; | |         #30 a var ! 
53d2			; | |         a var @ . 
53d2			; | |   
53d2			; | |     Displays the number 30 
53d2			; | | 
53d2			; | | Each variable pointer is a word so can use for any words that use that:  
53d2			; | |  
53d2			; | | e.g. 
53d2			; | |  
53d2			; | |         #30 a var 2! 
53d2			; | |         a var 2@ . 
53d2			; | |   
53d2			; | |     Displays the number 30 
53d2			; | |  
53d2			; | | > [!NOTE]  
53d2			; ! | > If a full string is passed then only the first char is looked at 
53d2			; | | > Any other char could exceed bounds checks!  
53d2			; | | > 
53d2			; | | > Each variable location follows the previous. Watch you don't clobber any others. 
53d2			 
53d2					if DEBUG_FORTH_WORDS_KEY 
53d2						DMARK "VAR" 
53d2				if DEMARK_VERSION = 1  
53d2 e5					push hl  
53d3 21 db 53				ld hl, .dmark  
53d6 22 9b fd				ld (debug_mark), hl  
53d9				endif  
53d9				if DEMARK_VERSION = 0  
53d9					push af  
53d9					ld a, (.dmark)  
53d9					ld (debug_mark),a  
53d9					ld a, (.dmark+1)  
53d9					ld (debug_mark+1),a  
53d9					ld a, (.dmark+2)  
53d9					ld (debug_mark+2),a  
53d9				endif  
53d9 18 04			jr .pastdmark  
53db ..			.dmark: db "VAR"  
53de				if DEMARK_VERSION = 1  
53de 00					db 0  
53df				endif  
53df				if DEMARK_VERSION = 1  
53df e1			.pastdmark: pop hl  
53e0				endif  
53e0				if DEMARK_VERSION = 0  
53e0			.pastdmark: pop af  
53e0				endif  
53e0			endm  
# End of macro DMARK
53e0						CALLMONITOR 
53e0				if BASE_CPM=1  
53e0					call debug_vector  
53e0				endif  
53e0				if BASE_KEV=1  
