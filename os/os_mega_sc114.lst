d572 f7				rst $30 
d573			 
d573			 
d573 0e 02			ld c, 2 
d575				;ld de, .cls 
d575 3e 5b			ld a, '[' 
d577 f7				rst $30 
d578 0e 02			ld c, 2 
d57a				;ld de, .cls 
