1306			; encoding 
1306			;  
1306			; pulse marks  of stream 
1306			; proportial 
1306			 
1306			 
1306			; setup default tape params 
1306			tape_init:     
1306 3e 00			ld a, Device_A 
1308 32 89 f9			ld (tape_port), a 
130b			 
130b 3e fa			ld a, 250 
130d 32 84 f9			ld (tape_tm_gap), a 
1310			 
1310 21 40 1f			ld hl, 8000 
1313 22 85 f9			ld (tape_samples), hl 
1316			 
1316 3e 06			ld a, 6 
1318 32 88 f9			ld (tape_pulse_high), a 
131b			 
131b 3e 02			ld a, 2 
131d 32 87 f9			ld (tape_pulse_low), a 
1320			 
1320 21 32 00			ld hl, 50 
1323 22 82 f9			ld (tape_tm_high), hl 
1326			 
1326 21 32 00			ld hl, 50 
1329 22 80 f9			ld (tape_tm_low), hl 
132c c9				ret 
132d			 
132d			; support routinues for tape 
132d			 
132d			 
132d			; Tape Output 
132d			 
132d			; osciallate the pin for the required duration 
132d			 
132d			tape_osc:  
132d				; hl has the number of iterations 
132d				; c = port number 
132d				; d = bus data 
132d				 
132d ed 51			out (c), d 
132f			 
132f 2b				dec hl 
1330 cd ad 0d			call ishlzero 
1333 20 f8			jr nz, tape_osc 
1335				 
1335 c9				ret 
1336			 
1336			; output a gap period 
1336			tape_gap:  
1336 3a 84 f9			ld a, (tape_tm_gap) 
1339 cd 62 0a			call aDelayInMS 
133c c9				ret 
133d			 
133d			tape_byte_gap: 
133d cd 36 13			call tape_gap 
1340 cd 36 13			call tape_gap 
1343 cd 36 13			call tape_gap 
1346 cd 36 13			call tape_gap 
1349 c9				ret 
134a			 
134a			; output a high period 
134a			 
134a			tape_high: 
134a 3a 89 f9			ld a, (tape_port) 
134d 4f				ld c, a 
134e 16 ff			ld d, 255 
1350 3a 88 f9			ld a, (tape_pulse_high) 
1353 47				ld b, a 
1354 2a 82 f9		.th:	ld hl, (tape_tm_high) 
1357 cd 2d 13			call tape_osc 
135a 10 f8			djnz .th 
135c c9				 ret 
135d			 
135d			; output a low period 
135d			 
135d			tape_low:  
135d			 
135d 3a 89 f9			ld a, (tape_port) 
1360 4f				ld c, a 
1361 16 ff			ld d, 255 
1363 3a 87 f9			ld a, (tape_pulse_low) 
1366 47				ld b, a 
1367 2a 82 f9		.tl:	ld hl, (tape_tm_high) 
136a			; keep the same pulse size and instead use count of pulse rather than length of pulse 
136a			;	ld hl, (tape_tm_low) 
136a cd 2d 13			call tape_osc 
136d 10 f8			djnz .tl 
136f c9				 ret 
1370			 
1370			; end of save marker 
1370			 
1370			tape_end: 
1370 3e ff			ld a, 255 
1372 cd 89 13			call tape_byte_out 
