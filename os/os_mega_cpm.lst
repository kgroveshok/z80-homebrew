44cb			.VARS: 
44cb				CWHEAD .V0 99 "VAR" 3 WORD_FLAG_CODE 
44cb 77				db WORD_SYS_CORE+99             
44cc 48 45			dw .V0            
44ce 04				db 3 + 1 
44cf .. 00			db "VAR",0              
44d3				endm 
# End of macro CWHEAD
44d3			; | VAR ( u1 -- )  Get the address of the (word) variable referenced on TOS  | DONE 
44d3			; | 
44d3			; | | The variable name should consist of a single letter (a-z). e.g. "a" 
44d3			; | |  
44d3			; | | e.g. 
44d3			; | |         #30 a var ! 
44d3			; | |         a var @ . 
44d3			; | |   
44d3			; | |     Displays the number 30 
44d3			; | | 
44d3			; | | Each variable pointer is a word so can use for any words that use that:  
44d3			; | |  
44d3			; | | e.g. 
44d3			; | |  
44d3			; | |         #30 a var 2! 
44d3			; | |         a var 2@ . 
44d3			; | |   
44d3			; | |     Displays the number 30 
44d3			; | |  
44d3			; | | > [!NOTE]  
44d3			; ! | > If a full string is passed then only the first char is looked at 
44d3			; | | > Any other char could exceed bounds checks!  
44d3			; | | > 
44d3			; | | > Each variable location follows the previous. Watch you don't clobber any others. 
44d3			 
44d3					if DEBUG_FORTH_WORDS_KEY 
44d3						DMARK "VAR" 
44d3				if DEMARK_VERSION = 1  
44d3 e5					push hl  
44d4 21 dc 44				ld hl, .dmark  
44d7 22 60 ee				ld (debug_mark), hl  
44da				endif  
44da				if DEMARK_VERSION = 0  
44da					push af  
44da					ld a, (.dmark)  
44da					ld (debug_mark),a  
44da					ld a, (.dmark+1)  
44da					ld (debug_mark+1),a  
44da					ld a, (.dmark+2)  
44da					ld (debug_mark+2),a  
44da				endif  
44da 18 04			jr .pastdmark  
44dc ..			.dmark: db "VAR"  
44df				if DEMARK_VERSION = 1  
44df 00					db 0  
44e0				endif  
44e0				if DEMARK_VERSION = 1  
44e0 e1			.pastdmark: pop hl  
44e1				endif  
44e1				if DEMARK_VERSION = 0  
44e1			.pastdmark: pop af  
44e1				endif  
44e1			endm  
# End of macro DMARK
