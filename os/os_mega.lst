6a6e			; **********************************************************************  
6a6e			; **  Alphanumeric LCD example                  by Stephen C Cousins  **  
6a6e			; **********************************************************************  
6a6e			;  
6a6e			; **  Written as a Small Computer Monitor App  
6a6e			; **  www.scc.me.uk  
6a6e			;  
6a6e			; History  
6a6e			; 2018-05-20  v0.2.0  SCC  Example for LiNC80 SBC1 only  
6a6e			; 2018-06-28  v0.3.0  SCC  Added support for RC2014 and Z280RC  
6a6e			; 2019-09-14  v0.4.0  SCC  Added support for SC129 digital I/O module  
6a6e			;  
6a6e			; **********************************************************************  
6a6e			;  
6a6e			; This program is an example of one of the methods of interfacing an   
6a6e			; alphanumeric LCD module.   
6a6e			;  
6a6e			; In this example the display is connected to either a Z80 PIO or a   
6a6e			; simple 8-bit output port.   
6a6e			;  
6a6e			; This interfacing method uses 4-bit data mode and uses time delays  
6a6e			; rather than polling the display's ready status. As a result the   
6a6e			; interface only requires 6 simple output lines:  
6a6e			;   Output bit 0 = not used  
6a6e			;   Output bit 1 = not used  
6a6e			;   Output bit 2 = RS         High = data, Low = instruction  
6a6e			;   Output bit 3 = E          Active high  
6a6e			;   Output bit 4 = DB4  
6a6e			;   Output bit 5 = DB5  
6a6e			;   Output bit 6 = DB6  
6a6e			;   Output bit 7 = DB7  
6a6e			; Display's R/W is connected to 0v so it is always in write mode  
6a6e			;  
6a6e			; This set up should work with any system supporting the RC2014 bus  
6a6e			  
6a6e			; To set up PIO port A in mode 3 (control) using LiNC80 as example  
6a6e			;   I/O address 0x1A = 0b11001111 (0xCF)   Select mode 3 (control)  
6a6e			;   I/O address 0x1A = 0b00000000 (0x00)   All pins are output  
6a6e			;  
6a6e			; **********************************************************************  
6a6e			  
6a6e			; Additonal for 4x40. E1 and E2 instead of just E   
6a6e			; TODO swipe vidout signal on port a to activate E2  
6a6e			  
6a6e			; **********************************************************************  
6a6e			; **  Constants  
6a6e			; **********************************************************************  
6a6e			; LCD constants required by LCD support module  
6a6e			kLCDPrt:    EQU kDataReg       ;LCD port is the PIO port A data reg  
6a6e			kLCDBitRS:  EQU 2              ;Port bit for LCD RS signal  
6a6e			kLCDBitE:   EQU 3              ;Port bit for LCD E signal             
6a6e			kLCDBitE2:   EQU 0              ;Port bit for LCD E2 signal            VICLK  
6a6e			kLCDBitLED:   EQU 1              ;Port bit for LCD E2 signal            VIDDO  
6a6e			; TODO Decide which E is being set  
6a6e			kLCDWidth:  EQU display_cols             ;Width in characters  
6a6e			  
6a6e			; **********************************************************************  
6a6e			; **  Code library usage  
6a6e			; **********************************************************************  
6a6e			  
6a6e			; send character to current cursor position  
6a6e			; wraps and/or scrolls screen automatically  
6a6e			  
6a6e			  
6a6e			  
6a6e			lcd_init:  
6a6e			  
6a6e			; SCMonAPI functions used  
6a6e			  
6a6e			; Alphanumeric LCD functions used  
6a6e			; no need to specify specific functions for this module  
6a6e			  
6a6e 3e cf		            LD   A, 11001111b  
6a70 d3 c2		            OUT  (kContReg), A  ;Port A = PIO 'control' mode  
6a72 3e 00		            LD   A, 00000000b  
6a74 d3 c2		            OUT  (kContReg),A   ;Port A = all lines are outputs  
6a76			  
6a76			; Initialise alphanumeric LCD module  
6a76 3e 00				ld a, 0  
6a78 32 fb fa				ld (display_lcde1e2), a  
6a7b cd fc 6a		            CALL fLCD_Init      ;Initialise LCD module  
6a7e 3e 01				ld a, 1  
6a80 32 fb fa				ld (display_lcde1e2), a  
6a83 cd fc 6a		            CALL fLCD_Init      ;Initialise LCD module  
6a86			  
6a86 c9				ret  
