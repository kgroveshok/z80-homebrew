574f			chk_stk_init: 
574f				; a vague random number to check so we dont get any "lucky" hits 
574f 3e 2d			ld a, 45 
5751 6f				ld l, a 
5752 00				nop 
5753 3e 17			ld a, 23 
5755 67				ld h, a 
5756			 
