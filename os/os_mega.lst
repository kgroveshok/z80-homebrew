12e9			 
12e9			if MALLOC_3 
12e9			; https://gist.githubusercontent.com/tomstorey/947a8b084bad69391a4b2a1c5b6d69ca/raw/5a08fb30a480d98c0deb4a6afe2d48961cc8e9d9/z80_malloc.s 
12e9			;heap_start        .equ  0x9000      ; Starting address of heap 
12e9			;heap_size         .equ  0x0100      ; Number of bytes available in heap 
12e9			; 
12e9			 ;     .org 0 
12e9			  ;    jp    main 
12e9			; 
12e9			; 
12e9			 ;     .org  0x100 
12e9			;main: 
12e9			 ;     ld    HL, 0x8100 
12e9			  ;    ld    SP, HL 
12e9			; 
12e9			;      call  heap_init 
12e9			 
12e9			      ; Make some allocations 
12e9			;      ld    HL, 12 
12e9			;      call  malloc            ; Allocates 0x9004 
12e9			; 
12e9			 ;     ld    HL, 12 
12e9			;      call  malloc            ; Allocates 0x9014 
12e9			 
12e9			;      ld    HL, 12 
12e9			;      call  malloc            ; Allocates 0x9024 
12e9			 
12e9			      ; Free some allocations 
12e9			;      ld    HL, 0x9014 
12e9			;      call  free 
12e9			 
12e9			;      ld    HL, 0x9004 
12e9			;      call  free 
12e9			; 
12e9			;      ld    HL, 0x9024 
12e9			;      call  free 
12e9			 
12e9			 
12e9			 ;     halt 
12e9			 
12e9			 
12e9			;------------------------------------------------------------------------------ 
12e9			;     heap_init                                                               : 
12e9			;                                                                             : 
12e9			; Description                                                                 : 
12e9			;     Initialise the heap and make it ready for malloc and free operations.   : 
12e9			;                                                                             : 
12e9			;     The heap is maintained as a linked list, starting with an initial       : 
12e9			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
12e9			;     the first free block in the heap. Each block then points to the next    : 
12e9			;     free block within the heap, and the free list ends at the first block   : 
12e9			;     with a null pointer to the next free block.                             : 
12e9			;                                                                             : 
12e9			; Parameters                                                                  : 
12e9			;     Inputs are compile-time only. Two defines which specify the starting    : 
12e9			;     address of the heap and its size are required, along with a memory      : 
12e9			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
12e9			;     principally stores a pointer to the first free block in the heap.       : 
12e9			;                                                                             : 
12e9			; Returns                                                                     : 
12e9			;     Nothing                                                                 : 
12e9			;------------------------------------------------------------------------------ 
12e9			heap_init: 
12e9			      push  HL 
12e9			 
12e9			      ; Initialise free list struct 
12e9			      ld    HL, heap_start 
12e9			      ld    (free_list), HL 
12e9			      ld    HL, 0 
12e9			      ld    (free_list+2), HL 
12e9			 
12e9			      ; Insert first free block at bottom of heap, consumes entire heap 
12e9			      ld    HL, heap_start+heap_size-4 
12e9			      ld    (heap_start), HL        ; Next block (end of free list) 
12e9			      ld    HL, heap_size-4 
12e9			      ld    (heap_start+2), HL      ; Block size 
12e9			 
12e9			      ; Insert end of free list block at top of heap - two null words will 
12e9			      ; terminate the free list 
12e9			      ld    HL, 0 
12e9			      ld    (heap_start+heap_size-2), HL 
12e9			      ld    (heap_start+heap_size-4), HL 
12e9			 
12e9			      pop   HL 
12e9			 
12e9			      ret 
12e9			 
12e9			 
12e9			;------------------------------------------------------------------------------ 
12e9			;     malloc                                                                  : 
12e9			;                                                                             : 
12e9			; Description                                                                 : 
12e9			;     Allocates the wanted space from the heap and returns the address of the : 
12e9			;     first useable byte of the allocation.                                   : 
12e9			;                                                                             : 
12e9			;     Allocations can happen in one of two ways:                              : 
12e9			;                                                                             : 
12e9			;     1. A free block may be found which is the exact size wanted. In this    : 
12e9			;        case the block is removed from the free list and retuedn to the      : 
12e9			;        caller.                                                              : 
12e9			;     2. A free block may be found which is larger than the size wanted. In   : 
12e9			;        this case, the larger block is split into two. The first portion of  : 
12e9			;        this block will become the requested space by the malloc call and    : 
12e9			;        is returned to the caller. The second portion becomes a new free     : 
12e9			;        block, and the free list is adjusted to maintain continuity via this : 
12e9			;        newly created block.                                                 : 
12e9			;                                                                             : 
12e9			;     malloc does not set any initial value in the allocated space, the       : 
12e9			;     caller is required to do this as required.                              : 
12e9			;                                                                             : 
12e9			;     This implementation of malloc uses the stack exclusively, and is        : 
12e9			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
12e9			;     advisable to disable interrupts before calling malloc, and recommended  : 
12e9			;     to avoid the use of malloc inside ISRs in general.                      : 
12e9			;                                                                             : 
12e9			;     NOTE: heap_init must be called before malloc and free can be used.      : 
12e9			;                                                                             : 
12e9			; Parameters                                                                  : 
12e9			;     HL  Number of bytes wanted                                              : 
12e9			;                                                                             : 
12e9			; Returns                                                                     : 
12e9			;     HL  Address of the first useable byte of the allocation                 : 
12e9			;                                                                             : 
12e9			; Flags                                                                       : 
12e9			;     Z   Set if the allocation did not succeed, clear otherwise              : 
12e9			;                                                                             : 
12e9			; Stack frame                                                                 : 
12e9			;       |             |                                                       : 
12e9			;       +-------------+                                                       : 
12e9			;       |     BC      |                                                       : 
12e9			;       +-------------+                                                       : 
12e9			;       |     DE      |                                                       : 
12e9			;       +-------------+                                                       : 
12e9			;       |     IX      |                                                       : 
12e9			;       +-------------+                                                       : 
12e9			;       |  prev_free  |                                                       : 
12e9			;   +4  +-------------+                                                       : 
12e9			;       |  this_free  |                                                       : 
12e9			;   +2  +-------------+                                                       : 
12e9			;       |  next_free  |                                                       : 
12e9			;   +0  +-------------+                                                       : 
12e9			;       |             |                                                       : 
12e9			;                                                                             : 
12e9			;------------------------------------------------------------------------------ 
12e9			malloc: 
12e9			      push  BC 
12e9			      push  DE 
12e9			      push  IX 
12e9			 
12e9			      ld    A, H                    ; Exit if no space requested 
12e9			      or    L 
12e9			      jp    Z, malloc_early_exit 
12e9			 
12e9			      ; Set up stack frame 
12e9			      ex    DE, HL 
12e9			      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
12e9			      add   HL, SP 
12e9			      ld    SP, HL 
12e9			      ld    IX, 0                   ; Use IX as a frame pointer 
12e9			      add   IX, SP 
12e9			 
12e9			      ; Setup initial state 
12e9			      ld    HL, 4                   ; want must also include space used by block struct 
12e9			      add   HL, DE 
12e9			 
12e9			      ld    B, H                    ; Move want to BC 
12e9			      ld    C, L 
12e9			 
12e9			      ld    HL, free_list           ; Store prev_free ptr to stack 
12e9			      ld    (IX+4), L 
12e9			      ld    (IX+5), H 
12e9			 
12e9			      ld    E, (HL)                 ; Store this_free ptr to stack 
12e9			      inc   HL 
12e9			      ld    D, (HL) 
12e9			      ld    (IX+2), E 
12e9			      ld    (IX+3), D 
12e9			      ex    DE, HL                  ; this_free ptr into HL 
12e9			 
12e9			      ; Loop through free block list to find some space 
12e9			malloc_find_space: 
12e9			      ld    E, (HL)                 ; Load next_free ptr into DE 
12e9			      inc   HL 
12e9			      ld    D, (HL) 
12e9			 
12e9			      ld    A, D                    ; Check for null next_free ptr - end of free list 
12e9			      or    E 
12e9			      jp    Z, malloc_no_space 
12e9			 
12e9			      ld    (IX+0), E               ; Store next_free ptr to stack 
12e9			      ld    (IX+1), D 
12e9			 
12e9			      ; Does this block have enough space to make the allocation? 
12e9			      inc   HL                      ; Load free block size into DE 
12e9			      ld    E, (HL) 
12e9			      inc   HL 
12e9			      ld    D, (HL) 
12e9			 
12e9			      ex    DE, HL                  ; Check size of block against want 
12e9			      or    A                       ; Ensure carry flag clear 
12e9			      sbc   HL, BC 
12e9			      push  HL                      ; Store the result for later (new block size) 
12e9			 
12e9			      jr    Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
12e9			      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
12e9			 
12e9			      ; this_free block is not big enough, setup ptrs to test next free block 
12e9			      pop   HL                      ; Discard previous result 
12e9			 
12e9			      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
12e9			      ld    H, (IX+3) 
12e9			      ld    (IX+4), L 
12e9			      ld    (IX+5), H 
12e9			 
12e9			      ld    L, (IX+0)               ; Move next_free ptr into this_free 
12e9			      ld    H, (IX+1) 
12e9			      ld    (IX+2), L 
12e9			      ld    (IX+3), H 
12e9			 
12e9			      jr    malloc_find_space 
12e9			 
12e9			      ; split a bigger block into two - requested size and remaining size 
12e9			malloc_alloc_split: 
12e9			      ex    DE, HL                  ; Calculate address of new free block 
12e9			      dec   HL 
12e9			      dec   HL 
12e9			      dec   HL 
12e9			      add   HL, BC 
12e9			 
12e9			      ; Create a new block and point it at next_free 
12e9			      ld    E, (IX+0)               ; Load next_free ptr into DE 
12e9			      ld    D, (IX+1) 
12e9			 
12e9			      ld    (HL), E                 ; Store next_free ptr into new block 
12e9			      inc   HL 
12e9			      ld    (HL), D 
12e9			 
12e9			      pop   DE                      ; Store size of new block into new block 
12e9			      inc   HL 
12e9			      ld    (HL), E 
12e9			      inc   HL 
12e9			      ld    (HL), D 
12e9			 
12e9			      ; Update this_free ptr to point to new block 
12e9			      dec   HL 
12e9			      dec   HL 
12e9			      dec   HL 
12e9			 
12e9			      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
12e9			      ld    D, (IX+3) 
12e9			 
12e9			      ld    (IX+2), L               ; Store new block addr as this_free ptr 
12e9			      ld    (IX+3), H 
12e9			 
12e9			      ; Modify this_free block to be allocation 
12e9			      ex    DE, HL 
12e9			      xor   A                       ; Null the next block ptr of allocated block 
12e9			      ld    (HL), A 
12e9			      inc   HL 
12e9			      ld    (HL), A 
12e9			 
12e9			      inc   HL                      ; Store want size into allocated block 
12e9			      ld    (HL), C 
12e9			      inc   HL 
12e9			      ld    (HL), B 
12e9			      inc   HL 
12e9			      push  HL                      ; Address of allocation to return 
12e9			 
12e9			      jr    malloc_update_links 
12e9			 
12e9			malloc_alloc_fit: 
12e9			      pop   HL                      ; Dont need new block size, want is exact fit 
12e9			 
12e9			      ; Modify this_free block to be allocation 
12e9			      ex    DE, HL 
12e9			      dec   HL 
12e9			      dec   HL 
12e9			      dec   HL 
12e9			 
12e9			      xor   A                       ; Null the next block ptr of allocated block 
12e9			      ld    (HL), A 
12e9			      inc   HL 
12e9			      ld    (HL), A 
12e9			 
12e9			      inc   HL                      ; Store address of allocation to return 
12e9			      inc   HL 
12e9			      inc   HL 
12e9			      push  HL 
12e9			 
12e9			      ; Copy next_free ptr to this_free, remove allocated block from free list 
12e9			      ld    L, (IX+0)               ; next_free to HL 
12e9			      ld    H, (IX+1) 
12e9			 
12e9			      ld    (IX+2), L               ; HL to this_free 
12e9			      ld    (IX+3), H 
12e9			 
12e9			 
12e9			malloc_update_links: 
12e9			      ; Update prev_free ptr to point to this_free 
12e9			      ld    L, (IX+4)               ; prev_free ptr to HL 
12e9			      ld    H, (IX+5) 
12e9			 
12e9			      ld    E, (IX+2)               ; this_free ptr to DE 
12e9			      ld    D, (IX+3) 
12e9			 
12e9			      ld    (HL), E                 ; this_free ptr into prev_free 
12e9			      inc   HL 
12e9			      ld    (HL), D 
12e9			 
12e9			      ; Clear the Z flag to indicate successful allocation 
12e9			      ld    A, D 
12e9			      or    E 
12e9			 
12e9			      pop   DE                      ; Address of allocation 
12e9			 
12e9			malloc_no_space: 
12e9			      ld    HL, 6                   ; Clean up stack frame 
12e9			      add   HL, SP 
12e9			      ld    SP, HL 
12e9			 
12e9			      ex    DE, HL                  ; Alloc addr into HL for return 
12e9			 
12e9			malloc_early_exit: 
12e9			      pop   IX 
12e9			      pop   DE 
12e9			      pop   BC 
12e9			 
12e9			      ret 
12e9			 
12e9			 
12e9			;------------------------------------------------------------------------------ 
12e9			;     free                                                                    : 
12e9			;                                                                             : 
12e9			; Description                                                                 : 
12e9			;     Return the space pointed to by HL to the heap. HL must be an address as : 
12e9			;     returned by malloc, otherwise the behaviour is undefined.               : 
12e9			;                                                                             : 
12e9			;     Where possible, directly adjacent free blocks will be merged together   : 
12e9			;     into larger blocks to help ensure that the heap does not become         : 
12e9			;     excessively fragmented.                                                 : 
12e9			;                                                                             : 
12e9			;     free does not clear or set any other value into the freed space, and    : 
12e9			;     therefore its contents may be visible through subsequent malloc's. The  : 
12e9			;     caller should clear the freed space as required.                        : 
12e9			;                                                                             : 
12e9			;     This implementation of free uses the stack exclusively, and is          : 
12e9			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
12e9			;     advisable to disable interrupts before calling free, and recommended    : 
12e9			;     to avoid the use of free inside ISRs in general.                        : 
12e9			;                                                                             : 
12e9			;     NOTE: heap_init must be called before malloc and free can be used.      : 
12e9			;                                                                             : 
12e9			; Parameters                                                                  : 
12e9			;     HL  Pointer to address of first byte of allocation to be freed          : 
12e9			;                                                                             : 
12e9			; Returns                                                                     : 
12e9			;     Nothing                                                                 : 
12e9			;                                                                             : 
12e9			; Stack frame                                                                 : 
12e9			;       |             |                                                       : 
12e9			;       +-------------+                                                       : 
12e9			;       |     BC      |                                                       : 
12e9			;       +-------------+                                                       : 
12e9			;       |     DE      |                                                       : 
12e9			;       +-------------+                                                       : 
12e9			;       |     IX      |                                                       : 
12e9			;       +-------------+                                                       : 
12e9			;       |  prev_free  |                                                       : 
12e9			;   +2  +-------------+                                                       : 
12e9			;       |  next_free  |                                                       : 
12e9			;   +0  +-------------+                                                       : 
12e9			;       |             |                                                       : 
12e9			;                                                                             : 
12e9			;------------------------------------------------------------------------------ 
12e9			free: 
12e9			      push  BC 
12e9			      push  DE 
12e9			      push  IX 
12e9			 
12e9			      ld    A, H                    ; Exit if ptr is null 
12e9			      or    L 
12e9			      jp    Z, free_early_exit 
12e9			 
12e9			      ; Set up stack frame 
12e9			      ex    DE, HL 
12e9			      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
12e9			      add   HL, SP 
12e9			      ld    SP, HL 
12e9			      ld    IX, 0                   ; Use IX as a frame pointer 
12e9			      add   IX, SP 
12e9			 
12e9			      ; The address in HL points to the start of the useable allocated space, 
12e9			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
12e9			      ; address of the block itself. 
12e9			      ex    DE, HL 
12e9			      ld    DE, -4 
12e9			      add   HL, DE 
12e9			 
12e9			      ; An allocated block must have a null next block pointer in it 
12e9			      ld    A, (HL) 
12e9			      inc   HL 
12e9			      or    (HL) 
12e9			      jp    NZ, free_done 
12e9			 
12e9			      dec   HL 
12e9			 
12e9			      ld    B, H                    ; Copy HL to BC 
12e9			      ld    C, L 
12e9			 
12e9			      ; Loop through the free list to find the first block with an address 
12e9			      ; higher than the block being freed 
12e9			      ld    HL, free_list 
12e9			 
12e9			free_find_higher_block: 
12e9			      ld    E, (HL)                 ; Load next ptr from free block 
12e9			      inc   HL 
12e9			      ld    D, (HL) 
12e9			      dec   HL 
12e9			 
12e9			      ld    (IX+0), E               ; Save ptr to next free block 
12e9			      ld    (IX+1), D 
12e9			      ld    (IX+2), L               ; Save ptr to prev free block 
12e9			      ld    (IX+3), H 
12e9			 
12e9			      ld    A, B                    ; Check if DE is greater than BC 
12e9			      cp    D                       ; Compare MSB first 
12e9			      jr    Z, $+4                  ; MSB the same, compare LSB 
12e9			      jr    NC, free_find_higher_block_skip 
12e9			      ld    A, C 
12e9			      cp    E                       ; Then compare LSB 
12e9			      jr    C, free_found_higher_block 
12e9			 
12e9			free_find_higher_block_skip: 
12e9			      ld    A, D                    ; Reached the end of the free list? 
12e9			      or    E 
12e9			      jp    Z, free_done 
12e9			 
12e9			      ex    DE, HL 
12e9			 
12e9			      jr    free_find_higher_block 
12e9			 
12e9			free_found_higher_block: 
12e9			      ; Insert freed block between prev and next free blocks 
12e9			      ld    (HL), C                 ; Point prev free block to freed block 
12e9			      inc   HL 
12e9			      ld    (HL), B 
12e9			 
12e9			      ld    H, B                    ; Point freed block at next free block 
12e9			      ld    L, C 
12e9			      ld    (HL), E 
12e9			      inc   HL 
12e9			      ld    (HL), D 
12e9			 
12e9			      ; Check if the freed block is adjacent to the next free block 
12e9			      inc   HL                      ; Load size of freed block into HL 
12e9			      ld    E, (HL) 
12e9			      inc   HL 
12e9			      ld    D, (HL) 
12e9			      ex    DE, HL 
12e9			 
12e9			      add   HL, BC                  ; Add addr of freed block and its size 
12e9			 
12e9			      ld    E, (IX+0)               ; Load addr of next free block into DE 
12e9			      ld    D, (IX+1) 
12e9			 
12e9			      or    A                       ; Clear the carry flag 
12e9			      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
12e9			      jr    NZ, free_check_adjacent_to_prev 
12e9			 
12e9			      ; Freed block is adjacent to next, merge into one bigger block 
12e9			      ex    DE, HL                  ; Load next ptr from next block into DE 
12e9			      ld    E, (HL) 
12e9			      inc   HL 
12e9			      ld    D, (HL) 
12e9			      push  HL                      ; Save ptr to next block for later 
12e9			 
12e9			      ld    H, B                    ; Store ptr from next block into freed block 
12e9			      ld    L, C 
12e9			      ld    (HL), E 
12e9			      inc   HL 
12e9			      ld    (HL), D 
12e9			 
12e9			      pop   HL                      ; Restore ptr to next block 
12e9			      inc   HL                      ; Load size of next block into DE 
12e9			      ld    E, (HL) 
12e9			      inc   HL 
12e9			      ld    D, (HL) 
12e9			      push  DE                      ; Save next block size for later 
12e9			 
12e9			      ld    H, B                    ; Load size of freed block into HL 
12e9			      ld    L, C 
12e9			      inc   HL 
12e9			      inc   HL 
12e9			      ld    E, (HL) 
12e9			      inc   HL 
12e9			      ld    D, (HL) 
12e9			      ex    DE, HL 
12e9			 
12e9			      pop   DE                      ; Restore size of next block 
12e9			      add   HL, DE                  ; Add sizes of both blocks 
12e9			      ex    DE, HL 
12e9			 
12e9			      ld    H, B                    ; Store new bigger size into freed block 
12e9			      ld    L, C 
12e9			      inc   HL 
12e9			      inc   HL 
12e9			      ld    (HL), E 
12e9			      inc   HL 
12e9			      ld    (HL), D 
12e9			 
12e9			free_check_adjacent_to_prev: 
12e9			      ; Check if the freed block is adjacent to the prev free block 
12e9			      ld    L, (IX+2)               ; Prev free block ptr into HL 
12e9			      ld    H, (IX+3) 
12e9			 
12e9			      inc   HL                      ; Size of prev free block into DE 
12e9			      inc   HL 
12e9			      ld    E, (HL) 
12e9			      inc   HL 
12e9			      ld    D, (HL) 
12e9			      dec   HL 
12e9			      dec   HL 
12e9			      dec   HL 
12e9			 
12e9			      add   HL, DE                  ; Add prev block addr and size 
12e9			 
12e9			      or    A                       ; Clear the carry flag 
12e9			      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
12e9			      jr    NZ, free_done 
12e9			 
12e9			      ; Freed block is adjacent to prev, merge into one bigger block 
12e9			      ld    H, B                    ; Load next ptr from freed block into DE 
12e9			      ld    L, C 
12e9			      ld    E, (HL) 
12e9			      inc   HL 
12e9			      ld    D, (HL) 
12e9			      push  HL                      ; Save freed block ptr for later 
12e9			 
12e9			      ld    L, (IX+2)               ; Store freed block ptr into prev block 
12e9			      ld    H, (IX+3) 
12e9			      ld    (HL), E 
12e9			      inc   HL 
12e9			      ld    (HL), D 
12e9			 
12e9			      pop   HL                      ; Restore freed block ptr 
12e9			      inc   HL                      ; Load size of freed block into DE 
12e9			      ld    E, (HL) 
12e9			      inc   HL 
12e9			      ld    D, (HL) 
12e9			      push  DE                      ; Save freed block size for later 
12e9			 
12e9			      ld    L, (IX+2)               ; Load size of prev block into DE 
12e9			      ld    H, (IX+3) 
12e9			      inc   HL 
12e9			      inc   HL 
12e9			      ld    E, (HL) 
12e9			      inc   HL 
12e9			      ld    D, (HL) 
12e9			 
12e9			      pop   HL                      ; Add sizes of both blocks 
12e9			      add   HL, DE 
12e9			      ex    DE, HL 
12e9			 
12e9			      ld    L, (IX+2)               ; Store new bigger size into prev block 
12e9			      ld    H, (IX+3) 
12e9			      inc   HL 
12e9			      inc   HL 
12e9			      ld    (HL), E 
12e9			      inc   HL 
12e9			      ld    (HL), D 
12e9			 
12e9			free_done: 
12e9			      ld    HL, 4                   ; Clean up stack frame 
12e9			      add   HL, SP 
12e9			      ld    SP, HL 
12e9			 
12e9			free_early_exit: 
12e9			      pop   IX 
12e9			      pop   DE 
12e9			      pop   BC 
12e9			 
12e9			      ret 
12e9			 
12e9			 
12e9			;      .org 0x8000 
12e9			; 
12e9			;free_list         .dw   0     ; Block struct for start of free list (MUST be 4 bytes) 
12e9			 ;                 .dw   0 
12e9			 
12e9			endif 
12e9			 
12e9			 
12e9			if MALLOC_4 
12e9			 
12e9			; My memory allocation code. Very very simple.... 
12e9			; allocate space under 250 chars 
12e9			 
12e9			heap_init: 
12e9				; init start of heap as zero 
12e9				;  
12e9			 
12e9				ld hl, heap_start 
12e9			;	ld a, 0 
12e9				ld (hl), 0      ; empty block 
12e9				inc hl 
12e9			;	ld a, 0 
12e9				ld (hl), 0      ; length of block 
12e9				; write end of list 
12e9				inc hl 
12e9				ld a,(hl) 
12e9				inc hl 
12e9				ld a,(hl) 
12e9				 
12e9			 
12e9				; init some malloc vars 
12e9			 
12e9				ld hl, 0 
12e9				ld (free_list), hl       ; store last malloc location 
12e9			 
12e9				ld hl, free_list+3      ; flag for 'free' being used and force a rescan for reuse of block  
12e9			;	ld a, 0 
12e9				ld (hl), 0 
12e9			 
12e9			 
12e9				ld hl, heap_start 
12e9				;  
12e9				  
12e9				ret 
12e9			 
12e9			 
12e9			;    free block marker 
12e9			;    requested size  
12e9			;    pointer to next block 
12e9			;    .... 
12e9			;    next block marker 
12e9			 
12e9			 
12e9			; TODO add a flag that is reset on use of free. if flag is reset then start scan from start of heap otherwise use last location 
12e9			; 
12e9			 
12e9			 
12e9			malloc:  
12e9				push de 
12e9				push bc 
12e9				push af 
12e9			 
12e9				; hl space required 
12e9				 
12e9				ld c, l    ; hold space   (TODO only a max of 255) 
12e9			 
12e9			;	inc c     ; TODO BUG need to fix memory leak on push str 
12e9			;	inc c 
12e9			;	inc c 
12e9			;	inc c 
12e9			;	inc c 
12e9			;	inc c 
12e9			;	inc c 
12e9			 
12e9			 
12e9			 
12e9				; start at heap if a free has been issued so we can reclaim it otherwise continue from last time 
12e9			 
12e9				ld a, (free_list+3) 
12e9			;	cp 0 
12e9				or a 
12e9				jr z, .contheap 
12e9			 
12e9				ld hl, (free_list)     ; get last alloc 
12e9					if DEBUG_FORTH_MALLOC_INT 
12e9						DMARK "mrs" 
12e9						CALLMONITOR 
12e9					endif 
12e9				jr .startalloc 
12e9			 
12e9			.contheap: 
12e9				ld hl, heap_start 
12e9			 
12e9			.startalloc: 
12e9			 
12e9					if DEBUG_FORTH_MALLOC_INT 
12e9						DMARK "mym" 
12e9						CALLMONITOR 
12e9					endif 
12e9			.findblock: 
12e9					if DEBUG_FORTH_MALLOC_INT 
12e9						DMARK "mmf" 
12e9						CALLMONITOR 
12e9					endif 
12e9			 
12e9				ld a,(hl)  
12e9				; if byte is zero then clear to use 
12e9			 
12e9			;	cp 0 
12e9				or a 
12e9				jr z, .foundemptyblock 
12e9			 
12e9				; if byte is not clear 
12e9				;     then byte is offset to next block 
12e9			 
12e9				inc hl 
12e9				ld a, (hl) ; get size 
12e9			.nextblock:	inc hl 
12e9					ld e, (hl) 
12e9					inc hl 
12e9					ld d, (hl) 
12e9					ex de, hl 
12e9			;	inc hl  ; move past the store space 
12e9			;	inc hl  ; move past zero index  
12e9			 
12e9				; TODO detect no more space 
12e9			 
12e9				push hl 
12e9				ld de, heap_end 
12e9				call cmp16 
12e9				pop hl 
12e9				jr nc, .nospace 
12e9			 
12e9				jr .findblock 
12e9			 
12e9			.nospace: ld hl, 0 
12e9				jp .exit 
12e9			 
12e9			 
12e9			.foundemptyblock:	 
12e9					if DEBUG_FORTH_MALLOC_INT 
12e9						DMARK "mme" 
12e9						CALLMONITOR 
12e9					endif 
12e9			 
12e9			; TODO has block enough space if reusing??? 
12e9			 
12e9				;  
12e9			 
12e9			; see if this block has been previously used 
12e9				inc hl 
12e9				ld a, (hl) 
12e9				dec hl 
12e9			;	cp 0 
12e9				or a 
12e9				jr z, .newblock 
12e9			 
12e9					if DEBUG_FORTH_MALLOC_INT 
12e9						DMARK "meR" 
12e9						CALLMONITOR 
12e9					endif 
12e9			 
12e9			; no reusing previously allocated block 
12e9			 
12e9			; is it smaller than previously used? 
12e9				 
12e9				inc hl    ; move to size 
12e9				ld a, c 
12e9				sub (hl)        ; we want c < (hl) 
12e9				dec hl    ; move back to marker 
12e9			        jr z, .findblock 
12e9			 
12e9				; update with the new size which should be lower 
12e9			 
12e9			        ;inc  hl   ; negate next move. move back to size  
12e9			 
12e9			.newblock: 
12e9				; need to be at marker here 
12e9			 
12e9					if DEBUG_FORTH_MALLOC_INT 
12e9						DMARK "meN" 
12e9						CALLMONITOR 
12e9					endif 
12e9			 
12e9			 
12e9				ld a, c 
12e9			 
12e9				ld (free_list+3), a	 ; flag resume from last malloc  
12e9				ld (free_list), hl    ; save out last location 
12e9			 
12e9			 
12e9				;inc a     ; space for length byte 
12e9				ld (hl), a     ; save block in use marker 
12e9			 
12e9				inc hl   ; move to space marker 
12e9				ld (hl), a    ; save new space 
12e9			 
12e9				inc hl   ; move to start of allocated area 
12e9				 
12e9			;	push hl     ; save where we are - 1  
12e9			 
12e9			;	inc hl  ; move past zero index  
12e9				; skip space to set down new marker 
12e9			 
12e9				; provide some extra space for now 
12e9			 
12e9				inc a    ; actual is one fewer than bytes requested. correct if zero index is taken into account 
12e9				inc a 
12e9				inc a 
12e9			 
12e9				push hl   ; save where we are in the node block 
12e9			 
12e9				call addatohl 
12e9			 
12e9				; write linked list point 
12e9			 
12e9				pop de     ; get our node position 
12e9				ex de, hl 
12e9			 
12e9				ld (hl), e 
12e9				inc hl 
12e9				ld (hl), d 
12e9			 
12e9				inc hl 
12e9			 
12e9				; now at start of allocated data so save pointer 
12e9			 
12e9				push hl 
12e9			 
12e9				; jump to position of next node and setup empty header in DE 
12e9			 
12e9				ex de, hl 
12e9			 
12e9			;	inc hl ; move past end of block 
12e9			 
12e9			;	ld a, 0 
12e9				ld (hl), 0   ; empty marker 
12e9				inc hl 
12e9				ld (hl), 0   ; size 
12e9				inc hl  
12e9				ld (hl), 0   ; ptr 
12e9				inc hl 
12e9				ld (hl), 0   ; ptr 
12e9			 
12e9			 
12e9				pop hl 
12e9			 
12e9					if DEBUG_FORTH_MALLOC_INT 
12e9						DMARK "mmr" 
12e9						CALLMONITOR 
12e9					endif 
12e9			 
12e9			.exit: 
12e9				pop af 
12e9				pop bc 
12e9				pop de  
12e9				ret 
12e9			 
12e9			 
12e9			 
12e9			 
12e9			free:  
12e9				push hl 
12e9				push af 
12e9				; get address in hl 
12e9			 
12e9					if DEBUG_FORTH_MALLOC_INT 
12e9						DMARK "fre" 
12e9						CALLMONITOR 
12e9					endif 
12e9				; data is at hl - move to block count 
12e9				dec hl 
12e9				dec hl    ; get past pointer 
12e9				dec hl 
12e9			 
12e9				ld a, (hl)    ; need this for a validation check 
12e9			 
12e9				dec hl    ; move to block marker 
12e9			 
12e9				; now check that the block count and block marker are the same  
12e9			        ; this checks that we are on a malloc node and not random memory 
12e9			        ; OK a faint chance this could be a problem but rare - famous last words! 
12e9			 
12e9				ld c, a 
12e9				ld a, (hl)    
12e9			 
12e9				cp c 
12e9				jr nz, .freeignore      ; not a valid malloc node in use so dont break anything 
12e9			 
12e9				; yes good chance we are on a malloc node 
12e9			 
12e9			;	ld a, 0      
12e9				ld (hl), 0   ; mark as free 
12e9			 
12e9				ld (free_list+3), a	 ; flag reuse of existing block on next malloc 
12e9			 
12e9			.freeignore:  
12e9			 
12e9				pop af 
12e9				pop hl 
12e9			 
12e9				ret 
12e9			 
12e9			 
12e9			 
12e9			endif 
