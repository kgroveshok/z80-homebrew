575c 22 c6 e9			ld (chk_ret_und), hl 
575f 22 84 e9			ld (chk_ret_ovr), hl 
5762 22 02 e9			ld (chk_loop_ovr), hl 
5765 22 00 e8			ld (chk_data_ovr), hl 
5768 c9				ret 
