1d96			include "firmware_595shiftreg.asm"  
1d96			; common code for handling a 595 shift reg out on whatever output port 
1d96			 
1d96			; port in c 
1d96			; byte in a 
1d96			 
1d96			 
1d96			shift_bit_data: equ 0 
1d96			shift_bit_clk: equ 1 
1d96			shift_bit_latch: equ 2 
1d96			 
1d96			 
1d96			; shift out a byte to the sound chip 
1d96			 
1d96			; A contains byte to send 
1d96			 
1d96			shift_byte: 
1d96			 
1d96 06 08			ld b, 8   ; 8 bits to shift 
1d98			 
1d98 16 00		.nb1:	ld d, 0    ; our work byte to send to the device with flags 
1d9a			 
1d9a				; set data bit state 
1d9a			 
1d9a cb 7f			bit 7, a 
1d9c				; high bit is set 
1d9c 28 02			jr z, .nb2 
1d9e cb c2			set shift_bit_data, d 
1da0			 
1da0				; set latches state  
1da0 cb ca		.nb2:	set shift_bit_clk, d 
1da2 cb 92			res shift_bit_latch, d    ; latch is inverted 
1da4 ed 51			out (c), d 
1da6				 
1da6				; clock the bit out 
1da6 cb 8a			res shift_bit_clk, d 
1da8 ed 51			out (c), d 
1daa			 
1daa				; shift a left one bit and repeat 
1daa 17				rla 
1dab			 
1dab 10 eb			djnz .nb1 
1dad			 
1dad				; latch 
1dad cb d2			set shift_bit_latch, d 
1daf ed 51			out (c), d 
1db1					 
1db1			 
1db1				; set  
1db1 c9				ret 
# End of file firmware_595shiftreg.asm
