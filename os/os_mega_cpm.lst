5a0b						DMARK "ASr" 
5a0b						CALLMONITOR 
5a0b					endif 
5a0b			 
5a0b					call ishlzero 
5a0b					ret z             ; file not found 
5a0b			 
5a0b					ld a, display_row_2 + 10 
5a0b					ld de, store_page+3 
5a0b					call str_at_display 
