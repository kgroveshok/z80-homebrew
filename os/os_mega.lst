25c9			; the core word dictionary v4 
25c9			; https://www.complang.tuwien.ac.at/forth/gforth/Docs-html/Notation.html#Notation 
25c9			 
25c9			; this is a linked list for each of the system words used 
25c9			; user defined words will follow the same format but will be in ram 
25c9			 
25c9			 
25c9			; 
25c9			; 
25c9			; define linked list: 
25c9			; 
25c9			; 1. compiled byte op code 
25c9			; 2. len of text word 
25c9			; 3. text word 
25c9			; 4. ptr to next dictionary word 
25c9			; 5. asm, calls etc for the word 
25c9			; 
25c9			;  if 1 == 0 then last word in dict  
25c9			;   
25c9			; set the start of dictionary scanning to be in ram and the last word point to the system dict 
25c9			;  
25c9			;  
25c9			; create basic standard set of words 
25c9			; 
25c9			;  
25c9			; + - / * DUP EMIT . SWAP IF..THEN..ELSE DO..LOOP  : ; DROP  
25c9			; 2DUP 2DROP 2SWAP  
25c9			; @ C@ - get byte  
25c9			; ! C! - store byte 
25c9			; 0< true if less than zero 
25c9			; 0= true if zero 
25c9			; < >  
25c9			; = true if same 
25c9			; variables 
25c9			 
