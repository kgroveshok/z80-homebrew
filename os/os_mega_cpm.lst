1bd3			user_word_eol:  
1bd3				; hl contains the pointer to where to create a linked list item from the end 
1bd3				; of the user dict to continue on at the system word dict 
1bd3				 
1bd3				; poke the stub of the word list linked list to repoint to rom words 
1bd3			 
1bd3				; stub format 
1bd3				; db   word id 
1bd3				; dw    link to next word 
1bd3			        ; db char length of token 
1bd3				; db string + 0 term 
1bd3				; db exec code....  
1bd3			 
1bd3			;	ld a, WORD_SYS_ROOT     ; root word 
1bd3 36 00			ld (hl), WORD_SYS_ROOT		; word id 
1bd5 23				inc hl 
1bd6			 
1bd6 11 7f 1d			ld de, sysdict 
1bd9 73				ld (hl), e		; next word link ie system dict 
1bda 23				inc hl 
1bdb 72				ld (hl), d		; next word link ie system dict 
1bdc 23				inc hl	 
1bdd			 
1bdd			;	ld (hl), sysdict		; next word link ie system dict 
1bdd			;	inc hl 
1bdd			;	inc hl 
1bdd			 
1bdd			;	inc hl 
1bdd			;	inc hl 
1bdd			 
1bdd			;	ld a, 2			; word length is 0 
1bdd 36 02			ld (hl), 2 
1bdf 23				inc hl 
1be0			 
1be0			;	ld a, '~'			; word length is 0 
1be0 36 7e			ld (hl), '~' 
1be2 23				inc hl 
1be3			;	ld a, 0			; save empty word 
1be3 36 00			ld (hl), 0 
