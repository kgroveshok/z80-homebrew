1158			; hl and de strings 
1158			; zero set if the same 
1158			 
1158			strcmp: 
1158 1a				ld a, (de) 
1159 be				cp (hl) 
115a 28 02			jr z, .ssame 
115c b7				or a 
115d c9				ret 
115e			 
