112c			malloc_guard_entry: 
112c				push hl 
112c				push de 
112c				push af 
112c			 
112c			 	or a      ;clear carry flag 
112c				push hl 
112c				ld de, 255 
112c				sbc hl, de 
112c				jr c, .lowalloc 
112c			 
112c				push de 
112c					ld hl, display_fb0 
112c					ld (display_fb_active), hl 
112c				call clear_display 
112c				ld a, 0 
112c				ld de, .mallocsize 
112c				call str_at_display 
112c				call update_display 
112c				call delay1s 
112c				call delay1s 
112c			;	ld a, 0 
112c			;	ld (os_view_disable), a 
112c				call bp_on 
112c			 
112c				pop de 
112c				pop hl 
112c			 
112c				 
112c			 
112c				CALLMONITOR 
112c				jr .lowdone 
112c			.lowalloc: 
112c			 
112c			 
112c				pop hl 
112c			.lowdone:	pop af 
112c				pop de 
112c				pop hl 
112c			ret 
112c			 
112c			malloc_guard_exit: 
112c				push hl 
112c				push de 
112c				push af 
112c			 
112c			 	or a      ;clear carry flag 
112c				push hl 
112c				ld de, 255 
112c				sbc hl, de 
112c				jr c, .lowallocx 
112c			 
112c				push de 
112c					ld hl, display_fb0 
112c					ld (display_fb_active), hl 
112c				call clear_display 
112c				ld a, 0 
112c				ld de, .mallocasize 
112c				call str_at_display 
112c				call update_display 
112c				call delay1s 
112c				call delay1s 
112c			;	ld a, 0 
112c			;	ld (os_view_disable), a 
112c				call bp_on 
112c				pop de 
112c				pop hl 
112c			 
112c				CALLMONITOR 
112c				jr .lowdonex 
112c			.lowallocx: 
112c			 
112c				pop hl 
112c			.lowdonex:	pop af 
112c				pop de 
112c				pop hl 
112c			ret 
112c			endif 
