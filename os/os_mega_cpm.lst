0ea4 23				inc hl 
0ea5 d6 30			SUB	030h		;Makes '0'-'9' equal 0-9 
0ea7 fe 0a			CP	00Ah		;Is it 0-9 ? 
0ea9 38 02			JR	C,NALPHA	;If so miss next bit 
0eab d6 07			SUB	007h		;Else convert alpha 
0ead			NALPHA: 
