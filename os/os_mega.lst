0dc8			addatohl: 
0dc8 85			    add   a, l    ; A = A+L 
0dc9 6f			    ld    l, a    ; L = A+L 
0dca 8c			    adc   a, h    ; A = A+L+H+carry 
0dcb 95			    sub   l       ; A = H+carry 
0dcc 67			    ld    h, a    ; H = H+carry 
0dcd c9			ret 
