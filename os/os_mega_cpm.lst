0f4c			; DispA 
0f4c			; -------------------------------------------------------------- 
0f4c			; Converts a signed integer value to a zero-terminated ASCII 
0f4c			; string representative of that value (using radix 10). 
0f4c			; -------------------------------------------------------------- 
0f4c			; INPUTS: 
0f4c			;     HL     Value to convert (two's complement integer). 
0f4c			;     DE     Base address of string destination. (pointer). 
0f4c			; -------------------------------------------------------------- 
0f4c			; OUTPUTS: 
0f4c			;     None 
0f4c			; -------------------------------------------------------------- 
0f4c			; REGISTERS/MEMORY DESTROYED 
0f4c			; AF HL 
0f4c			; -------------------------------------------------------------- 
0f4c			 
0f4c			;DispHLToASCII: 
0f4c			;   push    de 
0f4c			;   push    bc 
0f4c			; 
0f4c			;; Detect sign of HL. 
0f4c			;    bit    7, h 
0f4c			;    jr     z, ._DoConvert 
0f4c			; 
0f4c			;; HL is negative. Output '-' to string and negate HL. 
0f4c			;    ld     a, '-' 
0f4c			;    ld     (de), a 
0f4c			;    inc    de 
0f4c			; 
0f4c			;; Negate HL (using two's complement) 
0f4c			;    xor    a 
0f4c			;    sub    l 
0f4c			;    ld     l, a 
0f4c			;    ld     a, 0     ; Note that XOR A or SUB A would disturb CF 
0f4c			;    sbc    a, h 
0f4c			;    ld     h, a 
0f4c			; 
0f4c			;; Convert HL to digit characters 
0f4c			;._DoConvert: 
0f4c			;    ld     b, 0     ; B will count character length of number 
0f4c			;-   ld     a, 10 
0f4c			;    syscall  .DivHLByA  ; HL = HL / A, A = remainder 
0f4c			;    push   af 
0f4c			;    inc    b 
0f4c			;    ld     a, h 
0f4c			;    or     l 
0f4c			;    jr     nz, - 
0f4c			; 
0f4c			;; Retrieve digits from stack 
0f4c			;-   pop    af 
0f4c			;    or     $30 
0f4c			;    ld     (de), a 
0f4c			;    inc    de 
0f4c			;    djnz   - 
0f4c			; 
0f4c			;; Terminate string with NULL 
0f4c			;    xor    a 
0f4c			;    ld     (de), a 
0f4c			; 
0f4c			;    pop    bc 
0f4c			;    pop    de 
0f4c			;    ret 
0f4c			 
0f4c			;Comments 
0f4c			; 
0f4c			;    This routine uses the common positive-integer radix conversion algorithm of repeatedly dividing a value by the desired radix (base case: the value is zero) and saving the remainders of each division. 
0f4c			;    As this algorithm gives the digits in reverse order, they are pushed onto the hardware stack so that subsequently popping them yields the correct order. 
0f4c			;    Note that the output string will not be fixed-width. 
0f4c			; 
0f4c			;Example Usage 
0f4c			; 
0f4c			;    ld    hl, -1004 
0f4c			;    ld    de, OP1 
0f4c			;    call  DispA 
0f4c			;    ld    hl, OP1 
0f4c			;    syscall  PutS 
0f4c			 
0f4c			 
0f4c			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/string_to_uint16.z80 
0f4c			 
0f4c			 
0f4c			;Converts an ASCII string to an unsigned 16-bit integer 
0f4c			;Quits when it reaches a non-decimal digit 
0f4c			 
0f4c			string_to_uint16: 
0f4c			atoui_16: 
0f4c			;Input: 
0f4c			;     DE points to the string 
0f4c			;Outputs: 
0f4c			;     HL is the result 
0f4c			;     A is the 8-bit value of the number 
0f4c			;     DE points to the byte after the number 
0f4c			;Destroys: 
0f4c			;     BC 
0f4c			;       if the string is non-empty, BC is HL/10 
0f4c			;Size:  24 bytes 
0f4c			;Speed: 42+d(104+{0,9}) 
0f4c			;       d is the number of digits in the number 
0f4c			;       max is 640 cycles for a 5 digit number 
0f4c			;Assuming no leading zeros: 
0f4c			;1 digit:  146cc 
0f4c			;2 digit:  250cc 
0f4c			;3 digit:  354cc or 363cc (avg: 354.126cc) 
0f4c			;4 digit:  458cc or 467cc (avg: 458.27cc) 
0f4c			;5 digit:  562cc or 571cc or 580cc (avg: 562.4104cc) 
0f4c			;avg: 544.81158447265625cc (544+13297/16384) 
0f4c			;=============================================================== 
0f4c 21 00 00		  ld hl,0 
0f4f			.u16a: 
0f4f 1a			  ld a,(de) 
0f50 d6 30		  sub 30h 
0f52 fe 0a		  cp 10 
0f54 d0			  ret nc 
0f55 13			  inc de 
0f56 44			  ld b,h 
0f57 4d			  ld c,l 
0f58 29			  add hl,hl 
0f59 29			  add hl,hl 
0f5a 09			  add hl,bc 
0f5b 29			  add hl,hl 
0f5c 85			  add a,l 
0f5d 6f			  ld l,a 
0f5e 30 ef		  jr nc,.u16a 
0f60 24			  inc h 
0f61 c3 4f 0f		  jp .u16a 
0f64			 
0f64			 
0f64			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/string_to_uint16.z80 
0f64			 
0f64			;written by Zeda 
0f64			;Converts a 16-bit unsigned integer to an ASCII string. 
0f64			 
0f64			uitoa_16: 
0f64			;Input: 
0f64			;   DE is the number to convert 
0f64			;   HL points to where to write the ASCII string (up to 6 bytes needed). 
0f64			;Output: 
0f64			;   HL points to the null-terminated ASCII string 
0f64			;      NOTE: This isn't necessarily the same as the input HL. 
0f64 d5			  push de 
0f65 c5			  push bc 
0f66 f5			  push af 
0f67 eb			  ex de,hl 
0f68			 
0f68 01 f0 d8		  ld bc,-10000 
0f6b 3e 2f		  ld a,'0'-1 
0f6d 3c			  inc a 
0f6e 09			  add hl,bc  
0f6f 38 fc		   jr c,$-2 
0f71 12			  ld (de),a 
0f72 13			  inc de 
0f73			 
0f73 01 e8 03		  ld bc,1000 
0f76 3e 3a		  ld a,'9'+1 
0f78 3d			  dec a  
0f79 09			  add hl,bc  
0f7a 30 fc		   jr nc,$-2 
0f7c 12			  ld (de),a 
0f7d 13			  inc de 
0f7e			 
0f7e 01 9c ff		  ld bc,-100 
0f81 3e 2f		  ld a,'0'-1 
0f83 3c			  inc a  
0f84 09			  add hl,bc  
0f85 38 fc		   jr c,$-2 
0f87 12			  ld (de),a 
0f88 13			  inc de 
0f89			 
0f89 7d			  ld a,l 
0f8a 26 3a		  ld h,'9'+1 
0f8c 25			  dec h  
0f8d c6 0a		  add a,10  
0f8f 30 fb		   jr nc,$-3 
0f91 c6 30		  add a,'0' 
0f93 eb			  ex de,hl 
0f94 72			  ld (hl),d 
0f95 23			  inc hl 
0f96 77			  ld (hl),a 
0f97 23			  inc hl 
0f98 36 00		  ld (hl),0 
0f9a			 
0f9a			;Now strip the leading zeros 
0f9a 0e fa		  ld c,-6 
0f9c 09			  add hl,bc 
0f9d 3e 30		  ld a,'0' 
0f9f 23			  inc hl  
0fa0 be			  cp (hl)  
0fa1 28 fc		  jr z,$-2 
0fa3			 
0fa3			;Make sure that the string is non-empty! 
0fa3 7e			  ld a,(hl) 
0fa4 b7			  or a 
0fa5 20 01		  jr nz,.atoub 
0fa7 2b			  dec hl 
0fa8			.atoub: 
0fa8			 
0fa8 f1			  pop af 
0fa9 c1			  pop bc 
0faa d1			  pop de 
0fab c9			  ret 
0fac			 
0fac			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/toUpper.z80 
0fac			 
0fac			toUpper: 
0fac			;A is the char. 
0fac			;If A is a lowercase letter, this sets it to the matching uppercase 
0fac			;18cc or 30cc or 41cc 
0fac			;avg: 26.75cc 
0fac fe 61		  cp 'a' 
0fae d8			  ret c 
0faf fe 7b		  cp 'z'+1 
0fb1 d0			  ret nc 
0fb2 d6 20		  sub 'a'-'A' 
0fb4 c9			  ret 
