6788				call cin_wait 
6788						 
6788				cp '*' 
6788				jr z, .startupend1 
6788				cp '#' 
6788				jr nz, .startno 
6788				ld a, 1 
6788				ld (os_last_cmd),a 
6788				jr .startdo 
6788			.startno:	cp '1' 
6788				jr z,.startnxt  
