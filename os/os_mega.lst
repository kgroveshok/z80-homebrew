2d1e			; | MONITOR ( -- ) Display system breakpoint/monitor | DONE 
2d1e			; | | At start the current various registers will be displayed with contents. 
2d1e			; | | Top right corner will show the most recent debug marker seen. 
2d1e			; | | The bottom of the screen will also show the values of the data stack pointer (DSP) 
2d1e			; | | and the return stack pointer (RSP). 
2d1e			; | | Pressing: 
2d1e			; | |  
2d1e			; | |    1 - Initial screen 
2d1e			; | |  
2d1e			; | |    2 - Display a data dump of HL 
2d1e			; | |  
2d1e			; | |    3 - Display a data dump of DE 
2d1e			; | |  
2d1e			; | |    4 - Display a data dump of BC 
2d1e			; | |  
2d1e			; | |    5 - Display a data dump of HL 
2d1e			; | |  
2d1e			; | |    6 - Display a data dump of DSP 
2d1e			; | |  
2d1e			; | |    7 - Display a data dump of RSP 
2d1e			; | |  
2d1e			; | |    8 - Display a data dump of what is at DSP 
2d1e			; | |  
2d1e			; | |    9 - Display a data dump of what is at RSP 
2d1e			; | |  
2d1e			; | |    0 - Exit monitor and continue running. This will also enable break points 
2d1e			; | |  
2d1e			; | |    * - Disable break points 
2d1e			; | |  
2d1e			; | |    # - Enter traditional monitor mode 
2d1e			; | |  
2d1e			; | | 
2d1e			; | | Monitor Mode 
2d1e			; | | ------------ 
2d1e			; | | A prompt of '>' will be shown for various commands: 
2d1e			; | |  
2d1e			; | |    D xxxx - Display a data dump starting from hex address xxxx 
2d1e			; | |  
2d1e			; | |    C - Continue display a data dump from the last set address 
2d1e			; | |  
2d1e			; | |    M xxxx - Set start of memory edit at address xx 
2d1e			; | |  
2d1e			; | |    U xx - Poke the hex byte xx into the address set by M and increment the address to the next location 
2d1e			; | |  
2d1e			; | |    G xxxx - Exec code at specific address 
2d1e			; | |  
2d1e			; | |    Q - Return to previous 
2d1e				if DEBUG_FORTH_WORDS_KEY 
2d1e					DMARK "MON" 
2d1e				if DEMARK_VERSION = 1  
2d1e e5					push hl  
2d1f 21 27 2d				ld hl, .dmark  
2d22 22 9b fd				ld (debug_mark), hl  
2d25				endif  
