112c			if MALLOC_2 
112c			; Z80 Malloc and Free Functions 
112c			 
112c			; Malloc Function: 
112c			; Input: 
112c			;   HL: Size of block to allocate 
112c			; Output: 
112c			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
112c			 
112c			malloc: 
112c				 
112c			if DEBUG_FORTH_MALLOC_HIGH 
112c			call malloc_guard_entry 
112c			endif 
112c			 
112c			 
112c			 
112c			 
112c					if DEBUG_FORTH_MALLOC 
112c						DMARK "mal" 
112c						CALLMONITOR 
112c					endif 
112c			    push af            ; Save AF register 
112c			    ld a, l            ; Load low byte of size into A 
112c			    or h               ; Check if size is zero 
112c			    jp z, malloc_exit  ; If size is zero, exit with NULL pointer 
112c			 
112c			    ; Allocate memory 
112c			    ld hl, (heap_start) ; Load start of heap into HL 
112c					if DEBUG_FORTH_MALLOC 
112c						DMARK "ma1" 
112c						CALLMONITOR 
112c					endif 
112c			    call malloc_internal ; Call internal malloc function 
112c			    pop af             ; Restore AF register 
112c			if DEBUG_FORTH_MALLOC_HIGH 
112c			call malloc_guard_exit 
112c			call malloc_guard_zerolen 
112c			endif 
112c			    ret                ; Return 
112c			 
112c			; Free Function: 
112c			; Input: 
112c			;   HL: Pointer to memory block to free 
112c			; Output: 
112c			;   None 
112c			 
112c			free: 
112c			    push af            ; Save AF register 
112c			    ld a, l            ; Load low byte of pointer into A 
112c			    or h               ; Check if pointer is NULL 
112c			    jp z, free_exit    ; If pointer is NULL, exit 
112c			 
112c			    ; Free memory 
112c			    ld hl, (heap_start) ; Load start of heap into HL 
112c			    call free_internal  ; Call internal free function 
112c			    pop af             ; Restore AF register 
112c			    ret                ; Return 
112c			 
112c			; Internal Malloc Function: 
112c			; Input: 
112c			;   HL: Size of block to allocate 
112c			; Output: 
112c			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
112c			 
112c			malloc_internal: 
112c			    ld bc, 2           ; Number of bytes to allocate for management overhead 
112c			    add hl, bc         ; Add management overhead to requested size 
112c			    ex de, hl          ; Save total size in DE, and keep it in HL 
112c					if DEBUG_FORTH_MALLOC 
112c						DMARK "ma2" 
112c						CALLMONITOR 
112c					endif 
112c			 
112c			    ; Search for free memory block 
112c			    ld de, (heap_end)  ; Load end of heap into DE 
112c			    ld bc, 0           ; Initialize counter 
112c			 
112c					if DEBUG_FORTH_MALLOC 
112c						DMARK "ma2" 
112c						CALLMONITOR 
112c					endif 
112c			malloc_search_loop: 
112c			    ; Check if current block is free 
112c			    ld a, (hl)         ; Load current block's status (free or used) 
112c			;    cp 0               ; Compare with zero (free) 
112c				or a 
112c			    jr nz, malloc_skip_block_check  ; If not free, skip to the next block 
112c			 
112c			    ; Check if current block is large enough 
112c			    ld a, (hl+1)       ; Load high byte of block size 
112c			    cp l               ; Compare with low byte of requested size 
112c			    jr nz, malloc_skip_block_check  ; If not large enough, skip to the next block 
112c			 
112c			    ld a, (hl+2)       ; Load low byte of block size 
112c			    cp h               ; Compare with high byte of requested size 
112c			    jr c, malloc_skip_block_check   ; If not large enough, skip to the next block 
112c			 
112c			    ; Mark block as used 
112c			    ld (hl), 0xFF      ; Set status byte to indicate used block 
112c			 
112c			    ; Calculate remaining space in block 
112c			    ld bc, 0           ; Clear BC 
112c			    add hl, bc         ; Increment HL to point to start of data block 
112c			    add hl, de         ; HL = HL + DE (total size) 
112c			    ld bc, 1           ; Number of bytes to allocate for management overhead 
112c			    add hl, bc         ; Add management overhead to start of data block 
112c			 
112c			    ; Save pointer to allocated block in HL 
112c			if DEBUG_FORTH_MALLOC_HIGH 
112c						DMARK "ma5" 
112c			call malloc_guard_exit 
112c			call malloc_guard_zerolen 
112c			endif 
112c			    ret 
112c			 
112c			malloc_skip_block_check: 
112c			    ; Move to the next block 
112c			    ld bc, 3           ; Size of management overhead 
112c			    add hl, bc         ; Move to the next block 
112c			    inc de             ; Increment counter 
112c			 
112c			    ; Check if we have reached the end of heap 
112c			    ld a, e            ; Load low byte of heap end address 
112c			    cp (hl)            ; Compare with low byte of current address 
112c			    jr nz, malloc_search_loop  ; If not equal, continue searching 
112c			    ld a, d            ; Load high byte of heap end address 
112c			;    cp 0               ; Check if it's zero (end of memory) 
112c				or a 
112c			    jr nz, malloc_search_loop  ; If not zero, continue searching 
112c			 
112c			    ; If we reached here, allocation failed 
112c			    xor a              ; Set result to NULL 
112c			if DEBUG_FORTH_MALLOC_HIGH 
112c						DMARK "ma6" 
112c			call malloc_guard_exit 
112c			call malloc_guard_zerolen 
112c			endif 
112c			    ret 
112c			malloc_exit: 
112c			if DEBUG_FORTH_MALLOC_HIGH 
112c						DMARK "ma7" 
112c			call malloc_guard_exit 
112c			call malloc_guard_zerolen 
112c			endif 
112c			    ret 
112c			 
112c			; Internal Free Function: 
112c			; Input: 
112c			;   HL: Pointer to memory block to free 
112c			; Output: 
112c			;   None 
112c			 
112c			free_internal: 
112c			    ld de, (heap_start) ; Load start of heap into DE 
112c			    ld bc, 0            ; Initialize counter 
112c			 
112c			free_search_loop: 
112c			    ; Check if current block contains the pointer 
112c			    ld a, l             ; Load low byte of pointer 
112c			    cp (hl+1)           ; Compare with high byte of current block's address 
112c			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
112c			    ld a, h             ; Load high byte of pointer 
112c			    cp (hl+2)           ; Compare with low byte of current block's address 
112c			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
112c			 
112c			    ; Mark block as free 
112c			    ld (hl), 0          ; Set status byte to indicate free block 
112c			    ret                 ; Return 
112c			 
112c			free_skip_block_check: 
112c			    ; Move to the next block 
112c			    ld bc, 3            ; Size of management overhead 
112c			    add hl, bc          ; Move to the next block 
112c			    inc de              ; Increment counter 
112c			 
112c			    ; Check if we have reached the end of heap 
112c			    ld a, e             ; Load low byte of heap end address 
112c			    cp (hl)             ; Compare with low byte of current address 
112c			    jr nz, free_search_loop  ; If not equal, continue searching 
112c			    ld a, d             ; Load high byte of heap end address 
112c			;    cp 0                ; Check if it's zero (end of memory) 
112c				or a 
112c			    jr nz, free_search_loop  ; If not zero, continue searching 
112c			 
112c			    ; If we reached here, pointer is not found in heap 
112c			    ret 
112c			 
112c			free_exit: 
112c			    ret                 ; Return 
112c			 
112c			; Define heap start and end addresses 
112c			;heap_start:    .dw 0xC000   ; Start of heap 
112c			;heap_end:      .dw 0xE000   ; End of heap 
112c			 
112c			endif 
