11fd			; Select storage bank 
11fd			 
11fd			.selbank: 
11fd			 
11fd			if STARTUP_V2 
11fd			;	if STORAGE_SE 
11fd			;	else 
11fd			 
11fd				ld hl, prom_banks 
11fd				call menu 
11fd				cp 0 
11fd				ret z 
11fd				 
11fd				; set the bank number from the result 
11fd			 
11fd				 
11fd					ld c, SPI_CE_HIGH 
11fd					ld b, '0'    ; human readable bank number 
11fd			 
11fd			 
11fd					; active low 
11fd			 
11fd			;		cp 0 
11fd					or a 
11fd					jr z, .bset 
11fd					cp 1 
11fd					jr nz, .b2 
11fd					res 0, c 
11fd					ld b, '1'    ; human readable bank number 
11fd			.b2:		cp 2 
11fd					jr nz, .b3 
11fd					res 1, c 
11fd					ld b, '2'    ; human readable bank number 
11fd			.b3:		cp 3 
11fd					jr nz, .b4 
11fd					res 2, c 
11fd					ld b, '3'    ; human readable bank number 
11fd			.b4:		cp 4 
11fd					jr nz, .b5 
11fd					res 3, c 
11fd					ld b, '4'    ; human readable bank number 
11fd			.b5:		cp 5 
11fd					jr nz, .bset 
11fd					res 4, c 
11fd					ld b, '5'    ; human readable bank number 
11fd			 
11fd			.bset: 
11fd			 
11fd					ld a, c 
11fd			;		ld (spi_device),a 
11fd					ld a, b 
11fd			;		ld (spi_device_id),a 
11fd					push bc 
11fd			 
11fd					; select bank 1 and load block 0  
11fd			 
11fd				ld a, $fe      ; bit 0 clear 
11fd				ld (spi_device), a 
11fd			 
11fd				call storage_get_block_0 
11fd			 
11fd				pop bc 
11fd				ld a,c 
11fd				ld (store_page+STORE_0_BANKRUN), a 
11fd				ld a,b 
11fd				ld (store_page+STORE_0_BANKRUNN), a 
11fd					ld hl, 0 
11fd					ld de, store_page 
11fd				call storage_write_block 
11fd			 
11fd			else 
11fd 21 26 15			ld hl, prom_notav 
1200 11 3c 15			ld de, prom_empty 
1203 cd 4b 09			call info_panel 
1206			;	endif 
1206				 
1206			endif 
1206 c9				ret 
