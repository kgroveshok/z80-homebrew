8e61			.mallocasize: db "MALLOC gives >256",0 
8e61			.malloczero: db "MALLOC gives zero",0 
8e61			 
8e61			malloc_guard_zerolen: 
8e61				push hl 
8e61				push de 
8e61				push af 
8e61			 
8e61				ld de, 0 
8e61			        call cmp16 
8e61				jr nz, .lowalloz 
8e61			 
8e61				push hl 
8e61				push de 
8e61					ld hl, display_fb0 
8e61					ld (display_fb_active), hl 
8e61				call clear_display 
8e61				ld a, 0 
8e61				ld de, .malloczero 
8e61				call str_at_display 
8e61				call update_display 
8e61				call delay1s 
8e61				call delay1s 
8e61				call bp_on 
8e61			;	ld a, 0 
8e61			;	ld (os_view_disable), a 
8e61			 
8e61				pop de 
8e61				pop hl 
8e61			 
8e61				 
8e61			 
8e61				CALLMONITOR 
8e61			.lowalloz: 
8e61			 
8e61			 
8e61				pop af 
8e61				pop de 
8e61				pop hl 
8e61			ret 
8e61			 
8e61			malloc_guard_entry: 
8e61				push hl 
8e61				push de 
8e61				push af 
8e61			 
8e61			 	or a      ;clear carry flag 
8e61				push hl 
8e61				ld de, 255 
8e61				sbc hl, de 
8e61				jr c, .lowalloc 
8e61			 
8e61				push de 
8e61					ld hl, display_fb0 
8e61					ld (display_fb_active), hl 
8e61				call clear_display 
8e61				ld a, 0 
8e61				ld de, .mallocsize 
8e61				call str_at_display 
8e61				call update_display 
8e61				call delay1s 
8e61				call delay1s 
8e61			;	ld a, 0 
8e61			;	ld (os_view_disable), a 
8e61				call bp_on 
8e61			 
8e61				pop de 
8e61				pop hl 
8e61			 
8e61				 
8e61			 
8e61				CALLMONITOR 
8e61				jr .lowdone 
8e61			.lowalloc: 
8e61			 
8e61			 
8e61				pop hl 
8e61			.lowdone:	pop af 
8e61				pop de 
8e61				pop hl 
8e61			ret 
8e61			 
8e61			malloc_guard_exit: 
8e61				push hl 
8e61				push de 
8e61				push af 
8e61			 
8e61			 	or a      ;clear carry flag 
8e61				push hl 
8e61				ld de, 255 
8e61				sbc hl, de 
8e61				jr c, .lowallocx 
8e61			 
8e61				push de 
8e61					ld hl, display_fb0 
8e61					ld (display_fb_active), hl 
8e61				call clear_display 
8e61				ld a, 0 
8e61				ld de, .mallocasize 
8e61				call str_at_display 
8e61				call update_display 
8e61				call delay1s 
8e61				call delay1s 
8e61			;	ld a, 0 
8e61			;	ld (os_view_disable), a 
8e61				call bp_on 
8e61				pop de 
8e61				pop hl 
8e61			 
8e61				CALLMONITOR 
8e61				jr .lowdonex 
8e61			.lowallocx: 
8e61			 
8e61				pop hl 
8e61			.lowdonex:	pop af 
8e61				pop de 
8e61				pop hl 
8e61			ret 
