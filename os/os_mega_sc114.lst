8e41			 
8e41			malloc_guard_zerolen: 
8e41				push hl 
8e41				push de 
8e41				push af 
8e41			 
8e41				ld de, 0 
8e41			        call cmp16 
8e41				jr nz, .lowalloz 
8e41			 
8e41				push hl 
8e41				push de 
8e41					ld hl, display_fb0 
8e41					ld (display_fb_active), hl 
8e41				call clear_display 
8e41				ld a, 0 
8e41				ld de, .malloczero 
8e41				call str_at_display 
8e41				call update_display 
8e41				call delay1s 
8e41				call delay1s 
8e41				call bp_on 
