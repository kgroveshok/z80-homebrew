4cd8			; | READ ( -- n  )  Reads next page of current file id and push to stack | DONE 
4cd8			; | | e.g. 
4cd8			; | | $01 OPEN $01 DO READ . LOOP 
4cd8			; | | 
4cd8			; | | As this word only reads one 64 byte block in at a time, if the APPEND word has created extra blocks for the excess, this READ 
4cd8			; | | word is unaware so the long string needs to be joined if the string is a full. A single block read might be what you want, 
4cd8			; | | but if not then writing a word to join blocks will be required. The upshot is a full string will be 62 bytes as the first 
4cd8			; | | two bytes contain the file id and extent. 
4cd8			; | |  
4cd8			; | | Note: There is a flag that enables/disables long block reads called 'store_longread' and a poke of a non-zero value will 
4cd8			; | | enable the code to automatically read futher blocks if full. It is BUGGY so don't use for now. 
4cd8			; | | > [!NOTE] 
4cd8			; | | > Compatible with PicoSPINet  
4cd8			 
4cd8					if DEBUG_FORTH_WORDS_KEY 
4cd8						DMARK "REA" 
4cd8				if DEMARK_VERSION = 1  
4cd8 e5					push hl  
4cd9 21 e1 4c				ld hl, .dmark  
4cdc 22 9b fd				ld (debug_mark), hl  
4cdf				endif  
4cdf				if DEMARK_VERSION = 0  
4cdf					push af  
4cdf					ld a, (.dmark)  
4cdf					ld (debug_mark),a  
4cdf					ld a, (.dmark+1)  
4cdf					ld (debug_mark+1),a  
4cdf					ld a, (.dmark+2)  
4cdf					ld (debug_mark+2),a  
4cdf				endif  
4cdf 18 04			jr .pastdmark  
