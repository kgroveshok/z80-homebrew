11f1			create_startup: 
11f1			 
11f1				ld a, 0 
11f1				ld hl, .crstart 
11f1				call menu 
11f1			 
11f1				cp 0 
11f1				ret z 
11f1			 
11f1				cp 1 
11f1				call z, .genlsword 
11f1				cp 2 
11f1				call z, .genedword 
11f1			 
11f1				cp 3 
11f1				call z, .gendemword 
11f1			 
11f1				cp 4 
11f1				call z, .genutlword 
11f1				cp 5 
11f1				call z, .genspiword 
11f1				cp 6 
11f1				call z, .genkeyword 
11f1				cp 7 
11f1				call z, .gentapeword 
11f1				cp 8 
11f1				call z, .gensoundword 
11f1				cp 9 
11f1				call z, .genhwword 
11f1				jr create_startup 
