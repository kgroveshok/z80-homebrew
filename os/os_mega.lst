24bd			;WORD_SYS_LOWPRIM: equ 4    ; Offset for low level prim words opcode 
24bd			;WORD_SYS_BRANCH: equ 10    ; Offset for branching and loop words opcode 
24bd			WORD_SYS_UWORD: equ 1   ; Opcode for all user words 
24bd			WORD_SYS_DELETED: equ 3 ; Op code for a deleted UWORD 
24bd			WORD_SYS_ROOT: equ 0   ; Opcode for all user words 
24bd			WORD_SYS_END: equ 0   ; Opcode for all user words 
24bd			WORD_SYS_CORE: equ 20    ; Offset for dict core words opcode 
24bd			WORD_FLAG_CODE: equ 0	   ; opcodeflag to exec pure code for this word 
24bd			WORD_FLAG_JP: equ 1	   ; opcodeflag to list zero term jump table words 
24bd			 
24bd			; Core word preamble macro 
24bd			 
24bd			CWHEAD:   macro nxtword opcode lit len opflags 
24bd				db WORD_SYS_CORE+opcode             
24bd				; internal op code number 
24bd				dw nxtword            
24bd				; link to next dict word block 
24bd				db len + 1 
24bd				; literal length of dict word inc zero term 
24bd				db lit,0              
24bd				; literal dict word 
24bd			        ; TODO db opflags        
24bd				endm 
