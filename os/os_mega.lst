210e			; forth parser 
210e			 
210e			; My forth kernel 
210e			include "forth_kernel.asm" 
210e			; 
210e			; kernel to the forth OS 
210e			 
210e			DS_TYPE_STR: equ 1     ; string type 
210e			DS_TYPE_INUM: equ 2     ; $ 16 bit unsigned int usually a hex address 
210e			DS_TYPE_SNUM: equ 3     ; $ 16 bit signed int  
210e			DS_TYPE_CONST: equ 4     ; string type that won't be freed on a POP 
210e			;DS_TYPE_FNUM: equ 3      ; 24/32 bit floating point  do string conversion instead of a new type 
210e			 
210e			FORTH_PARSEV1: equ 0 
210e			FORTH_PARSEV2: equ 0 
210e			FORTH_PARSEV3: equ 0 
210e			FORTH_PARSEV4: equ 0 
210e			FORTH_PARSEV5: equ 0 
210e			FORTH_PARSEV6: equ 1 
210e			 
210e			;if FORTH_PARSEV5 
210e			;	FORTH_END_BUFFER: equ 0 
210e			;else 
210e			FORTH_END_BUFFER: equ 127 
210e			;endif 
210e			 
210e			FORTH_TRUE: equ 1 
210e			FORTH_FALSE: equ 0 
210e			 
210e			if FORTH_PARSEV4 
210e			include "forth_stackops.asm" 
210e			endif 
210e			 
210e			if FORTH_PARSEV5 
210e			include "forth_stackopsv5.asm" 
210e			endif 
210e			 
210e			if FORTH_PARSEV6 
210e			include "forth_stackopsv5.asm" 
210e			 
210e			; Stack operations for v5 parser on wards 
210e			; * DATA stack 
210e			; * LOOP stack 
210e			; * RETURN stack 
210e			 
210e			 
210e			 
210e			FORTH_CHK_DSP_UNDER: macro 
210e				push hl 
210e				push de 
210e				ld hl,(cli_data_sp) 
210e				ld de, cli_data_stack 
210e				call cmp16 
210e				jp c, fault_dsp_under 
210e				pop de 
210e				pop hl 
210e				endm 
210e			 
210e			 
210e			FORTH_CHK_RSP_UNDER: macro 
210e				push hl 
210e				push de 
210e				ld hl,(cli_ret_sp) 
210e				ld de, cli_ret_stack 
210e				call cmp16 
210e				jp c, fault_rsp_under 
210e				pop de 
210e				pop hl 
210e				endm 
210e			 
210e			FORTH_CHK_LOOP_UNDER: macro 
210e				push hl 
210e				push de 
210e				ld hl,(cli_loop_sp) 
210e				ld de, cli_loop_stack 
210e				call cmp16 
210e				jp c, fault_loop_under 
210e				pop de 
210e				pop hl 
210e				endm 
210e			 
210e			FORTH_ERR_TOS_NOTSTR: macro 
210e				; TOSO might need more for checks when used 
210e				push af 
210e				ld a,(hl) 
210e				cp DS_TYPE_STR 
210e				jp nz, type_faultn   
210e				pop af 
210e				endm 
210e			 
210e			FORTH_ERR_TOS_NOTNUM: macro 
210e				push af 
210e				ld a,(hl) 
210e				cp DS_TYPE_INUM 
210e				jp nz, type_faultn   
210e				pop af 
210e				endm 
210e			 
210e			 
210e			; increase data stack pointer and save hl to it 
210e				 
210e			FORTH_DSP_NEXT: macro 
210e				call macro_forth_dsp_next 
210e				endm 
210e			 
210e			 
210e			macro_forth_dsp_next: 
210e				if DEBUG_FORTH_STACK_GUARD 
210e cd bc 65				call check_stacks 
2111				endif 
2111 e5				push hl 
2112 d5				push de 
2113 eb				ex de,hl 
2114 2a 03 f9			ld hl,(cli_data_sp) 
2117 23				inc hl 
2118 23				inc hl 
2119			 
2119			; PARSEV5 
2119 23				inc hl 
211a 22 03 f9			ld (cli_data_sp),hl 
211d 73				ld (hl), e 
211e 23				inc hl 
211f 72				ld (hl), d 
2120 d1				pop de 
2121 e1				pop hl 
2122				if DEBUG_FORTH_STACK_GUARD 
2122 cd bc 65				call check_stacks 
2125				endif 
2125 c9				ret 
2126			 
2126			 
2126			; increase ret stack pointer and save hl to it 
2126				 
2126			FORTH_RSP_NEXT: macro 
2126				call macro_forth_rsp_next 
2126				endm 
2126			 
2126			macro_forth_rsp_next: 
2126				if DEBUG_FORTH_STACK_GUARD 
2126 cd bc 65				call check_stacks 
2129				endif 
2129 e5				push hl 
212a d5				push de 
212b eb				ex de,hl 
212c 2a 07 f9			ld hl,(cli_ret_sp) 
