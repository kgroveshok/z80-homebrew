0101 3a 8d f9			ld a, (spi_clktime) 
0104			;	cp 0 
0104 b7				or a 
0105 28 03			jr z, .scskip 
0107 cd 62 0a			call aDelayInMS 
010a			.scskip: 
010a f1				pop af 
010b c9				ret 
