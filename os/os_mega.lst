1261			malloc_update_links: 
1261			      ; Update prev_free ptr to point to this_free 
1261 dd 6e 04		      ld    L, (IX+4)               ; prev_free ptr to HL 
1264 dd 66 05		      ld    H, (IX+5) 
1267			 
1267 dd 5e 02		      ld    E, (IX+2)               ; this_free ptr to DE 
126a dd 56 03		      ld    D, (IX+3) 
126d			 
126d 73			      ld    (HL), E                 ; this_free ptr into prev_free 
126e 23			      inc   HL 
126f 72			      ld    (HL), D 
1270			 
1270					if DEBUG_FORTH_MALLOC 
1270						DMARK "Mul" 
1270						CALLMONITOR 
1270					endif 
1270			      ; Clear the Z flag to indicate successful allocation 
1270 7a			      ld    A, D 
1271 b3			      or    E 
1272			 
1272 d1			      pop   DE                      ; Address of allocation 
1273					if DEBUG_FORTH_MALLOC 
1273						DMARK "MAu" 
1273						CALLMONITOR 
1273					endif 
1273			 
1273			malloc_no_space: 
1273 21 06 00		      ld    HL, 6                   ; Clean up stack frame 
1276 39			      add   HL, SP 
1277 f9			      ld    SP, HL 
1278			 
1278 eb			      ex    DE, HL                  ; Alloc addr into HL for return 
1279					if DEBUG_FORTH_MALLOC 
1279						DMARK "MAN" 
1279						CALLMONITOR 
1279					endif 
1279			 
1279			malloc_early_exit: 
1279					if DEBUG_FORTH_MALLOC 
1279						DMARK "MAx" 
1279						CALLMONITOR 
1279					endif 
1279 dd e1		      pop   IX 
127b d1			      pop   DE 
127c c1			      pop   BC 
127d			 
127d			if DEBUG_FORTH_MALLOC_HIGH 
127d			call malloc_guard_exit 
127d			call malloc_guard_zerolen 
127d			endif 
127d c9			      ret 
127e			 
127e			 
127e			;------------------------------------------------------------------------------ 
127e			;     free                                                                    : 
127e			;                                                                             : 
127e			; Description                                                                 : 
127e			;     Return the space pointed to by HL to the heap. HL must be an address as : 
127e			;     returned by malloc, otherwise the behaviour is undefined.               : 
127e			;                                                                             : 
127e			;     Where possible, directly adjacent free blocks will be merged together   : 
127e			;     into larger blocks to help ensure that the heap does not become         : 
127e			;     excessively fragmented.                                                 : 
127e			;                                                                             : 
127e			;     free does not clear or set any other value into the freed space, and    : 
127e			;     therefore its contents may be visible through subsequent malloc's. The  : 
127e			;     caller should clear the freed space as required.                        : 
127e			;                                                                             : 
127e			;     This implementation of free uses the stack exclusively, and is          : 
127e			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
127e			;     advisable to disable interrupts before calling free, and recommended    : 
127e			;     to avoid the use of free inside ISRs in general.                        : 
127e			;                                                                             : 
127e			;     NOTE: heap_init must be called before malloc and free can be used.      : 
127e			;                                                                             : 
127e			; Parameters                                                                  : 
127e			;     HL  Pointer to address of first byte of allocation to be freed          : 
127e			;                                                                             : 
127e			; Returns                                                                     : 
127e			;     Nothing                                                                 : 
127e			;                                                                             : 
127e			; Stack frame                                                                 : 
127e			;       |             |                                                       : 
127e			;       +-------------+                                                       : 
127e			;       |     BC      |                                                       : 
127e			;       +-------------+                                                       : 
127e			;       |     DE      |                                                       : 
127e			;       +-------------+                                                       : 
127e			;       |     IX      |                                                       : 
127e			;       +-------------+                                                       : 
127e			;       |  prev_free  |                                                       : 
127e			;   +2  +-------------+                                                       : 
127e			;       |  next_free  |                                                       : 
127e			;   +0  +-------------+                                                       : 
127e			;       |             |                                                       : 
127e			;                                                                             : 
127e			;------------------------------------------------------------------------------ 
127e			free: 
127e c5			      push  BC 
127f d5			      push  DE 
1280 dd e5		      push  IX 
1282			 
1282 7c			      ld    A, H                    ; Exit if ptr is null 
1283 b5			      or    L 
1284 ca 48 13		      jp    Z, free_early_exit 
1287			 
1287			      ; Set up stack frame 
1287 eb			      ex    DE, HL 
1288 21 fc ff		      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
128b 39			      add   HL, SP 
128c f9			      ld    SP, HL 
128d dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
1291 dd 39		      add   IX, SP 
1293			 
1293			      ; The address in HL points to the start of the useable allocated space, 
1293			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
1293			      ; address of the block itself. 
1293 eb			      ex    DE, HL 
1294 11 fc ff		      ld    DE, -4 
1297 19			      add   HL, DE 
1298			 
1298			      ; An allocated block must have a null next block pointer in it 
1298 7e			      ld    A, (HL) 
1299 23			      inc   HL 
129a b6			      or    (HL) 
129b c2 43 13		      jp    NZ, free_done 
129e			 
129e 2b			      dec   HL 
129f			 
129f 44			      ld    B, H                    ; Copy HL to BC 
12a0 4d			      ld    C, L 
12a1			 
12a1			      ; Loop through the free list to find the first block with an address 
12a1			      ; higher than the block being freed 
12a1 21 0a 80		      ld    HL, free_list 
12a4			 
12a4			free_find_higher_block: 
12a4 5e			      ld    E, (HL)                 ; Load next ptr from free block 
12a5 23			      inc   HL 
12a6 56			      ld    D, (HL) 
12a7 2b			      dec   HL 
12a8			 
12a8 dd 73 00		      ld    (IX+0), E               ; Save ptr to next free block 
12ab dd 72 01		      ld    (IX+1), D 
12ae dd 75 02		      ld    (IX+2), L               ; Save ptr to prev free block 
12b1 dd 74 03		      ld    (IX+3), H 
12b4			 
12b4 78			      ld    A, B                    ; Check if DE is greater than BC 
12b5 ba			      cp    D                       ; Compare MSB first 
12b6 28 02		      jr    Z, $+4                  ; MSB the same, compare LSB 
12b8 30 04		      jr    NC, free_find_higher_block_skip 
12ba 79			      ld    A, C 
12bb bb			      cp    E                       ; Then compare LSB 
12bc 38 08		      jr    C, free_found_higher_block 
12be			 
12be			free_find_higher_block_skip: 
12be 7a			      ld    A, D                    ; Reached the end of the free list? 
12bf b3			      or    E 
12c0 ca 43 13		      jp    Z, free_done 
12c3			 
12c3 eb			      ex    DE, HL 
12c4			 
12c4 18 de		      jr    free_find_higher_block 
12c6			 
12c6			free_found_higher_block: 
12c6			      ; Insert freed block between prev and next free blocks 
12c6 71			      ld    (HL), C                 ; Point prev free block to freed block 
12c7 23			      inc   HL 
12c8 70			      ld    (HL), B 
12c9			 
12c9 60			      ld    H, B                    ; Point freed block at next free block 
12ca 69			      ld    L, C 
12cb 73			      ld    (HL), E 
12cc 23			      inc   HL 
12cd 72			      ld    (HL), D 
12ce			 
12ce			      ; Check if the freed block is adjacent to the next free block 
12ce 23			      inc   HL                      ; Load size of freed block into HL 
12cf 5e			      ld    E, (HL) 
12d0 23			      inc   HL 
12d1 56			      ld    D, (HL) 
12d2 eb			      ex    DE, HL 
12d3			 
12d3 09			      add   HL, BC                  ; Add addr of freed block and its size 
12d4			 
12d4 dd 5e 00		      ld    E, (IX+0)               ; Load addr of next free block into DE 
12d7 dd 56 01		      ld    D, (IX+1) 
12da			 
12da b7			      or    A                       ; Clear the carry flag 
12db ed 52		      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
12dd 20 22		      jr    NZ, free_check_adjacent_to_prev 
12df			 
12df			      ; Freed block is adjacent to next, merge into one bigger block 
12df eb			      ex    DE, HL                  ; Load next ptr from next block into DE 
12e0 5e			      ld    E, (HL) 
12e1 23			      inc   HL 
12e2 56			      ld    D, (HL) 
12e3 e5			      push  HL                      ; Save ptr to next block for later 
12e4			 
12e4 60			      ld    H, B                    ; Store ptr from next block into freed block 
12e5 69			      ld    L, C 
12e6 73			      ld    (HL), E 
12e7 23			      inc   HL 
12e8 72			      ld    (HL), D 
12e9			 
12e9 e1			      pop   HL                      ; Restore ptr to next block 
12ea 23			      inc   HL                      ; Load size of next block into DE 
12eb 5e			      ld    E, (HL) 
12ec 23			      inc   HL 
12ed 56			      ld    D, (HL) 
12ee d5			      push  DE                      ; Save next block size for later 
12ef			 
12ef 60			      ld    H, B                    ; Load size of freed block into HL 
12f0 69			      ld    L, C 
12f1 23			      inc   HL 
12f2 23			      inc   HL 
12f3 5e			      ld    E, (HL) 
12f4 23			      inc   HL 
12f5 56			      ld    D, (HL) 
12f6 eb			      ex    DE, HL 
12f7			 
12f7 d1			      pop   DE                      ; Restore size of next block 
12f8 19			      add   HL, DE                  ; Add sizes of both blocks 
12f9 eb			      ex    DE, HL 
12fa			 
12fa 60			      ld    H, B                    ; Store new bigger size into freed block 
12fb 69			      ld    L, C 
12fc 23			      inc   HL 
12fd 23			      inc   HL 
12fe 73			      ld    (HL), E 
12ff 23			      inc   HL 
1300 72			      ld    (HL), D 
1301			 
1301			free_check_adjacent_to_prev: 
1301			      ; Check if the freed block is adjacent to the prev free block 
1301 dd 6e 02		      ld    L, (IX+2)               ; Prev free block ptr into HL 
1304 dd 66 03		      ld    H, (IX+3) 
1307			 
1307 23			      inc   HL                      ; Size of prev free block into DE 
1308 23			      inc   HL 
1309 5e			      ld    E, (HL) 
130a 23			      inc   HL 
130b 56			      ld    D, (HL) 
130c 2b			      dec   HL 
130d 2b			      dec   HL 
130e 2b			      dec   HL 
130f			 
130f 19			      add   HL, DE                  ; Add prev block addr and size 
1310			 
1310 b7			      or    A                       ; Clear the carry flag 
1311 ed 42		      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
1313 20 2e		      jr    NZ, free_done 
1315			 
1315			      ; Freed block is adjacent to prev, merge into one bigger block 
1315 60			      ld    H, B                    ; Load next ptr from freed block into DE 
1316 69			      ld    L, C 
1317 5e			      ld    E, (HL) 
1318 23			      inc   HL 
1319 56			      ld    D, (HL) 
131a e5			      push  HL                      ; Save freed block ptr for later 
131b			 
131b dd 6e 02		      ld    L, (IX+2)               ; Store freed block ptr into prev block 
131e dd 66 03		      ld    H, (IX+3) 
1321 73			      ld    (HL), E 
1322 23			      inc   HL 
1323 72			      ld    (HL), D 
1324			 
1324 e1			      pop   HL                      ; Restore freed block ptr 
1325 23			      inc   HL                      ; Load size of freed block into DE 
1326 5e			      ld    E, (HL) 
1327 23			      inc   HL 
1328 56			      ld    D, (HL) 
1329 d5			      push  DE                      ; Save freed block size for later 
132a			 
132a dd 6e 02		      ld    L, (IX+2)               ; Load size of prev block into DE 
132d dd 66 03		      ld    H, (IX+3) 
1330 23			      inc   HL 
1331 23			      inc   HL 
1332 5e			      ld    E, (HL) 
1333 23			      inc   HL 
1334 56			      ld    D, (HL) 
1335			 
1335 e1			      pop   HL                      ; Add sizes of both blocks 
1336 19			      add   HL, DE 
1337 eb			      ex    DE, HL 
1338			 
1338 dd 6e 02		      ld    L, (IX+2)               ; Store new bigger size into prev block 
133b dd 66 03		      ld    H, (IX+3) 
133e 23			      inc   HL 
133f 23			      inc   HL 
1340 73			      ld    (HL), E 
1341 23			      inc   HL 
1342 72			      ld    (HL), D 
1343			 
1343			free_done: 
1343 21 04 00		      ld    HL, 4                   ; Clean up stack frame 
1346 39			      add   HL, SP 
1347 f9			      ld    SP, HL 
1348			 
1348			free_early_exit: 
1348 dd e1		      pop   IX 
134a d1			      pop   DE 
134b c1			      pop   BC 
134c			 
134c c9			      ret 
134d			 
134d			; moved to firmware.asm 
134d			; 
134d			;free_list         .dw   0     ; Block struct for start of free list (MUST be 4 bytes) 
134d			;                  .dw   0 
134d			 
134d			 
134d			endif 
134d			 
134d			 
134d			if MALLOC_3 
134d			; https://gist.githubusercontent.com/tomstorey/947a8b084bad69391a4b2a1c5b6d69ca/raw/5a08fb30a480d98c0deb4a6afe2d48961cc8e9d9/z80_malloc.s 
134d			;heap_start        .equ  0x9000      ; Starting address of heap 
134d			;heap_size         .equ  0x0100      ; Number of bytes available in heap 
134d			; 
134d			 ;     .org 0 
134d			  ;    jp    main 
134d			; 
134d			; 
134d			 ;     .org  0x100 
134d			;main: 
134d			 ;     ld    HL, 0x8100 
134d			  ;    ld    SP, HL 
134d			; 
134d			;      call  heap_init 
134d			 
134d			      ; Make some allocations 
134d			;      ld    HL, 12 
134d			;      call  malloc            ; Allocates 0x9004 
134d			; 
134d			 ;     ld    HL, 12 
134d			;      call  malloc            ; Allocates 0x9014 
134d			 
134d			;      ld    HL, 12 
134d			;      call  malloc            ; Allocates 0x9024 
134d			 
134d			      ; Free some allocations 
134d			;      ld    HL, 0x9014 
134d			;      call  free 
134d			 
134d			;      ld    HL, 0x9004 
134d			;      call  free 
134d			; 
134d			;      ld    HL, 0x9024 
134d			;      call  free 
134d			 
134d			 
134d			 ;     halt 
134d			 
134d			 
134d			;------------------------------------------------------------------------------ 
134d			;     heap_init                                                               : 
134d			;                                                                             : 
134d			; Description                                                                 : 
134d			;     Initialise the heap and make it ready for malloc and free operations.   : 
134d			;                                                                             : 
134d			;     The heap is maintained as a linked list, starting with an initial       : 
134d			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
134d			;     the first free block in the heap. Each block then points to the next    : 
134d			;     free block within the heap, and the free list ends at the first block   : 
134d			;     with a null pointer to the next free block.                             : 
134d			;                                                                             : 
134d			; Parameters                                                                  : 
134d			;     Inputs are compile-time only. Two defines which specify the starting    : 
134d			;     address of the heap and its size are required, along with a memory      : 
134d			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
134d			;     principally stores a pointer to the first free block in the heap.       : 
134d			;                                                                             : 
134d			; Returns                                                                     : 
134d			;     Nothing                                                                 : 
134d			;------------------------------------------------------------------------------ 
134d			heap_init: 
134d			      push  HL 
134d			 
134d			      ; Initialise free list struct 
134d			      ld    HL, heap_start 
134d			      ld    (free_list), HL 
134d			      ld    HL, 0 
134d			      ld    (free_list+2), HL 
134d			 
134d			      ; Insert first free block at bottom of heap, consumes entire heap 
134d			      ld    HL, heap_start+heap_size-4 
134d			      ld    (heap_start), HL        ; Next block (end of free list) 
134d			      ld    HL, heap_size-4 
134d			      ld    (heap_start+2), HL      ; Block size 
134d			 
134d			      ; Insert end of free list block at top of heap - two null words will 
134d			      ; terminate the free list 
134d			      ld    HL, 0 
134d			      ld    (heap_start+heap_size-2), HL 
134d			      ld    (heap_start+heap_size-4), HL 
134d			 
134d			      pop   HL 
134d			 
134d			      ret 
134d			 
134d			 
134d			;------------------------------------------------------------------------------ 
134d			;     malloc                                                                  : 
134d			;                                                                             : 
134d			; Description                                                                 : 
134d			;     Allocates the wanted space from the heap and returns the address of the : 
134d			;     first useable byte of the allocation.                                   : 
134d			;                                                                             : 
134d			;     Allocations can happen in one of two ways:                              : 
134d			;                                                                             : 
134d			;     1. A free block may be found which is the exact size wanted. In this    : 
134d			;        case the block is removed from the free list and retuedn to the      : 
134d			;        caller.                                                              : 
134d			;     2. A free block may be found which is larger than the size wanted. In   : 
134d			;        this case, the larger block is split into two. The first portion of  : 
134d			;        this block will become the requested space by the malloc call and    : 
134d			;        is returned to the caller. The second portion becomes a new free     : 
134d			;        block, and the free list is adjusted to maintain continuity via this : 
134d			;        newly created block.                                                 : 
134d			;                                                                             : 
134d			;     malloc does not set any initial value in the allocated space, the       : 
134d			;     caller is required to do this as required.                              : 
134d			;                                                                             : 
134d			;     This implementation of malloc uses the stack exclusively, and is        : 
134d			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
134d			;     advisable to disable interrupts before calling malloc, and recommended  : 
134d			;     to avoid the use of malloc inside ISRs in general.                      : 
134d			;                                                                             : 
134d			;     NOTE: heap_init must be called before malloc and free can be used.      : 
134d			;                                                                             : 
134d			; Parameters                                                                  : 
134d			;     HL  Number of bytes wanted                                              : 
134d			;                                                                             : 
134d			; Returns                                                                     : 
134d			;     HL  Address of the first useable byte of the allocation                 : 
134d			;                                                                             : 
134d			; Flags                                                                       : 
134d			;     Z   Set if the allocation did not succeed, clear otherwise              : 
134d			;                                                                             : 
134d			; Stack frame                                                                 : 
134d			;       |             |                                                       : 
134d			;       +-------------+                                                       : 
134d			;       |     BC      |                                                       : 
134d			;       +-------------+                                                       : 
134d			;       |     DE      |                                                       : 
134d			;       +-------------+                                                       : 
134d			;       |     IX      |                                                       : 
134d			;       +-------------+                                                       : 
134d			;       |  prev_free  |                                                       : 
134d			;   +4  +-------------+                                                       : 
134d			;       |  this_free  |                                                       : 
134d			;   +2  +-------------+                                                       : 
134d			;       |  next_free  |                                                       : 
134d			;   +0  +-------------+                                                       : 
134d			;       |             |                                                       : 
134d			;                                                                             : 
134d			;------------------------------------------------------------------------------ 
134d			malloc: 
134d			      push  BC 
134d			      push  DE 
134d			      push  IX 
134d			 
134d			      ld    A, H                    ; Exit if no space requested 
134d			      or    L 
134d			      jp    Z, malloc_early_exit 
134d			 
134d			      ; Set up stack frame 
134d			      ex    DE, HL 
134d			      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
134d			      add   HL, SP 
134d			      ld    SP, HL 
134d			      ld    IX, 0                   ; Use IX as a frame pointer 
134d			      add   IX, SP 
134d			 
134d			      ; Setup initial state 
134d			      ld    HL, 4                   ; want must also include space used by block struct 
134d			      add   HL, DE 
134d			 
134d			      ld    B, H                    ; Move want to BC 
134d			      ld    C, L 
134d			 
134d			      ld    HL, free_list           ; Store prev_free ptr to stack 
134d			      ld    (IX+4), L 
134d			      ld    (IX+5), H 
134d			 
134d			      ld    E, (HL)                 ; Store this_free ptr to stack 
134d			      inc   HL 
134d			      ld    D, (HL) 
134d			      ld    (IX+2), E 
134d			      ld    (IX+3), D 
134d			      ex    DE, HL                  ; this_free ptr into HL 
134d			 
134d			      ; Loop through free block list to find some space 
134d			malloc_find_space: 
134d			      ld    E, (HL)                 ; Load next_free ptr into DE 
134d			      inc   HL 
134d			      ld    D, (HL) 
134d			 
134d			      ld    A, D                    ; Check for null next_free ptr - end of free list 
134d			      or    E 
134d			      jp    Z, malloc_no_space 
134d			 
134d			      ld    (IX+0), E               ; Store next_free ptr to stack 
134d			      ld    (IX+1), D 
134d			 
134d			      ; Does this block have enough space to make the allocation? 
134d			      inc   HL                      ; Load free block size into DE 
134d			      ld    E, (HL) 
134d			      inc   HL 
134d			      ld    D, (HL) 
134d			 
134d			      ex    DE, HL                  ; Check size of block against want 
134d			      or    A                       ; Ensure carry flag clear 
134d			      sbc   HL, BC 
134d			      push  HL                      ; Store the result for later (new block size) 
134d			 
134d			      jr    Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
134d			      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
134d			 
134d			      ; this_free block is not big enough, setup ptrs to test next free block 
134d			      pop   HL                      ; Discard previous result 
134d			 
134d			      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
134d			      ld    H, (IX+3) 
134d			      ld    (IX+4), L 
134d			      ld    (IX+5), H 
134d			 
134d			      ld    L, (IX+0)               ; Move next_free ptr into this_free 
134d			      ld    H, (IX+1) 
134d			      ld    (IX+2), L 
134d			      ld    (IX+3), H 
134d			 
134d			      jr    malloc_find_space 
134d			 
134d			      ; split a bigger block into two - requested size and remaining size 
134d			malloc_alloc_split: 
134d			      ex    DE, HL                  ; Calculate address of new free block 
134d			      dec   HL 
134d			      dec   HL 
134d			      dec   HL 
134d			      add   HL, BC 
134d			 
134d			      ; Create a new block and point it at next_free 
134d			      ld    E, (IX+0)               ; Load next_free ptr into DE 
134d			      ld    D, (IX+1) 
134d			 
134d			      ld    (HL), E                 ; Store next_free ptr into new block 
134d			      inc   HL 
134d			      ld    (HL), D 
134d			 
134d			      pop   DE                      ; Store size of new block into new block 
134d			      inc   HL 
134d			      ld    (HL), E 
134d			      inc   HL 
134d			      ld    (HL), D 
134d			 
134d			      ; Update this_free ptr to point to new block 
134d			      dec   HL 
134d			      dec   HL 
134d			      dec   HL 
134d			 
134d			      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
134d			      ld    D, (IX+3) 
134d			 
134d			      ld    (IX+2), L               ; Store new block addr as this_free ptr 
134d			      ld    (IX+3), H 
134d			 
134d			      ; Modify this_free block to be allocation 
134d			      ex    DE, HL 
134d			      xor   A                       ; Null the next block ptr of allocated block 
134d			      ld    (HL), A 
134d			      inc   HL 
134d			      ld    (HL), A 
134d			 
134d			      inc   HL                      ; Store want size into allocated block 
134d			      ld    (HL), C 
134d			      inc   HL 
134d			      ld    (HL), B 
134d			      inc   HL 
134d			      push  HL                      ; Address of allocation to return 
134d			 
134d			      jr    malloc_update_links 
134d			 
134d			malloc_alloc_fit: 
134d			      pop   HL                      ; Dont need new block size, want is exact fit 
134d			 
134d			      ; Modify this_free block to be allocation 
134d			      ex    DE, HL 
134d			      dec   HL 
134d			      dec   HL 
134d			      dec   HL 
134d			 
134d			      xor   A                       ; Null the next block ptr of allocated block 
134d			      ld    (HL), A 
134d			      inc   HL 
134d			      ld    (HL), A 
134d			 
134d			      inc   HL                      ; Store address of allocation to return 
134d			      inc   HL 
134d			      inc   HL 
134d			      push  HL 
134d			 
134d			      ; Copy next_free ptr to this_free, remove allocated block from free list 
134d			      ld    L, (IX+0)               ; next_free to HL 
134d			      ld    H, (IX+1) 
134d			 
134d			      ld    (IX+2), L               ; HL to this_free 
134d			      ld    (IX+3), H 
134d			 
134d			 
134d			malloc_update_links: 
134d			      ; Update prev_free ptr to point to this_free 
134d			      ld    L, (IX+4)               ; prev_free ptr to HL 
134d			      ld    H, (IX+5) 
134d			 
134d			      ld    E, (IX+2)               ; this_free ptr to DE 
134d			      ld    D, (IX+3) 
134d			 
134d			      ld    (HL), E                 ; this_free ptr into prev_free 
134d			      inc   HL 
134d			      ld    (HL), D 
134d			 
134d			      ; Clear the Z flag to indicate successful allocation 
134d			      ld    A, D 
134d			      or    E 
134d			 
134d			      pop   DE                      ; Address of allocation 
134d			 
134d			malloc_no_space: 
134d			      ld    HL, 6                   ; Clean up stack frame 
134d			      add   HL, SP 
134d			      ld    SP, HL 
134d			 
134d			      ex    DE, HL                  ; Alloc addr into HL for return 
134d			 
134d			malloc_early_exit: 
134d			      pop   IX 
134d			      pop   DE 
134d			      pop   BC 
134d			 
134d			      ret 
134d			 
134d			 
134d			;------------------------------------------------------------------------------ 
134d			;     free                                                                    : 
134d			;                                                                             : 
134d			; Description                                                                 : 
134d			;     Return the space pointed to by HL to the heap. HL must be an address as : 
134d			;     returned by malloc, otherwise the behaviour is undefined.               : 
134d			;                                                                             : 
134d			;     Where possible, directly adjacent free blocks will be merged together   : 
134d			;     into larger blocks to help ensure that the heap does not become         : 
134d			;     excessively fragmented.                                                 : 
134d			;                                                                             : 
134d			;     free does not clear or set any other value into the freed space, and    : 
134d			;     therefore its contents may be visible through subsequent malloc's. The  : 
134d			;     caller should clear the freed space as required.                        : 
134d			;                                                                             : 
134d			;     This implementation of free uses the stack exclusively, and is          : 
134d			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
134d			;     advisable to disable interrupts before calling free, and recommended    : 
134d			;     to avoid the use of free inside ISRs in general.                        : 
134d			;                                                                             : 
134d			;     NOTE: heap_init must be called before malloc and free can be used.      : 
134d			;                                                                             : 
134d			; Parameters                                                                  : 
134d			;     HL  Pointer to address of first byte of allocation to be freed          : 
134d			;                                                                             : 
134d			; Returns                                                                     : 
134d			;     Nothing                                                                 : 
134d			;                                                                             : 
134d			; Stack frame                                                                 : 
134d			;       |             |                                                       : 
134d			;       +-------------+                                                       : 
134d			;       |     BC      |                                                       : 
134d			;       +-------------+                                                       : 
134d			;       |     DE      |                                                       : 
134d			;       +-------------+                                                       : 
134d			;       |     IX      |                                                       : 
134d			;       +-------------+                                                       : 
134d			;       |  prev_free  |                                                       : 
134d			;   +2  +-------------+                                                       : 
134d			;       |  next_free  |                                                       : 
134d			;   +0  +-------------+                                                       : 
134d			;       |             |                                                       : 
134d			;                                                                             : 
134d			;------------------------------------------------------------------------------ 
134d			free: 
134d			      push  BC 
134d			      push  DE 
134d			      push  IX 
134d			 
134d			      ld    A, H                    ; Exit if ptr is null 
134d			      or    L 
134d			      jp    Z, free_early_exit 
134d			 
134d			      ; Set up stack frame 
134d			      ex    DE, HL 
134d			      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
134d			      add   HL, SP 
134d			      ld    SP, HL 
134d			      ld    IX, 0                   ; Use IX as a frame pointer 
134d			      add   IX, SP 
134d			 
134d			      ; The address in HL points to the start of the useable allocated space, 
134d			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
134d			      ; address of the block itself. 
134d			      ex    DE, HL 
134d			      ld    DE, -4 
134d			      add   HL, DE 
134d			 
134d			      ; An allocated block must have a null next block pointer in it 
134d			      ld    A, (HL) 
134d			      inc   HL 
134d			      or    (HL) 
134d			      jp    NZ, free_done 
134d			 
134d			      dec   HL 
134d			 
134d			      ld    B, H                    ; Copy HL to BC 
134d			      ld    C, L 
134d			 
134d			      ; Loop through the free list to find the first block with an address 
134d			      ; higher than the block being freed 
134d			      ld    HL, free_list 
134d			 
134d			free_find_higher_block: 
134d			      ld    E, (HL)                 ; Load next ptr from free block 
134d			      inc   HL 
134d			      ld    D, (HL) 
134d			      dec   HL 
134d			 
134d			      ld    (IX+0), E               ; Save ptr to next free block 
134d			      ld    (IX+1), D 
134d			      ld    (IX+2), L               ; Save ptr to prev free block 
134d			      ld    (IX+3), H 
134d			 
134d			      ld    A, B                    ; Check if DE is greater than BC 
134d			      cp    D                       ; Compare MSB first 
134d			      jr    Z, $+4                  ; MSB the same, compare LSB 
134d			      jr    NC, free_find_higher_block_skip 
134d			      ld    A, C 
134d			      cp    E                       ; Then compare LSB 
134d			      jr    C, free_found_higher_block 
134d			 
134d			free_find_higher_block_skip: 
134d			      ld    A, D                    ; Reached the end of the free list? 
134d			      or    E 
134d			      jp    Z, free_done 
134d			 
134d			      ex    DE, HL 
134d			 
134d			      jr    free_find_higher_block 
134d			 
134d			free_found_higher_block: 
134d			      ; Insert freed block between prev and next free blocks 
134d			      ld    (HL), C                 ; Point prev free block to freed block 
134d			      inc   HL 
134d			      ld    (HL), B 
134d			 
134d			      ld    H, B                    ; Point freed block at next free block 
134d			      ld    L, C 
134d			      ld    (HL), E 
134d			      inc   HL 
134d			      ld    (HL), D 
134d			 
134d			      ; Check if the freed block is adjacent to the next free block 
134d			      inc   HL                      ; Load size of freed block into HL 
134d			      ld    E, (HL) 
134d			      inc   HL 
134d			      ld    D, (HL) 
134d			      ex    DE, HL 
134d			 
134d			      add   HL, BC                  ; Add addr of freed block and its size 
134d			 
134d			      ld    E, (IX+0)               ; Load addr of next free block into DE 
134d			      ld    D, (IX+1) 
134d			 
134d			      or    A                       ; Clear the carry flag 
134d			      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
134d			      jr    NZ, free_check_adjacent_to_prev 
134d			 
134d			      ; Freed block is adjacent to next, merge into one bigger block 
134d			      ex    DE, HL                  ; Load next ptr from next block into DE 
134d			      ld    E, (HL) 
134d			      inc   HL 
134d			      ld    D, (HL) 
134d			      push  HL                      ; Save ptr to next block for later 
134d			 
134d			      ld    H, B                    ; Store ptr from next block into freed block 
134d			      ld    L, C 
134d			      ld    (HL), E 
134d			      inc   HL 
134d			      ld    (HL), D 
134d			 
134d			      pop   HL                      ; Restore ptr to next block 
134d			      inc   HL                      ; Load size of next block into DE 
134d			      ld    E, (HL) 
134d			      inc   HL 
134d			      ld    D, (HL) 
134d			      push  DE                      ; Save next block size for later 
134d			 
134d			      ld    H, B                    ; Load size of freed block into HL 
134d			      ld    L, C 
134d			      inc   HL 
134d			      inc   HL 
134d			      ld    E, (HL) 
134d			      inc   HL 
134d			      ld    D, (HL) 
134d			      ex    DE, HL 
134d			 
134d			      pop   DE                      ; Restore size of next block 
134d			      add   HL, DE                  ; Add sizes of both blocks 
134d			      ex    DE, HL 
134d			 
134d			      ld    H, B                    ; Store new bigger size into freed block 
134d			      ld    L, C 
134d			      inc   HL 
134d			      inc   HL 
134d			      ld    (HL), E 
134d			      inc   HL 
134d			      ld    (HL), D 
134d			 
134d			free_check_adjacent_to_prev: 
134d			      ; Check if the freed block is adjacent to the prev free block 
134d			      ld    L, (IX+2)               ; Prev free block ptr into HL 
134d			      ld    H, (IX+3) 
134d			 
134d			      inc   HL                      ; Size of prev free block into DE 
134d			      inc   HL 
134d			      ld    E, (HL) 
134d			      inc   HL 
134d			      ld    D, (HL) 
134d			      dec   HL 
134d			      dec   HL 
134d			      dec   HL 
134d			 
134d			      add   HL, DE                  ; Add prev block addr and size 
134d			 
134d			      or    A                       ; Clear the carry flag 
134d			      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
134d			      jr    NZ, free_done 
134d			 
134d			      ; Freed block is adjacent to prev, merge into one bigger block 
134d			      ld    H, B                    ; Load next ptr from freed block into DE 
134d			      ld    L, C 
134d			      ld    E, (HL) 
134d			      inc   HL 
134d			      ld    D, (HL) 
134d			      push  HL                      ; Save freed block ptr for later 
134d			 
134d			      ld    L, (IX+2)               ; Store freed block ptr into prev block 
134d			      ld    H, (IX+3) 
134d			      ld    (HL), E 
134d			      inc   HL 
134d			      ld    (HL), D 
134d			 
134d			      pop   HL                      ; Restore freed block ptr 
134d			      inc   HL                      ; Load size of freed block into DE 
134d			      ld    E, (HL) 
134d			      inc   HL 
134d			      ld    D, (HL) 
134d			      push  DE                      ; Save freed block size for later 
134d			 
134d			      ld    L, (IX+2)               ; Load size of prev block into DE 
134d			      ld    H, (IX+3) 
134d			      inc   HL 
134d			      inc   HL 
134d			      ld    E, (HL) 
134d			      inc   HL 
134d			      ld    D, (HL) 
134d			 
134d			      pop   HL                      ; Add sizes of both blocks 
134d			      add   HL, DE 
134d			      ex    DE, HL 
134d			 
134d			      ld    L, (IX+2)               ; Store new bigger size into prev block 
134d			      ld    H, (IX+3) 
134d			      inc   HL 
134d			      inc   HL 
134d			      ld    (HL), E 
134d			      inc   HL 
134d			      ld    (HL), D 
134d			 
134d			free_done: 
134d			      ld    HL, 4                   ; Clean up stack frame 
134d			      add   HL, SP 
134d			      ld    SP, HL 
134d			 
134d			free_early_exit: 
134d			      pop   IX 
134d			      pop   DE 
134d			      pop   BC 
134d			 
134d			      ret 
134d			 
134d			 
134d			;      .org 0x8000 
134d			; 
134d			;free_list         .dw   0     ; Block struct for start of free list (MUST be 4 bytes) 
134d			 ;                 .dw   0 
134d			 
134d			endif 
134d			 
134d			 
134d			if MALLOC_4 
134d			 
134d			; My memory allocation code. Very very simple.... 
134d			; allocate space under 250 chars 
134d			 
134d			heap_init: 
134d				; init start of heap as zero 
134d				;  
134d			 
134d				ld hl, heap_start 
134d			;	ld a, 0 
134d				ld (hl), 0      ; empty block 
134d				inc hl 
134d			;	ld a, 0 
134d				ld (hl), 0      ; length of block 
134d				; write end of list 
134d				inc hl 
134d				ld a,(hl) 
134d				inc hl 
134d				ld a,(hl) 
134d				 
134d			 
134d				; init some malloc vars 
134d			 
134d				ld hl, 0 
134d				ld (free_list), hl       ; store last malloc location 
134d			 
134d				ld hl, free_list+3      ; flag for 'free' being used and force a rescan for reuse of block  
134d			;	ld a, 0 
134d				ld (hl), 0 
134d			 
134d			 
134d				ld hl, heap_start 
134d				;  
134d				  
134d				ret 
134d			 
134d			 
134d			;    free block marker 
134d			;    requested size  
134d			;    pointer to next block 
134d			;    .... 
134d			;    next block marker 
134d			 
134d			 
134d			; TODO add a flag that is reset on use of free. if flag is reset then start scan from start of heap otherwise use last location 
134d			; 
134d			 
134d			 
134d			malloc:  
134d				push de 
134d				push bc 
134d				push af 
134d			 
134d				; hl space required 
134d				 
134d				ld c, l    ; hold space   (TODO only a max of 255) 
134d			 
134d			;	inc c     ; TODO BUG need to fix memory leak on push str 
134d			;	inc c 
134d			;	inc c 
134d			;	inc c 
134d			;	inc c 
134d			;	inc c 
134d			;	inc c 
134d			 
134d			 
134d			 
134d				; start at heap if a free has been issued so we can reclaim it otherwise continue from last time 
134d			 
134d				ld a, (free_list+3) 
134d			;	cp 0 
134d				or a 
134d				jr z, .contheap 
134d			 
134d				ld hl, (free_list)     ; get last alloc 
134d					if DEBUG_FORTH_MALLOC_INT 
134d						DMARK "mrs" 
134d						CALLMONITOR 
134d					endif 
134d				jr .startalloc 
134d			 
134d			.contheap: 
134d				ld hl, heap_start 
134d			 
134d			.startalloc: 
134d			 
134d					if DEBUG_FORTH_MALLOC_INT 
134d						DMARK "mym" 
134d						CALLMONITOR 
134d					endif 
134d			.findblock: 
134d					if DEBUG_FORTH_MALLOC_INT 
134d						DMARK "mmf" 
134d						CALLMONITOR 
134d					endif 
134d			 
134d				ld a,(hl)  
134d				; if byte is zero then clear to use 
134d			 
134d			;	cp 0 
134d				or a 
134d				jr z, .foundemptyblock 
134d			 
134d				; if byte is not clear 
134d				;     then byte is offset to next block 
134d			 
134d				inc hl 
134d				ld a, (hl) ; get size 
134d			.nextblock:	inc hl 
134d					ld e, (hl) 
134d					inc hl 
134d					ld d, (hl) 
134d					ex de, hl 
134d			;	inc hl  ; move past the store space 
134d			;	inc hl  ; move past zero index  
134d			 
134d				; TODO detect no more space 
134d			 
134d				push hl 
134d				ld de, heap_end 
134d				call cmp16 
134d				pop hl 
134d				jr nc, .nospace 
134d			 
134d				jr .findblock 
134d			 
134d			.nospace: ld hl, 0 
134d				jp .exit 
134d			 
134d			 
134d			.foundemptyblock:	 
134d					if DEBUG_FORTH_MALLOC_INT 
134d						DMARK "mme" 
134d						CALLMONITOR 
134d					endif 
134d			 
134d			; TODO has block enough space if reusing??? 
134d			 
134d				;  
134d			 
134d			; see if this block has been previously used 
134d				inc hl 
134d				ld a, (hl) 
134d				dec hl 
134d			;	cp 0 
134d				or a 
134d				jr z, .newblock 
134d			 
134d					if DEBUG_FORTH_MALLOC_INT 
134d						DMARK "meR" 
134d						CALLMONITOR 
134d					endif 
134d			 
134d			; no reusing previously allocated block 
134d			 
134d			; is it smaller than previously used? 
134d				 
134d				inc hl    ; move to size 
134d				ld a, c 
134d				sub (hl)        ; we want c < (hl) 
134d				dec hl    ; move back to marker 
134d			        jr z, .findblock 
134d			 
134d				; update with the new size which should be lower 
134d			 
134d			        ;inc  hl   ; negate next move. move back to size  
134d			 
134d			.newblock: 
134d				; need to be at marker here 
134d			 
134d					if DEBUG_FORTH_MALLOC_INT 
134d						DMARK "meN" 
134d						CALLMONITOR 
134d					endif 
134d			 
134d			 
134d				ld a, c 
134d			 
134d				ld (free_list+3), a	 ; flag resume from last malloc  
134d				ld (free_list), hl    ; save out last location 
134d			 
134d			 
134d				;inc a     ; space for length byte 
134d				ld (hl), a     ; save block in use marker 
134d			 
134d				inc hl   ; move to space marker 
134d				ld (hl), a    ; save new space 
134d			 
134d				inc hl   ; move to start of allocated area 
134d				 
134d			;	push hl     ; save where we are - 1  
134d			 
134d			;	inc hl  ; move past zero index  
134d				; skip space to set down new marker 
134d			 
134d				; provide some extra space for now 
134d			 
134d				inc a    ; actual is one fewer than bytes requested. correct if zero index is taken into account 
134d				inc a 
134d				inc a 
134d			 
134d				push hl   ; save where we are in the node block 
134d			 
134d				call addatohl 
134d			 
134d				; write linked list point 
134d			 
134d				pop de     ; get our node position 
134d				ex de, hl 
134d			 
134d				ld (hl), e 
134d				inc hl 
134d				ld (hl), d 
134d			 
134d				inc hl 
134d			 
134d				; now at start of allocated data so save pointer 
134d			 
134d				push hl 
134d			 
134d				; jump to position of next node and setup empty header in DE 
134d			 
134d				ex de, hl 
134d			 
134d			;	inc hl ; move past end of block 
134d			 
134d			;	ld a, 0 
134d				ld (hl), 0   ; empty marker 
134d				inc hl 
134d				ld (hl), 0   ; size 
134d				inc hl  
134d				ld (hl), 0   ; ptr 
134d				inc hl 
134d				ld (hl), 0   ; ptr 
134d			 
134d			 
134d				pop hl 
134d			 
134d					if DEBUG_FORTH_MALLOC_INT 
134d						DMARK "mmr" 
134d						CALLMONITOR 
134d					endif 
134d			 
134d			.exit: 
134d				pop af 
134d				pop bc 
134d				pop de  
134d				ret 
134d			 
134d			 
134d			 
134d			 
134d			free:  
134d				push hl 
134d				push af 
134d				; get address in hl 
134d			 
134d					if DEBUG_FORTH_MALLOC_INT 
134d						DMARK "fre" 
134d						CALLMONITOR 
134d					endif 
134d				; data is at hl - move to block count 
134d				dec hl 
134d				dec hl    ; get past pointer 
134d				dec hl 
134d			 
134d				ld a, (hl)    ; need this for a validation check 
134d			 
134d				dec hl    ; move to block marker 
134d			 
134d				; now check that the block count and block marker are the same  
134d			        ; this checks that we are on a malloc node and not random memory 
134d			        ; OK a faint chance this could be a problem but rare - famous last words! 
134d			 
134d				ld c, a 
134d				ld a, (hl)    
134d			 
134d				cp c 
134d				jr nz, .freeignore      ; not a valid malloc node in use so dont break anything 
134d			 
134d				; yes good chance we are on a malloc node 
134d			 
134d			;	ld a, 0      
134d				ld (hl), 0   ; mark as free 
134d			 
134d				ld (free_list+3), a	 ; flag reuse of existing block on next malloc 
134d			 
134d			.freeignore:  
134d			 
134d				pop af 
134d				pop hl 
134d			 
134d				ret 
134d			 
134d			 
134d			 
134d			endif 
134d			 
134d			; eof 
# End of file firmware_memory.asm
