6e65			; clock      ce       reset     output  
6e65			; 0          x        0         n  
6e65			; x          1        0         n  
6e65			; x          x        1         q0  
6e65			; rising     0        0         n+1  
6e65			; falling    x        0         n  
6e65			; x          rising   0         n  
6e65			; 1          falling  0         x+1  
