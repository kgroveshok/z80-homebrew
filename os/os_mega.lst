0ce1			 
0ce1			 
0ce1			;;;; int maths 
0ce1			 
0ce1			; https://map.grauw.nl/articles/mult_div_shifts.php 
0ce1			; Divide 16-bit values (with 16-bit result) 
0ce1			; In: Divide BC by divider DE 
0ce1			; Out: BC = result, HL = rest 
0ce1			; 
0ce1			Div16: 
0ce1 21 00 00		    ld hl,0 
0ce4 78			    ld a,b 
0ce5 06 08		    ld b,8 
0ce7			Div16_Loop1: 
0ce7 17			    rla 
0ce8 ed 6a		    adc hl,hl 
0cea ed 52		    sbc hl,de 
0cec 30 01		    jr nc,Div16_NoAdd1 
0cee 19			    add hl,de 
0cef			Div16_NoAdd1: 
0cef 10 f6		    djnz Div16_Loop1 
0cf1 17			    rla 
0cf2 2f			    cpl 
0cf3 47			    ld b,a 
0cf4 79			    ld a,c 
0cf5 48			    ld c,b 
0cf6 06 08		    ld b,8 
0cf8			Div16_Loop2: 
0cf8 17			    rla 
0cf9 ed 6a		    adc hl,hl 
0cfb ed 52		    sbc hl,de 
0cfd 30 01		    jr nc,Div16_NoAdd2 
0cff 19			    add hl,de 
0d00			Div16_NoAdd2: 
0d00 10 f6		    djnz Div16_Loop2 
0d02 17			    rla 
0d03 2f			    cpl 
0d04 41			    ld b,c 
0d05 4f			    ld c,a 
0d06 c9			ret 
0d07			 
0d07			 
0d07			;http://z80-heaven.wikidot.com/math 
0d07			; 
0d07			;Inputs: 
0d07			;     DE and A are factors 
0d07			;Outputs: 
0d07			;     A is not changed 
0d07			;     B is 0 
0d07			;     C is not changed 
0d07			;     DE is not changed 
0d07			;     HL is the product 
0d07			;Time: 
0d07			;     342+6x 
0d07			; 
0d07			Mult16: 
0d07			 
0d07 06 08		     ld b,8          ;7           7 
0d09 21 00 00		     ld hl,0         ;10         10 
0d0c 29			       add hl,hl     ;11*8       88 
0d0d 07			       rlca          ;4*8        32 
0d0e 30 01		       jr nc,$+3     ;(12|18)*8  96+6x 
0d10 19			         add hl,de   ;--         -- 
0d11 10 f9		       djnz $-5      ;13*7+8     99 
0d13 c9			ret 
0d14			 
0d14			; 
0d14			; Square root of 16-bit value 
0d14			; In:  HL = value 
0d14			; Out:  D = result (rounded down) 
0d14			; 
0d14			;Sqr16: 
0d14			;    ld de,#0040 
0d14			;    ld a,l 
0d14			;    ld l,h 
0d14			;    ld h,d 
0d14			;    or a 
0d14			;    ld b,8 
0d14			;Sqr16_Loop: 
0d14			;    sbc hl,de 
0d14			;    jr nc,Sqr16_Skip 
0d14			;    add hl,de 
0d14			;Sqr16_Skip: 
0d14			;    ccf 
0d14			;    rl d 
0d14			;    add a,a 
0d14			;    adc hl,hl 
0d14			;    add a,a 
0d14			;    adc hl,hl 
0d14			;    djnz Sqr16_Loop 
0d14			;    ret 
0d14			; 
0d14			; 
0d14			; Divide 8-bit values 
0d14			; In: Divide E by divider C 
0d14			; Out: A = result, B = rest 
0d14			; 
0d14			Div8: 
0d14 af			    xor a 
0d15 06 08		    ld b,8 
0d17			Div8_Loop: 
0d17 cb 13		    rl e 
0d19 17			    rla 
0d1a 91			    sub c 
0d1b 30 01		    jr nc,Div8_NoAdd 
0d1d 81			    add a,c 
0d1e			Div8_NoAdd: 
0d1e 10 f7		    djnz Div8_Loop 
0d20 47			    ld b,a 
0d21 7b			    ld a,e 
0d22 17			    rla 
0d23 2f			    cpl 
0d24 c9			    ret 
