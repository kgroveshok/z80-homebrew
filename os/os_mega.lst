1d7c			include "firmware_595shiftreg.asm"  
1d7c			; common code for handling a 595 shift reg out on whatever output port 
1d7c			 
1d7c			; port in c 
1d7c			; byte in a 
1d7c			 
1d7c			 
1d7c			shift_bit_data: equ 0 
1d7c			shift_bit_clk: equ 1 
1d7c			shift_bit_latch: equ 2 
1d7c			 
1d7c			 
1d7c			; shift out a byte to the sound chip 
1d7c			 
1d7c			; A contains byte to send 
1d7c			 
1d7c			shift_byte: 
1d7c			 
1d7c 06 08			ld b, 8   ; 8 bits to shift 
1d7e			 
1d7e 16 00		.nb1:	ld d, 0    ; our work byte to send to the device with flags 
1d80			 
1d80				; set data bit state 
1d80			 
1d80 cb 7f			bit 7, a 
1d82				; high bit is set 
1d82 28 02			jr z, .nb2 
1d84 cb c2			set shift_bit_data, d 
1d86			 
1d86				; set latches state  
1d86 cb ca		.nb2:	set shift_bit_clk, d 
1d88 cb 92			res shift_bit_latch, d    ; latch is inverted 
1d8a ed 51			out (c), d 
1d8c				 
1d8c				; clock the bit out 
1d8c cb 8a			res shift_bit_clk, d 
1d8e ed 51			out (c), d 
1d90			 
1d90				; shift a left one bit and repeat 
1d90 17				rla 
1d91			 
1d91 10 eb			djnz .nb1 
1d93			 
1d93				; latch 
1d93 cb d2			set shift_bit_latch, d 
1d95 ed 51			out (c), d 
1d97					 
1d97			 
1d97				; set  
1d97 c9				ret 
# End of file firmware_595shiftreg.asm
