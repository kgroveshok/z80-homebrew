1140			; https://tutorials.eeems.ca/ASMin28Days/lesson/day16.html#cmp 
1140			 
1140			; String Length 
1140			;With a length-prefixed string, finding the length is trivial. For a null-terminated string, the process is decidedly more involved. This is where CPIR comes in. 
1140			 
1140			; Get the length of the null-terminated string starting at $8000 hl 
1140			;    LD     HL, $8000 
1140			 
1140			strlenz: 
1140			 
1140 af			    XOR    A               ; Zero is the value we are looking for. 
1141 47			    LD     B, A             ; Since we haven't the slightest clue as to the  
1142 4f			    LD     C, A             ; actual size of the string, put 0 in BC to search 
1143			                           ; 65, 536 bytes (the entire addressable memory space). 
1143 ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
1145			 
1145			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
1145 67			    LD     H, A             ; Zero HL (basically set it to 65, 536) to get the 
1146 6f			    LD     L, A             ; number of bytes 
1147 ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
1149 2b			    DEC    HL              ; Compensate for null. 
114a c9				ret 
114b			 
114b			; Get the length of the A terminated string starting at $8000 hl 
114b			;    LD     HL, $8000 
114b			 
114b			strlent: 
114b			 
114b			                  ; A is the value we are looking for. 
114b 06 00		    LD     B, 0             ; Since we haven't the slightest clue as to the  
114d 0e 00		    LD     C, 0             ; actual size of the string, put 0 in BC to search 
114f			                           ; 65, 536 bytes (the entire addressable memory space). 
114f ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
1151			 
1151			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
1151 26 00		    LD     H, 0             ; Zero HL (basically set it to 65, 536) to get the 
1153 2e 00		    LD     L, 0             ; number of bytes 
1155 ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
1157 2b			    DEC    HL              ; Compensate for null. 
1158 c9				ret 
1159			 
1159			 
1159			;Comparing Strings 
1159			 
1159			;IN    HL     Address of string1. 
1159			;      DE     Address of string2. 
1159			 
1159			; doc given but wrong??? 
1159			;OUT   zero   Set if string1 = string2, reset if string1 != string2. 
1159			;      carry  Set if string1 > string2, reset if string1 <= string2. 
1159			; tested 
1159			;OUT   carry set  if string1 = string2, carry  reset if string1 != string2. 
1159			 
1159			strcmp_old: 
1159 e5			    PUSH   HL 
115a d5			    PUSH   DE 
115b			 
115b 1a			    LD     A, (DE)          ; Compare lengths to determine smaller string 
115c be			    CP     (HL)            ; (want to minimize work). 
115d 38 01		    JR     C, Str1IsBigger 
115f 7e			    LD     A, (HL) 
1160			 
1160			Str1IsBigger: 
1160 4f			    LD     C, A             ; Put length in BC 
1161 06 00		    LD     B, 0 
1163 13			    INC    DE              ; Increment pointers to meat of string. 
1164 23			    INC    HL 
1165			 
1165			CmpLoop: 
1165 1a			    LD     A, (DE)          ; Compare bytes. 
1166 ed a1		    CPI 
1168 20 09		    JR     NZ, NoMatch      ; If (HL) != (DE), abort. 
116a 13			    INC    DE              ; Update pointer. 
116b ea 65 11		    JP     PE, CmpLoop 
116e			 
116e d1			    POP    DE 
116f e1			    POP    HL 
1170 1a			    LD     A, (DE)          ; Check string lengths to see if really equal. 
1171 be			    CP     (HL) 
1172 c9			    RET 
1173			 
1173			NoMatch: 
1173 2b			    DEC    HL 
1174 be			    CP     (HL)            ; Compare again to affect carry. 
1175 d1			    POP    DE 
1176 e1			    POP    HL 
1177 c9			    RET 
