9025				; d = bus data 
9025				 
9025 ed 51			out (c), d 
9027			 
9027 2b				dec hl 
9028 cd c2 8a			call ishlzero 
902b 20 f8			jr nz, tape_osc 
902d				 
902d c9				ret 
902e			 
