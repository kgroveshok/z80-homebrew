67d8			include "forth_startup.asm" 
67d8			; Which startup method to use? 
67d8			; 
67d8			; version 1 - allows for a single stored file to be selected to run at start up (if se storage is enabled) 
67d8			; followed by loading of a list of scripts in eeprom 
67d8			 
67d8			; version 2 - if se storage is enabled then auto load all files which begin with a '*' else use loading 
67d8			; from eeprom 
67d8			 
67d8			; Select with define in main stubs 
67d8			 
67d8			if STARTUP_V1 
67d8				include "forth_startupv1.asm" 
67d8			endif 
67d8			if STARTUP_V2 
67d8				include "forth_startupv2.asm" 
67d8			; Version 2 of the startup  
67d8			;  
67d8			; Auto load any files in bank 1 that start with a '*' 
67d8			; If no se storage then revert to using eprom 
67d8			 
67d8			 
67d8			if STORAGE_SE = 0 
67d8			 
67d8			sprompt1: db "Startup load...",0 
67d8			sprompt2: db "Run? 1=No *=End #=All",0 
67d8			 
67d8			 
67d8			 
67d8			 
67d8			forth_startup: 
67d8				ld hl, startcmds 
67d8				ld a, 0 
67d8				ld (os_last_cmd), a    ; tmp var to skip prompts if doing all 
67d8			 
67d8			.start1:	push hl 
67d8				call clear_display 
67d8				ld de, sprompt1 
67d8			        ld a, display_row_1 
67d8				call str_at_display 
67d8				ld de, sprompt2 
67d8			        ld a, display_row_2 
67d8				call str_at_display 
67d8				pop hl 
67d8				push hl 
67d8				ld e,(hl) 
67d8				inc hl 
67d8				ld d,(hl) 
67d8			        ld a, display_row_3 
67d8				call str_at_display 
67d8				call update_display 
67d8			 
67d8			 
67d8				ld a, (os_last_cmd) 
67d8			;	cp 0 
67d8				or a 
67d8				jr z, .startprompt 
67d8				call delay250ms 
67d8				jr .startdo 
67d8				 
67d8				 
67d8			 
67d8			.startprompt: 
67d8			 
67d8				ld a,display_row_4 + display_cols - 1 
67d8			        ld de, endprg 
67d8				call str_at_display 
67d8				call update_display 
67d8				call delay1s 
67d8				call cin_wait 
67d8						 
67d8				cp '*' 
67d8				jr z, .startupend1 
67d8				cp '#' 
67d8				jr nz, .startno 
67d8				ld a, 1 
67d8				ld (os_last_cmd),a 
67d8				jr .startdo 
67d8			.startno:	cp '1' 
67d8				jr z,.startnxt  
67d8			 
67d8				; exec startup line 
67d8			.startdo:	 
67d8				pop hl 
67d8				push hl 
67d8				 
67d8				ld e,(hl) 
67d8				inc hl 
67d8				ld d,(hl) 
67d8				ex de,hl 
67d8			 
67d8				push hl 
67d8			 
67d8				ld a, 0 
67d8				;ld a, FORTH_END_BUFFER 
67d8				call strlent 
67d8				inc hl   ; include zero term to copy 
67d8				ld b,0 
67d8				ld c,l 
67d8				pop hl 
67d8				ld de, scratch 
67d8				ldir 
67d8			 
67d8			 
67d8				ld hl, scratch 
67d8				call forthparse 
67d8				call forthexec 
67d8				call forthexec_cleanup 
67d8			 
67d8				ld a, display_row_4 
67d8				ld de, endprog 
67d8			 
67d8				call update_display		 
67d8			 
67d8				ld a, (os_last_cmd) 
67d8			;	cp 0 
67d8				or a 
67d8				jr nz, .startnxt 
67d8				call next_page_prompt 
67d8			        call clear_display 
67d8				call update_display		 
67d8			 
