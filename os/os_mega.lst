0ca0			 
0ca0			;-----> Generate a random number 
0ca0			; output a=answer 0<=a<=255 
0ca0			; all registers are preserved except: af 
0ca0			random: 
0ca0 e5			        push    hl 
0ca1 d5			        push    de 
0ca2 2a db fa		        ld      hl,(randData) 
0ca5 ed 5f		        ld      a,r 
0ca7 57			        ld      d,a 
0ca8 5e			        ld      e,(hl) 
0ca9 19			        add     hl,de 
0caa 85			        add     a,l 
0cab ac			        xor     h 
0cac 22 db fa		        ld      (randData),hl 
0caf d1			        pop     de 
0cb0 e1			        pop     hl 
0cb1 c9			        ret 
0cb2			 
0cb2			 
0cb2			; randData here must be a 2 byte seed located in ram. While this is a fast generator, it's generally not considered very good in terms of randomness. 
0cb2			 
0cb2			 
0cb2			 
0cb2			;------LFSR------ 
0cb2			;James Montelongo 
0cb2			;optimized by Spencer Putt 
0cb2			;out: 
0cb2			; a = 8 bit random number 
0cb2			RandLFSR: 
0cb2 21 e1 fa		        ld hl,LFSRSeed+4 
0cb5 5e			        ld e,(hl) 
0cb6 23			        inc hl 
0cb7 56			        ld d,(hl) 
0cb8 23			        inc hl 
0cb9 4e			        ld c,(hl) 
0cba 23			        inc hl 
0cbb 7e			        ld a,(hl) 
0cbc 47			        ld b,a 
0cbd cb 13		        rl e  
0cbf cb 12			rl d 
0cc1 cb 11		        rl c  
0cc3 17				rla 
0cc4 cb 13		        rl e  
0cc6 cb 12			rl d 
0cc8 cb 11		        rl c  
0cca 17				rla 
0ccb cb 13		        rl e  
0ccd cb 12			rl d 
0ccf cb 11		        rl c  
0cd1 17				rla 
0cd2 67			        ld h,a 
0cd3 cb 13		        rl e  
0cd5 cb 12			rl d 
0cd7 cb 11		        rl c  
0cd9 17				rla 
0cda a8			        xor b 
0cdb cb 13		        rl e  
0cdd cb 12			rl d 
0cdf ac			        xor h 
0ce0 a9			        xor c 
0ce1 aa			        xor d 
0ce2 21 e3 fa		        ld hl,LFSRSeed+6 
0ce5 11 e4 fa		        ld de,LFSRSeed+7 
0ce8 01 07 00		        ld bc,7 
0ceb ed b8		        lddr 
0ced 12			        ld (de),a 
0cee c9			        ret 
0cef			 
0cef			;While this may produces better numbers, it is slower, larger and requires a bigger seed than ionrandom. Assuming theres is a good seed to start, it should generate ~2^56 bytes before repeating. However if there is not a good seed(0 for example), then the numbers created will not be adequate. Unlike Ionrandom and its use of the r register, starting with the same seed the same numbers will be generated. With Ionrandom the code running may have an impact on the number generated. This means this method requires more initialization. 
0cef			 
0cef			;You can initialize with TI-OS's seeds, stored at seed1 and seed2, both are ti-floats but will serve the purpose.  
0cef			 
0cef			 
0cef			;This is a very fast, quality pseudo-random number generator. It combines a 16-bit Linear Feedback Shift Register and a 16-bit LCG. 
0cef			 
0cef			prng16: 
0cef			;Inputs: 
0cef			;   (seed1) contains a 16-bit seed value 
0cef			;   (seed2) contains a NON-ZERO 16-bit seed value 
0cef			;Outputs: 
0cef			;   HL is the result 
0cef			;   BC is the result of the LCG, so not that great of quality 
0cef			;   DE is preserved 
0cef			;Destroys: 
0cef			;   AF 
0cef			;cycle: 4,294,901,760 (almost 4.3 billion) 
0cef			;160cc 
0cef			;26 bytes 
0cef 2a d5 fa		    ld hl,(seed1) 
0cf2 44			    ld b,h 
0cf3 4d			    ld c,l 
0cf4 29			    add hl,hl 
0cf5 29			    add hl,hl 
0cf6 2c			    inc l 
0cf7 09			    add hl,bc 
0cf8 22 d5 fa		    ld (seed1),hl 
0cfb 2a d3 fa		    ld hl,(seed2) 
0cfe 29			    add hl,hl 
0cff 9f			    sbc a,a 
0d00 e6 2d		    and %00101101 
0d02 ad			    xor l 
0d03 6f			    ld l,a 
0d04 22 d3 fa		    ld (seed2),hl 
0d07 09			    add hl,bc 
0d08 c9			    ret 
0d09			 
0d09			;On their own, LCGs and LFSRs don't produce great results and are generally very cyclical, but they are very fast to compute. The 16-bit LCG in the above example will bounce around and reach each number from 0 to 65535, but the lower bits are far more predictable than the upper bits. The LFSR mixes up the predictability of a given bit's state, but it hits every number except 0, meaning there is a slightly higher chance of any given bit in the result being a 1 instead of a 0. It turns out that by adding together the outputs of these two generators, we can lose the predictability of a bit's state, while ensuring it has a 50% chance of being 0 or 1. As well, since the periods, 65536 and 65535 are coprime, then the overall period of the generator is 65535*65536, which is over 4 billion.  
0d09			 
0d09			rand32: 
0d09			;Inputs: 
0d09			;   (seed1_0) holds the lower 16 bits of the first seed 
0d09			;   (seed1_1) holds the upper 16 bits of the first seed 
0d09			;   (seed2_0) holds the lower 16 bits of the second seed 
0d09			;   (seed2_1) holds the upper 16 bits of the second seed 
0d09			;   **NOTE: seed2 must be non-zero 
0d09			;Outputs: 
0d09			;   HL is the result 
0d09			;   BC,DE can be used as lower quality values, but are not independent of HL. 
0d09			;Destroys: 
0d09			;   AF 
0d09			;Tested and passes all CAcert tests 
0d09			;Uses a very simple 32-bit LCG and 32-bit LFSR 
0d09			;it has a period of 18,446,744,069,414,584,320 
0d09			;roughly 18.4 quintillion. 
0d09			;LFSR taps: 0,2,6,7  = 11000101 
0d09			;291cc 
0d09			;seed1_0=$+1 
0d09			;    ld hl,12345 
0d09			;seed1_1=$+1 
0d09			;    ld de,6789 
0d09			;    ld b,h 
0d09			;    ld c,l 
0d09			;    add hl,hl \ rl e \ rl d 
0d09			;    add hl,hl \ rl e \ rl d 
0d09			;    inc l 
0d09			;    add hl,bc 
0d09			;    ld (seed1_0),hl 
0d09			;    ld hl,(seed1_1) 
0d09			;    adc hl,de 
0d09			;    ld (seed1_1),hl 
0d09			;    ex de,hl 
0d09			;seed2_0=$+1 
0d09			;    ld hl,9876 
0d09			;seed2_1=$+1 
0d09			;    ld bc,54321 
0d09			;    add hl,hl \ rl c \ rl b 
0d09			;    ld (seed2_1),bc 
0d09			;    sbc a,a 
0d09			;    and %11000101 
0d09			;    xor l 
0d09			;    ld l,a 
0d09			;    ld (seed2_0),hl 
0d09			;    ex de,hl 
0d09			;    add hl,bc 
0d09			;    ret 
0d09			; 
0d09			 
0d09			; 16-bit xorshift pseudorandom number generator by John Metcalf 
0d09			; 20 bytes, 86 cycles (excluding ret) 
0d09			 
0d09			; returns   hl = pseudorandom number 
0d09			; corrupts   a 
0d09			 
0d09			; generates 16-bit pseudorandom numbers with a period of 65535 
0d09			; using the xorshift method: 
0d09			 
0d09			; hl ^= hl << 7 
0d09			; hl ^= hl >> 9 
0d09			; hl ^= hl << 8 
0d09			 
0d09			; some alternative shift triplets which also perform well are: 
0d09			; 6, 7, 13; 7, 9, 13; 9, 7, 13. 
0d09			 
0d09			;  org 32768 
0d09			 
0d09			xrnd: 
0d09 2a d9 fa		  ld hl,(xrandc)       ; seed must not be 0 
0d0c 3e 00		  ld a,0 
0d0e bd			  cp l 
0d0f 20 02		  jr nz, .xrnd1 
0d11 2e 01		  ld l, 1 
0d13			.xrnd1: 
0d13			 
0d13 7c			  ld a,h 
0d14 1f			  rra 
0d15 7d			  ld a,l 
0d16 1f			  rra 
0d17 ac			  xor h 
0d18 67			  ld h,a 
0d19 7d			  ld a,l 
0d1a 1f			  rra 
0d1b 7c			  ld a,h 
0d1c 1f			  rra 
0d1d ad			  xor l 
0d1e 6f			  ld l,a 
0d1f ac			  xor h 
0d20 67			  ld h,a 
0d21			 
0d21 22 d9 fa		  ld (xrandc),hl 
0d24			 
0d24 c9			  ret 
