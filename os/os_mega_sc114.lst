d56d			 
d56d			; jump to nmi vector 
d56d			 
d56d			init_nmi: 
d56d			 
d56d 3e c9			ld a, $c9   ; RET 
d56f 32 6e ee			ld (nmi_vector), a 
d572			if BASE_KEV 
d572				ld a, $c3   ; jp 
d572				ld (nmi_vector), a 
d572				ld hl, led_on 
d572				ld (nmi_vector+1), hl 
d572			endif 
d572 c9				ret 
d573			 
d573			; Clear the hardware flag for nmi use 
d573			 
d573			clear_nmi: 
d573 f5				push af 
d574 3a 72 ee		        ld a, (hardware_word+1) 
d577 cb bf			res 7,a 
d579 32 72 ee		        ld (hardware_word+1),a 
d57c f1				pop af 
d57d c9				ret 
d57e			 
d57e			nmi: 
d57e e5				push hl 
d57f d5				push de 
d580 c5				push bc 
d581 f5				push af 
d582			 
d582				; check to see if already nmi has been set 
d582			 
d582 3a 72 ee		        ld a, (hardware_word+1) 
d585			 
d585 cb 7f			bit 7, a 
d587 20 08			jr nz, .rest     ; yes so skip any vector calls	 
d589				 
d589			 
d589				; set the hardware flag for nmi use 
d589 cb ff			set 7,a 
d58b 32 72 ee		        ld (hardware_word+1),a 
d58e			 
d58e				; call user function 
d58e cd 6e ee			call nmi_vector 
d591			 
d591 f5			.rest:	push af 
d592 c5				push bc 
d593 d5				push de 
d594 e5				push hl 
d595 ed 45			retn 
d597			 
d597			 
d597			; eof 
