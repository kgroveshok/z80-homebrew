0b27			;James Montelongo 
0b27			;optimized by Spencer Putt 
0b27			;out: 
0b27			; a = 8 bit random number 
0b27			RandLFSR: 
0b27 21 a6 eb		        ld hl,LFSRSeed+4 
0b2a 5e			        ld e,(hl) 
0b2b 23			        inc hl 
0b2c 56			        ld d,(hl) 
0b2d 23			        inc hl 
0b2e 4e			        ld c,(hl) 
0b2f 23			        inc hl 
0b30 7e			        ld a,(hl) 
0b31 47			        ld b,a 
0b32 cb 13		        rl e  
0b34 cb 12			rl d 
0b36 cb 11		        rl c  
0b38 17				rla 
0b39 cb 13		        rl e  
0b3b cb 12			rl d 
0b3d cb 11		        rl c  
0b3f 17				rla 
0b40 cb 13		        rl e  
0b42 cb 12			rl d 
0b44 cb 11		        rl c  
0b46 17				rla 
0b47 67			        ld h,a 
0b48 cb 13		        rl e  
0b4a cb 12			rl d 
0b4c cb 11		        rl c  
0b4e 17				rla 
0b4f a8			        xor b 
0b50 cb 13		        rl e  
0b52 cb 12			rl d 
0b54 ac			        xor h 
0b55 a9			        xor c 
0b56 aa			        xor d 
0b57 21 a8 eb		        ld hl,LFSRSeed+6 
0b5a 11 a9 eb		        ld de,LFSRSeed+7 
0b5d 01 07 00		        ld bc,7 
0b60 ed b8		        lddr 
0b62 12			        ld (de),a 
0b63 c9			        ret 
0b64			 
0b64			;While this may produces better numbers, it is slower, larger and requires a bigger seed than ionrandom. Assuming theres is a good seed to start, it should generate ~2^56 bytes before repeating. However if there is not a good seed(0 for example), then the numbers created will not be adequate. Unlike Ionrandom and its use of the r register, starting with the same seed the same numbers will be generated. With Ionrandom the code running may have an impact on the number generated. This means this method requires more initialization. 
0b64			 
0b64			;You can initialize with TI-OS's seeds, stored at seed1 and seed2, both are ti-floats but will serve the purpose.  
0b64			 
0b64			 
0b64			;This is a very fast, quality pseudo-random number generator. It combines a 16-bit Linear Feedback Shift Register and a 16-bit LCG. 
0b64			 
0b64			prng16: 
0b64			;Inputs: 
0b64			;   (seed1) contains a 16-bit seed value 
0b64			;   (seed2) contains a NON-ZERO 16-bit seed value 
0b64			;Outputs: 
0b64			;   HL is the result 
0b64			;   BC is the result of the LCG, so not that great of quality 
0b64			;   DE is preserved 
0b64			;Destroys: 
0b64			;   AF 
0b64			;cycle: 4,294,901,760 (almost 4.3 billion) 
0b64			;160cc 
0b64			;26 bytes 
0b64 2a 9a eb		    ld hl,(seed1) 
0b67 44			    ld b,h 
0b68 4d			    ld c,l 
0b69 29			    add hl,hl 
0b6a 29			    add hl,hl 
0b6b 2c			    inc l 
0b6c 09			    add hl,bc 
0b6d 22 9a eb		    ld (seed1),hl 
0b70 2a 98 eb		    ld hl,(seed2) 
0b73 29			    add hl,hl 
0b74 9f			    sbc a,a 
0b75 e6 2d		    and %00101101 
0b77 ad			    xor l 
0b78 6f			    ld l,a 
0b79 22 98 eb		    ld (seed2),hl 
0b7c 09			    add hl,bc 
0b7d c9			    ret 
0b7e			 
0b7e			;On their own, LCGs and LFSRs don't produce great results and are generally very cyclical, but they are very fast to compute. The 16-bit LCG in the above example will bounce around and reach each number from 0 to 65535, but the lower bits are far more predictable than the upper bits. The LFSR mixes up the predictability of a given bit's state, but it hits every number except 0, meaning there is a slightly higher chance of any given bit in the result being a 1 instead of a 0. It turns out that by adding together the outputs of these two generators, we can lose the predictability of a bit's state, while ensuring it has a 50% chance of being 0 or 1. As well, since the periods, 65536 and 65535 are coprime, then the overall period of the generator is 65535*65536, which is over 4 billion.  
0b7e			 
0b7e			rand32: 
0b7e			;Inputs: 
0b7e			;   (seed1_0) holds the lower 16 bits of the first seed 
0b7e			;   (seed1_1) holds the upper 16 bits of the first seed 
0b7e			;   (seed2_0) holds the lower 16 bits of the second seed 
0b7e			;   (seed2_1) holds the upper 16 bits of the second seed 
0b7e			;   **NOTE: seed2 must be non-zero 
0b7e			;Outputs: 
0b7e			;   HL is the result 
0b7e			;   BC,DE can be used as lower quality values, but are not independent of HL. 
0b7e			;Destroys: 
0b7e			;   AF 
0b7e			;Tested and passes all CAcert tests 
0b7e			;Uses a very simple 32-bit LCG and 32-bit LFSR 
0b7e			;it has a period of 18,446,744,069,414,584,320 
0b7e			;roughly 18.4 quintillion. 
0b7e			;LFSR taps: 0,2,6,7  = 11000101 
0b7e			;291cc 
0b7e			;seed1_0=$+1 
0b7e			;    ld hl,12345 
0b7e			;seed1_1=$+1 
0b7e			;    ld de,6789 
0b7e			;    ld b,h 
0b7e			;    ld c,l 
0b7e			;    add hl,hl \ rl e \ rl d 
0b7e			;    add hl,hl \ rl e \ rl d 
0b7e			;    inc l 
0b7e			;    add hl,bc 
0b7e			;    ld (seed1_0),hl 
0b7e			;    ld hl,(seed1_1) 
0b7e			;    adc hl,de 
0b7e			;    ld (seed1_1),hl 
0b7e			;    ex de,hl 
0b7e			;seed2_0=$+1 
0b7e			;    ld hl,9876 
0b7e			;seed2_1=$+1 
0b7e			;    ld bc,54321 
0b7e			;    add hl,hl \ rl c \ rl b 
0b7e			;    ld (seed2_1),bc 
0b7e			;    sbc a,a 
0b7e			;    and %11000101 
0b7e			;    xor l 
0b7e			;    ld l,a 
0b7e			;    ld (seed2_0),hl 
0b7e			;    ex de,hl 
0b7e			;    add hl,bc 
0b7e			;    ret 
0b7e			; 
0b7e			 
0b7e			; 16-bit xorshift pseudorandom number generator by John Metcalf 
0b7e			; 20 bytes, 86 cycles (excluding ret) 
0b7e			 
0b7e			; returns   hl = pseudorandom number 
0b7e			; corrupts   a 
0b7e			 
0b7e			; generates 16-bit pseudorandom numbers with a period of 65535 
0b7e			; using the xorshift method: 
0b7e			 
0b7e			; hl ^= hl << 7 
0b7e			; hl ^= hl >> 9 
0b7e			; hl ^= hl << 8 
0b7e			 
0b7e			; some alternative shift triplets which also perform well are: 
0b7e			; 6, 7, 13; 7, 9, 13; 9, 7, 13. 
0b7e			 
0b7e			;  org 32768 
0b7e			 
0b7e			xrnd: 
0b7e 2a 9e eb		  ld hl,(xrandc)       ; seed must not be 0 
0b81 3e 00		  ld a,0 
0b83 bd			  cp l 
0b84 20 02		  jr nz, .xrnd1 
0b86 2e 01		  ld l, 1 
0b88			.xrnd1: 
0b88			 
0b88 7c			  ld a,h 
0b89 1f			  rra 
0b8a 7d			  ld a,l 
0b8b 1f			  rra 
0b8c ac			  xor h 
0b8d 67			  ld h,a 
0b8e 7d			  ld a,l 
0b8f 1f			  rra 
0b90 7c			  ld a,h 
0b91 1f			  rra 
0b92 ad			  xor l 
0b93 6f			  ld l,a 
0b94 ac			  xor h 
0b95 67			  ld h,a 
0b96			 
0b96 22 9e eb		  ld (xrandc),hl 
0b99			 
0b99 c9			  ret 
