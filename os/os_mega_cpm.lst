11c2			; https://gist.githubusercontent.com/tomstorey/947a8b084bad69391a4b2a1c5b6d69ca/raw/5a08fb30a480d98c0deb4a6afe2d48961cc8e9d9/z80_malloc.s 
11c2			;heap_start        .equ  0x9000      ; Starting address of heap 
11c2			;heap_size         .equ  0x0100      ; Number of bytes available in heap 
11c2			; 
11c2			 ;     .org 0 
11c2			  ;    jp    main 
11c2			; 
11c2			; 
11c2			 ;     .org  0x100 
11c2			;main: 
11c2			 ;     ld    HL, 0x8100 
11c2			  ;    ld    SP, HL 
11c2			; 
11c2			;      call  heap_init 
11c2			 
11c2			      ; Make some allocations 
11c2			;      ld    HL, 12 
11c2			;      call  malloc            ; Allocates 0x9004 
11c2			; 
11c2			 ;     ld    HL, 12 
11c2			;      call  malloc            ; Allocates 0x9014 
11c2			 
11c2			;      ld    HL, 12 
11c2			;      call  malloc            ; Allocates 0x9024 
11c2			 
11c2			      ; Free some allocations 
11c2			;      ld    HL, 0x9014 
11c2			;      call  free 
11c2			 
11c2			;      ld    HL, 0x9004 
11c2			;      call  free 
11c2			; 
11c2			;      ld    HL, 0x9024 
11c2			;      call  free 
11c2			 
11c2			 
11c2			 ;     halt 
11c2			 
11c2			 
11c2			;------------------------------------------------------------------------------ 
11c2			;     heap_init                                                               : 
11c2			;                                                                             : 
11c2			; Description                                                                 : 
11c2			;     Initialise the heap and make it ready for malloc and free operations.   : 
11c2			;                                                                             : 
11c2			;     The heap is maintained as a linked list, starting with an initial       : 
11c2			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
11c2			;     the first free block in the heap. Each block then points to the next    : 
11c2			;     free block within the heap, and the free list ends at the first block   : 
11c2			;     with a null pointer to the next free block.                             : 
11c2			;                                                                             : 
11c2			; Parameters                                                                  : 
11c2			;     Inputs are compile-time only. Two defines which specify the starting    : 
11c2			;     address of the heap and its size are required, along with a memory      : 
11c2			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
11c2			;     principally stores a pointer to the first free block in the heap.       : 
11c2			;                                                                             : 
11c2			; Returns                                                                     : 
11c2			;     Nothing                                                                 : 
11c2			;------------------------------------------------------------------------------ 
11c2			heap_init: 
11c2			      push  HL 
11c2			 
11c2			      ; Initialise free list struct 
11c2			      ld    HL, heap_start 
11c2			      ld    (free_list), HL 
11c2			      ld    HL, 0 
11c2			      ld    (free_list+2), HL 
11c2			 
11c2			      ; Insert first free block at bottom of heap, consumes entire heap 
11c2			      ld    HL, heap_start+heap_size-4 
11c2			      ld    (heap_start), HL        ; Next block (end of free list) 
11c2			      ld    HL, heap_size-4 
11c2			      ld    (heap_start+2), HL      ; Block size 
11c2			 
11c2			      ; Insert end of free list block at top of heap - two null words will 
11c2			      ; terminate the free list 
11c2			      ld    HL, 0 
11c2			      ld    (heap_start+heap_size-2), HL 
11c2			      ld    (heap_start+heap_size-4), HL 
11c2			 
11c2			      pop   HL 
11c2			 
11c2			      ret 
11c2			 
11c2			 
11c2			;------------------------------------------------------------------------------ 
11c2			;     malloc                                                                  : 
11c2			;                                                                             : 
11c2			; Description                                                                 : 
11c2			;     Allocates the wanted space from the heap and returns the address of the : 
11c2			;     first useable byte of the allocation.                                   : 
11c2			;                                                                             : 
11c2			;     Allocations can happen in one of two ways:                              : 
11c2			;                                                                             : 
11c2			;     1. A free block may be found which is the exact size wanted. In this    : 
11c2			;        case the block is removed from the free list and retuedn to the      : 
11c2			;        caller.                                                              : 
11c2			;     2. A free block may be found which is larger than the size wanted. In   : 
11c2			;        this case, the larger block is split into two. The first portion of  : 
11c2			;        this block will become the requested space by the malloc call and    : 
11c2			;        is returned to the caller. The second portion becomes a new free     : 
11c2			;        block, and the free list is adjusted to maintain continuity via this : 
11c2			;        newly created block.                                                 : 
11c2			;                                                                             : 
11c2			;     malloc does not set any initial value in the allocated space, the       : 
11c2			;     caller is required to do this as required.                              : 
11c2			;                                                                             : 
11c2			;     This implementation of malloc uses the stack exclusively, and is        : 
11c2			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
11c2			;     advisable to disable interrupts before calling malloc, and recommended  : 
11c2			;     to avoid the use of malloc inside ISRs in general.                      : 
11c2			;                                                                             : 
11c2			;     NOTE: heap_init must be called before malloc and free can be used.      : 
11c2			;                                                                             : 
11c2			; Parameters                                                                  : 
11c2			;     HL  Number of bytes wanted                                              : 
11c2			;                                                                             : 
11c2			; Returns                                                                     : 
11c2			;     HL  Address of the first useable byte of the allocation                 : 
11c2			;                                                                             : 
11c2			; Flags                                                                       : 
11c2			;     Z   Set if the allocation did not succeed, clear otherwise              : 
11c2			;                                                                             : 
11c2			; Stack frame                                                                 : 
11c2			;       |             |                                                       : 
11c2			;       +-------------+                                                       : 
11c2			;       |     BC      |                                                       : 
11c2			;       +-------------+                                                       : 
11c2			;       |     DE      |                                                       : 
11c2			;       +-------------+                                                       : 
11c2			;       |     IX      |                                                       : 
11c2			;       +-------------+                                                       : 
11c2			;       |  prev_free  |                                                       : 
11c2			;   +4  +-------------+                                                       : 
11c2			;       |  this_free  |                                                       : 
11c2			;   +2  +-------------+                                                       : 
11c2			;       |  next_free  |                                                       : 
11c2			;   +0  +-------------+                                                       : 
11c2			;       |             |                                                       : 
11c2			;                                                                             : 
11c2			;------------------------------------------------------------------------------ 
11c2			malloc: 
11c2			      push  BC 
11c2			      push  DE 
11c2			      push  IX 
11c2			 
11c2			      ld    A, H                    ; Exit if no space requested 
11c2			      or    L 
11c2			      jp    Z, malloc_early_exit 
11c2			 
11c2			      ; Set up stack frame 
11c2			      ex    DE, HL 
11c2			      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
11c2			      add   HL, SP 
11c2			      ld    SP, HL 
11c2			      ld    IX, 0                   ; Use IX as a frame pointer 
11c2			      add   IX, SP 
11c2			 
11c2			      ; Setup initial state 
11c2			      ld    HL, 4                   ; want must also include space used by block struct 
11c2			      add   HL, DE 
11c2			 
11c2			      ld    B, H                    ; Move want to BC 
11c2			      ld    C, L 
11c2			 
11c2			      ld    HL, free_list           ; Store prev_free ptr to stack 
11c2			      ld    (IX+4), L 
11c2			      ld    (IX+5), H 
11c2			 
11c2			      ld    E, (HL)                 ; Store this_free ptr to stack 
11c2			      inc   HL 
11c2			      ld    D, (HL) 
11c2			      ld    (IX+2), E 
11c2			      ld    (IX+3), D 
11c2			      ex    DE, HL                  ; this_free ptr into HL 
11c2			 
11c2			      ; Loop through free block list to find some space 
11c2			malloc_find_space: 
11c2			      ld    E, (HL)                 ; Load next_free ptr into DE 
11c2			      inc   HL 
11c2			      ld    D, (HL) 
11c2			 
11c2			      ld    A, D                    ; Check for null next_free ptr - end of free list 
11c2			      or    E 
11c2			      jp    Z, malloc_no_space 
11c2			 
11c2			      ld    (IX+0), E               ; Store next_free ptr to stack 
11c2			      ld    (IX+1), D 
11c2			 
11c2			      ; Does this block have enough space to make the allocation? 
11c2			      inc   HL                      ; Load free block size into DE 
11c2			      ld    E, (HL) 
11c2			      inc   HL 
11c2			      ld    D, (HL) 
11c2			 
11c2			      ex    DE, HL                  ; Check size of block against want 
11c2			      or    A                       ; Ensure carry flag clear 
11c2			      sbc   HL, BC 
11c2			      push  HL                      ; Store the result for later (new block size) 
11c2			 
11c2			      jr    Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
11c2			      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
11c2			 
11c2			      ; this_free block is not big enough, setup ptrs to test next free block 
11c2			      pop   HL                      ; Discard previous result 
11c2			 
11c2			      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
11c2			      ld    H, (IX+3) 
11c2			      ld    (IX+4), L 
11c2			      ld    (IX+5), H 
11c2			 
11c2			      ld    L, (IX+0)               ; Move next_free ptr into this_free 
11c2			      ld    H, (IX+1) 
11c2			      ld    (IX+2), L 
11c2			      ld    (IX+3), H 
11c2			 
11c2			      jr    malloc_find_space 
11c2			 
11c2			      ; split a bigger block into two - requested size and remaining size 
11c2			malloc_alloc_split: 
11c2			      ex    DE, HL                  ; Calculate address of new free block 
11c2			      dec   HL 
11c2			      dec   HL 
11c2			      dec   HL 
11c2			      add   HL, BC 
11c2			 
11c2			      ; Create a new block and point it at next_free 
11c2			      ld    E, (IX+0)               ; Load next_free ptr into DE 
11c2			      ld    D, (IX+1) 
11c2			 
11c2			      ld    (HL), E                 ; Store next_free ptr into new block 
11c2			      inc   HL 
11c2			      ld    (HL), D 
11c2			 
11c2			      pop   DE                      ; Store size of new block into new block 
11c2			      inc   HL 
11c2			      ld    (HL), E 
11c2			      inc   HL 
11c2			      ld    (HL), D 
11c2			 
11c2			      ; Update this_free ptr to point to new block 
11c2			      dec   HL 
11c2			      dec   HL 
11c2			      dec   HL 
11c2			 
11c2			      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
11c2			      ld    D, (IX+3) 
11c2			 
11c2			      ld    (IX+2), L               ; Store new block addr as this_free ptr 
11c2			      ld    (IX+3), H 
11c2			 
11c2			      ; Modify this_free block to be allocation 
11c2			      ex    DE, HL 
11c2			      xor   A                       ; Null the next block ptr of allocated block 
11c2			      ld    (HL), A 
11c2			      inc   HL 
11c2			      ld    (HL), A 
11c2			 
11c2			      inc   HL                      ; Store want size into allocated block 
11c2			      ld    (HL), C 
11c2			      inc   HL 
11c2			      ld    (HL), B 
11c2			      inc   HL 
11c2			      push  HL                      ; Address of allocation to return 
11c2			 
11c2			      jr    malloc_update_links 
11c2			 
11c2			malloc_alloc_fit: 
11c2			      pop   HL                      ; Dont need new block size, want is exact fit 
11c2			 
11c2			      ; Modify this_free block to be allocation 
11c2			      ex    DE, HL 
11c2			      dec   HL 
11c2			      dec   HL 
11c2			      dec   HL 
11c2			 
11c2			      xor   A                       ; Null the next block ptr of allocated block 
11c2			      ld    (HL), A 
11c2			      inc   HL 
11c2			      ld    (HL), A 
11c2			 
11c2			      inc   HL                      ; Store address of allocation to return 
11c2			      inc   HL 
11c2			      inc   HL 
11c2			      push  HL 
11c2			 
11c2			      ; Copy next_free ptr to this_free, remove allocated block from free list 
11c2			      ld    L, (IX+0)               ; next_free to HL 
11c2			      ld    H, (IX+1) 
11c2			 
11c2			      ld    (IX+2), L               ; HL to this_free 
11c2			      ld    (IX+3), H 
11c2			 
11c2			 
11c2			malloc_update_links: 
11c2			      ; Update prev_free ptr to point to this_free 
11c2			      ld    L, (IX+4)               ; prev_free ptr to HL 
11c2			      ld    H, (IX+5) 
11c2			 
11c2			      ld    E, (IX+2)               ; this_free ptr to DE 
11c2			      ld    D, (IX+3) 
11c2			 
11c2			      ld    (HL), E                 ; this_free ptr into prev_free 
11c2			      inc   HL 
11c2			      ld    (HL), D 
11c2			 
11c2			      ; Clear the Z flag to indicate successful allocation 
11c2			      ld    A, D 
11c2			      or    E 
11c2			 
11c2			      pop   DE                      ; Address of allocation 
11c2			 
11c2			malloc_no_space: 
11c2			      ld    HL, 6                   ; Clean up stack frame 
11c2			      add   HL, SP 
11c2			      ld    SP, HL 
11c2			 
11c2			      ex    DE, HL                  ; Alloc addr into HL for return 
11c2			 
11c2			malloc_early_exit: 
11c2			      pop   IX 
11c2			      pop   DE 
11c2			      pop   BC 
11c2			 
11c2			      ret 
11c2			 
11c2			 
11c2			;------------------------------------------------------------------------------ 
11c2			;     free                                                                    : 
11c2			;                                                                             : 
11c2			; Description                                                                 : 
11c2			;     Return the space pointed to by HL to the heap. HL must be an address as : 
11c2			;     returned by malloc, otherwise the behaviour is undefined.               : 
11c2			;                                                                             : 
11c2			;     Where possible, directly adjacent free blocks will be merged together   : 
11c2			;     into larger blocks to help ensure that the heap does not become         : 
11c2			;     excessively fragmented.                                                 : 
11c2			;                                                                             : 
11c2			;     free does not clear or set any other value into the freed space, and    : 
11c2			;     therefore its contents may be visible through subsequent malloc's. The  : 
11c2			;     caller should clear the freed space as required.                        : 
11c2			;                                                                             : 
11c2			;     This implementation of free uses the stack exclusively, and is          : 
11c2			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
11c2			;     advisable to disable interrupts before calling free, and recommended    : 
11c2			;     to avoid the use of free inside ISRs in general.                        : 
11c2			;                                                                             : 
11c2			;     NOTE: heap_init must be called before malloc and free can be used.      : 
11c2			;                                                                             : 
11c2			; Parameters                                                                  : 
11c2			;     HL  Pointer to address of first byte of allocation to be freed          : 
11c2			;                                                                             : 
11c2			; Returns                                                                     : 
11c2			;     Nothing                                                                 : 
11c2			;                                                                             : 
11c2			; Stack frame                                                                 : 
11c2			;       |             |                                                       : 
11c2			;       +-------------+                                                       : 
11c2			;       |     BC      |                                                       : 
11c2			;       +-------------+                                                       : 
11c2			;       |     DE      |                                                       : 
11c2			;       +-------------+                                                       : 
11c2			;       |     IX      |                                                       : 
11c2			;       +-------------+                                                       : 
11c2			;       |  prev_free  |                                                       : 
11c2			;   +2  +-------------+                                                       : 
11c2			;       |  next_free  |                                                       : 
11c2			;   +0  +-------------+                                                       : 
11c2			;       |             |                                                       : 
11c2			;                                                                             : 
11c2			;------------------------------------------------------------------------------ 
11c2			free: 
11c2			      push  BC 
11c2			      push  DE 
11c2			      push  IX 
11c2			 
11c2			      ld    A, H                    ; Exit if ptr is null 
11c2			      or    L 
11c2			      jp    Z, free_early_exit 
11c2			 
11c2			      ; Set up stack frame 
11c2			      ex    DE, HL 
11c2			      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
11c2			      add   HL, SP 
11c2			      ld    SP, HL 
11c2			      ld    IX, 0                   ; Use IX as a frame pointer 
11c2			      add   IX, SP 
11c2			 
11c2			      ; The address in HL points to the start of the useable allocated space, 
11c2			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
11c2			      ; address of the block itself. 
11c2			      ex    DE, HL 
11c2			      ld    DE, -4 
11c2			      add   HL, DE 
11c2			 
11c2			      ; An allocated block must have a null next block pointer in it 
11c2			      ld    A, (HL) 
11c2			      inc   HL 
11c2			      or    (HL) 
11c2			      jp    NZ, free_done 
11c2			 
11c2			      dec   HL 
11c2			 
11c2			      ld    B, H                    ; Copy HL to BC 
11c2			      ld    C, L 
11c2			 
11c2			      ; Loop through the free list to find the first block with an address 
11c2			      ; higher than the block being freed 
11c2			      ld    HL, free_list 
11c2			 
11c2			free_find_higher_block: 
11c2			      ld    E, (HL)                 ; Load next ptr from free block 
11c2			      inc   HL 
11c2			      ld    D, (HL) 
11c2			      dec   HL 
11c2			 
11c2			      ld    (IX+0), E               ; Save ptr to next free block 
11c2			      ld    (IX+1), D 
11c2			      ld    (IX+2), L               ; Save ptr to prev free block 
11c2			      ld    (IX+3), H 
11c2			 
11c2			      ld    A, B                    ; Check if DE is greater than BC 
11c2			      cp    D                       ; Compare MSB first 
11c2			      jr    Z, $+4                  ; MSB the same, compare LSB 
11c2			      jr    NC, free_find_higher_block_skip 
11c2			      ld    A, C 
11c2			      cp    E                       ; Then compare LSB 
11c2			      jr    C, free_found_higher_block 
11c2			 
11c2			free_find_higher_block_skip: 
11c2			      ld    A, D                    ; Reached the end of the free list? 
11c2			      or    E 
11c2			      jp    Z, free_done 
11c2			 
11c2			      ex    DE, HL 
11c2			 
11c2			      jr    free_find_higher_block 
11c2			 
11c2			free_found_higher_block: 
11c2			      ; Insert freed block between prev and next free blocks 
11c2			      ld    (HL), C                 ; Point prev free block to freed block 
11c2			      inc   HL 
11c2			      ld    (HL), B 
11c2			 
11c2			      ld    H, B                    ; Point freed block at next free block 
11c2			      ld    L, C 
11c2			      ld    (HL), E 
11c2			      inc   HL 
11c2			      ld    (HL), D 
11c2			 
11c2			      ; Check if the freed block is adjacent to the next free block 
11c2			      inc   HL                      ; Load size of freed block into HL 
11c2			      ld    E, (HL) 
11c2			      inc   HL 
11c2			      ld    D, (HL) 
11c2			      ex    DE, HL 
11c2			 
11c2			      add   HL, BC                  ; Add addr of freed block and its size 
11c2			 
11c2			      ld    E, (IX+0)               ; Load addr of next free block into DE 
11c2			      ld    D, (IX+1) 
11c2			 
11c2			      or    A                       ; Clear the carry flag 
11c2			      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
11c2			      jr    NZ, free_check_adjacent_to_prev 
11c2			 
11c2			      ; Freed block is adjacent to next, merge into one bigger block 
11c2			      ex    DE, HL                  ; Load next ptr from next block into DE 
11c2			      ld    E, (HL) 
11c2			      inc   HL 
11c2			      ld    D, (HL) 
11c2			      push  HL                      ; Save ptr to next block for later 
11c2			 
11c2			      ld    H, B                    ; Store ptr from next block into freed block 
11c2			      ld    L, C 
11c2			      ld    (HL), E 
11c2			      inc   HL 
11c2			      ld    (HL), D 
11c2			 
11c2			      pop   HL                      ; Restore ptr to next block 
11c2			      inc   HL                      ; Load size of next block into DE 
11c2			      ld    E, (HL) 
11c2			      inc   HL 
11c2			      ld    D, (HL) 
11c2			      push  DE                      ; Save next block size for later 
11c2			 
11c2			      ld    H, B                    ; Load size of freed block into HL 
11c2			      ld    L, C 
11c2			      inc   HL 
11c2			      inc   HL 
11c2			      ld    E, (HL) 
11c2			      inc   HL 
11c2			      ld    D, (HL) 
11c2			      ex    DE, HL 
11c2			 
11c2			      pop   DE                      ; Restore size of next block 
11c2			      add   HL, DE                  ; Add sizes of both blocks 
11c2			      ex    DE, HL 
11c2			 
11c2			      ld    H, B                    ; Store new bigger size into freed block 
11c2			      ld    L, C 
11c2			      inc   HL 
11c2			      inc   HL 
11c2			      ld    (HL), E 
11c2			      inc   HL 
11c2			      ld    (HL), D 
11c2			 
11c2			free_check_adjacent_to_prev: 
11c2			      ; Check if the freed block is adjacent to the prev free block 
11c2			      ld    L, (IX+2)               ; Prev free block ptr into HL 
11c2			      ld    H, (IX+3) 
11c2			 
11c2			      inc   HL                      ; Size of prev free block into DE 
11c2			      inc   HL 
11c2			      ld    E, (HL) 
11c2			      inc   HL 
11c2			      ld    D, (HL) 
11c2			      dec   HL 
11c2			      dec   HL 
11c2			      dec   HL 
11c2			 
11c2			      add   HL, DE                  ; Add prev block addr and size 
11c2			 
11c2			      or    A                       ; Clear the carry flag 
11c2			      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
11c2			      jr    NZ, free_done 
11c2			 
11c2			      ; Freed block is adjacent to prev, merge into one bigger block 
11c2			      ld    H, B                    ; Load next ptr from freed block into DE 
11c2			      ld    L, C 
11c2			      ld    E, (HL) 
11c2			      inc   HL 
11c2			      ld    D, (HL) 
11c2			      push  HL                      ; Save freed block ptr for later 
11c2			 
11c2			      ld    L, (IX+2)               ; Store freed block ptr into prev block 
11c2			      ld    H, (IX+3) 
11c2			      ld    (HL), E 
11c2			      inc   HL 
11c2			      ld    (HL), D 
11c2			 
11c2			      pop   HL                      ; Restore freed block ptr 
11c2			      inc   HL                      ; Load size of freed block into DE 
11c2			      ld    E, (HL) 
11c2			      inc   HL 
11c2			      ld    D, (HL) 
11c2			      push  DE                      ; Save freed block size for later 
11c2			 
11c2			      ld    L, (IX+2)               ; Load size of prev block into DE 
11c2			      ld    H, (IX+3) 
11c2			      inc   HL 
11c2			      inc   HL 
11c2			      ld    E, (HL) 
11c2			      inc   HL 
11c2			      ld    D, (HL) 
11c2			 
11c2			      pop   HL                      ; Add sizes of both blocks 
11c2			      add   HL, DE 
11c2			      ex    DE, HL 
11c2			 
11c2			      ld    L, (IX+2)               ; Store new bigger size into prev block 
11c2			      ld    H, (IX+3) 
11c2			      inc   HL 
11c2			      inc   HL 
11c2			      ld    (HL), E 
11c2			      inc   HL 
11c2			      ld    (HL), D 
11c2			 
11c2			free_done: 
11c2			      ld    HL, 4                   ; Clean up stack frame 
11c2			      add   HL, SP 
11c2			      ld    SP, HL 
11c2			 
11c2			free_early_exit: 
11c2			      pop   IX 
11c2			      pop   DE 
11c2			      pop   BC 
11c2			 
11c2			      ret 
11c2			 
11c2			 
11c2			;      .org 0x8000 
11c2			; 
11c2			;free_list         .dw   0     ; Block struct for start of free list (MUST be 4 bytes) 
11c2			 ;                 .dw   0 
11c2			 
11c2			endif 
11c2			 
11c2			 
11c2			if MALLOC_4 
11c2			 
11c2			; My memory allocation code. Very very simple.... 
11c2			; allocate space under 250 chars 
11c2			 
11c2			heap_init: 
11c2				; init start of heap as zero 
11c2				;  
11c2			 
11c2				ld hl, heap_start 
11c2			;	ld a, 0 
11c2				ld (hl), 0      ; empty block 
11c2				inc hl 
11c2			;	ld a, 0 
11c2				ld (hl), 0      ; length of block 
11c2				; write end of list 
11c2				inc hl 
11c2				ld a,(hl) 
11c2				inc hl 
11c2				ld a,(hl) 
11c2				 
11c2			 
11c2				; init some malloc vars 
11c2			 
11c2				ld hl, 0 
11c2				ld (free_list), hl       ; store last malloc location 
11c2			 
11c2				ld hl, free_list+3      ; flag for 'free' being used and force a rescan for reuse of block  
11c2			;	ld a, 0 
11c2				ld (hl), 0 
11c2			 
11c2			 
11c2				ld hl, heap_start 
11c2				;  
11c2				  
11c2				ret 
11c2			 
11c2			 
11c2			;    free block marker 
11c2			;    requested size  
11c2			;    pointer to next block 
11c2			;    .... 
11c2			;    next block marker 
11c2			 
11c2			 
11c2			; TODO add a flag that is reset on use of free. if flag is reset then start scan from start of heap otherwise use last location 
11c2			; 
11c2			 
11c2			 
11c2			malloc:  
11c2				push de 
11c2				push bc 
11c2				push af 
11c2			 
11c2				; hl space required 
11c2				 
11c2				ld c, l    ; hold space   (TODO only a max of 255) 
11c2			 
11c2			;	inc c     ; TODO BUG need to fix memory leak on push str 
11c2			;	inc c 
11c2			;	inc c 
11c2			;	inc c 
11c2			;	inc c 
11c2			;	inc c 
11c2			;	inc c 
11c2			 
11c2			 
11c2			 
11c2				; start at heap if a free has been issued so we can reclaim it otherwise continue from last time 
11c2			 
11c2				ld a, (free_list+3) 
11c2			;	cp 0 
11c2				or a 
11c2				jr z, .contheap 
11c2			 
11c2				ld hl, (free_list)     ; get last alloc 
11c2					if DEBUG_FORTH_MALLOC_INT 
11c2						DMARK "mrs" 
11c2						CALLMONITOR 
11c2					endif 
11c2				jr .startalloc 
11c2			 
11c2			.contheap: 
11c2				ld hl, heap_start 
11c2			 
11c2			.startalloc: 
11c2			 
11c2					if DEBUG_FORTH_MALLOC_INT 
11c2						DMARK "mym" 
11c2						CALLMONITOR 
11c2					endif 
11c2			.findblock: 
11c2					if DEBUG_FORTH_MALLOC_INT 
11c2						DMARK "mmf" 
11c2						CALLMONITOR 
11c2					endif 
11c2			 
11c2				ld a,(hl)  
11c2				; if byte is zero then clear to use 
11c2			 
11c2			;	cp 0 
11c2				or a 
11c2				jr z, .foundemptyblock 
11c2			 
11c2				; if byte is not clear 
11c2				;     then byte is offset to next block 
11c2			 
11c2				inc hl 
11c2				ld a, (hl) ; get size 
11c2			.nextblock:	inc hl 
11c2					ld e, (hl) 
11c2					inc hl 
11c2					ld d, (hl) 
11c2					ex de, hl 
11c2			;	inc hl  ; move past the store space 
11c2			;	inc hl  ; move past zero index  
11c2			 
11c2				; TODO detect no more space 
11c2			 
11c2				push hl 
11c2				ld de, heap_end 
11c2				call cmp16 
11c2				pop hl 
11c2				jr nc, .nospace 
11c2			 
11c2				jr .findblock 
11c2			 
11c2			.nospace: ld hl, 0 
11c2				jp .exit 
11c2			 
11c2			 
11c2			.foundemptyblock:	 
11c2					if DEBUG_FORTH_MALLOC_INT 
11c2						DMARK "mme" 
11c2						CALLMONITOR 
11c2					endif 
11c2			 
11c2			; TODO has block enough space if reusing??? 
11c2			 
11c2				;  
11c2			 
11c2			; see if this block has been previously used 
11c2				inc hl 
11c2				ld a, (hl) 
11c2				dec hl 
11c2			;	cp 0 
11c2				or a 
11c2				jr z, .newblock 
11c2			 
11c2					if DEBUG_FORTH_MALLOC_INT 
11c2						DMARK "meR" 
11c2						CALLMONITOR 
11c2					endif 
11c2			 
11c2			; no reusing previously allocated block 
11c2			 
11c2			; is it smaller than previously used? 
11c2				 
11c2				inc hl    ; move to size 
11c2				ld a, c 
11c2				sub (hl)        ; we want c < (hl) 
11c2				dec hl    ; move back to marker 
11c2			        jr z, .findblock 
11c2			 
11c2				; update with the new size which should be lower 
11c2			 
11c2			        ;inc  hl   ; negate next move. move back to size  
11c2			 
11c2			.newblock: 
11c2				; need to be at marker here 
11c2			 
11c2					if DEBUG_FORTH_MALLOC_INT 
11c2						DMARK "meN" 
11c2						CALLMONITOR 
11c2					endif 
11c2			 
11c2			 
11c2				ld a, c 
11c2			 
11c2				ld (free_list+3), a	 ; flag resume from last malloc  
11c2				ld (free_list), hl    ; save out last location 
11c2			 
11c2			 
11c2				;inc a     ; space for length byte 
11c2				ld (hl), a     ; save block in use marker 
11c2			 
11c2				inc hl   ; move to space marker 
11c2				ld (hl), a    ; save new space 
11c2			 
11c2				inc hl   ; move to start of allocated area 
11c2				 
11c2			;	push hl     ; save where we are - 1  
11c2			 
11c2			;	inc hl  ; move past zero index  
11c2				; skip space to set down new marker 
11c2			 
11c2				; provide some extra space for now 
11c2			 
11c2				inc a    ; actual is one fewer than bytes requested. correct if zero index is taken into account 
11c2				inc a 
11c2				inc a 
11c2			 
11c2				push hl   ; save where we are in the node block 
11c2			 
11c2				call addatohl 
11c2			 
11c2				; write linked list point 
11c2			 
11c2				pop de     ; get our node position 
11c2				ex de, hl 
11c2			 
11c2				ld (hl), e 
11c2				inc hl 
11c2				ld (hl), d 
11c2			 
11c2				inc hl 
11c2			 
11c2				; now at start of allocated data so save pointer 
11c2			 
11c2				push hl 
11c2			 
11c2				; jump to position of next node and setup empty header in DE 
11c2			 
11c2				ex de, hl 
11c2			 
11c2			;	inc hl ; move past end of block 
11c2			 
11c2			;	ld a, 0 
11c2				ld (hl), 0   ; empty marker 
11c2				inc hl 
11c2				ld (hl), 0   ; size 
11c2				inc hl  
11c2				ld (hl), 0   ; ptr 
11c2				inc hl 
11c2				ld (hl), 0   ; ptr 
11c2			 
11c2			 
11c2				pop hl 
11c2			 
11c2					if DEBUG_FORTH_MALLOC_INT 
11c2						DMARK "mmr" 
11c2						CALLMONITOR 
11c2					endif 
11c2			 
11c2			.exit: 
11c2				pop af 
11c2				pop bc 
11c2				pop de  
11c2				ret 
11c2			 
11c2			 
11c2			 
11c2			 
11c2			free:  
11c2				push hl 
11c2				push af 
11c2				; get address in hl 
11c2			 
11c2					if DEBUG_FORTH_MALLOC_INT 
11c2						DMARK "fre" 
11c2						CALLMONITOR 
11c2					endif 
11c2				; data is at hl - move to block count 
11c2				dec hl 
11c2				dec hl    ; get past pointer 
11c2				dec hl 
11c2			 
11c2				ld a, (hl)    ; need this for a validation check 
11c2			 
11c2				dec hl    ; move to block marker 
11c2			 
11c2				; now check that the block count and block marker are the same  
11c2			        ; this checks that we are on a malloc node and not random memory 
11c2			        ; OK a faint chance this could be a problem but rare - famous last words! 
11c2			 
11c2				ld c, a 
11c2				ld a, (hl)    
11c2			 
11c2				cp c 
11c2				jr nz, .freeignore      ; not a valid malloc node in use so dont break anything 
11c2			 
11c2				; yes good chance we are on a malloc node 
11c2			 
11c2			;	ld a, 0      
11c2				ld (hl), 0   ; mark as free 
11c2			 
11c2				ld (free_list+3), a	 ; flag reuse of existing block on next malloc 
11c2			 
11c2			.freeignore:  
11c2			 
11c2				pop af 
11c2				pop hl 
11c2			 
11c2				ret 
11c2			 
11c2			 
11c2			 
11c2			endif 
