1d70			include "firmware_595shiftreg.asm"  
1d70			; common code for handling a 595 shift reg out on whatever output port 
1d70			 
1d70			; port in c 
1d70			; byte in a 
1d70			 
1d70			 
1d70			shift_bit_data: equ 0 
1d70			shift_bit_clk: equ 1 
1d70			shift_bit_latch: equ 2 
1d70			 
1d70			 
1d70			; shift out a byte to the sound chip 
1d70			 
1d70			; A contains byte to send 
1d70			 
1d70			shift_byte: 
1d70			 
1d70 06 08			ld b, 8   ; 8 bits to shift 
1d72			 
1d72 16 00		.nb1:	ld d, 0    ; our work byte to send to the device with flags 
1d74			 
1d74				; set data bit state 
1d74			 
1d74 cb 7f			bit 7, a 
1d76				; high bit is set 
1d76 28 02			jr z, .nb2 
1d78 cb c2			set shift_bit_data, d 
1d7a			 
1d7a				; set latches state  
1d7a cb ca		.nb2:	set shift_bit_clk, d 
1d7c cb 92			res shift_bit_latch, d    ; latch is inverted 
1d7e ed 51			out (c), d 
1d80				 
1d80				; clock the bit out 
1d80 cb 8a			res shift_bit_clk, d 
1d82 ed 51			out (c), d 
1d84			 
1d84				; shift a left one bit and repeat 
1d84 17				rla 
1d85			 
1d85 10 eb			djnz .nb1 
1d87			 
1d87				; latch 
1d87 cb d2			set shift_bit_latch, d 
1d89 ed 51			out (c), d 
1d8b					 
1d8b			 
1d8b				; set  
1d8b c9				ret 
# End of file firmware_595shiftreg.asm
