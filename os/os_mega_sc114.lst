9e89 15				db WORD_SYS_CORE+OPCODE_HEAP             
9e8a b7 9e			dw .EXEC            
9e8c 05				db 4 + 1 
9e8d .. 00			db "HEAP",0              
9e92				endm 
# End of macro CWHEAD
9e92			; | HEAP ( -- u1 u2 )   Pushes u1 the current number of bytes in the heap and u2 the remaining bytes - Only present if using my MALLOC | DONE 
9e92			; | | u1 - Current number of bytes in the heap 
9e92			; | | u2 - Remaining bytes left on the heap 
9e92			; | |  
9e92			; | | The heap is used for storing user defined words as well as any values pushed to stack. 
