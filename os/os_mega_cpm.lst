1211			create_startup: 
1211			 
1211				ld a, 0 
1211				ld hl, .crstart 
1211				call menu 
1211			 
1211				cp 0 
1211				ret z 
1211			 
1211				cp 1 
1211				call z, .genlsword 
1211				cp 2 
1211				call z, .genedword 
1211			 
1211				cp 3 
1211				call z, .gendemword 
1211			 
1211				cp 4 
1211				call z, .genutlword 
1211				cp 5 
1211				call z, .genspiword 
1211				cp 6 
1211				call z, .genkeyword 
1211				cp 7 
1211				call z, .gentapeword 
