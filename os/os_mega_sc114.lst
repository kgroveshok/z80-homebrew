902e			tape_gap:  
902e 3a 47 ea			ld a, (tape_tm_gap) 
9031 cd 39 87			call aDelayInMS 
9034 c9				ret 
9035			 
9035			tape_byte_gap: 
9035 cd 2e 90			call tape_gap 
9038 cd 2e 90			call tape_gap 
903b cd 2e 90			call tape_gap 
903e cd 2e 90			call tape_gap 
9041 c9				ret 
