1163			;------------------------------------------------------------------------------ 
1163			;     heap_init                                                               : 
1163			;                                                                             : 
1163			; Description                                                                 : 
1163			;     Initialise the heap and make it ready for malloc and free operations.   : 
1163			;                                                                             : 
1163			;     The heap is maintained as a linked list, starting with an initial       : 
1163			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
1163			;     the first free block in the heap. Each block then points to the next    : 
1163			;     free block within the heap, and the free list ends at the first block   : 
1163			;     with a null pointer to the next free block.                             : 
1163			;                                                                             : 
1163			; Parameters                                                                  : 
1163			;     Inputs are compile-time only. Two defines which specify the starting    : 
1163			;     address of the heap and its size are required, along with a memory      : 
1163			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
1163			;     principally stores a pointer to the first free block in the heap.       : 
1163			;                                                                             : 
1163			; Returns                                                                     : 
1163			;     Nothing                                                                 : 
1163			;------------------------------------------------------------------------------ 
1163			heap_init: 
1163 e5			      push  HL 
1164			 
1164			      ; Initialise free list struct 
1164 21 0e 80		      ld    HL, heap_start 
1167 22 0a 80		      ld    (free_list), HL 
116a 21 00 00		      ld    HL, 0 
116d 22 0c 80		      ld    (free_list+2), HL 
1170			 
1170			      ; Insert first free block at bottom of heap, consumes entire heap 
1170 21 af f0		      ld    HL, heap_start+heap_size-4 
1173 22 0e 80		      ld    (heap_start), HL        ; Next block (end of free list) 
1176 21 a1 70		      ld    HL, heap_size-4 
1179 22 10 80		      ld    (heap_start+2), HL      ; Block size 
117c			 
117c			      ; Insert end of free list block at top of heap - two null words will 
117c			      ; terminate the free list 
117c 21 00 00		      ld    HL, 0 
117f 22 b1 f0		      ld    (heap_start+heap_size-2), HL 
1182 22 af f0		      ld    (heap_start+heap_size-4), HL 
1185			 
1185 e1			      pop   HL 
1186			 
1186 c9			      ret 
1187			 
1187			 
1187			;------------------------------------------------------------------------------ 
1187			;     malloc                                                                  : 
1187			;                                                                             : 
1187			; Description                                                                 : 
1187			;     Allocates the wanted space from the heap and returns the address of the : 
1187			;     first useable byte of the allocation.                                   : 
1187			;                                                                             : 
1187			;     Allocations can happen in one of two ways:                              : 
1187			;                                                                             : 
1187			;     1. A free block may be found which is the exact size wanted. In this    : 
1187			;        case the block is removed from the free list and retuedn to the      : 
1187			;        caller.                                                              : 
1187			;     2. A free block may be found which is larger than the size wanted. In   : 
1187			;        this case, the larger block is split into two. The first portion of  : 
1187			;        this block will become the requested space by the malloc call and    : 
1187			;        is returned to the caller. The second portion becomes a new free     : 
1187			;        block, and the free list is adjusted to maintain continuity via this : 
1187			;        newly created block.                                                 : 
1187			;                                                                             : 
1187			;     malloc does not set any initial value in the allocated space, the       : 
1187			;     caller is required to do this as required.                              : 
1187			;                                                                             : 
1187			;     This implementation of malloc uses the stack exclusively, and is        : 
1187			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
1187			;     advisable to disable interrupts before calling malloc, and recommended  : 
1187			;     to avoid the use of malloc inside ISRs in general.                      : 
1187			;                                                                             : 
1187			;     NOTE: heap_init must be called before malloc and free can be used.      : 
1187			;                                                                             : 
1187			; Parameters                                                                  : 
1187			;     HL  Number of bytes wanted                                              : 
1187			;                                                                             : 
1187			; Returns                                                                     : 
1187			;     HL  Address of the first useable byte of the allocation                 : 
1187			;                                                                             : 
1187			; Flags                                                                       : 
1187			;     Z   Set if the allocation did not succeed, clear otherwise              : 
1187			;                                                                             : 
1187			; Stack frame                                                                 : 
1187			;       |             |                                                       : 
1187			;       +-------------+                                                       : 
1187			;       |     BC      |                                                       : 
1187			;       +-------------+                                                       : 
1187			;       |     DE      |                                                       : 
1187			;       +-------------+                                                       : 
1187			;       |     IX      |                                                       : 
1187			;       +-------------+                                                       : 
1187			;       |  prev_free  |                                                       : 
1187			;   +4  +-------------+                                                       : 
1187			;       |  this_free  |                                                       : 
1187			;   +2  +-------------+                                                       : 
1187			;       |  next_free  |                                                       : 
1187			;   +0  +-------------+                                                       : 
1187			;       |             |                                                       : 
1187			;                                                                             : 
1187			;------------------------------------------------------------------------------ 
1187			 
1187			 
1187			;malloc: 
1187			; 
1187			;	SAVESP ON 1 
1187			; 
1187			;	call malloc_code 
1187			; 
1187			;	CHECKSP ON 1 
1187			;	ret 
1187			 
1187			 
1187			malloc: 
1187 c5			      push  BC 
1188 d5			      push  DE 
1189 dd e5		      push  IX 
118b			if DEBUG_FORTH_MALLOC_HIGH 
118b			call malloc_guard_entry 
118b			endif 
118b			 
118b					if DEBUG_FORTH_MALLOC 
118b						DMARK "mal" 
118b						CALLMONITOR 
118b					endif 
118b 7c			      ld    A, H                    ; Exit if no space requested 
118c b5			      or    L 
118d ca 4c 12		      jp    Z, malloc_early_exit 
1190			 
1190			;inc hl 
1190			;inc hl 
1190			;inc hl 
1190			; 
1190			;inc hl 
1190			;inc hl 
1190			;inc hl 
1190			;inc hl 
1190			;inc hl 
1190			;inc hl 
1190			;inc hl 
1190			;inc hl 
1190			;inc hl 
1190			 
1190			 
1190			 
1190			 
1190					if DEBUG_FORTH_MALLOC 
1190						DMARK "maA" 
1190						CALLMONITOR 
1190					endif 
1190			      ; Set up stack frame 
1190 eb			      ex    DE, HL 
1191 21 fa ff		      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
1194 39			      add   HL, SP 
1195 f9			      ld    SP, HL 
1196 dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
119a dd 39		      add   IX, SP 
119c			 
119c			      ; Setup initial state 
119c 21 04 00		      ld    HL, 4                   ; want must also include space used by block struct 
119f 19			      add   HL, DE 
11a0			 
11a0 44			      ld    B, H                    ; Move want to BC 
11a1 4d			      ld    C, L 
11a2			 
11a2 21 0a 80		      ld    HL, free_list           ; Store prev_free ptr to stack 
11a5 dd 75 04		      ld    (IX+4), L 
11a8 dd 74 05		      ld    (IX+5), H 
11ab			 
11ab 5e			      ld    E, (HL)                 ; Store this_free ptr to stack 
11ac 23			      inc   HL 
11ad 56			      ld    D, (HL) 
11ae dd 73 02		      ld    (IX+2), E 
11b1 dd 72 03		      ld    (IX+3), D 
11b4 eb			      ex    DE, HL                  ; this_free ptr into HL 
11b5			 
11b5					if DEBUG_FORTH_MALLOC 
11b5						DMARK "maB" 
11b5						CALLMONITOR 
11b5					endif 
11b5			      ; Loop through free block list to find some space 
11b5			malloc_find_space: 
11b5 5e			      ld    E, (HL)                 ; Load next_free ptr into DE 
11b6 23			      inc   HL 
11b7 56			      ld    D, (HL) 
11b8			 
11b8 7a			      ld    A, D                    ; Check for null next_free ptr - end of free list 
11b9 b3			      or    E 
11ba ca 46 12		      jp    Z, malloc_no_space 
11bd			 
11bd dd 73 00		      ld    (IX+0), E               ; Store next_free ptr to stack 
11c0 dd 72 01		      ld    (IX+1), D 
11c3			 
11c3			      ; Does this block have enough space to make the allocation? 
11c3 23			      inc   HL                      ; Load free block size into DE 
11c4 5e			      ld    E, (HL) 
11c5 23			      inc   HL 
11c6 56			      ld    D, (HL) 
11c7			 
11c7 eb			      ex    DE, HL                  ; Check size of block against want 
11c8 b7			      or    A                       ; Ensure carry flag clear 
11c9 ed 42		      sbc   HL, BC 
11cb e5			      push  HL                      ; Store the result for later (new block size) 
11cc			 
11cc ca 1b 12		      jp   Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
11cf 30 1b		      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
11d1			 
11d1			      ; this_free block is not big enough, setup ptrs to test next free block 
11d1 e1			      pop   HL                      ; Discard previous result 
11d2			 
11d2 dd 6e 02		      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
11d5 dd 66 03		      ld    H, (IX+3) 
11d8 dd 75 04		      ld    (IX+4), L 
11db dd 74 05		      ld    (IX+5), H 
11de			 
11de dd 6e 00		      ld    L, (IX+0)               ; Move next_free ptr into this_free 
11e1 dd 66 01		      ld    H, (IX+1) 
11e4 dd 75 02		      ld    (IX+2), L 
11e7 dd 74 03		      ld    (IX+3), H 
11ea			 
11ea					if DEBUG_FORTH_MALLOC 
11ea						DMARK "MA>" 
11ea						CALLMONITOR 
11ea					endif 
11ea 18 c9		      jr    malloc_find_space 
11ec			 
11ec			      ; split a bigger block into two - requested size and remaining size 
11ec			malloc_alloc_split: 
11ec					if DEBUG_FORTH_MALLOC 
11ec						DMARK "MAs" 
11ec						CALLMONITOR 
11ec					endif 
11ec eb			      ex    DE, HL                  ; Calculate address of new free block 
11ed 2b			      dec   HL 
11ee 2b			      dec   HL 
11ef 2b			      dec   HL 
11f0 09			      add   HL, BC 
11f1			 
11f1			      ; Create a new block and point it at next_free 
11f1 dd 5e 00		      ld    E, (IX+0)               ; Load next_free ptr into DE 
11f4 dd 56 01		      ld    D, (IX+1) 
11f7			 
11f7 73			      ld    (HL), E                 ; Store next_free ptr into new block 
11f8 23			      inc   HL 
11f9 72			      ld    (HL), D 
11fa			 
11fa d1			      pop   DE                      ; Store size of new block into new block 
11fb 23			      inc   HL 
11fc 73			      ld    (HL), E 
11fd 23			      inc   HL 
11fe 72			      ld    (HL), D 
11ff			 
11ff			      ; Update this_free ptr to point to new block 
11ff 2b			      dec   HL 
1200 2b			      dec   HL 
1201 2b			      dec   HL 
1202			 
1202 dd 5e 02		      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
1205 dd 56 03		      ld    D, (IX+3) 
1208			 
1208 dd 75 02		      ld    (IX+2), L               ; Store new block addr as this_free ptr 
120b dd 74 03		      ld    (IX+3), H 
120e			 
120e			      ; Modify this_free block to be allocation 
120e eb			      ex    DE, HL 
120f af			      xor   A                       ; Null the next block ptr of allocated block 
1210 77			      ld    (HL), A 
1211 23			      inc   HL 
1212 77			      ld    (HL), A 
1213			 
1213 23			      inc   HL                      ; Store want size into allocated block 
1214 71			      ld    (HL), C 
1215 23			      inc   HL 
1216 70			      ld    (HL), B 
1217 23			      inc   HL 
1218 e5			      push  HL                      ; Address of allocation to return 
1219			 
1219 18 19		      jr    malloc_update_links 
121b			 
121b			malloc_alloc_fit: 
121b e1			      pop   HL                      ; Dont need new block size, want is exact fit 
121c			 
121c					if DEBUG_FORTH_MALLOC 
121c						DMARK "MAf" 
121c						CALLMONITOR 
121c					endif 
121c			      ; Modify this_free block to be allocation 
121c eb			      ex    DE, HL 
121d 2b			      dec   HL 
121e 2b			      dec   HL 
121f 2b			      dec   HL 
1220			 
1220 af			      xor   A                       ; Null the next block ptr of allocated block 
1221 77			      ld    (HL), A 
1222 23			      inc   HL 
1223 77			      ld    (HL), A 
1224			 
1224 23			      inc   HL                      ; Store address of allocation to return 
1225 23			      inc   HL 
1226 23			      inc   HL 
1227 e5			      push  HL 
1228			 
1228			      ; Copy next_free ptr to this_free, remove allocated block from free list 
1228 dd 6e 00		      ld    L, (IX+0)               ; next_free to HL 
122b dd 66 01		      ld    H, (IX+1) 
122e			 
122e dd 75 02		      ld    (IX+2), L               ; HL to this_free 
1231 dd 74 03		      ld    (IX+3), H 
1234			 
1234			 
1234			malloc_update_links: 
1234			      ; Update prev_free ptr to point to this_free 
1234 dd 6e 04		      ld    L, (IX+4)               ; prev_free ptr to HL 
1237 dd 66 05		      ld    H, (IX+5) 
123a			 
123a dd 5e 02		      ld    E, (IX+2)               ; this_free ptr to DE 
123d dd 56 03		      ld    D, (IX+3) 
1240			 
1240 73			      ld    (HL), E                 ; this_free ptr into prev_free 
1241 23			      inc   HL 
1242 72			      ld    (HL), D 
1243			 
1243					if DEBUG_FORTH_MALLOC 
1243						DMARK "Mul" 
1243						CALLMONITOR 
1243					endif 
1243			      ; Clear the Z flag to indicate successful allocation 
1243 7a			      ld    A, D 
1244 b3			      or    E 
1245			 
1245 d1			      pop   DE                      ; Address of allocation 
1246					if DEBUG_FORTH_MALLOC 
1246						DMARK "MAu" 
1246						CALLMONITOR 
1246					endif 
1246			 
1246			malloc_no_space: 
1246 21 06 00		      ld    HL, 6                   ; Clean up stack frame 
1249 39			      add   HL, SP 
124a f9			      ld    SP, HL 
124b			 
124b eb			      ex    DE, HL                  ; Alloc addr into HL for return 
124c					if DEBUG_FORTH_MALLOC 
124c						DMARK "MAN" 
124c						CALLMONITOR 
124c					endif 
124c			 
124c			malloc_early_exit: 
124c					if DEBUG_FORTH_MALLOC 
124c						DMARK "MAx" 
124c						CALLMONITOR 
124c					endif 
124c dd e1		      pop   IX 
124e d1			      pop   DE 
124f c1			      pop   BC 
1250			 
1250			if DEBUG_FORTH_MALLOC_HIGH 
1250			call malloc_guard_exit 
1250			call malloc_guard_zerolen 
1250			endif 
1250 c9			      ret 
1251			 
1251			 
1251			;------------------------------------------------------------------------------ 
1251			;     free                                                                    : 
1251			;                                                                             : 
1251			; Description                                                                 : 
1251			;     Return the space pointed to by HL to the heap. HL must be an address as : 
1251			;     returned by malloc, otherwise the behaviour is undefined.               : 
1251			;                                                                             : 
1251			;     Where possible, directly adjacent free blocks will be merged together   : 
1251			;     into larger blocks to help ensure that the heap does not become         : 
1251			;     excessively fragmented.                                                 : 
1251			;                                                                             : 
1251			;     free does not clear or set any other value into the freed space, and    : 
1251			;     therefore its contents may be visible through subsequent malloc's. The  : 
1251			;     caller should clear the freed space as required.                        : 
1251			;                                                                             : 
1251			;     This implementation of free uses the stack exclusively, and is          : 
1251			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
1251			;     advisable to disable interrupts before calling free, and recommended    : 
1251			;     to avoid the use of free inside ISRs in general.                        : 
1251			;                                                                             : 
1251			;     NOTE: heap_init must be called before malloc and free can be used.      : 
1251			;                                                                             : 
1251			; Parameters                                                                  : 
1251			;     HL  Pointer to address of first byte of allocation to be freed          : 
1251			;                                                                             : 
1251			; Returns                                                                     : 
1251			;     Nothing                                                                 : 
1251			;                                                                             : 
1251			; Stack frame                                                                 : 
1251			;       |             |                                                       : 
1251			;       +-------------+                                                       : 
1251			;       |     BC      |                                                       : 
1251			;       +-------------+                                                       : 
1251			;       |     DE      |                                                       : 
1251			;       +-------------+                                                       : 
1251			;       |     IX      |                                                       : 
1251			;       +-------------+                                                       : 
1251			;       |  prev_free  |                                                       : 
1251			;   +2  +-------------+                                                       : 
1251			;       |  next_free  |                                                       : 
1251			;   +0  +-------------+                                                       : 
1251			;       |             |                                                       : 
1251			;                                                                             : 
1251			;------------------------------------------------------------------------------ 
1251			free: 
1251 c5			      push  BC 
1252 d5			      push  DE 
1253 dd e5		      push  IX 
1255			 
1255 7c			      ld    A, H                    ; Exit if ptr is null 
1256 b5			      or    L 
1257 ca 1b 13		      jp    Z, free_early_exit 
125a			 
125a			      ; Set up stack frame 
125a eb			      ex    DE, HL 
125b 21 fc ff		      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
125e 39			      add   HL, SP 
125f f9			      ld    SP, HL 
1260 dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
1264 dd 39		      add   IX, SP 
1266			 
1266			      ; The address in HL points to the start of the useable allocated space, 
1266			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
1266			      ; address of the block itself. 
1266 eb			      ex    DE, HL 
1267 11 fc ff		      ld    DE, -4 
126a 19			      add   HL, DE 
126b			 
126b			      ; An allocated block must have a null next block pointer in it 
126b 7e			      ld    A, (HL) 
126c 23			      inc   HL 
126d b6			      or    (HL) 
126e c2 16 13		      jp    NZ, free_done 
1271			 
1271 2b			      dec   HL 
1272			 
1272 44			      ld    B, H                    ; Copy HL to BC 
1273 4d			      ld    C, L 
1274			 
1274			      ; Loop through the free list to find the first block with an address 
1274			      ; higher than the block being freed 
1274 21 0a 80		      ld    HL, free_list 
1277			 
1277			free_find_higher_block: 
1277 5e			      ld    E, (HL)                 ; Load next ptr from free block 
1278 23			      inc   HL 
1279 56			      ld    D, (HL) 
127a 2b			      dec   HL 
127b			 
127b dd 73 00		      ld    (IX+0), E               ; Save ptr to next free block 
127e dd 72 01		      ld    (IX+1), D 
1281 dd 75 02		      ld    (IX+2), L               ; Save ptr to prev free block 
1284 dd 74 03		      ld    (IX+3), H 
1287			 
1287 78			      ld    A, B                    ; Check if DE is greater than BC 
1288 ba			      cp    D                       ; Compare MSB first 
1289 28 02		      jr    Z, $+4                  ; MSB the same, compare LSB 
128b 30 04		      jr    NC, free_find_higher_block_skip 
128d 79			      ld    A, C 
128e bb			      cp    E                       ; Then compare LSB 
128f 38 08		      jr    C, free_found_higher_block 
1291			 
1291			free_find_higher_block_skip: 
1291 7a			      ld    A, D                    ; Reached the end of the free list? 
1292 b3			      or    E 
1293 ca 16 13		      jp    Z, free_done 
1296			 
1296 eb			      ex    DE, HL 
1297			 
1297 18 de		      jr    free_find_higher_block 
1299			 
1299			free_found_higher_block: 
1299			      ; Insert freed block between prev and next free blocks 
1299 71			      ld    (HL), C                 ; Point prev free block to freed block 
129a 23			      inc   HL 
129b 70			      ld    (HL), B 
129c			 
129c 60			      ld    H, B                    ; Point freed block at next free block 
129d 69			      ld    L, C 
129e 73			      ld    (HL), E 
129f 23			      inc   HL 
12a0 72			      ld    (HL), D 
12a1			 
12a1			      ; Check if the freed block is adjacent to the next free block 
12a1 23			      inc   HL                      ; Load size of freed block into HL 
12a2 5e			      ld    E, (HL) 
12a3 23			      inc   HL 
12a4 56			      ld    D, (HL) 
12a5 eb			      ex    DE, HL 
12a6			 
12a6 09			      add   HL, BC                  ; Add addr of freed block and its size 
12a7			 
12a7 dd 5e 00		      ld    E, (IX+0)               ; Load addr of next free block into DE 
12aa dd 56 01		      ld    D, (IX+1) 
12ad			 
12ad b7			      or    A                       ; Clear the carry flag 
12ae ed 52		      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
12b0 20 22		      jr    NZ, free_check_adjacent_to_prev 
12b2			 
12b2			      ; Freed block is adjacent to next, merge into one bigger block 
12b2 eb			      ex    DE, HL                  ; Load next ptr from next block into DE 
12b3 5e			      ld    E, (HL) 
12b4 23			      inc   HL 
12b5 56			      ld    D, (HL) 
12b6 e5			      push  HL                      ; Save ptr to next block for later 
12b7			 
12b7 60			      ld    H, B                    ; Store ptr from next block into freed block 
12b8 69			      ld    L, C 
12b9 73			      ld    (HL), E 
12ba 23			      inc   HL 
12bb 72			      ld    (HL), D 
12bc			 
12bc e1			      pop   HL                      ; Restore ptr to next block 
12bd 23			      inc   HL                      ; Load size of next block into DE 
12be 5e			      ld    E, (HL) 
12bf 23			      inc   HL 
12c0 56			      ld    D, (HL) 
12c1 d5			      push  DE                      ; Save next block size for later 
12c2			 
12c2 60			      ld    H, B                    ; Load size of freed block into HL 
12c3 69			      ld    L, C 
12c4 23			      inc   HL 
12c5 23			      inc   HL 
12c6 5e			      ld    E, (HL) 
12c7 23			      inc   HL 
12c8 56			      ld    D, (HL) 
12c9 eb			      ex    DE, HL 
12ca			 
12ca d1			      pop   DE                      ; Restore size of next block 
12cb 19			      add   HL, DE                  ; Add sizes of both blocks 
12cc eb			      ex    DE, HL 
12cd			 
12cd 60			      ld    H, B                    ; Store new bigger size into freed block 
12ce 69			      ld    L, C 
12cf 23			      inc   HL 
12d0 23			      inc   HL 
12d1 73			      ld    (HL), E 
12d2 23			      inc   HL 
12d3 72			      ld    (HL), D 
12d4			 
12d4			free_check_adjacent_to_prev: 
12d4			      ; Check if the freed block is adjacent to the prev free block 
12d4 dd 6e 02		      ld    L, (IX+2)               ; Prev free block ptr into HL 
12d7 dd 66 03		      ld    H, (IX+3) 
12da			 
12da 23			      inc   HL                      ; Size of prev free block into DE 
12db 23			      inc   HL 
12dc 5e			      ld    E, (HL) 
12dd 23			      inc   HL 
12de 56			      ld    D, (HL) 
12df 2b			      dec   HL 
12e0 2b			      dec   HL 
12e1 2b			      dec   HL 
12e2			 
12e2 19			      add   HL, DE                  ; Add prev block addr and size 
12e3			 
12e3 b7			      or    A                       ; Clear the carry flag 
12e4 ed 42		      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
12e6 20 2e		      jr    NZ, free_done 
12e8			 
12e8			      ; Freed block is adjacent to prev, merge into one bigger block 
12e8 60			      ld    H, B                    ; Load next ptr from freed block into DE 
12e9 69			      ld    L, C 
12ea 5e			      ld    E, (HL) 
12eb 23			      inc   HL 
12ec 56			      ld    D, (HL) 
12ed e5			      push  HL                      ; Save freed block ptr for later 
12ee			 
12ee dd 6e 02		      ld    L, (IX+2)               ; Store freed block ptr into prev block 
12f1 dd 66 03		      ld    H, (IX+3) 
12f4 73			      ld    (HL), E 
12f5 23			      inc   HL 
12f6 72			      ld    (HL), D 
12f7			 
12f7 e1			      pop   HL                      ; Restore freed block ptr 
12f8 23			      inc   HL                      ; Load size of freed block into DE 
12f9 5e			      ld    E, (HL) 
12fa 23			      inc   HL 
12fb 56			      ld    D, (HL) 
12fc d5			      push  DE                      ; Save freed block size for later 
12fd			 
12fd dd 6e 02		      ld    L, (IX+2)               ; Load size of prev block into DE 
1300 dd 66 03		      ld    H, (IX+3) 
1303 23			      inc   HL 
1304 23			      inc   HL 
1305 5e			      ld    E, (HL) 
1306 23			      inc   HL 
1307 56			      ld    D, (HL) 
1308			 
1308 e1			      pop   HL                      ; Add sizes of both blocks 
1309 19			      add   HL, DE 
130a eb			      ex    DE, HL 
130b			 
130b dd 6e 02		      ld    L, (IX+2)               ; Store new bigger size into prev block 
130e dd 66 03		      ld    H, (IX+3) 
1311 23			      inc   HL 
1312 23			      inc   HL 
1313 73			      ld    (HL), E 
1314 23			      inc   HL 
1315 72			      ld    (HL), D 
1316			 
1316			free_done: 
1316 21 04 00		      ld    HL, 4                   ; Clean up stack frame 
1319 39			      add   HL, SP 
131a f9			      ld    SP, HL 
131b			 
131b			free_early_exit: 
131b dd e1		      pop   IX 
131d d1			      pop   DE 
131e c1			      pop   BC 
131f			 
131f c9			      ret 
