01e7			; 
01e7			; Block 0 - Bank config  
01e7			; 
01e7			;      Byte - 0 file id counter 
01e7			;      Byte - 1-2 formated: Byte pattern: 0x80 x27 
01e7			;      Byte - 3-20 zero terminated bank label 
01e7			; 
01e7			; Block 1 > File storage 
01e7			; 
01e7			;      Byte 0 file id    - block 0 file details 
01e7			;      Byte 1 block id - block 0 is file  
01e7			;            Byte 2-15 - File name 
01e7			; 
01e7			;       - to end of block data 
01e7			; 
