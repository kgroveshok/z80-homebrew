2650					FORTH_PUSH_VALUEHL 
2650				if BASE_CPM=1 
2650					call forth_push_numhl 
2650				endif 
2650				if BASE_KEV=1 
2650 e7					rst $20 
2651				endif 
2651				endm 
# End of macro FORTH_PUSH_VALUEHL
