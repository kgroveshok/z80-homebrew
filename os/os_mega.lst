1d0c			include "firmware_595shiftreg.asm"  
1d0c			; common code for handling a 595 shift reg out on whatever output port 
1d0c			 
1d0c			; port in c 
1d0c			; byte in a 
1d0c			 
1d0c			 
1d0c			shift_bit_data: equ 0 
1d0c			shift_bit_clk: equ 1 
1d0c			shift_bit_latch: equ 2 
1d0c			 
1d0c			 
1d0c			; shift out a byte to the sound chip 
1d0c			 
1d0c			; A contains byte to send 
1d0c			 
1d0c			shift_byte: 
1d0c			 
1d0c 06 08			ld b, 8   ; 8 bits to shift 
1d0e			 
1d0e 16 00		.nb1:	ld d, 0    ; our work byte to send to the device with flags 
1d10			 
1d10				; set data bit state 
1d10			 
1d10 cb 7f			bit 7, a 
1d12				; high bit is set 
1d12 28 02			jr z, .nb2 
1d14 cb c2			set shift_bit_data, d 
1d16			 
1d16				; set latches state  
1d16 cb ca		.nb2:	set shift_bit_clk, d 
1d18 cb 92			res shift_bit_latch, d    ; latch is inverted 
1d1a ed 51			out (c), d 
1d1c				 
1d1c				; clock the bit out 
1d1c cb 8a			res shift_bit_clk, d 
1d1e ed 51			out (c), d 
1d20			 
1d20				; shift a left one bit and repeat 
1d20 17				rla 
1d21			 
1d21 10 eb			djnz .nb1 
1d23			 
1d23				; latch 
1d23 cb d2			set shift_bit_latch, d 
1d25 ed 51			out (c), d 
1d27					 
1d27			 
1d27				; set  
1d27 c9				ret 
# End of file firmware_595shiftreg.asm
