1150 c5			      push  BC 
1151 d5			      push  DE 
1152 dd e5		      push  IX 
1154			if DEBUG_FORTH_MALLOC_HIGH 
1154			call malloc_guard_entry 
1154			endif 
1154			 
1154					if DEBUG_FORTH_MALLOC 
1154						DMARK "mal" 
1154						CALLMONITOR 
1154					endif 
1154 7c			      ld    A, H                    ; Exit if no space requested 
1155 b5			      or    L 
1156 ca 15 12		      jp    Z, malloc_early_exit 
1159			 
1159			;inc hl 
1159			;inc hl 
1159			;inc hl 
1159			; 
1159			;inc hl 
1159			;inc hl 
1159			;inc hl 
1159			;inc hl 
1159			;inc hl 
1159			;inc hl 
1159			;inc hl 
1159			;inc hl 
1159			;inc hl 
1159			 
1159			 
1159			 
1159			 
