1d93			.NEW: 
1d93			CWHEAD .HEAP OPCODE_HEAP "NEW" 3 WORD_FLAG_CODE 
1d93 15				db WORD_SYS_CORE+OPCODE_HEAP             
1d94 ad 1d			dw .HEAP            
1d96 04				db 3 + 1 
1d97 .. 00			db "NEW",0              
1d9b				endm 
# End of macro CWHEAD
1d9b			; | NEW ( -- ) Clears all user words and stack | DONE 
1d9b				 
1d9b				if MALLOC_4 
1d9b					call  heap_init 
1d9b				endif 
1d9b				; reset uword pointers 
1d9b 21 4e 5b			ld hl, baseram 
1d9e 22 9a e5			ld (os_last_new_uword), hl 
