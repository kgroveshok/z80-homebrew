0dcf 5f			    ld    e, a    ; L = A+L 
0dd0 8a			    adc   a, d    ; A = A+L+H+carry 
0dd1 93			    sub   e       ; A = H+carry 
0dd2 57			    ld    d, a    ; H = H+carry 
0dd3 c9			ret 
