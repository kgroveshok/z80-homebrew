538b			; | VAR ( u1 -- )  Get the address of the (word) variable referenced on TOS  | DONE 
538b			; | 
538b			; | | The variable name should consist of a single letter (a-z). e.g. "a" 
538b			; | |  
538b			; | | e.g. 
538b			; | |         #30 a var ! 
538b			; | |         a var @ . 
538b			; | |   
538b			; | |     Displays the number 30 
538b			; | | 
538b			; | | Each variable pointer is a word so can use for any words that use that:  
538b			; | |  
538b			; | | e.g. 
538b			; | |  
538b			; | |         #30 a var 2! 
538b			; | |         a var 2@ . 
538b			; | |   
538b			; | |     Displays the number 30 
538b			; | |  
538b			; | | > [!NOTE]  
538b			; ! | > If a full string is passed then only the first char is looked at 
538b			; | | > Any other char could exceed bounds checks!  
538b			; | | > 
538b			; | | > Each variable location follows the previous. Watch you don't clobber any others. 
538b			 
538b					if DEBUG_FORTH_WORDS_KEY 
538b						DMARK "VAR" 
538b				if DEMARK_VERSION = 1  
538b e5					push hl  
538c 21 94 53				ld hl, .dmark  
538f 22 9b fd				ld (debug_mark), hl  
5392				endif  
5392				if DEMARK_VERSION = 0  
5392					push af  
5392					ld a, (.dmark)  
5392					ld (debug_mark),a  
5392					ld a, (.dmark+1)  
5392					ld (debug_mark+1),a  
5392					ld a, (.dmark+2)  
5392					ld (debug_mark+2),a  
5392				endif  
5392 18 04			jr .pastdmark  
5394 ..			.dmark: db "VAR"  
5397				if DEMARK_VERSION = 1  
5397 00					db 0  
5398				endif  
5398				if DEMARK_VERSION = 1  
5398 e1			.pastdmark: pop hl  
5399				endif  
5399				if DEMARK_VERSION = 0  
5399			.pastdmark: pop af  
5399				endif  
5399			endm  
# End of macro DMARK
5399						CALLMONITOR 
5399				if BASE_CPM=1  
5399					call debug_vector  
5399				endif  
