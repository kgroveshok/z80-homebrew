6dcb			  
6dcb			; Position cursor to specified location  
6dcb			;   On entry: A = Cursor position  
6dcb			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6dcb f5			fLCD_Pos:   PUSH AF  
6dcc					; at this point set the E1 or E2 flag depending on position  
6dcc			  
6dcc c5					push bc  
6dcd			;		push af  
6dcd 06 00				ld b, 0  
6dcf 4f					ld c, a  
6dd0 3e 4f				ld a, kLCD_Line3-1  
6dd2 b7			 		or a      ;clear carry flag  
6dd3 99					sbc a,c    ; TODO may need to sub 80 from a to put in context of current frame    
6dd4 38 04				jr c, .pe1  
6dd6			  
6dd6					; E selection  
6dd6 cb 80				res 0, b         ; bit 0 unset e  
6dd8			;		pop af    ; before line 3 so recover orig pos  
6dd8			;		ld c, a    ; save for poking back  
6dd8 18 06				jr .peset	          
6dda			.pe1:          	; E2 selection  
6dda cb c0				set 0, b         ; bit 0 set e1  
6ddc 79					ld a, c  
6ddd de 4f				sbc a, kLCD_Line3-1  
6ddf 4f					ld c, a	         ; save caculated offset  
6de0			;		pop af     ; bin this original value now we have calculated form  
6de0			  
6de0			.peset:		; set bit  
6de0 78					ld a, b  
6de1 32 fb fa				ld (display_lcde1e2), a 	  
6de4 79					ld a, c  
6de5 c1					pop bc  
6de6			  
6de6 f6 80		            OR   kLCD_Pos       ;Prepare position cursor instruction  
6de8 cd 3b 6d		            CALL fLCD_Inst      ;Write instruction to LCD  
6deb f1			            POP  AF  
6dec c9			            RET  
6ded			  
6ded			  
6ded			; Output text string to LCD  
6ded			;   On entry: DE = Pointer to null terminated text string  
6ded			;   On exit:  BC HL IX IY I AF' BC' DE' HL' preserved  
6ded 1a			fLCD_Str:   LD   A, (DE)        ;Get character from string  
6dee b7			            OR   A              ;Null terminator?  
6def c8			            RET  Z              ;Yes, so finished  
6df0 cd 7d 6d		            CALL fLCD_Data      ;Write character to display  
6df3 13			            INC  DE             ;Point to next character  
6df4 18 f7		            JR   fLCD_Str       ;Repeat  
6df6 c9					ret  
6df7			  
6df7			; Define custom character  
6df7			;   On entry: A = Character number (0 to 7)  
6df7			;             DE = Pointer to character bitmap data  
6df7			;   On exit:  A = Next character number  
6df7			;             DE = Next location following bitmap  
6df7			;             BC HL IX IY I AF' BC' DE' HL' preserved  
6df7			; Character is   
6df7 c5			fLCD_Def:   PUSH BC  
6df8 f5			            PUSH AF  
6df9 07			            RLCA                ;Calculate location  
6dfa 07			            RLCA                ;  for bitmap data  
6dfb 07			            RLCA                ;  = 8 x CharacterNumber  
6dfc f6 40		            OR   kLCD_Def       ;Prepare define character instruction  
6dfe cd 3b 6d		            CALL fLCD_Inst      ;Write instruction to LCD  
6e01 06 00		            LD   B, 0  
6e03 1a			Loop:      LD   A, (DE)        ;Get byte from bitmap  
6e04 cd 7d 6d		            CALL fLCD_Data      ;Write byte to display  
6e07 13			            INC  DE             ;Point to next byte  
6e08 04			            INC  B              ;Count bytes  
6e09 cb 58		            BIT  3, B           ;Finish all 8 bytes?  
6e0b 28 f6		            JR   Z, Loop       ;No, so repeat  
6e0d f1			            POP  AF  
6e0e 3c			            INC  A              ;Increment character number  
6e0f c1			            POP  BC  
6e10 c9			            RET  
