2c94			; | MONITOR ( -- ) Display system breakpoint/monitor | DONE 
2c94			; | | At start the current various registers will be displayed with contents. 
2c94			; | | Top right corner will show the most recent debug marker seen. 
2c94			; | | The bottom of the screen will also show the values of the data stack pointer (DSP) 
2c94			; | | and the return stack pointer (RSP). 
2c94			; | | Pressing: 
2c94			; | |  
2c94			; | |    1 - Initial screen 
2c94			; | |  
2c94			; | |    2 - Display a data dump of HL 
2c94			; | |  
2c94			; | |    3 - Display a data dump of DE 
2c94			; | |  
2c94			; | |    4 - Display a data dump of BC 
2c94			; | |  
2c94			; | |    5 - Display a data dump of HL 
2c94			; | |  
2c94			; | |    6 - Display a data dump of DSP 
2c94			; | |  
2c94			; | |    7 - Display a data dump of RSP 
2c94			; | |  
2c94			; | |    8 - Display a data dump of what is at DSP 
2c94			; | |  
2c94			; | |    9 - Display a data dump of what is at RSP 
2c94			; | |  
2c94			; | |    0 - Exit monitor and continue running. This will also enable break points 
2c94			; | |  
2c94			; | |    * - Disable break points 
2c94			; | |  
2c94			; | |    # - Enter traditional monitor mode 
2c94			; | |  
2c94			; | | 
2c94			; | | Monitor Mode 
2c94			; | | ------------ 
2c94			; | | A prompt of '>' will be shown for various commands: 
2c94			; | |  
2c94			; | |    D xxxx - Display a data dump starting from hex address xxxx 
2c94			; | |  
2c94			; | |    C - Continue display a data dump from the last set address 
2c94			; | |  
2c94			; | |    M xxxx - Set start of memory edit at address xx 
2c94			; | |  
2c94			; | |    U xx - Poke the hex byte xx into the address set by M and increment the address to the next location 
2c94			; | |  
2c94			; | |    G xxxx - Exec code at specific address 
2c94			; | |  
2c94			; | |    Q - Return to previous 
2c94				if DEBUG_FORTH_WORDS_KEY 
2c94					DMARK "MON" 
2c94				if DEMARK_VERSION = 1  
2c94 e5					push hl  
2c95 21 9d 2c				ld hl, .dmark  
2c98 22 9b fd				ld (debug_mark), hl  
2c9b				endif  
2c9b				if DEMARK_VERSION = 0  
