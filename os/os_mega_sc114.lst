9e92 e5					push hl  
9e93 21 9b 9e				ld hl, .dmark  
9e96 22 60 ee				ld (debug_mark), hl  
9e99				endif  
9e99				if DEMARK_VERSION = 0  
9e99					push af  
9e99					ld a, (.dmark)  
9e99					ld (debug_mark),a  
9e99					ld a, (.dmark+1)  
9e99					ld (debug_mark+1),a  
9e99					ld a, (.dmark+2)  
9e99					ld (debug_mark+2),a  
9e99				endif  
9e99 18 04			jr .pastdmark  
9e9b ..			.dmark: db "HEP"  
9e9e				if DEMARK_VERSION = 1  
9e9e 00					db 0  
9e9f				endif  
9e9f				if DEMARK_VERSION = 1  
9e9f e1			.pastdmark: pop hl  
9ea0				endif  
9ea0				if DEMARK_VERSION = 0  
9ea0			.pastdmark: pop af  
9ea0				endif  
9ea0			endm  
