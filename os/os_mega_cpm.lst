0f2c			; Decimal Signed Version 
0f2c			 
0f2c			; DispA 
0f2c			; -------------------------------------------------------------- 
0f2c			; Converts a signed integer value to a zero-terminated ASCII 
0f2c			; string representative of that value (using radix 10). 
0f2c			; -------------------------------------------------------------- 
0f2c			; INPUTS: 
0f2c			;     HL     Value to convert (two's complement integer). 
0f2c			;     DE     Base address of string destination. (pointer). 
0f2c			; -------------------------------------------------------------- 
0f2c			; OUTPUTS: 
0f2c			;     None 
0f2c			; -------------------------------------------------------------- 
0f2c			; REGISTERS/MEMORY DESTROYED 
0f2c			; AF HL 
0f2c			; -------------------------------------------------------------- 
0f2c			 
0f2c			;DispHLToASCII: 
0f2c			;   push    de 
0f2c			;   push    bc 
0f2c			; 
0f2c			;; Detect sign of HL. 
0f2c			;    bit    7, h 
0f2c			;    jr     z, ._DoConvert 
0f2c			; 
0f2c			;; HL is negative. Output '-' to string and negate HL. 
0f2c			;    ld     a, '-' 
0f2c			;    ld     (de), a 
0f2c			;    inc    de 
0f2c			; 
0f2c			;; Negate HL (using two's complement) 
0f2c			;    xor    a 
0f2c			;    sub    l 
0f2c			;    ld     l, a 
0f2c			;    ld     a, 0     ; Note that XOR A or SUB A would disturb CF 
0f2c			;    sbc    a, h 
0f2c			;    ld     h, a 
0f2c			; 
0f2c			;; Convert HL to digit characters 
0f2c			;._DoConvert: 
0f2c			;    ld     b, 0     ; B will count character length of number 
0f2c			;-   ld     a, 10 
0f2c			;    syscall  .DivHLByA  ; HL = HL / A, A = remainder 
0f2c			;    push   af 
0f2c			;    inc    b 
0f2c			;    ld     a, h 
0f2c			;    or     l 
0f2c			;    jr     nz, - 
0f2c			; 
0f2c			;; Retrieve digits from stack 
0f2c			;-   pop    af 
0f2c			;    or     $30 
0f2c			;    ld     (de), a 
0f2c			;    inc    de 
0f2c			;    djnz   - 
0f2c			; 
0f2c			;; Terminate string with NULL 
0f2c			;    xor    a 
0f2c			;    ld     (de), a 
0f2c			; 
0f2c			;    pop    bc 
0f2c			;    pop    de 
0f2c			;    ret 
0f2c			 
0f2c			;Comments 
0f2c			; 
0f2c			;    This routine uses the common positive-integer radix conversion algorithm of repeatedly dividing a value by the desired radix (base case: the value is zero) and saving the remainders of each division. 
0f2c			;    As this algorithm gives the digits in reverse order, they are pushed onto the hardware stack so that subsequently popping them yields the correct order. 
0f2c			;    Note that the output string will not be fixed-width. 
0f2c			; 
0f2c			;Example Usage 
0f2c			; 
0f2c			;    ld    hl, -1004 
