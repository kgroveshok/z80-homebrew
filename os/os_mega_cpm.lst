253d			; | MONITOR ( -- ) Display system breakpoint/monitor | DONE 
253d			; | | At start the current various registers will be displayed with contents. 
253d			; | | Top right corner will show the most recent debug marker seen. 
253d			; | | The bottom of the screen will also show the values of the data stack pointer (DSP) 
253d			; | | and the return stack pointer (RSP). 
253d			; | | Pressing: 
253d			; | |  
253d			; | |    1 - Initial screen 
253d			; | |  
253d			; | |    2 - Display a data dump of HL 
253d			; | |  
253d			; | |    3 - Display a data dump of DE 
253d			; | |  
253d			; | |    4 - Display a data dump of BC 
253d			; | |  
253d			; | |    5 - Display a data dump of HL 
253d			; | |  
253d			; | |    6 - Display a data dump of DSP 
253d			; | |  
253d			; | |    7 - Display a data dump of RSP 
253d			; | |  
253d			; | |    8 - Display a data dump of what is at DSP 
253d			; | |  
253d			; | |    9 - Display a data dump of what is at RSP 
253d			; | |  
253d			; | |    0 - Exit monitor and continue running. This will also enable break points 
253d			; | |  
253d			; | |    * - Disable break points 
253d			; | |  
253d			; | |    # - Enter traditional monitor mode 
253d			; | |  
253d			; | | 
253d			; | | Monitor Mode 
253d			; | | ------------ 
253d			; | | A prompt of '>' will be shown for various commands: 
253d			; | |  
253d			; | |    D xxxx - Display a data dump starting from hex address xxxx 
253d			; | |  
253d			; | |    C - Continue display a data dump from the last set address 
253d			; | |  
253d			; | |    M xxxx - Set start of memory edit at address xx 
253d			; | |  
253d			; | |    U xx - Poke the hex byte xx into the address set by M and increment the address to the next location 
253d			; | |  
253d			; | |    G xxxx - Exec code at specific address 
253d			; | |  
253d			; | |    Q - Return to previous 
253d				if DEBUG_FORTH_WORDS_KEY 
253d					DMARK "MON" 
253d				if DEMARK_VERSION = 1  
253d e5					push hl  
253e 21 46 25				ld hl, .dmark  
2541 22 60 ee				ld (debug_mark), hl  
2544				endif  
2544				if DEMARK_VERSION = 0  
2544					push af  
2544					ld a, (.dmark)  
2544					ld (debug_mark),a  
2544					ld a, (.dmark+1)  
2544					ld (debug_mark+1),a  
2544					ld a, (.dmark+2)  
2544					ld (debug_mark+2),a  
2544				endif  
2544 18 04			jr .pastdmark  
2546 ..			.dmark: db "MON"  
2549				if DEMARK_VERSION = 1  
2549 00					db 0  
254a				endif  
254a				if DEMARK_VERSION = 1  
254a e1			.pastdmark: pop hl  
254b				endif  
254b				if DEMARK_VERSION = 0  
254b			.pastdmark: pop af  
254b				endif  
254b			endm  
# End of macro DMARK
254b					CALLMONITOR 
254b				if BASE_CPM=1  
254b cd 6b ee				call debug_vector  
254e				endif  
254e				if BASE_KEV=1  
254e					rst 8  
254e				endif  
254e				endm  
# End of macro CALLMONITOR
254e				endif 
254e			;		ld a, 0 
254e			;		ld (os_view_disable), a 
