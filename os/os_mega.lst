1120			StrictStrCmp: 
1120				; Load next chars of each string 
1120 1a				ld a, (de) 
1121 47				ld b, a 
1122 7e				ld a, (hl) 
1123				; Compare 
1123 b8				cp b 
1124				; Return non-zero if chars don't match 
1124 c0				ret nz 
1125				; Check for end of both strings 
1125 fe 00			cp "\0" 
1127				; Return if strings have ended 
1127 c8				ret z 
1128				; Otherwise, advance to next chars 
1128 23				inc hl 
1129 13				inc de 
112a 18 f4			jr StrictStrCmp 
112c			 
