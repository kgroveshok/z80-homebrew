1157 56			      ld    D, (HL) 
1158 e5			      push  HL                      ; Save ptr to next block for later 
1159			 
1159 60			      ld    H, B                    ; Store ptr from next block into freed block 
115a 69			      ld    L, C 
115b 73			      ld    (HL), E 
115c 23			      inc   HL 
115d 72			      ld    (HL), D 
115e			 
115e e1			      pop   HL                      ; Restore ptr to next block 
115f 23			      inc   HL                      ; Load size of next block into DE 
1160 5e			      ld    E, (HL) 
1161 23			      inc   HL 
1162 56			      ld    D, (HL) 
1163 d5			      push  DE                      ; Save next block size for later 
1164			 
1164 60			      ld    H, B                    ; Load size of freed block into HL 
1165 69			      ld    L, C 
1166 23			      inc   HL 
1167 23			      inc   HL 
1168 5e			      ld    E, (HL) 
1169 23			      inc   HL 
116a 56			      ld    D, (HL) 
116b eb			      ex    DE, HL 
