1190			;------------------------------------------------------------------------------ 
1190			;     heap_init                                                               : 
1190			;                                                                             : 
1190			; Description                                                                 : 
1190			;     Initialise the heap and make it ready for malloc and free operations.   : 
1190			;                                                                             : 
1190			;     The heap is maintained as a linked list, starting with an initial       : 
1190			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
1190			;     the first free block in the heap. Each block then points to the next    : 
1190			;     free block within the heap, and the free list ends at the first block   : 
1190			;     with a null pointer to the next free block.                             : 
1190			;                                                                             : 
1190			; Parameters                                                                  : 
1190			;     Inputs are compile-time only. Two defines which specify the starting    : 
1190			;     address of the heap and its size are required, along with a memory      : 
1190			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
1190			;     principally stores a pointer to the first free block in the heap.       : 
1190			;                                                                             : 
1190			; Returns                                                                     : 
1190			;     Nothing                                                                 : 
1190			;------------------------------------------------------------------------------ 
1190			heap_init: 
1190 e5			      push  HL 
1191			 
1191			      ; Initialise free list struct 
1191 21 0e 80		      ld    HL, heap_start 
1194 22 0a 80		      ld    (free_list), HL 
1197 21 00 00		      ld    HL, 0 
119a 22 0c 80		      ld    (free_list+2), HL 
119d			 
119d			      ; Insert first free block at bottom of heap, consumes entire heap 
119d 21 ad f0		      ld    HL, heap_start+heap_size-4 
11a0 22 0e 80		      ld    (heap_start), HL        ; Next block (end of free list) 
11a3 21 9f 70		      ld    HL, heap_size-4 
11a6 22 10 80		      ld    (heap_start+2), HL      ; Block size 
11a9			 
11a9			      ; Insert end of free list block at top of heap - two null words will 
11a9			      ; terminate the free list 
11a9 21 00 00		      ld    HL, 0 
11ac 22 af f0		      ld    (heap_start+heap_size-2), HL 
11af 22 ad f0		      ld    (heap_start+heap_size-4), HL 
11b2			 
11b2 e1			      pop   HL 
11b3			 
11b3 c9			      ret 
11b4			 
11b4			 
11b4			;------------------------------------------------------------------------------ 
11b4			;     malloc                                                                  : 
11b4			;                                                                             : 
11b4			; Description                                                                 : 
11b4			;     Allocates the wanted space from the heap and returns the address of the : 
11b4			;     first useable byte of the allocation.                                   : 
11b4			;                                                                             : 
11b4			;     Allocations can happen in one of two ways:                              : 
11b4			;                                                                             : 
11b4			;     1. A free block may be found which is the exact size wanted. In this    : 
11b4			;        case the block is removed from the free list and retuedn to the      : 
11b4			;        caller.                                                              : 
11b4			;     2. A free block may be found which is larger than the size wanted. In   : 
11b4			;        this case, the larger block is split into two. The first portion of  : 
11b4			;        this block will become the requested space by the malloc call and    : 
11b4			;        is returned to the caller. The second portion becomes a new free     : 
11b4			;        block, and the free list is adjusted to maintain continuity via this : 
11b4			;        newly created block.                                                 : 
11b4			;                                                                             : 
11b4			;     malloc does not set any initial value in the allocated space, the       : 
11b4			;     caller is required to do this as required.                              : 
11b4			;                                                                             : 
11b4			;     This implementation of malloc uses the stack exclusively, and is        : 
11b4			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
11b4			;     advisable to disable interrupts before calling malloc, and recommended  : 
11b4			;     to avoid the use of malloc inside ISRs in general.                      : 
11b4			;                                                                             : 
11b4			;     NOTE: heap_init must be called before malloc and free can be used.      : 
11b4			;                                                                             : 
11b4			; Parameters                                                                  : 
11b4			;     HL  Number of bytes wanted                                              : 
11b4			;                                                                             : 
11b4			; Returns                                                                     : 
11b4			;     HL  Address of the first useable byte of the allocation                 : 
11b4			;                                                                             : 
11b4			; Flags                                                                       : 
11b4			;     Z   Set if the allocation did not succeed, clear otherwise              : 
11b4			;                                                                             : 
11b4			; Stack frame                                                                 : 
11b4			;       |             |                                                       : 
11b4			;       +-------------+                                                       : 
11b4			;       |     BC      |                                                       : 
11b4			;       +-------------+                                                       : 
11b4			;       |     DE      |                                                       : 
11b4			;       +-------------+                                                       : 
11b4			;       |     IX      |                                                       : 
11b4			;       +-------------+                                                       : 
11b4			;       |  prev_free  |                                                       : 
11b4			;   +4  +-------------+                                                       : 
11b4			;       |  this_free  |                                                       : 
11b4			;   +2  +-------------+                                                       : 
11b4			;       |  next_free  |                                                       : 
11b4			;   +0  +-------------+                                                       : 
11b4			;       |             |                                                       : 
11b4			;                                                                             : 
11b4			;------------------------------------------------------------------------------ 
11b4			 
11b4			 
11b4			;malloc: 
11b4			; 
11b4			;	SAVESP ON 1 
11b4			; 
11b4			;	call malloc_code 
11b4			; 
11b4			;	CHECKSP ON 1 
11b4			;	ret 
11b4			 
11b4			 
11b4			malloc: 
11b4 c5			      push  BC 
11b5 d5			      push  DE 
11b6 dd e5		      push  IX 
11b8			if DEBUG_FORTH_MALLOC_HIGH 
11b8			call malloc_guard_entry 
11b8			endif 
11b8			 
11b8					if DEBUG_FORTH_MALLOC 
11b8						DMARK "mal" 
11b8						CALLMONITOR 
11b8					endif 
11b8 7c			      ld    A, H                    ; Exit if no space requested 
11b9 b5			      or    L 
11ba ca 79 12		      jp    Z, malloc_early_exit 
11bd			 
11bd			;inc hl 
11bd			;inc hl 
11bd			;inc hl 
11bd			; 
11bd			;inc hl 
11bd			;inc hl 
11bd			;inc hl 
11bd			;inc hl 
11bd			;inc hl 
11bd			;inc hl 
11bd			;inc hl 
11bd			;inc hl 
11bd			;inc hl 
11bd			 
11bd			 
11bd			 
11bd			 
11bd					if DEBUG_FORTH_MALLOC 
11bd						DMARK "maA" 
11bd						CALLMONITOR 
11bd					endif 
11bd			      ; Set up stack frame 
11bd eb			      ex    DE, HL 
11be 21 fa ff		      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
11c1 39			      add   HL, SP 
11c2 f9			      ld    SP, HL 
11c3 dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
11c7 dd 39		      add   IX, SP 
11c9			 
11c9			      ; Setup initial state 
11c9 21 04 00		      ld    HL, 4                   ; want must also include space used by block struct 
11cc 19			      add   HL, DE 
11cd			 
11cd 44			      ld    B, H                    ; Move want to BC 
11ce 4d			      ld    C, L 
11cf			 
11cf 21 0a 80		      ld    HL, free_list           ; Store prev_free ptr to stack 
11d2 dd 75 04		      ld    (IX+4), L 
11d5 dd 74 05		      ld    (IX+5), H 
11d8			 
11d8 5e			      ld    E, (HL)                 ; Store this_free ptr to stack 
11d9 23			      inc   HL 
11da 56			      ld    D, (HL) 
11db dd 73 02		      ld    (IX+2), E 
11de dd 72 03		      ld    (IX+3), D 
11e1 eb			      ex    DE, HL                  ; this_free ptr into HL 
11e2			 
11e2					if DEBUG_FORTH_MALLOC 
11e2						DMARK "maB" 
11e2						CALLMONITOR 
11e2					endif 
11e2			      ; Loop through free block list to find some space 
11e2			malloc_find_space: 
11e2 5e			      ld    E, (HL)                 ; Load next_free ptr into DE 
11e3 23			      inc   HL 
11e4 56			      ld    D, (HL) 
11e5			 
11e5 7a			      ld    A, D                    ; Check for null next_free ptr - end of free list 
11e6 b3			      or    E 
11e7 ca 73 12		      jp    Z, malloc_no_space 
11ea			 
11ea dd 73 00		      ld    (IX+0), E               ; Store next_free ptr to stack 
11ed dd 72 01		      ld    (IX+1), D 
11f0			 
11f0			      ; Does this block have enough space to make the allocation? 
11f0 23			      inc   HL                      ; Load free block size into DE 
11f1 5e			      ld    E, (HL) 
11f2 23			      inc   HL 
11f3 56			      ld    D, (HL) 
11f4			 
11f4 eb			      ex    DE, HL                  ; Check size of block against want 
11f5 b7			      or    A                       ; Ensure carry flag clear 
11f6 ed 42		      sbc   HL, BC 
11f8 e5			      push  HL                      ; Store the result for later (new block size) 
11f9			 
11f9 ca 48 12		      jp   Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
11fc 30 1b		      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
11fe			 
11fe			      ; this_free block is not big enough, setup ptrs to test next free block 
11fe e1			      pop   HL                      ; Discard previous result 
11ff			 
11ff dd 6e 02		      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
1202 dd 66 03		      ld    H, (IX+3) 
1205 dd 75 04		      ld    (IX+4), L 
1208 dd 74 05		      ld    (IX+5), H 
120b			 
120b dd 6e 00		      ld    L, (IX+0)               ; Move next_free ptr into this_free 
120e dd 66 01		      ld    H, (IX+1) 
1211 dd 75 02		      ld    (IX+2), L 
1214 dd 74 03		      ld    (IX+3), H 
1217			 
1217					if DEBUG_FORTH_MALLOC 
1217						DMARK "MA>" 
1217						CALLMONITOR 
1217					endif 
1217 18 c9		      jr    malloc_find_space 
1219			 
1219			      ; split a bigger block into two - requested size and remaining size 
1219			malloc_alloc_split: 
1219					if DEBUG_FORTH_MALLOC 
1219						DMARK "MAs" 
1219						CALLMONITOR 
1219					endif 
1219 eb			      ex    DE, HL                  ; Calculate address of new free block 
121a 2b			      dec   HL 
121b 2b			      dec   HL 
121c 2b			      dec   HL 
121d 09			      add   HL, BC 
121e			 
121e			      ; Create a new block and point it at next_free 
121e dd 5e 00		      ld    E, (IX+0)               ; Load next_free ptr into DE 
1221 dd 56 01		      ld    D, (IX+1) 
1224			 
1224 73			      ld    (HL), E                 ; Store next_free ptr into new block 
1225 23			      inc   HL 
1226 72			      ld    (HL), D 
1227			 
1227 d1			      pop   DE                      ; Store size of new block into new block 
1228 23			      inc   HL 
1229 73			      ld    (HL), E 
122a 23			      inc   HL 
122b 72			      ld    (HL), D 
122c			 
122c			      ; Update this_free ptr to point to new block 
122c 2b			      dec   HL 
122d 2b			      dec   HL 
122e 2b			      dec   HL 
122f			 
122f dd 5e 02		      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
1232 dd 56 03		      ld    D, (IX+3) 
1235			 
1235 dd 75 02		      ld    (IX+2), L               ; Store new block addr as this_free ptr 
1238 dd 74 03		      ld    (IX+3), H 
123b			 
123b			      ; Modify this_free block to be allocation 
123b eb			      ex    DE, HL 
123c af			      xor   A                       ; Null the next block ptr of allocated block 
123d 77			      ld    (HL), A 
123e 23			      inc   HL 
123f 77			      ld    (HL), A 
1240			 
1240 23			      inc   HL                      ; Store want size into allocated block 
1241 71			      ld    (HL), C 
1242 23			      inc   HL 
1243 70			      ld    (HL), B 
1244 23			      inc   HL 
1245 e5			      push  HL                      ; Address of allocation to return 
1246			 
1246 18 19		      jr    malloc_update_links 
1248			 
1248			malloc_alloc_fit: 
1248 e1			      pop   HL                      ; Dont need new block size, want is exact fit 
1249			 
1249					if DEBUG_FORTH_MALLOC 
1249						DMARK "MAf" 
1249						CALLMONITOR 
1249					endif 
1249			      ; Modify this_free block to be allocation 
1249 eb			      ex    DE, HL 
124a 2b			      dec   HL 
124b 2b			      dec   HL 
124c 2b			      dec   HL 
124d			 
124d af			      xor   A                       ; Null the next block ptr of allocated block 
124e 77			      ld    (HL), A 
124f 23			      inc   HL 
1250 77			      ld    (HL), A 
1251			 
1251 23			      inc   HL                      ; Store address of allocation to return 
1252 23			      inc   HL 
1253 23			      inc   HL 
1254 e5			      push  HL 
1255			 
1255			      ; Copy next_free ptr to this_free, remove allocated block from free list 
1255 dd 6e 00		      ld    L, (IX+0)               ; next_free to HL 
1258 dd 66 01		      ld    H, (IX+1) 
125b			 
125b dd 75 02		      ld    (IX+2), L               ; HL to this_free 
125e dd 74 03		      ld    (IX+3), H 
