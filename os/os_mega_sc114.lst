a563			; | MONITOR ( -- ) Display system breakpoint/monitor | DONE 
a563			; | | At start the current various registers will be displayed with contents. 
a563			; | | Top right corner will show the most recent debug marker seen. 
a563			; | | The bottom of the screen will also show the values of the data stack pointer (DSP) 
a563			; | | and the return stack pointer (RSP). 
a563			; | | Pressing: 
a563			; | |  
a563			; | |    1 - Initial screen 
a563			; | |  
a563			; | |    2 - Display a data dump of HL 
a563			; | |  
a563			; | |    3 - Display a data dump of DE 
a563			; | |  
a563			; | |    4 - Display a data dump of BC 
a563			; | |  
a563			; | |    5 - Display a data dump of HL 
a563			; | |  
a563			; | |    6 - Display a data dump of DSP 
a563			; | |  
a563			; | |    7 - Display a data dump of RSP 
a563			; | |  
a563			; | |    8 - Display a data dump of what is at DSP 
a563			; | |  
a563			; | |    9 - Display a data dump of what is at RSP 
a563			; | |  
a563			; | |    0 - Exit monitor and continue running. This will also enable break points 
a563			; | |  
a563			; | |    * - Disable break points 
a563			; | |  
a563			; | |    # - Enter traditional monitor mode 
a563			; | |  
a563			; | | 
a563			; | | Monitor Mode 
a563			; | | ------------ 
a563			; | | A prompt of '>' will be shown for various commands: 
a563			; | |  
a563			; | |    D xxxx - Display a data dump starting from hex address xxxx 
a563			; | |  
a563			; | |    C - Continue display a data dump from the last set address 
a563			; | |  
a563			; | |    M xxxx - Set start of memory edit at address xx 
a563			; | |  
a563			; | |    U xx - Poke the hex byte xx into the address set by M and increment the address to the next location 
a563			; | |  
a563			; | |    G xxxx - Exec code at specific address 
a563			; | |  
a563			; | |    Q - Return to previous 
a563				if DEBUG_FORTH_WORDS_KEY 
a563					DMARK "MON" 
a563				if DEMARK_VERSION = 1  
a563 e5					push hl  
a564 21 6c a5				ld hl, .dmark  
a567 22 60 ee				ld (debug_mark), hl  
a56a				endif  
a56a				if DEMARK_VERSION = 0  
a56a					push af  
a56a					ld a, (.dmark)  
a56a					ld (debug_mark),a  
a56a					ld a, (.dmark+1)  
a56a					ld (debug_mark+1),a  
a56a					ld a, (.dmark+2)  
a56a					ld (debug_mark+2),a  
a56a				endif  
a56a 18 04			jr .pastdmark  
a56c ..			.dmark: db "MON"  
a56f				if DEMARK_VERSION = 1  
a56f 00					db 0  
a570				endif  
a570				if DEMARK_VERSION = 1  
a570 e1			.pastdmark: pop hl  
a571				endif  
a571				if DEMARK_VERSION = 0  
a571			.pastdmark: pop af  
a571				endif  
a571			endm  
# End of macro DMARK
a571					CALLMONITOR 
a571				if BASE_CPM=1  
a571					call debug_vector  
a571				endif  
a571				if BASE_KEV=1  
a571					rst 8  
a571				endif  
a571				endm  
# End of macro CALLMONITOR
a571				endif 
a571			;		ld a, 0 
