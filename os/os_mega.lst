53af			; | VAR ( u1 -- )  Get the address of the (word) variable referenced on TOS  | DONE 
53af			; | 
53af			; | | The variable name should consist of a single letter (a-z). e.g. "a" 
53af			; | |  
53af			; | | e.g. 
53af			; | |         #30 a var ! 
53af			; | |         a var @ . 
53af			; | |   
53af			; | |     Displays the number 30 
53af			; | | 
53af			; | | Each variable pointer is a word so can use for any words that use that:  
53af			; | |  
53af			; | | e.g. 
53af			; | |  
53af			; | |         #30 a var 2! 
53af			; | |         a var 2@ . 
53af			; | |   
53af			; | |     Displays the number 30 
53af			; | |  
53af			; | | > [!NOTE]  
53af			; ! | > If a full string is passed then only the first char is looked at 
53af			; | | > Any other char could exceed bounds checks!  
53af			; | | > 
53af			; | | > Each variable location follows the previous. Watch you don't clobber any others. 
53af			 
53af					if DEBUG_FORTH_WORDS_KEY 
53af						DMARK "VAR" 
53af				if DEMARK_VERSION = 1  
53af e5					push hl  
53b0 21 b8 53				ld hl, .dmark  
53b3 22 9b fd				ld (debug_mark), hl  
53b6				endif  
