d5b6			 
d5b6			 
d5b6 0e 02			ld c, 2 
d5b8				;ld de, .cls 
d5b8 3e 5b			ld a, '[' 
d5ba f7				rst $30 
d5bb 0e 02			ld c, 2 
d5bd				;ld de, .cls 
d5bd 3e 32			ld a, '2' 
d5bf f7				rst $30 
d5c0 0e 02			ld c, 2 
d5c2				;ld de, .cls 
