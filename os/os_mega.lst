2101			; Stack operations for v5 parser on wards 
2101			; * DATA stack 
2101			; * LOOP stack 
2101			; * RETURN stack 
2101			 
2101			 
2101			 
2101			FORTH_CHK_DSP_UNDER: macro 
2101				push hl 
2101				push de 
2101				ld hl,(cli_data_sp) 
2101				ld de, cli_data_stack 
2101				call cmp16 
2101				jp c, fault_dsp_under 
2101				pop de 
2101				pop hl 
2101				endm 
2101			 
2101			 
2101			FORTH_CHK_RSP_UNDER: macro 
2101				push hl 
2101				push de 
2101				ld hl,(cli_ret_sp) 
2101				ld de, cli_ret_stack 
2101				call cmp16 
2101				jp c, fault_rsp_under 
2101				pop de 
2101				pop hl 
2101				endm 
2101			 
2101			FORTH_CHK_LOOP_UNDER: macro 
2101				push hl 
2101				push de 
2101				ld hl,(cli_loop_sp) 
2101				ld de, cli_loop_stack 
2101				call cmp16 
2101				jp c, fault_loop_under 
2101				pop de 
2101				pop hl 
2101				endm 
2101			 
2101			FORTH_ERR_TOS_NOTSTR: macro 
2101				; TOSO might need more for checks when used 
2101				push af 
2101				ld a,(hl) 
2101				cp DS_TYPE_STR 
2101				jp nz, type_faultn   
2101				pop af 
2101				endm 
2101			 
2101			FORTH_ERR_TOS_NOTNUM: macro 
2101				push af 
2101				ld a,(hl) 
2101				cp DS_TYPE_INUM 
2101				jp nz, type_faultn   
2101				pop af 
2101				endm 
2101			 
2101			 
2101			; increase data stack pointer and save hl to it 
