901e			;------------------------------------------------------------------------------ 
901e			;     heap_init                                                               : 
901e			;                                                                             : 
901e			; Description                                                                 : 
901e			;     Initialise the heap and make it ready for malloc and free operations.   : 
901e			;                                                                             : 
901e			;     The heap is maintained as a linked list, starting with an initial       : 
901e			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
901e			;     the first free block in the heap. Each block then points to the next    : 
901e			;     free block within the heap, and the free list ends at the first block   : 
901e			;     with a null pointer to the next free block.                             : 
901e			;                                                                             : 
901e			; Parameters                                                                  : 
901e			;     Inputs are compile-time only. Two defines which specify the starting    : 
901e			;     address of the heap and its size are required, along with a memory      : 
901e			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
901e			;     principally stores a pointer to the first free block in the heap.       : 
901e			;                                                                             : 
901e			; Returns                                                                     : 
901e			;     Nothing                                                                 : 
901e			;------------------------------------------------------------------------------ 
901e			heap_init: 
901e			      push  HL 
901e			 
901e			      ; Initialise free list struct 
901e			      ld    HL, heap_start 
901e			      ld    (free_list), HL 
901e			      ld    HL, 0 
901e			      ld    (free_list+2), HL 
901e			 
901e			      ; Insert first free block at bottom of heap, consumes entire heap 
901e			      ld    HL, heap_start+heap_size-4 
901e			      ld    (heap_start), HL        ; Next block (end of free list) 
901e			      ld    HL, heap_size-4 
901e			      ld    (heap_start+2), HL      ; Block size 
901e			 
901e			      ; Insert end of free list block at top of heap - two null words will 
901e			      ; terminate the free list 
901e			      ld    HL, 0 
901e			      ld    (heap_start+heap_size-2), HL 
901e			      ld    (heap_start+heap_size-4), HL 
901e			 
901e			      pop   HL 
901e			 
901e			      ret 
901e			 
901e			 
901e			;------------------------------------------------------------------------------ 
901e			;     malloc                                                                  : 
901e			;                                                                             : 
901e			; Description                                                                 : 
901e			;     Allocates the wanted space from the heap and returns the address of the : 
901e			;     first useable byte of the allocation.                                   : 
901e			;                                                                             : 
901e			;     Allocations can happen in one of two ways:                              : 
901e			;                                                                             : 
901e			;     1. A free block may be found which is the exact size wanted. In this    : 
901e			;        case the block is removed from the free list and retuedn to the      : 
901e			;        caller.                                                              : 
901e			;     2. A free block may be found which is larger than the size wanted. In   : 
901e			;        this case, the larger block is split into two. The first portion of  : 
901e			;        this block will become the requested space by the malloc call and    : 
901e			;        is returned to the caller. The second portion becomes a new free     : 
901e			;        block, and the free list is adjusted to maintain continuity via this : 
901e			;        newly created block.                                                 : 
901e			;                                                                             : 
901e			;     malloc does not set any initial value in the allocated space, the       : 
901e			;     caller is required to do this as required.                              : 
901e			;                                                                             : 
901e			;     This implementation of malloc uses the stack exclusively, and is        : 
901e			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
901e			;     advisable to disable interrupts before calling malloc, and recommended  : 
901e			;     to avoid the use of malloc inside ISRs in general.                      : 
901e			;                                                                             : 
901e			;     NOTE: heap_init must be called before malloc and free can be used.      : 
901e			;                                                                             : 
901e			; Parameters                                                                  : 
901e			;     HL  Number of bytes wanted                                              : 
901e			;                                                                             : 
901e			; Returns                                                                     : 
901e			;     HL  Address of the first useable byte of the allocation                 : 
901e			;                                                                             : 
901e			; Flags                                                                       : 
901e			;     Z   Set if the allocation did not succeed, clear otherwise              : 
901e			;                                                                             : 
901e			; Stack frame                                                                 : 
901e			;       |             |                                                       : 
901e			;       +-------------+                                                       : 
901e			;       |     BC      |                                                       : 
901e			;       +-------------+                                                       : 
901e			;       |     DE      |                                                       : 
901e			;       +-------------+                                                       : 
901e			;       |     IX      |                                                       : 
901e			;       +-------------+                                                       : 
901e			;       |  prev_free  |                                                       : 
901e			;   +4  +-------------+                                                       : 
901e			;       |  this_free  |                                                       : 
901e			;   +2  +-------------+                                                       : 
901e			;       |  next_free  |                                                       : 
901e			;   +0  +-------------+                                                       : 
901e			;       |             |                                                       : 
901e			;                                                                             : 
901e			;------------------------------------------------------------------------------ 
901e			malloc: 
901e			      push  BC 
901e			      push  DE 
901e			      push  IX 
901e			 
901e			      ld    A, H                    ; Exit if no space requested 
901e			      or    L 
901e			      jp    Z, malloc_early_exit 
901e			 
901e			      ; Set up stack frame 
901e			      ex    DE, HL 
901e			      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
901e			      add   HL, SP 
901e			      ld    SP, HL 
901e			      ld    IX, 0                   ; Use IX as a frame pointer 
901e			      add   IX, SP 
901e			 
901e			      ; Setup initial state 
901e			      ld    HL, 4                   ; want must also include space used by block struct 
901e			      add   HL, DE 
901e			 
901e			      ld    B, H                    ; Move want to BC 
901e			      ld    C, L 
901e			 
901e			      ld    HL, free_list           ; Store prev_free ptr to stack 
901e			      ld    (IX+4), L 
901e			      ld    (IX+5), H 
901e			 
901e			      ld    E, (HL)                 ; Store this_free ptr to stack 
901e			      inc   HL 
901e			      ld    D, (HL) 
901e			      ld    (IX+2), E 
901e			      ld    (IX+3), D 
901e			      ex    DE, HL                  ; this_free ptr into HL 
901e			 
901e			      ; Loop through free block list to find some space 
901e			malloc_find_space: 
901e			      ld    E, (HL)                 ; Load next_free ptr into DE 
901e			      inc   HL 
901e			      ld    D, (HL) 
901e			 
901e			      ld    A, D                    ; Check for null next_free ptr - end of free list 
901e			      or    E 
901e			      jp    Z, malloc_no_space 
901e			 
901e			      ld    (IX+0), E               ; Store next_free ptr to stack 
901e			      ld    (IX+1), D 
901e			 
901e			      ; Does this block have enough space to make the allocation? 
901e			      inc   HL                      ; Load free block size into DE 
901e			      ld    E, (HL) 
901e			      inc   HL 
901e			      ld    D, (HL) 
901e			 
901e			      ex    DE, HL                  ; Check size of block against want 
901e			      or    A                       ; Ensure carry flag clear 
901e			      sbc   HL, BC 
901e			      push  HL                      ; Store the result for later (new block size) 
901e			 
901e			      jr    Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
901e			      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
901e			 
901e			      ; this_free block is not big enough, setup ptrs to test next free block 
901e			      pop   HL                      ; Discard previous result 
901e			 
901e			      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
901e			      ld    H, (IX+3) 
901e			      ld    (IX+4), L 
901e			      ld    (IX+5), H 
901e			 
901e			      ld    L, (IX+0)               ; Move next_free ptr into this_free 
901e			      ld    H, (IX+1) 
901e			      ld    (IX+2), L 
901e			      ld    (IX+3), H 
901e			 
901e			      jr    malloc_find_space 
901e			 
901e			      ; split a bigger block into two - requested size and remaining size 
901e			malloc_alloc_split: 
901e			      ex    DE, HL                  ; Calculate address of new free block 
901e			      dec   HL 
901e			      dec   HL 
901e			      dec   HL 
901e			      add   HL, BC 
901e			 
901e			      ; Create a new block and point it at next_free 
901e			      ld    E, (IX+0)               ; Load next_free ptr into DE 
901e			      ld    D, (IX+1) 
901e			 
901e			      ld    (HL), E                 ; Store next_free ptr into new block 
901e			      inc   HL 
901e			      ld    (HL), D 
901e			 
901e			      pop   DE                      ; Store size of new block into new block 
901e			      inc   HL 
901e			      ld    (HL), E 
901e			      inc   HL 
901e			      ld    (HL), D 
901e			 
901e			      ; Update this_free ptr to point to new block 
901e			      dec   HL 
901e			      dec   HL 
901e			      dec   HL 
901e			 
901e			      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
901e			      ld    D, (IX+3) 
901e			 
901e			      ld    (IX+2), L               ; Store new block addr as this_free ptr 
901e			      ld    (IX+3), H 
901e			 
901e			      ; Modify this_free block to be allocation 
901e			      ex    DE, HL 
901e			      xor   A                       ; Null the next block ptr of allocated block 
901e			      ld    (HL), A 
901e			      inc   HL 
901e			      ld    (HL), A 
901e			 
901e			      inc   HL                      ; Store want size into allocated block 
901e			      ld    (HL), C 
901e			      inc   HL 
901e			      ld    (HL), B 
901e			      inc   HL 
901e			      push  HL                      ; Address of allocation to return 
901e			 
901e			      jr    malloc_update_links 
901e			 
901e			malloc_alloc_fit: 
901e			      pop   HL                      ; Dont need new block size, want is exact fit 
901e			 
901e			      ; Modify this_free block to be allocation 
901e			      ex    DE, HL 
901e			      dec   HL 
901e			      dec   HL 
901e			      dec   HL 
901e			 
901e			      xor   A                       ; Null the next block ptr of allocated block 
901e			      ld    (HL), A 
901e			      inc   HL 
901e			      ld    (HL), A 
901e			 
901e			      inc   HL                      ; Store address of allocation to return 
901e			      inc   HL 
901e			      inc   HL 
901e			      push  HL 
901e			 
901e			      ; Copy next_free ptr to this_free, remove allocated block from free list 
901e			      ld    L, (IX+0)               ; next_free to HL 
901e			      ld    H, (IX+1) 
901e			 
901e			      ld    (IX+2), L               ; HL to this_free 
901e			      ld    (IX+3), H 
901e			 
901e			 
901e			malloc_update_links: 
901e			      ; Update prev_free ptr to point to this_free 
901e			      ld    L, (IX+4)               ; prev_free ptr to HL 
901e			      ld    H, (IX+5) 
901e			 
901e			      ld    E, (IX+2)               ; this_free ptr to DE 
901e			      ld    D, (IX+3) 
901e			 
901e			      ld    (HL), E                 ; this_free ptr into prev_free 
901e			      inc   HL 
901e			      ld    (HL), D 
901e			 
901e			      ; Clear the Z flag to indicate successful allocation 
901e			      ld    A, D 
901e			      or    E 
901e			 
901e			      pop   DE                      ; Address of allocation 
901e			 
901e			malloc_no_space: 
901e			      ld    HL, 6                   ; Clean up stack frame 
901e			      add   HL, SP 
901e			      ld    SP, HL 
901e			 
901e			      ex    DE, HL                  ; Alloc addr into HL for return 
901e			 
901e			malloc_early_exit: 
901e			      pop   IX 
901e			      pop   DE 
901e			      pop   BC 
901e			 
901e			      ret 
901e			 
901e			 
901e			;------------------------------------------------------------------------------ 
901e			;     free                                                                    : 
901e			;                                                                             : 
901e			; Description                                                                 : 
901e			;     Return the space pointed to by HL to the heap. HL must be an address as : 
901e			;     returned by malloc, otherwise the behaviour is undefined.               : 
901e			;                                                                             : 
901e			;     Where possible, directly adjacent free blocks will be merged together   : 
901e			;     into larger blocks to help ensure that the heap does not become         : 
901e			;     excessively fragmented.                                                 : 
901e			;                                                                             : 
901e			;     free does not clear or set any other value into the freed space, and    : 
901e			;     therefore its contents may be visible through subsequent malloc's. The  : 
901e			;     caller should clear the freed space as required.                        : 
901e			;                                                                             : 
901e			;     This implementation of free uses the stack exclusively, and is          : 
901e			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
901e			;     advisable to disable interrupts before calling free, and recommended    : 
901e			;     to avoid the use of free inside ISRs in general.                        : 
901e			;                                                                             : 
901e			;     NOTE: heap_init must be called before malloc and free can be used.      : 
901e			;                                                                             : 
901e			; Parameters                                                                  : 
901e			;     HL  Pointer to address of first byte of allocation to be freed          : 
901e			;                                                                             : 
901e			; Returns                                                                     : 
901e			;     Nothing                                                                 : 
901e			;                                                                             : 
901e			; Stack frame                                                                 : 
901e			;       |             |                                                       : 
901e			;       +-------------+                                                       : 
901e			;       |     BC      |                                                       : 
901e			;       +-------------+                                                       : 
901e			;       |     DE      |                                                       : 
901e			;       +-------------+                                                       : 
901e			;       |     IX      |                                                       : 
901e			;       +-------------+                                                       : 
901e			;       |  prev_free  |                                                       : 
901e			;   +2  +-------------+                                                       : 
901e			;       |  next_free  |                                                       : 
901e			;   +0  +-------------+                                                       : 
901e			;       |             |                                                       : 
901e			;                                                                             : 
901e			;------------------------------------------------------------------------------ 
901e			free: 
901e			      push  BC 
901e			      push  DE 
901e			      push  IX 
901e			 
901e			      ld    A, H                    ; Exit if ptr is null 
901e			      or    L 
901e			      jp    Z, free_early_exit 
901e			 
901e			      ; Set up stack frame 
901e			      ex    DE, HL 
901e			      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
901e			      add   HL, SP 
901e			      ld    SP, HL 
901e			      ld    IX, 0                   ; Use IX as a frame pointer 
901e			      add   IX, SP 
901e			 
901e			      ; The address in HL points to the start of the useable allocated space, 
901e			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
901e			      ; address of the block itself. 
901e			      ex    DE, HL 
901e			      ld    DE, -4 
901e			      add   HL, DE 
901e			 
901e			      ; An allocated block must have a null next block pointer in it 
901e			      ld    A, (HL) 
901e			      inc   HL 
901e			      or    (HL) 
901e			      jp    NZ, free_done 
901e			 
901e			      dec   HL 
901e			 
901e			      ld    B, H                    ; Copy HL to BC 
901e			      ld    C, L 
901e			 
901e			      ; Loop through the free list to find the first block with an address 
901e			      ; higher than the block being freed 
901e			      ld    HL, free_list 
901e			 
901e			free_find_higher_block: 
901e			      ld    E, (HL)                 ; Load next ptr from free block 
901e			      inc   HL 
901e			      ld    D, (HL) 
901e			      dec   HL 
901e			 
901e			      ld    (IX+0), E               ; Save ptr to next free block 
901e			      ld    (IX+1), D 
901e			      ld    (IX+2), L               ; Save ptr to prev free block 
901e			      ld    (IX+3), H 
901e			 
901e			      ld    A, B                    ; Check if DE is greater than BC 
901e			      cp    D                       ; Compare MSB first 
901e			      jr    Z, $+4                  ; MSB the same, compare LSB 
901e			      jr    NC, free_find_higher_block_skip 
901e			      ld    A, C 
901e			      cp    E                       ; Then compare LSB 
901e			      jr    C, free_found_higher_block 
901e			 
901e			free_find_higher_block_skip: 
901e			      ld    A, D                    ; Reached the end of the free list? 
901e			      or    E 
901e			      jp    Z, free_done 
901e			 
901e			      ex    DE, HL 
901e			 
901e			      jr    free_find_higher_block 
901e			 
901e			free_found_higher_block: 
901e			      ; Insert freed block between prev and next free blocks 
901e			      ld    (HL), C                 ; Point prev free block to freed block 
901e			      inc   HL 
901e			      ld    (HL), B 
901e			 
901e			      ld    H, B                    ; Point freed block at next free block 
901e			      ld    L, C 
901e			      ld    (HL), E 
901e			      inc   HL 
901e			      ld    (HL), D 
901e			 
901e			      ; Check if the freed block is adjacent to the next free block 
901e			      inc   HL                      ; Load size of freed block into HL 
901e			      ld    E, (HL) 
901e			      inc   HL 
901e			      ld    D, (HL) 
901e			      ex    DE, HL 
901e			 
901e			      add   HL, BC                  ; Add addr of freed block and its size 
901e			 
901e			      ld    E, (IX+0)               ; Load addr of next free block into DE 
901e			      ld    D, (IX+1) 
901e			 
901e			      or    A                       ; Clear the carry flag 
901e			      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
901e			      jr    NZ, free_check_adjacent_to_prev 
901e			 
901e			      ; Freed block is adjacent to next, merge into one bigger block 
901e			      ex    DE, HL                  ; Load next ptr from next block into DE 
901e			      ld    E, (HL) 
901e			      inc   HL 
901e			      ld    D, (HL) 
901e			      push  HL                      ; Save ptr to next block for later 
901e			 
901e			      ld    H, B                    ; Store ptr from next block into freed block 
901e			      ld    L, C 
901e			      ld    (HL), E 
901e			      inc   HL 
901e			      ld    (HL), D 
901e			 
901e			      pop   HL                      ; Restore ptr to next block 
901e			      inc   HL                      ; Load size of next block into DE 
901e			      ld    E, (HL) 
901e			      inc   HL 
901e			      ld    D, (HL) 
901e			      push  DE                      ; Save next block size for later 
901e			 
901e			      ld    H, B                    ; Load size of freed block into HL 
901e			      ld    L, C 
901e			      inc   HL 
901e			      inc   HL 
901e			      ld    E, (HL) 
901e			      inc   HL 
901e			      ld    D, (HL) 
901e			      ex    DE, HL 
901e			 
901e			      pop   DE                      ; Restore size of next block 
901e			      add   HL, DE                  ; Add sizes of both blocks 
901e			      ex    DE, HL 
901e			 
901e			      ld    H, B                    ; Store new bigger size into freed block 
901e			      ld    L, C 
901e			      inc   HL 
901e			      inc   HL 
901e			      ld    (HL), E 
901e			      inc   HL 
901e			      ld    (HL), D 
901e			 
901e			free_check_adjacent_to_prev: 
901e			      ; Check if the freed block is adjacent to the prev free block 
901e			      ld    L, (IX+2)               ; Prev free block ptr into HL 
901e			      ld    H, (IX+3) 
901e			 
901e			      inc   HL                      ; Size of prev free block into DE 
901e			      inc   HL 
901e			      ld    E, (HL) 
901e			      inc   HL 
901e			      ld    D, (HL) 
901e			      dec   HL 
901e			      dec   HL 
901e			      dec   HL 
901e			 
901e			      add   HL, DE                  ; Add prev block addr and size 
901e			 
901e			      or    A                       ; Clear the carry flag 
901e			      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
901e			      jr    NZ, free_done 
901e			 
901e			      ; Freed block is adjacent to prev, merge into one bigger block 
901e			      ld    H, B                    ; Load next ptr from freed block into DE 
901e			      ld    L, C 
901e			      ld    E, (HL) 
901e			      inc   HL 
901e			      ld    D, (HL) 
901e			      push  HL                      ; Save freed block ptr for later 
901e			 
901e			      ld    L, (IX+2)               ; Store freed block ptr into prev block 
901e			      ld    H, (IX+3) 
901e			      ld    (HL), E 
901e			      inc   HL 
901e			      ld    (HL), D 
901e			 
901e			      pop   HL                      ; Restore freed block ptr 
901e			      inc   HL                      ; Load size of freed block into DE 
901e			      ld    E, (HL) 
901e			      inc   HL 
901e			      ld    D, (HL) 
901e			      push  DE                      ; Save freed block size for later 
901e			 
901e			      ld    L, (IX+2)               ; Load size of prev block into DE 
901e			      ld    H, (IX+3) 
901e			      inc   HL 
901e			      inc   HL 
901e			      ld    E, (HL) 
901e			      inc   HL 
901e			      ld    D, (HL) 
901e			 
901e			      pop   HL                      ; Add sizes of both blocks 
901e			      add   HL, DE 
901e			      ex    DE, HL 
901e			 
901e			      ld    L, (IX+2)               ; Store new bigger size into prev block 
901e			      ld    H, (IX+3) 
901e			      inc   HL 
901e			      inc   HL 
901e			      ld    (HL), E 
901e			      inc   HL 
901e			      ld    (HL), D 
901e			 
901e			free_done: 
901e			      ld    HL, 4                   ; Clean up stack frame 
901e			      add   HL, SP 
901e			      ld    SP, HL 
901e			 
901e			free_early_exit: 
901e			      pop   IX 
901e			      pop   DE 
901e			      pop   BC 
901e			 
901e			      ret 
901e			 
901e			 
901e			;      .org 0x8000 
901e			; 
901e			;free_list         .dw   0     ; Block struct for start of free list (MUST be 4 bytes) 
901e			 ;                 .dw   0 
901e			 
901e			endif 
