121a			 
121a			;------------------------------------------------------------------------------ 
121a			;     free                                                                    : 
121a			;                                                                             : 
121a			; Description                                                                 : 
121a			;     Return the space pointed to by HL to the heap. HL must be an address as : 
121a			;     returned by malloc, otherwise the behaviour is undefined.               : 
121a			;                                                                             : 
121a			;     Where possible, directly adjacent free blocks will be merged together   : 
121a			;     into larger blocks to help ensure that the heap does not become         : 
121a			;     excessively fragmented.                                                 : 
121a			;                                                                             : 
121a			;     free does not clear or set any other value into the freed space, and    : 
121a			;     therefore its contents may be visible through subsequent malloc's. The  : 
121a			;     caller should clear the freed space as required.                        : 
121a			;                                                                             : 
121a			;     This implementation of free uses the stack exclusively, and is          : 
121a			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
121a			;     advisable to disable interrupts before calling free, and recommended    : 
121a			;     to avoid the use of free inside ISRs in general.                        : 
121a			;                                                                             : 
121a			;     NOTE: heap_init must be called before malloc and free can be used.      : 
121a			;                                                                             : 
121a			; Parameters                                                                  : 
121a			;     HL  Pointer to address of first byte of allocation to be freed          : 
121a			;                                                                             : 
121a			; Returns                                                                     : 
121a			;     Nothing                                                                 : 
121a			;                                                                             : 
121a			; Stack frame                                                                 : 
121a			;       |             |                                                       : 
121a			;       +-------------+                                                       : 
121a			;       |     BC      |                                                       : 
121a			;       +-------------+                                                       : 
121a			;       |     DE      |                                                       : 
121a			;       +-------------+                                                       : 
121a			;       |     IX      |                                                       : 
121a			;       +-------------+                                                       : 
121a			;       |  prev_free  |                                                       : 
121a			;   +2  +-------------+                                                       : 
121a			;       |  next_free  |                                                       : 
121a			;   +0  +-------------+                                                       : 
121a			;       |             |                                                       : 
121a			;                                                                             : 
121a			;------------------------------------------------------------------------------ 
121a			free: 
121a c5			      push  BC 
121b d5			      push  DE 
121c dd e5		      push  IX 
121e			 
121e 7c			      ld    A, H                    ; Exit if ptr is null 
121f b5			      or    L 
1220 ca e4 12		      jp    Z, free_early_exit 
1223			 
1223			      ; Set up stack frame 
1223 eb			      ex    DE, HL 
1224 21 fc ff		      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
1227 39			      add   HL, SP 
1228 f9			      ld    SP, HL 
1229 dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
122d dd 39		      add   IX, SP 
122f			 
122f			      ; The address in HL points to the start of the useable allocated space, 
122f			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
122f			      ; address of the block itself. 
122f eb			      ex    DE, HL 
1230 11 fc ff		      ld    DE, -4 
1233 19			      add   HL, DE 
1234			 
1234			      ; An allocated block must have a null next block pointer in it 
1234 7e			      ld    A, (HL) 
1235 23			      inc   HL 
1236 b6			      or    (HL) 
1237 c2 df 12		      jp    NZ, free_done 
123a			 
123a 2b			      dec   HL 
123b			 
123b 44			      ld    B, H                    ; Copy HL to BC 
123c 4d			      ld    C, L 
123d			 
123d			      ; Loop through the free list to find the first block with an address 
123d			      ; higher than the block being freed 
123d 21 0a 80		      ld    HL, free_list 
1240			 
1240			free_find_higher_block: 
1240 5e			      ld    E, (HL)                 ; Load next ptr from free block 
1241 23			      inc   HL 
1242 56			      ld    D, (HL) 
1243 2b			      dec   HL 
1244			 
1244 dd 73 00		      ld    (IX+0), E               ; Save ptr to next free block 
1247 dd 72 01		      ld    (IX+1), D 
124a dd 75 02		      ld    (IX+2), L               ; Save ptr to prev free block 
124d dd 74 03		      ld    (IX+3), H 
1250			 
1250 78			      ld    A, B                    ; Check if DE is greater than BC 
1251 ba			      cp    D                       ; Compare MSB first 
1252 28 02		      jr    Z, $+4                  ; MSB the same, compare LSB 
1254 30 04		      jr    NC, free_find_higher_block_skip 
1256 79			      ld    A, C 
1257 bb			      cp    E                       ; Then compare LSB 
1258 38 08		      jr    C, free_found_higher_block 
125a			 
125a			free_find_higher_block_skip: 
125a 7a			      ld    A, D                    ; Reached the end of the free list? 
125b b3			      or    E 
125c ca df 12		      jp    Z, free_done 
125f			 
125f eb			      ex    DE, HL 
1260			 
1260 18 de		      jr    free_find_higher_block 
1262			 
1262			free_found_higher_block: 
1262			      ; Insert freed block between prev and next free blocks 
1262 71			      ld    (HL), C                 ; Point prev free block to freed block 
1263 23			      inc   HL 
1264 70			      ld    (HL), B 
1265			 
1265 60			      ld    H, B                    ; Point freed block at next free block 
1266 69			      ld    L, C 
1267 73			      ld    (HL), E 
1268 23			      inc   HL 
1269 72			      ld    (HL), D 
126a			 
126a			      ; Check if the freed block is adjacent to the next free block 
126a 23			      inc   HL                      ; Load size of freed block into HL 
126b 5e			      ld    E, (HL) 
126c 23			      inc   HL 
126d 56			      ld    D, (HL) 
126e eb			      ex    DE, HL 
126f			 
126f 09			      add   HL, BC                  ; Add addr of freed block and its size 
1270			 
1270 dd 5e 00		      ld    E, (IX+0)               ; Load addr of next free block into DE 
1273 dd 56 01		      ld    D, (IX+1) 
1276			 
1276 b7			      or    A                       ; Clear the carry flag 
1277 ed 52		      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
1279 20 22		      jr    NZ, free_check_adjacent_to_prev 
127b			 
127b			      ; Freed block is adjacent to next, merge into one bigger block 
127b eb			      ex    DE, HL                  ; Load next ptr from next block into DE 
127c 5e			      ld    E, (HL) 
127d 23			      inc   HL 
127e 56			      ld    D, (HL) 
127f e5			      push  HL                      ; Save ptr to next block for later 
1280			 
1280 60			      ld    H, B                    ; Store ptr from next block into freed block 
1281 69			      ld    L, C 
1282 73			      ld    (HL), E 
1283 23			      inc   HL 
1284 72			      ld    (HL), D 
1285			 
1285 e1			      pop   HL                      ; Restore ptr to next block 
1286 23			      inc   HL                      ; Load size of next block into DE 
1287 5e			      ld    E, (HL) 
1288 23			      inc   HL 
1289 56			      ld    D, (HL) 
128a d5			      push  DE                      ; Save next block size for later 
128b			 
128b 60			      ld    H, B                    ; Load size of freed block into HL 
128c 69			      ld    L, C 
128d 23			      inc   HL 
128e 23			      inc   HL 
128f 5e			      ld    E, (HL) 
1290 23			      inc   HL 
1291 56			      ld    D, (HL) 
1292 eb			      ex    DE, HL 
1293			 
1293 d1			      pop   DE                      ; Restore size of next block 
1294 19			      add   HL, DE                  ; Add sizes of both blocks 
1295 eb			      ex    DE, HL 
1296			 
1296 60			      ld    H, B                    ; Store new bigger size into freed block 
1297 69			      ld    L, C 
1298 23			      inc   HL 
1299 23			      inc   HL 
129a 73			      ld    (HL), E 
129b 23			      inc   HL 
129c 72			      ld    (HL), D 
129d			 
129d			free_check_adjacent_to_prev: 
129d			      ; Check if the freed block is adjacent to the prev free block 
129d dd 6e 02		      ld    L, (IX+2)               ; Prev free block ptr into HL 
12a0 dd 66 03		      ld    H, (IX+3) 
12a3			 
12a3 23			      inc   HL                      ; Size of prev free block into DE 
12a4 23			      inc   HL 
12a5 5e			      ld    E, (HL) 
12a6 23			      inc   HL 
12a7 56			      ld    D, (HL) 
12a8 2b			      dec   HL 
12a9 2b			      dec   HL 
12aa 2b			      dec   HL 
12ab			 
12ab 19			      add   HL, DE                  ; Add prev block addr and size 
12ac			 
12ac b7			      or    A                       ; Clear the carry flag 
12ad ed 42		      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
12af 20 2e		      jr    NZ, free_done 
12b1			 
12b1			      ; Freed block is adjacent to prev, merge into one bigger block 
12b1 60			      ld    H, B                    ; Load next ptr from freed block into DE 
12b2 69			      ld    L, C 
12b3 5e			      ld    E, (HL) 
12b4 23			      inc   HL 
12b5 56			      ld    D, (HL) 
12b6 e5			      push  HL                      ; Save freed block ptr for later 
12b7			 
12b7 dd 6e 02		      ld    L, (IX+2)               ; Store freed block ptr into prev block 
12ba dd 66 03		      ld    H, (IX+3) 
12bd 73			      ld    (HL), E 
12be 23			      inc   HL 
12bf 72			      ld    (HL), D 
12c0			 
12c0 e1			      pop   HL                      ; Restore freed block ptr 
12c1 23			      inc   HL                      ; Load size of freed block into DE 
12c2 5e			      ld    E, (HL) 
12c3 23			      inc   HL 
12c4 56			      ld    D, (HL) 
12c5 d5			      push  DE                      ; Save freed block size for later 
12c6			 
12c6 dd 6e 02		      ld    L, (IX+2)               ; Load size of prev block into DE 
12c9 dd 66 03		      ld    H, (IX+3) 
12cc 23			      inc   HL 
12cd 23			      inc   HL 
12ce 5e			      ld    E, (HL) 
12cf 23			      inc   HL 
12d0 56			      ld    D, (HL) 
12d1			 
12d1 e1			      pop   HL                      ; Add sizes of both blocks 
12d2 19			      add   HL, DE 
12d3 eb			      ex    DE, HL 
12d4			 
12d4 dd 6e 02		      ld    L, (IX+2)               ; Store new bigger size into prev block 
12d7 dd 66 03		      ld    H, (IX+3) 
12da 23			      inc   HL 
12db 23			      inc   HL 
12dc 73			      ld    (HL), E 
12dd 23			      inc   HL 
12de 72			      ld    (HL), D 
12df			 
12df			free_done: 
12df 21 04 00		      ld    HL, 4                   ; Clean up stack frame 
12e2 39			      add   HL, SP 
12e3 f9			      ld    SP, HL 
12e4			 
12e4			free_early_exit: 
12e4 dd e1		      pop   IX 
12e6 d1			      pop   DE 
12e7 c1			      pop   BC 
12e8			 
12e8 c9			      ret 
12e9			 
