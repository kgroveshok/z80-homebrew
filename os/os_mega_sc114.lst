d5a1 f7				rst $30 
d5a2 c1				pop bc 
d5a3			 
d5a3 c9				ret 
d5a4			 
d5a4			; output char at pos 
d5a4			fLCD_Data: 
d5a4			      ;  out (SC114_SIO_1_OUT),a 
d5a4 c5				push bc 
d5a5 0e 02			ld c, $02 
d5a7 f7				rst $30 
d5a8 c1				pop bc 
d5a9			 
d5a9 c9				ret 
d5aa			 
d5aa			; ascii cls  
d5aa			 
d5aa 1b 5b 48 00	.cls:   db 27, '[', 'H', 0 
d5ae			 
d5ae			; write the frame buffer given in hl to hardware  
d5ae			write_display: 
d5ae			 
d5ae			API: equ 0 
d5ae			 
d5ae			if API 
d5ae				push bc 
d5ae				ld b, 4 
d5ae			 
d5ae			        ld (display_write_tmp), hl 	  
d5ae			 
d5ae				; clear and home cursor 
d5ae			 
d5ae				ld c, 6 
d5ae				ld de, .cls 
d5ae				rst $30 
d5ae			 
d5ae			 
d5ae			.writeln: 
d5ae			 
d5ae				ld de, (display_write_tmp) 
d5ae				ld c, 6 
d5ae				rst $30 
d5ae				ld c, 7 
d5ae				rst $30 
d5ae			 
d5ae				ld hl, (display_write_tmp) 
d5ae				ld de, display_cols 
d5ae				add hl,de 
d5ae				ld (display_write_tmp),hl 
d5ae			 
d5ae				djnz  .writeln 
d5ae			 
d5ae				pop bc 
d5ae			 
d5ae			 
d5ae				ret 
