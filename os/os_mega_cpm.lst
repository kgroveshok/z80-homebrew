453d					ld (debug_mark+1),a  
453d					ld a, (.dmark+2)  
453d					ld (debug_mark+2),a  
453d				endif  
453d 18 04			jr .pastdmark  
453f ..			.dmark: db "VAR"  
4542				if DEMARK_VERSION = 1  
4542 00					db 0  
4543				endif  
4543				if DEMARK_VERSION = 1  
4543 e1			.pastdmark: pop hl  
4544				endif  
4544				if DEMARK_VERSION = 0  
4544			.pastdmark: pop af  
4544				endif  
4544			endm  
# End of macro DMARK
