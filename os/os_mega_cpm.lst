0df5			;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;	 
0df5			; OUTPUT VALUE OF A IN HEX ONE NYBBLE AT A TIME 
0df5			; pass hl for where to put the text 
0df5			;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;	 
0df5 c5			hexout:	PUSH BC 
0df6 f5					PUSH AF 
0df7 47					LD B, A 
0df8					; Upper nybble 
0df8 cb 3f				SRL A 
0dfa cb 3f				SRL A 
0dfc cb 3f				SRL A 
0dfe cb 3f				SRL A 
0e00 cd 10 0e				CALL tohex 
0e03 77					ld (hl),a 
0e04 23					inc hl	 
0e05					 
0e05					; Lower nybble 
0e05 78					LD A, B 
0e06 e6 0f				AND 0FH 
0e08 cd 10 0e				CALL tohex 
0e0b 77					ld (hl),a 
0e0c 23					inc hl	 
0e0d					 
