6c74			include "firmware_lcd_4x40.asm" 
6c74			; **********************************************************************  
6c74			; **  Alphanumeric LCD example                  by Stephen C Cousins  **  
6c74			; **********************************************************************  
6c74			;  
6c74			; **  Written as a Small Computer Monitor App  
6c74			; **  www.scc.me.uk  
6c74			;  
6c74			; History  
6c74			; 2018-05-20  v0.2.0  SCC  Example for LiNC80 SBC1 only  
6c74			; 2018-06-28  v0.3.0  SCC  Added support for RC2014 and Z280RC  
6c74			; 2019-09-14  v0.4.0  SCC  Added support for SC129 digital I/O module  
6c74			;  
6c74			; **********************************************************************  
6c74			;  
6c74			; This program is an example of one of the methods of interfacing an   
6c74			; alphanumeric LCD module.   
6c74			;  
6c74			; In this example the display is connected to either a Z80 PIO or a   
6c74			; simple 8-bit output port.   
6c74			;  
6c74			; This interfacing method uses 4-bit data mode and uses time delays  
6c74			; rather than polling the display's ready status. As a result the   
6c74			; interface only requires 6 simple output lines:  
6c74			;   Output bit 0 = not used  
6c74			;   Output bit 1 = not used  
6c74			;   Output bit 2 = RS         High = data, Low = instruction  
6c74			;   Output bit 3 = E          Active high  
6c74			;   Output bit 4 = DB4  
6c74			;   Output bit 5 = DB5  
6c74			;   Output bit 6 = DB6  
6c74			;   Output bit 7 = DB7  
6c74			; Display's R/W is connected to 0v so it is always in write mode  
6c74			;  
6c74			; This set up should work with any system supporting the RC2014 bus  
6c74			  
6c74			; To set up PIO port A in mode 3 (control) using LiNC80 as example  
6c74			;   I/O address 0x1A = 0b11001111 (0xCF)   Select mode 3 (control)  
6c74			;   I/O address 0x1A = 0b00000000 (0x00)   All pins are output  
6c74			;  
6c74			; **********************************************************************  
6c74			  
6c74			; Additonal for 4x40. E1 and E2 instead of just E   
6c74			; TODO swipe vidout signal on port a to activate E2  
6c74			  
6c74			; **********************************************************************  
6c74			; **  Constants  
6c74			; **********************************************************************  
6c74			; LCD constants required by LCD support module  
6c74			kLCDPrt:    EQU kDataReg       ;LCD port is the PIO port A data reg  
6c74			kLCDBitRS:  EQU 2              ;Port bit for LCD RS signal  
6c74			kLCDBitE:   EQU 3              ;Port bit for LCD E signal             
6c74			kLCDBitE2:   EQU 0              ;Port bit for LCD E2 signal            VICLK  
6c74			kLCDBitLED:   EQU 1              ;Port bit for LCD E2 signal            VIDDO  
6c74			; TODO Decide which E is being set  
6c74			kLCDWidth:  EQU display_cols             ;Width in characters  
6c74			  
6c74			; **********************************************************************  
6c74			; **  Code library usage  
6c74			; **********************************************************************  
6c74			  
6c74			; send character to current cursor position  
6c74			; wraps and/or scrolls screen automatically  
6c74			  
6c74			  
6c74			  
6c74			lcd_init:  
6c74			  
6c74			; SCMonAPI functions used  
6c74			  
6c74			; Alphanumeric LCD functions used  
6c74			; no need to specify specific functions for this module  
6c74			  
6c74 3e cf		            LD   A, 11001111b  
6c76 d3 c2		            OUT  (kContReg), A  ;Port A = PIO 'control' mode  
6c78 3e 00		            LD   A, 00000000b  
6c7a d3 c2		            OUT  (kContReg),A   ;Port A = all lines are outputs  
6c7c			  
6c7c			; Initialise alphanumeric LCD module  
6c7c 3e 00				ld a, 0  
6c7e 32 fb fa				ld (display_lcde1e2), a  
6c81 cd 02 6d		            CALL fLCD_Init      ;Initialise LCD module  
6c84 3e 01				ld a, 1  
6c86 32 fb fa				ld (display_lcde1e2), a  
6c89 cd 02 6d		            CALL fLCD_Init      ;Initialise LCD module  
6c8c			  
6c8c c9				ret  
