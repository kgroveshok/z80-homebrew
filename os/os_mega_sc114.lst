d555			fLCD_Str: 
d555			        ;out (SC114_SIO_1_OUT),a 
d555 c5				push bc 
d556 0e 02			ld c, $02 
d558 f7				rst $30 
d559 c1				pop bc 
d55a c9				ret 
d55b			 
d55b			; position the cursor on the screen using A as realtive point in screen buffer (i.e. A=(x+(width/y))) 
d55b			fLCD_Pos: 
d55b				; use ASCII escape to position 
