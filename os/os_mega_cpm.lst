113b 71			      ld    (HL), C                 ; Point prev free block to freed block 
113c 23			      inc   HL 
113d 70			      ld    (HL), B 
113e			 
113e 60			      ld    H, B                    ; Point freed block at next free block 
113f 69			      ld    L, C 
1140 73			      ld    (HL), E 
1141 23			      inc   HL 
1142 72			      ld    (HL), D 
1143			 
1143			      ; Check if the freed block is adjacent to the next free block 
