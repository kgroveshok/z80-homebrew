a81c			; | SCRATCH ( u -- addr ) Pushes address of offset u to stack | DONE 
a81c			; | | The scratch area provides 32 word array. Can be used as single byte or as a word by passing the offset on stack. Pushes the resulting address to stack.  
a81c			; | | When used with the direct storage writing/malloc and the !@ or word versions it is possible to construct an expanded and flexible variable system 
a81c			; | |  
a81c			; | | e.g.    : score $00 scratch ; 
a81c			; | |  
a81c			; | | $00 score ! 
a81c			; | | $01 score +! 
a81c			; | |  
a81c			; | | e.g.   : varword $0a scratch ;  
a81c			; | | 
a81c			; | | $8000 varword ! 
a81c					if DEBUG_FORTH_WORDS_KEY 
a81c						DMARK "SCR" 
a81c				if DEMARK_VERSION = 1  
a81c e5					push hl  
a81d 21 25 a8				ld hl, .dmark  
a820 22 60 ee				ld (debug_mark), hl  
a823				endif  
