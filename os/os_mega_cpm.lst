451d					ld (debug_mark+1),a  
451d					ld a, (.dmark+2)  
451d					ld (debug_mark+2),a  
451d				endif  
451d 18 04			jr .pastdmark  
451f ..			.dmark: db "VAR"  
4522				if DEMARK_VERSION = 1  
4522 00					db 0  
4523				endif  
4523				if DEMARK_VERSION = 1  
4523 e1			.pastdmark: pop hl  
4524				endif  
4524				if DEMARK_VERSION = 0  
4524			.pastdmark: pop af  
4524				endif  
4524			endm  
# End of macro DMARK
