d57c f7				rst $30 
d57d 0e 02			ld c, 2 
d57f				;ld de, .cls 
d57f 3e 4a			ld a, 'J' 
d581 f7				rst $30 
d582 d1				pop de 
d583 c1				pop bc 
d584 e1				pop hl 
d585			 
d585			 
d585 22 be eb		        ld (display_write_tmp), hl 	  
d588 3e 00			ld a, kLCD_Line1 
d58a			        ;    CALL fLCD_Pos       ;Position cursor to location in A 
