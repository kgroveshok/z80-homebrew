8f41 7a			      ld    A, D 
8f42 b3			      or    E 
8f43			 
8f43 d1			      pop   DE                      ; Address of allocation 
8f44					if DEBUG_FORTH_MALLOC 
8f44						DMARK "MAu" 
8f44						CALLMONITOR 
8f44					endif 
