0c05			addatobc: 
0c05 81			    add   a, c    ; A = A+L 
0c06 4f			    ld    c, a    ; L = A+L 
0c07 88			    adc   a, b    ; A = A+L+H+carry 
0c08 91			    sub   c       ; A = H+carry 
0c09 47			    ld    b, a    ; H = H+carry 
0c0a c9			ret 
