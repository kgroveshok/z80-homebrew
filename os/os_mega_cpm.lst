1da7			findnexttok: 
1da7			 
1da7				; hl is pointer to move 
1da7				; de is the token to locate 
1da7			 
1da7					if DEBUG_FORTH 
1da7						DMARK "NTK" 
1da7						CALLMONITOR 
1da7					endif 
1da7 d5				push de 
1da8			 
1da8			.fnt1:	 
1da8				; find first char of token to locate 
1da8			 
1da8 1a				ld a, (de) 
1da9 4f				ld c,a 
1daa 7e				ld a,(hl) 
1dab cd ac 0f			call toUpper 
1dae					if DEBUG_FORTH 
1dae						DMARK "NT1" 
1dae						CALLMONITOR 
1dae					endif 
1dae b9				cp c 
1daf			 
1daf 28 03			jr z, .fnt2cmpmorefirst	 
1db1			 
1db1				; first char not found move to next char 
1db1			 
1db1 23				inc hl 
1db2 18 f4			jr .fnt1 
1db4			 
1db4			.fnt2cmpmorefirst:	 
1db4				; first char of token found.  
1db4			 
1db4 e5				push hl     ; save start of token just in case it is the right one 
1db5 d9				exx 
1db6 e1				pop hl        ; save it to hl' 
1db7 d9				exx 
1db8			 
1db8			 
1db8			.fnt2cmpmore:	 
1db8				; compare the rest 
1db8				 
1db8 23				inc hl 
1db9 13				inc de 
1dba				 
1dba 1a				ld a, (de) 
1dbb 4f				ld c,a 
1dbc 7e				ld a,(hl) 
1dbd cd ac 0f			call toUpper 
1dc0			 
1dc0					if DEBUG_FORTH 
1dc0						DMARK "NT2" 
1dc0						CALLMONITOR 
1dc0					endif 
1dc0				; c has the token to find char 
1dc0				; a has the mem to scan char 
1dc0			 
1dc0 b9				cp c 
1dc1 28 04			jr z,.fntmatch1 
1dc3			 
1dc3				; they are not the same 
1dc3			 
1dc3					if DEBUG_FORTH 
1dc3						DMARK "NT3" 
1dc3						CALLMONITOR 
1dc3					endif 
1dc3 d1				pop de	; reset de token to look for 
1dc4 d5				push de 
1dc5 18 e1			jr .fnt1 
1dc7				 
1dc7			.fntmatch1: 
1dc7			 
1dc7				; is the same char a null which means we might have a full hit? 
1dc7					if DEBUG_FORTH 
1dc7						DMARK "NT4" 
1dc7						CALLMONITOR 
1dc7					endif 
1dc7			 
1dc7			;	cp 0 
1dc7 b7				or a 
1dc8 28 0b			jr z, .fntmatchyes 
1dca			 
1dca				; are we at the end of the token to find? 
1dca			 
1dca					if DEBUG_FORTH 
1dca						DMARK "NT5" 
1dca						CALLMONITOR 
1dca					endif 
1dca 3e 00			ld a, 0 
1dcc b9				cp c 
1dcd			 
1dcd c2 b8 1d			jp nz, .fnt2cmpmore    ; no, so keep going to a direct hit 
1dd0			 
1dd0					if DEBUG_FORTH 
1dd0						DMARK "NT6" 
1dd0						CALLMONITOR 
1dd0					endif 
1dd0				; token to find is exhusted but no match to stream 
1dd0			 
1dd0				; restore tok pointer and continue on 
1dd0 d1				pop de 
1dd1 d5				push de 
1dd2 c3 a8 1d			jp .fnt1 
1dd5			 
1dd5			 
1dd5			.fntmatchyes: 
1dd5			 
1dd5				; hl now contains the end of the found token 
1dd5			 
1dd5				; get rid of saved token pointer to find 
1dd5			 
1dd5 d1				pop de 
1dd6			 
1dd6					if DEBUG_FORTH 
1dd6						DMARK "NT9" 
1dd6						CALLMONITOR 
1dd6					endif 
1dd6			 
1dd6				; hl will be on the null term so forward on 
1dd6			 
1dd6				; get back the saved start of the token 
1dd6			 
1dd6 d9				exx 
1dd7 e5				push hl     ; save start of token just in case it is the right one 
1dd8 d9				exx 
1dd9 e1				pop hl        ; save it to hl 
1dda			 
1dda c9				ret 
1ddb			 
1ddb			 
