103a			; 
103a			; Get a word (16 bit) in hexadecimal notation. The result is returned in HL. 
103a			; Since the routines get_byte and therefore get_nibble are called, only valid 
103a			; characters (0-9a-f) are accepted. 
103a			; 
103a			;get_word        push    af 
103a			;                call    get_byte        ; Get the upper byte 
103a			;                ld      h, a 
103a			;                call    get_byte        ; Get the lower byte 
103a			;                ld      l, a 
103a			;                pop     af 
103a			;                ret 
103a			; 
103a			; Get a byte in hexadecimal notation. The result is returned in A. Since 
103a			; the routine get_nibble is used only valid characters are accepted - the  
103a			; input routine only accepts characters 0-9a-f. 
103a			; 
103a c5			get_byte:        push    bc              ; Save contents of B (and C) 
103b 7e					ld a,(hl) 
103c 23					inc hl 
103d cd 62 10		                call    nibble2val      ; Get upper nibble 
1040 cb 07		                rlc     a 
1042 cb 07		                rlc     a 
1044 cb 07		                rlc     a 
1046 cb 07		                rlc     a 
1048 47			                ld      b, a            ; Save upper four bits 
1049 7e					ld a,(hl) 
104a cd 62 10		                call    nibble2val      ; Get lower nibble 
104d b0			                or      b               ; Combine both nibbles 
104e c1			                pop     bc              ; Restore B (and C) 
104f c9			                ret 
1050			; 
1050			; Get a hexadecimal digit from the serial line. This routine blocks until 
1050			; a valid character (0-9a-f) has been entered. A valid digit will be echoed 
1050			; to the serial line interface. The lower 4 bits of A contain the value of  
1050			; that particular digit. 
