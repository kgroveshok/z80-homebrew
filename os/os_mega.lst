0dee 83			    add   a, e    ; A = A+L 
0def 5f			    ld    e, a    ; L = A+L 
0df0 8a			    adc   a, d    ; A = A+L+H+carry 
0df1 93			    sub   e       ; A = H+carry 
0df2 57			    ld    d, a    ; H = H+carry 
0df3 c9			ret 
