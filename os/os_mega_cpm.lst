0f95			; https://tutorials.eeems.ca/ASMin28Days/lesson/day16.html#cmp 
0f95			 
0f95			; String Length 
0f95			;With a length-prefixed string, finding the length is trivial. For a null-terminated string, the process is decidedly more involved. This is where CPIR comes in. 
0f95			 
0f95			; Get the length of the null-terminated string starting at $8000 hl 
0f95			;    LD     HL, $8000 
0f95			 
0f95			strlenz: 
0f95			 
0f95 af			    XOR    A               ; Zero is the value we are looking for. 
0f96 47			    LD     B, A             ; Since we haven't the slightest clue as to the  
0f97 4f			    LD     C, A             ; actual size of the string, put 0 in BC to search 
0f98			                           ; 65, 536 bytes (the entire addressable memory space). 
0f98 ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
0f9a			 
0f9a			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
0f9a 67			    LD     H, A             ; Zero HL (basically set it to 65, 536) to get the 
0f9b 6f			    LD     L, A             ; number of bytes 
0f9c ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
0f9e 2b			    DEC    HL              ; Compensate for null. 
0f9f c9				ret 
0fa0			 
0fa0			; Get the length of the A terminated string starting at $8000 hl 
0fa0			;    LD     HL, $8000 
0fa0			 
0fa0			strlent: 
0fa0			 
0fa0			                  ; A is the value we are looking for. 
0fa0 06 00		    LD     B, 0             ; Since we haven't the slightest clue as to the  
0fa2 0e 00		    LD     C, 0             ; actual size of the string, put 0 in BC to search 
0fa4			                           ; 65, 536 bytes (the entire addressable memory space). 
0fa4 ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
0fa6			 
0fa6			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
0fa6 26 00		    LD     H, 0             ; Zero HL (basically set it to 65, 536) to get the 
0fa8 2e 00		    LD     L, 0             ; number of bytes 
0faa ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
0fac 2b			    DEC    HL              ; Compensate for null. 
0fad c9				ret 
