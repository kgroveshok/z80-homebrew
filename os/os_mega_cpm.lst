102d					endif 
102d 7c			      ld    A, H                    ; Exit if no space requested 
102e b5			      or    L 
102f ca ee 10		      jp    Z, malloc_early_exit 
1032			 
1032			;inc hl 
1032			;inc hl 
1032			;inc hl 
1032			; 
1032			;inc hl 
1032			;inc hl 
1032			;inc hl 
1032			;inc hl 
1032			;inc hl 
1032			;inc hl 
1032			;inc hl 
1032			;inc hl 
1032			;inc hl 
1032			 
1032			 
1032			 
1032			 
