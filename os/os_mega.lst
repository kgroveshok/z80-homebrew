1170			if MALLOC_2 
1170			; Z80 Malloc and Free Functions 
1170			 
1170			; Malloc Function: 
1170			; Input: 
1170			;   HL: Size of block to allocate 
1170			; Output: 
1170			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
1170			 
1170			malloc: 
1170				 
1170			if DEBUG_FORTH_MALLOC_HIGH 
1170			call malloc_guard_entry 
1170			endif 
1170			 
1170			 
1170			 
1170			 
1170					if DEBUG_FORTH_MALLOC 
1170						DMARK "mal" 
1170						CALLMONITOR 
1170					endif 
1170			    push af            ; Save AF register 
1170			    ld a, l            ; Load low byte of size into A 
1170			    or h               ; Check if size is zero 
1170			    jp z, malloc_exit  ; If size is zero, exit with NULL pointer 
1170			 
1170			    ; Allocate memory 
1170			    ld hl, (heap_start) ; Load start of heap into HL 
1170					if DEBUG_FORTH_MALLOC 
1170						DMARK "ma1" 
1170						CALLMONITOR 
1170					endif 
1170			    call malloc_internal ; Call internal malloc function 
1170			    pop af             ; Restore AF register 
1170			if DEBUG_FORTH_MALLOC_HIGH 
1170			call malloc_guard_exit 
1170			call malloc_guard_zerolen 
1170			endif 
1170			    ret                ; Return 
1170			 
1170			; Free Function: 
1170			; Input: 
1170			;   HL: Pointer to memory block to free 
1170			; Output: 
1170			;   None 
1170			 
1170			free: 
1170			    push af            ; Save AF register 
1170			    ld a, l            ; Load low byte of pointer into A 
1170			    or h               ; Check if pointer is NULL 
1170			    jp z, free_exit    ; If pointer is NULL, exit 
1170			 
1170			    ; Free memory 
1170			    ld hl, (heap_start) ; Load start of heap into HL 
1170			    call free_internal  ; Call internal free function 
1170			    pop af             ; Restore AF register 
1170			    ret                ; Return 
1170			 
1170			; Internal Malloc Function: 
1170			; Input: 
1170			;   HL: Size of block to allocate 
1170			; Output: 
1170			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
1170			 
1170			malloc_internal: 
1170			    ld bc, 2           ; Number of bytes to allocate for management overhead 
1170			    add hl, bc         ; Add management overhead to requested size 
1170			    ex de, hl          ; Save total size in DE, and keep it in HL 
1170					if DEBUG_FORTH_MALLOC 
1170						DMARK "ma2" 
1170						CALLMONITOR 
1170					endif 
1170			 
1170			    ; Search for free memory block 
1170			    ld de, (heap_end)  ; Load end of heap into DE 
1170			    ld bc, 0           ; Initialize counter 
1170			 
1170					if DEBUG_FORTH_MALLOC 
1170						DMARK "ma2" 
1170						CALLMONITOR 
1170					endif 
1170			malloc_search_loop: 
1170			    ; Check if current block is free 
1170			    ld a, (hl)         ; Load current block's status (free or used) 
1170			;    cp 0               ; Compare with zero (free) 
1170				or a 
1170			    jr nz, malloc_skip_block_check  ; If not free, skip to the next block 
1170			 
1170			    ; Check if current block is large enough 
1170			    ld a, (hl+1)       ; Load high byte of block size 
1170			    cp l               ; Compare with low byte of requested size 
1170			    jr nz, malloc_skip_block_check  ; If not large enough, skip to the next block 
1170			 
1170			    ld a, (hl+2)       ; Load low byte of block size 
1170			    cp h               ; Compare with high byte of requested size 
1170			    jr c, malloc_skip_block_check   ; If not large enough, skip to the next block 
1170			 
1170			    ; Mark block as used 
1170			    ld (hl), 0xFF      ; Set status byte to indicate used block 
1170			 
1170			    ; Calculate remaining space in block 
1170			    ld bc, 0           ; Clear BC 
1170			    add hl, bc         ; Increment HL to point to start of data block 
1170			    add hl, de         ; HL = HL + DE (total size) 
1170			    ld bc, 1           ; Number of bytes to allocate for management overhead 
1170			    add hl, bc         ; Add management overhead to start of data block 
1170			 
1170			    ; Save pointer to allocated block in HL 
1170			if DEBUG_FORTH_MALLOC_HIGH 
1170						DMARK "ma5" 
1170			call malloc_guard_exit 
1170			call malloc_guard_zerolen 
1170			endif 
1170			    ret 
1170			 
1170			malloc_skip_block_check: 
1170			    ; Move to the next block 
1170			    ld bc, 3           ; Size of management overhead 
1170			    add hl, bc         ; Move to the next block 
1170			    inc de             ; Increment counter 
1170			 
1170			    ; Check if we have reached the end of heap 
1170			    ld a, e            ; Load low byte of heap end address 
1170			    cp (hl)            ; Compare with low byte of current address 
1170			    jr nz, malloc_search_loop  ; If not equal, continue searching 
1170			    ld a, d            ; Load high byte of heap end address 
1170			;    cp 0               ; Check if it's zero (end of memory) 
1170				or a 
1170			    jr nz, malloc_search_loop  ; If not zero, continue searching 
1170			 
1170			    ; If we reached here, allocation failed 
1170			    xor a              ; Set result to NULL 
1170			if DEBUG_FORTH_MALLOC_HIGH 
1170						DMARK "ma6" 
1170			call malloc_guard_exit 
1170			call malloc_guard_zerolen 
1170			endif 
1170			    ret 
1170			malloc_exit: 
1170			if DEBUG_FORTH_MALLOC_HIGH 
1170						DMARK "ma7" 
1170			call malloc_guard_exit 
1170			call malloc_guard_zerolen 
1170			endif 
1170			    ret 
1170			 
1170			; Internal Free Function: 
1170			; Input: 
1170			;   HL: Pointer to memory block to free 
1170			; Output: 
1170			;   None 
1170			 
1170			free_internal: 
1170			    ld de, (heap_start) ; Load start of heap into DE 
1170			    ld bc, 0            ; Initialize counter 
1170			 
1170			free_search_loop: 
1170			    ; Check if current block contains the pointer 
1170			    ld a, l             ; Load low byte of pointer 
1170			    cp (hl+1)           ; Compare with high byte of current block's address 
1170			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
1170			    ld a, h             ; Load high byte of pointer 
1170			    cp (hl+2)           ; Compare with low byte of current block's address 
1170			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
1170			 
1170			    ; Mark block as free 
1170			    ld (hl), 0          ; Set status byte to indicate free block 
1170			    ret                 ; Return 
1170			 
1170			free_skip_block_check: 
1170			    ; Move to the next block 
1170			    ld bc, 3            ; Size of management overhead 
1170			    add hl, bc          ; Move to the next block 
1170			    inc de              ; Increment counter 
1170			 
1170			    ; Check if we have reached the end of heap 
1170			    ld a, e             ; Load low byte of heap end address 
1170			    cp (hl)             ; Compare with low byte of current address 
1170			    jr nz, free_search_loop  ; If not equal, continue searching 
1170			    ld a, d             ; Load high byte of heap end address 
1170			;    cp 0                ; Check if it's zero (end of memory) 
1170				or a 
1170			    jr nz, free_search_loop  ; If not zero, continue searching 
1170			 
1170			    ; If we reached here, pointer is not found in heap 
1170			    ret 
1170			 
1170			free_exit: 
1170			    ret                 ; Return 
1170			 
1170			; Define heap start and end addresses 
1170			;heap_start:    .dw 0xC000   ; Start of heap 
1170			;heap_end:      .dw 0xE000   ; End of heap 
1170			 
1170			endif 
1170			 
1170			 
1170			if MALLOC_1 
1170			 
1170			 
1170			 
1170			; from https://gist.github.com/tomstorey/947a8b084bad69391a4b2a1c5b6d69ca 
1170			 
1170			;moved to firmware.asm 
1170			;heap_start        .equ  0x9000      ; Starting address of heap 
1170			;heap_size         .equ  0x0100      ; Number of bytes available in heap 
1170			 
1170			;      .org 0 
1170			;      jp    main 
1170			 
1170			 
1170			;      .org  0x100 
1170			;main: 
1170			;      ld    HL, 0x8100 
1170			;      ld    SP, HL 
1170			; 
1170			;      call  heap_init 
1170			; 
1170			;      ; Make some allocations 
1170			;      ld    HL, 12 
1170			;      call  malloc            ; Allocates 0x9004 
1170			; 
1170			;      ld    HL, 12 
1170			;      call  malloc            ; Allocates 0x9014 
1170			; 
1170			;      ld    HL, 12 
1170			;      call  malloc            ; Allocates 0x9024 
1170			; 
1170			;      ; Free some allocations 
1170			;      ld    HL, 0x9014 
1170			;      call  free 
1170			; 
1170			;      ld    HL, 0x9004 
1170			;      call  free 
1170			; 
1170			;      ld    HL, 0x9024 
1170			;      call  free 
1170			; 
1170			; 
1170			;      halt 
1170			 
1170			 
1170			;------------------------------------------------------------------------------ 
1170			;     heap_init                                                               : 
1170			;                                                                             : 
1170			; Description                                                                 : 
1170			;     Initialise the heap and make it ready for malloc and free operations.   : 
1170			;                                                                             : 
1170			;     The heap is maintained as a linked list, starting with an initial       : 
1170			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
1170			;     the first free block in the heap. Each block then points to the next    : 
1170			;     free block within the heap, and the free list ends at the first block   : 
1170			;     with a null pointer to the next free block.                             : 
1170			;                                                                             : 
1170			; Parameters                                                                  : 
1170			;     Inputs are compile-time only. Two defines which specify the starting    : 
1170			;     address of the heap and its size are required, along with a memory      : 
1170			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
1170			;     principally stores a pointer to the first free block in the heap.       : 
1170			;                                                                             : 
1170			; Returns                                                                     : 
1170			;     Nothing                                                                 : 
1170			;------------------------------------------------------------------------------ 
1170			heap_init: 
1170 e5			      push  HL 
1171			 
1171			      ; Initialise free list struct 
1171 21 0e 80		      ld    HL, heap_start 
1174 22 0a 80		      ld    (free_list), HL 
1177 21 00 00		      ld    HL, 0 
117a 22 0c 80		      ld    (free_list+2), HL 
117d			 
117d			      ; Insert first free block at bottom of heap, consumes entire heap 
117d 21 ad f0		      ld    HL, heap_start+heap_size-4 
1180 22 0e 80		      ld    (heap_start), HL        ; Next block (end of free list) 
1183 21 9f 70		      ld    HL, heap_size-4 
1186 22 10 80		      ld    (heap_start+2), HL      ; Block size 
1189			 
1189			      ; Insert end of free list block at top of heap - two null words will 
1189			      ; terminate the free list 
1189 21 00 00		      ld    HL, 0 
118c 22 af f0		      ld    (heap_start+heap_size-2), HL 
118f 22 ad f0		      ld    (heap_start+heap_size-4), HL 
1192			 
1192 e1			      pop   HL 
1193			 
1193 c9			      ret 
1194			 
1194			 
1194			;------------------------------------------------------------------------------ 
1194			;     malloc                                                                  : 
1194			;                                                                             : 
1194			; Description                                                                 : 
1194			;     Allocates the wanted space from the heap and returns the address of the : 
1194			;     first useable byte of the allocation.                                   : 
1194			;                                                                             : 
1194			;     Allocations can happen in one of two ways:                              : 
1194			;                                                                             : 
1194			;     1. A free block may be found which is the exact size wanted. In this    : 
1194			;        case the block is removed from the free list and retuedn to the      : 
1194			;        caller.                                                              : 
1194			;     2. A free block may be found which is larger than the size wanted. In   : 
1194			;        this case, the larger block is split into two. The first portion of  : 
1194			;        this block will become the requested space by the malloc call and    : 
1194			;        is returned to the caller. The second portion becomes a new free     : 
1194			;        block, and the free list is adjusted to maintain continuity via this : 
1194			;        newly created block.                                                 : 
1194			;                                                                             : 
1194			;     malloc does not set any initial value in the allocated space, the       : 
1194			;     caller is required to do this as required.                              : 
1194			;                                                                             : 
1194			;     This implementation of malloc uses the stack exclusively, and is        : 
1194			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
1194			;     advisable to disable interrupts before calling malloc, and recommended  : 
1194			;     to avoid the use of malloc inside ISRs in general.                      : 
1194			;                                                                             : 
1194			;     NOTE: heap_init must be called before malloc and free can be used.      : 
1194			;                                                                             : 
1194			; Parameters                                                                  : 
1194			;     HL  Number of bytes wanted                                              : 
1194			;                                                                             : 
1194			; Returns                                                                     : 
1194			;     HL  Address of the first useable byte of the allocation                 : 
1194			;                                                                             : 
1194			; Flags                                                                       : 
1194			;     Z   Set if the allocation did not succeed, clear otherwise              : 
1194			;                                                                             : 
1194			; Stack frame                                                                 : 
1194			;       |             |                                                       : 
1194			;       +-------------+                                                       : 
1194			;       |     BC      |                                                       : 
1194			;       +-------------+                                                       : 
1194			;       |     DE      |                                                       : 
1194			;       +-------------+                                                       : 
1194			;       |     IX      |                                                       : 
1194			;       +-------------+                                                       : 
1194			;       |  prev_free  |                                                       : 
1194			;   +4  +-------------+                                                       : 
1194			;       |  this_free  |                                                       : 
1194			;   +2  +-------------+                                                       : 
1194			;       |  next_free  |                                                       : 
1194			;   +0  +-------------+                                                       : 
1194			;       |             |                                                       : 
1194			;                                                                             : 
1194			;------------------------------------------------------------------------------ 
1194			 
1194			 
1194			;malloc: 
1194			; 
1194			;	SAVESP ON 1 
1194			; 
1194			;	call malloc_code 
1194			; 
1194			;	CHECKSP ON 1 
1194			;	ret 
1194			 
1194			 
1194			malloc: 
1194 c5			      push  BC 
1195 d5			      push  DE 
1196 dd e5		      push  IX 
1198			if DEBUG_FORTH_MALLOC_HIGH 
1198			call malloc_guard_entry 
1198			endif 
1198			 
1198					if DEBUG_FORTH_MALLOC 
1198						DMARK "mal" 
1198						CALLMONITOR 
1198					endif 
1198 7c			      ld    A, H                    ; Exit if no space requested 
1199 b5			      or    L 
119a ca 59 12		      jp    Z, malloc_early_exit 
119d			 
119d			;inc hl 
119d			;inc hl 
119d			;inc hl 
119d			; 
119d			;inc hl 
119d			;inc hl 
119d			;inc hl 
119d			;inc hl 
119d			;inc hl 
119d			;inc hl 
119d			;inc hl 
119d			;inc hl 
119d			;inc hl 
119d			 
119d			 
119d			 
119d			 
119d					if DEBUG_FORTH_MALLOC 
119d						DMARK "maA" 
119d						CALLMONITOR 
119d					endif 
119d			      ; Set up stack frame 
119d eb			      ex    DE, HL 
119e 21 fa ff		      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
11a1 39			      add   HL, SP 
11a2 f9			      ld    SP, HL 
11a3 dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
11a7 dd 39		      add   IX, SP 
11a9			 
11a9			      ; Setup initial state 
11a9 21 04 00		      ld    HL, 4                   ; want must also include space used by block struct 
11ac 19			      add   HL, DE 
11ad			 
11ad 44			      ld    B, H                    ; Move want to BC 
11ae 4d			      ld    C, L 
11af			 
11af 21 0a 80		      ld    HL, free_list           ; Store prev_free ptr to stack 
11b2 dd 75 04		      ld    (IX+4), L 
11b5 dd 74 05		      ld    (IX+5), H 
11b8			 
11b8 5e			      ld    E, (HL)                 ; Store this_free ptr to stack 
11b9 23			      inc   HL 
11ba 56			      ld    D, (HL) 
11bb dd 73 02		      ld    (IX+2), E 
11be dd 72 03		      ld    (IX+3), D 
11c1 eb			      ex    DE, HL                  ; this_free ptr into HL 
11c2			 
11c2					if DEBUG_FORTH_MALLOC 
11c2						DMARK "maB" 
11c2						CALLMONITOR 
11c2					endif 
11c2			      ; Loop through free block list to find some space 
11c2			malloc_find_space: 
11c2 5e			      ld    E, (HL)                 ; Load next_free ptr into DE 
11c3 23			      inc   HL 
11c4 56			      ld    D, (HL) 
11c5			 
11c5 7a			      ld    A, D                    ; Check for null next_free ptr - end of free list 
11c6 b3			      or    E 
11c7 ca 53 12		      jp    Z, malloc_no_space 
11ca			 
11ca dd 73 00		      ld    (IX+0), E               ; Store next_free ptr to stack 
11cd dd 72 01		      ld    (IX+1), D 
11d0			 
11d0			      ; Does this block have enough space to make the allocation? 
11d0 23			      inc   HL                      ; Load free block size into DE 
11d1 5e			      ld    E, (HL) 
11d2 23			      inc   HL 
11d3 56			      ld    D, (HL) 
11d4			 
11d4 eb			      ex    DE, HL                  ; Check size of block against want 
11d5 b7			      or    A                       ; Ensure carry flag clear 
11d6 ed 42		      sbc   HL, BC 
11d8 e5			      push  HL                      ; Store the result for later (new block size) 
11d9			 
11d9 ca 28 12		      jp   Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
11dc 30 1b		      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
11de			 
11de			      ; this_free block is not big enough, setup ptrs to test next free block 
11de e1			      pop   HL                      ; Discard previous result 
11df			 
11df dd 6e 02		      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
11e2 dd 66 03		      ld    H, (IX+3) 
11e5 dd 75 04		      ld    (IX+4), L 
11e8 dd 74 05		      ld    (IX+5), H 
11eb			 
11eb dd 6e 00		      ld    L, (IX+0)               ; Move next_free ptr into this_free 
11ee dd 66 01		      ld    H, (IX+1) 
11f1 dd 75 02		      ld    (IX+2), L 
11f4 dd 74 03		      ld    (IX+3), H 
11f7			 
11f7					if DEBUG_FORTH_MALLOC 
11f7						DMARK "MA>" 
11f7						CALLMONITOR 
11f7					endif 
11f7 18 c9		      jr    malloc_find_space 
11f9			 
11f9			      ; split a bigger block into two - requested size and remaining size 
11f9			malloc_alloc_split: 
11f9					if DEBUG_FORTH_MALLOC 
11f9						DMARK "MAs" 
11f9						CALLMONITOR 
11f9					endif 
11f9 eb			      ex    DE, HL                  ; Calculate address of new free block 
11fa 2b			      dec   HL 
11fb 2b			      dec   HL 
11fc 2b			      dec   HL 
11fd 09			      add   HL, BC 
11fe			 
11fe			      ; Create a new block and point it at next_free 
11fe dd 5e 00		      ld    E, (IX+0)               ; Load next_free ptr into DE 
1201 dd 56 01		      ld    D, (IX+1) 
1204			 
1204 73			      ld    (HL), E                 ; Store next_free ptr into new block 
1205 23			      inc   HL 
1206 72			      ld    (HL), D 
1207			 
1207 d1			      pop   DE                      ; Store size of new block into new block 
1208 23			      inc   HL 
1209 73			      ld    (HL), E 
120a 23			      inc   HL 
120b 72			      ld    (HL), D 
120c			 
120c			      ; Update this_free ptr to point to new block 
120c 2b			      dec   HL 
120d 2b			      dec   HL 
120e 2b			      dec   HL 
120f			 
120f dd 5e 02		      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
1212 dd 56 03		      ld    D, (IX+3) 
1215			 
1215 dd 75 02		      ld    (IX+2), L               ; Store new block addr as this_free ptr 
1218 dd 74 03		      ld    (IX+3), H 
121b			 
121b			      ; Modify this_free block to be allocation 
121b eb			      ex    DE, HL 
121c af			      xor   A                       ; Null the next block ptr of allocated block 
121d 77			      ld    (HL), A 
121e 23			      inc   HL 
121f 77			      ld    (HL), A 
1220			 
1220 23			      inc   HL                      ; Store want size into allocated block 
1221 71			      ld    (HL), C 
1222 23			      inc   HL 
1223 70			      ld    (HL), B 
1224 23			      inc   HL 
1225 e5			      push  HL                      ; Address of allocation to return 
1226			 
1226 18 19		      jr    malloc_update_links 
1228			 
1228			malloc_alloc_fit: 
1228 e1			      pop   HL                      ; Dont need new block size, want is exact fit 
1229			 
1229					if DEBUG_FORTH_MALLOC 
1229						DMARK "MAf" 
1229						CALLMONITOR 
1229					endif 
1229			      ; Modify this_free block to be allocation 
1229 eb			      ex    DE, HL 
122a 2b			      dec   HL 
122b 2b			      dec   HL 
122c 2b			      dec   HL 
122d			 
122d af			      xor   A                       ; Null the next block ptr of allocated block 
122e 77			      ld    (HL), A 
122f 23			      inc   HL 
1230 77			      ld    (HL), A 
1231			 
1231 23			      inc   HL                      ; Store address of allocation to return 
1232 23			      inc   HL 
1233 23			      inc   HL 
1234 e5			      push  HL 
1235			 
1235			      ; Copy next_free ptr to this_free, remove allocated block from free list 
1235 dd 6e 00		      ld    L, (IX+0)               ; next_free to HL 
1238 dd 66 01		      ld    H, (IX+1) 
123b			 
123b dd 75 02		      ld    (IX+2), L               ; HL to this_free 
123e dd 74 03		      ld    (IX+3), H 
1241			 
1241			 
1241			malloc_update_links: 
1241			      ; Update prev_free ptr to point to this_free 
1241 dd 6e 04		      ld    L, (IX+4)               ; prev_free ptr to HL 
1244 dd 66 05		      ld    H, (IX+5) 
1247			 
1247 dd 5e 02		      ld    E, (IX+2)               ; this_free ptr to DE 
124a dd 56 03		      ld    D, (IX+3) 
124d			 
124d 73			      ld    (HL), E                 ; this_free ptr into prev_free 
124e 23			      inc   HL 
124f 72			      ld    (HL), D 
1250			 
1250					if DEBUG_FORTH_MALLOC 
1250						DMARK "Mul" 
1250						CALLMONITOR 
1250					endif 
1250			      ; Clear the Z flag to indicate successful allocation 
1250 7a			      ld    A, D 
1251 b3			      or    E 
1252			 
1252 d1			      pop   DE                      ; Address of allocation 
1253					if DEBUG_FORTH_MALLOC 
1253						DMARK "MAu" 
1253						CALLMONITOR 
1253					endif 
1253			 
1253			malloc_no_space: 
1253 21 06 00		      ld    HL, 6                   ; Clean up stack frame 
1256 39			      add   HL, SP 
1257 f9			      ld    SP, HL 
1258			 
1258 eb			      ex    DE, HL                  ; Alloc addr into HL for return 
1259					if DEBUG_FORTH_MALLOC 
1259						DMARK "MAN" 
1259						CALLMONITOR 
1259					endif 
1259			 
1259			malloc_early_exit: 
1259					if DEBUG_FORTH_MALLOC 
1259						DMARK "MAx" 
1259						CALLMONITOR 
1259					endif 
1259 dd e1		      pop   IX 
125b d1			      pop   DE 
125c c1			      pop   BC 
125d			 
125d			if DEBUG_FORTH_MALLOC_HIGH 
125d			call malloc_guard_exit 
125d			call malloc_guard_zerolen 
125d			endif 
125d c9			      ret 
125e			 
125e			 
125e			;------------------------------------------------------------------------------ 
125e			;     free                                                                    : 
125e			;                                                                             : 
125e			; Description                                                                 : 
125e			;     Return the space pointed to by HL to the heap. HL must be an address as : 
125e			;     returned by malloc, otherwise the behaviour is undefined.               : 
125e			;                                                                             : 
125e			;     Where possible, directly adjacent free blocks will be merged together   : 
125e			;     into larger blocks to help ensure that the heap does not become         : 
125e			;     excessively fragmented.                                                 : 
125e			;                                                                             : 
125e			;     free does not clear or set any other value into the freed space, and    : 
125e			;     therefore its contents may be visible through subsequent malloc's. The  : 
125e			;     caller should clear the freed space as required.                        : 
125e			;                                                                             : 
125e			;     This implementation of free uses the stack exclusively, and is          : 
125e			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
125e			;     advisable to disable interrupts before calling free, and recommended    : 
125e			;     to avoid the use of free inside ISRs in general.                        : 
125e			;                                                                             : 
125e			;     NOTE: heap_init must be called before malloc and free can be used.      : 
125e			;                                                                             : 
125e			; Parameters                                                                  : 
125e			;     HL  Pointer to address of first byte of allocation to be freed          : 
125e			;                                                                             : 
125e			; Returns                                                                     : 
125e			;     Nothing                                                                 : 
125e			;                                                                             : 
125e			; Stack frame                                                                 : 
125e			;       |             |                                                       : 
125e			;       +-------------+                                                       : 
125e			;       |     BC      |                                                       : 
125e			;       +-------------+                                                       : 
125e			;       |     DE      |                                                       : 
125e			;       +-------------+                                                       : 
125e			;       |     IX      |                                                       : 
125e			;       +-------------+                                                       : 
125e			;       |  prev_free  |                                                       : 
125e			;   +2  +-------------+                                                       : 
125e			;       |  next_free  |                                                       : 
125e			;   +0  +-------------+                                                       : 
125e			;       |             |                                                       : 
125e			;                                                                             : 
125e			;------------------------------------------------------------------------------ 
125e			free: 
125e c5			      push  BC 
125f d5			      push  DE 
1260 dd e5		      push  IX 
1262			 
1262 7c			      ld    A, H                    ; Exit if ptr is null 
1263 b5			      or    L 
1264 ca 28 13		      jp    Z, free_early_exit 
1267			 
1267			      ; Set up stack frame 
1267 eb			      ex    DE, HL 
1268 21 fc ff		      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
126b 39			      add   HL, SP 
126c f9			      ld    SP, HL 
126d dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
1271 dd 39		      add   IX, SP 
1273			 
1273			      ; The address in HL points to the start of the useable allocated space, 
1273			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
1273			      ; address of the block itself. 
1273 eb			      ex    DE, HL 
1274 11 fc ff		      ld    DE, -4 
1277 19			      add   HL, DE 
1278			 
1278			      ; An allocated block must have a null next block pointer in it 
1278 7e			      ld    A, (HL) 
1279 23			      inc   HL 
127a b6			      or    (HL) 
127b c2 23 13		      jp    NZ, free_done 
127e			 
127e 2b			      dec   HL 
127f			 
127f 44			      ld    B, H                    ; Copy HL to BC 
1280 4d			      ld    C, L 
1281			 
1281			      ; Loop through the free list to find the first block with an address 
1281			      ; higher than the block being freed 
1281 21 0a 80		      ld    HL, free_list 
1284			 
1284			free_find_higher_block: 
1284 5e			      ld    E, (HL)                 ; Load next ptr from free block 
1285 23			      inc   HL 
1286 56			      ld    D, (HL) 
1287 2b			      dec   HL 
1288			 
1288 dd 73 00		      ld    (IX+0), E               ; Save ptr to next free block 
128b dd 72 01		      ld    (IX+1), D 
128e dd 75 02		      ld    (IX+2), L               ; Save ptr to prev free block 
1291 dd 74 03		      ld    (IX+3), H 
1294			 
1294 78			      ld    A, B                    ; Check if DE is greater than BC 
1295 ba			      cp    D                       ; Compare MSB first 
1296 28 02		      jr    Z, $+4                  ; MSB the same, compare LSB 
1298 30 04		      jr    NC, free_find_higher_block_skip 
129a 79			      ld    A, C 
129b bb			      cp    E                       ; Then compare LSB 
129c 38 08		      jr    C, free_found_higher_block 
129e			 
129e			free_find_higher_block_skip: 
129e 7a			      ld    A, D                    ; Reached the end of the free list? 
129f b3			      or    E 
12a0 ca 23 13		      jp    Z, free_done 
12a3			 
12a3 eb			      ex    DE, HL 
12a4			 
12a4 18 de		      jr    free_find_higher_block 
12a6			 
12a6			free_found_higher_block: 
12a6			      ; Insert freed block between prev and next free blocks 
12a6 71			      ld    (HL), C                 ; Point prev free block to freed block 
12a7 23			      inc   HL 
12a8 70			      ld    (HL), B 
12a9			 
12a9 60			      ld    H, B                    ; Point freed block at next free block 
12aa 69			      ld    L, C 
12ab 73			      ld    (HL), E 
12ac 23			      inc   HL 
12ad 72			      ld    (HL), D 
12ae			 
12ae			      ; Check if the freed block is adjacent to the next free block 
12ae 23			      inc   HL                      ; Load size of freed block into HL 
12af 5e			      ld    E, (HL) 
12b0 23			      inc   HL 
12b1 56			      ld    D, (HL) 
12b2 eb			      ex    DE, HL 
12b3			 
12b3 09			      add   HL, BC                  ; Add addr of freed block and its size 
12b4			 
12b4 dd 5e 00		      ld    E, (IX+0)               ; Load addr of next free block into DE 
12b7 dd 56 01		      ld    D, (IX+1) 
12ba			 
12ba b7			      or    A                       ; Clear the carry flag 
12bb ed 52		      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
12bd 20 22		      jr    NZ, free_check_adjacent_to_prev 
12bf			 
12bf			      ; Freed block is adjacent to next, merge into one bigger block 
12bf eb			      ex    DE, HL                  ; Load next ptr from next block into DE 
12c0 5e			      ld    E, (HL) 
12c1 23			      inc   HL 
12c2 56			      ld    D, (HL) 
12c3 e5			      push  HL                      ; Save ptr to next block for later 
12c4			 
12c4 60			      ld    H, B                    ; Store ptr from next block into freed block 
12c5 69			      ld    L, C 
12c6 73			      ld    (HL), E 
12c7 23			      inc   HL 
12c8 72			      ld    (HL), D 
12c9			 
12c9 e1			      pop   HL                      ; Restore ptr to next block 
12ca 23			      inc   HL                      ; Load size of next block into DE 
12cb 5e			      ld    E, (HL) 
12cc 23			      inc   HL 
12cd 56			      ld    D, (HL) 
12ce d5			      push  DE                      ; Save next block size for later 
12cf			 
12cf 60			      ld    H, B                    ; Load size of freed block into HL 
12d0 69			      ld    L, C 
12d1 23			      inc   HL 
12d2 23			      inc   HL 
12d3 5e			      ld    E, (HL) 
12d4 23			      inc   HL 
12d5 56			      ld    D, (HL) 
12d6 eb			      ex    DE, HL 
12d7			 
12d7 d1			      pop   DE                      ; Restore size of next block 
12d8 19			      add   HL, DE                  ; Add sizes of both blocks 
12d9 eb			      ex    DE, HL 
12da			 
12da 60			      ld    H, B                    ; Store new bigger size into freed block 
12db 69			      ld    L, C 
12dc 23			      inc   HL 
12dd 23			      inc   HL 
12de 73			      ld    (HL), E 
12df 23			      inc   HL 
12e0 72			      ld    (HL), D 
12e1			 
12e1			free_check_adjacent_to_prev: 
12e1			      ; Check if the freed block is adjacent to the prev free block 
12e1 dd 6e 02		      ld    L, (IX+2)               ; Prev free block ptr into HL 
12e4 dd 66 03		      ld    H, (IX+3) 
12e7			 
12e7 23			      inc   HL                      ; Size of prev free block into DE 
12e8 23			      inc   HL 
12e9 5e			      ld    E, (HL) 
12ea 23			      inc   HL 
12eb 56			      ld    D, (HL) 
12ec 2b			      dec   HL 
12ed 2b			      dec   HL 
12ee 2b			      dec   HL 
12ef			 
12ef 19			      add   HL, DE                  ; Add prev block addr and size 
12f0			 
12f0 b7			      or    A                       ; Clear the carry flag 
12f1 ed 42		      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
12f3 20 2e		      jr    NZ, free_done 
12f5			 
12f5			      ; Freed block is adjacent to prev, merge into one bigger block 
12f5 60			      ld    H, B                    ; Load next ptr from freed block into DE 
12f6 69			      ld    L, C 
12f7 5e			      ld    E, (HL) 
12f8 23			      inc   HL 
12f9 56			      ld    D, (HL) 
12fa e5			      push  HL                      ; Save freed block ptr for later 
12fb			 
12fb dd 6e 02		      ld    L, (IX+2)               ; Store freed block ptr into prev block 
12fe dd 66 03		      ld    H, (IX+3) 
1301 73			      ld    (HL), E 
1302 23			      inc   HL 
1303 72			      ld    (HL), D 
1304			 
1304 e1			      pop   HL                      ; Restore freed block ptr 
1305 23			      inc   HL                      ; Load size of freed block into DE 
1306 5e			      ld    E, (HL) 
1307 23			      inc   HL 
1308 56			      ld    D, (HL) 
1309 d5			      push  DE                      ; Save freed block size for later 
130a			 
130a dd 6e 02		      ld    L, (IX+2)               ; Load size of prev block into DE 
130d dd 66 03		      ld    H, (IX+3) 
1310 23			      inc   HL 
1311 23			      inc   HL 
1312 5e			      ld    E, (HL) 
1313 23			      inc   HL 
1314 56			      ld    D, (HL) 
1315			 
1315 e1			      pop   HL                      ; Add sizes of both blocks 
1316 19			      add   HL, DE 
1317 eb			      ex    DE, HL 
1318			 
1318 dd 6e 02		      ld    L, (IX+2)               ; Store new bigger size into prev block 
131b dd 66 03		      ld    H, (IX+3) 
131e 23			      inc   HL 
131f 23			      inc   HL 
1320 73			      ld    (HL), E 
1321 23			      inc   HL 
1322 72			      ld    (HL), D 
1323			 
1323			free_done: 
1323 21 04 00		      ld    HL, 4                   ; Clean up stack frame 
1326 39			      add   HL, SP 
1327 f9			      ld    SP, HL 
1328			 
1328			free_early_exit: 
1328 dd e1		      pop   IX 
132a d1			      pop   DE 
132b c1			      pop   BC 
132c			 
132c c9			      ret 
