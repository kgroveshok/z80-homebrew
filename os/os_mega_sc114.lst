9629			include "firmware_595shiftreg.asm"  
9629			; common code for handling a 595 shift reg out on whatever output port 
9629			 
9629			; port in c 
9629			; byte in a 
9629			 
9629			 
9629			shift_bit_data: equ 0 
9629			shift_bit_clk: equ 1 
9629			shift_bit_latch: equ 2 
9629			 
9629			 
9629			; shift out a byte to the sound chip 
9629			 
9629			; A contains byte to send 
9629			 
9629			shift_byte: 
9629			 
9629 06 08			ld b, 8   ; 8 bits to shift 
962b			 
962b 16 00		.nb1:	ld d, 0    ; our work byte to send to the device with flags 
962d			 
962d				; set data bit state 
962d			 
962d cb 7f			bit 7, a 
962f				; high bit is set 
962f 28 02			jr z, .nb2 
9631 cb c2			set shift_bit_data, d 
9633			 
9633				; set latches state  
9633 cb ca		.nb2:	set shift_bit_clk, d 
9635 cb 92			res shift_bit_latch, d    ; latch is inverted 
9637 ed 51			out (c), d 
9639				 
9639				; clock the bit out 
9639 cb 8a			res shift_bit_clk, d 
963b ed 51			out (c), d 
963d			 
963d				; shift a left one bit and repeat 
963d 17				rla 
963e			 
963e 10 eb			djnz .nb1 
9640			 
9640				; latch 
9640 cb d2			set shift_bit_latch, d 
9642 ed 51			out (c), d 
9644					 
9644			 
9644				; set  
9644 c9				ret 
# End of file firmware_595shiftreg.asm
