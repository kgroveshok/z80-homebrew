67cb			; handle the auto run of code from files in storage 
67cb			 
67cb			 
67cb			include "forth_startup.asm" 
67cb			; Which startup method to use? 
67cb			; 
67cb			; version 1 - allows for a single stored file to be selected to run at start up (if se storage is enabled) 
67cb			; followed by loading of a list of scripts in eeprom 
67cb			 
67cb			; version 2 - if se storage is enabled then auto load all files which begin with a '*' else use loading 
67cb			; from eeprom 
67cb			 
67cb			; Select with define in main stubs 
67cb			 
67cb			if STARTUP_V1 
67cb				include "forth_startupv1.asm" 
67cb			endif 
67cb			if STARTUP_V2 
67cb				include "forth_startupv2.asm" 
67cb			; Version 2 of the startup  
67cb			;  
67cb			; Auto load any files in bank 1 that start with a '*' 
67cb			; If no se storage then revert to using eprom 
67cb			 
67cb			 
67cb			if STORAGE_SE = 0 
67cb			 
67cb			sprompt1: db "Startup load...",0 
67cb			sprompt2: db "Run? 1=No *=End #=All",0 
67cb			 
67cb			 
67cb			 
67cb			 
67cb			forth_startup: 
67cb				ld hl, startcmds 
67cb				ld a, 0 
67cb				ld (os_last_cmd), a    ; tmp var to skip prompts if doing all 
67cb			 
67cb			.start1:	push hl 
67cb				call clear_display 
67cb				ld de, sprompt1 
67cb			        ld a, display_row_1 
67cb				call str_at_display 
67cb				ld de, sprompt2 
67cb			        ld a, display_row_2 
67cb				call str_at_display 
67cb				pop hl 
67cb				push hl 
67cb				ld e,(hl) 
67cb				inc hl 
67cb				ld d,(hl) 
67cb			        ld a, display_row_3 
67cb				call str_at_display 
67cb				call update_display 
67cb			 
67cb			 
67cb				ld a, (os_last_cmd) 
67cb			;	cp 0 
67cb				or a 
67cb				jr z, .startprompt 
67cb				call delay250ms 
67cb				jr .startdo 
67cb				 
67cb				 
67cb			 
67cb			.startprompt: 
67cb			 
67cb				ld a,display_row_4 + display_cols - 1 
67cb			        ld de, endprg 
67cb				call str_at_display 
67cb				call update_display 
67cb				call delay1s 
67cb				call cin_wait 
67cb						 
67cb				cp '*' 
67cb				jr z, .startupend1 
67cb				cp '#' 
67cb				jr nz, .startno 
67cb				ld a, 1 
67cb				ld (os_last_cmd),a 
67cb				jr .startdo 
67cb			.startno:	cp '1' 
67cb				jr z,.startnxt  
67cb			 
67cb				; exec startup line 
67cb			.startdo:	 
67cb				pop hl 
67cb				push hl 
67cb				 
67cb				ld e,(hl) 
67cb				inc hl 
67cb				ld d,(hl) 
67cb				ex de,hl 
67cb			 
67cb				push hl 
67cb			 
67cb				ld a, 0 
67cb				;ld a, FORTH_END_BUFFER 
67cb				call strlent 
67cb				inc hl   ; include zero term to copy 
67cb				ld b,0 
67cb				ld c,l 
67cb				pop hl 
67cb				ld de, scratch 
67cb				ldir 
67cb			 
67cb			 
67cb				ld hl, scratch 
67cb				call forthparse 
67cb				call forthexec 
67cb				call forthexec_cleanup 
67cb			 
67cb				ld a, display_row_4 
67cb				ld de, endprog 
67cb			 
67cb				call update_display		 
67cb			 
67cb				ld a, (os_last_cmd) 
67cb			;	cp 0 
67cb				or a 
67cb				jr nz, .startnxt 
67cb				call next_page_prompt 
67cb			        call clear_display 
67cb				call update_display		 
67cb			 
67cb				; move onto next startup line? 
67cb			.startnxt: 
67cb			 
67cb				call delay250ms 
67cb				pop hl 
67cb			 
67cb				inc hl 
67cb				inc hl 
67cb			 
67cb				push hl 
67cb				ld e, (hl) 
67cb				inc hl 
67cb				ld d, (hl) 
67cb				pop hl 
67cb				; TODO replace 0 test 
67cb			 
67cb				ex de, hl 
67cb				call ishlzero 
67cb			;	ld a,e 
67cb			;	add d 
67cb			;	cp 0    ; any left to do? 
67cb				ex de, hl 
67cb				jp nz, .start1 
67cb				jr .startupend 
67cb			 
67cb			.startupend1: pop hl 
67cb			.startupend: 
67cb			 
67cb				call clear_display 
67cb				call update_display 
67cb				ret 
67cb			endif 
