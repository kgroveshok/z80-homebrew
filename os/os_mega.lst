6a2f			; **********************************************************************  
6a2f			; **  Alphanumeric LCD support                  by Stephen C Cousins  **  
6a2f			; **********************************************************************  
6a2f			;  
6a2f			; **  Written as a Small Computer Monitor App   
6a2f			; **  Version 0.1 SCC 2018-05-16  
6a2f			; **  www.scc.me.uk  
6a2f			;  
6a2f			; **********************************************************************  
6a2f			;  
6a2f			; This module provides support for alphanumeric LCD modules using with  
6a2f			; *  HD44780 (or compatible) controller  
6a2f			; *  5 x 7 pixel fonts  
6a2f			; *  Up to 80 characters in total (eg. 4 lines of 20 characters)  
6a2f			; *  Interface via six digital outputs to the display (see below)  
6a2f			;  
6a2f			; LCD module pinout:  
6a2f			;   1  Vss   0v supply  
6a2f			;   2  Vdd   5v supply  
6a2f			;   3  Vo    LCD input voltage (near zero volts via potentiometer)  
6a2f			;   4  RS    High = data, Low = instruction  
6a2f			;   5  R/W   High = Read, Low = Write  
6a2f			;   6  E     Enable signal (active high)  
6a2f			;   7  DB0   Data bit 0  
6a2f			;   8  DB1   Data bit 1  
6a2f			;   9  DB2   Data bit 2  
6a2f			;  10  DB3   Data bit 3  
6a2f			;  11  DB4   Data bit 4  
6a2f			;  12  DB5   Data bit 5  
6a2f			;  13  DB6   Data bit 6  
6a2f			;  14  DB7   Data bit 7  
6a2f			;  15  A     Backlight anode (+)  
6a2f			;  16  K     Backlight cathode (-)  
6a2f			;  
6a2f			; This interfacing method uses 4-bit data mode and uses time delays  
6a2f			; rather than polling the display's ready status. As a result the   
6a2f			; interface only requires 6 simple output lines:  
6a2f			;   LCD E   = Microcomputer output port bit <kLCDBitE>  
6a2f			;   LCD RS  = Microcomputer output port bit <kLCDBitRS>  
6a2f			;   LCD DB4 = Microcomputer output port bit 4  
6a2f			;   LCD DB5 = Microcomputer output port bit 5  
6a2f			;   LCD DB6 = Microcomputer output port bit 6  
6a2f			;   LCD DB7 = Microcomputer output port bit 7  
6a2f			; Display's R/W is connected to 0v so it is always in write mode  
6a2f			; All 6 connections must be on the same port address <kLCDPrt>  
6a2f			; This method also allows a decent length of cable from micro to LCD  
6a2f			;  
6a2f			; **********************************************************************  
6a2f			;  
6a2f			; To include the code for any given function provided by this module,   
6a2f			; add the appropriate #REQUIRES <FunctionName> statement at the top of   
6a2f			; the parent source file.  
6a2f			; For example:  #REQUIRES   uHexPrefix  
6a2f			;  
6a2f			; Also #INCLUDE this file at some point after the #REQUIRES statements  
6a2f			; in the parent source file.  
6a2f			; For example:  #INCLUDE    ..\_CodeLibrary\Utilities.asm  
6a2f			;  
6a2f			; These are the function names provided by this module:  
6a2f			; fLCD_Init                     ;Initialise LCD  
6a2f			; fLCD_Inst                     ;Send instruction to LCD  
6a2f			; fLCD_Data                     ;Send data byte to LCD  
6a2f			; fLCD_Pos                      ;Position cursor  
6a2f			; fLCD_Str                      ;Display string  
6a2f			; fLCD_Def                      ;Define custom character  
6a2f			;  
6a2f			; **********************************************************************  
6a2f			;  
6a2f			; Requires SCMonAPI.asm to also be included in the project  
6a2f			;  
6a2f			  
6a2f			  
6a2f			; **********************************************************************  
6a2f			; **  Constants  
6a2f			; **********************************************************************  
6a2f			  
6a2f			; Constants that must be defined externally  
6a2f			;kLCDPrt:   EQU 0xc0           ;Port address used for LCD  
6a2f			;kLCDBitRS: EQU 2              ;Port bit for LCD RS signal  
6a2f			;kLCDBitE:  EQU 3              ;Port bit for LCD E signal  
6a2f			;kLCDWidth: EQU 20             ;Width in characters  
6a2f			  
6a2f			; general line offsets in any frame buffer  
6a2f			  
6a2f			  
6a2f			display_row_1: equ 0  
6a2f			display_row_2: equ display_row_1+display_cols  
6a2f			display_row_3: equ display_row_2 + display_cols  
6a2f			display_row_4: equ display_row_3 + display_cols  
6a2f			;display_row_4_eol:   
6a2f			  
6a2f			  
6a2f			; Cursor position values for the start of each line  
6a2f			  
6a2f			; E  
6a2f			kLCD_Line1: EQU 0x00   
6a2f			kLCD_Line2: EQU kLCD_Line1+kLCDWidth  
6a2f			; E1  
6a2f			kLCD_Line3: EQU kLCD_Line2+kLCDWidth  
6a2f			kLCD_Line4: EQU kLCD_Line3+kLCDWidth   
6a2f			  
6a2f			; Instructions to send as A register to fLCD_Inst  
6a2f			kLCD_Clear: EQU 00000001b     ;LCD clear  
6a2f			kLCD_Off:   EQU 00001000b     ;LCD off  
6a2f			kLCD_On:    EQU 00001100b     ;LCD on, no cursor or blink  
6a2f			kLCD_Under: EQU 00001110b     ;LCD on, cursor = underscore  
6a2f			kLCD_Blink: EQU 00001101b     ;LCD on, cursor = blink block  
6a2f			kLCD_Both:  EQU 00001111b     ;LCD on, cursor = under+blink  
6a2f			  
6a2f			; Constants used by this code module  
6a2f			kLCD_Clr:   EQU 00000001b     ;LCD command: Clear display  
6a2f			kLCD_Pos:   EQU 10000000b     ;LCD command: Position cursor  
6a2f			kLCD_Def:   EQU 01000000b     ;LCD command: Define character  
6a2f			  
6a2f			  
6a2f			  
6a2f			; **********************************************************************  
6a2f			; **  LCD support functions  
6a2f			; **********************************************************************  
6a2f			  
6a2f			; Initialise alphanumeric LCD module  
6a2f			; LCD control register codes:  
6a2f			;   DL   0 = 4-bit mode        1 = 8-bit mode  
6a2f			;   N    0 = 1-line mode       1 = 2-line mode  
6a2f			;   F    0 = Font 5 x 8        1 = Font 5 x 11  
6a2f			;   D    0 = Display off       1 = Display on  
6a2f			;   C    0 = Cursor off        1 = Cursor on  
6a2f			;   B    0 = Blinking off      1 = Blinking on  
6a2f			;   ID   0 = Decrement mode    1 = Increment mode  
6a2f			;   SH   0 = Entire shift off  1 = Entire shift on  
6a2f 3e 28		fLCD_Init:  LD   A, 40  
6a31 cd 72 6b		            CALL LCDDelay       ;Delay 40ms after power up  
6a34			; For reliable reset set 8-bit mode - 3 times  
6a34 cd 42 6b		            CALL WrFn8bit       ;Function = 8-bit mode  
6a37 cd 42 6b		            CALL WrFn8bit       ;Function = 8-bit mode  
6a3a cd 42 6b		            CALL WrFn8bit       ;Function = 8-bit mode  
6a3d			; Set 4-bit mode  
6a3d cd 3e 6b		            CALL WrFn4bit       ;Function = 4-bit mode  
6a40 cd 70 6b		            CALL LCDDelay1      ;Delay 37 us or more  
6a43			; Function set  
6a43 3e 28		            LD   A, 00101000b  ;Control reg:  0  0  1  DL N  F  x  x  
6a45 cd 68 6a		            CALL fLCD_Inst      ;2 line, display on  
6a48			; Display On/Off control  
6a48 3e 0c		            LD   A, 00001100b  ;Control reg:  0  0  0  0  1  D  C  B   
6a4a cd 68 6a		            CALL fLCD_Inst      ;Display on, cursor on, blink off  
6a4d			; Display Clear  
6a4d 3e 01		            LD   A, 00000001b  ;Control reg:  0  0  0  0  0  0  0  1  
6a4f cd 68 6a		            CALL fLCD_Inst      ;Clear display  
6a52			; Entry mode  
6a52 3e 06		            LD   A, 00000110b  ;Control reg:  0  0  0  0  0  1  ID SH  
6a54 cd 68 6a		            CALL fLCD_Inst      ;Increment mode, shift off  
6a57			; Display module now initialised  
6a57 c9			            RET  
6a58			; ok to here  
6a58			  
6a58			; decide on setting bit for LED on or off  
6a58			; Set correct bit in A  
6a58 e5			IsLED: push hl  
6a59 21 ad fd			ld hl, hardware_word+1  
6a5c cb 56			bit 2, (hl)    ; led bit  
6a5e 20 04			jr nz, .isled1  
6a60 cb 8f			res kLCDBitLED, a  
6a62 18 02			jr .isleddone  
6a64 cb cf		.isled1: set kLCDBitLED, a  
6a66			.isleddone:  	  
6a66 e1				pop hl  
6a67			  
6a67 c9				ret  
6a68			  
6a68			  
6a68			; Write instruction to LCD  
6a68			;   On entry: A = Instruction byte to be written  
6a68			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6a68 f5			fLCD_Inst:  PUSH AF  
6a69 f5			            PUSH AF  
6a6a cd 7c 6a		            CALL Wr4bits       ;Write bits 4 to 7 of instruction  
6a6d f1			            POP  AF  
6a6e 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6a6f 17			            RLA  
6a70 17			            RLA  
6a71 17			            RLA  
6a72 cd 7c 6a		            CALL Wr4bits       ;Write bits 0 to 3 of instruction  
6a75 3e 02		            LD   A, 2  
6a77 cd 72 6b		            CALL LCDDelay       ;Delay 2 ms to complete   
6a7a f1			            POP  AF  
6a7b c9			            RET  
6a7c			Wr4bits:   
6a7c f5					push af  
6a7d 3a fb fa				ld a, (display_lcde1e2)  
6a80 fe 00				cp 0     ; e  
6a82 20 13				jr nz, .wea2	  
6a84 f1					pop af  
6a85 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6a87 cd 58 6a				call IsLED  
6a8a d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a8c cb df		            SET  kLCDBitE, A	    ; TODO decide which E is being set  
6a8e cb 87		            res  kLCDBitE2, A	    ; TODO decide which E is being set  
6a90 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6a92 cb 9f		            RES  kLCDBitE, A        ; TODO decide which E is being set  
6a94 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a96 c9			            RET  
6a97 f1			.wea2:		pop af  
6a98 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6a9a cd 58 6a				call IsLED  
6a9d d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a9f cb c7		            SET  kLCDBitE2, A	    ; TODO decide which E is being set  
6aa1 cb 9f		            res  kLCDBitE, A	    ; TODO decide which E is being set  
6aa3 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6aa5 cb 87		            RES  kLCDBitE2, A        ; TODO decide which E is being set  
6aa7 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6aa9 c9			            RET  
6aaa			  
6aaa			  
6aaa			; Write data to LCD  
6aaa			;   On entry: A = Data byte to be written  
6aaa			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6aaa f5			fLCD_Data:  PUSH AF  
6aab f5			            PUSH AF  
6aac cd be 6a		            CALL Wr4bitsa       ;Write bits 4 to 7 of data byte  
6aaf f1			            POP  AF  
6ab0 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6ab1 17			            RLA  
6ab2 17			            RLA  
6ab3 17			            RLA  
6ab4 cd be 6a		            CALL Wr4bitsa       ;Write bits 0 to 3 of data byte  
6ab7 3e 96		            LD   A, 150  
6ab9 3d			Wait:      DEC  A              ;Wait a while to allow data   
6aba 20 fd		            JR   NZ, Wait      ;  write to complete  
6abc f1			            POP  AF  
6abd c9			            RET  
6abe			Wr4bitsa:     
6abe f5					push af  
6abf 3a fb fa				ld a, (display_lcde1e2)  
6ac2 fe 00				cp 0     ; e1  
6ac4 20 19				jr nz, .we2	  
6ac6 f1					pop af  
6ac7 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6ac9 cd 58 6a				call IsLED  
6acc cb d7		            SET  kLCDBitRS, A  
6ace d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6ad0 cb df		            SET  kLCDBitE, A      ; TODO Decide which E is being set  
6ad2 cb 87		            res  kLCDBitE2, A      ; TODO Decide which E is being set  
6ad4 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6ad6 cb 9f		            RES  kLCDBitE, A       ; TODO Decide which E is being set  
6ad8 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6ada cb 97		            RES  kLCDBitRS, A  
6adc d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6ade c9			            RET  
6adf f1			.we2:		pop af  
6ae0 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6ae2 cd 58 6a				call IsLED  
6ae5 cb d7		            SET  kLCDBitRS, A  
6ae7 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6ae9 cb c7		            SET  kLCDBitE2, A      ; TODO Decide which E is being set  
6aeb cb 9f		            res  kLCDBitE, A      ; TODO Decide which E is being set  
6aed d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6aef cb 87		            RES  kLCDBitE2, A       ; TODO Decide which E is being set  
6af1 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6af3 cb 97		            RES  kLCDBitRS, A  
6af5 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6af7 c9			            RET  
6af8			  
6af8			  
6af8			; Position cursor to specified location  
6af8			;   On entry: A = Cursor position  
6af8			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6af8 f5			fLCD_Pos:   PUSH AF  
6af9					; at this point set the E1 or E2 flag depending on position  
6af9			  
6af9 c5					push bc  
6afa			;		push af  
6afa 06 00				ld b, 0  
6afc 4f					ld c, a  
6afd 3e 4f				ld a, kLCD_Line3-1  
6aff b7			 		or a      ;clear carry flag  
6b00 99					sbc a,c    ; TODO may need to sub 80 from a to put in context of current frame    
6b01 38 04				jr c, .pe1  
6b03			  
6b03					; E selection  
6b03 cb 80				res 0, b         ; bit 0 unset e  
6b05			;		pop af    ; before line 3 so recover orig pos  
6b05			;		ld c, a    ; save for poking back  
6b05 18 06				jr .peset	          
6b07			.pe1:          	; E2 selection  
6b07 cb c0				set 0, b         ; bit 0 set e1  
6b09 79					ld a, c  
6b0a de 4f				sbc a, kLCD_Line3-1  
6b0c 4f					ld c, a	         ; save caculated offset  
6b0d			;		pop af     ; bin this original value now we have calculated form  
6b0d			  
6b0d			.peset:		; set bit  
6b0d 78					ld a, b  
6b0e 32 fb fa				ld (display_lcde1e2), a 	  
6b11 79					ld a, c  
6b12 c1					pop bc  
6b13			  
6b13 f6 80		            OR   kLCD_Pos       ;Prepare position cursor instruction  
6b15 cd 68 6a		            CALL fLCD_Inst      ;Write instruction to LCD  
6b18 f1			            POP  AF  
6b19 c9			            RET  
6b1a			  
6b1a			  
6b1a			; Output text string to LCD  
6b1a			;   On entry: DE = Pointer to null terminated text string  
6b1a			;   On exit:  BC HL IX IY I AF' BC' DE' HL' preserved  
6b1a 1a			fLCD_Str:   LD   A, (DE)        ;Get character from string  
6b1b b7			            OR   A              ;Null terminator?  
6b1c c8			            RET  Z              ;Yes, so finished  
6b1d cd aa 6a		            CALL fLCD_Data      ;Write character to display  
6b20 13			            INC  DE             ;Point to next character  
6b21 18 f7		            JR   fLCD_Str       ;Repeat  
6b23 c9					ret  
6b24			  
6b24			; Define custom character  
6b24			;   On entry: A = Character number (0 to 7)  
6b24			;             DE = Pointer to character bitmap data  
6b24			;   On exit:  A = Next character number  
6b24			;             DE = Next location following bitmap  
6b24			;             BC HL IX IY I AF' BC' DE' HL' preserved  
6b24			; Character is   
6b24 c5			fLCD_Def:   PUSH BC  
6b25 f5			            PUSH AF  
6b26 07			            RLCA                ;Calculate location  
6b27 07			            RLCA                ;  for bitmap data  
6b28 07			            RLCA                ;  = 8 x CharacterNumber  
6b29 f6 40		            OR   kLCD_Def       ;Prepare define character instruction  
6b2b cd 68 6a		            CALL fLCD_Inst      ;Write instruction to LCD  
6b2e 06 00		            LD   B, 0  
6b30 1a			Loop:      LD   A, (DE)        ;Get byte from bitmap  
6b31 cd aa 6a		            CALL fLCD_Data      ;Write byte to display  
6b34 13			            INC  DE             ;Point to next byte  
6b35 04			            INC  B              ;Count bytes  
6b36 cb 58		            BIT  3, B           ;Finish all 8 bytes?  
6b38 28 f6		            JR   Z, Loop       ;No, so repeat  
6b3a f1			            POP  AF  
6b3b 3c			            INC  A              ;Increment character number  
6b3c c1			            POP  BC  
6b3d c9			            RET  
6b3e			  
6b3e			  
6b3e			; **********************************************************************  
6b3e			; **  Private functions  
6b3e			; **********************************************************************  
6b3e			  
6b3e			; Write function to LCD  
6b3e			;   On entry: A = Function byte to be written  
6b3e			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6b3e 3e 20		WrFn4bit:   LD   A, 00100000b  ;4-bit mode  
6b40 18 02		            JR   WrFunc  
6b42 3e 30		WrFn8bit:   LD   A, 00110000b  ;8-bit mode  
6b44 f5			WrFunc:     PUSH AF  
6b45 f5					push af  
6b46 3a fb fa				ld a, (display_lcde1e2)  
6b49 fe 00				cp 0     ; e1  
6b4b 20 0f				jr nz, .wfea2	  
6b4d f1					pop af  
6b4e d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b50 cb df		            SET  kLCDBitE, A     ; TODO Decide which E is being set  
6b52 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6b54 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b56 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6b58 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b5a 18 0d			jr .wfskip  
6b5c f1			.wfea2:		pop af  
6b5d d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b5f cb c7		            SET  kLCDBitE2, A     ; TODO Decide which E is being set  
6b61 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6b63 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b65 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6b67 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b69 3e 05		.wfskip:            LD  A, 5  
6b6b cd 72 6b		            CALL LCDDelay       ;Delay 5 ms to complete  
6b6e f1			            POP  AF  
6b6f c9			            RET  
6b70			  
6b70			  
6b70			; Delay in milliseconds  
6b70			;   On entry: A = Number of milliseconds delay  
6b70			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6b70 3e 01		LCDDelay1:  LD   A, 1           ;Delay by 1 ms  
6b72 d5			LCDDelay:   PUSH DE  
6b73 5f			            LD   E, A           ;Delay by 'A' ms  
6b74 16 00		            LD   D, 0  
6b76 cd 62 0a		            CALL aDelayInMS  
6b79 d1			            POP  DE  
6b7a c9			            RET  
