0de8			addatohl: 
0de8 85			    add   a, l    ; A = A+L 
0de9 6f			    ld    l, a    ; L = A+L 
0dea 8c			    adc   a, h    ; A = A+L+H+carry 
0deb 95			    sub   l       ; A = H+carry 
0dec 67			    ld    h, a    ; H = H+carry 
0ded c9			ret 
