0e89 38 02			JR	C,NALPHA	;If so miss next bit 
0e8b d6 07			SUB	007h		;Else convert alpha 
0e8d			NALPHA: 
0e8d b2				OR	D		;Add hi nibble back 
0e8e c9				RET			; 
