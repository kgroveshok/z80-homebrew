0fb8			;; 	ASCII char code for 0-9,A-F in A to single hex digit 
0fb8			;;    subtract $30, if result > 9 then subtract $7 more 
0fb8			;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; 
0fb8			atohex: 
0fb8 d6 30				SUB $30 
0fba fe 0a				CP 10 
0fbc f8					RET M		; If result negative it was 0-9 so we're done 
0fbd d6 07				SUB $7		; otherwise, subtract $7 more to get to $0A-$0F 
0fbf c9					RET		 
