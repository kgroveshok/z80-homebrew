8fd2			free_check_adjacent_to_prev: 
8fd2			      ; Check if the freed block is adjacent to the prev free block 
8fd2 dd 6e 02		      ld    L, (IX+2)               ; Prev free block ptr into HL 
8fd5 dd 66 03		      ld    H, (IX+3) 
8fd8			 
8fd8 23			      inc   HL                      ; Size of prev free block into DE 
8fd9 23			      inc   HL 
8fda 5e			      ld    E, (HL) 
8fdb 23			      inc   HL 
8fdc 56			      ld    D, (HL) 
8fdd 2b			      dec   HL 
8fde 2b			      dec   HL 
8fdf 2b			      dec   HL 
