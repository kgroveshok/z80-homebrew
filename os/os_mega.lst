6d02			; **********************************************************************  
6d02			; **  Alphanumeric LCD support                  by Stephen C Cousins  **  
6d02			; **********************************************************************  
6d02			;  
6d02			; **  Written as a Small Computer Monitor App   
6d02			; **  Version 0.1 SCC 2018-05-16  
6d02			; **  www.scc.me.uk  
6d02			;  
6d02			; **********************************************************************  
6d02			;  
6d02			; This module provides support for alphanumeric LCD modules using with  
6d02			; *  HD44780 (or compatible) controller  
6d02			; *  5 x 7 pixel fonts  
6d02			; *  Up to 80 characters in total (eg. 4 lines of 20 characters)  
6d02			; *  Interface via six digital outputs to the display (see below)  
6d02			;  
6d02			; LCD module pinout:  
6d02			;   1  Vss   0v supply  
6d02			;   2  Vdd   5v supply  
6d02			;   3  Vo    LCD input voltage (near zero volts via potentiometer)  
6d02			;   4  RS    High = data, Low = instruction  
6d02			;   5  R/W   High = Read, Low = Write  
6d02			;   6  E     Enable signal (active high)  
6d02			;   7  DB0   Data bit 0  
6d02			;   8  DB1   Data bit 1  
6d02			;   9  DB2   Data bit 2  
6d02			;  10  DB3   Data bit 3  
6d02			;  11  DB4   Data bit 4  
6d02			;  12  DB5   Data bit 5  
6d02			;  13  DB6   Data bit 6  
6d02			;  14  DB7   Data bit 7  
6d02			;  15  A     Backlight anode (+)  
6d02			;  16  K     Backlight cathode (-)  
6d02			;  
6d02			; This interfacing method uses 4-bit data mode and uses time delays  
6d02			; rather than polling the display's ready status. As a result the   
6d02			; interface only requires 6 simple output lines:  
6d02			;   LCD E   = Microcomputer output port bit <kLCDBitE>  
6d02			;   LCD RS  = Microcomputer output port bit <kLCDBitRS>  
6d02			;   LCD DB4 = Microcomputer output port bit 4  
6d02			;   LCD DB5 = Microcomputer output port bit 5  
6d02			;   LCD DB6 = Microcomputer output port bit 6  
6d02			;   LCD DB7 = Microcomputer output port bit 7  
6d02			; Display's R/W is connected to 0v so it is always in write mode  
6d02			; All 6 connections must be on the same port address <kLCDPrt>  
6d02			; This method also allows a decent length of cable from micro to LCD  
6d02			;  
6d02			; **********************************************************************  
6d02			;  
6d02			; To include the code for any given function provided by this module,   
6d02			; add the appropriate #REQUIRES <FunctionName> statement at the top of   
6d02			; the parent source file.  
6d02			; For example:  #REQUIRES   uHexPrefix  
6d02			;  
6d02			; Also #INCLUDE this file at some point after the #REQUIRES statements  
6d02			; in the parent source file.  
6d02			; For example:  #INCLUDE    ..\_CodeLibrary\Utilities.asm  
6d02			;  
6d02			; These are the function names provided by this module:  
6d02			; fLCD_Init                     ;Initialise LCD  
6d02			; fLCD_Inst                     ;Send instruction to LCD  
6d02			; fLCD_Data                     ;Send data byte to LCD  
6d02			; fLCD_Pos                      ;Position cursor  
6d02			; fLCD_Str                      ;Display string  
6d02			; fLCD_Def                      ;Define custom character  
6d02			;  
6d02			; **********************************************************************  
6d02			;  
6d02			; Requires SCMonAPI.asm to also be included in the project  
6d02			;  
6d02			  
6d02			  
6d02			; **********************************************************************  
6d02			; **  Constants  
6d02			; **********************************************************************  
6d02			  
6d02			; Constants that must be defined externally  
6d02			;kLCDPrt:   EQU 0xc0           ;Port address used for LCD  
6d02			;kLCDBitRS: EQU 2              ;Port bit for LCD RS signal  
6d02			;kLCDBitE:  EQU 3              ;Port bit for LCD E signal  
6d02			;kLCDWidth: EQU 20             ;Width in characters  
6d02			  
6d02			; general line offsets in any frame buffer  
6d02			  
6d02			  
6d02			display_row_1: equ 0  
6d02			display_row_2: equ display_row_1+display_cols  
6d02			display_row_3: equ display_row_2 + display_cols  
6d02			display_row_4: equ display_row_3 + display_cols  
6d02			;display_row_4_eol:   
6d02			  
6d02			  
6d02			; Cursor position values for the start of each line  
6d02			  
6d02			; E  
6d02			kLCD_Line1: EQU 0x00   
6d02			kLCD_Line2: EQU kLCD_Line1+kLCDWidth  
6d02			; E1  
6d02			kLCD_Line3: EQU kLCD_Line2+kLCDWidth  
6d02			kLCD_Line4: EQU kLCD_Line3+kLCDWidth   
6d02			  
6d02			; Instructions to send as A register to fLCD_Inst  
6d02			kLCD_Clear: EQU 00000001b     ;LCD clear  
6d02			kLCD_Off:   EQU 00001000b     ;LCD off  
6d02			kLCD_On:    EQU 00001100b     ;LCD on, no cursor or blink  
6d02			kLCD_Under: EQU 00001110b     ;LCD on, cursor = underscore  
6d02			kLCD_Blink: EQU 00001101b     ;LCD on, cursor = blink block  
6d02			kLCD_Both:  EQU 00001111b     ;LCD on, cursor = under+blink  
6d02			  
6d02			; Constants used by this code module  
6d02			kLCD_Clr:   EQU 00000001b     ;LCD command: Clear display  
6d02			kLCD_Pos:   EQU 10000000b     ;LCD command: Position cursor  
6d02			kLCD_Def:   EQU 01000000b     ;LCD command: Define character  
6d02			  
6d02			  
6d02			  
6d02			; **********************************************************************  
6d02			; **  LCD support functions  
6d02			; **********************************************************************  
6d02			  
6d02			; Initialise alphanumeric LCD module  
6d02			; LCD control register codes:  
6d02			;   DL   0 = 4-bit mode        1 = 8-bit mode  
6d02			;   N    0 = 1-line mode       1 = 2-line mode  
6d02			;   F    0 = Font 5 x 8        1 = Font 5 x 11  
6d02			;   D    0 = Display off       1 = Display on  
6d02			;   C    0 = Cursor off        1 = Cursor on  
6d02			;   B    0 = Blinking off      1 = Blinking on  
6d02			;   ID   0 = Decrement mode    1 = Increment mode  
6d02			;   SH   0 = Entire shift off  1 = Entire shift on  
6d02 3e 28		fLCD_Init:  LD   A, 40  
6d04 cd 45 6e		            CALL LCDDelay       ;Delay 40ms after power up  
6d07			; For reliable reset set 8-bit mode - 3 times  
6d07 cd 15 6e		            CALL WrFn8bit       ;Function = 8-bit mode  
6d0a cd 15 6e		            CALL WrFn8bit       ;Function = 8-bit mode  
6d0d cd 15 6e		            CALL WrFn8bit       ;Function = 8-bit mode  
6d10			; Set 4-bit mode  
6d10 cd 11 6e		            CALL WrFn4bit       ;Function = 4-bit mode  
6d13 cd 43 6e		            CALL LCDDelay1      ;Delay 37 us or more  
6d16			; Function set  
6d16 3e 28		            LD   A, 00101000b  ;Control reg:  0  0  1  DL N  F  x  x  
6d18 cd 3b 6d		            CALL fLCD_Inst      ;2 line, display on  
6d1b			; Display On/Off control  
6d1b 3e 0c		            LD   A, 00001100b  ;Control reg:  0  0  0  0  1  D  C  B   
6d1d cd 3b 6d		            CALL fLCD_Inst      ;Display on, cursor on, blink off  
6d20			; Display Clear  
6d20 3e 01		            LD   A, 00000001b  ;Control reg:  0  0  0  0  0  0  0  1  
6d22 cd 3b 6d		            CALL fLCD_Inst      ;Clear display  
6d25			; Entry mode  
6d25 3e 06		            LD   A, 00000110b  ;Control reg:  0  0  0  0  0  1  ID SH  
6d27 cd 3b 6d		            CALL fLCD_Inst      ;Increment mode, shift off  
6d2a			; Display module now initialised  
6d2a c9			            RET  
6d2b			; ok to here  
6d2b			  
6d2b			; decide on setting bit for LED on or off  
6d2b			; Set correct bit in A  
6d2b e5			IsLED: push hl  
6d2c 21 ad fd			ld hl, hardware_word+1  
6d2f cb 56			bit 2, (hl)    ; led bit  
6d31 20 04			jr nz, .isled1  
6d33 cb 8f			res kLCDBitLED, a  
6d35 18 02			jr .isleddone  
6d37 cb cf		.isled1: set kLCDBitLED, a  
6d39			.isleddone:  	  
6d39 e1				pop hl  
6d3a			  
6d3a c9				ret  
6d3b			  
6d3b			  
6d3b			; Write instruction to LCD  
6d3b			;   On entry: A = Instruction byte to be written  
6d3b			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6d3b f5			fLCD_Inst:  PUSH AF  
6d3c f5			            PUSH AF  
6d3d cd 4f 6d		            CALL Wr4bits       ;Write bits 4 to 7 of instruction  
6d40 f1			            POP  AF  
6d41 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6d42 17			            RLA  
6d43 17			            RLA  
6d44 17			            RLA  
6d45 cd 4f 6d		            CALL Wr4bits       ;Write bits 0 to 3 of instruction  
6d48 3e 02		            LD   A, 2  
6d4a cd 45 6e		            CALL LCDDelay       ;Delay 2 ms to complete   
6d4d f1			            POP  AF  
6d4e c9			            RET  
6d4f			Wr4bits:   
6d4f f5					push af  
6d50 3a fb fa				ld a, (display_lcde1e2)  
6d53 fe 00				cp 0     ; e  
6d55 20 13				jr nz, .wea2	  
6d57 f1					pop af  
6d58 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6d5a cd 2b 6d				call IsLED  
6d5d d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6d5f cb df		            SET  kLCDBitE, A	    ; TODO decide which E is being set  
6d61 cb 87		            res  kLCDBitE2, A	    ; TODO decide which E is being set  
6d63 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6d65 cb 9f		            RES  kLCDBitE, A        ; TODO decide which E is being set  
6d67 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6d69 c9			            RET  
6d6a f1			.wea2:		pop af  
6d6b e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6d6d cd 2b 6d				call IsLED  
6d70 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6d72 cb c7		            SET  kLCDBitE2, A	    ; TODO decide which E is being set  
6d74 cb 9f		            res  kLCDBitE, A	    ; TODO decide which E is being set  
6d76 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6d78 cb 87		            RES  kLCDBitE2, A        ; TODO decide which E is being set  
6d7a d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6d7c c9			            RET  
6d7d			  
6d7d			  
6d7d			; Write data to LCD  
6d7d			;   On entry: A = Data byte to be written  
6d7d			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6d7d f5			fLCD_Data:  PUSH AF  
6d7e f5			            PUSH AF  
6d7f cd 91 6d		            CALL Wr4bitsa       ;Write bits 4 to 7 of data byte  
6d82 f1			            POP  AF  
6d83 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6d84 17			            RLA  
6d85 17			            RLA  
6d86 17			            RLA  
6d87 cd 91 6d		            CALL Wr4bitsa       ;Write bits 0 to 3 of data byte  
6d8a 3e 96		            LD   A, 150  
6d8c 3d			Wait:      DEC  A              ;Wait a while to allow data   
6d8d 20 fd		            JR   NZ, Wait      ;  write to complete  
6d8f f1			            POP  AF  
6d90 c9			            RET  
6d91			Wr4bitsa:     
6d91 f5					push af  
6d92 3a fb fa				ld a, (display_lcde1e2)  
6d95 fe 00				cp 0     ; e1  
6d97 20 19				jr nz, .we2	  
6d99 f1					pop af  
6d9a e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6d9c cd 2b 6d				call IsLED  
6d9f cb d7		            SET  kLCDBitRS, A  
