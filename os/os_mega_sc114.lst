8e41			 
8e41			malloc_guard_entry: 
8e41				push hl 
8e41				push de 
8e41				push af 
8e41			 
8e41			 	or a      ;clear carry flag 
8e41				push hl 
8e41				ld de, 255 
8e41				sbc hl, de 
8e41				jr c, .lowalloc 
8e41			 
8e41				push de 
8e41					ld hl, display_fb0 
8e41					ld (display_fb_active), hl 
8e41				call clear_display 
8e41				ld a, 0 
8e41				ld de, .mallocsize 
8e41				call str_at_display 
8e41				call update_display 
8e41				call delay1s 
8e41				call delay1s 
8e41			;	ld a, 0 
8e41			;	ld (os_view_disable), a 
8e41				call bp_on 
8e41			 
8e41				pop de 
8e41				pop hl 
8e41			 
8e41				 
8e41			 
8e41				CALLMONITOR 
8e41				jr .lowdone 
8e41			.lowalloc: 
8e41			 
8e41			 
8e41				pop hl 
8e41			.lowdone:	pop af 
8e41				pop de 
8e41				pop hl 
8e41			ret 
8e41			 
8e41			malloc_guard_exit: 
8e41				push hl 
8e41				push de 
8e41				push af 
8e41			 
8e41			 	or a      ;clear carry flag 
8e41				push hl 
8e41				ld de, 255 
8e41				sbc hl, de 
8e41				jr c, .lowallocx 
8e41			 
8e41				push de 
8e41					ld hl, display_fb0 
8e41					ld (display_fb_active), hl 
8e41				call clear_display 
8e41				ld a, 0 
8e41				ld de, .mallocasize 
8e41				call str_at_display 
8e41				call update_display 
8e41				call delay1s 
8e41				call delay1s 
8e41			;	ld a, 0 
8e41			;	ld (os_view_disable), a 
8e41				call bp_on 
