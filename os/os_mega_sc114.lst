8e61			;------------------------------------------------------------------------------ 
8e61			;     heap_init                                                               : 
8e61			;                                                                             : 
8e61			; Description                                                                 : 
8e61			;     Initialise the heap and make it ready for malloc and free operations.   : 
8e61			;                                                                             : 
8e61			;     The heap is maintained as a linked list, starting with an initial       : 
8e61			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
8e61			;     the first free block in the heap. Each block then points to the next    : 
8e61			;     free block within the heap, and the free list ends at the first block   : 
8e61			;     with a null pointer to the next free block.                             : 
8e61			;                                                                             : 
8e61			; Parameters                                                                  : 
8e61			;     Inputs are compile-time only. Two defines which specify the starting    : 
8e61			;     address of the heap and its size are required, along with a memory      : 
8e61			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
8e61			;     principally stores a pointer to the first free block in the heap.       : 
8e61			;                                                                             : 
8e61			; Returns                                                                     : 
8e61			;     Nothing                                                                 : 
8e61			;------------------------------------------------------------------------------ 
8e61			heap_init: 
8e61 e5			      push  HL 
8e62			 
8e62			      ; Initialise free list struct 
8e62 21 e8 d6		      ld    HL, heap_start 
8e65 22 e3 d6		      ld    (free_list), HL 
8e68 21 00 00		      ld    HL, 0 
8e6b 22 e5 d6		      ld    (free_list+2), HL 
8e6e			 
8e6e			      ; Insert first free block at bottom of heap, consumes entire heap 
8e6e 21 72 e2		      ld    HL, heap_start+heap_size-4 
8e71 22 e8 d6		      ld    (heap_start), HL        ; Next block (end of free list) 
8e74 21 8a 0b		      ld    HL, heap_size-4 
8e77 22 ea d6		      ld    (heap_start+2), HL      ; Block size 
8e7a			 
8e7a			      ; Insert end of free list block at top of heap - two null words will 
8e7a			      ; terminate the free list 
8e7a 21 00 00		      ld    HL, 0 
8e7d 22 74 e2		      ld    (heap_start+heap_size-2), HL 
8e80 22 72 e2		      ld    (heap_start+heap_size-4), HL 
8e83			 
8e83 e1			      pop   HL 
8e84			 
8e84 c9			      ret 
8e85			 
8e85			 
8e85			;------------------------------------------------------------------------------ 
8e85			;     malloc                                                                  : 
8e85			;                                                                             : 
8e85			; Description                                                                 : 
8e85			;     Allocates the wanted space from the heap and returns the address of the : 
8e85			;     first useable byte of the allocation.                                   : 
8e85			;                                                                             : 
8e85			;     Allocations can happen in one of two ways:                              : 
8e85			;                                                                             : 
8e85			;     1. A free block may be found which is the exact size wanted. In this    : 
8e85			;        case the block is removed from the free list and retuedn to the      : 
8e85			;        caller.                                                              : 
8e85			;     2. A free block may be found which is larger than the size wanted. In   : 
8e85			;        this case, the larger block is split into two. The first portion of  : 
8e85			;        this block will become the requested space by the malloc call and    : 
8e85			;        is returned to the caller. The second portion becomes a new free     : 
8e85			;        block, and the free list is adjusted to maintain continuity via this : 
8e85			;        newly created block.                                                 : 
8e85			;                                                                             : 
8e85			;     malloc does not set any initial value in the allocated space, the       : 
8e85			;     caller is required to do this as required.                              : 
8e85			;                                                                             : 
8e85			;     This implementation of malloc uses the stack exclusively, and is        : 
8e85			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
8e85			;     advisable to disable interrupts before calling malloc, and recommended  : 
8e85			;     to avoid the use of malloc inside ISRs in general.                      : 
8e85			;                                                                             : 
8e85			;     NOTE: heap_init must be called before malloc and free can be used.      : 
8e85			;                                                                             : 
8e85			; Parameters                                                                  : 
8e85			;     HL  Number of bytes wanted                                              : 
8e85			;                                                                             : 
8e85			; Returns                                                                     : 
8e85			;     HL  Address of the first useable byte of the allocation                 : 
8e85			;                                                                             : 
8e85			; Flags                                                                       : 
8e85			;     Z   Set if the allocation did not succeed, clear otherwise              : 
8e85			;                                                                             : 
8e85			; Stack frame                                                                 : 
8e85			;       |             |                                                       : 
8e85			;       +-------------+                                                       : 
8e85			;       |     BC      |                                                       : 
8e85			;       +-------------+                                                       : 
8e85			;       |     DE      |                                                       : 
8e85			;       +-------------+                                                       : 
8e85			;       |     IX      |                                                       : 
8e85			;       +-------------+                                                       : 
8e85			;       |  prev_free  |                                                       : 
8e85			;   +4  +-------------+                                                       : 
8e85			;       |  this_free  |                                                       : 
8e85			;   +2  +-------------+                                                       : 
8e85			;       |  next_free  |                                                       : 
8e85			;   +0  +-------------+                                                       : 
8e85			;       |             |                                                       : 
8e85			;                                                                             : 
8e85			;------------------------------------------------------------------------------ 
8e85			 
8e85			 
8e85			;malloc: 
8e85			; 
8e85			;	SAVESP ON 1 
8e85			; 
8e85			;	call malloc_code 
8e85			; 
8e85			;	CHECKSP ON 1 
8e85			;	ret 
8e85			 
