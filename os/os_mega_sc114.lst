907e 47				ld b, a 
907f 2a 45 ea		.tl:	ld hl, (tape_tm_high) 
9082			; keep the same pulse size and instead use count of pulse rather than length of pulse 
9082			;	ld hl, (tape_tm_low) 
9082 cd 45 90			call tape_osc 
9085 10 f8			djnz .tl 
9087 c9				 ret 
9088			 
