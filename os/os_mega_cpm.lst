0ba0 17			    rla 
0ba1 ed 6a		    adc hl,hl 
0ba3 ed 52		    sbc hl,de 
0ba5 30 01		    jr nc,Div16_NoAdd1 
0ba7 19			    add hl,de 
0ba8			Div16_NoAdd1: 
0ba8 10 f6		    djnz Div16_Loop1 
0baa 17			    rla 
0bab 2f			    cpl 
0bac 47			    ld b,a 
0bad 79			    ld a,c 
0bae 48			    ld c,b 
0baf 06 08		    ld b,8 
0bb1			Div16_Loop2: 
