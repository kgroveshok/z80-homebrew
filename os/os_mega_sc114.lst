d52a				call storage_get_block_0 
d52a			 
d52a				ld a, (store_page+STORE_0_AUTOFILE) 
d52a			 
d52a				cp 0 
d52a				ret z     ; auto start not enabled 
d52a			 
d52a				call clear_display 
d52a			 
d52a				; set bank 
d52a			 
d52a					ld a, (store_page+STORE_0_BANKRUN) 
d52a					ld (spi_device), a 
d52a			 
d52a				; get file id to load from and get the file name to display 
d52a			 
d52a					ld a, (store_page+STORE_0_FILERUN) 
d52a			 
d52a					ld l, 0 
d52a					ld h, a 
d52a					ld de, store_page 
d52a			 
d52a					if DEBUG_FORTH_WORDS 
d52a						DMARK "ASp" 
d52a						CALLMONITOR 
d52a					endif 
d52a					call storage_read 
d52a			 
d52a					if DEBUG_FORTH_WORDS 
d52a						DMARK "ASr" 
d52a						CALLMONITOR 
d52a					endif 
d52a			 
d52a					call ishlzero 
d52a					ret z             ; file not found 
d52a			 
d52a					ld a, display_row_2 + 10 
d52a					ld de, store_page+3 
d52a					call str_at_display 
d52a				 
d52a			; 
d52a			 
d52a				ld a, display_row_1+5 
d52a				ld de, sprompt3 
d52a				call str_at_display 
d52a				ld a, display_row_3+15 
d52a				ld de, sprompt4 
d52a				call str_at_display 
d52a			 
d52a				call update_display 
d52a			 
d52a				call cin_wait 
d52a				cp 'n' 
d52a				ret z 
d52a				cp 'N' 
d52a				ret z 
d52a			 
d52a				call delay1s 
d52a			 
d52a				ld a, (store_page+2) 
d52a				ld (store_openmaxext), a    ; save count of ext 
d52a				ld a, 1  
d52a				ld (store_openext), a    ; save count of ext 
d52a			 
d52a			.autof:  
d52a				ld l , a 
d52a				 
d52a				ld a, (store_page) 
d52a				ld h, a	 
d52a				ld de, store_page 
d52a					if DEBUG_FORTH_WORDS 
d52a						DMARK "ASl" 
d52a						CALLMONITOR 
d52a					endif 
d52a					call storage_read 
d52a				call ishlzero 
d52a				ret z 
d52a			;	jr z, .autoend 
d52a			 
d52a					if DEBUG_FORTH_WORDS 
d52a						DMARK "ASc" 
d52a						CALLMONITOR 
d52a					endif 
d52a				ld de, store_page+2 
d52a				ld a, display_row_4 
d52a				call str_at_display 
d52a			 
d52a				call update_display 
d52a				call delay250ms 
d52a			 
d52a			 
d52a			 
d52a				ld hl, store_page+2 
d52a				call forthparse 
d52a				call forthexec 
d52a				call forthexec_cleanup 
d52a			 
d52a				 
d52a				ld a, (store_openext) 
d52a				inc a 
d52a				ld (store_openext), a    ; save count of ext 
d52a			 
d52a				jr .autof 
d52a			;.autofdone: 
