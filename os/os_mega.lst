0fc0			 
0fc0			BYTERD: 
0fc0 16 00			LD	D,00h		;Set up 
0fc2 cd ca 0f			CALL	HEXCON		;Get byte and convert to hex 
0fc5 87				ADD	A,A		;First nibble so 
0fc6 87				ADD	A,A		;multiply by 16 
0fc7 87				ADD	A,A		; 
0fc8 87				ADD	A,A		; 
0fc9 57				LD	D,A		;Save hi nibble in D 
0fca			HEXCON: 
0fca 7e				ld a, (hl)		;Get next chr 
0fcb 23				inc hl 
0fcc d6 30			SUB	030h		;Makes '0'-'9' equal 0-9 
0fce fe 0a			CP	00Ah		;Is it 0-9 ? 
0fd0 38 02			JR	C,NALPHA	;If so miss next bit 
0fd2 d6 07			SUB	007h		;Else convert alpha 
0fd4			NALPHA: 
0fd4 b2				OR	D		;Add hi nibble back 
0fd5 c9				RET			; 
