11dd			; Select storage bank 
11dd			 
11dd			.selbank: 
11dd			 
11dd			if STARTUP_V2 
11dd			;	if STORAGE_SE 
11dd			;	else 
11dd			 
11dd				ld hl, prom_banks 
11dd				call menu 
11dd				cp 0 
11dd				ret z 
11dd				 
11dd				; set the bank number from the result 
11dd			 
11dd				 
11dd					ld c, SPI_CE_HIGH 
11dd					ld b, '0'    ; human readable bank number 
11dd			 
11dd			 
11dd					; active low 
11dd			 
11dd			;		cp 0 
11dd					or a 
11dd					jr z, .bset 
11dd					cp 1 
11dd					jr nz, .b2 
11dd					res 0, c 
11dd					ld b, '1'    ; human readable bank number 
11dd			.b2:		cp 2 
11dd					jr nz, .b3 
11dd					res 1, c 
11dd					ld b, '2'    ; human readable bank number 
11dd			.b3:		cp 3 
11dd					jr nz, .b4 
11dd					res 2, c 
11dd					ld b, '3'    ; human readable bank number 
11dd			.b4:		cp 4 
11dd					jr nz, .b5 
11dd					res 3, c 
11dd					ld b, '4'    ; human readable bank number 
11dd			.b5:		cp 5 
11dd					jr nz, .bset 
11dd					res 4, c 
11dd					ld b, '5'    ; human readable bank number 
11dd			 
11dd			.bset: 
11dd			 
11dd					ld a, c 
11dd			;		ld (spi_device),a 
11dd					ld a, b 
11dd			;		ld (spi_device_id),a 
11dd					push bc 
11dd			 
11dd					; select bank 1 and load block 0  
11dd			 
11dd				ld a, $fe      ; bit 0 clear 
11dd				ld (spi_device), a 
11dd			 
11dd				call storage_get_block_0 
11dd			 
11dd				pop bc 
11dd				ld a,c 
11dd				ld (store_page+STORE_0_BANKRUN), a 
11dd				ld a,b 
11dd				ld (store_page+STORE_0_BANKRUNN), a 
11dd					ld hl, 0 
11dd					ld de, store_page 
11dd				call storage_write_block 
11dd			 
11dd			else 
11dd 21 06 15			ld hl, prom_notav 
11e0 11 1c 15			ld de, prom_empty 
11e3 cd 4b 09			call info_panel 
11e6			;	endif 
11e6				 
11e6			endif 
11e6 c9				ret 
