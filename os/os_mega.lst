0dda ed 52			sbc hl,de 
0ddc e0				ret po 
0ddd 7c				ld a,h 
0dde 1f				rra 
0ddf ee 40			xor 01000000B 
0de1 37				scf 
0de2 8f				adc a,a 
0de3 c9				ret 
