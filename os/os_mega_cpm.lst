10d3			 
10d3			;------------------------------------------------------------------------------ 
10d3			;     free                                                                    : 
10d3			;                                                                             : 
10d3			; Description                                                                 : 
10d3			;     Return the space pointed to by HL to the heap. HL must be an address as : 
10d3			;     returned by malloc, otherwise the behaviour is undefined.               : 
10d3			;                                                                             : 
10d3			;     Where possible, directly adjacent free blocks will be merged together   : 
10d3			;     into larger blocks to help ensure that the heap does not become         : 
10d3			;     excessively fragmented.                                                 : 
10d3			;                                                                             : 
10d3			;     free does not clear or set any other value into the freed space, and    : 
10d3			;     therefore its contents may be visible through subsequent malloc's. The  : 
10d3			;     caller should clear the freed space as required.                        : 
10d3			;                                                                             : 
10d3			;     This implementation of free uses the stack exclusively, and is          : 
10d3			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
10d3			;     advisable to disable interrupts before calling free, and recommended    : 
10d3			;     to avoid the use of free inside ISRs in general.                        : 
10d3			;                                                                             : 
10d3			;     NOTE: heap_init must be called before malloc and free can be used.      : 
10d3			;                                                                             : 
10d3			; Parameters                                                                  : 
10d3			;     HL  Pointer to address of first byte of allocation to be freed          : 
10d3			;                                                                             : 
10d3			; Returns                                                                     : 
10d3			;     Nothing                                                                 : 
10d3			;                                                                             : 
10d3			; Stack frame                                                                 : 
10d3			;       |             |                                                       : 
10d3			;       +-------------+                                                       : 
10d3			;       |     BC      |                                                       : 
10d3			;       +-------------+                                                       : 
10d3			;       |     DE      |                                                       : 
10d3			;       +-------------+                                                       : 
10d3			;       |     IX      |                                                       : 
10d3			;       +-------------+                                                       : 
10d3			;       |  prev_free  |                                                       : 
10d3			;   +2  +-------------+                                                       : 
10d3			;       |  next_free  |                                                       : 
10d3			;   +0  +-------------+                                                       : 
10d3			;       |             |                                                       : 
10d3			;                                                                             : 
10d3			;------------------------------------------------------------------------------ 
10d3			free: 
10d3 c5			      push  BC 
10d4 d5			      push  DE 
10d5 dd e5		      push  IX 
10d7			 
10d7 7c			      ld    A, H                    ; Exit if ptr is null 
10d8 b5			      or    L 
10d9 ca 9d 11		      jp    Z, free_early_exit 
10dc			 
10dc			      ; Set up stack frame 
10dc eb			      ex    DE, HL 
10dd 21 fc ff		      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
10e0 39			      add   HL, SP 
10e1 f9			      ld    SP, HL 
10e2 dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
10e6 dd 39		      add   IX, SP 
10e8			 
10e8			      ; The address in HL points to the start of the useable allocated space, 
10e8			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
10e8			      ; address of the block itself. 
10e8 eb			      ex    DE, HL 
10e9 11 fc ff		      ld    DE, -4 
10ec 19			      add   HL, DE 
10ed			 
10ed			      ; An allocated block must have a null next block pointer in it 
10ed 7e			      ld    A, (HL) 
10ee 23			      inc   HL 
10ef b6			      or    (HL) 
10f0 c2 98 11		      jp    NZ, free_done 
10f3			 
10f3 2b			      dec   HL 
10f4			 
10f4 44			      ld    B, H                    ; Copy HL to BC 
10f5 4d			      ld    C, L 
10f6			 
10f6			      ; Loop through the free list to find the first block with an address 
10f6			      ; higher than the block being freed 
10f6 21 9b 5b		      ld    HL, free_list 
10f9			 
10f9			free_find_higher_block: 
10f9 5e			      ld    E, (HL)                 ; Load next ptr from free block 
10fa 23			      inc   HL 
10fb 56			      ld    D, (HL) 
10fc 2b			      dec   HL 
10fd			 
10fd dd 73 00		      ld    (IX+0), E               ; Save ptr to next free block 
1100 dd 72 01		      ld    (IX+1), D 
1103 dd 75 02		      ld    (IX+2), L               ; Save ptr to prev free block 
1106 dd 74 03		      ld    (IX+3), H 
1109			 
1109 78			      ld    A, B                    ; Check if DE is greater than BC 
110a ba			      cp    D                       ; Compare MSB first 
110b 28 02		      jr    Z, $+4                  ; MSB the same, compare LSB 
110d 30 04		      jr    NC, free_find_higher_block_skip 
110f 79			      ld    A, C 
1110 bb			      cp    E                       ; Then compare LSB 
1111 38 08		      jr    C, free_found_higher_block 
1113			 
1113			free_find_higher_block_skip: 
1113 7a			      ld    A, D                    ; Reached the end of the free list? 
1114 b3			      or    E 
1115 ca 98 11		      jp    Z, free_done 
1118			 
1118 eb			      ex    DE, HL 
1119			 
1119 18 de		      jr    free_find_higher_block 
111b			 
111b			free_found_higher_block: 
111b			      ; Insert freed block between prev and next free blocks 
111b 71			      ld    (HL), C                 ; Point prev free block to freed block 
111c 23			      inc   HL 
111d 70			      ld    (HL), B 
111e			 
111e 60			      ld    H, B                    ; Point freed block at next free block 
111f 69			      ld    L, C 
1120 73			      ld    (HL), E 
1121 23			      inc   HL 
1122 72			      ld    (HL), D 
1123			 
1123			      ; Check if the freed block is adjacent to the next free block 
1123 23			      inc   HL                      ; Load size of freed block into HL 
1124 5e			      ld    E, (HL) 
1125 23			      inc   HL 
1126 56			      ld    D, (HL) 
1127 eb			      ex    DE, HL 
1128			 
1128 09			      add   HL, BC                  ; Add addr of freed block and its size 
1129			 
1129 dd 5e 00		      ld    E, (IX+0)               ; Load addr of next free block into DE 
112c dd 56 01		      ld    D, (IX+1) 
112f			 
112f b7			      or    A                       ; Clear the carry flag 
1130 ed 52		      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
1132 20 22		      jr    NZ, free_check_adjacent_to_prev 
1134			 
1134			      ; Freed block is adjacent to next, merge into one bigger block 
1134 eb			      ex    DE, HL                  ; Load next ptr from next block into DE 
1135 5e			      ld    E, (HL) 
1136 23			      inc   HL 
1137 56			      ld    D, (HL) 
1138 e5			      push  HL                      ; Save ptr to next block for later 
1139			 
1139 60			      ld    H, B                    ; Store ptr from next block into freed block 
113a 69			      ld    L, C 
113b 73			      ld    (HL), E 
113c 23			      inc   HL 
113d 72			      ld    (HL), D 
113e			 
113e e1			      pop   HL                      ; Restore ptr to next block 
113f 23			      inc   HL                      ; Load size of next block into DE 
1140 5e			      ld    E, (HL) 
1141 23			      inc   HL 
1142 56			      ld    D, (HL) 
1143 d5			      push  DE                      ; Save next block size for later 
1144			 
1144 60			      ld    H, B                    ; Load size of freed block into HL 
1145 69			      ld    L, C 
1146 23			      inc   HL 
1147 23			      inc   HL 
1148 5e			      ld    E, (HL) 
1149 23			      inc   HL 
114a 56			      ld    D, (HL) 
114b eb			      ex    DE, HL 
114c			 
114c d1			      pop   DE                      ; Restore size of next block 
114d 19			      add   HL, DE                  ; Add sizes of both blocks 
114e eb			      ex    DE, HL 
114f			 
114f 60			      ld    H, B                    ; Store new bigger size into freed block 
1150 69			      ld    L, C 
1151 23			      inc   HL 
1152 23			      inc   HL 
1153 73			      ld    (HL), E 
1154 23			      inc   HL 
1155 72			      ld    (HL), D 
1156			 
1156			free_check_adjacent_to_prev: 
1156			      ; Check if the freed block is adjacent to the prev free block 
1156 dd 6e 02		      ld    L, (IX+2)               ; Prev free block ptr into HL 
1159 dd 66 03		      ld    H, (IX+3) 
115c			 
115c 23			      inc   HL                      ; Size of prev free block into DE 
115d 23			      inc   HL 
115e 5e			      ld    E, (HL) 
115f 23			      inc   HL 
1160 56			      ld    D, (HL) 
1161 2b			      dec   HL 
1162 2b			      dec   HL 
1163 2b			      dec   HL 
1164			 
1164 19			      add   HL, DE                  ; Add prev block addr and size 
1165			 
1165 b7			      or    A                       ; Clear the carry flag 
1166 ed 42		      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
1168 20 2e		      jr    NZ, free_done 
116a			 
116a			      ; Freed block is adjacent to prev, merge into one bigger block 
116a 60			      ld    H, B                    ; Load next ptr from freed block into DE 
116b 69			      ld    L, C 
116c 5e			      ld    E, (HL) 
116d 23			      inc   HL 
116e 56			      ld    D, (HL) 
116f e5			      push  HL                      ; Save freed block ptr for later 
1170			 
1170 dd 6e 02		      ld    L, (IX+2)               ; Store freed block ptr into prev block 
1173 dd 66 03		      ld    H, (IX+3) 
1176 73			      ld    (HL), E 
1177 23			      inc   HL 
1178 72			      ld    (HL), D 
1179			 
1179 e1			      pop   HL                      ; Restore freed block ptr 
117a 23			      inc   HL                      ; Load size of freed block into DE 
117b 5e			      ld    E, (HL) 
117c 23			      inc   HL 
117d 56			      ld    D, (HL) 
117e d5			      push  DE                      ; Save freed block size for later 
117f			 
117f dd 6e 02		      ld    L, (IX+2)               ; Load size of prev block into DE 
1182 dd 66 03		      ld    H, (IX+3) 
1185 23			      inc   HL 
1186 23			      inc   HL 
1187 5e			      ld    E, (HL) 
1188 23			      inc   HL 
1189 56			      ld    D, (HL) 
118a			 
118a e1			      pop   HL                      ; Add sizes of both blocks 
118b 19			      add   HL, DE 
118c eb			      ex    DE, HL 
118d			 
118d dd 6e 02		      ld    L, (IX+2)               ; Store new bigger size into prev block 
1190 dd 66 03		      ld    H, (IX+3) 
1193 23			      inc   HL 
1194 23			      inc   HL 
1195 73			      ld    (HL), E 
1196 23			      inc   HL 
1197 72			      ld    (HL), D 
1198			 
1198			free_done: 
1198 21 04 00		      ld    HL, 4                   ; Clean up stack frame 
119b 39			      add   HL, SP 
119c f9			      ld    SP, HL 
119d			 
119d			free_early_exit: 
119d dd e1		      pop   IX 
119f d1			      pop   DE 
11a0 c1			      pop   BC 
11a1			 
11a1 c9			      ret 
11a2			 
11a2			; moved to firmware.asm 
11a2			; 
11a2			;free_list         .dw   0     ; Block struct for start of free list (MUST be 4 bytes) 
11a2			;                  .dw   0 
11a2			 
11a2			 
11a2			endif 
11a2			 
11a2			 
11a2			if MALLOC_3 
11a2			; https://gist.githubusercontent.com/tomstorey/947a8b084bad69391a4b2a1c5b6d69ca/raw/5a08fb30a480d98c0deb4a6afe2d48961cc8e9d9/z80_malloc.s 
11a2			;heap_start        .equ  0x9000      ; Starting address of heap 
11a2			;heap_size         .equ  0x0100      ; Number of bytes available in heap 
11a2			; 
11a2			 ;     .org 0 
11a2			  ;    jp    main 
11a2			; 
11a2			; 
11a2			 ;     .org  0x100 
11a2			;main: 
11a2			 ;     ld    HL, 0x8100 
11a2			  ;    ld    SP, HL 
11a2			; 
11a2			;      call  heap_init 
11a2			 
11a2			      ; Make some allocations 
11a2			;      ld    HL, 12 
11a2			;      call  malloc            ; Allocates 0x9004 
11a2			; 
11a2			 ;     ld    HL, 12 
11a2			;      call  malloc            ; Allocates 0x9014 
11a2			 
11a2			;      ld    HL, 12 
11a2			;      call  malloc            ; Allocates 0x9024 
11a2			 
11a2			      ; Free some allocations 
11a2			;      ld    HL, 0x9014 
11a2			;      call  free 
11a2			 
11a2			;      ld    HL, 0x9004 
11a2			;      call  free 
11a2			; 
11a2			;      ld    HL, 0x9024 
11a2			;      call  free 
11a2			 
11a2			 
11a2			 ;     halt 
11a2			 
11a2			 
11a2			;------------------------------------------------------------------------------ 
11a2			;     heap_init                                                               : 
11a2			;                                                                             : 
11a2			; Description                                                                 : 
11a2			;     Initialise the heap and make it ready for malloc and free operations.   : 
11a2			;                                                                             : 
11a2			;     The heap is maintained as a linked list, starting with an initial       : 
11a2			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
11a2			;     the first free block in the heap. Each block then points to the next    : 
11a2			;     free block within the heap, and the free list ends at the first block   : 
11a2			;     with a null pointer to the next free block.                             : 
11a2			;                                                                             : 
11a2			; Parameters                                                                  : 
11a2			;     Inputs are compile-time only. Two defines which specify the starting    : 
11a2			;     address of the heap and its size are required, along with a memory      : 
11a2			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
11a2			;     principally stores a pointer to the first free block in the heap.       : 
11a2			;                                                                             : 
11a2			; Returns                                                                     : 
11a2			;     Nothing                                                                 : 
11a2			;------------------------------------------------------------------------------ 
11a2			heap_init: 
11a2			      push  HL 
11a2			 
11a2			      ; Initialise free list struct 
11a2			      ld    HL, heap_start 
11a2			      ld    (free_list), HL 
11a2			      ld    HL, 0 
11a2			      ld    (free_list+2), HL 
11a2			 
11a2			      ; Insert first free block at bottom of heap, consumes entire heap 
11a2			      ld    HL, heap_start+heap_size-4 
11a2			      ld    (heap_start), HL        ; Next block (end of free list) 
11a2			      ld    HL, heap_size-4 
11a2			      ld    (heap_start+2), HL      ; Block size 
11a2			 
11a2			      ; Insert end of free list block at top of heap - two null words will 
11a2			      ; terminate the free list 
11a2			      ld    HL, 0 
11a2			      ld    (heap_start+heap_size-2), HL 
11a2			      ld    (heap_start+heap_size-4), HL 
11a2			 
11a2			      pop   HL 
11a2			 
11a2			      ret 
11a2			 
11a2			 
11a2			;------------------------------------------------------------------------------ 
11a2			;     malloc                                                                  : 
11a2			;                                                                             : 
11a2			; Description                                                                 : 
11a2			;     Allocates the wanted space from the heap and returns the address of the : 
11a2			;     first useable byte of the allocation.                                   : 
11a2			;                                                                             : 
11a2			;     Allocations can happen in one of two ways:                              : 
11a2			;                                                                             : 
11a2			;     1. A free block may be found which is the exact size wanted. In this    : 
11a2			;        case the block is removed from the free list and retuedn to the      : 
11a2			;        caller.                                                              : 
11a2			;     2. A free block may be found which is larger than the size wanted. In   : 
11a2			;        this case, the larger block is split into two. The first portion of  : 
11a2			;        this block will become the requested space by the malloc call and    : 
11a2			;        is returned to the caller. The second portion becomes a new free     : 
11a2			;        block, and the free list is adjusted to maintain continuity via this : 
11a2			;        newly created block.                                                 : 
11a2			;                                                                             : 
11a2			;     malloc does not set any initial value in the allocated space, the       : 
11a2			;     caller is required to do this as required.                              : 
11a2			;                                                                             : 
11a2			;     This implementation of malloc uses the stack exclusively, and is        : 
11a2			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
11a2			;     advisable to disable interrupts before calling malloc, and recommended  : 
11a2			;     to avoid the use of malloc inside ISRs in general.                      : 
11a2			;                                                                             : 
11a2			;     NOTE: heap_init must be called before malloc and free can be used.      : 
11a2			;                                                                             : 
11a2			; Parameters                                                                  : 
11a2			;     HL  Number of bytes wanted                                              : 
11a2			;                                                                             : 
11a2			; Returns                                                                     : 
11a2			;     HL  Address of the first useable byte of the allocation                 : 
11a2			;                                                                             : 
11a2			; Flags                                                                       : 
11a2			;     Z   Set if the allocation did not succeed, clear otherwise              : 
11a2			;                                                                             : 
11a2			; Stack frame                                                                 : 
11a2			;       |             |                                                       : 
11a2			;       +-------------+                                                       : 
11a2			;       |     BC      |                                                       : 
11a2			;       +-------------+                                                       : 
11a2			;       |     DE      |                                                       : 
11a2			;       +-------------+                                                       : 
11a2			;       |     IX      |                                                       : 
11a2			;       +-------------+                                                       : 
11a2			;       |  prev_free  |                                                       : 
11a2			;   +4  +-------------+                                                       : 
11a2			;       |  this_free  |                                                       : 
11a2			;   +2  +-------------+                                                       : 
11a2			;       |  next_free  |                                                       : 
11a2			;   +0  +-------------+                                                       : 
11a2			;       |             |                                                       : 
11a2			;                                                                             : 
11a2			;------------------------------------------------------------------------------ 
11a2			malloc: 
11a2			      push  BC 
11a2			      push  DE 
11a2			      push  IX 
11a2			 
11a2			      ld    A, H                    ; Exit if no space requested 
11a2			      or    L 
11a2			      jp    Z, malloc_early_exit 
11a2			 
11a2			      ; Set up stack frame 
11a2			      ex    DE, HL 
11a2			      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
11a2			      add   HL, SP 
11a2			      ld    SP, HL 
11a2			      ld    IX, 0                   ; Use IX as a frame pointer 
11a2			      add   IX, SP 
11a2			 
11a2			      ; Setup initial state 
11a2			      ld    HL, 4                   ; want must also include space used by block struct 
11a2			      add   HL, DE 
11a2			 
11a2			      ld    B, H                    ; Move want to BC 
11a2			      ld    C, L 
11a2			 
11a2			      ld    HL, free_list           ; Store prev_free ptr to stack 
11a2			      ld    (IX+4), L 
11a2			      ld    (IX+5), H 
11a2			 
11a2			      ld    E, (HL)                 ; Store this_free ptr to stack 
11a2			      inc   HL 
11a2			      ld    D, (HL) 
11a2			      ld    (IX+2), E 
11a2			      ld    (IX+3), D 
11a2			      ex    DE, HL                  ; this_free ptr into HL 
11a2			 
11a2			      ; Loop through free block list to find some space 
11a2			malloc_find_space: 
11a2			      ld    E, (HL)                 ; Load next_free ptr into DE 
11a2			      inc   HL 
11a2			      ld    D, (HL) 
11a2			 
11a2			      ld    A, D                    ; Check for null next_free ptr - end of free list 
11a2			      or    E 
11a2			      jp    Z, malloc_no_space 
11a2			 
11a2			      ld    (IX+0), E               ; Store next_free ptr to stack 
11a2			      ld    (IX+1), D 
11a2			 
11a2			      ; Does this block have enough space to make the allocation? 
11a2			      inc   HL                      ; Load free block size into DE 
11a2			      ld    E, (HL) 
11a2			      inc   HL 
11a2			      ld    D, (HL) 
11a2			 
11a2			      ex    DE, HL                  ; Check size of block against want 
11a2			      or    A                       ; Ensure carry flag clear 
11a2			      sbc   HL, BC 
11a2			      push  HL                      ; Store the result for later (new block size) 
11a2			 
11a2			      jr    Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
11a2			      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
11a2			 
11a2			      ; this_free block is not big enough, setup ptrs to test next free block 
11a2			      pop   HL                      ; Discard previous result 
11a2			 
11a2			      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
11a2			      ld    H, (IX+3) 
11a2			      ld    (IX+4), L 
11a2			      ld    (IX+5), H 
11a2			 
11a2			      ld    L, (IX+0)               ; Move next_free ptr into this_free 
11a2			      ld    H, (IX+1) 
11a2			      ld    (IX+2), L 
11a2			      ld    (IX+3), H 
11a2			 
11a2			      jr    malloc_find_space 
11a2			 
11a2			      ; split a bigger block into two - requested size and remaining size 
11a2			malloc_alloc_split: 
11a2			      ex    DE, HL                  ; Calculate address of new free block 
11a2			      dec   HL 
11a2			      dec   HL 
11a2			      dec   HL 
11a2			      add   HL, BC 
11a2			 
11a2			      ; Create a new block and point it at next_free 
11a2			      ld    E, (IX+0)               ; Load next_free ptr into DE 
11a2			      ld    D, (IX+1) 
11a2			 
11a2			      ld    (HL), E                 ; Store next_free ptr into new block 
11a2			      inc   HL 
11a2			      ld    (HL), D 
11a2			 
11a2			      pop   DE                      ; Store size of new block into new block 
11a2			      inc   HL 
11a2			      ld    (HL), E 
11a2			      inc   HL 
11a2			      ld    (HL), D 
11a2			 
11a2			      ; Update this_free ptr to point to new block 
11a2			      dec   HL 
11a2			      dec   HL 
11a2			      dec   HL 
11a2			 
11a2			      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
11a2			      ld    D, (IX+3) 
11a2			 
11a2			      ld    (IX+2), L               ; Store new block addr as this_free ptr 
11a2			      ld    (IX+3), H 
11a2			 
11a2			      ; Modify this_free block to be allocation 
11a2			      ex    DE, HL 
11a2			      xor   A                       ; Null the next block ptr of allocated block 
11a2			      ld    (HL), A 
11a2			      inc   HL 
11a2			      ld    (HL), A 
11a2			 
11a2			      inc   HL                      ; Store want size into allocated block 
11a2			      ld    (HL), C 
11a2			      inc   HL 
11a2			      ld    (HL), B 
11a2			      inc   HL 
11a2			      push  HL                      ; Address of allocation to return 
11a2			 
11a2			      jr    malloc_update_links 
11a2			 
11a2			malloc_alloc_fit: 
11a2			      pop   HL                      ; Dont need new block size, want is exact fit 
11a2			 
11a2			      ; Modify this_free block to be allocation 
11a2			      ex    DE, HL 
11a2			      dec   HL 
11a2			      dec   HL 
11a2			      dec   HL 
11a2			 
11a2			      xor   A                       ; Null the next block ptr of allocated block 
11a2			      ld    (HL), A 
11a2			      inc   HL 
11a2			      ld    (HL), A 
11a2			 
11a2			      inc   HL                      ; Store address of allocation to return 
11a2			      inc   HL 
11a2			      inc   HL 
11a2			      push  HL 
11a2			 
11a2			      ; Copy next_free ptr to this_free, remove allocated block from free list 
11a2			      ld    L, (IX+0)               ; next_free to HL 
11a2			      ld    H, (IX+1) 
11a2			 
11a2			      ld    (IX+2), L               ; HL to this_free 
11a2			      ld    (IX+3), H 
11a2			 
11a2			 
11a2			malloc_update_links: 
11a2			      ; Update prev_free ptr to point to this_free 
11a2			      ld    L, (IX+4)               ; prev_free ptr to HL 
11a2			      ld    H, (IX+5) 
11a2			 
11a2			      ld    E, (IX+2)               ; this_free ptr to DE 
11a2			      ld    D, (IX+3) 
11a2			 
11a2			      ld    (HL), E                 ; this_free ptr into prev_free 
11a2			      inc   HL 
11a2			      ld    (HL), D 
11a2			 
11a2			      ; Clear the Z flag to indicate successful allocation 
11a2			      ld    A, D 
11a2			      or    E 
11a2			 
11a2			      pop   DE                      ; Address of allocation 
11a2			 
11a2			malloc_no_space: 
11a2			      ld    HL, 6                   ; Clean up stack frame 
11a2			      add   HL, SP 
11a2			      ld    SP, HL 
11a2			 
11a2			      ex    DE, HL                  ; Alloc addr into HL for return 
11a2			 
11a2			malloc_early_exit: 
11a2			      pop   IX 
11a2			      pop   DE 
11a2			      pop   BC 
11a2			 
11a2			      ret 
11a2			 
11a2			 
11a2			;------------------------------------------------------------------------------ 
11a2			;     free                                                                    : 
11a2			;                                                                             : 
11a2			; Description                                                                 : 
11a2			;     Return the space pointed to by HL to the heap. HL must be an address as : 
11a2			;     returned by malloc, otherwise the behaviour is undefined.               : 
11a2			;                                                                             : 
11a2			;     Where possible, directly adjacent free blocks will be merged together   : 
11a2			;     into larger blocks to help ensure that the heap does not become         : 
11a2			;     excessively fragmented.                                                 : 
11a2			;                                                                             : 
11a2			;     free does not clear or set any other value into the freed space, and    : 
11a2			;     therefore its contents may be visible through subsequent malloc's. The  : 
11a2			;     caller should clear the freed space as required.                        : 
11a2			;                                                                             : 
11a2			;     This implementation of free uses the stack exclusively, and is          : 
11a2			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
11a2			;     advisable to disable interrupts before calling free, and recommended    : 
11a2			;     to avoid the use of free inside ISRs in general.                        : 
11a2			;                                                                             : 
11a2			;     NOTE: heap_init must be called before malloc and free can be used.      : 
11a2			;                                                                             : 
11a2			; Parameters                                                                  : 
11a2			;     HL  Pointer to address of first byte of allocation to be freed          : 
11a2			;                                                                             : 
11a2			; Returns                                                                     : 
11a2			;     Nothing                                                                 : 
11a2			;                                                                             : 
11a2			; Stack frame                                                                 : 
11a2			;       |             |                                                       : 
11a2			;       +-------------+                                                       : 
11a2			;       |     BC      |                                                       : 
11a2			;       +-------------+                                                       : 
11a2			;       |     DE      |                                                       : 
11a2			;       +-------------+                                                       : 
11a2			;       |     IX      |                                                       : 
11a2			;       +-------------+                                                       : 
11a2			;       |  prev_free  |                                                       : 
11a2			;   +2  +-------------+                                                       : 
11a2			;       |  next_free  |                                                       : 
11a2			;   +0  +-------------+                                                       : 
11a2			;       |             |                                                       : 
11a2			;                                                                             : 
11a2			;------------------------------------------------------------------------------ 
11a2			free: 
11a2			      push  BC 
11a2			      push  DE 
11a2			      push  IX 
11a2			 
11a2			      ld    A, H                    ; Exit if ptr is null 
11a2			      or    L 
11a2			      jp    Z, free_early_exit 
11a2			 
11a2			      ; Set up stack frame 
11a2			      ex    DE, HL 
11a2			      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
11a2			      add   HL, SP 
11a2			      ld    SP, HL 
11a2			      ld    IX, 0                   ; Use IX as a frame pointer 
11a2			      add   IX, SP 
11a2			 
11a2			      ; The address in HL points to the start of the useable allocated space, 
11a2			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
11a2			      ; address of the block itself. 
11a2			      ex    DE, HL 
11a2			      ld    DE, -4 
11a2			      add   HL, DE 
11a2			 
11a2			      ; An allocated block must have a null next block pointer in it 
11a2			      ld    A, (HL) 
11a2			      inc   HL 
11a2			      or    (HL) 
11a2			      jp    NZ, free_done 
11a2			 
11a2			      dec   HL 
11a2			 
11a2			      ld    B, H                    ; Copy HL to BC 
11a2			      ld    C, L 
11a2			 
11a2			      ; Loop through the free list to find the first block with an address 
11a2			      ; higher than the block being freed 
11a2			      ld    HL, free_list 
11a2			 
11a2			free_find_higher_block: 
11a2			      ld    E, (HL)                 ; Load next ptr from free block 
11a2			      inc   HL 
11a2			      ld    D, (HL) 
11a2			      dec   HL 
11a2			 
11a2			      ld    (IX+0), E               ; Save ptr to next free block 
11a2			      ld    (IX+1), D 
11a2			      ld    (IX+2), L               ; Save ptr to prev free block 
11a2			      ld    (IX+3), H 
11a2			 
11a2			      ld    A, B                    ; Check if DE is greater than BC 
11a2			      cp    D                       ; Compare MSB first 
11a2			      jr    Z, $+4                  ; MSB the same, compare LSB 
11a2			      jr    NC, free_find_higher_block_skip 
11a2			      ld    A, C 
11a2			      cp    E                       ; Then compare LSB 
11a2			      jr    C, free_found_higher_block 
11a2			 
11a2			free_find_higher_block_skip: 
11a2			      ld    A, D                    ; Reached the end of the free list? 
11a2			      or    E 
11a2			      jp    Z, free_done 
11a2			 
11a2			      ex    DE, HL 
11a2			 
11a2			      jr    free_find_higher_block 
11a2			 
11a2			free_found_higher_block: 
11a2			      ; Insert freed block between prev and next free blocks 
11a2			      ld    (HL), C                 ; Point prev free block to freed block 
11a2			      inc   HL 
11a2			      ld    (HL), B 
11a2			 
11a2			      ld    H, B                    ; Point freed block at next free block 
11a2			      ld    L, C 
11a2			      ld    (HL), E 
11a2			      inc   HL 
11a2			      ld    (HL), D 
11a2			 
11a2			      ; Check if the freed block is adjacent to the next free block 
11a2			      inc   HL                      ; Load size of freed block into HL 
11a2			      ld    E, (HL) 
11a2			      inc   HL 
11a2			      ld    D, (HL) 
11a2			      ex    DE, HL 
11a2			 
11a2			      add   HL, BC                  ; Add addr of freed block and its size 
11a2			 
11a2			      ld    E, (IX+0)               ; Load addr of next free block into DE 
11a2			      ld    D, (IX+1) 
11a2			 
11a2			      or    A                       ; Clear the carry flag 
11a2			      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
11a2			      jr    NZ, free_check_adjacent_to_prev 
11a2			 
11a2			      ; Freed block is adjacent to next, merge into one bigger block 
11a2			      ex    DE, HL                  ; Load next ptr from next block into DE 
11a2			      ld    E, (HL) 
11a2			      inc   HL 
11a2			      ld    D, (HL) 
11a2			      push  HL                      ; Save ptr to next block for later 
11a2			 
11a2			      ld    H, B                    ; Store ptr from next block into freed block 
11a2			      ld    L, C 
11a2			      ld    (HL), E 
11a2			      inc   HL 
11a2			      ld    (HL), D 
11a2			 
11a2			      pop   HL                      ; Restore ptr to next block 
11a2			      inc   HL                      ; Load size of next block into DE 
11a2			      ld    E, (HL) 
11a2			      inc   HL 
11a2			      ld    D, (HL) 
11a2			      push  DE                      ; Save next block size for later 
11a2			 
11a2			      ld    H, B                    ; Load size of freed block into HL 
11a2			      ld    L, C 
11a2			      inc   HL 
11a2			      inc   HL 
11a2			      ld    E, (HL) 
11a2			      inc   HL 
11a2			      ld    D, (HL) 
11a2			      ex    DE, HL 
11a2			 
11a2			      pop   DE                      ; Restore size of next block 
11a2			      add   HL, DE                  ; Add sizes of both blocks 
11a2			      ex    DE, HL 
11a2			 
11a2			      ld    H, B                    ; Store new bigger size into freed block 
11a2			      ld    L, C 
11a2			      inc   HL 
11a2			      inc   HL 
11a2			      ld    (HL), E 
11a2			      inc   HL 
11a2			      ld    (HL), D 
11a2			 
11a2			free_check_adjacent_to_prev: 
11a2			      ; Check if the freed block is adjacent to the prev free block 
11a2			      ld    L, (IX+2)               ; Prev free block ptr into HL 
11a2			      ld    H, (IX+3) 
11a2			 
11a2			      inc   HL                      ; Size of prev free block into DE 
11a2			      inc   HL 
11a2			      ld    E, (HL) 
11a2			      inc   HL 
11a2			      ld    D, (HL) 
11a2			      dec   HL 
11a2			      dec   HL 
11a2			      dec   HL 
11a2			 
11a2			      add   HL, DE                  ; Add prev block addr and size 
11a2			 
11a2			      or    A                       ; Clear the carry flag 
11a2			      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
11a2			      jr    NZ, free_done 
11a2			 
11a2			      ; Freed block is adjacent to prev, merge into one bigger block 
11a2			      ld    H, B                    ; Load next ptr from freed block into DE 
11a2			      ld    L, C 
11a2			      ld    E, (HL) 
11a2			      inc   HL 
11a2			      ld    D, (HL) 
11a2			      push  HL                      ; Save freed block ptr for later 
11a2			 
11a2			      ld    L, (IX+2)               ; Store freed block ptr into prev block 
11a2			      ld    H, (IX+3) 
11a2			      ld    (HL), E 
11a2			      inc   HL 
11a2			      ld    (HL), D 
11a2			 
11a2			      pop   HL                      ; Restore freed block ptr 
11a2			      inc   HL                      ; Load size of freed block into DE 
11a2			      ld    E, (HL) 
11a2			      inc   HL 
11a2			      ld    D, (HL) 
11a2			      push  DE                      ; Save freed block size for later 
11a2			 
11a2			      ld    L, (IX+2)               ; Load size of prev block into DE 
11a2			      ld    H, (IX+3) 
11a2			      inc   HL 
11a2			      inc   HL 
11a2			      ld    E, (HL) 
11a2			      inc   HL 
11a2			      ld    D, (HL) 
11a2			 
11a2			      pop   HL                      ; Add sizes of both blocks 
11a2			      add   HL, DE 
11a2			      ex    DE, HL 
11a2			 
11a2			      ld    L, (IX+2)               ; Store new bigger size into prev block 
11a2			      ld    H, (IX+3) 
11a2			      inc   HL 
11a2			      inc   HL 
11a2			      ld    (HL), E 
11a2			      inc   HL 
11a2			      ld    (HL), D 
11a2			 
11a2			free_done: 
11a2			      ld    HL, 4                   ; Clean up stack frame 
11a2			      add   HL, SP 
11a2			      ld    SP, HL 
11a2			 
11a2			free_early_exit: 
11a2			      pop   IX 
11a2			      pop   DE 
11a2			      pop   BC 
11a2			 
11a2			      ret 
11a2			 
11a2			 
11a2			;      .org 0x8000 
11a2			; 
11a2			;free_list         .dw   0     ; Block struct for start of free list (MUST be 4 bytes) 
11a2			 ;                 .dw   0 
11a2			 
11a2			endif 
11a2			 
11a2			 
11a2			if MALLOC_4 
11a2			 
11a2			; My memory allocation code. Very very simple.... 
11a2			; allocate space under 250 chars 
11a2			 
11a2			heap_init: 
11a2				; init start of heap as zero 
11a2				;  
11a2			 
11a2				ld hl, heap_start 
11a2			;	ld a, 0 
11a2				ld (hl), 0      ; empty block 
11a2				inc hl 
11a2			;	ld a, 0 
11a2				ld (hl), 0      ; length of block 
11a2				; write end of list 
11a2				inc hl 
11a2				ld a,(hl) 
11a2				inc hl 
11a2				ld a,(hl) 
11a2				 
11a2			 
11a2				; init some malloc vars 
11a2			 
11a2				ld hl, 0 
11a2				ld (free_list), hl       ; store last malloc location 
11a2			 
11a2				ld hl, free_list+3      ; flag for 'free' being used and force a rescan for reuse of block  
11a2			;	ld a, 0 
11a2				ld (hl), 0 
11a2			 
11a2			 
11a2				ld hl, heap_start 
11a2				;  
11a2				  
11a2				ret 
11a2			 
11a2			 
11a2			;    free block marker 
11a2			;    requested size  
11a2			;    pointer to next block 
11a2			;    .... 
11a2			;    next block marker 
11a2			 
11a2			 
11a2			; TODO add a flag that is reset on use of free. if flag is reset then start scan from start of heap otherwise use last location 
11a2			; 
11a2			 
11a2			 
11a2			malloc:  
11a2				push de 
11a2				push bc 
11a2				push af 
11a2			 
11a2				; hl space required 
11a2				 
11a2				ld c, l    ; hold space   (TODO only a max of 255) 
11a2			 
11a2			;	inc c     ; TODO BUG need to fix memory leak on push str 
11a2			;	inc c 
11a2			;	inc c 
11a2			;	inc c 
11a2			;	inc c 
11a2			;	inc c 
11a2			;	inc c 
11a2			 
11a2			 
11a2			 
11a2				; start at heap if a free has been issued so we can reclaim it otherwise continue from last time 
11a2			 
11a2				ld a, (free_list+3) 
11a2			;	cp 0 
11a2				or a 
11a2				jr z, .contheap 
11a2			 
11a2				ld hl, (free_list)     ; get last alloc 
11a2					if DEBUG_FORTH_MALLOC_INT 
11a2						DMARK "mrs" 
11a2						CALLMONITOR 
11a2					endif 
11a2				jr .startalloc 
11a2			 
11a2			.contheap: 
11a2				ld hl, heap_start 
11a2			 
11a2			.startalloc: 
11a2			 
11a2					if DEBUG_FORTH_MALLOC_INT 
11a2						DMARK "mym" 
11a2						CALLMONITOR 
11a2					endif 
11a2			.findblock: 
11a2					if DEBUG_FORTH_MALLOC_INT 
11a2						DMARK "mmf" 
11a2						CALLMONITOR 
11a2					endif 
11a2			 
11a2				ld a,(hl)  
11a2				; if byte is zero then clear to use 
11a2			 
11a2			;	cp 0 
11a2				or a 
11a2				jr z, .foundemptyblock 
11a2			 
11a2				; if byte is not clear 
11a2				;     then byte is offset to next block 
11a2			 
11a2				inc hl 
11a2				ld a, (hl) ; get size 
11a2			.nextblock:	inc hl 
11a2					ld e, (hl) 
11a2					inc hl 
11a2					ld d, (hl) 
11a2					ex de, hl 
11a2			;	inc hl  ; move past the store space 
11a2			;	inc hl  ; move past zero index  
11a2			 
11a2				; TODO detect no more space 
11a2			 
11a2				push hl 
11a2				ld de, heap_end 
11a2				call cmp16 
11a2				pop hl 
11a2				jr nc, .nospace 
11a2			 
11a2				jr .findblock 
11a2			 
11a2			.nospace: ld hl, 0 
11a2				jp .exit 
11a2			 
11a2			 
11a2			.foundemptyblock:	 
11a2					if DEBUG_FORTH_MALLOC_INT 
11a2						DMARK "mme" 
11a2						CALLMONITOR 
11a2					endif 
11a2			 
11a2			; TODO has block enough space if reusing??? 
11a2			 
11a2				;  
11a2			 
11a2			; see if this block has been previously used 
11a2				inc hl 
11a2				ld a, (hl) 
11a2				dec hl 
11a2			;	cp 0 
11a2				or a 
11a2				jr z, .newblock 
11a2			 
11a2					if DEBUG_FORTH_MALLOC_INT 
11a2						DMARK "meR" 
11a2						CALLMONITOR 
11a2					endif 
11a2			 
11a2			; no reusing previously allocated block 
11a2			 
11a2			; is it smaller than previously used? 
11a2				 
11a2				inc hl    ; move to size 
11a2				ld a, c 
11a2				sub (hl)        ; we want c < (hl) 
11a2				dec hl    ; move back to marker 
11a2			        jr z, .findblock 
11a2			 
11a2				; update with the new size which should be lower 
11a2			 
11a2			        ;inc  hl   ; negate next move. move back to size  
11a2			 
11a2			.newblock: 
11a2				; need to be at marker here 
11a2			 
11a2					if DEBUG_FORTH_MALLOC_INT 
11a2						DMARK "meN" 
11a2						CALLMONITOR 
11a2					endif 
11a2			 
11a2			 
11a2				ld a, c 
11a2			 
11a2				ld (free_list+3), a	 ; flag resume from last malloc  
11a2				ld (free_list), hl    ; save out last location 
11a2			 
11a2			 
11a2				;inc a     ; space for length byte 
11a2				ld (hl), a     ; save block in use marker 
11a2			 
11a2				inc hl   ; move to space marker 
11a2				ld (hl), a    ; save new space 
11a2			 
11a2				inc hl   ; move to start of allocated area 
11a2				 
11a2			;	push hl     ; save where we are - 1  
11a2			 
11a2			;	inc hl  ; move past zero index  
11a2				; skip space to set down new marker 
11a2			 
11a2				; provide some extra space for now 
11a2			 
11a2				inc a    ; actual is one fewer than bytes requested. correct if zero index is taken into account 
11a2				inc a 
11a2				inc a 
11a2			 
11a2				push hl   ; save where we are in the node block 
11a2			 
11a2				call addatohl 
11a2			 
11a2				; write linked list point 
11a2			 
11a2				pop de     ; get our node position 
11a2				ex de, hl 
11a2			 
11a2				ld (hl), e 
11a2				inc hl 
11a2				ld (hl), d 
11a2			 
11a2				inc hl 
11a2			 
11a2				; now at start of allocated data so save pointer 
11a2			 
11a2				push hl 
11a2			 
11a2				; jump to position of next node and setup empty header in DE 
11a2			 
11a2				ex de, hl 
11a2			 
11a2			;	inc hl ; move past end of block 
11a2			 
11a2			;	ld a, 0 
11a2				ld (hl), 0   ; empty marker 
11a2				inc hl 
11a2				ld (hl), 0   ; size 
11a2				inc hl  
11a2				ld (hl), 0   ; ptr 
11a2				inc hl 
11a2				ld (hl), 0   ; ptr 
11a2			 
11a2			 
11a2				pop hl 
11a2			 
11a2					if DEBUG_FORTH_MALLOC_INT 
11a2						DMARK "mmr" 
11a2						CALLMONITOR 
11a2					endif 
11a2			 
11a2			.exit: 
11a2				pop af 
11a2				pop bc 
11a2				pop de  
11a2				ret 
11a2			 
11a2			 
11a2			 
11a2			 
11a2			free:  
11a2				push hl 
11a2				push af 
11a2				; get address in hl 
11a2			 
11a2					if DEBUG_FORTH_MALLOC_INT 
11a2						DMARK "fre" 
11a2						CALLMONITOR 
11a2					endif 
11a2				; data is at hl - move to block count 
11a2				dec hl 
11a2				dec hl    ; get past pointer 
11a2				dec hl 
11a2			 
11a2				ld a, (hl)    ; need this for a validation check 
11a2			 
11a2				dec hl    ; move to block marker 
11a2			 
11a2				; now check that the block count and block marker are the same  
11a2			        ; this checks that we are on a malloc node and not random memory 
11a2			        ; OK a faint chance this could be a problem but rare - famous last words! 
11a2			 
11a2				ld c, a 
11a2				ld a, (hl)    
11a2			 
11a2				cp c 
11a2				jr nz, .freeignore      ; not a valid malloc node in use so dont break anything 
11a2			 
11a2				; yes good chance we are on a malloc node 
11a2			 
11a2			;	ld a, 0      
11a2				ld (hl), 0   ; mark as free 
11a2			 
11a2				ld (free_list+3), a	 ; flag reuse of existing block on next malloc 
11a2			 
11a2			.freeignore:  
11a2			 
11a2				pop af 
11a2				pop hl 
11a2			 
11a2				ret 
11a2			 
11a2			 
11a2			 
11a2			endif 
11a2			 
