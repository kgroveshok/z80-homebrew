d598			        ;out (SC114_SIO_1_OUT),a 
d598 c5				push bc 
d599 0e 02			ld c, $02 
d59b f7				rst $30 
d59c c1				pop bc 
d59d c9				ret 
d59e			 
d59e			; position the cursor on the screen using A as realtive point in screen buffer (i.e. A=(x+(width/y))) 
d59e			fLCD_Pos: 
