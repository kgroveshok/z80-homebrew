9042			tape_high: 
9042 3a 4c ea			ld a, (tape_port) 
9045 4f				ld c, a 
9046 16 ff			ld d, 255 
9048 3a 4b ea			ld a, (tape_pulse_high) 
904b 47				ld b, a 
904c 2a 45 ea		.th:	ld hl, (tape_tm_high) 
