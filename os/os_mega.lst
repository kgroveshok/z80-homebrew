161a			 
161a			; Device support for SN76489AN sound chip 
161a			 
161a			; https://arduinoplusplus.wordpress.com/2019/10/05/making-noise-with-a-sn76489-digital-sound-generator-part-1/ 
161a			; http://danceswithferrets.org/geekblog/?p=93 
161a			; https://www.smspower.org/Development/SN76489 
161a			 
161a			; D0 [ 3] 
161a			; D1 [ 2] 
161a			; D2 [ 1] 
161a			; D3 [15] 
161a			; D4 [13] 
161a			; D5 [12] 
161a			; D6 [11] 
161a			; D7 [10] 
161a			; /WE [ 5] 
161a			; CLK [14] 
161a			; /OE [ 6] 
161a			; AUDIO [ 7] 
161a			; GND 8 
161a			; +5 16 
161a			; 
161a			 
161a			; Write sequence: 
161a			; CE low 
161a			; Data bus 
161a			; WE low then high 
161a			; 32 clock cycles / 8ns write time at 4mhz 
161a			; 
161a			; https://github.com/jblang/SN76489 
161a			; Shows that the clock needs to be enabled when required. Noticed that with the clock connected it interupted the bus 
161a			; Tried: 
161a			; 
161a			; CE/OE -> Both pins of NAND -> To one pin of second NAND and second pin to full clock -> CLK on chip 
161a			; 
161a			; Connected WE to OR too 
161a			;  
161a			; That enabled the clock when required 
161a			; However still random bus corruption. Need further investigation 
161a			 
161a			 
161a			SOUND_LATCH: equ 10000000B 
161a			SOUND_DATA: equ 0B 
161a			SOUND_CH0:  equ 0B    ; Tone 
161a			SOUND_CH1: equ 0100000B        ; Tone 
161a			SOUND_CH2: equ 1000000B   ; Tone 
161a			SOUND_CH3: equ 1100000B    ; Noise 
161a			SOUND_VOL: equ 10000B 
161a			SOUND_TONE: equ 0B 
161a			 
161a			 
161a c9			sound_init: ret 
161b			 
161b			 
