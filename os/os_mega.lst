2614					ld (debug_mark+1),a  
2614					ld a, (.dmark+2)  
2614					ld (debug_mark+2),a  
2614				endif  
2614 18 04			jr .pastdmark  
2616 ..			.dmark: db "HEP"  
2619				if DEMARK_VERSION = 1  
2619 00					db 0  
261a				endif  
261a				if DEMARK_VERSION = 1  
261a e1			.pastdmark: pop hl  
261b				endif  
261b				if DEMARK_VERSION = 0  
261b			.pastdmark: pop af  
261b				endif  
261b			endm  
