0ffc			;; 	ASCII char code for 0-9,A-F in A to single hex digit 
0ffc			;;    subtract $30, if result > 9 then subtract $7 more 
0ffc			;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; 
0ffc			atohex: 
0ffc d6 30				SUB $30 
0ffe fe 0a				CP 10 
1000 f8					RET M		; If result negative it was 0-9 so we're done 
1001 d6 07				SUB $7		; otherwise, subtract $7 more to get to $0A-$0F 
1003 c9					RET		 
