8fe0 19			      add   HL, DE                  ; Add prev block addr and size 
8fe1			 
8fe1 b7			      or    A                       ; Clear the carry flag 
8fe2 ed 42		      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
8fe4 20 2e		      jr    NZ, free_done 
8fe6			 
8fe6			      ; Freed block is adjacent to prev, merge into one bigger block 
8fe6 60			      ld    H, B                    ; Load next ptr from freed block into DE 
8fe7 69			      ld    L, C 
8fe8 5e			      ld    E, (HL) 
8fe9 23			      inc   HL 
8fea 56			      ld    D, (HL) 
8feb e5			      push  HL                      ; Save freed block ptr for later 
8fec			 
