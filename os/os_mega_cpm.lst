151d			  
151d			include "firmware_595shiftreg.asm"  
151d			; common code for handling a 595 shift reg out on whatever output port 
151d			 
151d			; port in c 
151d			; byte in a 
151d			 
151d			 
151d			shift_bit_data: equ 0 
151d			shift_bit_clk: equ 1 
151d			shift_bit_latch: equ 2 
151d			 
151d			 
151d			; shift out a byte to the sound chip 
151d			 
151d			; A contains byte to send 
151d			 
151d			shift_byte: 
151d			 
151d 06 08			ld b, 8   ; 8 bits to shift 
151f			 
151f 16 00		.nb1:	ld d, 0    ; our work byte to send to the device with flags 
1521			 
1521				; set data bit state 
1521			 
1521 cb 7f			bit 7, a 
1523				; high bit is set 
1523 28 02			jr z, .nb2 
1525 cb c2			set shift_bit_data, d 
1527			 
1527				; set latches state  
1527 cb ca		.nb2:	set shift_bit_clk, d 
1529 cb 92			res shift_bit_latch, d    ; latch is inverted 
