c060			.SPIO: 
c060			 
c060			if STORAGE_SE 
c060				CWHEAD .SPICEH 61 "SPICEL" 6 WORD_FLAG_CODE 
c060			; | SPICEL ( -- ) Set SPI CE low for the currently selected device |  DONE 
c060			 
c060					call spi_ce_low 
c060			    NEXTW 
c060			 
c060			.SPICEH: 
c060				CWHEAD .SPIBOb 61 "SPICEH" 6 WORD_FLAG_CODE 
c060			; | SPICEH ( -- ) Set SPI CE high for the currently selected device |  DONE 
c060			 
c060					call spi_ce_high 
c060			    NEXTW 
c060			 
c060			.SPIBOb: 
c060			 
c060				CWHEAD .SPII 61 "SPIO" 4 WORD_FLAG_CODE 
c060			; | SPIO ( u1 -- ) Send byte u1 to SPI  |  DONE 
c060			 
c060					if DEBUG_FORTH_WORDS_KEY 
c060						DMARK "SPo" 
c060						CALLMONITOR 
c060					endif 
c060					; get port 
c060			 
c060			 
c060					; get byte to send 
c060			 
c060					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
c060			 
c060			;		push hl    ; u1  
c060			 
c060					; destroy value TOS 
c060			 
c060					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
c060			 
c060					; one value on hl get other one back 
c060			 
c060			;		pop hl   ; u2 - addr 
c060			 
c060					; TODO Send SPI byte 
c060			 
c060			;		push hl 
c060			;		call spi_ce_low 
c060			;		pop hl 
c060					ld a, l 
c060					call spi_send_byte 
c060			;		call spi_ce_high 
c060			 
c060					NEXTW 
c060			 
c060			.SPII: 
c060				CWHEAD .SESEL 62 "SPII" 5 WORD_FLAG_CODE 
c060			; | SPII ( -- u1 ) Get a byte from SPI  | DONE 
c060					if DEBUG_FORTH_WORDS_KEY 
c060						DMARK "SPi" 
c060						CALLMONITOR 
c060					endif 
c060			 
c060					; TODO Get SPI byte 
c060			 
c060					call spi_read_byte 
c060			 
c060					if DEBUG_FORTH_WORDS 
c060						DMARK "Si2" 
c060						CALLMONITOR 
c060					endif 
c060					ld h, 0 
c060					ld l, a 
c060					if DEBUG_FORTH_WORDS 
c060						DMARK "Si3" 
c060						CALLMONITOR 
c060					endif 
c060					;call forth_push_numhl 
c060					FORTH_PUSH_VALUEHL 
c060			 
c060					NEXTW 
c060			 
c060			 
c060			 
c060			.SESEL: 
c060				CWHEAD .SESELS 82 "BANK?" 5 WORD_FLAG_CODE 
c060			; | BANK? ( -- u ) Reports on the serial EEPROM Bank Device at bank address u1 1-5.  | DONE 
c060			; | | Zero is disabled storage. 
c060					if DEBUG_FORTH_WORDS_KEY 
c060						DMARK "BN?" 
c060						CALLMONITOR 
c060					endif 
c060					ld a, (spi_device_id) 
c060					sub '0' 
c060					ld h, 0 
c060					ld l, a 
c060					FORTH_PUSH_VALUEHL 
c060					;call forth_push_numhl 
c060					NEXTW 
c060			.SESELS: 
c060				CWHEAD .CARTDEV 82 "BANK" 4 WORD_FLAG_CODE 
c060			; | BANK ( u1 -- ) Select Serial EEPROM Bank Device at bank address u1 1-5 (disables CARTDEV).  | DONE 
c060			; | | Set to zero to disable storage. 
c060					if DEBUG_FORTH_WORDS_KEY 
c060						DMARK "BNK" 
c060						CALLMONITOR 
c060					endif 
c060			 
c060					ld a, 255 
c060					ld (spi_cartdev), a 
c060			 
c060					; get bank 
c060			 
c060					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
c060			 
c060			;		push hl 
c060			 
c060					; destroy value TOS 
c060			 
c060					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
c060			 
c060					; one value on hl get other one back 
c060			 
c060			;		pop hl 
c060			 
c060			 
c060					ld c, SPI_CE_HIGH 
c060					ld b, '0'    ; human readable bank number 
c060			 
c060					ld a, l 
c060			 
c060					if DEBUG_FORTH_WORDS 
c060						DMARK "BNK" 
c060						CALLMONITOR 
c060					endif 
c060			 
c060					; active low 
c060			 
c060			;		cp 0 
c060					or a 
c060					jr z, .bset 
c060					cp 1 
c060					jr nz, .b2 
c060					res 0, c 
c060					ld b, '1'    ; human readable bank number 
c060			.b2:		cp 2 
c060					jr nz, .b3 
c060					res 1, c 
c060					ld b, '2'    ; human readable bank number 
c060			.b3:		cp 3 
c060					jr nz, .b4 
c060					res 2, c 
c060					ld b, '3'    ; human readable bank number 
c060			.b4:		cp 4 
c060					jr nz, .b5 
c060					res 3, c 
c060					ld b, '4'    ; human readable bank number 
c060			.b5:		cp 5 
c060					jr nz, .bset 
c060					res 4, c 
c060					ld b, '5'    ; human readable bank number 
c060			 
c060			.bset: 
c060					ld a, c 
c060					ld (spi_device),a 
c060					ld a, b 
c060					ld (spi_device_id),a 
c060					if DEBUG_FORTH_WORDS 
c060						DMARK "BN2" 
c060						CALLMONITOR 
c060					endif 
c060			 
c060					; set default SPI clk pulse time as disabled for BANK use 
c060			 
c060					ld a, 0 
c060					ld (spi_clktime), a 
c060			 
c060					NEXTW 
c060			 
c060			.CARTDEV: 
c060				CWHEAD .ENDDEVICE 82 "CARTDEV" 7 WORD_FLAG_CODE 
c060			; | CARTDEV ( u1 -- ) Select cart device 1-8 (Disables BANK). | DONE 
c060			; | | Set to zero to disable devices. 
c060					if DEBUG_FORTH_WORDS_KEY 
c060						DMARK "CDV" 
c060						CALLMONITOR 
c060					endif 
c060			 
c060					; disable se storage bank selection 
c060			 
c060					ld a, SPI_CE_HIGH		; ce high 
c060					ld (spi_device), a 
c060			 
c060					; get bank 
c060			 
c060					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
c060			 
c060			;		push hl 
c060			 
c060					; destroy value TOS 
c060			 
c060					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
c060			 
c060					; one value on hl get other one back 
c060			 
c060			;		pop hl 
c060			 
c060					; active low 
c060			 
c060					ld c, 255 
c060			 
c060					ld a, l 
c060					if DEBUG_FORTH_WORDS 
c060						DMARK "CDV" 
c060						CALLMONITOR 
c060					endif 
c060			;		cp 0 
c060					or a 
c060					jr z, .cset 
c060					cp 1 
c060					jr nz, .c2 
c060					res 0, c 
c060			.c2:		cp 2 
c060					jr nz, .c3 
c060					res 1, c 
c060			.c3:		cp 3 
c060					jr nz, .c4 
c060					res 2, c 
c060			.c4:		cp 4 
c060					jr nz, .c5 
c060					res 3, c 
c060			.c5:		cp 5 
c060					jr nz, .c6 
c060					res 4, c 
c060			.c6:		cp 6 
c060					jr nz, .c7 
c060					res 5, c 
c060			.c7:		cp 7 
c060					jr nz, .c8 
c060					res 6, c 
c060			.c8:		cp 8 
c060					jr nz, .cset 
c060					res 7, c 
c060			.cset:		ld a, c 
c060					ld (spi_cartdev),a 
c060			 
c060					if DEBUG_FORTH_WORDS 
c060						DMARK "CD2" 
c060						CALLMONITOR 
c060					endif 
c060			 
c060					; set default SPI clk pulse time as 10ms for CARTDEV use 
c060			 
c060					ld a, $0a 
c060					ld (spi_clktime), a 
c060					NEXTW 
c060			endif 
c060			 
c060			.ENDDEVICE: 
c060			; eof 
c060			 
# End of file forth_words_device.asm
