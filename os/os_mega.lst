6afb			; **********************************************************************  
6afb			; **  Alphanumeric LCD support                  by Stephen C Cousins  **  
6afb			; **********************************************************************  
6afb			;  
6afb			; **  Written as a Small Computer Monitor App   
6afb			; **  Version 0.1 SCC 2018-05-16  
6afb			; **  www.scc.me.uk  
6afb			;  
6afb			; **********************************************************************  
6afb			;  
6afb			; This module provides support for alphanumeric LCD modules using with  
6afb			; *  HD44780 (or compatible) controller  
6afb			; *  5 x 7 pixel fonts  
6afb			; *  Up to 80 characters in total (eg. 4 lines of 20 characters)  
6afb			; *  Interface via six digital outputs to the display (see below)  
6afb			;  
6afb			; LCD module pinout:  
6afb			;   1  Vss   0v supply  
6afb			;   2  Vdd   5v supply  
6afb			;   3  Vo    LCD input voltage (near zero volts via potentiometer)  
6afb			;   4  RS    High = data, Low = instruction  
6afb			;   5  R/W   High = Read, Low = Write  
6afb			;   6  E     Enable signal (active high)  
6afb			;   7  DB0   Data bit 0  
6afb			;   8  DB1   Data bit 1  
6afb			;   9  DB2   Data bit 2  
6afb			;  10  DB3   Data bit 3  
6afb			;  11  DB4   Data bit 4  
6afb			;  12  DB5   Data bit 5  
6afb			;  13  DB6   Data bit 6  
6afb			;  14  DB7   Data bit 7  
6afb			;  15  A     Backlight anode (+)  
6afb			;  16  K     Backlight cathode (-)  
6afb			;  
6afb			; This interfacing method uses 4-bit data mode and uses time delays  
6afb			; rather than polling the display's ready status. As a result the   
6afb			; interface only requires 6 simple output lines:  
6afb			;   LCD E   = Microcomputer output port bit <kLCDBitE>  
6afb			;   LCD RS  = Microcomputer output port bit <kLCDBitRS>  
6afb			;   LCD DB4 = Microcomputer output port bit 4  
6afb			;   LCD DB5 = Microcomputer output port bit 5  
6afb			;   LCD DB6 = Microcomputer output port bit 6  
6afb			;   LCD DB7 = Microcomputer output port bit 7  
6afb			; Display's R/W is connected to 0v so it is always in write mode  
6afb			; All 6 connections must be on the same port address <kLCDPrt>  
6afb			; This method also allows a decent length of cable from micro to LCD  
6afb			;  
6afb			; **********************************************************************  
6afb			;  
6afb			; To include the code for any given function provided by this module,   
6afb			; add the appropriate #REQUIRES <FunctionName> statement at the top of   
6afb			; the parent source file.  
6afb			; For example:  #REQUIRES   uHexPrefix  
6afb			;  
6afb			; Also #INCLUDE this file at some point after the #REQUIRES statements  
6afb			; in the parent source file.  
6afb			; For example:  #INCLUDE    ..\_CodeLibrary\Utilities.asm  
6afb			;  
6afb			; These are the function names provided by this module:  
6afb			; fLCD_Init                     ;Initialise LCD  
6afb			; fLCD_Inst                     ;Send instruction to LCD  
6afb			; fLCD_Data                     ;Send data byte to LCD  
6afb			; fLCD_Pos                      ;Position cursor  
6afb			; fLCD_Str                      ;Display string  
6afb			; fLCD_Def                      ;Define custom character  
6afb			;  
6afb			; **********************************************************************  
6afb			;  
6afb			; Requires SCMonAPI.asm to also be included in the project  
6afb			;  
6afb			  
6afb			  
6afb			; **********************************************************************  
6afb			; **  Constants  
6afb			; **********************************************************************  
6afb			  
6afb			; Constants that must be defined externally  
6afb			;kLCDPrt:   EQU 0xc0           ;Port address used for LCD  
6afb			;kLCDBitRS: EQU 2              ;Port bit for LCD RS signal  
6afb			;kLCDBitE:  EQU 3              ;Port bit for LCD E signal  
6afb			;kLCDWidth: EQU 20             ;Width in characters  
6afb			  
6afb			; general line offsets in any frame buffer  
6afb			  
6afb			  
6afb			display_row_1: equ 0  
6afb			display_row_2: equ display_row_1+display_cols  
6afb			display_row_3: equ display_row_2 + display_cols  
6afb			display_row_4: equ display_row_3 + display_cols  
6afb			;display_row_4_eol:   
6afb			  
6afb			  
6afb			; Cursor position values for the start of each line  
6afb			  
6afb			; E  
6afb			kLCD_Line1: EQU 0x00   
6afb			kLCD_Line2: EQU kLCD_Line1+kLCDWidth  
6afb			; E1  
6afb			kLCD_Line3: EQU kLCD_Line2+kLCDWidth  
6afb			kLCD_Line4: EQU kLCD_Line3+kLCDWidth   
6afb			  
6afb			; Instructions to send as A register to fLCD_Inst  
6afb			kLCD_Clear: EQU 00000001b     ;LCD clear  
6afb			kLCD_Off:   EQU 00001000b     ;LCD off  
6afb			kLCD_On:    EQU 00001100b     ;LCD on, no cursor or blink  
6afb			kLCD_Under: EQU 00001110b     ;LCD on, cursor = underscore  
6afb			kLCD_Blink: EQU 00001101b     ;LCD on, cursor = blink block  
6afb			kLCD_Both:  EQU 00001111b     ;LCD on, cursor = under+blink  
6afb			  
6afb			; Constants used by this code module  
6afb			kLCD_Clr:   EQU 00000001b     ;LCD command: Clear display  
6afb			kLCD_Pos:   EQU 10000000b     ;LCD command: Position cursor  
6afb			kLCD_Def:   EQU 01000000b     ;LCD command: Define character  
6afb			  
6afb			  
6afb			  
6afb			; **********************************************************************  
6afb			; **  LCD support functions  
6afb			; **********************************************************************  
6afb			  
6afb			; Initialise alphanumeric LCD module  
6afb			; LCD control register codes:  
6afb			;   DL   0 = 4-bit mode        1 = 8-bit mode  
6afb			;   N    0 = 1-line mode       1 = 2-line mode  
6afb			;   F    0 = Font 5 x 8        1 = Font 5 x 11  
6afb			;   D    0 = Display off       1 = Display on  
6afb			;   C    0 = Cursor off        1 = Cursor on  
6afb			;   B    0 = Blinking off      1 = Blinking on  
6afb			;   ID   0 = Decrement mode    1 = Increment mode  
6afb			;   SH   0 = Entire shift off  1 = Entire shift on  
6afb 3e 28		fLCD_Init:  LD   A, 40  
6afd cd 3e 6c		            CALL LCDDelay       ;Delay 40ms after power up  
6b00			; For reliable reset set 8-bit mode - 3 times  
6b00 cd 0e 6c		            CALL WrFn8bit       ;Function = 8-bit mode  
6b03 cd 0e 6c		            CALL WrFn8bit       ;Function = 8-bit mode  
6b06 cd 0e 6c		            CALL WrFn8bit       ;Function = 8-bit mode  
6b09			; Set 4-bit mode  
6b09 cd 0a 6c		            CALL WrFn4bit       ;Function = 4-bit mode  
6b0c cd 3c 6c		            CALL LCDDelay1      ;Delay 37 us or more  
6b0f			; Function set  
6b0f 3e 28		            LD   A, 00101000b  ;Control reg:  0  0  1  DL N  F  x  x  
6b11 cd 34 6b		            CALL fLCD_Inst      ;2 line, display on  
6b14			; Display On/Off control  
6b14 3e 0c		            LD   A, 00001100b  ;Control reg:  0  0  0  0  1  D  C  B   
6b16 cd 34 6b		            CALL fLCD_Inst      ;Display on, cursor on, blink off  
6b19			; Display Clear  
6b19 3e 01		            LD   A, 00000001b  ;Control reg:  0  0  0  0  0  0  0  1  
6b1b cd 34 6b		            CALL fLCD_Inst      ;Clear display  
6b1e			; Entry mode  
6b1e 3e 06		            LD   A, 00000110b  ;Control reg:  0  0  0  0  0  1  ID SH  
6b20 cd 34 6b		            CALL fLCD_Inst      ;Increment mode, shift off  
6b23			; Display module now initialised  
6b23 c9			            RET  
6b24			; ok to here  
6b24			  
6b24			; decide on setting bit for LED on or off  
6b24			; Set correct bit in A  
6b24 e5			IsLED: push hl  
6b25 21 ad fd			ld hl, hardware_word+1  
6b28 cb 56			bit 2, (hl)    ; led bit  
6b2a 20 04			jr nz, .isled1  
6b2c cb 8f			res kLCDBitLED, a  
6b2e 18 02			jr .isleddone  
6b30 cb cf		.isled1: set kLCDBitLED, a  
6b32			.isleddone:  	  
6b32 e1				pop hl  
6b33			  
6b33 c9				ret  
6b34			  
6b34			  
6b34			; Write instruction to LCD  
6b34			;   On entry: A = Instruction byte to be written  
6b34			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6b34 f5			fLCD_Inst:  PUSH AF  
6b35 f5			            PUSH AF  
6b36 cd 48 6b		            CALL Wr4bits       ;Write bits 4 to 7 of instruction  
6b39 f1			            POP  AF  
6b3a 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6b3b 17			            RLA  
6b3c 17			            RLA  
6b3d 17			            RLA  
6b3e cd 48 6b		            CALL Wr4bits       ;Write bits 0 to 3 of instruction  
6b41 3e 02		            LD   A, 2  
6b43 cd 3e 6c		            CALL LCDDelay       ;Delay 2 ms to complete   
6b46 f1			            POP  AF  
6b47 c9			            RET  
6b48			Wr4bits:   
6b48 f5					push af  
6b49 3a fb fa				ld a, (display_lcde1e2)  
6b4c fe 00				cp 0     ; e  
6b4e 20 13				jr nz, .wea2	  
6b50 f1					pop af  
6b51 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6b53 cd 24 6b				call IsLED  
6b56 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b58 cb df		            SET  kLCDBitE, A	    ; TODO decide which E is being set  
6b5a cb 87		            res  kLCDBitE2, A	    ; TODO decide which E is being set  
6b5c d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b5e cb 9f		            RES  kLCDBitE, A        ; TODO decide which E is being set  
6b60 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b62 c9			            RET  
6b63 f1			.wea2:		pop af  
6b64 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6b66 cd 24 6b				call IsLED  
6b69 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b6b cb c7		            SET  kLCDBitE2, A	    ; TODO decide which E is being set  
6b6d cb 9f		            res  kLCDBitE, A	    ; TODO decide which E is being set  
6b6f d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b71 cb 87		            RES  kLCDBitE2, A        ; TODO decide which E is being set  
6b73 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b75 c9			            RET  
6b76			  
6b76			  
6b76			; Write data to LCD  
6b76			;   On entry: A = Data byte to be written  
6b76			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6b76 f5			fLCD_Data:  PUSH AF  
6b77 f5			            PUSH AF  
6b78 cd 8a 6b		            CALL Wr4bitsa       ;Write bits 4 to 7 of data byte  
6b7b f1			            POP  AF  
6b7c 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6b7d 17			            RLA  
6b7e 17			            RLA  
6b7f 17			            RLA  
6b80 cd 8a 6b		            CALL Wr4bitsa       ;Write bits 0 to 3 of data byte  
6b83 3e 96		            LD   A, 150  
6b85 3d			Wait:      DEC  A              ;Wait a while to allow data   
6b86 20 fd		            JR   NZ, Wait      ;  write to complete  
6b88 f1			            POP  AF  
6b89 c9			            RET  
6b8a			Wr4bitsa:     
6b8a f5					push af  
6b8b 3a fb fa				ld a, (display_lcde1e2)  
6b8e fe 00				cp 0     ; e1  
6b90 20 19				jr nz, .we2	  
6b92 f1					pop af  
6b93 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6b95 cd 24 6b				call IsLED  
6b98 cb d7		            SET  kLCDBitRS, A  
6b9a d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6b9c cb df		            SET  kLCDBitE, A      ; TODO Decide which E is being set  
6b9e cb 87		            res  kLCDBitE2, A      ; TODO Decide which E is being set  
6ba0 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6ba2 cb 9f		            RES  kLCDBitE, A       ; TODO Decide which E is being set  
6ba4 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6ba6 cb 97		            RES  kLCDBitRS, A  
6ba8 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6baa c9			            RET  
6bab f1			.we2:		pop af  
6bac e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6bae cd 24 6b				call IsLED  
6bb1 cb d7		            SET  kLCDBitRS, A  
6bb3 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6bb5 cb c7		            SET  kLCDBitE2, A      ; TODO Decide which E is being set  
6bb7 cb 9f		            res  kLCDBitE, A      ; TODO Decide which E is being set  
6bb9 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6bbb cb 87		            RES  kLCDBitE2, A       ; TODO Decide which E is being set  
6bbd d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6bbf cb 97		            RES  kLCDBitRS, A  
6bc1 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6bc3 c9			            RET  
6bc4			  
6bc4			  
6bc4			; Position cursor to specified location  
6bc4			;   On entry: A = Cursor position  
6bc4			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6bc4 f5			fLCD_Pos:   PUSH AF  
6bc5					; at this point set the E1 or E2 flag depending on position  
6bc5			  
6bc5 c5					push bc  
6bc6			;		push af  
6bc6 06 00				ld b, 0  
6bc8 4f					ld c, a  
6bc9 3e 4f				ld a, kLCD_Line3-1  
6bcb b7			 		or a      ;clear carry flag  
6bcc 99					sbc a,c    ; TODO may need to sub 80 from a to put in context of current frame    
6bcd 38 04				jr c, .pe1  
6bcf			  
6bcf					; E selection  
6bcf cb 80				res 0, b         ; bit 0 unset e  
6bd1			;		pop af    ; before line 3 so recover orig pos  
6bd1			;		ld c, a    ; save for poking back  
6bd1 18 06				jr .peset	          
6bd3			.pe1:          	; E2 selection  
6bd3 cb c0				set 0, b         ; bit 0 set e1  
6bd5 79					ld a, c  
6bd6 de 4f				sbc a, kLCD_Line3-1  
6bd8 4f					ld c, a	         ; save caculated offset  
6bd9			;		pop af     ; bin this original value now we have calculated form  
6bd9			  
6bd9			.peset:		; set bit  
6bd9 78					ld a, b  
6bda 32 fb fa				ld (display_lcde1e2), a 	  
6bdd 79					ld a, c  
6bde c1					pop bc  
6bdf			  
6bdf f6 80		            OR   kLCD_Pos       ;Prepare position cursor instruction  
6be1 cd 34 6b		            CALL fLCD_Inst      ;Write instruction to LCD  
6be4 f1			            POP  AF  
6be5 c9			            RET  
6be6			  
6be6			  
6be6			; Output text string to LCD  
6be6			;   On entry: DE = Pointer to null terminated text string  
6be6			;   On exit:  BC HL IX IY I AF' BC' DE' HL' preserved  
6be6 1a			fLCD_Str:   LD   A, (DE)        ;Get character from string  
6be7 b7			            OR   A              ;Null terminator?  
6be8 c8			            RET  Z              ;Yes, so finished  
6be9 cd 76 6b		            CALL fLCD_Data      ;Write character to display  
6bec 13			            INC  DE             ;Point to next character  
6bed 18 f7		            JR   fLCD_Str       ;Repeat  
6bef c9					ret  
6bf0			  
6bf0			; Define custom character  
6bf0			;   On entry: A = Character number (0 to 7)  
6bf0			;             DE = Pointer to character bitmap data  
6bf0			;   On exit:  A = Next character number  
6bf0			;             DE = Next location following bitmap  
6bf0			;             BC HL IX IY I AF' BC' DE' HL' preserved  
6bf0			; Character is   
6bf0 c5			fLCD_Def:   PUSH BC  
6bf1 f5			            PUSH AF  
6bf2 07			            RLCA                ;Calculate location  
6bf3 07			            RLCA                ;  for bitmap data  
6bf4 07			            RLCA                ;  = 8 x CharacterNumber  
6bf5 f6 40		            OR   kLCD_Def       ;Prepare define character instruction  
6bf7 cd 34 6b		            CALL fLCD_Inst      ;Write instruction to LCD  
6bfa 06 00		            LD   B, 0  
6bfc 1a			Loop:      LD   A, (DE)        ;Get byte from bitmap  
6bfd cd 76 6b		            CALL fLCD_Data      ;Write byte to display  
6c00 13			            INC  DE             ;Point to next byte  
6c01 04			            INC  B              ;Count bytes  
6c02 cb 58		            BIT  3, B           ;Finish all 8 bytes?  
6c04 28 f6		            JR   Z, Loop       ;No, so repeat  
6c06 f1			            POP  AF  
6c07 3c			            INC  A              ;Increment character number  
6c08 c1			            POP  BC  
6c09 c9			            RET  
6c0a			  
6c0a			  
6c0a			; **********************************************************************  
6c0a			; **  Private functions  
6c0a			; **********************************************************************  
6c0a			  
6c0a			; Write function to LCD  
6c0a			;   On entry: A = Function byte to be written  
6c0a			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6c0a 3e 20		WrFn4bit:   LD   A, 00100000b  ;4-bit mode  
6c0c 18 02		            JR   WrFunc  
6c0e 3e 30		WrFn8bit:   LD   A, 00110000b  ;8-bit mode  
6c10 f5			WrFunc:     PUSH AF  
6c11 f5					push af  
6c12 3a fb fa				ld a, (display_lcde1e2)  
6c15 fe 00				cp 0     ; e1  
6c17 20 0f				jr nz, .wfea2	  
6c19 f1					pop af  
6c1a d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6c1c cb df		            SET  kLCDBitE, A     ; TODO Decide which E is being set  
6c1e cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6c20 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6c22 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6c24 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6c26 18 0d			jr .wfskip  
6c28 f1			.wfea2:		pop af  
6c29 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6c2b cb c7		            SET  kLCDBitE2, A     ; TODO Decide which E is being set  
6c2d cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6c2f d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6c31 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6c33 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6c35 3e 05		.wfskip:            LD  A, 5  
6c37 cd 3e 6c		            CALL LCDDelay       ;Delay 5 ms to complete  
6c3a f1			            POP  AF  
6c3b c9			            RET  
6c3c			  
6c3c			  
6c3c			; Delay in milliseconds  
6c3c			;   On entry: A = Number of milliseconds delay  
6c3c			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6c3c 3e 01		LCDDelay1:  LD   A, 1           ;Delay by 1 ms  
6c3e d5			LCDDelay:   PUSH DE  
6c3f 5f			            LD   E, A           ;Delay by 'A' ms  
6c40 16 00		            LD   D, 0  
6c42 cd 62 0a		            CALL aDelayInMS  
6c45 d1			            POP  DE  
