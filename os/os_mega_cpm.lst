5719 22 c8 e9			ld (chk_ret_und), hl 
571c 22 86 e9			ld (chk_ret_ovr), hl 
571f 22 04 e9			ld (chk_loop_ovr), hl 
5722 22 02 e8			ld (chk_data_ovr), hl 
5725 c9				ret 
