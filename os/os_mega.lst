0dc8			;HL_Div_C: 
0dc8			;Inputs: 
0dc8			;     HL is the numerator 
0dc8			;     C is the denominator 
0dc8			;Outputs: 
0dc8			;     A is the remainder 
0dc8			;     B is 0 
0dc8			;     C is not changed 
0dc8			;     DE is not changed 
0dc8			;     HL is the quotient 
0dc8			; 
0dc8			;       ld b,16 
0dc8			;       xor a 
0dc8			;         add hl,hl 
0dc8			;         rla 
0dc8			;         cp c 
0dc8			;         jr c,$+4 
0dc8			;           inc l 
0dc8			;           sub c 
0dc8			;         djnz $-7 
