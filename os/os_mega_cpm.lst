0fb5			; https://tutorials.eeems.ca/ASMin28Days/lesson/day16.html#cmp 
0fb5			 
0fb5			; String Length 
0fb5			;With a length-prefixed string, finding the length is trivial. For a null-terminated string, the process is decidedly more involved. This is where CPIR comes in. 
0fb5			 
0fb5			; Get the length of the null-terminated string starting at $8000 hl 
0fb5			;    LD     HL, $8000 
0fb5			 
0fb5			strlenz: 
0fb5			 
0fb5 af			    XOR    A               ; Zero is the value we are looking for. 
0fb6 47			    LD     B, A             ; Since we haven't the slightest clue as to the  
0fb7 4f			    LD     C, A             ; actual size of the string, put 0 in BC to search 
0fb8			                           ; 65, 536 bytes (the entire addressable memory space). 
0fb8 ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
0fba			 
0fba			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
0fba 67			    LD     H, A             ; Zero HL (basically set it to 65, 536) to get the 
0fbb 6f			    LD     L, A             ; number of bytes 
0fbc ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
0fbe 2b			    DEC    HL              ; Compensate for null. 
0fbf c9				ret 
0fc0			 
0fc0			; Get the length of the A terminated string starting at $8000 hl 
0fc0			;    LD     HL, $8000 
0fc0			 
0fc0			strlent: 
0fc0			 
0fc0			                  ; A is the value we are looking for. 
0fc0 06 00		    LD     B, 0             ; Since we haven't the slightest clue as to the  
0fc2 0e 00		    LD     C, 0             ; actual size of the string, put 0 in BC to search 
0fc4			                           ; 65, 536 bytes (the entire addressable memory space). 
0fc4 ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
0fc6			 
0fc6			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
0fc6 26 00		    LD     H, 0             ; Zero HL (basically set it to 65, 536) to get the 
0fc8 2e 00		    LD     L, 0             ; number of bytes 
0fca ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
0fcc 2b			    DEC    HL              ; Compensate for null. 
0fcd c9				ret 
0fce			 
0fce			 
0fce			;Comparing Strings 
0fce			 
0fce			;IN    HL     Address of string1. 
0fce			;      DE     Address of string2. 
0fce			 
0fce			; doc given but wrong??? 
0fce			;OUT   zero   Set if string1 = string2, reset if string1 != string2. 
0fce			;      carry  Set if string1 > string2, reset if string1 <= string2. 
0fce			; tested 
0fce			;OUT   carry set  if string1 = string2, carry  reset if string1 != string2. 
0fce			 
0fce			strcmp_old: 
0fce e5			    PUSH   HL 
0fcf d5			    PUSH   DE 
0fd0			 
0fd0 1a			    LD     A, (DE)          ; Compare lengths to determine smaller string 
0fd1 be			    CP     (HL)            ; (want to minimize work). 
0fd2 38 01		    JR     C, Str1IsBigger 
0fd4 7e			    LD     A, (HL) 
0fd5			 
0fd5			Str1IsBigger: 
0fd5 4f			    LD     C, A             ; Put length in BC 
0fd6 06 00		    LD     B, 0 
0fd8 13			    INC    DE              ; Increment pointers to meat of string. 
0fd9 23			    INC    HL 
0fda			 
0fda			CmpLoop: 
0fda 1a			    LD     A, (DE)          ; Compare bytes. 
0fdb ed a1		    CPI 
0fdd 20 09		    JR     NZ, NoMatch      ; If (HL) != (DE), abort. 
0fdf 13			    INC    DE              ; Update pointer. 
0fe0 ea da 0f		    JP     PE, CmpLoop 
0fe3			 
0fe3 d1			    POP    DE 
0fe4 e1			    POP    HL 
0fe5 1a			    LD     A, (DE)          ; Check string lengths to see if really equal. 
0fe6 be			    CP     (HL) 
0fe7 c9			    RET 
0fe8			 
0fe8			NoMatch: 
0fe8 2b			    DEC    HL 
0fe9 be			    CP     (HL)            ; Compare again to affect carry. 
0fea d1			    POP    DE 
0feb e1			    POP    HL 
0fec c9			    RET 
