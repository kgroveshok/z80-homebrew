02a3				include "firmware_seeprom.asm"  
02a3			; 
02a3			; persisent storage interface via microchip serial eeprom 
02a3			 
02a3			; port a pio 2 
02a3			; pa 7 - si 
02a3			; pa 6 - sclk  
02a3			; pa 5 - so 
02a3			; pa 4 - cs 
02a3			; pa 3 - cs 
02a3			; pa 2 - cs 
02a3			; pa 1 - cs 
02a3			; pa 0 - cs 
02a3			; 
02a3			; TODO get block 
02a3			; TODO save block 
02a3			; TODO load file 
02a3			; TODO save file 
02a3			; TODO get dir  
02a3			 
02a3			;  
02a3			storage_adata: equ Device_C    ; device c port a - onboard storage 
02a3			storage_actl: equ Device_C+2     ; device c port a 
02a3			storage_bdata: equ Device_C+1    ; device c port b - ext storage cart 
02a3			storage_bctl: equ Device_C+3     ; device c port b 
02a3			 
02a3			 
02a3			; TODO move these to hardware driver file 
02a3			 
02a3			;STORE_BLOCK_PHY:   equ 64    ; physical block size on storage   64byte on 256k eeprom 
02a3			;STORE_DEVICE_MAXBLOCKS:  equ  512 ; how many blocks are there on this storage device 
02a3			; storage bank file system format 
02a3			; 
02a3			; first page of bank: 
02a3			; 	addr 0 - status check 
02a3			;       addr 1 - write protect flag 
02a3			;       addr 2 - zero if all data is held on this device. >0 - next device number (not used right now) 
02a3			;       addr 3 - last file id (to save on scanning for spare file id). or could have bit mask of file ids in use????  
02a3			;         TODO see if scanning whole of for available next file id is fast enough 
02a3			;	addr 4 > zero term string of bank label 
02a3			; 
02a3			;        
02a3			;  
02a3			; first page of any file: 
02a3			;      byte 0 - file id  
02a3			;      byte 1-17 - fixed file name  
02a3			;      byte 18-end of page - extra meta data tba (date? description? keywords?) 
02a3			; 
02a3			; other pages of any file: 
02a3			;      byte 0 - file id 
02a3			;      byte 1> - file data 
02a3			; 
02a3			; TODO depending on how long it takes to load a file in if scanning the whole bank for the file id, could speed it up by having last file page flag??? high bit? that would max 127 files 
02a3			;  
02a3			; TODO need a bank format which places a 0 in each of the first byte of every page and updates the meta in page 0 
02a3			 
02a3			 
02a3			;storage_so_bit: 5 
02a3			;storage_si_bit: 7 
02a3			;storage_sclk_bit: 6 
02a3			  
02a3			 
02a3			; init storage pio 
02a3			 
02a3			storage_init: 
02a3			 
02a3			 
02a3					; set default SPI clk pulse time as disabled 
02a3			 
02a3 3e 00				ld a, 0 
02a5 32 8f f9				ld (spi_clktime), a 
02a8			 
02a8					; init hardware 
02a8			 
02a8 3e cf		            LD   A, 11001111b 
02aa d3 82		            OUT  (storage_actl), A  ;Port A = PIO 'control' mode 
02ac 3e 00		            LD   A, 00000000b 
02ae cb f7			set SPI_DO,a 
02b0			;            LD   A, SPI_DO      ; only one input line  the rest are outputs 
02b0 d3 82		            OUT  (storage_actl),A   ;Port A = all lines are outputs 
02b2			 
02b2 3e cf		            LD   A, 11001111b 
02b4 d3 83		            OUT  (storage_bctl), A  ;Port A = PIO 'control' mode 
02b6 3e 00		            LD   A, 00000000b 
02b8 d3 83		            OUT  (storage_bctl),A   ;Port A = all lines are outputs 
02ba			 
02ba				; set all external spi devices off  
02ba 3e ff			ld a, 255 
02bc 32 8b f9			ld (spi_device), a 
02bf 32 8e f9			ld (spi_cartdev), a 
02c2			 
02c2					; ensure the spi bus is in a default stable state 
02c2 cd 0c 01				call se_stable_spi 
02c5			 
02c5			; TODO scan spi bus and gather which storage banks are present 
02c5			 
02c5			; populate store_bank_active  
02c5			; for each ce line activate and attempt to write first byte of bank and read back 
02c5			; if zero is returned then bank is empty 
02c5			;   
02c5			; 
02c5			 
02c5					; init file extent cache to save on slow reads 
02c5			 
02c5			;	ld hl, store_filecache 
02c5			;	ld de, 0 
02c5			;	ld hl,(de)	 
02c5			 
02c5			 
02c5 c9			    ret 
02c6			 
02c6			store_read_ins: equ 000000011b   ; Read data from memory array beginning at selected address 
02c6			store_write_ins: equ 000000010b  ;  Write data to memory array beginning at selected address 
02c6			store_wren_ins: equ 000000110b   ;  Set the write enable latch (enable write operations) 
02c6			 
02c6			; INSTRUCTION SET 
02c6			; READ 0000 0011 Read data from memory array beginning at selected address 
02c6			; WRITE 0000 0010 Write data to memory array beginning at selected address 
02c6			; WREN 0000 0110 Set the write enable latch (enable write operations) 
02c6			; WRDI 0000 0100 Reset the write enable latch (disable write operations) 
02c6			; RDSR 0000 0101 Read STATUS register 
02c6			; WRSR 0000 0001 Write STATUS register 
02c6			; PE 0100 0010 Page Erase – erase one page in memory array 
02c6			; SE 1101 1000 Sector Erase – erase one sector in memory array 
02c6			; CE 1100 0111 Chip Erase – erase all sectors in memory array 
02c6			; RDID 1010 1011 Release from Deep power-down and read electronic signature 
02c6			 
02c6			; TODO send byte steam for page without setting the address for every single byte 
02c6			; TODO read byte  
02c6			 
02c6			; byte in a 
02c6			; address in hl  
02c6			se_writebyte: 
02c6			        
02c6			    ;   ld c, a 
02c6 f5			        push af 
02c7 e5			        push hl 
02c8			 
02c8			    ; initi write mode 
02c8			    ; 
02c8			    ;CS low 
02c8			 
02c8 3a 8c f9		       ld a,(spi_portbyte) 
02cb cd 31 02			call spi_ce_low 
02ce			       ;res SPI_CE0,a           ; TODO pass the ce bank bit mask 
02ce d3 80		       out (storage_adata),a 
02d0 32 8c f9		       ld (spi_portbyte), a 
02d3			 
02d3			    ;clock out wren instruction 
02d3			 
02d3 3e 06		    ld a, store_wren_ins 
02d5 cd 32 01		    call spi_send_byte  
02d8			 
02d8			    ;cs high to enable write latch 
02d8			 
02d8 3a 8c f9		       ld a,(spi_portbyte) 
02db cd 20 02			call spi_ce_high 
02de			;       set SPI_CE0,a           ; TODO pass the ce bank bit mask 
02de d3 80		       out (storage_adata),a 
02e0 32 8c f9		       ld (spi_portbyte), a 
02e3			 
02e3			;	nop 
02e3			    ; 
02e3			    ; intial write data 
02e3			    ; 
02e3			    ; cs low 
02e3			     
02e3			;       ld a,(spi_portbyte) 
02e3 cd 31 02			call spi_ce_low 
02e6			       ;res SPI_CE0,a           ; TODO pass the ce bank bit mask 
02e6 d3 80		       out (storage_adata),a 
02e8 32 8c f9		       ld (spi_portbyte), a 
02eb			 
02eb			    ; clock out write instruction 
02eb			     
02eb 3e 02		    ld a, store_write_ins  
02ed cd 32 01		    call spi_send_byte  
02f0			 
02f0			    ; clock out address (depending on address size) 
02f0			     
02f0 e1			    pop hl 
02f1 7c			    ld a,h    ; address out msb first 
02f2 cd 32 01		    call spi_send_byte  
02f5 7d			    ld a,l 
02f6 cd 32 01		    call spi_send_byte  
02f9			 
02f9			    ; clock out byte(s) for page 
