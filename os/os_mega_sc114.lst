8ffe			if MALLOC_3 
8ffe			; https://gist.githubusercontent.com/tomstorey/947a8b084bad69391a4b2a1c5b6d69ca/raw/5a08fb30a480d98c0deb4a6afe2d48961cc8e9d9/z80_malloc.s 
8ffe			;heap_start        .equ  0x9000      ; Starting address of heap 
8ffe			;heap_size         .equ  0x0100      ; Number of bytes available in heap 
8ffe			; 
8ffe			 ;     .org 0 
8ffe			  ;    jp    main 
8ffe			; 
8ffe			; 
8ffe			 ;     .org  0x100 
8ffe			;main: 
8ffe			 ;     ld    HL, 0x8100 
8ffe			  ;    ld    SP, HL 
8ffe			; 
8ffe			;      call  heap_init 
8ffe			 
8ffe			      ; Make some allocations 
8ffe			;      ld    HL, 12 
8ffe			;      call  malloc            ; Allocates 0x9004 
8ffe			; 
8ffe			 ;     ld    HL, 12 
8ffe			;      call  malloc            ; Allocates 0x9014 
8ffe			 
8ffe			;      ld    HL, 12 
8ffe			;      call  malloc            ; Allocates 0x9024 
8ffe			 
8ffe			      ; Free some allocations 
8ffe			;      ld    HL, 0x9014 
8ffe			;      call  free 
8ffe			 
8ffe			;      ld    HL, 0x9004 
8ffe			;      call  free 
8ffe			; 
8ffe			;      ld    HL, 0x9024 
8ffe			;      call  free 
8ffe			 
8ffe			 
8ffe			 ;     halt 
8ffe			 
8ffe			 
8ffe			;------------------------------------------------------------------------------ 
8ffe			;     heap_init                                                               : 
8ffe			;                                                                             : 
8ffe			; Description                                                                 : 
8ffe			;     Initialise the heap and make it ready for malloc and free operations.   : 
8ffe			;                                                                             : 
8ffe			;     The heap is maintained as a linked list, starting with an initial       : 
8ffe			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
8ffe			;     the first free block in the heap. Each block then points to the next    : 
8ffe			;     free block within the heap, and the free list ends at the first block   : 
8ffe			;     with a null pointer to the next free block.                             : 
8ffe			;                                                                             : 
8ffe			; Parameters                                                                  : 
8ffe			;     Inputs are compile-time only. Two defines which specify the starting    : 
8ffe			;     address of the heap and its size are required, along with a memory      : 
8ffe			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
8ffe			;     principally stores a pointer to the first free block in the heap.       : 
8ffe			;                                                                             : 
8ffe			; Returns                                                                     : 
8ffe			;     Nothing                                                                 : 
8ffe			;------------------------------------------------------------------------------ 
8ffe			heap_init: 
8ffe			      push  HL 
8ffe			 
8ffe			      ; Initialise free list struct 
8ffe			      ld    HL, heap_start 
8ffe			      ld    (free_list), HL 
8ffe			      ld    HL, 0 
8ffe			      ld    (free_list+2), HL 
8ffe			 
8ffe			      ; Insert first free block at bottom of heap, consumes entire heap 
8ffe			      ld    HL, heap_start+heap_size-4 
8ffe			      ld    (heap_start), HL        ; Next block (end of free list) 
8ffe			      ld    HL, heap_size-4 
8ffe			      ld    (heap_start+2), HL      ; Block size 
8ffe			 
8ffe			      ; Insert end of free list block at top of heap - two null words will 
8ffe			      ; terminate the free list 
8ffe			      ld    HL, 0 
8ffe			      ld    (heap_start+heap_size-2), HL 
8ffe			      ld    (heap_start+heap_size-4), HL 
8ffe			 
8ffe			      pop   HL 
8ffe			 
8ffe			      ret 
8ffe			 
8ffe			 
8ffe			;------------------------------------------------------------------------------ 
8ffe			;     malloc                                                                  : 
8ffe			;                                                                             : 
8ffe			; Description                                                                 : 
8ffe			;     Allocates the wanted space from the heap and returns the address of the : 
8ffe			;     first useable byte of the allocation.                                   : 
8ffe			;                                                                             : 
8ffe			;     Allocations can happen in one of two ways:                              : 
8ffe			;                                                                             : 
8ffe			;     1. A free block may be found which is the exact size wanted. In this    : 
8ffe			;        case the block is removed from the free list and retuedn to the      : 
8ffe			;        caller.                                                              : 
8ffe			;     2. A free block may be found which is larger than the size wanted. In   : 
8ffe			;        this case, the larger block is split into two. The first portion of  : 
8ffe			;        this block will become the requested space by the malloc call and    : 
8ffe			;        is returned to the caller. The second portion becomes a new free     : 
8ffe			;        block, and the free list is adjusted to maintain continuity via this : 
8ffe			;        newly created block.                                                 : 
8ffe			;                                                                             : 
8ffe			;     malloc does not set any initial value in the allocated space, the       : 
8ffe			;     caller is required to do this as required.                              : 
8ffe			;                                                                             : 
8ffe			;     This implementation of malloc uses the stack exclusively, and is        : 
8ffe			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
8ffe			;     advisable to disable interrupts before calling malloc, and recommended  : 
8ffe			;     to avoid the use of malloc inside ISRs in general.                      : 
8ffe			;                                                                             : 
8ffe			;     NOTE: heap_init must be called before malloc and free can be used.      : 
8ffe			;                                                                             : 
8ffe			; Parameters                                                                  : 
8ffe			;     HL  Number of bytes wanted                                              : 
8ffe			;                                                                             : 
8ffe			; Returns                                                                     : 
8ffe			;     HL  Address of the first useable byte of the allocation                 : 
8ffe			;                                                                             : 
8ffe			; Flags                                                                       : 
8ffe			;     Z   Set if the allocation did not succeed, clear otherwise              : 
8ffe			;                                                                             : 
8ffe			; Stack frame                                                                 : 
8ffe			;       |             |                                                       : 
8ffe			;       +-------------+                                                       : 
8ffe			;       |     BC      |                                                       : 
8ffe			;       +-------------+                                                       : 
8ffe			;       |     DE      |                                                       : 
8ffe			;       +-------------+                                                       : 
8ffe			;       |     IX      |                                                       : 
8ffe			;       +-------------+                                                       : 
8ffe			;       |  prev_free  |                                                       : 
8ffe			;   +4  +-------------+                                                       : 
8ffe			;       |  this_free  |                                                       : 
8ffe			;   +2  +-------------+                                                       : 
8ffe			;       |  next_free  |                                                       : 
8ffe			;   +0  +-------------+                                                       : 
8ffe			;       |             |                                                       : 
8ffe			;                                                                             : 
8ffe			;------------------------------------------------------------------------------ 
8ffe			malloc: 
8ffe			      push  BC 
8ffe			      push  DE 
8ffe			      push  IX 
8ffe			 
8ffe			      ld    A, H                    ; Exit if no space requested 
8ffe			      or    L 
8ffe			      jp    Z, malloc_early_exit 
8ffe			 
8ffe			      ; Set up stack frame 
8ffe			      ex    DE, HL 
8ffe			      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
8ffe			      add   HL, SP 
8ffe			      ld    SP, HL 
8ffe			      ld    IX, 0                   ; Use IX as a frame pointer 
8ffe			      add   IX, SP 
8ffe			 
8ffe			      ; Setup initial state 
8ffe			      ld    HL, 4                   ; want must also include space used by block struct 
8ffe			      add   HL, DE 
8ffe			 
8ffe			      ld    B, H                    ; Move want to BC 
8ffe			      ld    C, L 
8ffe			 
8ffe			      ld    HL, free_list           ; Store prev_free ptr to stack 
8ffe			      ld    (IX+4), L 
8ffe			      ld    (IX+5), H 
8ffe			 
8ffe			      ld    E, (HL)                 ; Store this_free ptr to stack 
8ffe			      inc   HL 
8ffe			      ld    D, (HL) 
8ffe			      ld    (IX+2), E 
8ffe			      ld    (IX+3), D 
8ffe			      ex    DE, HL                  ; this_free ptr into HL 
8ffe			 
8ffe			      ; Loop through free block list to find some space 
8ffe			malloc_find_space: 
8ffe			      ld    E, (HL)                 ; Load next_free ptr into DE 
8ffe			      inc   HL 
8ffe			      ld    D, (HL) 
8ffe			 
8ffe			      ld    A, D                    ; Check for null next_free ptr - end of free list 
8ffe			      or    E 
8ffe			      jp    Z, malloc_no_space 
8ffe			 
8ffe			      ld    (IX+0), E               ; Store next_free ptr to stack 
8ffe			      ld    (IX+1), D 
8ffe			 
8ffe			      ; Does this block have enough space to make the allocation? 
8ffe			      inc   HL                      ; Load free block size into DE 
8ffe			      ld    E, (HL) 
8ffe			      inc   HL 
8ffe			      ld    D, (HL) 
8ffe			 
8ffe			      ex    DE, HL                  ; Check size of block against want 
8ffe			      or    A                       ; Ensure carry flag clear 
8ffe			      sbc   HL, BC 
8ffe			      push  HL                      ; Store the result for later (new block size) 
8ffe			 
8ffe			      jr    Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
8ffe			      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
8ffe			 
8ffe			      ; this_free block is not big enough, setup ptrs to test next free block 
8ffe			      pop   HL                      ; Discard previous result 
8ffe			 
8ffe			      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
8ffe			      ld    H, (IX+3) 
8ffe			      ld    (IX+4), L 
8ffe			      ld    (IX+5), H 
8ffe			 
8ffe			      ld    L, (IX+0)               ; Move next_free ptr into this_free 
8ffe			      ld    H, (IX+1) 
8ffe			      ld    (IX+2), L 
8ffe			      ld    (IX+3), H 
8ffe			 
8ffe			      jr    malloc_find_space 
8ffe			 
8ffe			      ; split a bigger block into two - requested size and remaining size 
8ffe			malloc_alloc_split: 
8ffe			      ex    DE, HL                  ; Calculate address of new free block 
8ffe			      dec   HL 
8ffe			      dec   HL 
8ffe			      dec   HL 
8ffe			      add   HL, BC 
8ffe			 
8ffe			      ; Create a new block and point it at next_free 
8ffe			      ld    E, (IX+0)               ; Load next_free ptr into DE 
8ffe			      ld    D, (IX+1) 
8ffe			 
8ffe			      ld    (HL), E                 ; Store next_free ptr into new block 
8ffe			      inc   HL 
8ffe			      ld    (HL), D 
8ffe			 
8ffe			      pop   DE                      ; Store size of new block into new block 
8ffe			      inc   HL 
8ffe			      ld    (HL), E 
8ffe			      inc   HL 
8ffe			      ld    (HL), D 
8ffe			 
8ffe			      ; Update this_free ptr to point to new block 
8ffe			      dec   HL 
8ffe			      dec   HL 
8ffe			      dec   HL 
8ffe			 
8ffe			      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
8ffe			      ld    D, (IX+3) 
8ffe			 
8ffe			      ld    (IX+2), L               ; Store new block addr as this_free ptr 
8ffe			      ld    (IX+3), H 
8ffe			 
8ffe			      ; Modify this_free block to be allocation 
8ffe			      ex    DE, HL 
8ffe			      xor   A                       ; Null the next block ptr of allocated block 
8ffe			      ld    (HL), A 
8ffe			      inc   HL 
8ffe			      ld    (HL), A 
8ffe			 
8ffe			      inc   HL                      ; Store want size into allocated block 
8ffe			      ld    (HL), C 
8ffe			      inc   HL 
8ffe			      ld    (HL), B 
8ffe			      inc   HL 
8ffe			      push  HL                      ; Address of allocation to return 
8ffe			 
8ffe			      jr    malloc_update_links 
8ffe			 
8ffe			malloc_alloc_fit: 
8ffe			      pop   HL                      ; Dont need new block size, want is exact fit 
8ffe			 
8ffe			      ; Modify this_free block to be allocation 
8ffe			      ex    DE, HL 
8ffe			      dec   HL 
8ffe			      dec   HL 
8ffe			      dec   HL 
8ffe			 
8ffe			      xor   A                       ; Null the next block ptr of allocated block 
8ffe			      ld    (HL), A 
8ffe			      inc   HL 
8ffe			      ld    (HL), A 
8ffe			 
8ffe			      inc   HL                      ; Store address of allocation to return 
8ffe			      inc   HL 
8ffe			      inc   HL 
8ffe			      push  HL 
8ffe			 
8ffe			      ; Copy next_free ptr to this_free, remove allocated block from free list 
8ffe			      ld    L, (IX+0)               ; next_free to HL 
8ffe			      ld    H, (IX+1) 
8ffe			 
8ffe			      ld    (IX+2), L               ; HL to this_free 
8ffe			      ld    (IX+3), H 
8ffe			 
8ffe			 
8ffe			malloc_update_links: 
8ffe			      ; Update prev_free ptr to point to this_free 
8ffe			      ld    L, (IX+4)               ; prev_free ptr to HL 
8ffe			      ld    H, (IX+5) 
8ffe			 
8ffe			      ld    E, (IX+2)               ; this_free ptr to DE 
8ffe			      ld    D, (IX+3) 
8ffe			 
8ffe			      ld    (HL), E                 ; this_free ptr into prev_free 
8ffe			      inc   HL 
8ffe			      ld    (HL), D 
8ffe			 
8ffe			      ; Clear the Z flag to indicate successful allocation 
8ffe			      ld    A, D 
8ffe			      or    E 
8ffe			 
8ffe			      pop   DE                      ; Address of allocation 
8ffe			 
8ffe			malloc_no_space: 
8ffe			      ld    HL, 6                   ; Clean up stack frame 
8ffe			      add   HL, SP 
8ffe			      ld    SP, HL 
8ffe			 
8ffe			      ex    DE, HL                  ; Alloc addr into HL for return 
8ffe			 
8ffe			malloc_early_exit: 
8ffe			      pop   IX 
8ffe			      pop   DE 
8ffe			      pop   BC 
8ffe			 
8ffe			      ret 
8ffe			 
8ffe			 
8ffe			;------------------------------------------------------------------------------ 
8ffe			;     free                                                                    : 
8ffe			;                                                                             : 
8ffe			; Description                                                                 : 
8ffe			;     Return the space pointed to by HL to the heap. HL must be an address as : 
8ffe			;     returned by malloc, otherwise the behaviour is undefined.               : 
8ffe			;                                                                             : 
8ffe			;     Where possible, directly adjacent free blocks will be merged together   : 
8ffe			;     into larger blocks to help ensure that the heap does not become         : 
8ffe			;     excessively fragmented.                                                 : 
8ffe			;                                                                             : 
8ffe			;     free does not clear or set any other value into the freed space, and    : 
8ffe			;     therefore its contents may be visible through subsequent malloc's. The  : 
8ffe			;     caller should clear the freed space as required.                        : 
8ffe			;                                                                             : 
8ffe			;     This implementation of free uses the stack exclusively, and is          : 
8ffe			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
8ffe			;     advisable to disable interrupts before calling free, and recommended    : 
8ffe			;     to avoid the use of free inside ISRs in general.                        : 
8ffe			;                                                                             : 
8ffe			;     NOTE: heap_init must be called before malloc and free can be used.      : 
8ffe			;                                                                             : 
8ffe			; Parameters                                                                  : 
8ffe			;     HL  Pointer to address of first byte of allocation to be freed          : 
8ffe			;                                                                             : 
8ffe			; Returns                                                                     : 
8ffe			;     Nothing                                                                 : 
8ffe			;                                                                             : 
8ffe			; Stack frame                                                                 : 
8ffe			;       |             |                                                       : 
8ffe			;       +-------------+                                                       : 
8ffe			;       |     BC      |                                                       : 
8ffe			;       +-------------+                                                       : 
8ffe			;       |     DE      |                                                       : 
8ffe			;       +-------------+                                                       : 
8ffe			;       |     IX      |                                                       : 
8ffe			;       +-------------+                                                       : 
8ffe			;       |  prev_free  |                                                       : 
8ffe			;   +2  +-------------+                                                       : 
8ffe			;       |  next_free  |                                                       : 
8ffe			;   +0  +-------------+                                                       : 
8ffe			;       |             |                                                       : 
8ffe			;                                                                             : 
8ffe			;------------------------------------------------------------------------------ 
8ffe			free: 
8ffe			      push  BC 
8ffe			      push  DE 
8ffe			      push  IX 
8ffe			 
8ffe			      ld    A, H                    ; Exit if ptr is null 
8ffe			      or    L 
8ffe			      jp    Z, free_early_exit 
8ffe			 
8ffe			      ; Set up stack frame 
8ffe			      ex    DE, HL 
8ffe			      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
8ffe			      add   HL, SP 
8ffe			      ld    SP, HL 
8ffe			      ld    IX, 0                   ; Use IX as a frame pointer 
8ffe			      add   IX, SP 
8ffe			 
8ffe			      ; The address in HL points to the start of the useable allocated space, 
8ffe			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
8ffe			      ; address of the block itself. 
8ffe			      ex    DE, HL 
8ffe			      ld    DE, -4 
8ffe			      add   HL, DE 
8ffe			 
8ffe			      ; An allocated block must have a null next block pointer in it 
8ffe			      ld    A, (HL) 
8ffe			      inc   HL 
8ffe			      or    (HL) 
8ffe			      jp    NZ, free_done 
8ffe			 
8ffe			      dec   HL 
8ffe			 
8ffe			      ld    B, H                    ; Copy HL to BC 
8ffe			      ld    C, L 
8ffe			 
8ffe			      ; Loop through the free list to find the first block with an address 
8ffe			      ; higher than the block being freed 
8ffe			      ld    HL, free_list 
8ffe			 
8ffe			free_find_higher_block: 
8ffe			      ld    E, (HL)                 ; Load next ptr from free block 
8ffe			      inc   HL 
8ffe			      ld    D, (HL) 
8ffe			      dec   HL 
8ffe			 
8ffe			      ld    (IX+0), E               ; Save ptr to next free block 
8ffe			      ld    (IX+1), D 
8ffe			      ld    (IX+2), L               ; Save ptr to prev free block 
8ffe			      ld    (IX+3), H 
8ffe			 
8ffe			      ld    A, B                    ; Check if DE is greater than BC 
8ffe			      cp    D                       ; Compare MSB first 
8ffe			      jr    Z, $+4                  ; MSB the same, compare LSB 
8ffe			      jr    NC, free_find_higher_block_skip 
8ffe			      ld    A, C 
8ffe			      cp    E                       ; Then compare LSB 
8ffe			      jr    C, free_found_higher_block 
8ffe			 
8ffe			free_find_higher_block_skip: 
8ffe			      ld    A, D                    ; Reached the end of the free list? 
8ffe			      or    E 
8ffe			      jp    Z, free_done 
8ffe			 
8ffe			      ex    DE, HL 
8ffe			 
8ffe			      jr    free_find_higher_block 
8ffe			 
8ffe			free_found_higher_block: 
8ffe			      ; Insert freed block between prev and next free blocks 
8ffe			      ld    (HL), C                 ; Point prev free block to freed block 
8ffe			      inc   HL 
8ffe			      ld    (HL), B 
8ffe			 
8ffe			      ld    H, B                    ; Point freed block at next free block 
8ffe			      ld    L, C 
8ffe			      ld    (HL), E 
8ffe			      inc   HL 
8ffe			      ld    (HL), D 
8ffe			 
8ffe			      ; Check if the freed block is adjacent to the next free block 
8ffe			      inc   HL                      ; Load size of freed block into HL 
8ffe			      ld    E, (HL) 
8ffe			      inc   HL 
8ffe			      ld    D, (HL) 
8ffe			      ex    DE, HL 
8ffe			 
8ffe			      add   HL, BC                  ; Add addr of freed block and its size 
8ffe			 
8ffe			      ld    E, (IX+0)               ; Load addr of next free block into DE 
8ffe			      ld    D, (IX+1) 
8ffe			 
8ffe			      or    A                       ; Clear the carry flag 
8ffe			      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
8ffe			      jr    NZ, free_check_adjacent_to_prev 
8ffe			 
8ffe			      ; Freed block is adjacent to next, merge into one bigger block 
8ffe			      ex    DE, HL                  ; Load next ptr from next block into DE 
8ffe			      ld    E, (HL) 
8ffe			      inc   HL 
8ffe			      ld    D, (HL) 
8ffe			      push  HL                      ; Save ptr to next block for later 
8ffe			 
8ffe			      ld    H, B                    ; Store ptr from next block into freed block 
8ffe			      ld    L, C 
8ffe			      ld    (HL), E 
8ffe			      inc   HL 
8ffe			      ld    (HL), D 
8ffe			 
8ffe			      pop   HL                      ; Restore ptr to next block 
8ffe			      inc   HL                      ; Load size of next block into DE 
8ffe			      ld    E, (HL) 
8ffe			      inc   HL 
8ffe			      ld    D, (HL) 
8ffe			      push  DE                      ; Save next block size for later 
8ffe			 
8ffe			      ld    H, B                    ; Load size of freed block into HL 
8ffe			      ld    L, C 
8ffe			      inc   HL 
8ffe			      inc   HL 
8ffe			      ld    E, (HL) 
8ffe			      inc   HL 
8ffe			      ld    D, (HL) 
8ffe			      ex    DE, HL 
8ffe			 
8ffe			      pop   DE                      ; Restore size of next block 
8ffe			      add   HL, DE                  ; Add sizes of both blocks 
8ffe			      ex    DE, HL 
8ffe			 
8ffe			      ld    H, B                    ; Store new bigger size into freed block 
8ffe			      ld    L, C 
8ffe			      inc   HL 
8ffe			      inc   HL 
8ffe			      ld    (HL), E 
8ffe			      inc   HL 
8ffe			      ld    (HL), D 
8ffe			 
8ffe			free_check_adjacent_to_prev: 
8ffe			      ; Check if the freed block is adjacent to the prev free block 
8ffe			      ld    L, (IX+2)               ; Prev free block ptr into HL 
8ffe			      ld    H, (IX+3) 
8ffe			 
8ffe			      inc   HL                      ; Size of prev free block into DE 
8ffe			      inc   HL 
8ffe			      ld    E, (HL) 
8ffe			      inc   HL 
8ffe			      ld    D, (HL) 
8ffe			      dec   HL 
8ffe			      dec   HL 
8ffe			      dec   HL 
8ffe			 
8ffe			      add   HL, DE                  ; Add prev block addr and size 
8ffe			 
8ffe			      or    A                       ; Clear the carry flag 
8ffe			      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
8ffe			      jr    NZ, free_done 
8ffe			 
8ffe			      ; Freed block is adjacent to prev, merge into one bigger block 
8ffe			      ld    H, B                    ; Load next ptr from freed block into DE 
8ffe			      ld    L, C 
8ffe			      ld    E, (HL) 
8ffe			      inc   HL 
8ffe			      ld    D, (HL) 
8ffe			      push  HL                      ; Save freed block ptr for later 
8ffe			 
8ffe			      ld    L, (IX+2)               ; Store freed block ptr into prev block 
8ffe			      ld    H, (IX+3) 
8ffe			      ld    (HL), E 
8ffe			      inc   HL 
8ffe			      ld    (HL), D 
8ffe			 
8ffe			      pop   HL                      ; Restore freed block ptr 
8ffe			      inc   HL                      ; Load size of freed block into DE 
8ffe			      ld    E, (HL) 
8ffe			      inc   HL 
8ffe			      ld    D, (HL) 
8ffe			      push  DE                      ; Save freed block size for later 
8ffe			 
8ffe			      ld    L, (IX+2)               ; Load size of prev block into DE 
8ffe			      ld    H, (IX+3) 
8ffe			      inc   HL 
8ffe			      inc   HL 
8ffe			      ld    E, (HL) 
8ffe			      inc   HL 
8ffe			      ld    D, (HL) 
8ffe			 
8ffe			      pop   HL                      ; Add sizes of both blocks 
8ffe			      add   HL, DE 
8ffe			      ex    DE, HL 
8ffe			 
8ffe			      ld    L, (IX+2)               ; Store new bigger size into prev block 
8ffe			      ld    H, (IX+3) 
8ffe			      inc   HL 
8ffe			      inc   HL 
8ffe			      ld    (HL), E 
8ffe			      inc   HL 
8ffe			      ld    (HL), D 
8ffe			 
8ffe			free_done: 
8ffe			      ld    HL, 4                   ; Clean up stack frame 
8ffe			      add   HL, SP 
8ffe			      ld    SP, HL 
8ffe			 
8ffe			free_early_exit: 
8ffe			      pop   IX 
8ffe			      pop   DE 
8ffe			      pop   BC 
8ffe			 
8ffe			      ret 
8ffe			 
8ffe			 
8ffe			;      .org 0x8000 
8ffe			; 
8ffe			;free_list         .dw   0     ; Block struct for start of free list (MUST be 4 bytes) 
8ffe			 ;                 .dw   0 
8ffe			 
8ffe			endif 
