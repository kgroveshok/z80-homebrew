8e41			if MALLOC_2 
8e41			; Z80 Malloc and Free Functions 
8e41			 
8e41			; Malloc Function: 
8e41			; Input: 
8e41			;   HL: Size of block to allocate 
8e41			; Output: 
8e41			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
8e41			 
8e41			malloc: 
8e41				 
8e41			if DEBUG_FORTH_MALLOC_HIGH 
8e41			call malloc_guard_entry 
8e41			endif 
8e41			 
8e41			 
8e41			 
8e41			 
8e41					if DEBUG_FORTH_MALLOC 
8e41						DMARK "mal" 
8e41						CALLMONITOR 
8e41					endif 
8e41			    push af            ; Save AF register 
8e41			    ld a, l            ; Load low byte of size into A 
8e41			    or h               ; Check if size is zero 
8e41			    jp z, malloc_exit  ; If size is zero, exit with NULL pointer 
8e41			 
8e41			    ; Allocate memory 
8e41			    ld hl, (heap_start) ; Load start of heap into HL 
8e41					if DEBUG_FORTH_MALLOC 
8e41						DMARK "ma1" 
8e41						CALLMONITOR 
8e41					endif 
8e41			    call malloc_internal ; Call internal malloc function 
8e41			    pop af             ; Restore AF register 
8e41			if DEBUG_FORTH_MALLOC_HIGH 
8e41			call malloc_guard_exit 
8e41			call malloc_guard_zerolen 
8e41			endif 
8e41			    ret                ; Return 
8e41			 
8e41			; Free Function: 
8e41			; Input: 
8e41			;   HL: Pointer to memory block to free 
8e41			; Output: 
8e41			;   None 
8e41			 
8e41			free: 
8e41			    push af            ; Save AF register 
8e41			    ld a, l            ; Load low byte of pointer into A 
8e41			    or h               ; Check if pointer is NULL 
8e41			    jp z, free_exit    ; If pointer is NULL, exit 
8e41			 
8e41			    ; Free memory 
8e41			    ld hl, (heap_start) ; Load start of heap into HL 
8e41			    call free_internal  ; Call internal free function 
8e41			    pop af             ; Restore AF register 
8e41			    ret                ; Return 
8e41			 
8e41			; Internal Malloc Function: 
8e41			; Input: 
8e41			;   HL: Size of block to allocate 
8e41			; Output: 
8e41			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
8e41			 
8e41			malloc_internal: 
8e41			    ld bc, 2           ; Number of bytes to allocate for management overhead 
8e41			    add hl, bc         ; Add management overhead to requested size 
8e41			    ex de, hl          ; Save total size in DE, and keep it in HL 
8e41					if DEBUG_FORTH_MALLOC 
8e41						DMARK "ma2" 
8e41						CALLMONITOR 
8e41					endif 
8e41			 
8e41			    ; Search for free memory block 
8e41			    ld de, (heap_end)  ; Load end of heap into DE 
8e41			    ld bc, 0           ; Initialize counter 
8e41			 
8e41					if DEBUG_FORTH_MALLOC 
8e41						DMARK "ma2" 
8e41						CALLMONITOR 
8e41					endif 
8e41			malloc_search_loop: 
8e41			    ; Check if current block is free 
8e41			    ld a, (hl)         ; Load current block's status (free or used) 
8e41			;    cp 0               ; Compare with zero (free) 
8e41				or a 
8e41			    jr nz, malloc_skip_block_check  ; If not free, skip to the next block 
8e41			 
8e41			    ; Check if current block is large enough 
8e41			    ld a, (hl+1)       ; Load high byte of block size 
8e41			    cp l               ; Compare with low byte of requested size 
8e41			    jr nz, malloc_skip_block_check  ; If not large enough, skip to the next block 
8e41			 
8e41			    ld a, (hl+2)       ; Load low byte of block size 
8e41			    cp h               ; Compare with high byte of requested size 
8e41			    jr c, malloc_skip_block_check   ; If not large enough, skip to the next block 
8e41			 
8e41			    ; Mark block as used 
8e41			    ld (hl), 0xFF      ; Set status byte to indicate used block 
8e41			 
8e41			    ; Calculate remaining space in block 
8e41			    ld bc, 0           ; Clear BC 
8e41			    add hl, bc         ; Increment HL to point to start of data block 
8e41			    add hl, de         ; HL = HL + DE (total size) 
8e41			    ld bc, 1           ; Number of bytes to allocate for management overhead 
8e41			    add hl, bc         ; Add management overhead to start of data block 
8e41			 
8e41			    ; Save pointer to allocated block in HL 
8e41			if DEBUG_FORTH_MALLOC_HIGH 
8e41						DMARK "ma5" 
8e41			call malloc_guard_exit 
8e41			call malloc_guard_zerolen 
8e41			endif 
8e41			    ret 
8e41			 
8e41			malloc_skip_block_check: 
8e41			    ; Move to the next block 
8e41			    ld bc, 3           ; Size of management overhead 
8e41			    add hl, bc         ; Move to the next block 
8e41			    inc de             ; Increment counter 
8e41			 
8e41			    ; Check if we have reached the end of heap 
8e41			    ld a, e            ; Load low byte of heap end address 
8e41			    cp (hl)            ; Compare with low byte of current address 
8e41			    jr nz, malloc_search_loop  ; If not equal, continue searching 
8e41			    ld a, d            ; Load high byte of heap end address 
8e41			;    cp 0               ; Check if it's zero (end of memory) 
8e41				or a 
8e41			    jr nz, malloc_search_loop  ; If not zero, continue searching 
8e41			 
8e41			    ; If we reached here, allocation failed 
8e41			    xor a              ; Set result to NULL 
8e41			if DEBUG_FORTH_MALLOC_HIGH 
8e41						DMARK "ma6" 
8e41			call malloc_guard_exit 
8e41			call malloc_guard_zerolen 
8e41			endif 
8e41			    ret 
8e41			malloc_exit: 
8e41			if DEBUG_FORTH_MALLOC_HIGH 
8e41						DMARK "ma7" 
8e41			call malloc_guard_exit 
8e41			call malloc_guard_zerolen 
8e41			endif 
8e41			    ret 
8e41			 
8e41			; Internal Free Function: 
8e41			; Input: 
8e41			;   HL: Pointer to memory block to free 
8e41			; Output: 
8e41			;   None 
8e41			 
8e41			free_internal: 
8e41			    ld de, (heap_start) ; Load start of heap into DE 
8e41			    ld bc, 0            ; Initialize counter 
8e41			 
8e41			free_search_loop: 
8e41			    ; Check if current block contains the pointer 
8e41			    ld a, l             ; Load low byte of pointer 
8e41			    cp (hl+1)           ; Compare with high byte of current block's address 
8e41			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
8e41			    ld a, h             ; Load high byte of pointer 
8e41			    cp (hl+2)           ; Compare with low byte of current block's address 
8e41			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
8e41			 
8e41			    ; Mark block as free 
8e41			    ld (hl), 0          ; Set status byte to indicate free block 
8e41			    ret                 ; Return 
8e41			 
8e41			free_skip_block_check: 
8e41			    ; Move to the next block 
8e41			    ld bc, 3            ; Size of management overhead 
8e41			    add hl, bc          ; Move to the next block 
8e41			    inc de              ; Increment counter 
8e41			 
8e41			    ; Check if we have reached the end of heap 
8e41			    ld a, e             ; Load low byte of heap end address 
8e41			    cp (hl)             ; Compare with low byte of current address 
8e41			    jr nz, free_search_loop  ; If not equal, continue searching 
8e41			    ld a, d             ; Load high byte of heap end address 
8e41			;    cp 0                ; Check if it's zero (end of memory) 
8e41				or a 
8e41			    jr nz, free_search_loop  ; If not zero, continue searching 
8e41			 
8e41			    ; If we reached here, pointer is not found in heap 
8e41			    ret 
8e41			 
8e41			free_exit: 
8e41			    ret                 ; Return 
8e41			 
8e41			; Define heap start and end addresses 
8e41			;heap_start:    .dw 0xC000   ; Start of heap 
8e41			;heap_end:      .dw 0xE000   ; End of heap 
8e41			 
8e41			endif 
