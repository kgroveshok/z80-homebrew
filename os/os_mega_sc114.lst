9eb3 15				db WORD_SYS_CORE+OPCODE_HEAP             
9eb4 cd 9e			dw .HEAP            
9eb6 04				db 3 + 1 
9eb7 .. 00			db "NEW",0              
9ebb				endm 
# End of macro CWHEAD
9ebb			; | NEW ( -- ) Clears all user words and stack | DONE 
