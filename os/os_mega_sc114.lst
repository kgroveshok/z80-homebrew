8dc0			 
8dc0			;written by Zeda 
8dc0			;Converts a 16-bit unsigned integer to an ASCII string. 
8dc0			 
8dc0			uitoa_16: 
8dc0			;Input: 
8dc0			;   DE is the number to convert 
8dc0			;   HL points to where to write the ASCII string (up to 6 bytes needed). 
8dc0			;Output: 
8dc0			;   HL points to the null-terminated ASCII string 
8dc0			;      NOTE: This isn't necessarily the same as the input HL. 
8dc0 d5			  push de 
8dc1 c5			  push bc 
8dc2 f5			  push af 
8dc3 eb			  ex de,hl 
8dc4			 
8dc4 01 f0 d8		  ld bc,-10000 
8dc7 3e 2f		  ld a,'0'-1 
8dc9 3c			  inc a 
8dca 09			  add hl,bc  
8dcb 38 fc		   jr c,$-2 
8dcd 12			  ld (de),a 
8dce 13			  inc de 
8dcf			 
8dcf 01 e8 03		  ld bc,1000 
8dd2 3e 3a		  ld a,'9'+1 
8dd4 3d			  dec a  
8dd5 09			  add hl,bc  
8dd6 30 fc		   jr nc,$-2 
8dd8 12			  ld (de),a 
8dd9 13			  inc de 
8dda			 
8dda 01 9c ff		  ld bc,-100 
8ddd 3e 2f		  ld a,'0'-1 
8ddf 3c			  inc a  
8de0 09			  add hl,bc  
8de1 38 fc		   jr c,$-2 
8de3 12			  ld (de),a 
8de4 13			  inc de 
8de5			 
8de5 7d			  ld a,l 
8de6 26 3a		  ld h,'9'+1 
8de8 25			  dec h  
8de9 c6 0a		  add a,10  
8deb 30 fb		   jr nc,$-3 
8ded c6 30		  add a,'0' 
8def eb			  ex de,hl 
8df0 72			  ld (hl),d 
8df1 23			  inc hl 
8df2 77			  ld (hl),a 
8df3 23			  inc hl 
8df4 36 00		  ld (hl),0 
8df6			 
8df6			;Now strip the leading zeros 
8df6 0e fa		  ld c,-6 
8df8 09			  add hl,bc 
8df9 3e 30		  ld a,'0' 
8dfb 23			  inc hl  
8dfc be			  cp (hl)  
8dfd 28 fc		  jr z,$-2 
8dff			 
8dff			;Make sure that the string is non-empty! 
8dff 7e			  ld a,(hl) 
8e00 b7			  or a 
8e01 20 01		  jr nz,.atoub 
8e03 2b			  dec hl 
8e04			.atoub: 
8e04			 
8e04 f1			  pop af 
8e05 c1			  pop bc 
8e06 d1			  pop de 
8e07 c9			  ret 
8e08			 
8e08			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/toUpper.z80 
8e08			 
8e08			toUpper: 
8e08			;A is the char. 
8e08			;If A is a lowercase letter, this sets it to the matching uppercase 
8e08			;18cc or 30cc or 41cc 
8e08			;avg: 26.75cc 
8e08 fe 61		  cp 'a' 
8e0a d8			  ret c 
8e0b fe 7b		  cp 'z'+1 
8e0d d0			  ret nc 
8e0e d6 20		  sub 'a'-'A' 
8e10 c9			  ret 
