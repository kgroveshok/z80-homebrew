18db			 
18db			 
18db			FORTH_CHK_DSP_UNDER: macro 
18db				push hl 
18db				push de 
18db				ld hl,(cli_data_sp) 
18db				ld de, cli_data_stack 
18db				call cmp16 
18db				jp c, fault_dsp_under 
18db				pop de 
18db				pop hl 
18db				endm 
18db			 
18db			 
18db			FORTH_CHK_RSP_UNDER: macro 
18db				push hl 
18db				push de 
18db				ld hl,(cli_ret_sp) 
18db				ld de, cli_ret_stack 
18db				call cmp16 
18db				jp c, fault_rsp_under 
18db				pop de 
18db				pop hl 
18db				endm 
18db			 
18db			FORTH_CHK_LOOP_UNDER: macro 
18db				push hl 
18db				push de 
18db				ld hl,(cli_loop_sp) 
18db				ld de, cli_loop_stack 
18db				call cmp16 
18db				jp c, fault_loop_under 
18db				pop de 
18db				pop hl 
18db				endm 
18db			 
18db			FORTH_ERR_TOS_NOTSTR: macro 
18db				; TOSO might need more for checks when used 
18db				push af 
18db				ld a,(hl) 
18db				cp DS_TYPE_STR 
18db				jp nz, type_faultn   
18db				pop af 
18db				endm 
18db			 
18db			FORTH_ERR_TOS_NOTNUM: macro 
18db				push af 
18db				ld a,(hl) 
18db				cp DS_TYPE_INUM 
18db				jp nz, type_faultn   
18db				pop af 
18db				endm 
