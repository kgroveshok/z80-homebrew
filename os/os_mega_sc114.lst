c01d			 
c01d			.VARS: 
c01d				CWHEAD .V0 99 "VAR" 3 WORD_FLAG_CODE 
c01d 77				db WORD_SYS_CORE+99             
c01e 85 c0			dw .V0            
c020 04				db 3 + 1 
c021 .. 00			db "VAR",0              
c025				endm 
# End of macro CWHEAD
c025			; | VAR ( u1 -- )  Get the address of the (word) variable referenced on TOS  | DONE 
c025			; | 
c025			; | | The variable name should consist of a single letter (a-z). e.g. "a" 
c025			; | |  
c025			; | | e.g. 
c025			; | |         #30 a var ! 
c025			; | |         a var @ . 
c025			; | |   
c025			; | |     Displays the number 30 
c025			; | | 
c025			; | | Each variable pointer is a word so can use for any words that use that:  
c025			; | |  
c025			; | | e.g. 
c025			; | |  
c025			; | |         #30 a var 2! 
c025			; | |         a var 2@ . 
c025			; | |   
c025			; | |     Displays the number 30 
c025			; | |  
c025			; | | > [!NOTE]  
c025			; ! | > If a full string is passed then only the first char is looked at 
c025			; | | > Any other char could exceed bounds checks!  
c025			; | | > 
c025			; | | > Each variable location follows the previous. Watch you don't clobber any others. 
c025			 
c025					if DEBUG_FORTH_WORDS_KEY 
c025						DMARK "VAR" 
c025				if DEMARK_VERSION = 1  
c025 e5					push hl  
c026 21 2e c0				ld hl, .dmark  
c029 22 60 ee				ld (debug_mark), hl  
c02c				endif  
c02c				if DEMARK_VERSION = 0  
c02c					push af  
c02c					ld a, (.dmark)  
c02c					ld (debug_mark),a  
c02c					ld a, (.dmark+1)  
c02c					ld (debug_mark+1),a  
c02c					ld a, (.dmark+2)  
c02c					ld (debug_mark+2),a  
c02c				endif  
c02c 18 04			jr .pastdmark  
c02e ..			.dmark: db "VAR"  
c031				if DEMARK_VERSION = 1  
c031 00					db 0  
c032				endif  
c032				if DEMARK_VERSION = 1  
c032 e1			.pastdmark: pop hl  
c033				endif  
c033				if DEMARK_VERSION = 0  
c033			.pastdmark: pop af  
c033				endif  
c033			endm  
# End of macro DMARK
c033						CALLMONITOR 
c033				if BASE_CPM=1  
c033					call debug_vector  
c033				endif  
c033				if BASE_KEV=1  
c033					rst 8  
c033				endif  
c033				endm  
# End of macro CALLMONITOR
c033					endif 
c033			 
c033					FORTH_DSP_VALUEHL 
c033				if BASE_CPM=1 
c033				call macro_dsp_valuehl 
c033				endif 
c033				if BASE_KEV=1 
c033					rst $18 
c033				endif 
c033				endm 
# End of macro FORTH_DSP_VALUEHL
