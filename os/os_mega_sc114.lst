8ced			;; 	ASCII char code for 0-9,A-F in A to single hex digit 
8ced			;;    subtract $30, if result > 9 then subtract $7 more 
8ced			;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; 
8ced			atohex: 
8ced d6 30				SUB $30 
8cef fe 0a				CP 10 
8cf1 f8					RET M		; If result negative it was 0-9 so we're done 
8cf2 d6 07				SUB $7		; otherwise, subtract $7 more to get to $0A-$0F 
8cf4 c9					RET		 
