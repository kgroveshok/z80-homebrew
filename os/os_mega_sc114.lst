c01d			if STORAGE_SE 
c01d				CWHEAD .SPICEH 61 "SPICEL" 6 WORD_FLAG_CODE 
c01d			; | SPICEL ( -- ) Set SPI CE low for the currently selected device |  DONE 
c01d			 
c01d					call spi_ce_low 
c01d			    NEXTW 
c01d			 
c01d			.SPICEH: 
c01d				CWHEAD .SPIBOb 61 "SPICEH" 6 WORD_FLAG_CODE 
c01d			; | SPICEH ( -- ) Set SPI CE high for the currently selected device |  DONE 
c01d			 
c01d					call spi_ce_high 
c01d			    NEXTW 
c01d			 
c01d			.SPIBOb: 
c01d			 
c01d				CWHEAD .SPII 61 "SPIO" 4 WORD_FLAG_CODE 
c01d			; | SPIO ( u1 -- ) Send byte u1 to SPI  |  DONE 
c01d			 
c01d					if DEBUG_FORTH_WORDS_KEY 
c01d						DMARK "SPo" 
c01d						CALLMONITOR 
c01d					endif 
c01d					; get port 
c01d			 
c01d			 
c01d					; get byte to send 
c01d			 
c01d					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
c01d			 
c01d			;		push hl    ; u1  
c01d			 
c01d					; destroy value TOS 
c01d			 
c01d					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
c01d			 
c01d					; one value on hl get other one back 
c01d			 
c01d			;		pop hl   ; u2 - addr 
c01d			 
c01d					; TODO Send SPI byte 
c01d			 
c01d			;		push hl 
c01d			;		call spi_ce_low 
c01d			;		pop hl 
c01d					ld a, l 
c01d					call spi_send_byte 
c01d			;		call spi_ce_high 
c01d			 
c01d					NEXTW 
c01d			 
c01d			.SPII: 
c01d				CWHEAD .SESEL 62 "SPII" 5 WORD_FLAG_CODE 
c01d			; | SPII ( -- u1 ) Get a byte from SPI  | DONE 
c01d					if DEBUG_FORTH_WORDS_KEY 
c01d						DMARK "SPi" 
c01d						CALLMONITOR 
c01d					endif 
c01d			 
c01d					; TODO Get SPI byte 
c01d			 
c01d					call spi_read_byte 
c01d			 
c01d					if DEBUG_FORTH_WORDS 
c01d						DMARK "Si2" 
c01d						CALLMONITOR 
c01d					endif 
c01d					ld h, 0 
c01d					ld l, a 
c01d					if DEBUG_FORTH_WORDS 
c01d						DMARK "Si3" 
c01d						CALLMONITOR 
c01d					endif 
c01d					;call forth_push_numhl 
c01d					FORTH_PUSH_VALUEHL 
c01d			 
c01d					NEXTW 
c01d			 
c01d			 
c01d			 
c01d			.SESEL: 
c01d				CWHEAD .SESELS 82 "BANK?" 5 WORD_FLAG_CODE 
c01d			; | BANK? ( -- u ) Reports on the serial EEPROM Bank Device at bank address u1 1-5.  | DONE 
c01d			; | | Zero is disabled storage. 
c01d					if DEBUG_FORTH_WORDS_KEY 
c01d						DMARK "BN?" 
c01d						CALLMONITOR 
c01d					endif 
c01d					ld a, (spi_device_id) 
c01d					sub '0' 
c01d					ld h, 0 
c01d					ld l, a 
c01d					FORTH_PUSH_VALUEHL 
c01d					;call forth_push_numhl 
c01d					NEXTW 
c01d			.SESELS: 
c01d				CWHEAD .CARTDEV 82 "BANK" 4 WORD_FLAG_CODE 
c01d			; | BANK ( u1 -- ) Select Serial EEPROM Bank Device at bank address u1 1-5 (disables CARTDEV).  | DONE 
c01d			; | | Set to zero to disable storage. 
c01d					if DEBUG_FORTH_WORDS_KEY 
c01d						DMARK "BNK" 
c01d						CALLMONITOR 
c01d					endif 
c01d			 
c01d					ld a, 255 
c01d					ld (spi_cartdev), a 
c01d			 
c01d					; get bank 
c01d			 
c01d					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
c01d			 
c01d			;		push hl 
c01d			 
c01d					; destroy value TOS 
c01d			 
c01d					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
c01d			 
c01d					; one value on hl get other one back 
c01d			 
c01d			;		pop hl 
c01d			 
c01d			 
c01d					ld c, SPI_CE_HIGH 
c01d					ld b, '0'    ; human readable bank number 
c01d			 
c01d					ld a, l 
c01d			 
c01d					if DEBUG_FORTH_WORDS 
c01d						DMARK "BNK" 
c01d						CALLMONITOR 
c01d					endif 
c01d			 
c01d					; active low 
c01d			 
c01d			;		cp 0 
c01d					or a 
c01d					jr z, .bset 
c01d					cp 1 
c01d					jr nz, .b2 
c01d					res 0, c 
c01d					ld b, '1'    ; human readable bank number 
c01d			.b2:		cp 2 
c01d					jr nz, .b3 
c01d					res 1, c 
c01d					ld b, '2'    ; human readable bank number 
c01d			.b3:		cp 3 
c01d					jr nz, .b4 
c01d					res 2, c 
c01d					ld b, '3'    ; human readable bank number 
c01d			.b4:		cp 4 
c01d					jr nz, .b5 
c01d					res 3, c 
c01d					ld b, '4'    ; human readable bank number 
c01d			.b5:		cp 5 
c01d					jr nz, .bset 
c01d					res 4, c 
c01d					ld b, '5'    ; human readable bank number 
c01d			 
c01d			.bset: 
c01d					ld a, c 
c01d					ld (spi_device),a 
c01d					ld a, b 
c01d					ld (spi_device_id),a 
c01d					if DEBUG_FORTH_WORDS 
c01d						DMARK "BN2" 
c01d						CALLMONITOR 
c01d					endif 
c01d			 
c01d					; set default SPI clk pulse time as disabled for BANK use 
c01d			 
c01d					ld a, 0 
c01d					ld (spi_clktime), a 
c01d			 
c01d					NEXTW 
c01d			 
c01d			.CARTDEV: 
c01d				CWHEAD .ENDDEVICE 82 "CARTDEV" 7 WORD_FLAG_CODE 
c01d			; | CARTDEV ( u1 -- ) Select cart device 1-8 (Disables BANK). | DONE 
c01d			; | | Set to zero to disable devices. 
c01d					if DEBUG_FORTH_WORDS_KEY 
c01d						DMARK "CDV" 
c01d						CALLMONITOR 
c01d					endif 
c01d			 
c01d					; disable se storage bank selection 
c01d			 
c01d					ld a, SPI_CE_HIGH		; ce high 
c01d					ld (spi_device), a 
c01d			 
c01d					; get bank 
c01d			 
c01d					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
c01d			 
c01d			;		push hl 
c01d			 
c01d					; destroy value TOS 
c01d			 
c01d					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
c01d			 
c01d					; one value on hl get other one back 
c01d			 
c01d			;		pop hl 
c01d			 
c01d					; active low 
c01d			 
c01d					ld c, 255 
c01d			 
c01d					ld a, l 
c01d					if DEBUG_FORTH_WORDS 
c01d						DMARK "CDV" 
c01d						CALLMONITOR 
c01d					endif 
c01d			;		cp 0 
c01d					or a 
c01d					jr z, .cset 
c01d					cp 1 
c01d					jr nz, .c2 
c01d					res 0, c 
c01d			.c2:		cp 2 
c01d					jr nz, .c3 
c01d					res 1, c 
c01d			.c3:		cp 3 
c01d					jr nz, .c4 
c01d					res 2, c 
c01d			.c4:		cp 4 
c01d					jr nz, .c5 
c01d					res 3, c 
c01d			.c5:		cp 5 
c01d					jr nz, .c6 
c01d					res 4, c 
c01d			.c6:		cp 6 
c01d					jr nz, .c7 
c01d					res 5, c 
c01d			.c7:		cp 7 
c01d					jr nz, .c8 
c01d					res 6, c 
c01d			.c8:		cp 8 
c01d					jr nz, .cset 
c01d					res 7, c 
c01d			.cset:		ld a, c 
c01d					ld (spi_cartdev),a 
c01d			 
c01d					if DEBUG_FORTH_WORDS 
c01d						DMARK "CD2" 
c01d						CALLMONITOR 
c01d					endif 
c01d			 
c01d					; set default SPI clk pulse time as 10ms for CARTDEV use 
c01d			 
c01d					ld a, $0a 
c01d					ld (spi_clktime), a 
c01d					NEXTW 
c01d			endif 
c01d			 
c01d			.ENDDEVICE: 
c01d			; eof 
