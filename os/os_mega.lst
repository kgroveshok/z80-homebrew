2154			; My forth kernel 
2154			include "forth_kernel.asm" 
2154			; 
2154			; kernel to the forth OS 
2154			 
2154			DS_TYPE_STR: equ 1     ; string type 
2154			DS_TYPE_INUM: equ 2     ; $ 16 bit unsigned int usually a hex address 
2154			DS_TYPE_SNUM: equ 3     ; $ 16 bit signed int  
2154			DS_TYPE_CONST: equ 4     ; string type that won't be freed on a POP 
2154			;DS_TYPE_FNUM: equ 3      ; 24/32 bit floating point  do string conversion instead of a new type 
2154			 
2154			FORTH_PARSEV1: equ 0 
2154			FORTH_PARSEV2: equ 0 
2154			FORTH_PARSEV3: equ 0 
2154			FORTH_PARSEV4: equ 0 
2154			FORTH_PARSEV5: equ 0 
2154			FORTH_PARSEV6: equ 1 
2154			 
2154			;if FORTH_PARSEV5 
2154			;	FORTH_END_BUFFER: equ 0 
2154			;else 
2154			FORTH_END_BUFFER: equ 127 
2154			;endif 
2154			 
2154			FORTH_TRUE: equ 1 
2154			FORTH_FALSE: equ 0 
2154			 
2154			if FORTH_PARSEV4 
2154			include "forth_stackops.asm" 
2154			endif 
2154			 
2154			if FORTH_PARSEV5 
2154			include "forth_stackopsv5.asm" 
2154			endif 
2154			 
2154			if FORTH_PARSEV6 
2154			include "forth_stackopsv5.asm" 
2154			 
2154			; Stack operations for v5 parser on wards 
2154			; * DATA stack 
2154			; * LOOP stack 
2154			; * RETURN stack 
2154			 
2154			 
2154			 
2154			FORTH_CHK_DSP_UNDER: macro 
2154				push hl 
2154				push de 
2154				ld hl,(cli_data_sp) 
2154				ld de, cli_data_stack 
2154				call cmp16 
2154				jp c, fault_dsp_under 
2154				pop de 
2154				pop hl 
2154				endm 
2154			 
2154			 
2154			FORTH_CHK_RSP_UNDER: macro 
2154				push hl 
2154				push de 
2154				ld hl,(cli_ret_sp) 
2154				ld de, cli_ret_stack 
2154				call cmp16 
2154				jp c, fault_rsp_under 
2154				pop de 
2154				pop hl 
2154				endm 
2154			 
2154			FORTH_CHK_LOOP_UNDER: macro 
2154				push hl 
2154				push de 
2154				ld hl,(cli_loop_sp) 
2154				ld de, cli_loop_stack 
2154				call cmp16 
2154				jp c, fault_loop_under 
2154				pop de 
2154				pop hl 
2154				endm 
2154			 
2154			FORTH_ERR_TOS_NOTSTR: macro 
2154				; TOSO might need more for checks when used 
2154				push af 
2154				ld a,(hl) 
2154				cp DS_TYPE_STR 
2154				jp nz, type_faultn   
2154				pop af 
2154				endm 
2154			 
2154			FORTH_ERR_TOS_NOTNUM: macro 
2154				push af 
2154				ld a,(hl) 
