1dad			.HEAP: 
1dad			CWHEAD .EXEC OPCODE_HEAP "HEAP" 4 WORD_FLAG_CODE 
1dad 15				db WORD_SYS_CORE+OPCODE_HEAP             
1dae e4 1d			dw .EXEC            
1db0 05				db 4 + 1 
1db1 .. 00			db "HEAP",0              
1db6				endm 
# End of macro CWHEAD
1db6			; | HEAP ( -- u1 u2 )   Pushes u1 the current number of bytes in the heap and u2 the remaining bytes - Only present if using my MALLOC | DONE 
1db6			; | | u1 - Current number of bytes in the heap 
1db6			; | | u2 - Remaining bytes left on the heap 
1db6			; | |  
1db6			; | | The heap is used for storing user defined words as well as any values pushed to stack. 
1db6			 
1db6			 
1db6				if DEBUG_FORTH_WORDS_KEY 
1db6					DMARK "HEP" 
1db6				if DEMARK_VERSION = 1  
1db6 e5					push hl  
1db7 21 bf 1d				ld hl, .dmark  
1dba 22 60 ee				ld (debug_mark), hl  
1dbd				endif  
1dbd				if DEMARK_VERSION = 0  
1dbd					push af  
1dbd					ld a, (.dmark)  
1dbd					ld (debug_mark),a  
1dbd					ld a, (.dmark+1)  
1dbd					ld (debug_mark+1),a  
1dbd					ld a, (.dmark+2)  
1dbd					ld (debug_mark+2),a  
1dbd				endif  
1dbd 18 04			jr .pastdmark  
1dbf ..			.dmark: db "HEP"  
1dc2				if DEMARK_VERSION = 1  
1dc2 00					db 0  
1dc3				endif  
1dc3				if DEMARK_VERSION = 1  
1dc3 e1			.pastdmark: pop hl  
1dc4				endif  
1dc4				if DEMARK_VERSION = 0  
1dc4			.pastdmark: pop af  
1dc4				endif  
1dc4			endm  
# End of macro DMARK
1dc4					CALLMONITOR 
1dc4				if BASE_CPM=1  
1dc4 cd 6b ee				call debug_vector  
1dc7				endif  
1dc7				if BASE_KEV=1  
1dc7					rst 8  
1dc7				endif  
1dc7				endm  
# End of macro CALLMONITOR
1dc7				endif 
1dc7 2a 58 5b			ld hl, (free_list )      
1dca 11 5d 5b			ld de, heap_start 
