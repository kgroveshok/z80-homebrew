931d			config_fdir: 
931d				; using the scratch dir go through and release the memory allocated for each string 
931d				 
931d				ld hl, scratch 
931d			.cfdir:	ld e,(hl) 
931d				inc hl 
931d				ld d,(hl) 
931d				inc hl 
931d			 
931d				ex de, hl 
931d				call ishlzero 
931d				ret z     ; return on null pointer 
931d				call free 
931d				ex de, hl 
931d				jr .cfdir 
931d			 
931d			 
931d				ret 
931d			 
931d			 
931d			config_dir: 
931d			 
931d				; for the config menus that need to build a directory of storage call this routine 
931d				; it will construct a menu in scratch to pass to menu 
931d			 
931d				; open storage device 
931d			 
931d				; execute DIR to build a list of files and their ids into scratch in menu format 
931d				; once the menu has finished then will need to call config_fdir to release the strings 
931d				 
931d				; c = number items 
931d			 
931d				 
931d				call storage_get_block_0 
931d			 
931d				ld hl, store_page     ; get current id count 
931d				ld b, (hl) 
931d				ld c, 0    ; count of files   
931d			 
931d			 
931d				ld hl, scratch 
931d				ld (store_tmp2), hl    ; location to poke strings 
931d			 
931d				; check for empty drive 
931d			 
931d				ld a, 0 
931d				cp b 
931d				jp z, .dirdone 
931d			 
931d				 
931d					if DEBUG_FORTH_WORDS 
931d						DMARK "Cdc" 
931d						CALLMONITOR 
931d					endif 
931d			 
931d			 
931d			.diritem:	 
931d				push bc 
931d				; for each of the current ids do a search for them and if found push to stack 
931d			 
931d					ld hl, STORE_BLOCK_PHY 
931d					ld d, 0		 ; look for extent 0 of block id as this contains file name 
931d					ld e,b 
931d			 
931d					call storage_findnextid 
931d			 
931d			 
931d					; if found hl will be non zero 
931d			 
931d					call ishlzero 
931d					jr z, .dirnotfound 
931d			 
931d					; increase count 
931d			 
931d					pop bc	 
931d					inc c 
931d					push bc 
931d					 
931d			 
931d					; get file header and push the file name 
931d			 
931d					ld de, store_page 
931d					call storage_read_block 
931d			 
931d					; push file id to stack 
931d				 
931d					ld a, (store_page) 
931d					ld h, 0 
931d					ld l, a 
931d			 
931d					;call forth_push_numhl 
931d					; TODO store id 
931d			 
931d					push hl 
931d			 
931d					; push extent count to stack  
931d				 
931d					ld hl, store_page+3 
931d			 
931d					; get file name length 
931d			 
931d					call strlenz   
931d			 
931d					inc hl   ; cover zero term 
931d					inc hl  ; stick the id at the end of the area 
931d			 
931d					push hl 
931d					pop bc    ; move length to bc 
931d			 
931d					call malloc 
931d			 
931d					; TODO save malloc area to scratch 
931d			 
931d					ex de, hl 
931d					ld hl, (store_tmp2) 
931d					ld (hl), e 
931d					inc hl 
931d					ld (hl), d 
931d					inc hl 
931d					ld (store_tmp2), hl 
931d			 
931d					 
931d			 
931d					;pop hl   ; get source 
931d			;		ex de, hl    ; swap aronund	 
931d			 
931d					ld hl, store_page+3 
931d					if DEBUG_FORTH_WORDS 
931d						DMARK "CFd" 
931d						CALLMONITOR 
931d					endif 
931d					ldir 
931d			 
931d					; de is past string, move back one and store id 
931d					 
931d					dec de 
931d			 
931d					; store file id 
931d			 
931d					pop hl 
931d					ex de,hl 
931d					ld (hl), e 
931d			 
931d					if DEBUG_FORTH_WORDS 
931d						DMARK "Cdi" 
931d						CALLMONITOR 
931d					endif 
931d					 
931d			.dirnotfound: 
931d					pop bc     
931d					djnz .diritem 
931d				 
931d			.dirdone:	 
931d			 
931d			;		ld a, 0 
931d					ld hl, (store_tmp2) 
931d					ld (hl), 0 
931d					inc hl 
931d					ld (hl), 0 
931d					inc hl 
931d					; push a count of the dir items found 
931d			 
931d			;		ld h, 0 
931d			;		ld l, c 
931d			 
931d				ret 
931d			 
931d			endif 
