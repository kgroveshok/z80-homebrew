68a4				call update_display 
68a4				call delay1s 
68a4				call cin_wait 
68a4						 
68a4				cp '*' 
68a4				jr z, .startupend1 
68a4				cp '#' 
68a4				jr nz, .startno 
68a4				ld a, 1 
68a4				ld (os_last_cmd),a 
68a4				jr .startdo 
68a4			.startno:	cp '1' 
68a4				jr z,.startnxt  
68a4			 
68a4				; exec startup line 
68a4			.startdo:	 
68a4				pop hl 
68a4				push hl 
68a4				 
68a4				ld e,(hl) 
68a4				inc hl 
68a4				ld d,(hl) 
68a4				ex de,hl 
68a4			 
68a4				push hl 
68a4			 
68a4				ld a, 0 
68a4				;ld a, FORTH_END_BUFFER 
68a4				call strlent 
68a4				inc hl   ; include zero term to copy 
68a4				ld b,0 
68a4				ld c,l 
68a4				pop hl 
68a4				ld de, scratch 
68a4				ldir 
68a4			 
68a4			 
68a4				ld hl, scratch 
68a4				call forthparse 
68a4				call forthexec 
68a4				call forthexec_cleanup 
68a4			 
68a4				ld a, display_row_4 
68a4				ld de, endprog 
68a4			 
68a4				call update_display		 
68a4			 
68a4				ld a, (os_last_cmd) 
68a4			;	cp 0 
68a4				or a 
68a4				jr nz, .startnxt 
68a4				call next_page_prompt 
68a4			        call clear_display 
68a4				call update_display		 
68a4			 
68a4				; move onto next startup line? 
68a4			.startnxt: 
68a4			 
68a4				call delay250ms 
68a4				pop hl 
68a4			 
68a4				inc hl 
68a4				inc hl 
68a4			 
68a4				push hl 
68a4				ld e, (hl) 
68a4				inc hl 
68a4				ld d, (hl) 
68a4				pop hl 
