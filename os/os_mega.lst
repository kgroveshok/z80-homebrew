241d			user_word_eol:  
241d				; hl contains the pointer to where to create a linked list item from the end 
241d				; of the user dict to continue on at the system word dict 
241d				 
241d				; poke the stub of the word list linked list to repoint to rom words 
241d			 
241d				; stub format 
241d				; db   word id 
241d				; dw    link to next word 
241d			        ; db char length of token 
241d				; db string + 0 term 
241d				; db exec code....  
241d			 
241d			;	ld a, WORD_SYS_ROOT     ; root word 
241d 36 00			ld (hl), WORD_SYS_ROOT		; word id 
241f 23				inc hl 
2420			 
2420 11 c9 25			ld de, sysdict 
2423 73				ld (hl), e		; next word link ie system dict 
2424 23				inc hl 
2425 72				ld (hl), d		; next word link ie system dict 
2426 23				inc hl	 
2427			 
2427			;	ld (hl), sysdict		; next word link ie system dict 
2427			;	inc hl 
2427			;	inc hl 
2427			 
2427			;	inc hl 
2427			;	inc hl 
2427			 
2427			;	ld a, 2			; word length is 0 
2427 36 02			ld (hl), 2 
2429 23				inc hl 
242a			 
242a			;	ld a, '~'			; word length is 0 
242a 36 7e			ld (hl), '~' 
242c 23				inc hl 
242d			;	ld a, 0			; save empty word 
242d 36 00			ld (hl), 0 
242f			 
242f c9				ret 
