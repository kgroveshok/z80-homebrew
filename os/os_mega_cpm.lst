1005			;      call  malloc            ; Allocates 0x9004 
1005			; 
1005			;      ld    HL, 12 
1005			;      call  malloc            ; Allocates 0x9014 
1005			; 
1005			;      ld    HL, 12 
1005			;      call  malloc            ; Allocates 0x9024 
1005			; 
1005			;      ; Free some allocations 
1005			;      ld    HL, 0x9014 
1005			;      call  free 
1005			; 
1005			;      ld    HL, 0x9004 
1005			;      call  free 
1005			; 
1005			;      ld    HL, 0x9024 
1005			;      call  free 
1005			; 
1005			; 
1005			;      halt 
