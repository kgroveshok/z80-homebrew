133d			if TAPE_SUPPORT   
133d				include "firmware_tape.asm"    ; Tape support on Device A by default  
133d			; Tape support 
133d			 
133d			 
133d			; encoding 
133d			;  
133d			; pulse marks  of stream 
133d			; proportial 
133d			 
133d			 
133d			; setup default tape params 
133d			tape_init:     
133d 3e 00			ld a, Device_A 
133f 32 89 f9			ld (tape_port), a 
1342			 
1342 3e fa			ld a, 250 
1344 32 84 f9			ld (tape_tm_gap), a 
1347			 
1347 21 40 1f			ld hl, 8000 
134a 22 85 f9			ld (tape_samples), hl 
134d			 
134d 3e 06			ld a, 6 
134f 32 88 f9			ld (tape_pulse_high), a 
1352			 
1352 3e 02			ld a, 2 
1354 32 87 f9			ld (tape_pulse_low), a 
1357			 
1357 21 32 00			ld hl, 50 
135a 22 82 f9			ld (tape_tm_high), hl 
135d			 
135d 21 32 00			ld hl, 50 
1360 22 80 f9			ld (tape_tm_low), hl 
1363 c9				ret 
1364			 
1364			; support routinues for tape 
1364			 
1364			 
1364			; Tape Output 
1364			 
1364			; osciallate the pin for the required duration 
1364			 
1364			tape_osc:  
1364				; hl has the number of iterations 
1364				; c = port number 
1364				; d = bus data 
1364				 
1364 ed 51			out (c), d 
1366			 
1366 2b				dec hl 
1367 cd e4 0d			call ishlzero 
136a 20 f8			jr nz, tape_osc 
136c				 
136c c9				ret 
136d			 
136d			; output a gap period 
136d			tape_gap:  
136d 3a 84 f9			ld a, (tape_tm_gap) 
1370 cd 99 0a			call aDelayInMS 
1373 c9				ret 
1374			 
1374			tape_byte_gap: 
1374 cd 6d 13			call tape_gap 
1377 cd 6d 13			call tape_gap 
137a cd 6d 13			call tape_gap 
137d cd 6d 13			call tape_gap 
1380 c9				ret 
1381			 
1381			; output a high period 
1381			 
1381			tape_high: 
1381 3a 89 f9			ld a, (tape_port) 
1384 4f				ld c, a 
1385 16 ff			ld d, 255 
1387 3a 88 f9			ld a, (tape_pulse_high) 
138a 47				ld b, a 
138b 2a 82 f9		.th:	ld hl, (tape_tm_high) 
138e cd 64 13			call tape_osc 
1391 10 f8			djnz .th 
1393 c9				 ret 
1394			 
1394			; output a low period 
1394			 
1394			tape_low:  
1394			 
1394 3a 89 f9			ld a, (tape_port) 
1397 4f				ld c, a 
1398 16 ff			ld d, 255 
139a 3a 87 f9			ld a, (tape_pulse_low) 
139d 47				ld b, a 
139e 2a 82 f9		.tl:	ld hl, (tape_tm_high) 
13a1			; keep the same pulse size and instead use count of pulse rather than length of pulse 
13a1			;	ld hl, (tape_tm_low) 
13a1 cd 64 13			call tape_osc 
13a4 10 f8			djnz .tl 
13a6 c9				 ret 
13a7			 
13a7			; end of save marker 
13a7			 
13a7			tape_end: 
13a7 3e ff			ld a, 255 
13a9 cd c0 13			call tape_byte_out 
13ac cd 74 13			call tape_byte_gap 
13af			 
13af 3e ff			ld a, 255 
13b1 cd c0 13			call tape_byte_out 
13b4 cd 74 13			call tape_byte_gap 
13b7 3e ff			ld a, 255 
13b9 cd c0 13			call tape_byte_out 
13bc cd 74 13			call tape_byte_gap 
13bf c9				 ret 
13c0			 
