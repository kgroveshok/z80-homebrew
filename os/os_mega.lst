1184			StrictStrCmp: 
1184				; Load next chars of each string 
1184 1a				ld a, (de) 
1185 47				ld b, a 
1186 7e				ld a, (hl) 
1187				; Compare 
1187 b8				cp b 
1188				; Return non-zero if chars don't match 
1188 c0				ret nz 
1189				; Check for end of both strings 
1189 fe 00			cp "\0" 
118b				; Return if strings have ended 
118b c8				ret z 
118c				; Otherwise, advance to next chars 
118c 23				inc hl 
118d 13				inc de 
118e 18 f4			jr StrictStrCmp 
