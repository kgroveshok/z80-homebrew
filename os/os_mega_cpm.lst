0fe5			;------------------------------------------------------------------------------ 
0fe5			;     heap_init                                                               : 
0fe5			;                                                                             : 
0fe5			; Description                                                                 : 
0fe5			;     Initialise the heap and make it ready for malloc and free operations.   : 
0fe5			;                                                                             : 
0fe5			;     The heap is maintained as a linked list, starting with an initial       : 
0fe5			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
0fe5			;     the first free block in the heap. Each block then points to the next    : 
0fe5			;     free block within the heap, and the free list ends at the first block   : 
0fe5			;     with a null pointer to the next free block.                             : 
0fe5			;                                                                             : 
0fe5			; Parameters                                                                  : 
0fe5			;     Inputs are compile-time only. Two defines which specify the starting    : 
0fe5			;     address of the heap and its size are required, along with a memory      : 
0fe5			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
0fe5			;     principally stores a pointer to the first free block in the heap.       : 
0fe5			;                                                                             : 
0fe5			; Returns                                                                     : 
0fe5			;     Nothing                                                                 : 
0fe5			;------------------------------------------------------------------------------ 
0fe5			heap_init: 
0fe5 e5			      push  HL 
0fe6			 
0fe6			      ; Initialise free list struct 
0fe6 21 a0 5b		      ld    HL, heap_start 
0fe9 22 9b 5b		      ld    (free_list), HL 
0fec 21 00 00		      ld    HL, 0 
0fef 22 9d 5b		      ld    (free_list+2), HL 
0ff2			 
0ff2			      ; Insert first free block at bottom of heap, consumes entire heap 
0ff2 21 72 e2		      ld    HL, heap_start+heap_size-4 
0ff5 22 a0 5b		      ld    (heap_start), HL        ; Next block (end of free list) 
0ff8 21 d2 86		      ld    HL, heap_size-4 
0ffb 22 a2 5b		      ld    (heap_start+2), HL      ; Block size 
0ffe			 
0ffe			      ; Insert end of free list block at top of heap - two null words will 
0ffe			      ; terminate the free list 
0ffe 21 00 00		      ld    HL, 0 
1001 22 74 e2		      ld    (heap_start+heap_size-2), HL 
1004 22 72 e2		      ld    (heap_start+heap_size-4), HL 
1007			 
1007 e1			      pop   HL 
1008			 
1008 c9			      ret 
1009			 
