101a			; 
101a			; Get a word (16 bit) in hexadecimal notation. The result is returned in HL. 
101a			; Since the routines get_byte and therefore get_nibble are called, only valid 
101a			; characters (0-9a-f) are accepted. 
101a			; 
101a			;get_word        push    af 
101a			;                call    get_byte        ; Get the upper byte 
101a			;                ld      h, a 
101a			;                call    get_byte        ; Get the lower byte 
101a			;                ld      l, a 
101a			;                pop     af 
101a			;                ret 
101a			; 
101a			; Get a byte in hexadecimal notation. The result is returned in A. Since 
101a			; the routine get_nibble is used only valid characters are accepted - the  
101a			; input routine only accepts characters 0-9a-f. 
101a			; 
101a c5			get_byte:        push    bc              ; Save contents of B (and C) 
101b 7e					ld a,(hl) 
101c 23					inc hl 
101d cd 42 10		                call    nibble2val      ; Get upper nibble 
1020 cb 07		                rlc     a 
1022 cb 07		                rlc     a 
1024 cb 07		                rlc     a 
1026 cb 07		                rlc     a 
1028 47			                ld      b, a            ; Save upper four bits 
1029 7e					ld a,(hl) 
102a cd 42 10		                call    nibble2val      ; Get lower nibble 
102d b0			                or      b               ; Combine both nibbles 
102e c1			                pop     bc              ; Restore B (and C) 
102f c9			                ret 
