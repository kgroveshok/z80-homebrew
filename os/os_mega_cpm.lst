1d80 93 1d			dw .NMICLREND            
1d82 07				db 6 + 1 
1d83 .. 00			db "NMICLR",0              
1d8a				endm 
# End of macro CWHEAD
1d8a			; | NMICLR ( -- ) Clears the use of the NMI switch | DONE 
1d8a cd 11 5a			call clear_nmi 
1d8d			 
1d8d				NEXTW 
1d8d cd 68 ee			call parse_vector 
1d90 c3 46 1c			jp macro_next 
1d93				endm 
