1c37			user_word_eol:  
1c37				; hl contains the pointer to where to create a linked list item from the end 
1c37				; of the user dict to continue on at the system word dict 
1c37				 
1c37				; poke the stub of the word list linked list to repoint to rom words 
1c37			 
1c37				; stub format 
1c37				; db   word id 
1c37				; dw    link to next word 
1c37			        ; db char length of token 
1c37				; db string + 0 term 
1c37				; db exec code....  
1c37			 
1c37			;	ld a, WORD_SYS_ROOT     ; root word 
1c37 36 00			ld (hl), WORD_SYS_ROOT		; word id 
1c39 23				inc hl 
1c3a			 
1c3a 11 e3 1d			ld de, sysdict 
1c3d 73				ld (hl), e		; next word link ie system dict 
1c3e 23				inc hl 
1c3f 72				ld (hl), d		; next word link ie system dict 
1c40 23				inc hl	 
1c41			 
1c41			;	ld (hl), sysdict		; next word link ie system dict 
1c41			;	inc hl 
1c41			;	inc hl 
1c41			 
1c41			;	inc hl 
1c41			;	inc hl 
1c41			 
1c41			;	ld a, 2			; word length is 0 
1c41 36 02			ld (hl), 2 
1c43 23				inc hl 
1c44			 
1c44			;	ld a, '~'			; word length is 0 
1c44 36 7e			ld (hl), '~' 
1c46 23				inc hl 
1c47			;	ld a, 0			; save empty word 
1c47 36 00			ld (hl), 0 
