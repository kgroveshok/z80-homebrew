2490			WORD_SYS_DELETED: equ 3 ; Op code for a deleted UWORD 
2490			WORD_SYS_ROOT: equ 0   ; Opcode for all user words 
2490			WORD_SYS_END: equ 0   ; Opcode for all user words 
2490			WORD_SYS_CORE: equ 20    ; Offset for dict core words opcode 
