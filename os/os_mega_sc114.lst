8f24			malloc_no_space: 
8f24 21 06 00		      ld    HL, 6                   ; Clean up stack frame 
8f27 39			      add   HL, SP 
8f28 f9			      ld    SP, HL 
8f29			 
8f29 eb			      ex    DE, HL                  ; Alloc addr into HL for return 
8f2a					if DEBUG_FORTH_MALLOC 
8f2a						DMARK "MAN" 
8f2a						CALLMONITOR 
8f2a					endif 
8f2a			 
8f2a			malloc_early_exit: 
8f2a					if DEBUG_FORTH_MALLOC 
8f2a						DMARK "MAx" 
8f2a						CALLMONITOR 
8f2a					endif 
8f2a dd e1		      pop   IX 
8f2c d1			      pop   DE 
8f2d c1			      pop   BC 
8f2e			 
8f2e			if DEBUG_FORTH_MALLOC_HIGH 
