6e11			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6e11 3e 20		WrFn4bit:   LD   A, 00100000b  ;4-bit mode  
6e13 18 02		            JR   WrFunc  
6e15 3e 30		WrFn8bit:   LD   A, 00110000b  ;8-bit mode  
6e17 f5			WrFunc:     PUSH AF  
6e18 f5					push af  
6e19 3a fb fa				ld a, (display_lcde1e2)  
6e1c fe 00				cp 0     ; e1  
6e1e 20 0f				jr nz, .wfea2	  
6e20 f1					pop af  
6e21 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6e23 cb df		            SET  kLCDBitE, A     ; TODO Decide which E is being set  
6e25 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6e27 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6e29 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6e2b d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6e2d 18 0d			jr .wfskip  
6e2f f1			.wfea2:		pop af  
6e30 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6e32 cb c7		            SET  kLCDBitE2, A     ; TODO Decide which E is being set  
6e34 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6e36 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6e38 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6e3a d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6e3c 3e 05		.wfskip:            LD  A, 5  
6e3e cd 45 6e		            CALL LCDDelay       ;Delay 5 ms to complete  
6e41 f1			            POP  AF  
6e42 c9			            RET  
6e43			  
6e43			  
6e43			; Delay in milliseconds  
6e43			;   On entry: A = Number of milliseconds delay  
6e43			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6e43 3e 01		LCDDelay1:  LD   A, 1           ;Delay by 1 ms  
6e45 d5			LCDDelay:   PUSH DE  
6e46 5f			            LD   E, A           ;Delay by 'A' ms  
6e47 16 00		            LD   D, 0  
6e49 cd 62 0a		            CALL aDelayInMS  
6e4c d1			            POP  DE  
6e4d c9			            RET  
