8da8			; Decimal Signed Version 
8da8			 
8da8			; DispA 
8da8			; -------------------------------------------------------------- 
8da8			; Converts a signed integer value to a zero-terminated ASCII 
8da8			; string representative of that value (using radix 10). 
8da8			; -------------------------------------------------------------- 
8da8			; INPUTS: 
8da8			;     HL     Value to convert (two's complement integer). 
8da8			;     DE     Base address of string destination. (pointer). 
8da8			; -------------------------------------------------------------- 
8da8			; OUTPUTS: 
8da8			;     None 
8da8			; -------------------------------------------------------------- 
8da8			; REGISTERS/MEMORY DESTROYED 
8da8			; AF HL 
8da8			; -------------------------------------------------------------- 
8da8			 
8da8			;DispHLToASCII: 
8da8			;   push    de 
8da8			;   push    bc 
8da8			; 
8da8			;; Detect sign of HL. 
8da8			;    bit    7, h 
8da8			;    jr     z, ._DoConvert 
8da8			; 
8da8			;; HL is negative. Output '-' to string and negate HL. 
8da8			;    ld     a, '-' 
8da8			;    ld     (de), a 
8da8			;    inc    de 
8da8			; 
8da8			;; Negate HL (using two's complement) 
8da8			;    xor    a 
8da8			;    sub    l 
8da8			;    ld     l, a 
8da8			;    ld     a, 0     ; Note that XOR A or SUB A would disturb CF 
8da8			;    sbc    a, h 
8da8			;    ld     h, a 
8da8			; 
8da8			;; Convert HL to digit characters 
8da8			;._DoConvert: 
8da8			;    ld     b, 0     ; B will count character length of number 
8da8			;-   ld     a, 10 
8da8			;    syscall  .DivHLByA  ; HL = HL / A, A = remainder 
8da8			;    push   af 
8da8			;    inc    b 
8da8			;    ld     a, h 
8da8			;    or     l 
8da8			;    jr     nz, - 
8da8			; 
8da8			;; Retrieve digits from stack 
8da8			;-   pop    af 
8da8			;    or     $30 
8da8			;    ld     (de), a 
8da8			;    inc    de 
8da8			;    djnz   - 
8da8			; 
8da8			;; Terminate string with NULL 
8da8			;    xor    a 
8da8			;    ld     (de), a 
8da8			; 
8da8			;    pop    bc 
8da8			;    pop    de 
8da8			;    ret 
8da8			 
8da8			;Comments 
8da8			; 
8da8			;    This routine uses the common positive-integer radix conversion algorithm of repeatedly dividing a value by the desired radix (base case: the value is zero) and saving the remainders of each division. 
8da8			;    As this algorithm gives the digits in reverse order, they are pushed onto the hardware stack so that subsequently popping them yields the correct order. 
8da8			;    Note that the output string will not be fixed-width. 
8da8			; 
8da8			;Example Usage 
8da8			; 
8da8			;    ld    hl, -1004 
8da8			;    ld    de, OP1 
8da8			;    call  DispA 
8da8			;    ld    hl, OP1 
8da8			;    syscall  PutS 
8da8			 
8da8			 
8da8			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/string_to_uint16.z80 
8da8			 
8da8			 
8da8			;Converts an ASCII string to an unsigned 16-bit integer 
8da8			;Quits when it reaches a non-decimal digit 
8da8			 
8da8			string_to_uint16: 
8da8			atoui_16: 
8da8			;Input: 
8da8			;     DE points to the string 
8da8			;Outputs: 
8da8			;     HL is the result 
8da8			;     A is the 8-bit value of the number 
8da8			;     DE points to the byte after the number 
8da8			;Destroys: 
8da8			;     BC 
8da8			;       if the string is non-empty, BC is HL/10 
8da8			;Size:  24 bytes 
8da8			;Speed: 42+d(104+{0,9}) 
8da8			;       d is the number of digits in the number 
8da8			;       max is 640 cycles for a 5 digit number 
8da8			;Assuming no leading zeros: 
8da8			;1 digit:  146cc 
8da8			;2 digit:  250cc 
8da8			;3 digit:  354cc or 363cc (avg: 354.126cc) 
8da8			;4 digit:  458cc or 467cc (avg: 458.27cc) 
8da8			;5 digit:  562cc or 571cc or 580cc (avg: 562.4104cc) 
8da8			;avg: 544.81158447265625cc (544+13297/16384) 
8da8			;=============================================================== 
8da8 21 00 00		  ld hl,0 
8dab			.u16a: 
8dab 1a			  ld a,(de) 
8dac d6 30		  sub 30h 
8dae fe 0a		  cp 10 
8db0 d0			  ret nc 
8db1 13			  inc de 
8db2 44			  ld b,h 
8db3 4d			  ld c,l 
8db4 29			  add hl,hl 
8db5 29			  add hl,hl 
8db6 09			  add hl,bc 
8db7 29			  add hl,hl 
8db8 85			  add a,l 
8db9 6f			  ld l,a 
8dba 30 ef		  jr nc,.u16a 
8dbc 24			  inc h 
8dbd c3 ab 8d		  jp .u16a 
