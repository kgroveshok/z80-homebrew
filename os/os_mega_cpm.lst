0be0			;http://z80-heaven.wikidot.com/math 
0be0			; 
0be0			;Inputs: 
0be0			;     DE and A are factors 
0be0			;Outputs: 
0be0			;     A is not changed 
0be0			;     B is 0 
0be0			;     C is not changed 
0be0			;     DE is not changed 
0be0			;     HL is the product 
0be0			;Time: 
0be0			;     342+6x 
0be0			; 
0be0			Mult16: 
0be0			 
0be0 06 08		     ld b,8          ;7           7 
0be2 21 00 00		     ld hl,0         ;10         10 
0be5 29			       add hl,hl     ;11*8       88 
0be6 07			       rlca          ;4*8        32 
0be7 30 01		       jr nc,$+3     ;(12|18)*8  96+6x 
0be9 19			         add hl,de   ;--         -- 
0bea 10 f9		       djnz $-5      ;13*7+8     99 
0bec c9			ret 
