2c9e			; | MONITOR ( -- ) Display system breakpoint/monitor | DONE 
2c9e			; | | At start the current various registers will be displayed with contents. 
2c9e			; | | Top right corner will show the most recent debug marker seen. 
2c9e			; | | The bottom of the screen will also show the values of the data stack pointer (DSP) 
2c9e			; | | and the return stack pointer (RSP). 
2c9e			; | | Pressing: 
2c9e			; | |  
2c9e			; | |    1 - Initial screen 
2c9e			; | |  
2c9e			; | |    2 - Display a data dump of HL 
2c9e			; | |  
2c9e			; | |    3 - Display a data dump of DE 
2c9e			; | |  
2c9e			; | |    4 - Display a data dump of BC 
2c9e			; | |  
2c9e			; | |    5 - Display a data dump of HL 
2c9e			; | |  
2c9e			; | |    6 - Display a data dump of DSP 
2c9e			; | |  
2c9e			; | |    7 - Display a data dump of RSP 
2c9e			; | |  
2c9e			; | |    8 - Display a data dump of what is at DSP 
2c9e			; | |  
2c9e			; | |    9 - Display a data dump of what is at RSP 
2c9e			; | |  
2c9e			; | |    0 - Exit monitor and continue running. This will also enable break points 
2c9e			; | |  
2c9e			; | |    * - Disable break points 
2c9e			; | |  
2c9e			; | |    # - Enter traditional monitor mode 
2c9e			; | |  
2c9e			; | | 
2c9e			; | | Monitor Mode 
2c9e			; | | ------------ 
2c9e			; | | A prompt of '>' will be shown for various commands: 
2c9e			; | |  
2c9e			; | |    D xxxx - Display a data dump starting from hex address xxxx 
2c9e			; | |  
2c9e			; | |    C - Continue display a data dump from the last set address 
2c9e			; | |  
2c9e			; | |    M xxxx - Set start of memory edit at address xx 
2c9e			; | |  
2c9e			; | |    U xx - Poke the hex byte xx into the address set by M and increment the address to the next location 
2c9e			; | |  
2c9e			; | |    G xxxx - Exec code at specific address 
2c9e			; | |  
2c9e			; | |    Q - Return to previous 
2c9e				if DEBUG_FORTH_WORDS_KEY 
2c9e					DMARK "MON" 
2c9e				if DEMARK_VERSION = 1  
2c9e e5					push hl  
2c9f 21 a7 2c				ld hl, .dmark  
2ca2 22 9b fd				ld (debug_mark), hl  
2ca5				endif  
2ca5				if DEMARK_VERSION = 0  
2ca5					push af  
2ca5					ld a, (.dmark)  
2ca5					ld (debug_mark),a  
2ca5					ld a, (.dmark+1)  
2ca5					ld (debug_mark+1),a  
2ca5					ld a, (.dmark+2)  
2ca5					ld (debug_mark+2),a  
2ca5				endif  
2ca5 18 04			jr .pastdmark  
2ca7 ..			.dmark: db "MON"  
2caa				if DEMARK_VERSION = 1  
