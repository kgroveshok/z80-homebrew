6a9c 3e 00			ld a, kLCD_Line1  
6a9e cd c4 6b		            CALL fLCD_Pos       ;Position cursor to location in A  
6aa1 06 28			ld b, display_cols  
6aa3 ed 5b f9 fa		ld de, (display_write_tmp)  
6aa7 cd f3 6a			call write_len_string  
