6952			; **********************************************************************  
6952			; **  Alphanumeric LCD example                  by Stephen C Cousins  **  
6952			; **********************************************************************  
6952			;  
6952			; **  Written as a Small Computer Monitor App  
6952			; **  www.scc.me.uk  
6952			;  
6952			; History  
6952			; 2018-05-20  v0.2.0  SCC  Example for LiNC80 SBC1 only  
6952			; 2018-06-28  v0.3.0  SCC  Added support for RC2014 and Z280RC  
6952			; 2019-09-14  v0.4.0  SCC  Added support for SC129 digital I/O module  
6952			;  
6952			; **********************************************************************  
6952			;  
6952			; This program is an example of one of the methods of interfacing an   
6952			; alphanumeric LCD module.   
6952			;  
6952			; In this example the display is connected to either a Z80 PIO or a   
6952			; simple 8-bit output port.   
6952			;  
6952			; This interfacing method uses 4-bit data mode and uses time delays  
6952			; rather than polling the display's ready status. As a result the   
6952			; interface only requires 6 simple output lines:  
6952			;   Output bit 0 = not used  
6952			;   Output bit 1 = not used  
6952			;   Output bit 2 = RS         High = data, Low = instruction  
6952			;   Output bit 3 = E          Active high  
6952			;   Output bit 4 = DB4  
6952			;   Output bit 5 = DB5  
6952			;   Output bit 6 = DB6  
6952			;   Output bit 7 = DB7  
6952			; Display's R/W is connected to 0v so it is always in write mode  
6952			;  
6952			; This set up should work with any system supporting the RC2014 bus  
6952			  
6952			; To set up PIO port A in mode 3 (control) using LiNC80 as example  
6952			;   I/O address 0x1A = 0b11001111 (0xCF)   Select mode 3 (control)  
6952			;   I/O address 0x1A = 0b00000000 (0x00)   All pins are output  
6952			;  
6952			; **********************************************************************  
6952			  
6952			; Additonal for 4x40. E1 and E2 instead of just E   
6952			; TODO swipe vidout signal on port a to activate E2  
6952			  
6952			; **********************************************************************  
6952			; **  Constants  
6952			; **********************************************************************  
6952			; LCD constants required by LCD support module  
6952			kLCDPrt:    EQU kDataReg       ;LCD port is the PIO port A data reg  
6952			kLCDBitRS:  EQU 2              ;Port bit for LCD RS signal  
6952			kLCDBitE:   EQU 3              ;Port bit for LCD E signal             
6952			kLCDBitE2:   EQU 0              ;Port bit for LCD E2 signal            VICLK  
6952			kLCDBitLED:   EQU 1              ;Port bit for LCD E2 signal            VIDDO  
6952			; TODO Decide which E is being set  
6952			kLCDWidth:  EQU display_cols             ;Width in characters  
6952			  
6952			; **********************************************************************  
6952			; **  Code library usage  
6952			; **********************************************************************  
6952			  
6952			; send character to current cursor position  
6952			; wraps and/or scrolls screen automatically  
6952			  
6952			  
6952			  
6952			lcd_init:  
6952			  
6952			; SCMonAPI functions used  
6952			  
6952			; Alphanumeric LCD functions used  
6952			; no need to specify specific functions for this module  
6952			  
6952 3e cf		            LD   A, 11001111b  
6954 d3 c2		            OUT  (kContReg), A  ;Port A = PIO 'control' mode  
6956 3e 00		            LD   A, 00000000b  
6958 d3 c2		            OUT  (kContReg),A   ;Port A = all lines are outputs  
695a			  
695a			; Initialise alphanumeric LCD module  
695a 3e 00				ld a, 0  
695c 32 fb fa				ld (display_lcde1e2), a  
695f cd e0 69		            CALL fLCD_Init      ;Initialise LCD module  
6962 3e 01				ld a, 1  
6964 32 fb fa				ld (display_lcde1e2), a  
6967 cd e0 69		            CALL fLCD_Init      ;Initialise LCD module  
696a			  
696a c9				ret  
