1057			malloc_find_space: 
1057 5e			      ld    E, (HL)                 ; Load next_free ptr into DE 
1058 23			      inc   HL 
1059 56			      ld    D, (HL) 
105a			 
105a 7a			      ld    A, D                    ; Check for null next_free ptr - end of free list 
105b b3			      or    E 
105c ca e8 10		      jp    Z, malloc_no_space 
105f			 
105f dd 73 00		      ld    (IX+0), E               ; Store next_free ptr to stack 
1062 dd 72 01		      ld    (IX+1), D 
1065			 
1065			      ; Does this block have enough space to make the allocation? 
1065 23			      inc   HL                      ; Load free block size into DE 
1066 5e			      ld    E, (HL) 
1067 23			      inc   HL 
1068 56			      ld    D, (HL) 
1069			 
1069 eb			      ex    DE, HL                  ; Check size of block against want 
106a b7			      or    A                       ; Ensure carry flag clear 
106b ed 42		      sbc   HL, BC 
106d e5			      push  HL                      ; Store the result for later (new block size) 
106e			 
106e ca bd 10		      jp   Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
1071 30 1b		      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
1073			 
1073			      ; this_free block is not big enough, setup ptrs to test next free block 
1073 e1			      pop   HL                      ; Discard previous result 
1074			 
1074 dd 6e 02		      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
1077 dd 66 03		      ld    H, (IX+3) 
107a dd 75 04		      ld    (IX+4), L 
107d dd 74 05		      ld    (IX+5), H 
1080			 
1080 dd 6e 00		      ld    L, (IX+0)               ; Move next_free ptr into this_free 
1083 dd 66 01		      ld    H, (IX+1) 
1086 dd 75 02		      ld    (IX+2), L 
1089 dd 74 03		      ld    (IX+3), H 
108c			 
108c					if DEBUG_FORTH_MALLOC 
108c						DMARK "MA>" 
108c						CALLMONITOR 
108c					endif 
108c 18 c9		      jr    malloc_find_space 
108e			 
108e			      ; split a bigger block into two - requested size and remaining size 
108e			malloc_alloc_split: 
108e					if DEBUG_FORTH_MALLOC 
108e						DMARK "MAs" 
108e						CALLMONITOR 
108e					endif 
108e eb			      ex    DE, HL                  ; Calculate address of new free block 
108f 2b			      dec   HL 
1090 2b			      dec   HL 
1091 2b			      dec   HL 
1092 09			      add   HL, BC 
1093			 
1093			      ; Create a new block and point it at next_free 
1093 dd 5e 00		      ld    E, (IX+0)               ; Load next_free ptr into DE 
1096 dd 56 01		      ld    D, (IX+1) 
1099			 
1099 73			      ld    (HL), E                 ; Store next_free ptr into new block 
109a 23			      inc   HL 
109b 72			      ld    (HL), D 
109c			 
109c d1			      pop   DE                      ; Store size of new block into new block 
109d 23			      inc   HL 
109e 73			      ld    (HL), E 
109f 23			      inc   HL 
10a0 72			      ld    (HL), D 
10a1			 
10a1			      ; Update this_free ptr to point to new block 
10a1 2b			      dec   HL 
10a2 2b			      dec   HL 
10a3 2b			      dec   HL 
10a4			 
10a4 dd 5e 02		      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
10a7 dd 56 03		      ld    D, (IX+3) 
10aa			 
10aa dd 75 02		      ld    (IX+2), L               ; Store new block addr as this_free ptr 
10ad dd 74 03		      ld    (IX+3), H 
10b0			 
10b0			      ; Modify this_free block to be allocation 
10b0 eb			      ex    DE, HL 
10b1 af			      xor   A                       ; Null the next block ptr of allocated block 
10b2 77			      ld    (HL), A 
10b3 23			      inc   HL 
10b4 77			      ld    (HL), A 
10b5			 
10b5 23			      inc   HL                      ; Store want size into allocated block 
10b6 71			      ld    (HL), C 
10b7 23			      inc   HL 
10b8 70			      ld    (HL), B 
10b9 23			      inc   HL 
10ba e5			      push  HL                      ; Address of allocation to return 
10bb			 
10bb 18 19		      jr    malloc_update_links 
10bd			 
10bd			malloc_alloc_fit: 
10bd e1			      pop   HL                      ; Dont need new block size, want is exact fit 
10be			 
10be					if DEBUG_FORTH_MALLOC 
10be						DMARK "MAf" 
10be						CALLMONITOR 
10be					endif 
10be			      ; Modify this_free block to be allocation 
10be eb			      ex    DE, HL 
10bf 2b			      dec   HL 
10c0 2b			      dec   HL 
10c1 2b			      dec   HL 
10c2			 
10c2 af			      xor   A                       ; Null the next block ptr of allocated block 
10c3 77			      ld    (HL), A 
10c4 23			      inc   HL 
10c5 77			      ld    (HL), A 
10c6			 
10c6 23			      inc   HL                      ; Store address of allocation to return 
10c7 23			      inc   HL 
10c8 23			      inc   HL 
10c9 e5			      push  HL 
10ca			 
10ca			      ; Copy next_free ptr to this_free, remove allocated block from free list 
10ca dd 6e 00		      ld    L, (IX+0)               ; next_free to HL 
10cd dd 66 01		      ld    H, (IX+1) 
10d0			 
10d0 dd 75 02		      ld    (IX+2), L               ; HL to this_free 
10d3 dd 74 03		      ld    (IX+3), H 
