112c			;      call  malloc            ; Allocates 0x9004 
112c			; 
112c			;      ld    HL, 12 
112c			;      call  malloc            ; Allocates 0x9014 
112c			; 
112c			;      ld    HL, 12 
112c			;      call  malloc            ; Allocates 0x9024 
112c			; 
112c			;      ; Free some allocations 
112c			;      ld    HL, 0x9014 
112c			;      call  free 
112c			; 
112c			;      ld    HL, 0x9004 
112c			;      call  free 
112c			; 
112c			;      ld    HL, 0x9024 
112c			;      call  free 
112c			; 
112c			; 
112c			;      halt 
