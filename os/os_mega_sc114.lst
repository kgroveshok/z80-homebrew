8a8f 6a			    ld l,d 
8a90 06 08		    ld b,8 
8a92			Mult8_Loop: 
8a92 29			    add hl,hl 
8a93 30 01		    jr nc,Mult8_NoAdd 
8a95 19			    add hl,de 
8a96			Mult8_NoAdd: 
8a96 10 fa		    djnz Mult8_Loop 
8a98 c9			    ret 
