10f3			 
10f3			;------------------------------------------------------------------------------ 
10f3			;     free                                                                    : 
10f3			;                                                                             : 
10f3			; Description                                                                 : 
10f3			;     Return the space pointed to by HL to the heap. HL must be an address as : 
10f3			;     returned by malloc, otherwise the behaviour is undefined.               : 
10f3			;                                                                             : 
10f3			;     Where possible, directly adjacent free blocks will be merged together   : 
10f3			;     into larger blocks to help ensure that the heap does not become         : 
10f3			;     excessively fragmented.                                                 : 
10f3			;                                                                             : 
10f3			;     free does not clear or set any other value into the freed space, and    : 
10f3			;     therefore its contents may be visible through subsequent malloc's. The  : 
10f3			;     caller should clear the freed space as required.                        : 
10f3			;                                                                             : 
10f3			;     This implementation of free uses the stack exclusively, and is          : 
10f3			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
10f3			;     advisable to disable interrupts before calling free, and recommended    : 
10f3			;     to avoid the use of free inside ISRs in general.                        : 
10f3			;                                                                             : 
10f3			;     NOTE: heap_init must be called before malloc and free can be used.      : 
10f3			;                                                                             : 
10f3			; Parameters                                                                  : 
10f3			;     HL  Pointer to address of first byte of allocation to be freed          : 
10f3			;                                                                             : 
10f3			; Returns                                                                     : 
10f3			;     Nothing                                                                 : 
10f3			;                                                                             : 
10f3			; Stack frame                                                                 : 
10f3			;       |             |                                                       : 
10f3			;       +-------------+                                                       : 
10f3			;       |     BC      |                                                       : 
10f3			;       +-------------+                                                       : 
10f3			;       |     DE      |                                                       : 
10f3			;       +-------------+                                                       : 
10f3			;       |     IX      |                                                       : 
10f3			;       +-------------+                                                       : 
10f3			;       |  prev_free  |                                                       : 
10f3			;   +2  +-------------+                                                       : 
10f3			;       |  next_free  |                                                       : 
10f3			;   +0  +-------------+                                                       : 
10f3			;       |             |                                                       : 
10f3			;                                                                             : 
10f3			;------------------------------------------------------------------------------ 
10f3			free: 
10f3 c5			      push  BC 
10f4 d5			      push  DE 
10f5 dd e5		      push  IX 
10f7			 
10f7 7c			      ld    A, H                    ; Exit if ptr is null 
10f8 b5			      or    L 
10f9 ca bd 11		      jp    Z, free_early_exit 
10fc			 
10fc			      ; Set up stack frame 
10fc eb			      ex    DE, HL 
10fd 21 fc ff		      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
1100 39			      add   HL, SP 
1101 f9			      ld    SP, HL 
1102 dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
1106 dd 39		      add   IX, SP 
1108			 
1108			      ; The address in HL points to the start of the useable allocated space, 
1108			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
1108			      ; address of the block itself. 
1108 eb			      ex    DE, HL 
1109 11 fc ff		      ld    DE, -4 
110c 19			      add   HL, DE 
110d			 
110d			      ; An allocated block must have a null next block pointer in it 
110d 7e			      ld    A, (HL) 
110e 23			      inc   HL 
110f b6			      or    (HL) 
1110 c2 b8 11		      jp    NZ, free_done 
1113			 
1113 2b			      dec   HL 
1114			 
1114 44			      ld    B, H                    ; Copy HL to BC 
1115 4d			      ld    C, L 
1116			 
1116			      ; Loop through the free list to find the first block with an address 
1116			      ; higher than the block being freed 
1116 21 1c 5c		      ld    HL, free_list 
1119			 
1119			free_find_higher_block: 
1119 5e			      ld    E, (HL)                 ; Load next ptr from free block 
111a 23			      inc   HL 
111b 56			      ld    D, (HL) 
111c 2b			      dec   HL 
111d			 
111d dd 73 00		      ld    (IX+0), E               ; Save ptr to next free block 
1120 dd 72 01		      ld    (IX+1), D 
1123 dd 75 02		      ld    (IX+2), L               ; Save ptr to prev free block 
1126 dd 74 03		      ld    (IX+3), H 
1129			 
1129 78			      ld    A, B                    ; Check if DE is greater than BC 
112a ba			      cp    D                       ; Compare MSB first 
112b 28 02		      jr    Z, $+4                  ; MSB the same, compare LSB 
112d 30 04		      jr    NC, free_find_higher_block_skip 
112f 79			      ld    A, C 
1130 bb			      cp    E                       ; Then compare LSB 
1131 38 08		      jr    C, free_found_higher_block 
1133			 
1133			free_find_higher_block_skip: 
1133 7a			      ld    A, D                    ; Reached the end of the free list? 
1134 b3			      or    E 
1135 ca b8 11		      jp    Z, free_done 
1138			 
