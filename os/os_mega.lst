69a9 11 28 00			ld de, display_cols  
69ac 19				add hl,de  
69ad 22 f9 fa			ld (display_write_tmp),hl  
69b0			  
69b0				  
69b0 3e 50			ld a, kLCD_Line3  
69b2 cd a8 6a		            CALL fLCD_Pos       ;Position cursor to location in A  
69b5 06 28			ld b, display_cols  
69b7 ed 5b f9 fa		ld de, (display_write_tmp)  
69bb cd d7 69			call write_len_string  
69be				  
69be 2a f9 fa			ld hl, (display_write_tmp)  
69c1 11 28 00			ld de, display_cols  
69c4 19				add hl,de  
69c5 22 f9 fa			ld (display_write_tmp),hl  
69c8			  
69c8				  
