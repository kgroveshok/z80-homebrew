25a1			; | MONITOR ( -- ) Display system breakpoint/monitor | DONE 
25a1			; | | At start the current various registers will be displayed with contents. 
25a1			; | | Top right corner will show the most recent debug marker seen. 
25a1			; | | The bottom of the screen will also show the values of the data stack pointer (DSP) 
25a1			; | | and the return stack pointer (RSP). 
25a1			; | | Pressing: 
25a1			; | |  
25a1			; | |    1 - Initial screen 
25a1			; | |  
25a1			; | |    2 - Display a data dump of HL 
25a1			; | |  
25a1			; | |    3 - Display a data dump of DE 
25a1			; | |  
25a1			; | |    4 - Display a data dump of BC 
25a1			; | |  
25a1			; | |    5 - Display a data dump of HL 
25a1			; | |  
25a1			; | |    6 - Display a data dump of DSP 
25a1			; | |  
25a1			; | |    7 - Display a data dump of RSP 
25a1			; | |  
25a1			; | |    8 - Display a data dump of what is at DSP 
25a1			; | |  
25a1			; | |    9 - Display a data dump of what is at RSP 
25a1			; | |  
25a1			; | |    0 - Exit monitor and continue running. This will also enable break points 
25a1			; | |  
25a1			; | |    * - Disable break points 
25a1			; | |  
25a1			; | |    # - Enter traditional monitor mode 
25a1			; | |  
25a1			; | | 
25a1			; | | Monitor Mode 
25a1			; | | ------------ 
25a1			; | | A prompt of '>' will be shown for various commands: 
25a1			; | |  
25a1			; | |    D xxxx - Display a data dump starting from hex address xxxx 
25a1			; | |  
25a1			; | |    C - Continue display a data dump from the last set address 
25a1			; | |  
25a1			; | |    M xxxx - Set start of memory edit at address xx 
25a1			; | |  
25a1			; | |    U xx - Poke the hex byte xx into the address set by M and increment the address to the next location 
25a1			; | |  
25a1			; | |    G xxxx - Exec code at specific address 
25a1			; | |  
25a1			; | |    Q - Return to previous 
25a1				if DEBUG_FORTH_WORDS_KEY 
25a1					DMARK "MON" 
25a1				if DEMARK_VERSION = 1  
25a1 e5					push hl  
25a2 21 aa 25				ld hl, .dmark  
25a5 22 60 ee				ld (debug_mark), hl  
25a8				endif  
25a8				if DEMARK_VERSION = 0  
25a8					push af  
25a8					ld a, (.dmark)  
25a8					ld (debug_mark),a  
25a8					ld a, (.dmark+1)  
25a8					ld (debug_mark+1),a  
25a8					ld a, (.dmark+2)  
25a8					ld (debug_mark+2),a  
25a8				endif  
25a8 18 04			jr .pastdmark  
25aa ..			.dmark: db "MON"  
25ad				if DEMARK_VERSION = 1  
25ad 00					db 0  
25ae				endif  
25ae				if DEMARK_VERSION = 1  
25ae e1			.pastdmark: pop hl  
25af				endif  
25af				if DEMARK_VERSION = 0  
25af			.pastdmark: pop af  
25af				endif  
25af			endm  
# End of macro DMARK
25af					CALLMONITOR 
25af				if BASE_CPM=1  
25af cd 6b ee				call debug_vector  
25b2				endif  
25b2				if BASE_KEV=1  
25b2					rst 8  
25b2				endif  
25b2				endm  
# End of macro CALLMONITOR
25b2				endif 
