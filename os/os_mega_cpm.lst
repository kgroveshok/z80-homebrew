1009			;------------------------------------------------------------------------------ 
1009			;     malloc                                                                  : 
1009			;                                                                             : 
1009			; Description                                                                 : 
1009			;     Allocates the wanted space from the heap and returns the address of the : 
1009			;     first useable byte of the allocation.                                   : 
1009			;                                                                             : 
1009			;     Allocations can happen in one of two ways:                              : 
1009			;                                                                             : 
1009			;     1. A free block may be found which is the exact size wanted. In this    : 
1009			;        case the block is removed from the free list and retuedn to the      : 
1009			;        caller.                                                              : 
1009			;     2. A free block may be found which is larger than the size wanted. In   : 
1009			;        this case, the larger block is split into two. The first portion of  : 
1009			;        this block will become the requested space by the malloc call and    : 
1009			;        is returned to the caller. The second portion becomes a new free     : 
1009			;        block, and the free list is adjusted to maintain continuity via this : 
1009			;        newly created block.                                                 : 
1009			;                                                                             : 
1009			;     malloc does not set any initial value in the allocated space, the       : 
1009			;     caller is required to do this as required.                              : 
1009			;                                                                             : 
1009			;     This implementation of malloc uses the stack exclusively, and is        : 
1009			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
1009			;     advisable to disable interrupts before calling malloc, and recommended  : 
1009			;     to avoid the use of malloc inside ISRs in general.                      : 
1009			;                                                                             : 
1009			;     NOTE: heap_init must be called before malloc and free can be used.      : 
1009			;                                                                             : 
1009			; Parameters                                                                  : 
1009			;     HL  Number of bytes wanted                                              : 
1009			;                                                                             : 
1009			; Returns                                                                     : 
1009			;     HL  Address of the first useable byte of the allocation                 : 
1009			;                                                                             : 
1009			; Flags                                                                       : 
1009			;     Z   Set if the allocation did not succeed, clear otherwise              : 
1009			;                                                                             : 
1009			; Stack frame                                                                 : 
1009			;       |             |                                                       : 
1009			;       +-------------+                                                       : 
1009			;       |     BC      |                                                       : 
1009			;       +-------------+                                                       : 
1009			;       |     DE      |                                                       : 
1009			;       +-------------+                                                       : 
1009			;       |     IX      |                                                       : 
1009			;       +-------------+                                                       : 
1009			;       |  prev_free  |                                                       : 
1009			;   +4  +-------------+                                                       : 
1009			;       |  this_free  |                                                       : 
1009			;   +2  +-------------+                                                       : 
1009			;       |  next_free  |                                                       : 
1009			;   +0  +-------------+                                                       : 
1009			;       |             |                                                       : 
1009			;                                                                             : 
1009			;------------------------------------------------------------------------------ 
1009			 
1009			 
1009			;malloc: 
1009			; 
1009			;	SAVESP ON 1 
1009			; 
1009			;	call malloc_code 
1009			; 
1009			;	CHECKSP ON 1 
1009			;	ret 
1009			 
1009			 
1009			malloc: 
1009 c5			      push  BC 
100a d5			      push  DE 
100b dd e5		      push  IX 
100d			if DEBUG_FORTH_MALLOC_HIGH 
100d			call malloc_guard_entry 
100d			endif 
100d			 
100d					if DEBUG_FORTH_MALLOC 
100d						DMARK "mal" 
100d						CALLMONITOR 
100d					endif 
100d 7c			      ld    A, H                    ; Exit if no space requested 
100e b5			      or    L 
100f ca ce 10		      jp    Z, malloc_early_exit 
1012			 
1012			;inc hl 
1012			;inc hl 
1012			;inc hl 
1012			; 
1012			;inc hl 
1012			;inc hl 
1012			;inc hl 
1012			;inc hl 
1012			;inc hl 
1012			;inc hl 
1012			;inc hl 
1012			;inc hl 
1012			;inc hl 
1012			 
1012			 
1012			 
1012			 
1012					if DEBUG_FORTH_MALLOC 
1012						DMARK "maA" 
1012						CALLMONITOR 
1012					endif 
1012			      ; Set up stack frame 
1012 eb			      ex    DE, HL 
1013 21 fa ff		      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
1016 39			      add   HL, SP 
1017 f9			      ld    SP, HL 
1018 dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
101c dd 39		      add   IX, SP 
101e			 
101e			      ; Setup initial state 
101e 21 04 00		      ld    HL, 4                   ; want must also include space used by block struct 
1021 19			      add   HL, DE 
1022			 
1022 44			      ld    B, H                    ; Move want to BC 
1023 4d			      ld    C, L 
1024			 
1024 21 9b 5b		      ld    HL, free_list           ; Store prev_free ptr to stack 
1027 dd 75 04		      ld    (IX+4), L 
102a dd 74 05		      ld    (IX+5), H 
102d			 
102d 5e			      ld    E, (HL)                 ; Store this_free ptr to stack 
102e 23			      inc   HL 
102f 56			      ld    D, (HL) 
1030 dd 73 02		      ld    (IX+2), E 
1033 dd 72 03		      ld    (IX+3), D 
1036 eb			      ex    DE, HL                  ; this_free ptr into HL 
1037			 
1037					if DEBUG_FORTH_MALLOC 
1037						DMARK "maB" 
1037						CALLMONITOR 
1037					endif 
1037			      ; Loop through free block list to find some space 
1037			malloc_find_space: 
1037 5e			      ld    E, (HL)                 ; Load next_free ptr into DE 
1038 23			      inc   HL 
1039 56			      ld    D, (HL) 
103a			 
103a 7a			      ld    A, D                    ; Check for null next_free ptr - end of free list 
103b b3			      or    E 
103c ca c8 10		      jp    Z, malloc_no_space 
103f			 
103f dd 73 00		      ld    (IX+0), E               ; Store next_free ptr to stack 
1042 dd 72 01		      ld    (IX+1), D 
1045			 
1045			      ; Does this block have enough space to make the allocation? 
1045 23			      inc   HL                      ; Load free block size into DE 
1046 5e			      ld    E, (HL) 
1047 23			      inc   HL 
1048 56			      ld    D, (HL) 
1049			 
1049 eb			      ex    DE, HL                  ; Check size of block against want 
104a b7			      or    A                       ; Ensure carry flag clear 
104b ed 42		      sbc   HL, BC 
104d e5			      push  HL                      ; Store the result for later (new block size) 
104e			 
104e ca 9d 10		      jp   Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
1051 30 1b		      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
1053			 
1053			      ; this_free block is not big enough, setup ptrs to test next free block 
1053 e1			      pop   HL                      ; Discard previous result 
1054			 
1054 dd 6e 02		      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
1057 dd 66 03		      ld    H, (IX+3) 
105a dd 75 04		      ld    (IX+4), L 
105d dd 74 05		      ld    (IX+5), H 
1060			 
1060 dd 6e 00		      ld    L, (IX+0)               ; Move next_free ptr into this_free 
1063 dd 66 01		      ld    H, (IX+1) 
1066 dd 75 02		      ld    (IX+2), L 
1069 dd 74 03		      ld    (IX+3), H 
106c			 
106c					if DEBUG_FORTH_MALLOC 
106c						DMARK "MA>" 
106c						CALLMONITOR 
106c					endif 
106c 18 c9		      jr    malloc_find_space 
106e			 
106e			      ; split a bigger block into two - requested size and remaining size 
106e			malloc_alloc_split: 
106e					if DEBUG_FORTH_MALLOC 
106e						DMARK "MAs" 
106e						CALLMONITOR 
106e					endif 
106e eb			      ex    DE, HL                  ; Calculate address of new free block 
106f 2b			      dec   HL 
1070 2b			      dec   HL 
1071 2b			      dec   HL 
1072 09			      add   HL, BC 
1073			 
1073			      ; Create a new block and point it at next_free 
1073 dd 5e 00		      ld    E, (IX+0)               ; Load next_free ptr into DE 
1076 dd 56 01		      ld    D, (IX+1) 
1079			 
1079 73			      ld    (HL), E                 ; Store next_free ptr into new block 
107a 23			      inc   HL 
107b 72			      ld    (HL), D 
107c			 
107c d1			      pop   DE                      ; Store size of new block into new block 
107d 23			      inc   HL 
107e 73			      ld    (HL), E 
107f 23			      inc   HL 
1080 72			      ld    (HL), D 
1081			 
1081			      ; Update this_free ptr to point to new block 
1081 2b			      dec   HL 
1082 2b			      dec   HL 
1083 2b			      dec   HL 
1084			 
1084 dd 5e 02		      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
1087 dd 56 03		      ld    D, (IX+3) 
108a			 
108a dd 75 02		      ld    (IX+2), L               ; Store new block addr as this_free ptr 
108d dd 74 03		      ld    (IX+3), H 
1090			 
1090			      ; Modify this_free block to be allocation 
1090 eb			      ex    DE, HL 
1091 af			      xor   A                       ; Null the next block ptr of allocated block 
1092 77			      ld    (HL), A 
1093 23			      inc   HL 
1094 77			      ld    (HL), A 
1095			 
1095 23			      inc   HL                      ; Store want size into allocated block 
1096 71			      ld    (HL), C 
1097 23			      inc   HL 
1098 70			      ld    (HL), B 
1099 23			      inc   HL 
109a e5			      push  HL                      ; Address of allocation to return 
109b			 
109b 18 19		      jr    malloc_update_links 
109d			 
109d			malloc_alloc_fit: 
109d e1			      pop   HL                      ; Dont need new block size, want is exact fit 
109e			 
109e					if DEBUG_FORTH_MALLOC 
109e						DMARK "MAf" 
109e						CALLMONITOR 
109e					endif 
109e			      ; Modify this_free block to be allocation 
109e eb			      ex    DE, HL 
109f 2b			      dec   HL 
10a0 2b			      dec   HL 
10a1 2b			      dec   HL 
10a2			 
10a2 af			      xor   A                       ; Null the next block ptr of allocated block 
10a3 77			      ld    (HL), A 
10a4 23			      inc   HL 
10a5 77			      ld    (HL), A 
10a6			 
10a6 23			      inc   HL                      ; Store address of allocation to return 
10a7 23			      inc   HL 
10a8 23			      inc   HL 
10a9 e5			      push  HL 
10aa			 
10aa			      ; Copy next_free ptr to this_free, remove allocated block from free list 
10aa dd 6e 00		      ld    L, (IX+0)               ; next_free to HL 
10ad dd 66 01		      ld    H, (IX+1) 
10b0			 
10b0 dd 75 02		      ld    (IX+2), L               ; HL to this_free 
10b3 dd 74 03		      ld    (IX+3), H 
10b6			 
10b6			 
10b6			malloc_update_links: 
10b6			      ; Update prev_free ptr to point to this_free 
10b6 dd 6e 04		      ld    L, (IX+4)               ; prev_free ptr to HL 
10b9 dd 66 05		      ld    H, (IX+5) 
10bc			 
10bc dd 5e 02		      ld    E, (IX+2)               ; this_free ptr to DE 
10bf dd 56 03		      ld    D, (IX+3) 
10c2			 
10c2 73			      ld    (HL), E                 ; this_free ptr into prev_free 
10c3 23			      inc   HL 
10c4 72			      ld    (HL), D 
10c5			 
10c5					if DEBUG_FORTH_MALLOC 
10c5						DMARK "Mul" 
10c5						CALLMONITOR 
10c5					endif 
10c5			      ; Clear the Z flag to indicate successful allocation 
10c5 7a			      ld    A, D 
10c6 b3			      or    E 
10c7			 
10c7 d1			      pop   DE                      ; Address of allocation 
10c8					if DEBUG_FORTH_MALLOC 
10c8						DMARK "MAu" 
10c8						CALLMONITOR 
10c8					endif 
10c8			 
10c8			malloc_no_space: 
10c8 21 06 00		      ld    HL, 6                   ; Clean up stack frame 
10cb 39			      add   HL, SP 
10cc f9			      ld    SP, HL 
10cd			 
10cd eb			      ex    DE, HL                  ; Alloc addr into HL for return 
10ce					if DEBUG_FORTH_MALLOC 
10ce						DMARK "MAN" 
10ce						CALLMONITOR 
10ce					endif 
10ce			 
10ce			malloc_early_exit: 
10ce					if DEBUG_FORTH_MALLOC 
10ce						DMARK "MAx" 
10ce						CALLMONITOR 
10ce					endif 
10ce dd e1		      pop   IX 
10d0 d1			      pop   DE 
10d1 c1			      pop   BC 
10d2			 
10d2			if DEBUG_FORTH_MALLOC_HIGH 
10d2			call malloc_guard_exit 
10d2			call malloc_guard_zerolen 
10d2			endif 
10d2 c9			      ret 
