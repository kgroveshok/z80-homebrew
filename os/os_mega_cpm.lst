595b 21 d9 47			ld hl, startcmds 
595e 3e 00			ld a, 0 
5960 32 c3 e6			ld (os_last_cmd), a    ; tmp var to skip prompts if doing all 
5963			 
5963 e5			.start1:	push hl 
5964 cd b9 09			call clear_display 
5967 11 35 59			ld de, sprompt1 
596a 3e 00		        ld a, display_row_1 
596c cd cb 09			call str_at_display 
596f 11 45 59			ld de, sprompt2 
5972 3e 28		        ld a, display_row_2 
5974 cd cb 09			call str_at_display 
5977 e1				pop hl 
5978 e5				push hl 
5979 5e				ld e,(hl) 
597a 23				inc hl 
597b 56				ld d,(hl) 
597c 3e 50		        ld a, display_row_3 
597e cd cb 09			call str_at_display 
5981 cd f1 09			call update_display 
