6788			include "forth_startup.asm" 
6788			; Which startup method to use? 
6788			; 
6788			; version 1 - allows for a single stored file to be selected to run at start up (if se storage is enabled) 
6788			; followed by loading of a list of scripts in eeprom 
6788			 
6788			; version 2 - if se storage is enabled then auto load all files which begin with a '*' else use loading 
6788			; from eeprom 
6788			 
6788			; Select with define in main stubs 
6788			 
6788			if STARTUP_V1 
6788				include "forth_startupv1.asm" 
6788			endif 
6788			if STARTUP_V2 
6788				include "forth_startupv2.asm" 
6788			; Version 2 of the startup  
6788			;  
6788			; Auto load any files in bank 1 that start with a '*' 
6788			; If no se storage then revert to using eprom 
6788			 
6788			 
6788			if STORAGE_SE = 0 
6788			 
6788			sprompt1: db "Startup load...",0 
6788			sprompt2: db "Run? 1=No *=End #=All",0 
6788			 
6788			 
6788			 
6788			 
6788			forth_startup: 
6788				ld hl, startcmds 
6788				ld a, 0 
6788				ld (os_last_cmd), a    ; tmp var to skip prompts if doing all 
6788			 
6788			.start1:	push hl 
6788				call clear_display 
6788				ld de, sprompt1 
6788			        ld a, display_row_1 
6788				call str_at_display 
6788				ld de, sprompt2 
6788			        ld a, display_row_2 
6788				call str_at_display 
6788				pop hl 
6788				push hl 
6788				ld e,(hl) 
6788				inc hl 
6788				ld d,(hl) 
6788			        ld a, display_row_3 
6788				call str_at_display 
6788				call update_display 
6788			 
6788			 
6788				ld a, (os_last_cmd) 
6788			;	cp 0 
6788				or a 
6788				jr z, .startprompt 
6788				call delay250ms 
6788				jr .startdo 
6788				 
6788				 
6788			 
