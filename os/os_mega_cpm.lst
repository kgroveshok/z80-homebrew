0e71			;; 	ASCII char code for 0-9,A-F in A to single hex digit 
0e71			;;    subtract $30, if result > 9 then subtract $7 more 
0e71			;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; 
0e71			atohex: 
0e71 d6 30				SUB $30 
0e73 fe 0a				CP 10 
0e75 f8					RET M		; If result negative it was 0-9 so we're done 
0e76 d6 07				SUB $7		; otherwise, subtract $7 more to get to $0A-$0F 
0e78 c9					RET		 
