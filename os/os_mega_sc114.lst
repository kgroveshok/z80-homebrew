8ccd			;; 	ASCII char code for 0-9,A-F in A to single hex digit 
8ccd			;;    subtract $30, if result > 9 then subtract $7 more 
8ccd			;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; 
8ccd			atohex: 
8ccd d6 30				SUB $30 
8ccf fe 0a				CP 10 
8cd1 f8					RET M		; If result negative it was 0-9 so we're done 
8cd2 d6 07				SUB $7		; otherwise, subtract $7 more to get to $0A-$0F 
8cd4 c9					RET		 
