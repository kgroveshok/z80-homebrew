69e0			; **********************************************************************  
69e0			; **  LCD support functions  
69e0			; **********************************************************************  
69e0			  
69e0			; Initialise alphanumeric LCD module  
69e0			; LCD control register codes:  
69e0			;   DL   0 = 4-bit mode        1 = 8-bit mode  
69e0			;   N    0 = 1-line mode       1 = 2-line mode  
69e0			;   F    0 = Font 5 x 8        1 = Font 5 x 11  
69e0			;   D    0 = Display off       1 = Display on  
69e0			;   C    0 = Cursor off        1 = Cursor on  
69e0			;   B    0 = Blinking off      1 = Blinking on  
69e0			;   ID   0 = Decrement mode    1 = Increment mode  
69e0			;   SH   0 = Entire shift off  1 = Entire shift on  
69e0 3e 28		fLCD_Init:  LD   A, 40  
69e2 cd 23 6b		            CALL LCDDelay       ;Delay 40ms after power up  
69e5			; For reliable reset set 8-bit mode - 3 times  
69e5 cd f3 6a		            CALL WrFn8bit       ;Function = 8-bit mode  
69e8 cd f3 6a		            CALL WrFn8bit       ;Function = 8-bit mode  
69eb cd f3 6a		            CALL WrFn8bit       ;Function = 8-bit mode  
69ee			; Set 4-bit mode  
69ee cd ef 6a		            CALL WrFn4bit       ;Function = 4-bit mode  
69f1 cd 21 6b		            CALL LCDDelay1      ;Delay 37 us or more  
69f4			; Function set  
69f4 3e 28		            LD   A, 00101000b  ;Control reg:  0  0  1  DL N  F  x  x  
69f6 cd 19 6a		            CALL fLCD_Inst      ;2 line, display on  
69f9			; Display On/Off control  
69f9 3e 0c		            LD   A, 00001100b  ;Control reg:  0  0  0  0  1  D  C  B   
69fb cd 19 6a		            CALL fLCD_Inst      ;Display on, cursor on, blink off  
69fe			; Display Clear  
69fe 3e 01		            LD   A, 00000001b  ;Control reg:  0  0  0  0  0  0  0  1  
6a00 cd 19 6a		            CALL fLCD_Inst      ;Clear display  
6a03			; Entry mode  
6a03 3e 06		            LD   A, 00000110b  ;Control reg:  0  0  0  0  0  1  ID SH  
6a05 cd 19 6a		            CALL fLCD_Inst      ;Increment mode, shift off  
6a08			; Display module now initialised  
6a08 c9			            RET  
6a09			; ok to here  
6a09			  
6a09			; decide on setting bit for LED on or off  
6a09			; Set correct bit in A  
6a09 e5			IsLED: push hl  
6a0a 21 ad fd			ld hl, hardware_word+1  
6a0d cb 56			bit 2, (hl)    ; led bit  
6a0f 20 04			jr nz, .isled1  
6a11 cb 8f			res kLCDBitLED, a  
6a13 18 02			jr .isleddone  
6a15 cb cf		.isled1: set kLCDBitLED, a  
6a17			.isleddone:  	  
6a17 e1				pop hl  
6a18			  
6a18 c9				ret  
6a19			  
6a19			  
6a19			; Write instruction to LCD  
6a19			;   On entry: A = Instruction byte to be written  
6a19			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6a19 f5			fLCD_Inst:  PUSH AF  
6a1a f5			            PUSH AF  
6a1b cd 2d 6a		            CALL Wr4bits       ;Write bits 4 to 7 of instruction  
6a1e f1			            POP  AF  
6a1f 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6a20 17			            RLA  
6a21 17			            RLA  
6a22 17			            RLA  
6a23 cd 2d 6a		            CALL Wr4bits       ;Write bits 0 to 3 of instruction  
6a26 3e 02		            LD   A, 2  
6a28 cd 23 6b		            CALL LCDDelay       ;Delay 2 ms to complete   
6a2b f1			            POP  AF  
6a2c c9			            RET  
6a2d			Wr4bits:   
6a2d f5					push af  
6a2e 3a fb fa				ld a, (display_lcde1e2)  
6a31 fe 00				cp 0     ; e  
6a33 20 13				jr nz, .wea2	  
6a35 f1					pop af  
6a36 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6a38 cd 09 6a				call IsLED  
6a3b d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a3d cb df		            SET  kLCDBitE, A	    ; TODO decide which E is being set  
6a3f cb 87		            res  kLCDBitE2, A	    ; TODO decide which E is being set  
6a41 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6a43 cb 9f		            RES  kLCDBitE, A        ; TODO decide which E is being set  
6a45 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a47 c9			            RET  
6a48 f1			.wea2:		pop af  
6a49 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6a4b cd 09 6a				call IsLED  
6a4e d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a50 cb c7		            SET  kLCDBitE2, A	    ; TODO decide which E is being set  
6a52 cb 9f		            res  kLCDBitE, A	    ; TODO decide which E is being set  
6a54 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6a56 cb 87		            RES  kLCDBitE2, A        ; TODO decide which E is being set  
6a58 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a5a c9			            RET  
6a5b			  
6a5b			  
6a5b			; Write data to LCD  
6a5b			;   On entry: A = Data byte to be written  
6a5b			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6a5b f5			fLCD_Data:  PUSH AF  
6a5c f5			            PUSH AF  
6a5d cd 6f 6a		            CALL Wr4bitsa       ;Write bits 4 to 7 of data byte  
6a60 f1			            POP  AF  
6a61 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6a62 17			            RLA  
6a63 17			            RLA  
6a64 17			            RLA  
6a65 cd 6f 6a		            CALL Wr4bitsa       ;Write bits 0 to 3 of data byte  
6a68 3e 96		            LD   A, 150  
6a6a 3d			Wait:      DEC  A              ;Wait a while to allow data   
6a6b 20 fd		            JR   NZ, Wait      ;  write to complete  
6a6d f1			            POP  AF  
6a6e c9			            RET  
6a6f			Wr4bitsa:     
6a6f f5					push af  
6a70 3a fb fa				ld a, (display_lcde1e2)  
6a73 fe 00				cp 0     ; e1  
6a75 20 19				jr nz, .we2	  
6a77 f1					pop af  
6a78 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6a7a cd 09 6a				call IsLED  
6a7d cb d7		            SET  kLCDBitRS, A  
6a7f d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6a81 cb df		            SET  kLCDBitE, A      ; TODO Decide which E is being set  
6a83 cb 87		            res  kLCDBitE2, A      ; TODO Decide which E is being set  
6a85 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6a87 cb 9f		            RES  kLCDBitE, A       ; TODO Decide which E is being set  
6a89 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6a8b cb 97		            RES  kLCDBitRS, A  
6a8d d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a8f c9			            RET  
6a90 f1			.we2:		pop af  
6a91 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6a93 cd 09 6a				call IsLED  
6a96 cb d7		            SET  kLCDBitRS, A  
6a98 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6a9a cb c7		            SET  kLCDBitE2, A      ; TODO Decide which E is being set  
6a9c cb 9f		            res  kLCDBitE, A      ; TODO Decide which E is being set  
6a9e d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6aa0 cb 87		            RES  kLCDBitE2, A       ; TODO Decide which E is being set  
6aa2 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6aa4 cb 97		            RES  kLCDBitRS, A  
6aa6 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6aa8 c9			            RET  
6aa9			  
