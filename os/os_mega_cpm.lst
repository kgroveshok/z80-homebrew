0fd9			StrictStrCmp: 
0fd9				; Load next chars of each string 
0fd9 1a				ld a, (de) 
0fda 47				ld b, a 
0fdb 7e				ld a, (hl) 
0fdc				; Compare 
0fdc b8				cp b 
0fdd				; Return non-zero if chars don't match 
0fdd c0				ret nz 
0fde				; Check for end of both strings 
0fde fe 00			cp "\0" 
0fe0				; Return if strings have ended 
0fe0 c8				ret z 
0fe1				; Otherwise, advance to next chars 
0fe1 23				inc hl 
0fe2 13				inc de 
0fe3 18 f4			jr StrictStrCmp 
