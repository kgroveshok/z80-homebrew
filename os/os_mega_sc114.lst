8df1			; https://tutorials.eeems.ca/ASMin28Days/lesson/day16.html#cmp 
8df1			 
8df1			; String Length 
8df1			;With a length-prefixed string, finding the length is trivial. For a null-terminated string, the process is decidedly more involved. This is where CPIR comes in. 
8df1			 
8df1			; Get the length of the null-terminated string starting at $8000 hl 
8df1			;    LD     HL, $8000 
8df1			 
8df1			strlenz: 
8df1			 
8df1 af			    XOR    A               ; Zero is the value we are looking for. 
8df2 47			    LD     B, A             ; Since we haven't the slightest clue as to the  
8df3 4f			    LD     C, A             ; actual size of the string, put 0 in BC to search 
8df4			                           ; 65, 536 bytes (the entire addressable memory space). 
8df4 ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
8df6			 
8df6			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
8df6 67			    LD     H, A             ; Zero HL (basically set it to 65, 536) to get the 
8df7 6f			    LD     L, A             ; number of bytes 
8df8 ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
8dfa 2b			    DEC    HL              ; Compensate for null. 
8dfb c9				ret 
8dfc			 
8dfc			; Get the length of the A terminated string starting at $8000 hl 
8dfc			;    LD     HL, $8000 
8dfc			 
8dfc			strlent: 
8dfc			 
8dfc			                  ; A is the value we are looking for. 
8dfc 06 00		    LD     B, 0             ; Since we haven't the slightest clue as to the  
8dfe 0e 00		    LD     C, 0             ; actual size of the string, put 0 in BC to search 
8e00			                           ; 65, 536 bytes (the entire addressable memory space). 
8e00 ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
8e02			 
8e02			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
8e02 26 00		    LD     H, 0             ; Zero HL (basically set it to 65, 536) to get the 
8e04 2e 00		    LD     L, 0             ; number of bytes 
8e06 ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
8e08 2b			    DEC    HL              ; Compensate for null. 
8e09 c9				ret 
8e0a			 
8e0a			 
8e0a			;Comparing Strings 
8e0a			 
8e0a			;IN    HL     Address of string1. 
8e0a			;      DE     Address of string2. 
8e0a			 
8e0a			; doc given but wrong??? 
8e0a			;OUT   zero   Set if string1 = string2, reset if string1 != string2. 
8e0a			;      carry  Set if string1 > string2, reset if string1 <= string2. 
8e0a			; tested 
8e0a			;OUT   carry set  if string1 = string2, carry  reset if string1 != string2. 
8e0a			 
8e0a			strcmp_old: 
8e0a e5			    PUSH   HL 
8e0b d5			    PUSH   DE 
8e0c			 
8e0c 1a			    LD     A, (DE)          ; Compare lengths to determine smaller string 
8e0d be			    CP     (HL)            ; (want to minimize work). 
8e0e 38 01		    JR     C, Str1IsBigger 
8e10 7e			    LD     A, (HL) 
8e11			 
8e11			Str1IsBigger: 
8e11 4f			    LD     C, A             ; Put length in BC 
8e12 06 00		    LD     B, 0 
8e14 13			    INC    DE              ; Increment pointers to meat of string. 
8e15 23			    INC    HL 
8e16			 
8e16			CmpLoop: 
8e16 1a			    LD     A, (DE)          ; Compare bytes. 
8e17 ed a1		    CPI 
8e19 20 09		    JR     NZ, NoMatch      ; If (HL) != (DE), abort. 
8e1b 13			    INC    DE              ; Update pointer. 
8e1c ea 16 8e		    JP     PE, CmpLoop 
8e1f			 
8e1f d1			    POP    DE 
8e20 e1			    POP    HL 
8e21 1a			    LD     A, (DE)          ; Check string lengths to see if really equal. 
8e22 be			    CP     (HL) 
8e23 c9			    RET 
8e24			 
8e24			NoMatch: 
8e24 2b			    DEC    HL 
8e25 be			    CP     (HL)            ; Compare again to affect carry. 
8e26 d1			    POP    DE 
8e27 e1			    POP    HL 
8e28 c9			    RET 
