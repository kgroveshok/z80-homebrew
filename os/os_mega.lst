4d48			; | READ ( -- n  )  Reads next page of current file id and push to stack | DONE 
4d48			; | | e.g. 
4d48			; | | $01 OPEN $01 DO READ . LOOP 
4d48			; | | 
4d48			; | | As this word only reads one 64 byte block in at a time, if the APPEND word has created extra blocks for the excess, this READ 
4d48			; | | word is unaware so the long string needs to be joined if the string is a full. A single block read might be what you want, 
4d48			; | | but if not then writing a word to join blocks will be required. The upshot is a full string will be 62 bytes as the first 
4d48			; | | two bytes contain the file id and extent. 
4d48			; | |  
4d48			; | | Note: There is a flag that enables/disables long block reads called 'store_longread' and a poke of a non-zero value will 
4d48			; | | enable the code to automatically read futher blocks if full. It is BUGGY so don't use for now. 
4d48			; | | > [!NOTE] 
4d48			; | | > Compatible with PicoSPINet  
4d48			 
4d48					if DEBUG_FORTH_WORDS_KEY 
4d48						DMARK "REA" 
4d48				if DEMARK_VERSION = 1  
4d48 e5					push hl  
4d49 21 51 4d				ld hl, .dmark  
4d4c 22 9b fd				ld (debug_mark), hl  
4d4f				endif  
