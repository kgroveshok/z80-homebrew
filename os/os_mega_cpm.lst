1176			      ; Check if the freed block is adjacent to the prev free block 
1176 dd 6e 02		      ld    L, (IX+2)               ; Prev free block ptr into HL 
1179 dd 66 03		      ld    H, (IX+3) 
117c			 
117c 23			      inc   HL                      ; Size of prev free block into DE 
117d 23			      inc   HL 
117e 5e			      ld    E, (HL) 
117f 23			      inc   HL 
1180 56			      ld    D, (HL) 
1181 2b			      dec   HL 
1182 2b			      dec   HL 
1183 2b			      dec   HL 
1184			 
1184 19			      add   HL, DE                  ; Add prev block addr and size 
1185			 
1185 b7			      or    A                       ; Clear the carry flag 
1186 ed 42		      sbc   HL, BC                  ; Subtract addrs to compare adjacency 
1188 20 2e		      jr    NZ, free_done 
118a			 
