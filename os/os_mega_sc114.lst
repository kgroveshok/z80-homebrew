8d0b			; 
8d0b			; Get a word (16 bit) in hexadecimal notation. The result is returned in HL. 
8d0b			; Since the routines get_byte and therefore get_nibble are called, only valid 
8d0b			; characters (0-9a-f) are accepted. 
8d0b			; 
8d0b			;get_word        push    af 
8d0b			;                call    get_byte        ; Get the upper byte 
8d0b			;                ld      h, a 
8d0b			;                call    get_byte        ; Get the lower byte 
8d0b			;                ld      l, a 
8d0b			;                pop     af 
8d0b			;                ret 
8d0b			; 
8d0b			; Get a byte in hexadecimal notation. The result is returned in A. Since 
8d0b			; the routine get_nibble is used only valid characters are accepted - the  
8d0b			; input routine only accepts characters 0-9a-f. 
8d0b			; 
8d0b c5			get_byte:        push    bc              ; Save contents of B (and C) 
8d0c 7e					ld a,(hl) 
8d0d 23					inc hl 
8d0e cd 33 8d		                call    nibble2val      ; Get upper nibble 
8d11 cb 07		                rlc     a 
8d13 cb 07		                rlc     a 
8d15 cb 07		                rlc     a 
8d17 cb 07		                rlc     a 
8d19 47			                ld      b, a            ; Save upper four bits 
8d1a 7e					ld a,(hl) 
8d1b cd 33 8d		                call    nibble2val      ; Get lower nibble 
8d1e b0			                or      b               ; Combine both nibbles 
8d1f c1			                pop     bc              ; Restore B (and C) 
8d20 c9			                ret 
