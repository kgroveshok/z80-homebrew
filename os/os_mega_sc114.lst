d546 e5			.start1:	push hl 
d547 cd 15 88			call clear_display 
d54a 11 18 d5			ld de, sprompt1 
d54d 3e 00		        ld a, display_row_1 
d54f cd 27 88			call str_at_display 
d552 11 28 d5			ld de, sprompt2 
d555 3e 28		        ld a, display_row_2 
