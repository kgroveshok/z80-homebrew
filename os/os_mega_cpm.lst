1211				ld de, .tapeworddef 
1211				call .genfile 
1211				ret 
1211			 
1211			; hl - points to file name 
1211			; de - points to strings to add to file 
1211			 
1211			.genfile: 
1211				push hl 
1211				push de 
1211			 
1211				call clear_display 
1211				ld a, display_row_1 
1211				ld de, .genfiletxt 
1211				call str_at_display 
1211				call update_display 
1211			 
1211				pop de 
1211				pop hl 
1211			 
1211			 
1211				push de 
1211				call storage_create 
1211				; id in hl 
1211				pop de   ; table of strings to add 
1211			 
1211			.genloop: 
1211			 
1211				push hl ; save id for next time around 
1211				push de ; save de for next time around 
1211			 
1211				ex de, hl 
1211				call loadwordinhl 
1211				ex de, hl 
1211			 
1211				; need hl to be the id 
1211				; need de to be the string ptr 
1211				 
1211				call storage_append 
1211			 
1211				pop de 
1211				pop hl 
1211			 
1211				inc de 
1211				inc de 
1211			 
1211				ld a,(de) 
1211				cp 0 
1211				jr nz, .genloop 
1211				inc de 
1211				ld a, (de) 
1211				dec de 
1211				cp 0 
1211				jr nz, .genloop	 
1211			 
1211				ret 
1211			 
1211			.genfiletxt:  db "Creating file...",0 
