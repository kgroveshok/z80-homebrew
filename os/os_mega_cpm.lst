450e			.SESEL: 
450e				CWHEAD .SESELS 82 "BANK?" 5 WORD_FLAG_CODE 
450e			; | BANK? ( -- u ) Reports on the serial EEPROM Bank Device at bank address u1 1-5.  | DONE 
450e			; | | Zero is disabled storage. 
450e					if DEBUG_FORTH_WORDS_KEY 
450e						DMARK "BN?" 
450e						CALLMONITOR 
450e					endif 
450e					ld a, (spi_device_id) 
450e					sub '0' 
450e					ld h, 0 
450e					ld l, a 
450e					FORTH_PUSH_VALUEHL 
450e					;call forth_push_numhl 
450e					NEXTW 
450e			.SESELS: 
450e				CWHEAD .CARTDEV 82 "BANK" 4 WORD_FLAG_CODE 
450e			; | BANK ( u1 -- ) Select Serial EEPROM Bank Device at bank address u1 1-5 (disables CARTDEV).  | DONE 
450e			; | | Set to zero to disable storage. 
450e					if DEBUG_FORTH_WORDS_KEY 
450e						DMARK "BNK" 
450e						CALLMONITOR 
450e					endif 
450e			 
450e					ld a, 255 
450e					ld (spi_cartdev), a 
450e			 
450e					; get bank 
450e			 
450e					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
450e			 
450e			;		push hl 
450e			 
450e					; destroy value TOS 
450e			 
450e					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
450e			 
450e					; one value on hl get other one back 
450e			 
450e			;		pop hl 
450e			 
450e			 
450e					ld c, SPI_CE_HIGH 
450e					ld b, '0'    ; human readable bank number 
450e			 
450e					ld a, l 
450e			 
450e					if DEBUG_FORTH_WORDS 
450e						DMARK "BNK" 
450e						CALLMONITOR 
450e					endif 
450e			 
450e					; active low 
450e			 
450e			;		cp 0 
450e					or a 
450e					jr z, .bset 
450e					cp 1 
450e					jr nz, .b2 
450e					res 0, c 
450e					ld b, '1'    ; human readable bank number 
450e			.b2:		cp 2 
450e					jr nz, .b3 
450e					res 1, c 
450e					ld b, '2'    ; human readable bank number 
450e			.b3:		cp 3 
450e					jr nz, .b4 
450e					res 2, c 
450e					ld b, '3'    ; human readable bank number 
450e			.b4:		cp 4 
450e					jr nz, .b5 
450e					res 3, c 
450e					ld b, '4'    ; human readable bank number 
450e			.b5:		cp 5 
450e					jr nz, .bset 
450e					res 4, c 
450e					ld b, '5'    ; human readable bank number 
450e			 
450e			.bset: 
450e					ld a, c 
450e					ld (spi_device),a 
450e					ld a, b 
450e					ld (spi_device_id),a 
450e					if DEBUG_FORTH_WORDS 
450e						DMARK "BN2" 
450e						CALLMONITOR 
450e					endif 
450e			 
450e					; set default SPI clk pulse time as disabled for BANK use 
450e			 
450e					ld a, 0 
450e					ld (spi_clktime), a 
450e			 
450e					NEXTW 
450e			 
450e			.CARTDEV: 
450e				CWHEAD .ENDDEVICE 82 "CARTDEV" 7 WORD_FLAG_CODE 
450e			; | CARTDEV ( u1 -- ) Select cart device 1-8 (Disables BANK). | DONE 
450e			; | | Set to zero to disable devices. 
450e					if DEBUG_FORTH_WORDS_KEY 
450e						DMARK "CDV" 
450e						CALLMONITOR 
450e					endif 
450e			 
450e					; disable se storage bank selection 
450e			 
450e					ld a, SPI_CE_HIGH		; ce high 
450e					ld (spi_device), a 
450e			 
450e					; get bank 
450e			 
450e					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
450e			 
450e			;		push hl 
450e			 
450e					; destroy value TOS 
450e			 
450e					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
450e			 
450e					; one value on hl get other one back 
450e			 
450e			;		pop hl 
450e			 
450e					; active low 
450e			 
450e					ld c, 255 
450e			 
450e					ld a, l 
450e					if DEBUG_FORTH_WORDS 
450e						DMARK "CDV" 
450e						CALLMONITOR 
450e					endif 
450e			;		cp 0 
450e					or a 
450e					jr z, .cset 
450e					cp 1 
450e					jr nz, .c2 
450e					res 0, c 
450e			.c2:		cp 2 
450e					jr nz, .c3 
450e					res 1, c 
450e			.c3:		cp 3 
450e					jr nz, .c4 
450e					res 2, c 
450e			.c4:		cp 4 
450e					jr nz, .c5 
450e					res 3, c 
450e			.c5:		cp 5 
450e					jr nz, .c6 
450e					res 4, c 
450e			.c6:		cp 6 
450e					jr nz, .c7 
450e					res 5, c 
450e			.c7:		cp 7 
450e					jr nz, .c8 
450e					res 6, c 
450e			.c8:		cp 8 
450e					jr nz, .cset 
450e					res 7, c 
450e			.cset:		ld a, c 
450e					ld (spi_cartdev),a 
450e			 
450e					if DEBUG_FORTH_WORDS 
450e						DMARK "CD2" 
450e						CALLMONITOR 
450e					endif 
450e			 
450e					; set default SPI clk pulse time as 10ms for CARTDEV use 
450e			 
450e					ld a, $0a 
450e					ld (spi_clktime), a 
450e					NEXTW 
450e			endif 
