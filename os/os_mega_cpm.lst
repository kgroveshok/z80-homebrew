0c18 ed 52			sbc hl,de 
0c1a e0				ret po 
0c1b 7c				ld a,h 
0c1c 1f				rra 
0c1d ee 40			xor 01000000B 
0c1f 37				scf 
0c20 8f				adc a,a 
0c21 c9				ret 
