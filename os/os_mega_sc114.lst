d56d			;			CALLMONITOR 
d56d			;		endif 
d56d			;;	call clear_display 
d56d			;	ret 
d56d			 
d56d			 
d56d			 
d56d			endif 
# End of file forth_startupv1.asm
d56d			endif 
d56d			if STARTUP_V2 
d56d				include "forth_startupv2.asm" 
