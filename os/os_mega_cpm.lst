1c17			user_word_eol:  
1c17				; hl contains the pointer to where to create a linked list item from the end 
1c17				; of the user dict to continue on at the system word dict 
1c17				 
1c17				; poke the stub of the word list linked list to repoint to rom words 
1c17			 
1c17				; stub format 
1c17				; db   word id 
1c17				; dw    link to next word 
1c17			        ; db char length of token 
1c17				; db string + 0 term 
1c17				; db exec code....  
1c17			 
1c17			;	ld a, WORD_SYS_ROOT     ; root word 
1c17 36 00			ld (hl), WORD_SYS_ROOT		; word id 
1c19 23				inc hl 
1c1a			 
1c1a 11 c3 1d			ld de, sysdict 
1c1d 73				ld (hl), e		; next word link ie system dict 
1c1e 23				inc hl 
1c1f 72				ld (hl), d		; next word link ie system dict 
1c20 23				inc hl	 
1c21			 
1c21			;	ld (hl), sysdict		; next word link ie system dict 
1c21			;	inc hl 
1c21			;	inc hl 
1c21			 
1c21			;	inc hl 
1c21			;	inc hl 
1c21			 
1c21			;	ld a, 2			; word length is 0 
1c21 36 02			ld (hl), 2 
1c23 23				inc hl 
1c24			 
1c24			;	ld a, '~'			; word length is 0 
1c24 36 7e			ld (hl), '~' 
1c26 23				inc hl 
1c27			;	ld a, 0			; save empty word 
1c27 36 00			ld (hl), 0 
1c29			 
