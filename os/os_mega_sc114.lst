8f49			 
8f49 eb			      ex    DE, HL                  ; Alloc addr into HL for return 
8f4a					if DEBUG_FORTH_MALLOC 
8f4a						DMARK "MAN" 
8f4a						CALLMONITOR 
8f4a					endif 
