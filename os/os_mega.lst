15fa			 
15fa			; Device support for SN76489AN sound chip 
15fa			 
15fa			; https://arduinoplusplus.wordpress.com/2019/10/05/making-noise-with-a-sn76489-digital-sound-generator-part-1/ 
15fa			; http://danceswithferrets.org/geekblog/?p=93 
15fa			; https://www.smspower.org/Development/SN76489 
15fa			 
15fa			; D0 [ 3] 
15fa			; D1 [ 2] 
15fa			; D2 [ 1] 
15fa			; D3 [15] 
15fa			; D4 [13] 
15fa			; D5 [12] 
15fa			; D6 [11] 
15fa			; D7 [10] 
15fa			; /WE [ 5] 
15fa			; CLK [14] 
15fa			; /OE [ 6] 
15fa			; AUDIO [ 7] 
15fa			; GND 8 
15fa			; +5 16 
15fa			; 
15fa			 
15fa			; Write sequence: 
15fa			; CE low 
15fa			; Data bus 
15fa			; WE low then high 
15fa			; 32 clock cycles / 8ns write time at 4mhz 
15fa			; 
15fa			; https://github.com/jblang/SN76489 
15fa			; Shows that the clock needs to be enabled when required. Noticed that with the clock connected it interupted the bus 
15fa			; Tried: 
15fa			; 
15fa			; CE/OE -> Both pins of NAND -> To one pin of second NAND and second pin to full clock -> CLK on chip 
15fa			; 
15fa			; Connected WE to OR too 
15fa			;  
15fa			; That enabled the clock when required 
15fa			; However still random bus corruption. Need further investigation 
15fa			 
15fa			 
15fa			SOUND_LATCH: equ 10000000B 
15fa			SOUND_DATA: equ 0B 
15fa			SOUND_CH0:  equ 0B    ; Tone 
15fa			SOUND_CH1: equ 0100000B        ; Tone 
15fa			SOUND_CH2: equ 1000000B   ; Tone 
15fa			SOUND_CH3: equ 1100000B    ; Noise 
15fa			SOUND_VOL: equ 10000B 
15fa			SOUND_TONE: equ 0B 
15fa			 
15fa			 
15fa c9			sound_init: ret 
