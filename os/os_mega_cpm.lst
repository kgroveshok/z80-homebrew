1005			if MALLOC_2 
1005			; Z80 Malloc and Free Functions 
1005			 
1005			; Malloc Function: 
1005			; Input: 
1005			;   HL: Size of block to allocate 
1005			; Output: 
1005			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
1005			 
1005			malloc: 
1005				 
1005			if DEBUG_FORTH_MALLOC_HIGH 
1005			call malloc_guard_entry 
1005			endif 
1005			 
1005			 
1005			 
1005			 
1005					if DEBUG_FORTH_MALLOC 
1005						DMARK "mal" 
1005						CALLMONITOR 
1005					endif 
1005			    push af            ; Save AF register 
1005			    ld a, l            ; Load low byte of size into A 
1005			    or h               ; Check if size is zero 
1005			    jp z, malloc_exit  ; If size is zero, exit with NULL pointer 
1005			 
1005			    ; Allocate memory 
1005			    ld hl, (heap_start) ; Load start of heap into HL 
1005					if DEBUG_FORTH_MALLOC 
1005						DMARK "ma1" 
1005						CALLMONITOR 
1005					endif 
1005			    call malloc_internal ; Call internal malloc function 
1005			    pop af             ; Restore AF register 
1005			if DEBUG_FORTH_MALLOC_HIGH 
1005			call malloc_guard_exit 
1005			call malloc_guard_zerolen 
1005			endif 
1005			    ret                ; Return 
1005			 
1005			; Free Function: 
1005			; Input: 
1005			;   HL: Pointer to memory block to free 
1005			; Output: 
1005			;   None 
1005			 
1005			free: 
1005			    push af            ; Save AF register 
1005			    ld a, l            ; Load low byte of pointer into A 
1005			    or h               ; Check if pointer is NULL 
1005			    jp z, free_exit    ; If pointer is NULL, exit 
1005			 
1005			    ; Free memory 
1005			    ld hl, (heap_start) ; Load start of heap into HL 
1005			    call free_internal  ; Call internal free function 
1005			    pop af             ; Restore AF register 
1005			    ret                ; Return 
1005			 
1005			; Internal Malloc Function: 
1005			; Input: 
1005			;   HL: Size of block to allocate 
1005			; Output: 
1005			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
1005			 
1005			malloc_internal: 
1005			    ld bc, 2           ; Number of bytes to allocate for management overhead 
1005			    add hl, bc         ; Add management overhead to requested size 
1005			    ex de, hl          ; Save total size in DE, and keep it in HL 
1005					if DEBUG_FORTH_MALLOC 
1005						DMARK "ma2" 
1005						CALLMONITOR 
1005					endif 
1005			 
1005			    ; Search for free memory block 
1005			    ld de, (heap_end)  ; Load end of heap into DE 
1005			    ld bc, 0           ; Initialize counter 
1005			 
1005					if DEBUG_FORTH_MALLOC 
1005						DMARK "ma2" 
1005						CALLMONITOR 
1005					endif 
1005			malloc_search_loop: 
1005			    ; Check if current block is free 
1005			    ld a, (hl)         ; Load current block's status (free or used) 
1005			;    cp 0               ; Compare with zero (free) 
1005				or a 
1005			    jr nz, malloc_skip_block_check  ; If not free, skip to the next block 
1005			 
1005			    ; Check if current block is large enough 
1005			    ld a, (hl+1)       ; Load high byte of block size 
1005			    cp l               ; Compare with low byte of requested size 
1005			    jr nz, malloc_skip_block_check  ; If not large enough, skip to the next block 
1005			 
1005			    ld a, (hl+2)       ; Load low byte of block size 
1005			    cp h               ; Compare with high byte of requested size 
1005			    jr c, malloc_skip_block_check   ; If not large enough, skip to the next block 
1005			 
1005			    ; Mark block as used 
1005			    ld (hl), 0xFF      ; Set status byte to indicate used block 
1005			 
1005			    ; Calculate remaining space in block 
1005			    ld bc, 0           ; Clear BC 
1005			    add hl, bc         ; Increment HL to point to start of data block 
1005			    add hl, de         ; HL = HL + DE (total size) 
1005			    ld bc, 1           ; Number of bytes to allocate for management overhead 
1005			    add hl, bc         ; Add management overhead to start of data block 
1005			 
1005			    ; Save pointer to allocated block in HL 
1005			if DEBUG_FORTH_MALLOC_HIGH 
1005						DMARK "ma5" 
1005			call malloc_guard_exit 
1005			call malloc_guard_zerolen 
1005			endif 
1005			    ret 
1005			 
1005			malloc_skip_block_check: 
1005			    ; Move to the next block 
1005			    ld bc, 3           ; Size of management overhead 
1005			    add hl, bc         ; Move to the next block 
1005			    inc de             ; Increment counter 
1005			 
1005			    ; Check if we have reached the end of heap 
1005			    ld a, e            ; Load low byte of heap end address 
1005			    cp (hl)            ; Compare with low byte of current address 
1005			    jr nz, malloc_search_loop  ; If not equal, continue searching 
1005			    ld a, d            ; Load high byte of heap end address 
1005			;    cp 0               ; Check if it's zero (end of memory) 
1005				or a 
1005			    jr nz, malloc_search_loop  ; If not zero, continue searching 
1005			 
1005			    ; If we reached here, allocation failed 
1005			    xor a              ; Set result to NULL 
1005			if DEBUG_FORTH_MALLOC_HIGH 
1005						DMARK "ma6" 
1005			call malloc_guard_exit 
1005			call malloc_guard_zerolen 
1005			endif 
1005			    ret 
1005			malloc_exit: 
1005			if DEBUG_FORTH_MALLOC_HIGH 
1005						DMARK "ma7" 
1005			call malloc_guard_exit 
1005			call malloc_guard_zerolen 
1005			endif 
1005			    ret 
1005			 
1005			; Internal Free Function: 
1005			; Input: 
1005			;   HL: Pointer to memory block to free 
1005			; Output: 
1005			;   None 
1005			 
1005			free_internal: 
1005			    ld de, (heap_start) ; Load start of heap into DE 
1005			    ld bc, 0            ; Initialize counter 
1005			 
1005			free_search_loop: 
1005			    ; Check if current block contains the pointer 
1005			    ld a, l             ; Load low byte of pointer 
1005			    cp (hl+1)           ; Compare with high byte of current block's address 
1005			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
1005			    ld a, h             ; Load high byte of pointer 
1005			    cp (hl+2)           ; Compare with low byte of current block's address 
1005			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
1005			 
1005			    ; Mark block as free 
1005			    ld (hl), 0          ; Set status byte to indicate free block 
1005			    ret                 ; Return 
1005			 
1005			free_skip_block_check: 
1005			    ; Move to the next block 
1005			    ld bc, 3            ; Size of management overhead 
1005			    add hl, bc          ; Move to the next block 
1005			    inc de              ; Increment counter 
1005			 
1005			    ; Check if we have reached the end of heap 
1005			    ld a, e             ; Load low byte of heap end address 
1005			    cp (hl)             ; Compare with low byte of current address 
1005			    jr nz, free_search_loop  ; If not equal, continue searching 
1005			    ld a, d             ; Load high byte of heap end address 
1005			;    cp 0                ; Check if it's zero (end of memory) 
1005				or a 
1005			    jr nz, free_search_loop  ; If not zero, continue searching 
1005			 
1005			    ; If we reached here, pointer is not found in heap 
1005			    ret 
1005			 
1005			free_exit: 
1005			    ret                 ; Return 
1005			 
1005			; Define heap start and end addresses 
1005			;heap_start:    .dw 0xC000   ; Start of heap 
1005			;heap_end:      .dw 0xE000   ; End of heap 
1005			 
1005			endif 
