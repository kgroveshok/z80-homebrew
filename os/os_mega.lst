212e			; forth parser 
212e			 
212e			; My forth kernel 
212e			include "forth_kernel.asm" 
212e			; 
212e			; kernel to the forth OS 
212e			 
212e			DS_TYPE_STR: equ 1     ; string type 
212e			DS_TYPE_INUM: equ 2     ; $ 16 bit unsigned int usually a hex address 
212e			DS_TYPE_SNUM: equ 3     ; $ 16 bit signed int  
212e			DS_TYPE_CONST: equ 4     ; string type that won't be freed on a POP 
212e			;DS_TYPE_FNUM: equ 3      ; 24/32 bit floating point  do string conversion instead of a new type 
212e			 
212e			FORTH_PARSEV1: equ 0 
212e			FORTH_PARSEV2: equ 0 
212e			FORTH_PARSEV3: equ 0 
212e			FORTH_PARSEV4: equ 0 
212e			FORTH_PARSEV5: equ 0 
212e			FORTH_PARSEV6: equ 1 
212e			 
212e			;if FORTH_PARSEV5 
212e			;	FORTH_END_BUFFER: equ 0 
212e			;else 
212e			FORTH_END_BUFFER: equ 127 
212e			;endif 
212e			 
212e			FORTH_TRUE: equ 1 
212e			FORTH_FALSE: equ 0 
212e			 
212e			if FORTH_PARSEV4 
212e			include "forth_stackops.asm" 
212e			endif 
212e			 
212e			if FORTH_PARSEV5 
212e			include "forth_stackopsv5.asm" 
212e			endif 
212e			 
212e			if FORTH_PARSEV6 
212e			include "forth_stackopsv5.asm" 
212e			 
212e			; Stack operations for v5 parser on wards 
212e			; * DATA stack 
212e			; * LOOP stack 
212e			; * RETURN stack 
212e			 
212e			 
212e			 
212e			FORTH_CHK_DSP_UNDER: macro 
212e				push hl 
212e				push de 
212e				ld hl,(cli_data_sp) 
212e				ld de, cli_data_stack 
212e				call cmp16 
212e				jp c, fault_dsp_under 
212e				pop de 
212e				pop hl 
212e				endm 
212e			 
212e			 
212e			FORTH_CHK_RSP_UNDER: macro 
212e				push hl 
212e				push de 
212e				ld hl,(cli_ret_sp) 
212e				ld de, cli_ret_stack 
212e				call cmp16 
212e				jp c, fault_rsp_under 
212e				pop de 
212e				pop hl 
212e				endm 
212e			 
212e			FORTH_CHK_LOOP_UNDER: macro 
212e				push hl 
212e				push de 
212e				ld hl,(cli_loop_sp) 
212e				ld de, cli_loop_stack 
212e				call cmp16 
212e				jp c, fault_loop_under 
212e				pop de 
212e				pop hl 
212e				endm 
212e			 
212e			FORTH_ERR_TOS_NOTSTR: macro 
212e				; TOSO might need more for checks when used 
212e				push af 
212e				ld a,(hl) 
212e				cp DS_TYPE_STR 
212e				jp nz, type_faultn   
212e				pop af 
212e				endm 
212e			 
212e			FORTH_ERR_TOS_NOTNUM: macro 
212e				push af 
212e				ld a,(hl) 
212e				cp DS_TYPE_INUM 
212e				jp nz, type_faultn   
212e				pop af 
212e				endm 
212e			 
212e			 
212e			; increase data stack pointer and save hl to it 
212e				 
212e			FORTH_DSP_NEXT: macro 
212e				call macro_forth_dsp_next 
212e				endm 
