2458 23				inc hl 
2459			 
2459 11 02 26			ld de, sysdict 
245c 73				ld (hl), e		; next word link ie system dict 
245d 23				inc hl 
245e 72				ld (hl), d		; next word link ie system dict 
245f 23				inc hl	 
2460			 
2460			;	ld (hl), sysdict		; next word link ie system dict 
2460			;	inc hl 
2460			;	inc hl 
2460			 
2460			;	inc hl 
2460			;	inc hl 
2460			 
2460			;	ld a, 2			; word length is 0 
2460 36 02			ld (hl), 2 
2462 23				inc hl 
2463			 
2463			;	ld a, '~'			; word length is 0 
2463 36 7e			ld (hl), '~' 
2465 23				inc hl 
2466			;	ld a, 0			; save empty word 
2466 36 00			ld (hl), 0 
