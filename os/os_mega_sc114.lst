c080				CWHEAD .SPII 61 "SPIO" 4 WORD_FLAG_CODE 
c080			; | SPIO ( u1 -- ) Send byte u1 to SPI  |  DONE 
c080			 
c080					if DEBUG_FORTH_WORDS_KEY 
c080						DMARK "SPo" 
c080						CALLMONITOR 
c080					endif 
c080					; get port 
c080			 
c080			 
c080					; get byte to send 
c080			 
c080					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
c080			 
c080			;		push hl    ; u1  
c080			 
c080					; destroy value TOS 
c080			 
c080					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
c080			 
c080					; one value on hl get other one back 
c080			 
c080			;		pop hl   ; u2 - addr 
c080			 
c080					; TODO Send SPI byte 
c080			 
c080			;		push hl 
c080			;		call spi_ce_low 
c080			;		pop hl 
c080					ld a, l 
c080					call spi_send_byte 
c080			;		call spi_ce_high 
c080			 
c080					NEXTW 
c080			 
c080			.SPII: 
c080				CWHEAD .SESEL 62 "SPII" 5 WORD_FLAG_CODE 
c080			; | SPII ( -- u1 ) Get a byte from SPI  | DONE 
c080					if DEBUG_FORTH_WORDS_KEY 
c080						DMARK "SPi" 
c080						CALLMONITOR 
c080					endif 
c080			 
c080					; TODO Get SPI byte 
c080			 
c080					call spi_read_byte 
c080			 
c080					if DEBUG_FORTH_WORDS 
c080						DMARK "Si2" 
c080						CALLMONITOR 
c080					endif 
c080					ld h, 0 
c080					ld l, a 
c080					if DEBUG_FORTH_WORDS 
c080						DMARK "Si3" 
c080						CALLMONITOR 
c080					endif 
c080					;call forth_push_numhl 
c080					FORTH_PUSH_VALUEHL 
c080			 
c080					NEXTW 
c080			 
c080			 
c080			 
c080			.SESEL: 
c080				CWHEAD .SESELS 82 "BANK?" 5 WORD_FLAG_CODE 
c080			; | BANK? ( -- u ) Reports on the serial EEPROM Bank Device at bank address u1 1-5.  | DONE 
c080			; | | Zero is disabled storage. 
c080					if DEBUG_FORTH_WORDS_KEY 
c080						DMARK "BN?" 
c080						CALLMONITOR 
c080					endif 
c080					ld a, (spi_device_id) 
c080					sub '0' 
c080					ld h, 0 
c080					ld l, a 
c080					FORTH_PUSH_VALUEHL 
c080					;call forth_push_numhl 
c080					NEXTW 
c080			.SESELS: 
c080				CWHEAD .CARTDEV 82 "BANK" 4 WORD_FLAG_CODE 
c080			; | BANK ( u1 -- ) Select Serial EEPROM Bank Device at bank address u1 1-5 (disables CARTDEV).  | DONE 
c080			; | | Set to zero to disable storage. 
c080					if DEBUG_FORTH_WORDS_KEY 
c080						DMARK "BNK" 
c080						CALLMONITOR 
c080					endif 
c080			 
c080					ld a, 255 
c080					ld (spi_cartdev), a 
c080			 
c080					; get bank 
c080			 
c080					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
c080			 
c080			;		push hl 
c080			 
c080					; destroy value TOS 
c080			 
c080					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
c080			 
c080					; one value on hl get other one back 
c080			 
c080			;		pop hl 
c080			 
c080			 
c080					ld c, SPI_CE_HIGH 
c080					ld b, '0'    ; human readable bank number 
c080			 
c080					ld a, l 
c080			 
c080					if DEBUG_FORTH_WORDS 
c080						DMARK "BNK" 
c080						CALLMONITOR 
c080					endif 
c080			 
c080					; active low 
c080			 
c080			;		cp 0 
c080					or a 
c080					jr z, .bset 
c080					cp 1 
c080					jr nz, .b2 
c080					res 0, c 
c080					ld b, '1'    ; human readable bank number 
c080			.b2:		cp 2 
c080					jr nz, .b3 
c080					res 1, c 
c080					ld b, '2'    ; human readable bank number 
c080			.b3:		cp 3 
c080					jr nz, .b4 
c080					res 2, c 
c080					ld b, '3'    ; human readable bank number 
c080			.b4:		cp 4 
c080					jr nz, .b5 
c080					res 3, c 
c080					ld b, '4'    ; human readable bank number 
c080			.b5:		cp 5 
c080					jr nz, .bset 
c080					res 4, c 
c080					ld b, '5'    ; human readable bank number 
c080			 
c080			.bset: 
c080					ld a, c 
c080					ld (spi_device),a 
c080					ld a, b 
c080					ld (spi_device_id),a 
c080					if DEBUG_FORTH_WORDS 
c080						DMARK "BN2" 
c080						CALLMONITOR 
c080					endif 
c080			 
c080					; set default SPI clk pulse time as disabled for BANK use 
c080			 
c080					ld a, 0 
c080					ld (spi_clktime), a 
c080			 
c080					NEXTW 
c080			 
c080			.CARTDEV: 
c080				CWHEAD .ENDDEVICE 82 "CARTDEV" 7 WORD_FLAG_CODE 
c080			; | CARTDEV ( u1 -- ) Select cart device 1-8 (Disables BANK). | DONE 
c080			; | | Set to zero to disable devices. 
c080					if DEBUG_FORTH_WORDS_KEY 
c080						DMARK "CDV" 
c080						CALLMONITOR 
c080					endif 
c080			 
c080					; disable se storage bank selection 
c080			 
c080					ld a, SPI_CE_HIGH		; ce high 
c080					ld (spi_device), a 
c080			 
c080					; get bank 
c080			 
c080					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
c080			 
c080			;		push hl 
c080			 
c080					; destroy value TOS 
c080			 
c080					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
c080			 
c080					; one value on hl get other one back 
c080			 
c080			;		pop hl 
c080			 
c080					; active low 
c080			 
c080					ld c, 255 
c080			 
c080					ld a, l 
c080					if DEBUG_FORTH_WORDS 
c080						DMARK "CDV" 
c080						CALLMONITOR 
c080					endif 
c080			;		cp 0 
c080					or a 
c080					jr z, .cset 
c080					cp 1 
c080					jr nz, .c2 
c080					res 0, c 
c080			.c2:		cp 2 
c080					jr nz, .c3 
c080					res 1, c 
c080			.c3:		cp 3 
c080					jr nz, .c4 
c080					res 2, c 
c080			.c4:		cp 4 
c080					jr nz, .c5 
c080					res 3, c 
c080			.c5:		cp 5 
c080					jr nz, .c6 
c080					res 4, c 
c080			.c6:		cp 6 
c080					jr nz, .c7 
c080					res 5, c 
c080			.c7:		cp 7 
c080					jr nz, .c8 
c080					res 6, c 
c080			.c8:		cp 8 
c080					jr nz, .cset 
c080					res 7, c 
c080			.cset:		ld a, c 
c080					ld (spi_cartdev),a 
c080			 
c080					if DEBUG_FORTH_WORDS 
c080						DMARK "CD2" 
c080						CALLMONITOR 
c080					endif 
c080			 
c080					; set default SPI clk pulse time as 10ms for CARTDEV use 
