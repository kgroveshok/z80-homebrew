4d3b			; | READ ( -- n  )  Reads next page of current file id and push to stack | DONE 
4d3b			; | | e.g. 
4d3b			; | | $01 OPEN $01 DO READ . LOOP 
4d3b			; | | 
4d3b			; | | As this word only reads one 64 byte block in at a time, if the APPEND word has created extra blocks for the excess, this READ 
4d3b			; | | word is unaware so the long string needs to be joined if the string is a full. A single block read might be what you want, 
4d3b			; | | but if not then writing a word to join blocks will be required. The upshot is a full string will be 62 bytes as the first 
4d3b			; | | two bytes contain the file id and extent. 
4d3b			; | |  
4d3b			; | | Note: There is a flag that enables/disables long block reads called 'store_longread' and a poke of a non-zero value will 
4d3b			; | | enable the code to automatically read futher blocks if full. It is BUGGY so don't use for now. 
4d3b			; | | > [!NOTE] 
4d3b			; | | > Compatible with PicoSPINet  
4d3b			 
4d3b					if DEBUG_FORTH_WORDS_KEY 
4d3b						DMARK "REA" 
4d3b				if DEMARK_VERSION = 1  
4d3b e5					push hl  
4d3c 21 44 4d				ld hl, .dmark  
4d3f 22 9b fd				ld (debug_mark), hl  
4d42				endif  
