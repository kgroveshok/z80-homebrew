53ab			; | VAR ( u1 -- )  Get the address of the (word) variable referenced on TOS  | DONE 
53ab			; | 
53ab			; | | The variable name should consist of a single letter (a-z). e.g. "a" 
53ab			; | |  
53ab			; | | e.g. 
53ab			; | |         #30 a var ! 
53ab			; | |         a var @ . 
53ab			; | |   
53ab			; | |     Displays the number 30 
53ab			; | | 
53ab			; | | Each variable pointer is a word so can use for any words that use that:  
53ab			; | |  
53ab			; | | e.g. 
53ab			; | |  
53ab			; | |         #30 a var 2! 
53ab			; | |         a var 2@ . 
53ab			; | |   
53ab			; | |     Displays the number 30 
53ab			; | |  
53ab			; | | > [!NOTE]  
53ab			; ! | > If a full string is passed then only the first char is looked at 
53ab			; | | > Any other char could exceed bounds checks!  
53ab			; | | > 
53ab			; | | > Each variable location follows the previous. Watch you don't clobber any others. 
53ab			 
53ab					if DEBUG_FORTH_WORDS_KEY 
53ab						DMARK "VAR" 
53ab				if DEMARK_VERSION = 1  
53ab e5					push hl  
53ac 21 b4 53				ld hl, .dmark  
53af 22 9b fd				ld (debug_mark), hl  
53b2				endif  
53b2				if DEMARK_VERSION = 0  
53b2					push af  
53b2					ld a, (.dmark)  
53b2					ld (debug_mark),a  
53b2					ld a, (.dmark+1)  
53b2					ld (debug_mark+1),a  
53b2					ld a, (.dmark+2)  
53b2					ld (debug_mark+2),a  
53b2				endif  
53b2 18 04			jr .pastdmark  
53b4 ..			.dmark: db "VAR"  
53b7				if DEMARK_VERSION = 1  
53b7 00					db 0  
53b8				endif  
53b8				if DEMARK_VERSION = 1  
53b8 e1			.pastdmark: pop hl  
53b9				endif  
53b9				if DEMARK_VERSION = 0  
53b9			.pastdmark: pop af  
53b9				endif  
53b9			endm  
# End of macro DMARK
