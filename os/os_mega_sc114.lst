8f32			 
8f32			malloc_update_links: 
8f32			      ; Update prev_free ptr to point to this_free 
8f32 dd 6e 04		      ld    L, (IX+4)               ; prev_free ptr to HL 
8f35 dd 66 05		      ld    H, (IX+5) 
8f38			 
8f38 dd 5e 02		      ld    E, (IX+2)               ; this_free ptr to DE 
8f3b dd 56 03		      ld    D, (IX+3) 
8f3e			 
8f3e 73			      ld    (HL), E                 ; this_free ptr into prev_free 
8f3f 23			      inc   HL 
8f40 72			      ld    (HL), D 
8f41			 
8f41					if DEBUG_FORTH_MALLOC 
8f41						DMARK "Mul" 
8f41						CALLMONITOR 
8f41					endif 
