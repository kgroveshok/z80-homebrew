2132			; 
2132			; kernel to the forth OS 
2132			 
2132			DS_TYPE_STR: equ 1     ; string type 
2132			DS_TYPE_INUM: equ 2     ; $ 16 bit unsigned int usually a hex address 
2132			DS_TYPE_SNUM: equ 3     ; $ 16 bit signed int  
2132			DS_TYPE_CONST: equ 4     ; string type that won't be freed on a POP 
2132			;DS_TYPE_FNUM: equ 3      ; 24/32 bit floating point  do string conversion instead of a new type 
2132			 
2132			FORTH_PARSEV1: equ 0 
2132			FORTH_PARSEV2: equ 0 
2132			FORTH_PARSEV3: equ 0 
2132			FORTH_PARSEV4: equ 0 
2132			FORTH_PARSEV5: equ 0 
2132			FORTH_PARSEV6: equ 1 
2132			 
2132			;if FORTH_PARSEV5 
2132			;	FORTH_END_BUFFER: equ 0 
2132			;else 
2132			FORTH_END_BUFFER: equ 127 
2132			;endif 
2132			 
2132			FORTH_TRUE: equ 1 
2132			FORTH_FALSE: equ 0 
2132			 
2132			if FORTH_PARSEV4 
2132			include "forth_stackops.asm" 
2132			endif 
2132			 
2132			if FORTH_PARSEV5 
2132			include "forth_stackopsv5.asm" 
2132			endif 
2132			 
2132			if FORTH_PARSEV6 
2132			include "forth_stackopsv5.asm" 
2132			 
2132			; Stack operations for v5 parser on wards 
2132			; * DATA stack 
2132			; * LOOP stack 
2132			; * RETURN stack 
2132			 
2132			 
2132			 
2132			FORTH_CHK_DSP_UNDER: macro 
2132				push hl 
2132				push de 
2132				ld hl,(cli_data_sp) 
2132				ld de, cli_data_stack 
2132				call cmp16 
2132				jp c, fault_dsp_under 
2132				pop de 
2132				pop hl 
2132				endm 
2132			 
2132			 
2132			FORTH_CHK_RSP_UNDER: macro 
2132				push hl 
2132				push de 
2132				ld hl,(cli_ret_sp) 
2132				ld de, cli_ret_stack 
2132				call cmp16 
2132				jp c, fault_rsp_under 
2132				pop de 
2132				pop hl 
2132				endm 
2132			 
2132			FORTH_CHK_LOOP_UNDER: macro 
2132				push hl 
2132				push de 
2132				ld hl,(cli_loop_sp) 
2132				ld de, cli_loop_stack 
2132				call cmp16 
2132				jp c, fault_loop_under 
2132				pop de 
2132				pop hl 
2132				endm 
2132			 
2132			FORTH_ERR_TOS_NOTSTR: macro 
2132				; TOSO might need more for checks when used 
2132				push af 
2132				ld a,(hl) 
2132				cp DS_TYPE_STR 
2132				jp nz, type_faultn   
2132				pop af 
2132				endm 
2132			 
2132			FORTH_ERR_TOS_NOTNUM: macro 
2132				push af 
2132				ld a,(hl) 
2132				cp DS_TYPE_INUM 
2132				jp nz, type_faultn   
2132				pop af 
2132				endm 
2132			 
2132			 
2132			; increase data stack pointer and save hl to it 
2132				 
2132			FORTH_DSP_NEXT: macro 
2132				call macro_forth_dsp_next 
2132				endm 
