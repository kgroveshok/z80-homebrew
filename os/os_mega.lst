25c9			.NEW: 
25c9			CWHEAD .HEAP OPCODE_HEAP "NEW" 3 WORD_FLAG_CODE 
25c9 15				db WORD_SYS_CORE+OPCODE_HEAP             
25ca e3 25			dw .HEAP            
25cc 04				db 3 + 1 
25cd .. 00			db "NEW",0              
25d1				endm 
# End of macro CWHEAD
25d1			; | NEW ( -- ) Clears all user words and stack | DONE 
25d1				 
25d1				if MALLOC_4 
25d1					call  heap_init 
25d1				endif 
25d1				; reset uword pointers 
25d1 21 00 80			ld hl, baseram 
25d4 22 d5 f3			ld (os_last_new_uword), hl 
25d7 cd 1d 24			call user_word_eol 
25da				; clear stack 
25da cd 36 24			call forth_warmstart 
25dd				NEXTW 
25dd cd a3 fd			call parse_vector 
25e0 c3 90 24			jp macro_next 
25e3				endm 
# End of macro NEXTW
