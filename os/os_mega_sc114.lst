99e7			FORTH_CHK_DSP_UNDER: macro 
99e7				push hl 
99e7				push de 
99e7				ld hl,(cli_data_sp) 
99e7				ld de, cli_data_stack 
99e7				call cmp16 
99e7				jp c, fault_dsp_under 
99e7				pop de 
99e7				pop hl 
99e7				endm 
99e7			 
99e7			 
99e7			FORTH_CHK_RSP_UNDER: macro 
99e7				push hl 
99e7				push de 
99e7				ld hl,(cli_ret_sp) 
99e7				ld de, cli_ret_stack 
99e7				call cmp16 
99e7				jp c, fault_rsp_under 
99e7				pop de 
99e7				pop hl 
99e7				endm 
99e7			 
99e7			FORTH_CHK_LOOP_UNDER: macro 
99e7				push hl 
99e7				push de 
99e7				ld hl,(cli_loop_sp) 
99e7				ld de, cli_loop_stack 
99e7				call cmp16 
99e7				jp c, fault_loop_under 
99e7				pop de 
99e7				pop hl 
99e7				endm 
