0fff			;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;	 
0fff			tohex: 
0fff e5					PUSH HL 
1000 d5					PUSH DE 
1001 16 00				LD D, 0 
1003 5f					LD E, A 
1004 21 0c 10				LD HL, .DATA 
1007 19					ADD HL, DE 
1008 7e					LD A, (HL) 
1009 d1					POP DE 
100a e1					POP HL 
100b c9					RET 
