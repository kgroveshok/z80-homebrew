6792			 
6792			include "forth_startup.asm" 
6792			; Which startup method to use? 
6792			; 
6792			; version 1 - allows for a single stored file to be selected to run at start up (if se storage is enabled) 
6792			; followed by loading of a list of scripts in eeprom 
6792			 
6792			; version 2 - if se storage is enabled then auto load all files which begin with a '*' else use loading 
6792			; from eeprom 
6792			 
6792			; Select with define in main stubs 
6792			 
6792			if STARTUP_V1 
6792				include "forth_startupv1.asm" 
6792			endif 
6792			if STARTUP_V2 
6792				include "forth_startupv2.asm" 
6792			; Version 2 of the startup  
6792			;  
6792			; Auto load any files in bank 1 that start with a '*' 
6792			; If no se storage then revert to using eprom 
6792			 
6792			 
6792			if STORAGE_SE = 0 
6792			 
6792			sprompt1: db "Startup load...",0 
6792			sprompt2: db "Run? 1=No *=End #=All",0 
6792			 
6792			 
6792			 
6792			 
6792			forth_startup: 
6792				ld hl, startcmds 
6792				ld a, 0 
6792				ld (os_last_cmd), a    ; tmp var to skip prompts if doing all 
6792			 
6792			.start1:	push hl 
6792				call clear_display 
6792				ld de, sprompt1 
6792			        ld a, display_row_1 
6792				call str_at_display 
6792				ld de, sprompt2 
6792			        ld a, display_row_2 
6792				call str_at_display 
6792				pop hl 
6792				push hl 
6792				ld e,(hl) 
6792				inc hl 
6792				ld d,(hl) 
6792			        ld a, display_row_3 
6792				call str_at_display 
6792				call update_display 
6792			 
6792			 
6792				ld a, (os_last_cmd) 
6792			;	cp 0 
6792				or a 
6792				jr z, .startprompt 
6792				call delay250ms 
6792				jr .startdo 
6792				 
6792				 
6792			 
6792			.startprompt: 
6792			 
6792				ld a,display_row_4 + display_cols - 1 
6792			        ld de, endprg 
6792				call str_at_display 
6792				call update_display 
6792				call delay1s 
6792				call cin_wait 
6792						 
6792				cp '*' 
6792				jr z, .startupend1 
6792				cp '#' 
6792				jr nz, .startno 
6792				ld a, 1 
6792				ld (os_last_cmd),a 
6792				jr .startdo 
6792			.startno:	cp '1' 
6792				jr z,.startnxt  
6792			 
6792				; exec startup line 
6792			.startdo:	 
6792				pop hl 
6792				push hl 
6792				 
6792				ld e,(hl) 
6792				inc hl 
6792				ld d,(hl) 
6792				ex de,hl 
6792			 
6792				push hl 
6792			 
6792				ld a, 0 
6792				;ld a, FORTH_END_BUFFER 
6792				call strlent 
6792				inc hl   ; include zero term to copy 
6792				ld b,0 
6792				ld c,l 
6792				pop hl 
6792				ld de, scratch 
6792				ldir 
6792			 
6792			 
6792				ld hl, scratch 
6792				call forthparse 
6792				call forthexec 
6792				call forthexec_cleanup 
6792			 
6792				ld a, display_row_4 
6792				ld de, endprog 
6792			 
6792				call update_display		 
6792			 
6792				ld a, (os_last_cmd) 
6792			;	cp 0 
6792				or a 
6792				jr nz, .startnxt 
6792				call next_page_prompt 
6792			        call clear_display 
6792				call update_display		 
6792			 
6792				; move onto next startup line? 
6792			.startnxt: 
6792			 
6792				call delay250ms 
6792				pop hl 
6792			 
6792				inc hl 
6792				inc hl 
6792			 
6792				push hl 
6792				ld e, (hl) 
6792				inc hl 
6792				ld d, (hl) 
6792				pop hl 
6792				; TODO replace 0 test 
6792			 
6792				ex de, hl 
6792				call ishlzero 
6792			;	ld a,e 
6792			;	add d 
6792			;	cp 0    ; any left to do? 
6792				ex de, hl 
6792				jp nz, .start1 
6792				jr .startupend 
6792			 
6792			.startupend1: pop hl 
6792			.startupend: 
6792			 
6792				call clear_display 
6792				call update_display 
6792				ret 
6792			endif 
