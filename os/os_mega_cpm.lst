0c0b			subafromhl: 
0c0b			   ; If A=0 do nothing 
0c0b			    ; Otherwise flip A's sign. Since 
0c0b			    ; the upper byte becomes -1, also 
0c0b			    ; substract 1 from H. 
0c0b ed 44		    neg 
0c0d ca 16 0c		    jp    z, Skip 
0c10 25			    dec   h 
0c11			     
0c11			    ; Now add the low byte as usual 
0c11			    ; Two's complement takes care of 
0c11			    ; ensuring the result is correct 
0c11 85			    add   a, l 
0c12 6f			    ld    l, a 
0c13 8c			    adc   a, h 
0c14 95			    sub   l 
0c15 67			    ld    h, a 
0c16			Skip: 
0c16 c9				ret 
