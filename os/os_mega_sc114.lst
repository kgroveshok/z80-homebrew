8e41			;------------------------------------------------------------------------------ 
8e41			;     heap_init                                                               : 
8e41			;                                                                             : 
8e41			; Description                                                                 : 
8e41			;     Initialise the heap and make it ready for malloc and free operations.   : 
8e41			;                                                                             : 
8e41			;     The heap is maintained as a linked list, starting with an initial       : 
8e41			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
8e41			;     the first free block in the heap. Each block then points to the next    : 
8e41			;     free block within the heap, and the free list ends at the first block   : 
8e41			;     with a null pointer to the next free block.                             : 
8e41			;                                                                             : 
8e41			; Parameters                                                                  : 
8e41			;     Inputs are compile-time only. Two defines which specify the starting    : 
8e41			;     address of the heap and its size are required, along with a memory      : 
8e41			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
8e41			;     principally stores a pointer to the first free block in the heap.       : 
8e41			;                                                                             : 
8e41			; Returns                                                                     : 
8e41			;     Nothing                                                                 : 
8e41			;------------------------------------------------------------------------------ 
8e41			heap_init: 
8e41 e5			      push  HL 
8e42			 
8e42			      ; Initialise free list struct 
8e42 21 67 d6		      ld    HL, heap_start 
8e45 22 62 d6		      ld    (free_list), HL 
8e48 21 00 00		      ld    HL, 0 
8e4b 22 64 d6		      ld    (free_list+2), HL 
8e4e			 
8e4e			      ; Insert first free block at bottom of heap, consumes entire heap 
8e4e 21 72 e2		      ld    HL, heap_start+heap_size-4 
8e51 22 67 d6		      ld    (heap_start), HL        ; Next block (end of free list) 
8e54 21 0b 0c		      ld    HL, heap_size-4 
8e57 22 69 d6		      ld    (heap_start+2), HL      ; Block size 
8e5a			 
8e5a			      ; Insert end of free list block at top of heap - two null words will 
8e5a			      ; terminate the free list 
8e5a 21 00 00		      ld    HL, 0 
8e5d 22 74 e2		      ld    (heap_start+heap_size-2), HL 
8e60 22 72 e2		      ld    (heap_start+heap_size-4), HL 
8e63			 
8e63 e1			      pop   HL 
8e64			 
8e64 c9			      ret 
8e65			 
8e65			 
8e65			;------------------------------------------------------------------------------ 
8e65			;     malloc                                                                  : 
8e65			;                                                                             : 
8e65			; Description                                                                 : 
8e65			;     Allocates the wanted space from the heap and returns the address of the : 
8e65			;     first useable byte of the allocation.                                   : 
8e65			;                                                                             : 
8e65			;     Allocations can happen in one of two ways:                              : 
8e65			;                                                                             : 
8e65			;     1. A free block may be found which is the exact size wanted. In this    : 
8e65			;        case the block is removed from the free list and retuedn to the      : 
8e65			;        caller.                                                              : 
8e65			;     2. A free block may be found which is larger than the size wanted. In   : 
8e65			;        this case, the larger block is split into two. The first portion of  : 
8e65			;        this block will become the requested space by the malloc call and    : 
8e65			;        is returned to the caller. The second portion becomes a new free     : 
8e65			;        block, and the free list is adjusted to maintain continuity via this : 
8e65			;        newly created block.                                                 : 
8e65			;                                                                             : 
8e65			;     malloc does not set any initial value in the allocated space, the       : 
8e65			;     caller is required to do this as required.                              : 
8e65			;                                                                             : 
8e65			;     This implementation of malloc uses the stack exclusively, and is        : 
8e65			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
8e65			;     advisable to disable interrupts before calling malloc, and recommended  : 
8e65			;     to avoid the use of malloc inside ISRs in general.                      : 
8e65			;                                                                             : 
8e65			;     NOTE: heap_init must be called before malloc and free can be used.      : 
8e65			;                                                                             : 
8e65			; Parameters                                                                  : 
8e65			;     HL  Number of bytes wanted                                              : 
8e65			;                                                                             : 
8e65			; Returns                                                                     : 
8e65			;     HL  Address of the first useable byte of the allocation                 : 
8e65			;                                                                             : 
8e65			; Flags                                                                       : 
8e65			;     Z   Set if the allocation did not succeed, clear otherwise              : 
8e65			;                                                                             : 
8e65			; Stack frame                                                                 : 
8e65			;       |             |                                                       : 
8e65			;       +-------------+                                                       : 
8e65			;       |     BC      |                                                       : 
8e65			;       +-------------+                                                       : 
8e65			;       |     DE      |                                                       : 
8e65			;       +-------------+                                                       : 
8e65			;       |     IX      |                                                       : 
8e65			;       +-------------+                                                       : 
8e65			;       |  prev_free  |                                                       : 
8e65			;   +4  +-------------+                                                       : 
8e65			;       |  this_free  |                                                       : 
8e65			;   +2  +-------------+                                                       : 
8e65			;       |  next_free  |                                                       : 
8e65			;   +0  +-------------+                                                       : 
8e65			;       |             |                                                       : 
8e65			;                                                                             : 
8e65			;------------------------------------------------------------------------------ 
8e65			 
8e65			 
8e65			;malloc: 
8e65			; 
8e65			;	SAVESP ON 1 
8e65			; 
8e65			;	call malloc_code 
8e65			; 
8e65			;	CHECKSP ON 1 
8e65			;	ret 
8e65			 
8e65			 
8e65			malloc: 
8e65 c5			      push  BC 
8e66 d5			      push  DE 
8e67 dd e5		      push  IX 
8e69			if DEBUG_FORTH_MALLOC_HIGH 
8e69			call malloc_guard_entry 
8e69			endif 
8e69			 
8e69					if DEBUG_FORTH_MALLOC 
8e69						DMARK "mal" 
8e69						CALLMONITOR 
8e69					endif 
8e69 7c			      ld    A, H                    ; Exit if no space requested 
8e6a b5			      or    L 
8e6b ca 2a 8f		      jp    Z, malloc_early_exit 
8e6e			 
8e6e			;inc hl 
8e6e			;inc hl 
8e6e			;inc hl 
8e6e			; 
8e6e			;inc hl 
8e6e			;inc hl 
8e6e			;inc hl 
8e6e			;inc hl 
8e6e			;inc hl 
8e6e			;inc hl 
8e6e			;inc hl 
8e6e			;inc hl 
8e6e			;inc hl 
8e6e			 
8e6e			 
8e6e			 
8e6e			 
8e6e					if DEBUG_FORTH_MALLOC 
8e6e						DMARK "maA" 
8e6e						CALLMONITOR 
8e6e					endif 
8e6e			      ; Set up stack frame 
8e6e eb			      ex    DE, HL 
8e6f 21 fa ff		      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
8e72 39			      add   HL, SP 
8e73 f9			      ld    SP, HL 
8e74 dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
8e78 dd 39		      add   IX, SP 
8e7a			 
8e7a			      ; Setup initial state 
8e7a 21 04 00		      ld    HL, 4                   ; want must also include space used by block struct 
8e7d 19			      add   HL, DE 
8e7e			 
8e7e 44			      ld    B, H                    ; Move want to BC 
8e7f 4d			      ld    C, L 
8e80			 
8e80 21 62 d6		      ld    HL, free_list           ; Store prev_free ptr to stack 
8e83 dd 75 04		      ld    (IX+4), L 
8e86 dd 74 05		      ld    (IX+5), H 
8e89			 
8e89 5e			      ld    E, (HL)                 ; Store this_free ptr to stack 
8e8a 23			      inc   HL 
8e8b 56			      ld    D, (HL) 
8e8c dd 73 02		      ld    (IX+2), E 
8e8f dd 72 03		      ld    (IX+3), D 
8e92 eb			      ex    DE, HL                  ; this_free ptr into HL 
8e93			 
8e93					if DEBUG_FORTH_MALLOC 
8e93						DMARK "maB" 
8e93						CALLMONITOR 
8e93					endif 
8e93			      ; Loop through free block list to find some space 
8e93			malloc_find_space: 
8e93 5e			      ld    E, (HL)                 ; Load next_free ptr into DE 
8e94 23			      inc   HL 
8e95 56			      ld    D, (HL) 
8e96			 
8e96 7a			      ld    A, D                    ; Check for null next_free ptr - end of free list 
8e97 b3			      or    E 
8e98 ca 24 8f		      jp    Z, malloc_no_space 
8e9b			 
8e9b dd 73 00		      ld    (IX+0), E               ; Store next_free ptr to stack 
8e9e dd 72 01		      ld    (IX+1), D 
8ea1			 
8ea1			      ; Does this block have enough space to make the allocation? 
8ea1 23			      inc   HL                      ; Load free block size into DE 
8ea2 5e			      ld    E, (HL) 
8ea3 23			      inc   HL 
8ea4 56			      ld    D, (HL) 
8ea5			 
8ea5 eb			      ex    DE, HL                  ; Check size of block against want 
8ea6 b7			      or    A                       ; Ensure carry flag clear 
8ea7 ed 42		      sbc   HL, BC 
8ea9 e5			      push  HL                      ; Store the result for later (new block size) 
8eaa			 
8eaa ca f9 8e		      jp   Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
8ead 30 1b		      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
8eaf			 
8eaf			      ; this_free block is not big enough, setup ptrs to test next free block 
8eaf e1			      pop   HL                      ; Discard previous result 
8eb0			 
8eb0 dd 6e 02		      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
8eb3 dd 66 03		      ld    H, (IX+3) 
8eb6 dd 75 04		      ld    (IX+4), L 
8eb9 dd 74 05		      ld    (IX+5), H 
8ebc			 
8ebc dd 6e 00		      ld    L, (IX+0)               ; Move next_free ptr into this_free 
8ebf dd 66 01		      ld    H, (IX+1) 
8ec2 dd 75 02		      ld    (IX+2), L 
8ec5 dd 74 03		      ld    (IX+3), H 
8ec8			 
8ec8					if DEBUG_FORTH_MALLOC 
8ec8						DMARK "MA>" 
8ec8						CALLMONITOR 
8ec8					endif 
8ec8 18 c9		      jr    malloc_find_space 
8eca			 
8eca			      ; split a bigger block into two - requested size and remaining size 
8eca			malloc_alloc_split: 
8eca					if DEBUG_FORTH_MALLOC 
8eca						DMARK "MAs" 
8eca						CALLMONITOR 
8eca					endif 
8eca eb			      ex    DE, HL                  ; Calculate address of new free block 
8ecb 2b			      dec   HL 
8ecc 2b			      dec   HL 
8ecd 2b			      dec   HL 
8ece 09			      add   HL, BC 
8ecf			 
8ecf			      ; Create a new block and point it at next_free 
8ecf dd 5e 00		      ld    E, (IX+0)               ; Load next_free ptr into DE 
8ed2 dd 56 01		      ld    D, (IX+1) 
8ed5			 
8ed5 73			      ld    (HL), E                 ; Store next_free ptr into new block 
8ed6 23			      inc   HL 
8ed7 72			      ld    (HL), D 
8ed8			 
8ed8 d1			      pop   DE                      ; Store size of new block into new block 
8ed9 23			      inc   HL 
8eda 73			      ld    (HL), E 
8edb 23			      inc   HL 
8edc 72			      ld    (HL), D 
8edd			 
8edd			      ; Update this_free ptr to point to new block 
8edd 2b			      dec   HL 
8ede 2b			      dec   HL 
8edf 2b			      dec   HL 
8ee0			 
8ee0 dd 5e 02		      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
8ee3 dd 56 03		      ld    D, (IX+3) 
8ee6			 
8ee6 dd 75 02		      ld    (IX+2), L               ; Store new block addr as this_free ptr 
8ee9 dd 74 03		      ld    (IX+3), H 
8eec			 
8eec			      ; Modify this_free block to be allocation 
8eec eb			      ex    DE, HL 
8eed af			      xor   A                       ; Null the next block ptr of allocated block 
8eee 77			      ld    (HL), A 
8eef 23			      inc   HL 
8ef0 77			      ld    (HL), A 
8ef1			 
8ef1 23			      inc   HL                      ; Store want size into allocated block 
8ef2 71			      ld    (HL), C 
8ef3 23			      inc   HL 
8ef4 70			      ld    (HL), B 
8ef5 23			      inc   HL 
8ef6 e5			      push  HL                      ; Address of allocation to return 
8ef7			 
8ef7 18 19		      jr    malloc_update_links 
8ef9			 
8ef9			malloc_alloc_fit: 
8ef9 e1			      pop   HL                      ; Dont need new block size, want is exact fit 
8efa			 
8efa					if DEBUG_FORTH_MALLOC 
8efa						DMARK "MAf" 
8efa						CALLMONITOR 
8efa					endif 
8efa			      ; Modify this_free block to be allocation 
8efa eb			      ex    DE, HL 
8efb 2b			      dec   HL 
8efc 2b			      dec   HL 
8efd 2b			      dec   HL 
8efe			 
8efe af			      xor   A                       ; Null the next block ptr of allocated block 
8eff 77			      ld    (HL), A 
8f00 23			      inc   HL 
8f01 77			      ld    (HL), A 
8f02			 
8f02 23			      inc   HL                      ; Store address of allocation to return 
8f03 23			      inc   HL 
8f04 23			      inc   HL 
8f05 e5			      push  HL 
8f06			 
8f06			      ; Copy next_free ptr to this_free, remove allocated block from free list 
8f06 dd 6e 00		      ld    L, (IX+0)               ; next_free to HL 
8f09 dd 66 01		      ld    H, (IX+1) 
8f0c			 
8f0c dd 75 02		      ld    (IX+2), L               ; HL to this_free 
8f0f dd 74 03		      ld    (IX+3), H 
8f12			 
8f12			 
8f12			malloc_update_links: 
8f12			      ; Update prev_free ptr to point to this_free 
8f12 dd 6e 04		      ld    L, (IX+4)               ; prev_free ptr to HL 
8f15 dd 66 05		      ld    H, (IX+5) 
8f18			 
8f18 dd 5e 02		      ld    E, (IX+2)               ; this_free ptr to DE 
8f1b dd 56 03		      ld    D, (IX+3) 
8f1e			 
8f1e 73			      ld    (HL), E                 ; this_free ptr into prev_free 
8f1f 23			      inc   HL 
8f20 72			      ld    (HL), D 
8f21			 
8f21					if DEBUG_FORTH_MALLOC 
8f21						DMARK "Mul" 
8f21						CALLMONITOR 
8f21					endif 
8f21			      ; Clear the Z flag to indicate successful allocation 
8f21 7a			      ld    A, D 
8f22 b3			      or    E 
8f23			 
8f23 d1			      pop   DE                      ; Address of allocation 
8f24					if DEBUG_FORTH_MALLOC 
8f24						DMARK "MAu" 
8f24						CALLMONITOR 
8f24					endif 
