2602				include "forth_wordsv4.asm" 
2602			 
2602			; the core word dictionary v4 
2602			; https://www.complang.tuwien.ac.at/forth/gforth/Docs-html/Notation.html#Notation 
2602			 
2602			; this is a linked list for each of the system words used 
2602			; user defined words will follow the same format but will be in ram 
2602			 
2602			 
2602			; 
2602			; 
2602			; define linked list: 
2602			; 
2602			; 1. compiled byte op code 
2602			; 2. len of text word 
2602			; 3. text word 
2602			; 4. ptr to next dictionary word 
2602			; 5. asm, calls etc for the word 
2602			; 
2602			;  if 1 == 0 then last word in dict  
2602			;   
2602			; set the start of dictionary scanning to be in ram and the last word point to the system dict 
2602			;  
2602			;  
2602			; create basic standard set of words 
2602			; 
2602			;  
2602			; + - / * DUP EMIT . SWAP IF..THEN..ELSE DO..LOOP  : ; DROP  
2602			; 2DUP 2DROP 2SWAP  
2602			; @ C@ - get byte  
2602			; ! C! - store byte 
2602			; 0< true if less than zero 
2602			; 0= true if zero 
2602			; < >  
2602			; = true if same 
2602			; variables 
2602			 
2602			 
2602			; Hardware specific words I may need 
2602			; 
2602			; IN OUT  
2602			; calls to key util functions 
2602			; calls to hardward abstraction stuff 
2602			; easy control of frame buffers and lcd i/o 
2602			; keyboard  
2602			 
2602			 
