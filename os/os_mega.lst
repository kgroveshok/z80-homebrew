6951			include "firmware_lcd_4x40.asm" 
6951			; **********************************************************************  
6951			; **  Alphanumeric LCD example                  by Stephen C Cousins  **  
6951			; **********************************************************************  
6951			;  
6951			; **  Written as a Small Computer Monitor App  
6951			; **  www.scc.me.uk  
6951			;  
6951			; History  
6951			; 2018-05-20  v0.2.0  SCC  Example for LiNC80 SBC1 only  
6951			; 2018-06-28  v0.3.0  SCC  Added support for RC2014 and Z280RC  
6951			; 2019-09-14  v0.4.0  SCC  Added support for SC129 digital I/O module  
6951			;  
6951			; **********************************************************************  
6951			;  
6951			; This program is an example of one of the methods of interfacing an   
6951			; alphanumeric LCD module.   
6951			;  
6951			; In this example the display is connected to either a Z80 PIO or a   
6951			; simple 8-bit output port.   
6951			;  
6951			; This interfacing method uses 4-bit data mode and uses time delays  
6951			; rather than polling the display's ready status. As a result the   
6951			; interface only requires 6 simple output lines:  
6951			;   Output bit 0 = not used  
6951			;   Output bit 1 = not used  
6951			;   Output bit 2 = RS         High = data, Low = instruction  
6951			;   Output bit 3 = E          Active high  
6951			;   Output bit 4 = DB4  
6951			;   Output bit 5 = DB5  
6951			;   Output bit 6 = DB6  
6951			;   Output bit 7 = DB7  
6951			; Display's R/W is connected to 0v so it is always in write mode  
6951			;  
6951			; This set up should work with any system supporting the RC2014 bus  
6951			  
6951			; To set up PIO port A in mode 3 (control) using LiNC80 as example  
6951			;   I/O address 0x1A = 0b11001111 (0xCF)   Select mode 3 (control)  
6951			;   I/O address 0x1A = 0b00000000 (0x00)   All pins are output  
6951			;  
6951			; **********************************************************************  
6951			  
6951			; Additonal for 4x40. E1 and E2 instead of just E   
6951			; TODO swipe vidout signal on port a to activate E2  
6951			  
6951			; **********************************************************************  
6951			; **  Constants  
6951			; **********************************************************************  
6951			; LCD constants required by LCD support module  
6951			kLCDPrt:    EQU kDataReg       ;LCD port is the PIO port A data reg  
6951			kLCDBitRS:  EQU 2              ;Port bit for LCD RS signal  
6951			kLCDBitE:   EQU 3              ;Port bit for LCD E signal             
6951			kLCDBitE2:   EQU 0              ;Port bit for LCD E2 signal            VICLK  
6951			kLCDBitLED:   EQU 1              ;Port bit for LCD E2 signal            VIDDO  
6951			; TODO Decide which E is being set  
6951			kLCDWidth:  EQU display_cols             ;Width in characters  
6951			  
6951			; **********************************************************************  
6951			; **  Code library usage  
6951			; **********************************************************************  
6951			  
6951			; send character to current cursor position  
6951			; wraps and/or scrolls screen automatically  
6951			  
6951			  
6951			  
6951			lcd_init:  
6951			  
6951			; SCMonAPI functions used  
6951			  
6951			; Alphanumeric LCD functions used  
6951			; no need to specify specific functions for this module  
6951			  
6951 3e cf		            LD   A, 11001111b  
6953 d3 c2		            OUT  (kContReg), A  ;Port A = PIO 'control' mode  
6955 3e 00		            LD   A, 00000000b  
6957 d3 c2		            OUT  (kContReg),A   ;Port A = all lines are outputs  
6959			  
6959			; Initialise alphanumeric LCD module  
6959 3e 00				ld a, 0  
695b 32 fb fa				ld (display_lcde1e2), a  
695e cd df 69		            CALL fLCD_Init      ;Initialise LCD module  
6961 3e 01				ld a, 1  
6963 32 fb fa				ld (display_lcde1e2), a  
6966 cd df 69		            CALL fLCD_Init      ;Initialise LCD module  
6969			  
6969 c9				ret  
696a			  
