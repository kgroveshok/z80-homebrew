1caa			; A better parser without using malloc and string copies all over the place.  
1caa			; Exec in situ should be faster 
1caa			 
1caa			;WORD_SYS_LOWPRIM: equ 4    ; Offset for low level prim words opcode 
1caa			;WORD_SYS_BRANCH: equ 10    ; Offset for branching and loop words opcode 
1caa			WORD_SYS_UWORD: equ 1   ; Opcode for all user words 
1caa			WORD_SYS_DELETED: equ 3 ; Op code for a deleted UWORD 
1caa			WORD_SYS_ROOT: equ 0   ; Opcode for all user words 
1caa			WORD_SYS_END: equ 0   ; Opcode for all user words 
1caa			WORD_SYS_CORE: equ 20    ; Offset for dict core words opcode 
1caa			WORD_FLAG_CODE: equ 0	   ; opcodeflag to exec pure code for this word 
1caa			WORD_FLAG_JP: equ 1	   ; opcodeflag to list zero term jump table words 
1caa			 
1caa			; Core word preamble macro 
1caa			 
1caa			CWHEAD:   macro nxtword opcode lit len opflags 
1caa				db WORD_SYS_CORE+opcode             
1caa				; internal op code number 
1caa				dw nxtword            
1caa				; link to next dict word block 
1caa				db len + 1 
1caa				; literal length of dict word inc zero term 
1caa				db lit,0              
1caa				; literal dict word 
1caa			        ; TODO db opflags        
1caa				endm 
1caa			 
1caa			 
1caa			NEXTW: macro  
