1d43			include "firmware_595shiftreg.asm"  
1d43			; common code for handling a 595 shift reg out on whatever output port 
1d43			 
1d43			; port in c 
1d43			; byte in a 
1d43			 
1d43			 
1d43			shift_bit_data: equ 0 
1d43			shift_bit_clk: equ 1 
1d43			shift_bit_latch: equ 2 
1d43			 
1d43			 
1d43			; shift out a byte to the sound chip 
1d43			 
1d43			; A contains byte to send 
1d43			 
1d43			shift_byte: 
1d43			 
1d43 06 08			ld b, 8   ; 8 bits to shift 
1d45			 
1d45 16 00		.nb1:	ld d, 0    ; our work byte to send to the device with flags 
1d47			 
1d47				; set data bit state 
1d47			 
1d47 cb 7f			bit 7, a 
1d49				; high bit is set 
1d49 28 02			jr z, .nb2 
1d4b cb c2			set shift_bit_data, d 
1d4d			 
1d4d				; set latches state  
1d4d cb ca		.nb2:	set shift_bit_clk, d 
1d4f cb 92			res shift_bit_latch, d    ; latch is inverted 
1d51 ed 51			out (c), d 
1d53				 
1d53				; clock the bit out 
1d53 cb 8a			res shift_bit_clk, d 
1d55 ed 51			out (c), d 
1d57			 
1d57				; shift a left one bit and repeat 
1d57 17				rla 
1d58			 
1d58 10 eb			djnz .nb1 
1d5a			 
1d5a				; latch 
1d5a cb d2			set shift_bit_latch, d 
1d5c ed 51			out (c), d 
1d5e					 
1d5e			 
1d5e				; set  
1d5e c9				ret 
# End of file firmware_595shiftreg.asm
