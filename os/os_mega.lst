2101			FORTH_DSP_NEXT: macro 
2101				call macro_forth_dsp_next 
2101				endm 
2101			 
2101			 
2101			macro_forth_dsp_next: 
2101				if DEBUG_FORTH_STACK_GUARD 
2101 cd 83 65				call check_stacks 
2104				endif 
2104 e5				push hl 
2105 d5				push de 
2106 eb				ex de,hl 
2107 2a 05 f9			ld hl,(cli_data_sp) 
210a 23				inc hl 
210b 23				inc hl 
210c			 
210c			; PARSEV5 
210c 23				inc hl 
210d 22 05 f9			ld (cli_data_sp),hl 
2110 73				ld (hl), e 
2111 23				inc hl 
2112 72				ld (hl), d 
2113 d1				pop de 
2114 e1				pop hl 
2115				if DEBUG_FORTH_STACK_GUARD 
2115 cd 83 65				call check_stacks 
2118				endif 
2118 c9				ret 
