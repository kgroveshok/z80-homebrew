10c0			; from https://wikiti.brandonw.net/index.php?title=Z80_Routines:Other:DispA 
10c0			 
10c0			; Decimal Unsigned Version 
10c0			 
10c0			;Number in a to decimal ASCII 
10c0			;adapted from 16 bit found in z80 Bits to 8 bit by Galandros 
10c0			;Example: display a=56 as "056" 
10c0			;input: a = number 
10c0			;Output: a=0,value of a in the screen 
10c0			;destroys af,bc (don't know about hl and de) 
10c0			DispAToASCII: 
10c0 0e 9c			ld	c,-100 
10c2 cd cc 10			call	.Na1 
10c5 0e f6			ld	c,-10 
10c7 cd cc 10			call	.Na1 
10ca 0e ff			ld	c,-1 
10cc 06 2f		.Na1:	ld	b,'0'-1 
10ce 04			.Na2:	inc	b 
10cf 81				add	a,c 
10d0 38 fc			jr	c,.Na2 
10d2 91				sub	c		;works as add 100/10/1 
10d3 f5				push af		;safer than ld c,a 
10d4 78				ld	a,b		;char is in b 
10d5			;TODO	CALL	PUTCHAR	;plot a char. Replace with bcall(_PutC) or similar. 
10d5 f1				pop af		;safer than ld a,c 
10d6 c9				ret 
10d7			 
10d7			; Decimal Signed Version 
10d7			 
10d7			; DispA 
10d7			; -------------------------------------------------------------- 
10d7			; Converts a signed integer value to a zero-terminated ASCII 
10d7			; string representative of that value (using radix 10). 
10d7			; -------------------------------------------------------------- 
10d7			; INPUTS: 
10d7			;     HL     Value to convert (two's complement integer). 
10d7			;     DE     Base address of string destination. (pointer). 
10d7			; -------------------------------------------------------------- 
10d7			; OUTPUTS: 
10d7			;     None 
10d7			; -------------------------------------------------------------- 
10d7			; REGISTERS/MEMORY DESTROYED 
10d7			; AF HL 
10d7			; -------------------------------------------------------------- 
10d7			 
10d7			;DispHLToASCII: 
10d7			;   push    de 
10d7			;   push    bc 
10d7			; 
10d7			;; Detect sign of HL. 
10d7			;    bit    7, h 
10d7			;    jr     z, ._DoConvert 
10d7			; 
10d7			;; HL is negative. Output '-' to string and negate HL. 
10d7			;    ld     a, '-' 
10d7			;    ld     (de), a 
10d7			;    inc    de 
10d7			; 
10d7			;; Negate HL (using two's complement) 
10d7			;    xor    a 
10d7			;    sub    l 
10d7			;    ld     l, a 
10d7			;    ld     a, 0     ; Note that XOR A or SUB A would disturb CF 
10d7			;    sbc    a, h 
10d7			;    ld     h, a 
10d7			; 
10d7			;; Convert HL to digit characters 
10d7			;._DoConvert: 
10d7			;    ld     b, 0     ; B will count character length of number 
10d7			;-   ld     a, 10 
10d7			;    syscall  .DivHLByA  ; HL = HL / A, A = remainder 
10d7			;    push   af 
10d7			;    inc    b 
10d7			;    ld     a, h 
10d7			;    or     l 
10d7			;    jr     nz, - 
10d7			; 
10d7			;; Retrieve digits from stack 
10d7			;-   pop    af 
10d7			;    or     $30 
10d7			;    ld     (de), a 
10d7			;    inc    de 
10d7			;    djnz   - 
10d7			; 
10d7			;; Terminate string with NULL 
10d7			;    xor    a 
10d7			;    ld     (de), a 
10d7			; 
10d7			;    pop    bc 
10d7			;    pop    de 
10d7			;    ret 
10d7			 
10d7			;Comments 
10d7			; 
10d7			;    This routine uses the common positive-integer radix conversion algorithm of repeatedly dividing a value by the desired radix (base case: the value is zero) and saving the remainders of each division. 
10d7			;    As this algorithm gives the digits in reverse order, they are pushed onto the hardware stack so that subsequently popping them yields the correct order. 
10d7			;    Note that the output string will not be fixed-width. 
10d7			; 
10d7			;Example Usage 
10d7			; 
10d7			;    ld    hl, -1004 
10d7			;    ld    de, OP1 
10d7			;    call  DispA 
10d7			;    ld    hl, OP1 
10d7			;    syscall  PutS 
10d7			 
10d7			 
10d7			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/string_to_uint16.z80 
10d7			 
10d7			 
10d7			;Converts an ASCII string to an unsigned 16-bit integer 
10d7			;Quits when it reaches a non-decimal digit 
10d7			 
10d7			string_to_uint16: 
10d7			atoui_16: 
10d7			;Input: 
10d7			;     DE points to the string 
10d7			;Outputs: 
10d7			;     HL is the result 
10d7			;     A is the 8-bit value of the number 
10d7			;     DE points to the byte after the number 
10d7			;Destroys: 
10d7			;     BC 
10d7			;       if the string is non-empty, BC is HL/10 
10d7			;Size:  24 bytes 
10d7			;Speed: 42+d(104+{0,9}) 
10d7			;       d is the number of digits in the number 
10d7			;       max is 640 cycles for a 5 digit number 
10d7			;Assuming no leading zeros: 
10d7			;1 digit:  146cc 
10d7			;2 digit:  250cc 
10d7			;3 digit:  354cc or 363cc (avg: 354.126cc) 
10d7			;4 digit:  458cc or 467cc (avg: 458.27cc) 
10d7			;5 digit:  562cc or 571cc or 580cc (avg: 562.4104cc) 
10d7			;avg: 544.81158447265625cc (544+13297/16384) 
10d7			;=============================================================== 
10d7 21 00 00		  ld hl,0 
10da			.u16a: 
10da 1a			  ld a,(de) 
10db d6 30		  sub 30h 
10dd fe 0a		  cp 10 
10df d0			  ret nc 
10e0 13			  inc de 
10e1 44			  ld b,h 
10e2 4d			  ld c,l 
10e3 29			  add hl,hl 
10e4 29			  add hl,hl 
10e5 09			  add hl,bc 
10e6 29			  add hl,hl 
10e7 85			  add a,l 
10e8 6f			  ld l,a 
10e9 30 ef		  jr nc,.u16a 
10eb 24			  inc h 
10ec c3 da 10		  jp .u16a 
10ef			 
10ef			 
10ef			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/string_to_uint16.z80 
10ef			 
10ef			;written by Zeda 
10ef			;Converts a 16-bit unsigned integer to an ASCII string. 
10ef			 
10ef			uitoa_16: 
10ef			;Input: 
10ef			;   DE is the number to convert 
10ef			;   HL points to where to write the ASCII string (up to 6 bytes needed). 
10ef			;Output: 
10ef			;   HL points to the null-terminated ASCII string 
10ef			;      NOTE: This isn't necessarily the same as the input HL. 
10ef d5			  push de 
10f0 c5			  push bc 
10f1 f5			  push af 
10f2 eb			  ex de,hl 
10f3			 
10f3 01 f0 d8		  ld bc,-10000 
10f6 3e 2f		  ld a,'0'-1 
10f8 3c			  inc a 
10f9 09			  add hl,bc  
10fa 38 fc		   jr c,$-2 
10fc 12			  ld (de),a 
10fd 13			  inc de 
10fe			 
10fe 01 e8 03		  ld bc,1000 
1101 3e 3a		  ld a,'9'+1 
1103 3d			  dec a  
1104 09			  add hl,bc  
1105 30 fc		   jr nc,$-2 
1107 12			  ld (de),a 
1108 13			  inc de 
1109			 
1109 01 9c ff		  ld bc,-100 
110c 3e 2f		  ld a,'0'-1 
110e 3c			  inc a  
110f 09			  add hl,bc  
1110 38 fc		   jr c,$-2 
1112 12			  ld (de),a 
1113 13			  inc de 
1114			 
1114 7d			  ld a,l 
1115 26 3a		  ld h,'9'+1 
1117 25			  dec h  
1118 c6 0a		  add a,10  
111a 30 fb		   jr nc,$-3 
111c c6 30		  add a,'0' 
111e eb			  ex de,hl 
111f 72			  ld (hl),d 
1120 23			  inc hl 
1121 77			  ld (hl),a 
1122 23			  inc hl 
1123 36 00		  ld (hl),0 
1125			 
1125			;Now strip the leading zeros 
1125 0e fa		  ld c,-6 
1127 09			  add hl,bc 
1128 3e 30		  ld a,'0' 
112a 23			  inc hl  
112b be			  cp (hl)  
112c 28 fc		  jr z,$-2 
112e			 
112e			;Make sure that the string is non-empty! 
112e 7e			  ld a,(hl) 
112f b7			  or a 
1130 20 01		  jr nz,.atoub 
1132 2b			  dec hl 
1133			.atoub: 
1133			 
1133 f1			  pop af 
1134 c1			  pop bc 
1135 d1			  pop de 
1136 c9			  ret 
1137			 
1137			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/toUpper.z80 
1137			 
1137			toUpper: 
1137			;A is the char. 
1137			;If A is a lowercase letter, this sets it to the matching uppercase 
1137			;18cc or 30cc or 41cc 
1137			;avg: 26.75cc 
1137 fe 61		  cp 'a' 
1139 d8			  ret c 
113a fe 7b		  cp 'z'+1 
113c d0			  ret nc 
113d d6 20		  sub 'a'-'A' 
113f c9			  ret 
