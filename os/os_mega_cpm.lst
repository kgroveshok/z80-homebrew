0ff9			StrictStrCmp: 
0ff9				; Load next chars of each string 
0ff9 1a				ld a, (de) 
0ffa 47				ld b, a 
0ffb 7e				ld a, (hl) 
0ffc				; Compare 
0ffc b8				cp b 
0ffd				; Return non-zero if chars don't match 
0ffd c0				ret nz 
0ffe				; Check for end of both strings 
0ffe fe 00			cp "\0" 
1000				; Return if strings have ended 
1000 c8				ret z 
1001				; Otherwise, advance to next chars 
1001 23				inc hl 
1002 13				inc de 
1003 18 f4			jr StrictStrCmp 
