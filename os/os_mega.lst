213a			; forth parser 
213a			 
213a			; My forth kernel 
213a			include "forth_kernel.asm" 
213a			; 
213a			; kernel to the forth OS 
213a			 
213a			DS_TYPE_STR: equ 1     ; string type 
213a			DS_TYPE_INUM: equ 2     ; $ 16 bit unsigned int usually a hex address 
213a			DS_TYPE_SNUM: equ 3     ; $ 16 bit signed int  
213a			DS_TYPE_CONST: equ 4     ; string type that won't be freed on a POP 
213a			;DS_TYPE_FNUM: equ 3      ; 24/32 bit floating point  do string conversion instead of a new type 
213a			 
213a			FORTH_PARSEV1: equ 0 
213a			FORTH_PARSEV2: equ 0 
213a			FORTH_PARSEV3: equ 0 
213a			FORTH_PARSEV4: equ 0 
213a			FORTH_PARSEV5: equ 0 
213a			FORTH_PARSEV6: equ 1 
213a			 
213a			;if FORTH_PARSEV5 
213a			;	FORTH_END_BUFFER: equ 0 
213a			;else 
213a			FORTH_END_BUFFER: equ 127 
213a			;endif 
213a			 
213a			FORTH_TRUE: equ 1 
213a			FORTH_FALSE: equ 0 
213a			 
213a			if FORTH_PARSEV4 
213a			include "forth_stackops.asm" 
213a			endif 
213a			 
213a			if FORTH_PARSEV5 
213a			include "forth_stackopsv5.asm" 
213a			endif 
213a			 
213a			if FORTH_PARSEV6 
213a			include "forth_stackopsv5.asm" 
213a			 
213a			; Stack operations for v5 parser on wards 
213a			; * DATA stack 
213a			; * LOOP stack 
213a			; * RETURN stack 
213a			 
213a			 
213a			 
213a			FORTH_CHK_DSP_UNDER: macro 
213a				push hl 
213a				push de 
213a				ld hl,(cli_data_sp) 
213a				ld de, cli_data_stack 
213a				call cmp16 
213a				jp c, fault_dsp_under 
213a				pop de 
213a				pop hl 
213a				endm 
213a			 
213a			 
213a			FORTH_CHK_RSP_UNDER: macro 
213a				push hl 
213a				push de 
213a				ld hl,(cli_ret_sp) 
213a				ld de, cli_ret_stack 
213a				call cmp16 
213a				jp c, fault_rsp_under 
213a				pop de 
213a				pop hl 
213a				endm 
213a			 
213a			FORTH_CHK_LOOP_UNDER: macro 
213a				push hl 
213a				push de 
213a				ld hl,(cli_loop_sp) 
213a				ld de, cli_loop_stack 
213a				call cmp16 
213a				jp c, fault_loop_under 
213a				pop de 
213a				pop hl 
213a				endm 
213a			 
213a			FORTH_ERR_TOS_NOTSTR: macro 
213a				; TOSO might need more for checks when used 
213a				push af 
213a				ld a,(hl) 
213a				cp DS_TYPE_STR 
213a				jp nz, type_faultn   
213a				pop af 
213a				endm 
213a			 
213a			FORTH_ERR_TOS_NOTNUM: macro 
213a				push af 
213a				ld a,(hl) 
213a				cp DS_TYPE_INUM 
213a				jp nz, type_faultn   
213a				pop af 
213a				endm 
