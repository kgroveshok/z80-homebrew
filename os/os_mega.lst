# End of macro CWHEAD
53b8			; | VAR ( u1 -- )  Get the address of the (word) variable referenced on TOS  | DONE 
53b8			; | 
53b8			; | | The variable name should consist of a single letter (a-z). e.g. "a" 
53b8			; | |  
53b8			; | | e.g. 
53b8			; | |         #30 a var ! 
53b8			; | |         a var @ . 
53b8			; | |   
53b8			; | |     Displays the number 30 
53b8			; | | 
53b8			; | | Each variable pointer is a word so can use for any words that use that:  
53b8			; | |  
53b8			; | | e.g. 
53b8			; | |  
53b8			; | |         #30 a var 2! 
53b8			; | |         a var 2@ . 
53b8			; | |   
53b8			; | |     Displays the number 30 
53b8			; | |  
53b8			; | | > [!NOTE]  
53b8			; ! | > If a full string is passed then only the first char is looked at 
53b8			; | | > Any other char could exceed bounds checks!  
53b8			; | | > 
53b8			; | | > Each variable location follows the previous. Watch you don't clobber any others. 
53b8			 
53b8					if DEBUG_FORTH_WORDS_KEY 
53b8						DMARK "VAR" 
53b8				if DEMARK_VERSION = 1  
53b8 e5					push hl  
53b9 21 c1 53				ld hl, .dmark  
53bc 22 9b fd				ld (debug_mark), hl  
53bf				endif  
53bf				if DEMARK_VERSION = 0  
53bf					push af  
53bf					ld a, (.dmark)  
53bf					ld (debug_mark),a  
53bf					ld a, (.dmark+1)  
53bf					ld (debug_mark+1),a  
53bf					ld a, (.dmark+2)  
53bf					ld (debug_mark+2),a  
53bf				endif  
53bf 18 04			jr .pastdmark  
53c1 ..			.dmark: db "VAR"  
53c4				if DEMARK_VERSION = 1  
53c4 00					db 0  
53c5				endif  
53c5				if DEMARK_VERSION = 1  
53c5 e1			.pastdmark: pop hl  
53c6				endif  
53c6				if DEMARK_VERSION = 0  
53c6			.pastdmark: pop af  
53c6				endif  
53c6			endm  
# End of macro DMARK
53c6						CALLMONITOR 
53c6				if BASE_CPM=1  
53c6					call debug_vector  
53c6				endif  
53c6				if BASE_KEV=1  
53c6 cf					rst 8  
53c7				endif  
53c7				endm  
# End of macro CALLMONITOR
53c7					endif 
