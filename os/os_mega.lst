1164			StrictStrCmp: 
1164				; Load next chars of each string 
1164 1a				ld a, (de) 
1165 47				ld b, a 
1166 7e				ld a, (hl) 
1167				; Compare 
1167 b8				cp b 
1168				; Return non-zero if chars don't match 
1168 c0				ret nz 
1169				; Check for end of both strings 
1169 fe 00			cp "\0" 
116b				; Return if strings have ended 
116b c8				ret z 
116c				; Otherwise, advance to next chars 
116c 23				inc hl 
116d 13				inc de 
116e 18 f4			jr StrictStrCmp 
