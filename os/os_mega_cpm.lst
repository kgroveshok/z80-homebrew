1005			malloc_guard_zerolen: 
1005				push hl 
1005				push de 
1005				push af 
1005			 
1005				ld de, 0 
1005			        call cmp16 
1005				jr nz, .lowalloz 
1005			 
1005				push hl 
1005				push de 
1005					ld hl, display_fb0 
1005					ld (display_fb_active), hl 
1005				call clear_display 
1005				ld a, 0 
1005				ld de, .malloczero 
1005				call str_at_display 
1005				call update_display 
1005				call delay1s 
