153d			include "firmware_595shiftreg.asm"  
153d			; common code for handling a 595 shift reg out on whatever output port 
153d			 
153d			; port in c 
153d			; byte in a 
153d			 
153d			 
153d			shift_bit_data: equ 0 
153d			shift_bit_clk: equ 1 
153d			shift_bit_latch: equ 2 
153d			 
153d			 
153d			; shift out a byte to the sound chip 
153d			 
153d			; A contains byte to send 
153d			 
153d			shift_byte: 
153d			 
153d 06 08			ld b, 8   ; 8 bits to shift 
153f			 
153f 16 00		.nb1:	ld d, 0    ; our work byte to send to the device with flags 
1541			 
1541				; set data bit state 
1541			 
1541 cb 7f			bit 7, a 
1543				; high bit is set 
1543 28 02			jr z, .nb2 
1545 cb c2			set shift_bit_data, d 
1547			 
1547				; set latches state  
1547 cb ca		.nb2:	set shift_bit_clk, d 
1549 cb 92			res shift_bit_latch, d    ; latch is inverted 
154b ed 51			out (c), d 
154d				 
154d				; clock the bit out 
154d cb 8a			res shift_bit_clk, d 
154f ed 51			out (c), d 
1551			 
1551				; shift a left one bit and repeat 
1551 17				rla 
1552			 
1552 10 eb			djnz .nb1 
1554			 
1554				; latch 
1554 cb d2			set shift_bit_latch, d 
1556 ed 51			out (c), d 
1558					 
1558			 
1558				; set  
1558 c9				ret 
# End of file firmware_595shiftreg.asm
