1159						DMARK "maA" 
1159						CALLMONITOR 
1159					endif 
1159			      ; Set up stack frame 
1159 eb			      ex    DE, HL 
115a 21 fa ff		      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
115d 39			      add   HL, SP 
115e f9			      ld    SP, HL 
115f dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
1163 dd 39		      add   IX, SP 
1165			 
1165			      ; Setup initial state 
1165 21 04 00		      ld    HL, 4                   ; want must also include space used by block struct 
1168 19			      add   HL, DE 
1169			 
1169 44			      ld    B, H                    ; Move want to BC 
116a 4d			      ld    C, L 
116b			 
116b 21 0a 80		      ld    HL, free_list           ; Store prev_free ptr to stack 
116e dd 75 04		      ld    (IX+4), L 
1171 dd 74 05		      ld    (IX+5), H 
1174			 
1174 5e			      ld    E, (HL)                 ; Store this_free ptr to stack 
1175 23			      inc   HL 
1176 56			      ld    D, (HL) 
1177 dd 73 02		      ld    (IX+2), E 
117a dd 72 03		      ld    (IX+3), D 
117d eb			      ex    DE, HL                  ; this_free ptr into HL 
117e			 
117e					if DEBUG_FORTH_MALLOC 
117e						DMARK "maB" 
117e						CALLMONITOR 
117e					endif 
117e			      ; Loop through free block list to find some space 
117e			malloc_find_space: 
117e 5e			      ld    E, (HL)                 ; Load next_free ptr into DE 
117f 23			      inc   HL 
1180 56			      ld    D, (HL) 
1181			 
1181 7a			      ld    A, D                    ; Check for null next_free ptr - end of free list 
1182 b3			      or    E 
1183 ca 0f 12		      jp    Z, malloc_no_space 
1186			 
1186 dd 73 00		      ld    (IX+0), E               ; Store next_free ptr to stack 
1189 dd 72 01		      ld    (IX+1), D 
118c			 
118c			      ; Does this block have enough space to make the allocation? 
118c 23			      inc   HL                      ; Load free block size into DE 
118d 5e			      ld    E, (HL) 
118e 23			      inc   HL 
118f 56			      ld    D, (HL) 
1190			 
1190 eb			      ex    DE, HL                  ; Check size of block against want 
1191 b7			      or    A                       ; Ensure carry flag clear 
1192 ed 42		      sbc   HL, BC 
1194 e5			      push  HL                      ; Store the result for later (new block size) 
1195			 
1195 ca e4 11		      jp   Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
1198 30 1b		      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
119a			 
119a			      ; this_free block is not big enough, setup ptrs to test next free block 
119a e1			      pop   HL                      ; Discard previous result 
119b			 
119b dd 6e 02		      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
119e dd 66 03		      ld    H, (IX+3) 
11a1 dd 75 04		      ld    (IX+4), L 
11a4 dd 74 05		      ld    (IX+5), H 
11a7			 
11a7 dd 6e 00		      ld    L, (IX+0)               ; Move next_free ptr into this_free 
11aa dd 66 01		      ld    H, (IX+1) 
11ad dd 75 02		      ld    (IX+2), L 
11b0 dd 74 03		      ld    (IX+3), H 
11b3			 
11b3					if DEBUG_FORTH_MALLOC 
11b3						DMARK "MA>" 
11b3						CALLMONITOR 
11b3					endif 
11b3 18 c9		      jr    malloc_find_space 
11b5			 
11b5			      ; split a bigger block into two - requested size and remaining size 
11b5			malloc_alloc_split: 
11b5					if DEBUG_FORTH_MALLOC 
11b5						DMARK "MAs" 
11b5						CALLMONITOR 
11b5					endif 
11b5 eb			      ex    DE, HL                  ; Calculate address of new free block 
11b6 2b			      dec   HL 
11b7 2b			      dec   HL 
11b8 2b			      dec   HL 
11b9 09			      add   HL, BC 
11ba			 
11ba			      ; Create a new block and point it at next_free 
11ba dd 5e 00		      ld    E, (IX+0)               ; Load next_free ptr into DE 
11bd dd 56 01		      ld    D, (IX+1) 
11c0			 
11c0 73			      ld    (HL), E                 ; Store next_free ptr into new block 
11c1 23			      inc   HL 
11c2 72			      ld    (HL), D 
11c3			 
11c3 d1			      pop   DE                      ; Store size of new block into new block 
11c4 23			      inc   HL 
11c5 73			      ld    (HL), E 
11c6 23			      inc   HL 
11c7 72			      ld    (HL), D 
11c8			 
11c8			      ; Update this_free ptr to point to new block 
11c8 2b			      dec   HL 
11c9 2b			      dec   HL 
11ca 2b			      dec   HL 
11cb			 
11cb dd 5e 02		      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
11ce dd 56 03		      ld    D, (IX+3) 
11d1			 
11d1 dd 75 02		      ld    (IX+2), L               ; Store new block addr as this_free ptr 
11d4 dd 74 03		      ld    (IX+3), H 
11d7			 
11d7			      ; Modify this_free block to be allocation 
11d7 eb			      ex    DE, HL 
11d8 af			      xor   A                       ; Null the next block ptr of allocated block 
11d9 77			      ld    (HL), A 
11da 23			      inc   HL 
11db 77			      ld    (HL), A 
11dc			 
11dc 23			      inc   HL                      ; Store want size into allocated block 
11dd 71			      ld    (HL), C 
11de 23			      inc   HL 
11df 70			      ld    (HL), B 
11e0 23			      inc   HL 
11e1 e5			      push  HL                      ; Address of allocation to return 
11e2			 
11e2 18 19		      jr    malloc_update_links 
11e4			 
11e4			malloc_alloc_fit: 
11e4 e1			      pop   HL                      ; Dont need new block size, want is exact fit 
11e5			 
11e5					if DEBUG_FORTH_MALLOC 
11e5						DMARK "MAf" 
11e5						CALLMONITOR 
11e5					endif 
11e5			      ; Modify this_free block to be allocation 
11e5 eb			      ex    DE, HL 
11e6 2b			      dec   HL 
11e7 2b			      dec   HL 
11e8 2b			      dec   HL 
11e9			 
11e9 af			      xor   A                       ; Null the next block ptr of allocated block 
11ea 77			      ld    (HL), A 
11eb 23			      inc   HL 
11ec 77			      ld    (HL), A 
11ed			 
11ed 23			      inc   HL                      ; Store address of allocation to return 
11ee 23			      inc   HL 
11ef 23			      inc   HL 
11f0 e5			      push  HL 
11f1			 
