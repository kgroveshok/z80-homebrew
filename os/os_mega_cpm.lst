0b15			;-----> Generate a random number 
0b15			; output a=answer 0<=a<=255 
0b15			; all registers are preserved except: af 
0b15			random: 
0b15 e5			        push    hl 
0b16 d5			        push    de 
0b17 2a a0 eb		        ld      hl,(randData) 
0b1a ed 5f		        ld      a,r 
0b1c 57			        ld      d,a 
0b1d 5e			        ld      e,(hl) 
0b1e 19			        add     hl,de 
0b1f 85			        add     a,l 
0b20 ac			        xor     h 
0b21 22 a0 eb		        ld      (randData),hl 
0b24 d1			        pop     de 
0b25 e1			        pop     hl 
0b26 c9			        ret 
0b27			 
0b27			 
0b27			; randData here must be a 2 byte seed located in ram. While this is a fast generator, it's generally not considered very good in terms of randomness. 
