0cc0			 
0cc0			;-----> Generate a random number 
0cc0			; output a=answer 0<=a<=255 
0cc0			; all registers are preserved except: af 
0cc0			random: 
0cc0 e5			        push    hl 
0cc1 d5			        push    de 
0cc2 2a db fa		        ld      hl,(randData) 
0cc5 ed 5f		        ld      a,r 
0cc7 57			        ld      d,a 
0cc8 5e			        ld      e,(hl) 
0cc9 19			        add     hl,de 
0cca 85			        add     a,l 
0ccb ac			        xor     h 
0ccc 22 db fa		        ld      (randData),hl 
0ccf d1			        pop     de 
0cd0 e1			        pop     hl 
0cd1 c9			        ret 
0cd2			 
0cd2			 
0cd2			; randData here must be a 2 byte seed located in ram. While this is a fast generator, it's generally not considered very good in terms of randomness. 
0cd2			 
0cd2			 
0cd2			 
0cd2			;------LFSR------ 
0cd2			;James Montelongo 
0cd2			;optimized by Spencer Putt 
0cd2			;out: 
0cd2			; a = 8 bit random number 
0cd2			RandLFSR: 
0cd2 21 e1 fa		        ld hl,LFSRSeed+4 
0cd5 5e			        ld e,(hl) 
0cd6 23			        inc hl 
0cd7 56			        ld d,(hl) 
0cd8 23			        inc hl 
0cd9 4e			        ld c,(hl) 
0cda 23			        inc hl 
0cdb 7e			        ld a,(hl) 
0cdc 47			        ld b,a 
0cdd cb 13		        rl e  
0cdf cb 12			rl d 
0ce1 cb 11		        rl c  
0ce3 17				rla 
0ce4 cb 13		        rl e  
0ce6 cb 12			rl d 
0ce8 cb 11		        rl c  
0cea 17				rla 
0ceb cb 13		        rl e  
0ced cb 12			rl d 
0cef cb 11		        rl c  
0cf1 17				rla 
0cf2 67			        ld h,a 
0cf3 cb 13		        rl e  
0cf5 cb 12			rl d 
0cf7 cb 11		        rl c  
0cf9 17				rla 
0cfa a8			        xor b 
0cfb cb 13		        rl e  
0cfd cb 12			rl d 
0cff ac			        xor h 
0d00 a9			        xor c 
0d01 aa			        xor d 
0d02 21 e3 fa		        ld hl,LFSRSeed+6 
0d05 11 e4 fa		        ld de,LFSRSeed+7 
0d08 01 07 00		        ld bc,7 
0d0b ed b8		        lddr 
0d0d 12			        ld (de),a 
0d0e c9			        ret 
0d0f			 
0d0f			;While this may produces better numbers, it is slower, larger and requires a bigger seed than ionrandom. Assuming theres is a good seed to start, it should generate ~2^56 bytes before repeating. However if there is not a good seed(0 for example), then the numbers created will not be adequate. Unlike Ionrandom and its use of the r register, starting with the same seed the same numbers will be generated. With Ionrandom the code running may have an impact on the number generated. This means this method requires more initialization. 
0d0f			 
0d0f			;You can initialize with TI-OS's seeds, stored at seed1 and seed2, both are ti-floats but will serve the purpose.  
0d0f			 
0d0f			 
0d0f			;This is a very fast, quality pseudo-random number generator. It combines a 16-bit Linear Feedback Shift Register and a 16-bit LCG. 
0d0f			 
0d0f			prng16: 
0d0f			;Inputs: 
0d0f			;   (seed1) contains a 16-bit seed value 
0d0f			;   (seed2) contains a NON-ZERO 16-bit seed value 
0d0f			;Outputs: 
0d0f			;   HL is the result 
0d0f			;   BC is the result of the LCG, so not that great of quality 
0d0f			;   DE is preserved 
0d0f			;Destroys: 
0d0f			;   AF 
0d0f			;cycle: 4,294,901,760 (almost 4.3 billion) 
0d0f			;160cc 
0d0f			;26 bytes 
0d0f 2a d5 fa		    ld hl,(seed1) 
0d12 44			    ld b,h 
0d13 4d			    ld c,l 
0d14 29			    add hl,hl 
0d15 29			    add hl,hl 
0d16 2c			    inc l 
0d17 09			    add hl,bc 
0d18 22 d5 fa		    ld (seed1),hl 
0d1b 2a d3 fa		    ld hl,(seed2) 
0d1e 29			    add hl,hl 
0d1f 9f			    sbc a,a 
0d20 e6 2d		    and %00101101 
0d22 ad			    xor l 
0d23 6f			    ld l,a 
0d24 22 d3 fa		    ld (seed2),hl 
0d27 09			    add hl,bc 
0d28 c9			    ret 
0d29			 
0d29			;On their own, LCGs and LFSRs don't produce great results and are generally very cyclical, but they are very fast to compute. The 16-bit LCG in the above example will bounce around and reach each number from 0 to 65535, but the lower bits are far more predictable than the upper bits. The LFSR mixes up the predictability of a given bit's state, but it hits every number except 0, meaning there is a slightly higher chance of any given bit in the result being a 1 instead of a 0. It turns out that by adding together the outputs of these two generators, we can lose the predictability of a bit's state, while ensuring it has a 50% chance of being 0 or 1. As well, since the periods, 65536 and 65535 are coprime, then the overall period of the generator is 65535*65536, which is over 4 billion.  
0d29			 
0d29			rand32: 
0d29			;Inputs: 
0d29			;   (seed1_0) holds the lower 16 bits of the first seed 
0d29			;   (seed1_1) holds the upper 16 bits of the first seed 
0d29			;   (seed2_0) holds the lower 16 bits of the second seed 
0d29			;   (seed2_1) holds the upper 16 bits of the second seed 
0d29			;   **NOTE: seed2 must be non-zero 
0d29			;Outputs: 
0d29			;   HL is the result 
0d29			;   BC,DE can be used as lower quality values, but are not independent of HL. 
0d29			;Destroys: 
0d29			;   AF 
0d29			;Tested and passes all CAcert tests 
0d29			;Uses a very simple 32-bit LCG and 32-bit LFSR 
0d29			;it has a period of 18,446,744,069,414,584,320 
0d29			;roughly 18.4 quintillion. 
0d29			;LFSR taps: 0,2,6,7  = 11000101 
0d29			;291cc 
0d29			;seed1_0=$+1 
0d29			;    ld hl,12345 
0d29			;seed1_1=$+1 
0d29			;    ld de,6789 
0d29			;    ld b,h 
0d29			;    ld c,l 
0d29			;    add hl,hl \ rl e \ rl d 
0d29			;    add hl,hl \ rl e \ rl d 
0d29			;    inc l 
0d29			;    add hl,bc 
0d29			;    ld (seed1_0),hl 
0d29			;    ld hl,(seed1_1) 
0d29			;    adc hl,de 
0d29			;    ld (seed1_1),hl 
0d29			;    ex de,hl 
0d29			;seed2_0=$+1 
0d29			;    ld hl,9876 
0d29			;seed2_1=$+1 
0d29			;    ld bc,54321 
0d29			;    add hl,hl \ rl c \ rl b 
0d29			;    ld (seed2_1),bc 
0d29			;    sbc a,a 
0d29			;    and %11000101 
0d29			;    xor l 
0d29			;    ld l,a 
0d29			;    ld (seed2_0),hl 
0d29			;    ex de,hl 
0d29			;    add hl,bc 
0d29			;    ret 
0d29			; 
0d29			 
0d29			; 16-bit xorshift pseudorandom number generator by John Metcalf 
0d29			; 20 bytes, 86 cycles (excluding ret) 
0d29			 
0d29			; returns   hl = pseudorandom number 
0d29			; corrupts   a 
0d29			 
0d29			; generates 16-bit pseudorandom numbers with a period of 65535 
0d29			; using the xorshift method: 
0d29			 
0d29			; hl ^= hl << 7 
0d29			; hl ^= hl >> 9 
0d29			; hl ^= hl << 8 
0d29			 
0d29			; some alternative shift triplets which also perform well are: 
0d29			; 6, 7, 13; 7, 9, 13; 9, 7, 13. 
0d29			 
0d29			;  org 32768 
0d29			 
0d29			xrnd: 
0d29 2a d9 fa		  ld hl,(xrandc)       ; seed must not be 0 
0d2c 3e 00		  ld a,0 
0d2e bd			  cp l 
0d2f 20 02		  jr nz, .xrnd1 
0d31 2e 01		  ld l, 1 
0d33			.xrnd1: 
0d33			 
0d33 7c			  ld a,h 
0d34 1f			  rra 
0d35 7d			  ld a,l 
0d36 1f			  rra 
0d37 ac			  xor h 
0d38 67			  ld h,a 
0d39 7d			  ld a,l 
0d3a 1f			  rra 
0d3b 7c			  ld a,h 
0d3c 1f			  rra 
0d3d ad			  xor l 
0d3e 6f			  ld l,a 
0d3f ac			  xor h 
0d40 67			  ld h,a 
0d41			 
0d41 22 d9 fa		  ld (xrandc),hl 
0d44			 
0d44 c9			  ret 
