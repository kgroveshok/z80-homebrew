0bc0			;http://z80-heaven.wikidot.com/math 
0bc0			; 
0bc0			;Inputs: 
0bc0			;     DE and A are factors 
0bc0			;Outputs: 
0bc0			;     A is not changed 
0bc0			;     B is 0 
0bc0			;     C is not changed 
0bc0			;     DE is not changed 
