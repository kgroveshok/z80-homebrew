d518			; handle the auto run of code from files in storage 
d518			 
d518			 
d518			include "forth_startup.asm" 
d518			; Which startup method to use? 
d518			; 
d518			; version 1 - allows for a single stored file to be selected to run at start up (if se storage is enabled) 
d518			; followed by loading of a list of scripts in eeprom 
d518			 
d518			; version 2 - if se storage is enabled then auto load all files which begin with a '*' else use loading 
d518			; from eeprom 
d518			 
d518			; Select with define in main stubs 
d518			 
d518			if STARTUP_V1 
d518				include "forth_startupv1.asm" 
d518			; Startup script loading version 1 
d518			 
d518			; If SE storage is available first stage is to use the selected file 
d518			; then go through the eeprom list 
d518			 
d518 .. 00		sprompt1: db "Startup load...",0 
d528 .. 00		sprompt2: db "Run? 1=No *=End #=All",0 
