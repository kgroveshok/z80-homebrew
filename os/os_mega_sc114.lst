# End of macro CWHEAD
a543			; | MONITOR ( -- ) Display system breakpoint/monitor | DONE 
a543			; | | At start the current various registers will be displayed with contents. 
a543			; | | Top right corner will show the most recent debug marker seen. 
a543			; | | The bottom of the screen will also show the values of the data stack pointer (DSP) 
a543			; | | and the return stack pointer (RSP). 
a543			; | | Pressing: 
a543			; | |  
a543			; | |    1 - Initial screen 
a543			; | |  
a543			; | |    2 - Display a data dump of HL 
a543			; | |  
a543			; | |    3 - Display a data dump of DE 
a543			; | |  
a543			; | |    4 - Display a data dump of BC 
a543			; | |  
a543			; | |    5 - Display a data dump of HL 
a543			; | |  
a543			; | |    6 - Display a data dump of DSP 
a543			; | |  
a543			; | |    7 - Display a data dump of RSP 
a543			; | |  
a543			; | |    8 - Display a data dump of what is at DSP 
a543			; | |  
a543			; | |    9 - Display a data dump of what is at RSP 
a543			; | |  
a543			; | |    0 - Exit monitor and continue running. This will also enable break points 
a543			; | |  
a543			; | |    * - Disable break points 
a543			; | |  
a543			; | |    # - Enter traditional monitor mode 
a543			; | |  
a543			; | | 
a543			; | | Monitor Mode 
a543			; | | ------------ 
a543			; | | A prompt of '>' will be shown for various commands: 
a543			; | |  
a543			; | |    D xxxx - Display a data dump starting from hex address xxxx 
a543			; | |  
a543			; | |    C - Continue display a data dump from the last set address 
a543			; | |  
a543			; | |    M xxxx - Set start of memory edit at address xx 
a543			; | |  
a543			; | |    U xx - Poke the hex byte xx into the address set by M and increment the address to the next location 
a543			; | |  
a543			; | |    G xxxx - Exec code at specific address 
a543			; | |  
a543			; | |    Q - Return to previous 
a543				if DEBUG_FORTH_WORDS_KEY 
a543					DMARK "MON" 
a543				if DEMARK_VERSION = 1  
a543 e5					push hl  
a544 21 4c a5				ld hl, .dmark  
a547 22 60 ee				ld (debug_mark), hl  
a54a				endif  
a54a				if DEMARK_VERSION = 0  
a54a					push af  
a54a					ld a, (.dmark)  
a54a					ld (debug_mark),a  
a54a					ld a, (.dmark+1)  
a54a					ld (debug_mark+1),a  
a54a					ld a, (.dmark+2)  
a54a					ld (debug_mark+2),a  
a54a				endif  
a54a 18 04			jr .pastdmark  
a54c ..			.dmark: db "MON"  
a54f				if DEMARK_VERSION = 1  
a54f 00					db 0  
a550				endif  
a550				if DEMARK_VERSION = 1  
a550 e1			.pastdmark: pop hl  
a551				endif  
a551				if DEMARK_VERSION = 0  
a551			.pastdmark: pop af  
a551				endif  
a551			endm  
# End of macro DMARK
a551					CALLMONITOR 
a551				if BASE_CPM=1  
a551					call debug_vector  
a551				endif  
a551				if BASE_KEV=1  
a551					rst 8  
a551				endif  
a551				endm  
# End of macro CALLMONITOR
a551				endif 
