9edd					ld a, (.dmark)  
9edd					ld (debug_mark),a  
9edd					ld a, (.dmark+1)  
9edd					ld (debug_mark+1),a  
9edd					ld a, (.dmark+2)  
9edd					ld (debug_mark+2),a  
9edd				endif  
9edd 18 04			jr .pastdmark  
9edf ..			.dmark: db "HEP"  
9ee2				if DEMARK_VERSION = 1  
9ee2 00					db 0  
9ee3				endif  
9ee3				if DEMARK_VERSION = 1  
9ee3 e1			.pastdmark: pop hl  
9ee4				endif  
9ee4				if DEMARK_VERSION = 0  
