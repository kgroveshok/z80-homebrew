8e11			; https://tutorials.eeems.ca/ASMin28Days/lesson/day16.html#cmp 
8e11			 
8e11			; String Length 
8e11			;With a length-prefixed string, finding the length is trivial. For a null-terminated string, the process is decidedly more involved. This is where CPIR comes in. 
8e11			 
8e11			; Get the length of the null-terminated string starting at $8000 hl 
8e11			;    LD     HL, $8000 
8e11			 
8e11			strlenz: 
8e11			 
8e11 af			    XOR    A               ; Zero is the value we are looking for. 
8e12 47			    LD     B, A             ; Since we haven't the slightest clue as to the  
8e13 4f			    LD     C, A             ; actual size of the string, put 0 in BC to search 
8e14			                           ; 65, 536 bytes (the entire addressable memory space). 
8e14 ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
8e16			 
8e16			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
8e16 67			    LD     H, A             ; Zero HL (basically set it to 65, 536) to get the 
8e17 6f			    LD     L, A             ; number of bytes 
8e18 ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
8e1a 2b			    DEC    HL              ; Compensate for null. 
8e1b c9				ret 
8e1c			 
8e1c			; Get the length of the A terminated string starting at $8000 hl 
8e1c			;    LD     HL, $8000 
8e1c			 
8e1c			strlent: 
8e1c			 
8e1c			                  ; A is the value we are looking for. 
8e1c 06 00		    LD     B, 0             ; Since we haven't the slightest clue as to the  
8e1e 0e 00		    LD     C, 0             ; actual size of the string, put 0 in BC to search 
8e20			                           ; 65, 536 bytes (the entire addressable memory space). 
8e20 ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
8e22			 
8e22			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
8e22 26 00		    LD     H, 0             ; Zero HL (basically set it to 65, 536) to get the 
8e24 2e 00		    LD     L, 0             ; number of bytes 
8e26 ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
8e28 2b			    DEC    HL              ; Compensate for null. 
8e29 c9				ret 
8e2a			 
8e2a			 
8e2a			;Comparing Strings 
8e2a			 
8e2a			;IN    HL     Address of string1. 
8e2a			;      DE     Address of string2. 
8e2a			 
8e2a			; doc given but wrong??? 
8e2a			;OUT   zero   Set if string1 = string2, reset if string1 != string2. 
8e2a			;      carry  Set if string1 > string2, reset if string1 <= string2. 
8e2a			; tested 
8e2a			;OUT   carry set  if string1 = string2, carry  reset if string1 != string2. 
8e2a			 
8e2a			strcmp_old: 
8e2a e5			    PUSH   HL 
8e2b d5			    PUSH   DE 
8e2c			 
8e2c 1a			    LD     A, (DE)          ; Compare lengths to determine smaller string 
8e2d be			    CP     (HL)            ; (want to minimize work). 
8e2e 38 01		    JR     C, Str1IsBigger 
8e30 7e			    LD     A, (HL) 
8e31			 
8e31			Str1IsBigger: 
8e31 4f			    LD     C, A             ; Put length in BC 
8e32 06 00		    LD     B, 0 
8e34 13			    INC    DE              ; Increment pointers to meat of string. 
8e35 23			    INC    HL 
8e36			 
8e36			CmpLoop: 
8e36 1a			    LD     A, (DE)          ; Compare bytes. 
8e37 ed a1		    CPI 
8e39 20 09		    JR     NZ, NoMatch      ; If (HL) != (DE), abort. 
8e3b 13			    INC    DE              ; Update pointer. 
8e3c ea 36 8e		    JP     PE, CmpLoop 
8e3f			 
8e3f d1			    POP    DE 
8e40 e1			    POP    HL 
8e41 1a			    LD     A, (DE)          ; Check string lengths to see if really equal. 
8e42 be			    CP     (HL) 
8e43 c9			    RET 
8e44			 
8e44			NoMatch: 
8e44 2b			    DEC    HL 
8e45 be			    CP     (HL)            ; Compare again to affect carry. 
8e46 d1			    POP    DE 
8e47 e1			    POP    HL 
8e48 c9			    RET 
