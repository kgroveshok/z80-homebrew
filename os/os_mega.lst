69ca cd a8 6a		            CALL fLCD_Pos       ;Position cursor to location in A  
69cd 06 28			ld b, display_cols  
69cf ed 5b f9 fa		ld de, (display_write_tmp)  
69d3 cd d7 69			call write_len_string  
69d6 c9					ret  
