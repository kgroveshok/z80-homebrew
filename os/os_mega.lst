2631 61 26			dw .EXEC            
2633 05				db 4 + 1 
2634 .. 00			db "HEAP",0              
2639				endm 
# End of macro CWHEAD
2639			; | HEAP ( -- u1 u2 )   Pushes u1 the current number of bytes in the heap and u2 the remaining bytes - Only present if using my MALLOC | DONE 
2639			; | | u1 - Current number of bytes in the heap 
2639			; | | u2 - Remaining bytes left on the heap 
2639			; | |  
2639			; | | The heap is used for storing user defined words as well as any values pushed to stack. 
2639			 
2639			 
2639				if DEBUG_FORTH_WORDS_KEY 
2639					DMARK "HEP" 
2639				if DEMARK_VERSION = 1  
2639 e5					push hl  
263a 21 42 26				ld hl, .dmark  
263d 22 9b fd				ld (debug_mark), hl  
2640				endif  
2640				if DEMARK_VERSION = 0  
2640					push af  
2640					ld a, (.dmark)  
2640					ld (debug_mark),a  
2640					ld a, (.dmark+1)  
2640					ld (debug_mark+1),a  
2640					ld a, (.dmark+2)  
2640					ld (debug_mark+2),a  
2640				endif  
2640 18 04			jr .pastdmark  
2642 ..			.dmark: db "HEP"  
2645				if DEMARK_VERSION = 1  
2645 00					db 0  
2646				endif  
2646				if DEMARK_VERSION = 1  
2646 e1			.pastdmark: pop hl  
2647				endif  
2647				if DEMARK_VERSION = 0  
2647			.pastdmark: pop af  
2647				endif  
2647			endm  
# End of macro DMARK
2647					CALLMONITOR 
2647				if BASE_CPM=1  
2647					call debug_vector  
2647				endif  
2647				if BASE_KEV=1  
2647 cf					rst 8  
2648				endif  
2648				endm  
# End of macro CALLMONITOR
2648				endif 
2648 2a 0a 80			ld hl, (free_list )      
264b 11 0e 80			ld de, heap_start 
264e			 
264e ed 52			sbc hl, de  
2650			 
