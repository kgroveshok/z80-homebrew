0d25			; 
0d25			; Multiply 8-bit value with a 16-bit value (unrolled) 
0d25			; In: Multiply A with DE 
0d25			; Out: HL = result 
0d25			; 
0d25			Mult12U: 
0d25 2e 00		    ld l,0 
0d27 87			    add a,a 
0d28 30 01		    jr nc,Mult12U_NoAdd0 
0d2a 19			    add hl,de 
0d2b			Mult12U_NoAdd0: 
0d2b 29			    add hl,hl 
0d2c 87			    add a,a 
0d2d 30 01		    jr nc,Mult12U_NoAdd1 
0d2f 19			    add hl,de 
0d30			Mult12U_NoAdd1: 
0d30 29			    add hl,hl 
0d31 87			    add a,a 
0d32 30 01		    jr nc,Mult12U_NoAdd2 
0d34 19			    add hl,de 
0d35			Mult12U_NoAdd2: 
0d35 29			    add hl,hl 
0d36 87			    add a,a 
0d37 30 01		    jr nc,Mult12U_NoAdd3 
0d39 19			    add hl,de 
0d3a			Mult12U_NoAdd3: 
0d3a 29			    add hl,hl 
0d3b 87			    add a,a 
0d3c 30 01		    jr nc,Mult12U_NoAdd4 
0d3e 19			    add hl,de 
0d3f			Mult12U_NoAdd4: 
0d3f 29			    add hl,hl 
0d40 87			    add a,a 
0d41 30 01		    jr nc,Mult12U_NoAdd5 
0d43 19			    add hl,de 
0d44			Mult12U_NoAdd5: 
0d44 29			    add hl,hl 
0d45 87			    add a,a 
0d46 30 01		    jr nc,Mult12U_NoAdd6 
0d48 19			    add hl,de 
0d49			Mult12U_NoAdd6: 
0d49 29			    add hl,hl 
0d4a 87			    add a,a 
0d4b d0			    ret nc 
0d4c 19			    add hl,de 
0d4d c9			    ret 
0d4e			 
0d4e			; 
0d4e			; Multiply 8-bit value with a 16-bit value (right rotating) 
0d4e			; In: Multiply A with DE 
0d4e			;      Put lowest value in A for most efficient calculation 
0d4e			; Out: HL = result 
0d4e			; 
0d4e			Mult12R: 
0d4e 21 00 00		    ld hl,0 
0d51			Mult12R_Loop: 
0d51 cb 3f		    srl a 
0d53 30 01		    jr nc,Mult12R_NoAdd 
0d55 19			    add hl,de 
0d56			Mult12R_NoAdd: 
0d56 cb 23		    sla e 
0d58 cb 12		    rl d 
0d5a b7			    or a 
0d5b c2 51 0d		    jp nz,Mult12R_Loop 
0d5e c9			    ret 
