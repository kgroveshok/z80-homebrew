1033 21 fa ff		      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
1036 39			      add   HL, SP 
1037 f9			      ld    SP, HL 
1038 dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
103c dd 39		      add   IX, SP 
103e			 
103e			      ; Setup initial state 
103e 21 04 00		      ld    HL, 4                   ; want must also include space used by block struct 
1041 19			      add   HL, DE 
1042			 
1042 44			      ld    B, H                    ; Move want to BC 
1043 4d			      ld    C, L 
1044			 
1044 21 1c 5c		      ld    HL, free_list           ; Store prev_free ptr to stack 
1047 dd 75 04		      ld    (IX+4), L 
104a dd 74 05		      ld    (IX+5), H 
104d			 
104d 5e			      ld    E, (HL)                 ; Store this_free ptr to stack 
104e 23			      inc   HL 
104f 56			      ld    D, (HL) 
1050 dd 73 02		      ld    (IX+2), E 
1053 dd 72 03		      ld    (IX+3), D 
1056 eb			      ex    DE, HL                  ; this_free ptr into HL 
1057			 
1057					if DEBUG_FORTH_MALLOC 
1057						DMARK "maB" 
1057						CALLMONITOR 
1057					endif 
