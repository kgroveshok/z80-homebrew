452e			    NEXTW 
452e			 
452e			.SPICEH: 
452e				CWHEAD .SPIBOb 61 "SPICEH" 6 WORD_FLAG_CODE 
452e			; | SPICEH ( -- ) Set SPI CE high for the currently selected device |  DONE 
452e			 
452e					call spi_ce_high 
452e			    NEXTW 
452e			 
452e			.SPIBOb: 
452e			 
452e				CWHEAD .SPII 61 "SPIO" 4 WORD_FLAG_CODE 
452e			; | SPIO ( u1 -- ) Send byte u1 to SPI  |  DONE 
452e			 
452e					if DEBUG_FORTH_WORDS_KEY 
452e						DMARK "SPo" 
452e						CALLMONITOR 
452e					endif 
452e					; get port 
452e			 
452e			 
452e					; get byte to send 
452e			 
452e					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
452e			 
452e			;		push hl    ; u1  
452e			 
452e					; destroy value TOS 
452e			 
452e					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
452e			 
452e					; one value on hl get other one back 
452e			 
452e			;		pop hl   ; u2 - addr 
452e			 
452e					; TODO Send SPI byte 
452e			 
452e			;		push hl 
452e			;		call spi_ce_low 
452e			;		pop hl 
452e					ld a, l 
452e					call spi_send_byte 
452e			;		call spi_ce_high 
452e			 
452e					NEXTW 
452e			 
452e			.SPII: 
452e				CWHEAD .SESEL 62 "SPII" 5 WORD_FLAG_CODE 
452e			; | SPII ( -- u1 ) Get a byte from SPI  | DONE 
452e					if DEBUG_FORTH_WORDS_KEY 
452e						DMARK "SPi" 
452e						CALLMONITOR 
452e					endif 
452e			 
452e					; TODO Get SPI byte 
452e			 
452e					call spi_read_byte 
452e			 
452e					if DEBUG_FORTH_WORDS 
452e						DMARK "Si2" 
452e						CALLMONITOR 
452e					endif 
452e					ld h, 0 
452e					ld l, a 
452e					if DEBUG_FORTH_WORDS 
452e						DMARK "Si3" 
452e						CALLMONITOR 
452e					endif 
452e					;call forth_push_numhl 
452e					FORTH_PUSH_VALUEHL 
452e			 
452e					NEXTW 
452e			 
452e			 
452e			 
452e			.SESEL: 
452e				CWHEAD .SESELS 82 "BANK?" 5 WORD_FLAG_CODE 
452e			; | BANK? ( -- u ) Reports on the serial EEPROM Bank Device at bank address u1 1-5.  | DONE 
452e			; | | Zero is disabled storage. 
452e					if DEBUG_FORTH_WORDS_KEY 
452e						DMARK "BN?" 
452e						CALLMONITOR 
452e					endif 
452e					ld a, (spi_device_id) 
452e					sub '0' 
452e					ld h, 0 
452e					ld l, a 
452e					FORTH_PUSH_VALUEHL 
452e					;call forth_push_numhl 
452e					NEXTW 
452e			.SESELS: 
452e				CWHEAD .CARTDEV 82 "BANK" 4 WORD_FLAG_CODE 
452e			; | BANK ( u1 -- ) Select Serial EEPROM Bank Device at bank address u1 1-5 (disables CARTDEV).  | DONE 
452e			; | | Set to zero to disable storage. 
452e					if DEBUG_FORTH_WORDS_KEY 
452e						DMARK "BNK" 
452e						CALLMONITOR 
452e					endif 
452e			 
452e					ld a, 255 
452e					ld (spi_cartdev), a 
452e			 
452e					; get bank 
452e			 
452e					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
452e			 
452e			;		push hl 
452e			 
452e					; destroy value TOS 
452e			 
452e					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
452e			 
452e					; one value on hl get other one back 
452e			 
452e			;		pop hl 
452e			 
452e			 
452e					ld c, SPI_CE_HIGH 
452e					ld b, '0'    ; human readable bank number 
452e			 
452e					ld a, l 
452e			 
452e					if DEBUG_FORTH_WORDS 
452e						DMARK "BNK" 
452e						CALLMONITOR 
452e					endif 
452e			 
452e					; active low 
452e			 
452e			;		cp 0 
452e					or a 
452e					jr z, .bset 
452e					cp 1 
452e					jr nz, .b2 
452e					res 0, c 
452e					ld b, '1'    ; human readable bank number 
452e			.b2:		cp 2 
452e					jr nz, .b3 
452e					res 1, c 
452e					ld b, '2'    ; human readable bank number 
452e			.b3:		cp 3 
452e					jr nz, .b4 
452e					res 2, c 
452e					ld b, '3'    ; human readable bank number 
452e			.b4:		cp 4 
452e					jr nz, .b5 
452e					res 3, c 
452e					ld b, '4'    ; human readable bank number 
452e			.b5:		cp 5 
452e					jr nz, .bset 
452e					res 4, c 
452e					ld b, '5'    ; human readable bank number 
452e			 
452e			.bset: 
452e					ld a, c 
452e					ld (spi_device),a 
452e					ld a, b 
452e					ld (spi_device_id),a 
452e					if DEBUG_FORTH_WORDS 
452e						DMARK "BN2" 
452e						CALLMONITOR 
452e					endif 
452e			 
452e					; set default SPI clk pulse time as disabled for BANK use 
452e			 
452e					ld a, 0 
452e					ld (spi_clktime), a 
452e			 
452e					NEXTW 
452e			 
452e			.CARTDEV: 
452e				CWHEAD .ENDDEVICE 82 "CARTDEV" 7 WORD_FLAG_CODE 
452e			; | CARTDEV ( u1 -- ) Select cart device 1-8 (Disables BANK). | DONE 
452e			; | | Set to zero to disable devices. 
452e					if DEBUG_FORTH_WORDS_KEY 
452e						DMARK "CDV" 
452e						CALLMONITOR 
452e					endif 
452e			 
452e					; disable se storage bank selection 
452e			 
452e					ld a, SPI_CE_HIGH		; ce high 
452e					ld (spi_device), a 
452e			 
452e					; get bank 
452e			 
452e					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
452e			 
452e			;		push hl 
452e			 
452e					; destroy value TOS 
452e			 
452e					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
452e			 
452e					; one value on hl get other one back 
452e			 
452e			;		pop hl 
452e			 
452e					; active low 
452e			 
452e					ld c, 255 
452e			 
452e					ld a, l 
452e					if DEBUG_FORTH_WORDS 
452e						DMARK "CDV" 
452e						CALLMONITOR 
452e					endif 
452e			;		cp 0 
452e					or a 
452e					jr z, .cset 
452e					cp 1 
452e					jr nz, .c2 
452e					res 0, c 
452e			.c2:		cp 2 
452e					jr nz, .c3 
452e					res 1, c 
452e			.c3:		cp 3 
452e					jr nz, .c4 
452e					res 2, c 
452e			.c4:		cp 4 
452e					jr nz, .c5 
452e					res 3, c 
452e			.c5:		cp 5 
452e					jr nz, .c6 
452e					res 4, c 
452e			.c6:		cp 6 
452e					jr nz, .c7 
452e					res 5, c 
452e			.c7:		cp 7 
452e					jr nz, .c8 
452e					res 6, c 
452e			.c8:		cp 8 
452e					jr nz, .cset 
452e					res 7, c 
452e			.cset:		ld a, c 
452e					ld (spi_cartdev),a 
452e			 
452e					if DEBUG_FORTH_WORDS 
452e						DMARK "CD2" 
452e						CALLMONITOR 
452e					endif 
452e			 
452e					; set default SPI clk pulse time as 10ms for CARTDEV use 
452e			 
452e					ld a, $0a 
452e					ld (spi_clktime), a 
452e					NEXTW 
452e			endif 
452e			 
452e			.ENDDEVICE: 
452e			; eof 
