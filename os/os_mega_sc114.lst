8aad			; 
8aad			; Multiply 8-bit values 
8aad			; In:  Multiply H with E 
8aad			; Out: HL = result 
8aad			; 
8aad			Mult8: 
8aad 16 00		    ld d,0 
8aaf 6a			    ld l,d 
8ab0 06 08		    ld b,8 
8ab2			Mult8_Loop: 
8ab2 29			    add hl,hl 
8ab3 30 01		    jr nc,Mult8_NoAdd 
8ab5 19			    add hl,de 
8ab6			Mult8_NoAdd: 
8ab6 10 fa		    djnz Mult8_Loop 
