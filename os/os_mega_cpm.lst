5acf						CALLMONITOR 
5acf					endif 
5acf					call storage_read 
5acf			 
5acf					if DEBUG_FORTH_WORDS 
5acf						DMARK "ASr" 
5acf						CALLMONITOR 
5acf					endif 
5acf			 
5acf					call ishlzero 
5acf					ret z             ; file not found 
5acf			 
5acf					ld a, display_row_2 + 10 
5acf					ld de, store_page+3 
5acf					call str_at_display 
