8a99			;HL_Div_C: 
8a99			;Inputs: 
8a99			;     HL is the numerator 
8a99			;     C is the denominator 
8a99			;Outputs: 
8a99			;     A is the remainder 
8a99			;     B is 0 
8a99			;     C is not changed 
8a99			;     DE is not changed 
8a99			;     HL is the quotient 
8a99			; 
8a99			;       ld b,16 
8a99			;       xor a 
8a99			;         add hl,hl 
8a99			;         rla 
8a99			;         cp c 
8a99			;         jr c,$+4 
8a99			;           inc l 
8a99			;           sub c 
8a99			;         djnz $-7 
