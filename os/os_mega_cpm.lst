44cb			.SESEL: 
44cb				CWHEAD .SESELS 82 "BANK?" 5 WORD_FLAG_CODE 
44cb			; | BANK? ( -- u ) Reports on the serial EEPROM Bank Device at bank address u1 1-5.  | DONE 
44cb			; | | Zero is disabled storage. 
44cb					if DEBUG_FORTH_WORDS_KEY 
44cb						DMARK "BN?" 
44cb						CALLMONITOR 
44cb					endif 
44cb					ld a, (spi_device_id) 
44cb					sub '0' 
44cb					ld h, 0 
44cb					ld l, a 
44cb					FORTH_PUSH_VALUEHL 
44cb					;call forth_push_numhl 
44cb					NEXTW 
44cb			.SESELS: 
44cb				CWHEAD .CARTDEV 82 "BANK" 4 WORD_FLAG_CODE 
44cb			; | BANK ( u1 -- ) Select Serial EEPROM Bank Device at bank address u1 1-5 (disables CARTDEV).  | DONE 
44cb			; | | Set to zero to disable storage. 
44cb					if DEBUG_FORTH_WORDS_KEY 
44cb						DMARK "BNK" 
44cb						CALLMONITOR 
44cb					endif 
44cb			 
44cb					ld a, 255 
44cb					ld (spi_cartdev), a 
44cb			 
44cb					; get bank 
44cb			 
44cb					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
44cb			 
44cb			;		push hl 
44cb			 
44cb					; destroy value TOS 
44cb			 
44cb					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
44cb			 
44cb					; one value on hl get other one back 
44cb			 
44cb			;		pop hl 
44cb			 
44cb			 
44cb					ld c, SPI_CE_HIGH 
44cb					ld b, '0'    ; human readable bank number 
44cb			 
44cb					ld a, l 
44cb			 
44cb					if DEBUG_FORTH_WORDS 
44cb						DMARK "BNK" 
44cb						CALLMONITOR 
44cb					endif 
44cb			 
44cb					; active low 
44cb			 
44cb			;		cp 0 
44cb					or a 
44cb					jr z, .bset 
44cb					cp 1 
44cb					jr nz, .b2 
44cb					res 0, c 
44cb					ld b, '1'    ; human readable bank number 
44cb			.b2:		cp 2 
44cb					jr nz, .b3 
44cb					res 1, c 
44cb					ld b, '2'    ; human readable bank number 
44cb			.b3:		cp 3 
44cb					jr nz, .b4 
44cb					res 2, c 
44cb					ld b, '3'    ; human readable bank number 
44cb			.b4:		cp 4 
44cb					jr nz, .b5 
44cb					res 3, c 
44cb					ld b, '4'    ; human readable bank number 
44cb			.b5:		cp 5 
44cb					jr nz, .bset 
44cb					res 4, c 
44cb					ld b, '5'    ; human readable bank number 
44cb			 
44cb			.bset: 
44cb					ld a, c 
44cb					ld (spi_device),a 
44cb					ld a, b 
44cb					ld (spi_device_id),a 
44cb					if DEBUG_FORTH_WORDS 
44cb						DMARK "BN2" 
44cb						CALLMONITOR 
44cb					endif 
44cb			 
44cb					; set default SPI clk pulse time as disabled for BANK use 
44cb			 
44cb					ld a, 0 
44cb					ld (spi_clktime), a 
44cb			 
44cb					NEXTW 
44cb			 
44cb			.CARTDEV: 
44cb				CWHEAD .ENDDEVICE 82 "CARTDEV" 7 WORD_FLAG_CODE 
44cb			; | CARTDEV ( u1 -- ) Select cart device 1-8 (Disables BANK). | DONE 
44cb			; | | Set to zero to disable devices. 
44cb					if DEBUG_FORTH_WORDS_KEY 
44cb						DMARK "CDV" 
44cb						CALLMONITOR 
44cb					endif 
44cb			 
44cb					; disable se storage bank selection 
44cb			 
44cb					ld a, SPI_CE_HIGH		; ce high 
44cb					ld (spi_device), a 
44cb			 
44cb					; get bank 
44cb			 
44cb					FORTH_DSP_VALUEHL     			; TODO skip type check and assume number.... lol 
44cb			 
44cb			;		push hl 
44cb			 
44cb					; destroy value TOS 
44cb			 
44cb					FORTH_DSP_POP  ; TODO add stock underflow checks and throws  
44cb			 
44cb					; one value on hl get other one back 
44cb			 
44cb			;		pop hl 
44cb			 
44cb					; active low 
44cb			 
44cb					ld c, 255 
44cb			 
44cb					ld a, l 
44cb					if DEBUG_FORTH_WORDS 
44cb						DMARK "CDV" 
44cb						CALLMONITOR 
44cb					endif 
44cb			;		cp 0 
44cb					or a 
44cb					jr z, .cset 
44cb					cp 1 
44cb					jr nz, .c2 
