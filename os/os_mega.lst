6994			; **********************************************************************  
6994			; **  Alphanumeric LCD example                  by Stephen C Cousins  **  
6994			; **********************************************************************  
6994			;  
6994			; **  Written as a Small Computer Monitor App  
6994			; **  www.scc.me.uk  
6994			;  
6994			; History  
6994			; 2018-05-20  v0.2.0  SCC  Example for LiNC80 SBC1 only  
6994			; 2018-06-28  v0.3.0  SCC  Added support for RC2014 and Z280RC  
6994			; 2019-09-14  v0.4.0  SCC  Added support for SC129 digital I/O module  
6994			;  
6994			; **********************************************************************  
6994			;  
6994			; This program is an example of one of the methods of interfacing an   
6994			; alphanumeric LCD module.   
6994			;  
6994			; In this example the display is connected to either a Z80 PIO or a   
6994			; simple 8-bit output port.   
6994			;  
6994			; This interfacing method uses 4-bit data mode and uses time delays  
6994			; rather than polling the display's ready status. As a result the   
6994			; interface only requires 6 simple output lines:  
6994			;   Output bit 0 = not used  
6994			;   Output bit 1 = not used  
6994			;   Output bit 2 = RS         High = data, Low = instruction  
6994			;   Output bit 3 = E          Active high  
6994			;   Output bit 4 = DB4  
6994			;   Output bit 5 = DB5  
6994			;   Output bit 6 = DB6  
6994			;   Output bit 7 = DB7  
6994			; Display's R/W is connected to 0v so it is always in write mode  
6994			;  
6994			; This set up should work with any system supporting the RC2014 bus  
6994			  
6994			; To set up PIO port A in mode 3 (control) using LiNC80 as example  
6994			;   I/O address 0x1A = 0b11001111 (0xCF)   Select mode 3 (control)  
6994			;   I/O address 0x1A = 0b00000000 (0x00)   All pins are output  
6994			;  
6994			; **********************************************************************  
6994			  
6994			; Additonal for 4x40. E1 and E2 instead of just E   
6994			; TODO swipe vidout signal on port a to activate E2  
6994			  
6994			; **********************************************************************  
6994			; **  Constants  
6994			; **********************************************************************  
6994			; LCD constants required by LCD support module  
6994			kLCDPrt:    EQU kDataReg       ;LCD port is the PIO port A data reg  
6994			kLCDBitRS:  EQU 2              ;Port bit for LCD RS signal  
6994			kLCDBitE:   EQU 3              ;Port bit for LCD E signal             
6994			kLCDBitE2:   EQU 0              ;Port bit for LCD E2 signal            VICLK  
6994			kLCDBitLED:   EQU 1              ;Port bit for LCD E2 signal            VIDDO  
6994			; TODO Decide which E is being set  
6994			kLCDWidth:  EQU display_cols             ;Width in characters  
6994			  
6994			; **********************************************************************  
6994			; **  Code library usage  
6994			; **********************************************************************  
6994			  
6994			; send character to current cursor position  
6994			; wraps and/or scrolls screen automatically  
6994			  
6994			  
6994			  
6994			lcd_init:  
6994			  
6994			; SCMonAPI functions used  
6994			  
6994			; Alphanumeric LCD functions used  
6994			; no need to specify specific functions for this module  
6994			  
6994 3e cf		            LD   A, 11001111b  
6996 d3 c2		            OUT  (kContReg), A  ;Port A = PIO 'control' mode  
6998 3e 00		            LD   A, 00000000b  
699a d3 c2		            OUT  (kContReg),A   ;Port A = all lines are outputs  
699c			  
699c			; Initialise alphanumeric LCD module  
699c 3e 00				ld a, 0  
699e 32 fb fa				ld (display_lcde1e2), a  
69a1 cd 22 6a		            CALL fLCD_Init      ;Initialise LCD module  
69a4 3e 01				ld a, 1  
69a6 32 fb fa				ld (display_lcde1e2), a  
69a9 cd 22 6a		            CALL fLCD_Init      ;Initialise LCD module  
69ac			  
69ac c9				ret  
69ad			  
69ad			;  
69ad			;;  
69ad			; lcd functions  
69ad			;  
69ad			;  
69ad			  
69ad			; what is at cursor position   
69ad			  
69ad			;get_cursor:	ld de, (cursor_row)   ;  row + col  
