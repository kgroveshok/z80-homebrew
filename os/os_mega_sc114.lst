9e9f			; op_code, len, word, next 
9e9f			;    word: 
9e9f			;    db op_code 
9e9f			;    ds word zero term 
9e9f			;    dw next 
9e9f			;    endm 
9e9f			 
9e9f			 
9e9f			 
9e9f			 
