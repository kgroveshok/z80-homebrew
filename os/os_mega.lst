6aa9			; Position cursor to specified location  
6aa9			;   On entry: A = Cursor position  
6aa9			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6aa9 f5			fLCD_Pos:   PUSH AF  
6aaa					; at this point set the E1 or E2 flag depending on position  
6aaa			  
6aaa c5					push bc  
6aab			;		push af  
6aab 06 00				ld b, 0  
6aad 4f					ld c, a  
6aae 3e 4f				ld a, kLCD_Line3-1  
6ab0 b7			 		or a      ;clear carry flag  
6ab1 99					sbc a,c    ; TODO may need to sub 80 from a to put in context of current frame    
6ab2 38 04				jr c, .pe1  
6ab4			  
6ab4					; E selection  
6ab4 cb 80				res 0, b         ; bit 0 unset e  
6ab6			;		pop af    ; before line 3 so recover orig pos  
6ab6			;		ld c, a    ; save for poking back  
6ab6 18 06				jr .peset	          
6ab8			.pe1:          	; E2 selection  
6ab8 cb c0				set 0, b         ; bit 0 set e1  
6aba 79					ld a, c  
6abb de 4f				sbc a, kLCD_Line3-1  
6abd 4f					ld c, a	         ; save caculated offset  
6abe			;		pop af     ; bin this original value now we have calculated form  
6abe			  
6abe			.peset:		; set bit  
6abe 78					ld a, b  
6abf 32 fb fa				ld (display_lcde1e2), a 	  
6ac2 79					ld a, c  
6ac3 c1					pop bc  
6ac4			  
6ac4 f6 80		            OR   kLCD_Pos       ;Prepare position cursor instruction  
6ac6 cd 19 6a		            CALL fLCD_Inst      ;Write instruction to LCD  
6ac9 f1			            POP  AF  
6aca c9			            RET  
6acb			  
6acb			  
6acb			; Output text string to LCD  
6acb			;   On entry: DE = Pointer to null terminated text string  
6acb			;   On exit:  BC HL IX IY I AF' BC' DE' HL' preserved  
6acb 1a			fLCD_Str:   LD   A, (DE)        ;Get character from string  
6acc b7			            OR   A              ;Null terminator?  
6acd c8			            RET  Z              ;Yes, so finished  
6ace cd 5b 6a		            CALL fLCD_Data      ;Write character to display  
6ad1 13			            INC  DE             ;Point to next character  
6ad2 18 f7		            JR   fLCD_Str       ;Repeat  
6ad4 c9					ret  
6ad5			  
6ad5			; Define custom character  
6ad5			;   On entry: A = Character number (0 to 7)  
6ad5			;             DE = Pointer to character bitmap data  
6ad5			;   On exit:  A = Next character number  
6ad5			;             DE = Next location following bitmap  
6ad5			;             BC HL IX IY I AF' BC' DE' HL' preserved  
6ad5			; Character is   
6ad5 c5			fLCD_Def:   PUSH BC  
6ad6 f5			            PUSH AF  
6ad7 07			            RLCA                ;Calculate location  
6ad8 07			            RLCA                ;  for bitmap data  
6ad9 07			            RLCA                ;  = 8 x CharacterNumber  
6ada f6 40		            OR   kLCD_Def       ;Prepare define character instruction  
6adc cd 19 6a		            CALL fLCD_Inst      ;Write instruction to LCD  
6adf 06 00		            LD   B, 0  
6ae1 1a			Loop:      LD   A, (DE)        ;Get byte from bitmap  
6ae2 cd 5b 6a		            CALL fLCD_Data      ;Write byte to display  
6ae5 13			            INC  DE             ;Point to next byte  
6ae6 04			            INC  B              ;Count bytes  
6ae7 cb 58		            BIT  3, B           ;Finish all 8 bytes?  
6ae9 28 f6		            JR   Z, Loop       ;No, so repeat  
6aeb f1			            POP  AF  
6aec 3c			            INC  A              ;Increment character number  
6aed c1			            POP  BC  
6aee c9			            RET  
6aef			  
