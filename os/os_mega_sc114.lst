a887					ld a, (.dmark+2)  
a887					ld (debug_mark+2),a  
a887				endif  
a887 18 04			jr .pastdmark  
a889 ..			.dmark: db "SCR"  
a88c				if DEMARK_VERSION = 1  
a88c 00					db 0  
a88d				endif  
