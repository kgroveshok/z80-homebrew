1005			malloc_guard_entry: 
1005				push hl 
1005				push de 
1005				push af 
1005			 
1005			 	or a      ;clear carry flag 
1005				push hl 
1005				ld de, 255 
1005				sbc hl, de 
1005				jr c, .lowalloc 
1005			 
1005				push de 
1005					ld hl, display_fb0 
1005					ld (display_fb_active), hl 
1005				call clear_display 
1005				ld a, 0 
1005				ld de, .mallocsize 
1005				call str_at_display 
1005				call update_display 
1005				call delay1s 
1005				call delay1s 
1005			;	ld a, 0 
1005			;	ld (os_view_disable), a 
1005				call bp_on 
1005			 
1005				pop de 
1005				pop hl 
1005			 
1005				 
1005			 
1005				CALLMONITOR 
1005				jr .lowdone 
1005			.lowalloc: 
1005			 
1005			 
1005				pop hl 
1005			.lowdone:	pop af 
1005				pop de 
1005				pop hl 
1005			ret 
1005			 
1005			malloc_guard_exit: 
1005				push hl 
1005				push de 
1005				push af 
1005			 
1005			 	or a      ;clear carry flag 
1005				push hl 
1005				ld de, 255 
1005				sbc hl, de 
1005				jr c, .lowallocx 
1005			 
1005				push de 
1005					ld hl, display_fb0 
1005					ld (display_fb_active), hl 
1005				call clear_display 
1005				ld a, 0 
1005				ld de, .mallocasize 
1005				call str_at_display 
1005				call update_display 
1005				call delay1s 
1005				call delay1s 
1005			;	ld a, 0 
1005			;	ld (os_view_disable), a 
1005				call bp_on 
1005				pop de 
1005				pop hl 
1005			 
1005				CALLMONITOR 
1005				jr .lowdonex 
1005			.lowallocx: 
1005			 
1005				pop hl 
1005			.lowdonex:	pop af 
1005				pop de 
1005				pop hl 
1005			ret 
