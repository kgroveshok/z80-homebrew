24c9			;WORD_SYS_LOWPRIM: equ 4    ; Offset for low level prim words opcode 
24c9			;WORD_SYS_BRANCH: equ 10    ; Offset for branching and loop words opcode 
24c9			WORD_SYS_UWORD: equ 1   ; Opcode for all user words 
24c9			WORD_SYS_DELETED: equ 3 ; Op code for a deleted UWORD 
24c9			WORD_SYS_ROOT: equ 0   ; Opcode for all user words 
24c9			WORD_SYS_END: equ 0   ; Opcode for all user words 
24c9			WORD_SYS_CORE: equ 20    ; Offset for dict core words opcode 
24c9			WORD_FLAG_CODE: equ 0	   ; opcodeflag to exec pure code for this word 
24c9			WORD_FLAG_JP: equ 1	   ; opcodeflag to list zero term jump table words 
24c9			 
24c9			; Core word preamble macro 
24c9			 
24c9			CWHEAD:   macro nxtword opcode lit len opflags 
24c9				db WORD_SYS_CORE+opcode             
24c9				; internal op code number 
24c9				dw nxtword            
24c9				; link to next dict word block 
24c9				db len + 1 
24c9				; literal length of dict word inc zero term 
24c9				db lit,0              
24c9				; literal dict word 
24c9			        ; TODO db opflags        
24c9				endm 
