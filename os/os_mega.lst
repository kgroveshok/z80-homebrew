101c			;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; 
101c			;; 	ASCII char code for 0-9,A-F in A to single hex digit 
101c			;;    subtract $30, if result > 9 then subtract $7 more 
101c			;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; 
101c			atohex: 
101c d6 30				SUB $30 
101e fe 0a				CP 10 
1020 f8					RET M		; If result negative it was 0-9 so we're done 
1021 d6 07				SUB $7		; otherwise, subtract $7 more to get to $0A-$0F 
1023 c9					RET		 
