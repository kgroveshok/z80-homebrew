1149			 
1149 dd 5e 00		      ld    E, (IX+0)               ; Load addr of next free block into DE 
114c dd 56 01		      ld    D, (IX+1) 
114f			 
114f b7			      or    A                       ; Clear the carry flag 
1150 ed 52		      sbc   HL, DE                  ; Subtract addrs to compare adjacency 
1152 20 22		      jr    NZ, free_check_adjacent_to_prev 
1154			 
