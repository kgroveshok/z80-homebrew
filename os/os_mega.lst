68a4			 
68a4			include "forth_startup.asm" 
68a4			; Which startup method to use? 
68a4			; 
68a4			; version 1 - allows for a single stored file to be selected to run at start up (if se storage is enabled) 
68a4			; followed by loading of a list of scripts in eeprom 
68a4			 
68a4			; version 2 - if se storage is enabled then auto load all files which begin with a '*' else use loading 
68a4			; from eeprom 
68a4			 
68a4			; Select with define in main stubs 
68a4			 
68a4			if STARTUP_V1 
68a4				include "forth_startupv1.asm" 
68a4			endif 
68a4			if STARTUP_V2 
68a4				include "forth_startupv2.asm" 
68a4			; Version 2 of the startup  
68a4			;  
68a4			; Auto load any files in bank 1 that start with a '*' 
68a4			; If no se storage then revert to using eprom 
68a4			 
68a4			 
68a4			if STORAGE_SE = 0 
68a4			 
68a4			sprompt1: db "Startup load...",0 
68a4			sprompt2: db "Run? 1=No *=End #=All",0 
68a4			 
68a4			 
68a4			 
68a4			 
68a4			forth_startup: 
68a4				ld hl, startcmds 
68a4				ld a, 0 
68a4				ld (os_last_cmd), a    ; tmp var to skip prompts if doing all 
68a4			 
68a4			.start1:	push hl 
68a4				call clear_display 
68a4				ld de, sprompt1 
68a4			        ld a, display_row_1 
68a4				call str_at_display 
68a4				ld de, sprompt2 
68a4			        ld a, display_row_2 
68a4				call str_at_display 
68a4				pop hl 
68a4				push hl 
68a4				ld e,(hl) 
68a4				inc hl 
68a4				ld d,(hl) 
68a4			        ld a, display_row_3 
68a4				call str_at_display 
68a4				call update_display 
68a4			 
68a4			 
68a4				ld a, (os_last_cmd) 
68a4			;	cp 0 
68a4				or a 
68a4				jr z, .startprompt 
68a4				call delay250ms 
68a4				jr .startdo 
68a4				 
68a4				 
68a4			 
68a4			.startprompt: 
68a4			 
68a4				ld a,display_row_4 + display_cols - 1 
68a4			        ld de, endprg 
