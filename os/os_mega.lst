53b6					push af  
53b6					ld a, (.dmark)  
53b6					ld (debug_mark),a  
53b6					ld a, (.dmark+1)  
53b6					ld (debug_mark+1),a  
53b6					ld a, (.dmark+2)  
53b6					ld (debug_mark+2),a  
53b6				endif  
53b6 18 04			jr .pastdmark  
53b8 ..			.dmark: db "VAR"  
53bb				if DEMARK_VERSION = 1  
53bb 00					db 0  
53bc				endif  
53bc				if DEMARK_VERSION = 1  
53bc e1			.pastdmark: pop hl  
53bd				endif  
53bd				if DEMARK_VERSION = 0  
53bd			.pastdmark: pop af  
53bd				endif  
53bd			endm  
# End of macro DMARK
53bd						CALLMONITOR 
53bd				if BASE_CPM=1  
53bd					call debug_vector  
53bd				endif  
