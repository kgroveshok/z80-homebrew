0de8			;HL_Div_C: 
0de8			;Inputs: 
0de8			;     HL is the numerator 
0de8			;     C is the denominator 
0de8			;Outputs: 
0de8			;     A is the remainder 
0de8			;     B is 0 
0de8			;     C is not changed 
0de8			;     DE is not changed 
0de8			;     HL is the quotient 
0de8			; 
0de8			;       ld b,16 
0de8			;       xor a 
0de8			;         add hl,hl 
0de8			;         rla 
0de8			;         cp c 
0de8			;         jr c,$+4 
0de8			;           inc l 
0de8			;           sub c 
0de8			;         djnz $-7 
