89b2			; https://map.grauw.nl/articles/mult_div_shifts.php 
89b2			; Divide 16-bit values (with 16-bit result) 
89b2			; In: Divide BC by divider DE 
89b2			; Out: BC = result, HL = rest 
89b2			; 
89b2			Div16: 
89b2 21 00 00		    ld hl,0 
89b5 78			    ld a,b 
89b6 06 08		    ld b,8 
89b8			Div16_Loop1: 
89b8 17			    rla 
89b9 ed 6a		    adc hl,hl 
89bb ed 52		    sbc hl,de 
89bd 30 01		    jr nc,Div16_NoAdd1 
89bf 19			    add hl,de 
89c0			Div16_NoAdd1: 
89c0 10 f6		    djnz Div16_Loop1 
89c2 17			    rla 
89c3 2f			    cpl 
89c4 47			    ld b,a 
89c5 79			    ld a,c 
89c6 48			    ld c,b 
89c7 06 08		    ld b,8 
89c9			Div16_Loop2: 
89c9 17			    rla 
89ca ed 6a		    adc hl,hl 
89cc ed 52		    sbc hl,de 
89ce 30 01		    jr nc,Div16_NoAdd2 
89d0 19			    add hl,de 
89d1			Div16_NoAdd2: 
89d1 10 f6		    djnz Div16_Loop2 
89d3 17			    rla 
89d4 2f			    cpl 
89d5 41			    ld b,c 
89d6 4f			    ld c,a 
89d7 c9			ret 
