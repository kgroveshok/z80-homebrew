0fd6			; 
0fd6			; Get a word (16 bit) in hexadecimal notation. The result is returned in HL. 
0fd6			; Since the routines get_byte and therefore get_nibble are called, only valid 
0fd6			; characters (0-9a-f) are accepted. 
0fd6			; 
0fd6			;get_word        push    af 
0fd6			;                call    get_byte        ; Get the upper byte 
0fd6			;                ld      h, a 
0fd6			;                call    get_byte        ; Get the lower byte 
0fd6			;                ld      l, a 
0fd6			;                pop     af 
0fd6			;                ret 
0fd6			; 
0fd6			; Get a byte in hexadecimal notation. The result is returned in A. Since 
0fd6			; the routine get_nibble is used only valid characters are accepted - the  
0fd6			; input routine only accepts characters 0-9a-f. 
0fd6			; 
0fd6 c5			get_byte:        push    bc              ; Save contents of B (and C) 
0fd7 7e					ld a,(hl) 
0fd8 23					inc hl 
0fd9 cd fe 0f		                call    nibble2val      ; Get upper nibble 
0fdc cb 07		                rlc     a 
0fde cb 07		                rlc     a 
0fe0 cb 07		                rlc     a 
0fe2 cb 07		                rlc     a 
0fe4 47			                ld      b, a            ; Save upper four bits 
0fe5 7e					ld a,(hl) 
0fe6 cd fe 0f		                call    nibble2val      ; Get lower nibble 
0fe9 b0			                or      b               ; Combine both nibbles 
0fea c1			                pop     bc              ; Restore B (and C) 
0feb c9			                ret 
