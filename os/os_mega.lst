68a5			; handle the auto run of code from files in storage 
68a5			 
68a5			 
68a5			include "forth_startup.asm" 
68a5			; Which startup method to use? 
68a5			; 
68a5			; version 1 - allows for a single stored file to be selected to run at start up (if se storage is enabled) 
68a5			; followed by loading of a list of scripts in eeprom 
68a5			 
68a5			; version 2 - if se storage is enabled then auto load all files which begin with a '*' else use loading 
68a5			; from eeprom 
68a5			 
68a5			; Select with define in main stubs 
68a5			 
68a5			if STARTUP_V1 
68a5				include "forth_startupv1.asm" 
68a5			endif 
68a5			if STARTUP_V2 
68a5				include "forth_startupv2.asm" 
68a5			; Version 2 of the startup  
68a5			;  
68a5			; Auto load any files in bank 1 that start with a '*' 
68a5			; If no se storage then revert to using eprom 
68a5			 
68a5			 
68a5			if STORAGE_SE = 0 
68a5			 
68a5			sprompt1: db "Startup load...",0 
68a5			sprompt2: db "Run? 1=No *=End #=All",0 
68a5			 
68a5			 
68a5			 
68a5			 
68a5			forth_startup: 
68a5				ld hl, startcmds 
68a5				ld a, 0 
68a5				ld (os_last_cmd), a    ; tmp var to skip prompts if doing all 
68a5			 
68a5			.start1:	push hl 
68a5				call clear_display 
68a5				ld de, sprompt1 
68a5			        ld a, display_row_1 
68a5				call str_at_display 
68a5				ld de, sprompt2 
68a5			        ld a, display_row_2 
68a5				call str_at_display 
68a5				pop hl 
68a5				push hl 
68a5				ld e,(hl) 
68a5				inc hl 
68a5				ld d,(hl) 
68a5			        ld a, display_row_3 
68a5				call str_at_display 
68a5				call update_display 
68a5			 
68a5			 
68a5				ld a, (os_last_cmd) 
68a5			;	cp 0 
68a5				or a 
68a5				jr z, .startprompt 
68a5				call delay250ms 
68a5				jr .startdo 
68a5				 
68a5				 
68a5			 
68a5			.startprompt: 
68a5			 
68a5				ld a,display_row_4 + display_cols - 1 
68a5			        ld de, endprg 
68a5				call str_at_display 
68a5				call update_display 
68a5				call delay1s 
68a5				call cin_wait 
68a5						 
68a5				cp '*' 
68a5				jr z, .startupend1 
68a5				cp '#' 
68a5				jr nz, .startno 
68a5				ld a, 1 
68a5				ld (os_last_cmd),a 
68a5				jr .startdo 
68a5			.startno:	cp '1' 
68a5				jr z,.startnxt  
68a5			 
68a5				; exec startup line 
68a5			.startdo:	 
68a5				pop hl 
68a5				push hl 
68a5				 
68a5				ld e,(hl) 
68a5				inc hl 
68a5				ld d,(hl) 
68a5				ex de,hl 
68a5			 
68a5				push hl 
68a5			 
68a5				ld a, 0 
68a5				;ld a, FORTH_END_BUFFER 
68a5				call strlent 
68a5				inc hl   ; include zero term to copy 
68a5				ld b,0 
68a5				ld c,l 
68a5				pop hl 
68a5				ld de, scratch 
68a5				ldir 
68a5			 
68a5			 
68a5				ld hl, scratch 
68a5				call forthparse 
68a5				call forthexec 
68a5				call forthexec_cleanup 
68a5			 
68a5				ld a, display_row_4 
68a5				ld de, endprog 
68a5			 
68a5				call update_display		 
68a5			 
68a5				ld a, (os_last_cmd) 
68a5			;	cp 0 
68a5				or a 
68a5				jr nz, .startnxt 
68a5				call next_page_prompt 
68a5			        call clear_display 
68a5				call update_display		 
68a5			 
68a5				; move onto next startup line? 
68a5			.startnxt: 
68a5			 
68a5				call delay250ms 
68a5				pop hl 
68a5			 
68a5				inc hl 
68a5				inc hl 
68a5			 
68a5				push hl 
68a5				ld e, (hl) 
68a5				inc hl 
68a5				ld d, (hl) 
68a5				pop hl 
