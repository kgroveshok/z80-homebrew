57da			 
57da			;	ld (chk_stund), hl	; stack points.... 
57da 22 00 ef			ld (chk_stovr), hl 
57dd 22 c6 e9			ld (chk_ret_und), hl 
57e0 22 84 e9			ld (chk_ret_ovr), hl 
57e3 22 02 e9			ld (chk_loop_ovr), hl 
57e6 22 00 e8			ld (chk_data_ovr), hl 
57e9 c9				ret 
