0d84			;HL_Div_C: 
0d84			;Inputs: 
0d84			;     HL is the numerator 
0d84			;     C is the denominator 
0d84			;Outputs: 
0d84			;     A is the remainder 
0d84			;     B is 0 
0d84			;     C is not changed 
0d84			;     DE is not changed 
0d84			;     HL is the quotient 
0d84			; 
0d84			;       ld b,16 
0d84			;       xor a 
0d84			;         add hl,hl 
0d84			;         rla 
0d84			;         cp c 
0d84			;         jr c,$+4 
0d84			;           inc l 
0d84			;           sub c 
0d84			;         djnz $-7 
