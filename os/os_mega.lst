0b84			; Display a menu and allow item selection (optional toggle items) 
0b84			; 
0b84			; format: 
0b84			; hl pointer to word array with zero term for items 
0b84			; e.g.    db item1 
0b84			;         db .... 
0b84			;         db 0 
0b84			; 
0b84			; a = starting menu item  
0b84			; 
0b84			; de = pointer item toggle array   (todo) 
0b84			; 
0b84			; returns item selected in a 1-... 
0b84			; returns 0 if back button pressed 
0b84			; 
0b84			; NOTE: Uses system frame buffer to display 
0b84			; 
0b84			; LEFT, Q = go back 
0b84			; RIGHT, SPACE, CR = select 
0b84			; UP, A - Up 
0b84			; DOWN, Z - Down 
0b84			 
0b84			 
0b84			MENU_ARRAY_PTR: equ store_tmp1 
0b84			MENU_CUR_ITEM: equ store_tmp2 
0b84			MENU_ITEM_CT: equ store_tmp2+1 
