6b31			  
6b31			; Write function to LCD  
6b31			;   On entry: A = Function byte to be written  
6b31			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6b31 3e 20		WrFn4bit:   LD   A, 00100000b  ;4-bit mode  
6b33 18 02		            JR   WrFunc  
6b35 3e 30		WrFn8bit:   LD   A, 00110000b  ;8-bit mode  
6b37 f5			WrFunc:     PUSH AF  
6b38 f5					push af  
6b39 3a fb fa				ld a, (display_lcde1e2)  
6b3c fe 00				cp 0     ; e1  
6b3e 20 0f				jr nz, .wfea2	  
6b40 f1					pop af  
6b41 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b43 cb df		            SET  kLCDBitE, A     ; TODO Decide which E is being set  
6b45 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6b47 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b49 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6b4b d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b4d 18 0d			jr .wfskip  
6b4f f1			.wfea2:		pop af  
6b50 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b52 cb c7		            SET  kLCDBitE2, A     ; TODO Decide which E is being set  
6b54 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6b56 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b58 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6b5a d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b5c 3e 05		.wfskip:            LD  A, 5  
6b5e cd 65 6b		            CALL LCDDelay       ;Delay 5 ms to complete  
6b61 f1			            POP  AF  
6b62 c9			            RET  
6b63			  
6b63			  
6b63			; Delay in milliseconds  
6b63			;   On entry: A = Number of milliseconds delay  
6b63			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6b63 3e 01		LCDDelay1:  LD   A, 1           ;Delay by 1 ms  
6b65 d5			LCDDelay:   PUSH DE  
6b66 5f			            LD   E, A           ;Delay by 'A' ms  
6b67 16 00		            LD   D, 0  
6b69 cd 62 0a		            CALL aDelayInMS  
6b6c d1			            POP  DE  
