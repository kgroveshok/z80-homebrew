8e55			StrictStrCmp: 
8e55				; Load next chars of each string 
8e55 1a				ld a, (de) 
8e56 47				ld b, a 
8e57 7e				ld a, (hl) 
8e58				; Compare 
8e58 b8				cp b 
8e59				; Return non-zero if chars don't match 
8e59 c0				ret nz 
8e5a				; Check for end of both strings 
8e5a fe 00			cp "\0" 
8e5c				; Return if strings have ended 
8e5c c8				ret z 
8e5d				; Otherwise, advance to next chars 
8e5d 23				inc hl 
8e5e 13				inc de 
8e5f 18 f4			jr StrictStrCmp 
