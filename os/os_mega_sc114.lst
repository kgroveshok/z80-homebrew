8da0			 
8da0			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/string_to_uint16.z80 
8da0			 
8da0			;written by Zeda 
8da0			;Converts a 16-bit unsigned integer to an ASCII string. 
8da0			 
8da0			uitoa_16: 
8da0			;Input: 
8da0			;   DE is the number to convert 
8da0			;   HL points to where to write the ASCII string (up to 6 bytes needed). 
8da0			;Output: 
8da0			;   HL points to the null-terminated ASCII string 
8da0			;      NOTE: This isn't necessarily the same as the input HL. 
8da0 d5			  push de 
8da1 c5			  push bc 
8da2 f5			  push af 
8da3 eb			  ex de,hl 
8da4			 
8da4 01 f0 d8		  ld bc,-10000 
8da7 3e 2f		  ld a,'0'-1 
8da9 3c			  inc a 
8daa 09			  add hl,bc  
8dab 38 fc		   jr c,$-2 
8dad 12			  ld (de),a 
8dae 13			  inc de 
8daf			 
8daf 01 e8 03		  ld bc,1000 
8db2 3e 3a		  ld a,'9'+1 
8db4 3d			  dec a  
8db5 09			  add hl,bc  
8db6 30 fc		   jr nc,$-2 
8db8 12			  ld (de),a 
8db9 13			  inc de 
8dba			 
8dba 01 9c ff		  ld bc,-100 
8dbd 3e 2f		  ld a,'0'-1 
8dbf 3c			  inc a  
8dc0 09			  add hl,bc  
8dc1 38 fc		   jr c,$-2 
8dc3 12			  ld (de),a 
8dc4 13			  inc de 
8dc5			 
8dc5 7d			  ld a,l 
8dc6 26 3a		  ld h,'9'+1 
8dc8 25			  dec h  
8dc9 c6 0a		  add a,10  
8dcb 30 fb		   jr nc,$-3 
8dcd c6 30		  add a,'0' 
8dcf eb			  ex de,hl 
8dd0 72			  ld (hl),d 
8dd1 23			  inc hl 
8dd2 77			  ld (hl),a 
8dd3 23			  inc hl 
8dd4 36 00		  ld (hl),0 
8dd6			 
8dd6			;Now strip the leading zeros 
8dd6 0e fa		  ld c,-6 
8dd8 09			  add hl,bc 
8dd9 3e 30		  ld a,'0' 
8ddb 23			  inc hl  
8ddc be			  cp (hl)  
8ddd 28 fc		  jr z,$-2 
8ddf			 
8ddf			;Make sure that the string is non-empty! 
8ddf 7e			  ld a,(hl) 
8de0 b7			  or a 
8de1 20 01		  jr nz,.atoub 
8de3 2b			  dec hl 
8de4			.atoub: 
8de4			 
8de4 f1			  pop af 
8de5 c1			  pop bc 
8de6 d1			  pop de 
8de7 c9			  ret 
8de8			 
8de8			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/toUpper.z80 
8de8			 
8de8			toUpper: 
8de8			;A is the char. 
8de8			;If A is a lowercase letter, this sets it to the matching uppercase 
8de8			;18cc or 30cc or 41cc 
8de8			;avg: 26.75cc 
8de8 fe 61		  cp 'a' 
8dea d8			  ret c 
8deb fe 7b		  cp 'z'+1 
8ded d0			  ret nc 
8dee d6 20		  sub 'a'-'A' 
8df0 c9			  ret 
