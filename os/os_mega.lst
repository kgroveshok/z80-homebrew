1170				push de 
1170					ld hl, display_fb0 
1170					ld (display_fb_active), hl 
1170				call clear_display 
1170				ld a, 0 
1170				ld de, .mallocasize 
1170				call str_at_display 
1170				call update_display 
1170				call delay1s 
1170				call delay1s 
1170			;	ld a, 0 
1170			;	ld (os_view_disable), a 
1170				call bp_on 
1170				pop de 
1170				pop hl 
1170			 
1170				CALLMONITOR 
1170				jr .lowdonex 
1170			.lowallocx: 
1170			 
1170				pop hl 
1170			.lowdonex:	pop af 
1170				pop de 
1170				pop hl 
