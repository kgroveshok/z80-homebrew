8ffe			 
8ffe			if MALLOC_4 
8ffe			 
8ffe			; My memory allocation code. Very very simple.... 
8ffe			; allocate space under 250 chars 
8ffe			 
8ffe			heap_init: 
8ffe				; init start of heap as zero 
8ffe				;  
8ffe			 
8ffe				ld hl, heap_start 
8ffe			;	ld a, 0 
8ffe				ld (hl), 0      ; empty block 
8ffe				inc hl 
8ffe			;	ld a, 0 
8ffe				ld (hl), 0      ; length of block 
8ffe				; write end of list 
8ffe				inc hl 
8ffe				ld a,(hl) 
8ffe				inc hl 
8ffe				ld a,(hl) 
8ffe				 
8ffe			 
8ffe				; init some malloc vars 
8ffe			 
8ffe				ld hl, 0 
8ffe				ld (free_list), hl       ; store last malloc location 
8ffe			 
8ffe				ld hl, free_list+3      ; flag for 'free' being used and force a rescan for reuse of block  
8ffe			;	ld a, 0 
8ffe				ld (hl), 0 
8ffe			 
8ffe			 
8ffe				ld hl, heap_start 
8ffe				;  
8ffe				  
8ffe				ret 
8ffe			 
8ffe			 
8ffe			;    free block marker 
8ffe			;    requested size  
8ffe			;    pointer to next block 
8ffe			;    .... 
8ffe			;    next block marker 
8ffe			 
8ffe			 
8ffe			; TODO add a flag that is reset on use of free. if flag is reset then start scan from start of heap otherwise use last location 
8ffe			; 
8ffe			 
8ffe			 
8ffe			malloc:  
8ffe				push de 
8ffe				push bc 
8ffe				push af 
8ffe			 
8ffe				; hl space required 
8ffe				 
8ffe				ld c, l    ; hold space   (TODO only a max of 255) 
8ffe			 
8ffe			;	inc c     ; TODO BUG need to fix memory leak on push str 
8ffe			;	inc c 
8ffe			;	inc c 
8ffe			;	inc c 
8ffe			;	inc c 
8ffe			;	inc c 
8ffe			;	inc c 
8ffe			 
8ffe			 
8ffe			 
8ffe				; start at heap if a free has been issued so we can reclaim it otherwise continue from last time 
8ffe			 
8ffe				ld a, (free_list+3) 
8ffe			;	cp 0 
8ffe				or a 
8ffe				jr z, .contheap 
8ffe			 
8ffe				ld hl, (free_list)     ; get last alloc 
8ffe					if DEBUG_FORTH_MALLOC_INT 
8ffe						DMARK "mrs" 
8ffe						CALLMONITOR 
8ffe					endif 
8ffe				jr .startalloc 
8ffe			 
8ffe			.contheap: 
8ffe				ld hl, heap_start 
8ffe			 
8ffe			.startalloc: 
8ffe			 
8ffe					if DEBUG_FORTH_MALLOC_INT 
8ffe						DMARK "mym" 
8ffe						CALLMONITOR 
8ffe					endif 
8ffe			.findblock: 
8ffe					if DEBUG_FORTH_MALLOC_INT 
8ffe						DMARK "mmf" 
8ffe						CALLMONITOR 
8ffe					endif 
8ffe			 
8ffe				ld a,(hl)  
8ffe				; if byte is zero then clear to use 
8ffe			 
8ffe			;	cp 0 
8ffe				or a 
8ffe				jr z, .foundemptyblock 
8ffe			 
8ffe				; if byte is not clear 
8ffe				;     then byte is offset to next block 
8ffe			 
8ffe				inc hl 
8ffe				ld a, (hl) ; get size 
8ffe			.nextblock:	inc hl 
8ffe					ld e, (hl) 
8ffe					inc hl 
8ffe					ld d, (hl) 
8ffe					ex de, hl 
8ffe			;	inc hl  ; move past the store space 
8ffe			;	inc hl  ; move past zero index  
8ffe			 
8ffe				; TODO detect no more space 
8ffe			 
8ffe				push hl 
8ffe				ld de, heap_end 
8ffe				call cmp16 
8ffe				pop hl 
8ffe				jr nc, .nospace 
8ffe			 
8ffe				jr .findblock 
8ffe			 
8ffe			.nospace: ld hl, 0 
8ffe				jp .exit 
8ffe			 
8ffe			 
8ffe			.foundemptyblock:	 
8ffe					if DEBUG_FORTH_MALLOC_INT 
8ffe						DMARK "mme" 
8ffe						CALLMONITOR 
8ffe					endif 
8ffe			 
8ffe			; TODO has block enough space if reusing??? 
8ffe			 
8ffe				;  
8ffe			 
8ffe			; see if this block has been previously used 
8ffe				inc hl 
8ffe				ld a, (hl) 
8ffe				dec hl 
8ffe			;	cp 0 
8ffe				or a 
8ffe				jr z, .newblock 
8ffe			 
8ffe					if DEBUG_FORTH_MALLOC_INT 
8ffe						DMARK "meR" 
8ffe						CALLMONITOR 
8ffe					endif 
8ffe			 
8ffe			; no reusing previously allocated block 
8ffe			 
8ffe			; is it smaller than previously used? 
8ffe				 
8ffe				inc hl    ; move to size 
8ffe				ld a, c 
8ffe				sub (hl)        ; we want c < (hl) 
8ffe				dec hl    ; move back to marker 
8ffe			        jr z, .findblock 
8ffe			 
8ffe				; update with the new size which should be lower 
8ffe			 
8ffe			        ;inc  hl   ; negate next move. move back to size  
8ffe			 
8ffe			.newblock: 
8ffe				; need to be at marker here 
8ffe			 
8ffe					if DEBUG_FORTH_MALLOC_INT 
8ffe						DMARK "meN" 
8ffe						CALLMONITOR 
8ffe					endif 
8ffe			 
8ffe			 
8ffe				ld a, c 
8ffe			 
8ffe				ld (free_list+3), a	 ; flag resume from last malloc  
8ffe				ld (free_list), hl    ; save out last location 
8ffe			 
8ffe			 
8ffe				;inc a     ; space for length byte 
8ffe				ld (hl), a     ; save block in use marker 
8ffe			 
8ffe				inc hl   ; move to space marker 
8ffe				ld (hl), a    ; save new space 
8ffe			 
8ffe				inc hl   ; move to start of allocated area 
8ffe				 
8ffe			;	push hl     ; save where we are - 1  
8ffe			 
8ffe			;	inc hl  ; move past zero index  
8ffe				; skip space to set down new marker 
8ffe			 
8ffe				; provide some extra space for now 
8ffe			 
8ffe				inc a    ; actual is one fewer than bytes requested. correct if zero index is taken into account 
8ffe				inc a 
8ffe				inc a 
8ffe			 
8ffe				push hl   ; save where we are in the node block 
8ffe			 
8ffe				call addatohl 
8ffe			 
8ffe				; write linked list point 
8ffe			 
8ffe				pop de     ; get our node position 
8ffe				ex de, hl 
8ffe			 
8ffe				ld (hl), e 
8ffe				inc hl 
8ffe				ld (hl), d 
8ffe			 
8ffe				inc hl 
8ffe			 
8ffe				; now at start of allocated data so save pointer 
8ffe			 
8ffe				push hl 
8ffe			 
8ffe				; jump to position of next node and setup empty header in DE 
8ffe			 
8ffe				ex de, hl 
8ffe			 
8ffe			;	inc hl ; move past end of block 
8ffe			 
8ffe			;	ld a, 0 
8ffe				ld (hl), 0   ; empty marker 
8ffe				inc hl 
8ffe				ld (hl), 0   ; size 
8ffe				inc hl  
8ffe				ld (hl), 0   ; ptr 
8ffe				inc hl 
8ffe				ld (hl), 0   ; ptr 
8ffe			 
8ffe			 
8ffe				pop hl 
8ffe			 
8ffe					if DEBUG_FORTH_MALLOC_INT 
8ffe						DMARK "mmr" 
8ffe						CALLMONITOR 
8ffe					endif 
8ffe			 
8ffe			.exit: 
8ffe				pop af 
8ffe				pop bc 
8ffe				pop de  
8ffe				ret 
8ffe			 
8ffe			 
8ffe			 
8ffe			 
8ffe			free:  
8ffe				push hl 
8ffe				push af 
8ffe				; get address in hl 
8ffe			 
8ffe					if DEBUG_FORTH_MALLOC_INT 
8ffe						DMARK "fre" 
8ffe						CALLMONITOR 
8ffe					endif 
8ffe				; data is at hl - move to block count 
8ffe				dec hl 
8ffe				dec hl    ; get past pointer 
8ffe				dec hl 
8ffe			 
8ffe				ld a, (hl)    ; need this for a validation check 
8ffe			 
8ffe				dec hl    ; move to block marker 
8ffe			 
8ffe				; now check that the block count and block marker are the same  
8ffe			        ; this checks that we are on a malloc node and not random memory 
8ffe			        ; OK a faint chance this could be a problem but rare - famous last words! 
8ffe			 
8ffe				ld c, a 
8ffe				ld a, (hl)    
8ffe			 
8ffe				cp c 
8ffe				jr nz, .freeignore      ; not a valid malloc node in use so dont break anything 
8ffe			 
8ffe				; yes good chance we are on a malloc node 
8ffe			 
8ffe			;	ld a, 0      
8ffe				ld (hl), 0   ; mark as free 
8ffe			 
8ffe				ld (free_list+3), a	 ; flag reuse of existing block on next malloc 
8ffe			 
8ffe			.freeignore:  
8ffe			 
8ffe				pop af 
8ffe				pop hl 
8ffe			 
8ffe				ret 
8ffe			 
8ffe			 
8ffe			 
8ffe			endif 
