1c46			;WORD_SYS_LOWPRIM: equ 4    ; Offset for low level prim words opcode 
1c46			;WORD_SYS_BRANCH: equ 10    ; Offset for branching and loop words opcode 
1c46			WORD_SYS_UWORD: equ 1   ; Opcode for all user words 
1c46			WORD_SYS_DELETED: equ 3 ; Op code for a deleted UWORD 
1c46			WORD_SYS_ROOT: equ 0   ; Opcode for all user words 
1c46			WORD_SYS_END: equ 0   ; Opcode for all user words 
1c46			WORD_SYS_CORE: equ 20    ; Offset for dict core words opcode 
1c46			WORD_FLAG_CODE: equ 0	   ; opcodeflag to exec pure code for this word 
1c46			WORD_FLAG_JP: equ 1	   ; opcodeflag to list zero term jump table words 
1c46			 
1c46			; Core word preamble macro 
1c46			 
1c46			CWHEAD:   macro nxtword opcode lit len opflags 
1c46				db WORD_SYS_CORE+opcode             
1c46				; internal op code number 
1c46				dw nxtword            
1c46				; link to next dict word block 
1c46				db len + 1 
1c46				; literal length of dict word inc zero term 
1c46				db lit,0              
1c46				; literal dict word 
1c46			        ; TODO db opflags        
1c46				endm 
