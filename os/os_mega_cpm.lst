0fe5			 
0fe5			 
0fe5			;      .org  0x100 
0fe5			;main: 
0fe5			;      ld    HL, 0x8100 
0fe5			;      ld    SP, HL 
0fe5			; 
0fe5			;      call  heap_init 
0fe5			; 
0fe5			;      ; Make some allocations 
0fe5			;      ld    HL, 12 
0fe5			;      call  malloc            ; Allocates 0x9004 
0fe5			; 
0fe5			;      ld    HL, 12 
0fe5			;      call  malloc            ; Allocates 0x9014 
0fe5			; 
0fe5			;      ld    HL, 12 
0fe5			;      call  malloc            ; Allocates 0x9024 
0fe5			; 
0fe5			;      ; Free some allocations 
0fe5			;      ld    HL, 0x9014 
0fe5			;      call  free 
0fe5			; 
0fe5			;      ld    HL, 0x9004 
0fe5			;      call  free 
0fe5			; 
0fe5			;      ld    HL, 0x9024 
0fe5			;      call  free 
0fe5			; 
0fe5			; 
0fe5			;      halt 
