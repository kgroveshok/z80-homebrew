534f					ld a, (.dmark+2)  
534f					ld (debug_mark+2),a  
534f				endif  
534f 18 04			jr .pastdmark  
5351 ..			.dmark: db "VAR"  
5354				if DEMARK_VERSION = 1  
5354 00					db 0  
5355				endif  
5355				if DEMARK_VERSION = 1  
5355 e1			.pastdmark: pop hl  
5356				endif  
5356				if DEMARK_VERSION = 0  
5356			.pastdmark: pop af  
5356				endif  
