1211				ld de, .lsworddef 
1211				call .genfile 
1211				ret 
1211			 
1211			.genedword: 
1211				ld de, .edworddef 
1211				ld hl, crs_s2 
1211				call .genfile 
1211				ret 
1211			 
1211			.gendemword: 
1211				ld de, .demoworddef 
1211				ld hl, crs_s3 
1211				call .genfile 
1211				ret 
1211			 
1211			.genutlword: 
1211				ld hl, crs_s4 
1211				ld de, .utilwordef 
1211				call .genfile 
1211				ret 
1211			.genspiword: 
1211				ld hl, crs_s5 
1211				ld de, .spiworddef 
1211				call .genfile 
1211				ret 
1211			.genkeyword: 
1211				ld hl, crs_s6 
1211				ld de, .keyworddef 
1211				call .genfile 
1211				ret 
