1073			; Decimal Signed Version 
1073			 
1073			; DispA 
1073			; -------------------------------------------------------------- 
1073			; Converts a signed integer value to a zero-terminated ASCII 
1073			; string representative of that value (using radix 10). 
1073			; -------------------------------------------------------------- 
1073			; INPUTS: 
1073			;     HL     Value to convert (two's complement integer). 
1073			;     DE     Base address of string destination. (pointer). 
1073			; -------------------------------------------------------------- 
1073			; OUTPUTS: 
1073			;     None 
1073			; -------------------------------------------------------------- 
1073			; REGISTERS/MEMORY DESTROYED 
1073			; AF HL 
1073			; -------------------------------------------------------------- 
1073			 
1073			;DispHLToASCII: 
1073			;   push    de 
1073			;   push    bc 
1073			; 
1073			;; Detect sign of HL. 
1073			;    bit    7, h 
1073			;    jr     z, ._DoConvert 
1073			; 
1073			;; HL is negative. Output '-' to string and negate HL. 
1073			;    ld     a, '-' 
1073			;    ld     (de), a 
1073			;    inc    de 
1073			; 
1073			;; Negate HL (using two's complement) 
1073			;    xor    a 
1073			;    sub    l 
1073			;    ld     l, a 
1073			;    ld     a, 0     ; Note that XOR A or SUB A would disturb CF 
1073			;    sbc    a, h 
1073			;    ld     h, a 
1073			; 
1073			;; Convert HL to digit characters 
1073			;._DoConvert: 
1073			;    ld     b, 0     ; B will count character length of number 
1073			;-   ld     a, 10 
1073			;    syscall  .DivHLByA  ; HL = HL / A, A = remainder 
1073			;    push   af 
1073			;    inc    b 
1073			;    ld     a, h 
1073			;    or     l 
1073			;    jr     nz, - 
1073			; 
1073			;; Retrieve digits from stack 
1073			;-   pop    af 
1073			;    or     $30 
1073			;    ld     (de), a 
1073			;    inc    de 
1073			;    djnz   - 
1073			; 
1073			;; Terminate string with NULL 
1073			;    xor    a 
1073			;    ld     (de), a 
1073			; 
1073			;    pop    bc 
1073			;    pop    de 
1073			;    ret 
1073			 
1073			;Comments 
1073			; 
1073			;    This routine uses the common positive-integer radix conversion algorithm of repeatedly dividing a value by the desired radix (base case: the value is zero) and saving the remainders of each division. 
1073			;    As this algorithm gives the digits in reverse order, they are pushed onto the hardware stack so that subsequently popping them yields the correct order. 
1073			;    Note that the output string will not be fixed-width. 
1073			; 
1073			;Example Usage 
1073			; 
1073			;    ld    hl, -1004 
1073			;    ld    de, OP1 
1073			;    call  DispA 
1073			;    ld    hl, OP1 
1073			;    syscall  PutS 
