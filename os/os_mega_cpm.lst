1005			;------------------------------------------------------------------------------ 
1005			;     heap_init                                                               : 
1005			;                                                                             : 
1005			; Description                                                                 : 
1005			;     Initialise the heap and make it ready for malloc and free operations.   : 
1005			;                                                                             : 
1005			;     The heap is maintained as a linked list, starting with an initial       : 
1005			;     "dummy block" of zero size which is mainly used to hold a pointer to    : 
1005			;     the first free block in the heap. Each block then points to the next    : 
1005			;     free block within the heap, and the free list ends at the first block   : 
1005			;     with a null pointer to the next free block.                             : 
1005			;                                                                             : 
1005			; Parameters                                                                  : 
1005			;     Inputs are compile-time only. Two defines which specify the starting    : 
1005			;     address of the heap and its size are required, along with a memory      : 
1005			;     allocation of 4 consecutive bytes which is used for a dummy block which : 
1005			;     principally stores a pointer to the first free block in the heap.       : 
1005			;                                                                             : 
1005			; Returns                                                                     : 
1005			;     Nothing                                                                 : 
1005			;------------------------------------------------------------------------------ 
1005			heap_init: 
1005 e5			      push  HL 
1006			 
1006			      ; Initialise free list struct 
1006 21 21 5c		      ld    HL, heap_start 
1009 22 1c 5c		      ld    (free_list), HL 
100c 21 00 00		      ld    HL, 0 
100f 22 1e 5c		      ld    (free_list+2), HL 
1012			 
1012			      ; Insert first free block at bottom of heap, consumes entire heap 
1012 21 72 e2		      ld    HL, heap_start+heap_size-4 
1015 22 21 5c		      ld    (heap_start), HL        ; Next block (end of free list) 
1018 21 51 86		      ld    HL, heap_size-4 
101b 22 23 5c		      ld    (heap_start+2), HL      ; Block size 
101e			 
101e			      ; Insert end of free list block at top of heap - two null words will 
101e			      ; terminate the free list 
101e 21 00 00		      ld    HL, 0 
1021 22 74 e2		      ld    (heap_start+heap_size-2), HL 
1024 22 72 e2		      ld    (heap_start+heap_size-4), HL 
1027			 
1027 e1			      pop   HL 
1028			 
1028 c9			      ret 
1029			 
