d52a			 
d52a			; jump to nmi vector 
d52a			 
d52a			init_nmi: 
d52a			 
d52a 3e c9			ld a, $c9   ; RET 
d52c 32 6e ee			ld (nmi_vector), a 
d52f			if BASE_KEV 
d52f				ld a, $c3   ; jp 
d52f				ld (nmi_vector), a 
d52f				ld hl, led_on 
d52f				ld (nmi_vector+1), hl 
d52f			endif 
d52f c9				ret 
d530			 
d530			; Clear the hardware flag for nmi use 
d530			 
d530			clear_nmi: 
d530 f5				push af 
d531 3a 72 ee		        ld a, (hardware_word+1) 
d534 cb bf			res 7,a 
d536 32 72 ee		        ld (hardware_word+1),a 
d539 f1				pop af 
d53a c9				ret 
d53b			 
d53b			nmi: 
d53b e5				push hl 
d53c d5				push de 
d53d c5				push bc 
d53e f5				push af 
d53f			 
d53f				; check to see if already nmi has been set 
d53f			 
d53f 3a 72 ee		        ld a, (hardware_word+1) 
d542			 
d542 cb 7f			bit 7, a 
d544 20 08			jr nz, .rest     ; yes so skip any vector calls	 
d546				 
d546			 
d546				; set the hardware flag for nmi use 
d546 cb ff			set 7,a 
d548 32 72 ee		        ld (hardware_word+1),a 
d54b			 
d54b				; call user function 
d54b cd 6e ee			call nmi_vector 
d54e			 
d54e f5			.rest:	push af 
d54f c5				push bc 
d550 d5				push de 
d551 e5				push hl 
d552 ed 45			retn 
d554			 
d554			 
d554			; eof 
