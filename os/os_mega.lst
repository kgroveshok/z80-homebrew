20e5				endif 
20e5 e5				push hl 
20e6 d5				push de 
20e7 eb				ex de,hl 
20e8 2a 09 f9			ld hl,(cli_ret_sp) 
20eb 23				inc hl 
20ec 23				inc hl 
20ed 22 09 f9			ld (cli_ret_sp),hl 
20f0 73				ld (hl), e 
20f1 23				inc hl 
20f2 72				ld (hl), d 
20f3 d1				pop de 
20f4 e1				pop hl 
20f5				if DEBUG_FORTH_STACK_GUARD 
20f5 cd 79 65				call check_stacks 
20f8				endif 
20f8 c9				ret 
20f9			 
20f9			; get current ret stack pointer and save to hl  
20f9				 
20f9			FORTH_RSP_TOS: macro 
