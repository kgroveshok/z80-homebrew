69b1 0e 28			ld c, display_cols  
69b3 23			cpr1:	inc hl  
69b4 0d				dec c  
69b5 20 fc			jr nz, cpr1  
69b7 05				dec b  
69b8 20 f7			jr nz, cpr  
69ba			  
69ba				; add col	  
69ba			  
69ba 23			cpr2:	inc hl  
69bb 1d				dec e  
69bc 20 fc			jr nz, cpr2  
69be			  
69be c1				pop bc  
69bf c9				ret  
