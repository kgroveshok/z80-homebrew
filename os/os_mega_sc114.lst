8f4f			;------------------------------------------------------------------------------ 
8f4f			;     free                                                                    : 
8f4f			;                                                                             : 
8f4f			; Description                                                                 : 
8f4f			;     Return the space pointed to by HL to the heap. HL must be an address as : 
8f4f			;     returned by malloc, otherwise the behaviour is undefined.               : 
8f4f			;                                                                             : 
8f4f			;     Where possible, directly adjacent free blocks will be merged together   : 
8f4f			;     into larger blocks to help ensure that the heap does not become         : 
8f4f			;     excessively fragmented.                                                 : 
8f4f			;                                                                             : 
8f4f			;     free does not clear or set any other value into the freed space, and    : 
8f4f			;     therefore its contents may be visible through subsequent malloc's. The  : 
8f4f			;     caller should clear the freed space as required.                        : 
8f4f			;                                                                             : 
8f4f			;     This implementation of free uses the stack exclusively, and is          : 
8f4f			;     therefore re-entrant. But due to the Z80's lack of atomicity, it is     : 
8f4f			;     advisable to disable interrupts before calling free, and recommended    : 
8f4f			;     to avoid the use of free inside ISRs in general.                        : 
8f4f			;                                                                             : 
8f4f			;     NOTE: heap_init must be called before malloc and free can be used.      : 
8f4f			;                                                                             : 
8f4f			; Parameters                                                                  : 
8f4f			;     HL  Pointer to address of first byte of allocation to be freed          : 
8f4f			;                                                                             : 
8f4f			; Returns                                                                     : 
8f4f			;     Nothing                                                                 : 
8f4f			;                                                                             : 
8f4f			; Stack frame                                                                 : 
8f4f			;       |             |                                                       : 
8f4f			;       +-------------+                                                       : 
8f4f			;       |     BC      |                                                       : 
8f4f			;       +-------------+                                                       : 
8f4f			;       |     DE      |                                                       : 
8f4f			;       +-------------+                                                       : 
8f4f			;       |     IX      |                                                       : 
8f4f			;       +-------------+                                                       : 
8f4f			;       |  prev_free  |                                                       : 
8f4f			;   +2  +-------------+                                                       : 
8f4f			;       |  next_free  |                                                       : 
8f4f			;   +0  +-------------+                                                       : 
8f4f			;       |             |                                                       : 
8f4f			;                                                                             : 
8f4f			;------------------------------------------------------------------------------ 
8f4f			free: 
8f4f c5			      push  BC 
8f50 d5			      push  DE 
8f51 dd e5		      push  IX 
8f53			 
8f53 7c			      ld    A, H                    ; Exit if ptr is null 
8f54 b5			      or    L 
8f55 ca 19 90		      jp    Z, free_early_exit 
8f58			 
8f58			      ; Set up stack frame 
8f58 eb			      ex    DE, HL 
8f59 21 fc ff		      ld    HL, -4                  ; Reserve 4 bytes for stack frame 
8f5c 39			      add   HL, SP 
8f5d f9			      ld    SP, HL 
8f5e dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
8f62 dd 39		      add   IX, SP 
8f64			 
8f64			      ; The address in HL points to the start of the useable allocated space, 
8f64			      ; but the block struct starts 4 bytes before this. Sub 4 to get the 
8f64			      ; address of the block itself. 
8f64 eb			      ex    DE, HL 
8f65 11 fc ff		      ld    DE, -4 
8f68 19			      add   HL, DE 
8f69			 
8f69			      ; An allocated block must have a null next block pointer in it 
8f69 7e			      ld    A, (HL) 
8f6a 23			      inc   HL 
8f6b b6			      or    (HL) 
8f6c c2 14 90		      jp    NZ, free_done 
8f6f			 
8f6f 2b			      dec   HL 
8f70			 
8f70 44			      ld    B, H                    ; Copy HL to BC 
8f71 4d			      ld    C, L 
8f72			 
8f72			      ; Loop through the free list to find the first block with an address 
8f72			      ; higher than the block being freed 
8f72 21 e3 d6		      ld    HL, free_list 
8f75			 
8f75			free_find_higher_block: 
8f75 5e			      ld    E, (HL)                 ; Load next ptr from free block 
8f76 23			      inc   HL 
8f77 56			      ld    D, (HL) 
8f78 2b			      dec   HL 
8f79			 
8f79 dd 73 00		      ld    (IX+0), E               ; Save ptr to next free block 
8f7c dd 72 01		      ld    (IX+1), D 
8f7f dd 75 02		      ld    (IX+2), L               ; Save ptr to prev free block 
8f82 dd 74 03		      ld    (IX+3), H 
8f85			 
8f85 78			      ld    A, B                    ; Check if DE is greater than BC 
8f86 ba			      cp    D                       ; Compare MSB first 
8f87 28 02		      jr    Z, $+4                  ; MSB the same, compare LSB 
8f89 30 04		      jr    NC, free_find_higher_block_skip 
8f8b 79			      ld    A, C 
8f8c bb			      cp    E                       ; Then compare LSB 
8f8d 38 08		      jr    C, free_found_higher_block 
8f8f			 
8f8f			free_find_higher_block_skip: 
8f8f 7a			      ld    A, D                    ; Reached the end of the free list? 
8f90 b3			      or    E 
8f91 ca 14 90		      jp    Z, free_done 
8f94			 
8f94 eb			      ex    DE, HL 
8f95			 
8f95 18 de		      jr    free_find_higher_block 
