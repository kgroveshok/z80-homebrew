6c8d			  
6c8d			  
6c8d			; take current custor pos in de (d=row,e=col) and return a pointer to the frame buffer  
6c8d			  
6c8d			curptr:  
6c8d c5				push bc  
6c8e 21 e1 fc			ld hl, display_fb0  
6c91			cpr:	  
6c91				; loop for cursor whole row  
6c91 0e 28			ld c, display_cols  
6c93 23			cpr1:	inc hl  
6c94 0d				dec c  
6c95 20 fc			jr nz, cpr1  
6c97 05				dec b  
6c98 20 f7			jr nz, cpr  
6c9a			  
6c9a				; add col	  
6c9a			  
6c9a 23			cpr2:	inc hl  
6c9b 1d				dec e  
6c9c 20 fc			jr nz, cpr2  
6c9e			  
6c9e c1				pop bc  
6c9f c9				ret  
6ca0				  
6ca0			  
6ca0			  
6ca0			  
6ca0			  
6ca0			; write the frame buffer given in hl to hardware   
6ca0 22 f9 fa		write_display: ld (display_write_tmp), hl 	   
6ca3 3e 00			ld a, kLCD_Line1  
6ca5 cd cb 6d		            CALL fLCD_Pos       ;Position cursor to location in A  
6ca8 06 28			ld b, display_cols  
6caa ed 5b f9 fa		ld de, (display_write_tmp)  
6cae cd fa 6c			call write_len_string  
6cb1				  
6cb1				  
6cb1 2a f9 fa			ld hl, (display_write_tmp)  
6cb4 11 28 00			ld de, display_cols  
6cb7 19				add hl,de  
6cb8 22 f9 fa			ld (display_write_tmp),hl  
6cbb			  
6cbb				  
6cbb 3e 28			ld a, kLCD_Line2  
6cbd cd cb 6d		            CALL fLCD_Pos       ;Position cursor to location in A  
6cc0 06 28			ld b, display_cols  
6cc2 ed 5b f9 fa		ld de, (display_write_tmp)  
6cc6 cd fa 6c			call write_len_string  
6cc9				  
6cc9 2a f9 fa			ld hl, (display_write_tmp)  
6ccc 11 28 00			ld de, display_cols  
6ccf 19				add hl,de  
6cd0 22 f9 fa			ld (display_write_tmp),hl  
6cd3			  
6cd3				  
6cd3 3e 50			ld a, kLCD_Line3  
6cd5 cd cb 6d		            CALL fLCD_Pos       ;Position cursor to location in A  
6cd8 06 28			ld b, display_cols  
6cda ed 5b f9 fa		ld de, (display_write_tmp)  
6cde cd fa 6c			call write_len_string  
6ce1				  
6ce1 2a f9 fa			ld hl, (display_write_tmp)  
6ce4 11 28 00			ld de, display_cols  
6ce7 19				add hl,de  
6ce8 22 f9 fa			ld (display_write_tmp),hl  
6ceb			  
6ceb				  
6ceb 3e 78			ld a, kLCD_Line4  
6ced cd cb 6d		            CALL fLCD_Pos       ;Position cursor to location in A  
6cf0 06 28			ld b, display_cols  
6cf2 ed 5b f9 fa		ld de, (display_write_tmp)  
6cf6 cd fa 6c			call write_len_string  
6cf9 c9					ret  
6cfa				  
6cfa				; write out a fixed length string given in b from de  
6cfa			  
6cfa 1a			write_len_string:   LD   A, (DE)        ;Get character from string  
6cfb cd 7d 6d		            CALL fLCD_Data      ;Write character to display  
6cfe 13				inc de  
