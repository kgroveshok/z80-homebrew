0bf9			addatohl: 
0bf9 85			    add   a, l    ; A = A+L 
0bfa 6f			    ld    l, a    ; L = A+L 
0bfb 8c			    adc   a, h    ; A = A+L+H+carry 
0bfc 95			    sub   l       ; A = H+carry 
0bfd 67			    ld    h, a    ; H = H+carry 
0bfe c9			ret 
0bff			 
0bff			addatode: 
0bff 83			    add   a, e    ; A = A+L 
0c00 5f			    ld    e, a    ; L = A+L 
0c01 8a			    adc   a, d    ; A = A+L+H+carry 
0c02 93			    sub   e       ; A = H+carry 
0c03 57			    ld    d, a    ; H = H+carry 
0c04 c9			ret 
