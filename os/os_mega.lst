6aab			; handle the auto run of code from files in storage 
6aab			 
6aab			 
6aab			include "forth_startup.asm" 
6aab			; Which startup method to use? 
6aab			; 
6aab			; version 1 - allows for a single stored file to be selected to run at start up (if se storage is enabled) 
6aab			; followed by loading of a list of scripts in eeprom 
6aab			 
6aab			; version 2 - if se storage is enabled then auto load all files which begin with a '*' else use loading 
6aab			; from eeprom 
6aab			 
6aab			; Select with define in main stubs 
6aab			 
6aab			if STARTUP_V1 
6aab				include "forth_startupv1.asm" 
6aab			endif 
6aab			if STARTUP_V2 
6aab				include "forth_startupv2.asm" 
6aab			; Version 2 of the startup  
6aab			;  
6aab			; Auto load any files in bank 1 that start with a '*' 
6aab			; If no se storage then revert to using eprom 
6aab			 
6aab			 
6aab			if STORAGE_SE = 0 
6aab			 
6aab			sprompt1: db "Startup load...",0 
6aab			sprompt2: db "Run? 1=No *=End #=All",0 
6aab			 
6aab			 
6aab			 
6aab			 
6aab			forth_startup: 
6aab				ld hl, startcmds 
6aab				ld a, 0 
6aab				ld (os_last_cmd), a    ; tmp var to skip prompts if doing all 
6aab			 
6aab			.start1:	push hl 
6aab				call clear_display 
6aab				ld de, sprompt1 
6aab			        ld a, display_row_1 
6aab				call str_at_display 
6aab				ld de, sprompt2 
6aab			        ld a, display_row_2 
6aab				call str_at_display 
6aab				pop hl 
6aab				push hl 
6aab				ld e,(hl) 
6aab				inc hl 
6aab				ld d,(hl) 
6aab			        ld a, display_row_3 
6aab				call str_at_display 
6aab				call update_display 
6aab			 
6aab			 
6aab				ld a, (os_last_cmd) 
6aab			;	cp 0 
6aab				or a 
6aab				jr z, .startprompt 
6aab				call delay250ms 
6aab				jr .startdo 
6aab				 
6aab				 
6aab			 
6aab			.startprompt: 
6aab			 
6aab				ld a,display_row_4 + display_cols - 1 
6aab			        ld de, endprg 
6aab				call str_at_display 
6aab				call update_display 
6aab				call delay1s 
6aab				call cin_wait 
6aab						 
6aab				cp '*' 
6aab				jr z, .startupend1 
6aab				cp '#' 
6aab				jr nz, .startno 
6aab				ld a, 1 
6aab				ld (os_last_cmd),a 
6aab				jr .startdo 
6aab			.startno:	cp '1' 
6aab				jr z,.startnxt  
6aab			 
6aab				; exec startup line 
6aab			.startdo:	 
6aab				pop hl 
6aab				push hl 
6aab				 
6aab				ld e,(hl) 
6aab				inc hl 
6aab				ld d,(hl) 
6aab				ex de,hl 
6aab			 
6aab				push hl 
6aab			 
6aab				ld a, 0 
6aab				;ld a, FORTH_END_BUFFER 
6aab				call strlent 
6aab				inc hl   ; include zero term to copy 
6aab				ld b,0 
6aab				ld c,l 
6aab				pop hl 
6aab				ld de, scratch 
6aab				ldir 
6aab			 
6aab			 
6aab				ld hl, scratch 
6aab				call forthparse 
6aab				call forthexec 
6aab				call forthexec_cleanup 
6aab			 
6aab				ld a, display_row_4 
6aab				ld de, endprog 
6aab			 
6aab				call update_display		 
6aab			 
6aab				ld a, (os_last_cmd) 
6aab			;	cp 0 
6aab				or a 
6aab				jr nz, .startnxt 
6aab				call next_page_prompt 
6aab			        call clear_display 
6aab				call update_display		 
6aab			 
6aab				; move onto next startup line? 
6aab			.startnxt: 
6aab			 
6aab				call delay250ms 
6aab				pop hl 
6aab			 
6aab				inc hl 
6aab				inc hl 
6aab			 
6aab				push hl 
6aab				ld e, (hl) 
6aab				inc hl 
6aab				ld d, (hl) 
6aab				pop hl 
6aab				; TODO replace 0 test 
6aab			 
6aab				ex de, hl 
6aab				call ishlzero 
6aab			;	ld a,e 
6aab			;	add d 
6aab			;	cp 0    ; any left to do? 
6aab				ex de, hl 
6aab				jp nz, .start1 
6aab				jr .startupend 
6aab			 
6aab			.startupend1: pop hl 
6aab			.startupend: 
6aab			 
6aab				call clear_display 
6aab				call update_display 
6aab				ret 
6aab			endif 
