d56d			 
d56d				cp 0 
d56d				ret z     ; auto start not enabled 
d56d			 
d56d				call clear_display 
d56d			 
d56d				; set bank 
d56d			 
d56d					ld a, (store_page+STORE_0_BANKRUN) 
d56d					ld (spi_device), a 
d56d			 
d56d				; get file id to load from and get the file name to display 
d56d			 
d56d					ld a, (store_page+STORE_0_FILERUN) 
d56d			 
d56d					ld l, 0 
d56d					ld h, a 
d56d					ld de, store_page 
d56d			 
d56d					if DEBUG_FORTH_WORDS 
d56d						DMARK "ASp" 
d56d						CALLMONITOR 
d56d					endif 
d56d					call storage_read 
d56d			 
d56d					if DEBUG_FORTH_WORDS 
d56d						DMARK "ASr" 
d56d						CALLMONITOR 
d56d					endif 
d56d			 
d56d					call ishlzero 
d56d					ret z             ; file not found 
d56d			 
d56d					ld a, display_row_2 + 10 
d56d					ld de, store_page+3 
d56d					call str_at_display 
d56d				 
d56d			; 
d56d			 
d56d				ld a, display_row_1+5 
d56d				ld de, sprompt3 
d56d				call str_at_display 
d56d				ld a, display_row_3+15 
d56d				ld de, sprompt4 
d56d				call str_at_display 
d56d			 
d56d				call update_display 
d56d			 
d56d				call cin_wait 
d56d				cp 'n' 
d56d				ret z 
d56d				cp 'N' 
d56d				ret z 
d56d			 
d56d				call delay1s 
d56d			 
d56d				ld a, (store_page+2) 
d56d				ld (store_openmaxext), a    ; save count of ext 
d56d				ld a, 1  
d56d				ld (store_openext), a    ; save count of ext 
d56d			 
d56d			.autof:  
d56d				ld l , a 
d56d				 
d56d				ld a, (store_page) 
d56d				ld h, a	 
d56d				ld de, store_page 
d56d					if DEBUG_FORTH_WORDS 
d56d						DMARK "ASl" 
d56d						CALLMONITOR 
d56d					endif 
d56d					call storage_read 
d56d				call ishlzero 
d56d				ret z 
d56d			;	jr z, .autoend 
d56d			 
d56d					if DEBUG_FORTH_WORDS 
d56d						DMARK "ASc" 
d56d						CALLMONITOR 
d56d					endif 
d56d				ld de, store_page+2 
d56d				ld a, display_row_4 
d56d				call str_at_display 
d56d			 
d56d				call update_display 
d56d				call delay250ms 
d56d			 
d56d			 
d56d			 
d56d				ld hl, store_page+2 
d56d				call forthparse 
d56d				call forthexec 
d56d				call forthexec_cleanup 
d56d			 
d56d				 
d56d				ld a, (store_openext) 
d56d				inc a 
d56d				ld (store_openext), a    ; save count of ext 
d56d			 
d56d				jr .autof 
d56d			;.autofdone: 
