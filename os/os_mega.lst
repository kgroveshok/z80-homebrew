1050 fe 61		to_upper:        cp      'a'             ; Nothing to do if not lower case 
1052 d8			                ret     c 
1053 fe 7b		                cp      'z' + 1         ; > 'z'? 
1055 d0			                ret     nc              ; Nothing to do, either 
1056 e6 5f		                and     $5f             ; Convert to upper case 
1058 c9			                ret 
