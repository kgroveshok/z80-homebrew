0f2c			 
0f2c			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/string_to_uint16.z80 
0f2c			 
0f2c			 
0f2c			;Converts an ASCII string to an unsigned 16-bit integer 
0f2c			;Quits when it reaches a non-decimal digit 
0f2c			 
0f2c			string_to_uint16: 
0f2c			atoui_16: 
0f2c			;Input: 
0f2c			;     DE points to the string 
0f2c			;Outputs: 
0f2c			;     HL is the result 
0f2c			;     A is the 8-bit value of the number 
0f2c			;     DE points to the byte after the number 
0f2c			;Destroys: 
0f2c			;     BC 
0f2c			;       if the string is non-empty, BC is HL/10 
0f2c			;Size:  24 bytes 
0f2c			;Speed: 42+d(104+{0,9}) 
0f2c			;       d is the number of digits in the number 
0f2c			;       max is 640 cycles for a 5 digit number 
0f2c			;Assuming no leading zeros: 
0f2c			;1 digit:  146cc 
0f2c			;2 digit:  250cc 
0f2c			;3 digit:  354cc or 363cc (avg: 354.126cc) 
0f2c			;4 digit:  458cc or 467cc (avg: 458.27cc) 
0f2c			;5 digit:  562cc or 571cc or 580cc (avg: 562.4104cc) 
0f2c			;avg: 544.81158447265625cc (544+13297/16384) 
0f2c			;=============================================================== 
0f2c 21 00 00		  ld hl,0 
0f2f			.u16a: 
0f2f 1a			  ld a,(de) 
0f30 d6 30		  sub 30h 
0f32 fe 0a		  cp 10 
0f34 d0			  ret nc 
0f35 13			  inc de 
0f36 44			  ld b,h 
0f37 4d			  ld c,l 
0f38 29			  add hl,hl 
0f39 29			  add hl,hl 
0f3a 09			  add hl,bc 
0f3b 29			  add hl,hl 
0f3c 85			  add a,l 
0f3d 6f			  ld l,a 
0f3e 30 ef		  jr nc,.u16a 
0f40 24			  inc h 
0f41 c3 2f 0f		  jp .u16a 
0f44			 
0f44			 
0f44			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/string_to_uint16.z80 
0f44			 
0f44			;written by Zeda 
0f44			;Converts a 16-bit unsigned integer to an ASCII string. 
0f44			 
0f44			uitoa_16: 
0f44			;Input: 
0f44			;   DE is the number to convert 
0f44			;   HL points to where to write the ASCII string (up to 6 bytes needed). 
0f44			;Output: 
0f44			;   HL points to the null-terminated ASCII string 
0f44			;      NOTE: This isn't necessarily the same as the input HL. 
0f44 d5			  push de 
0f45 c5			  push bc 
0f46 f5			  push af 
0f47 eb			  ex de,hl 
0f48			 
0f48 01 f0 d8		  ld bc,-10000 
0f4b 3e 2f		  ld a,'0'-1 
0f4d 3c			  inc a 
0f4e 09			  add hl,bc  
0f4f 38 fc		   jr c,$-2 
0f51 12			  ld (de),a 
0f52 13			  inc de 
0f53			 
0f53 01 e8 03		  ld bc,1000 
0f56 3e 3a		  ld a,'9'+1 
0f58 3d			  dec a  
0f59 09			  add hl,bc  
0f5a 30 fc		   jr nc,$-2 
0f5c 12			  ld (de),a 
0f5d 13			  inc de 
0f5e			 
0f5e 01 9c ff		  ld bc,-100 
0f61 3e 2f		  ld a,'0'-1 
0f63 3c			  inc a  
0f64 09			  add hl,bc  
0f65 38 fc		   jr c,$-2 
0f67 12			  ld (de),a 
0f68 13			  inc de 
0f69			 
0f69 7d			  ld a,l 
0f6a 26 3a		  ld h,'9'+1 
0f6c 25			  dec h  
0f6d c6 0a		  add a,10  
0f6f 30 fb		   jr nc,$-3 
0f71 c6 30		  add a,'0' 
0f73 eb			  ex de,hl 
0f74 72			  ld (hl),d 
0f75 23			  inc hl 
0f76 77			  ld (hl),a 
0f77 23			  inc hl 
0f78 36 00		  ld (hl),0 
0f7a			 
0f7a			;Now strip the leading zeros 
0f7a 0e fa		  ld c,-6 
0f7c 09			  add hl,bc 
0f7d 3e 30		  ld a,'0' 
0f7f 23			  inc hl  
0f80 be			  cp (hl)  
0f81 28 fc		  jr z,$-2 
0f83			 
0f83			;Make sure that the string is non-empty! 
0f83 7e			  ld a,(hl) 
0f84 b7			  or a 
0f85 20 01		  jr nz,.atoub 
0f87 2b			  dec hl 
0f88			.atoub: 
0f88			 
0f88 f1			  pop af 
0f89 c1			  pop bc 
0f8a d1			  pop de 
0f8b c9			  ret 
0f8c			 
0f8c			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/toUpper.z80 
0f8c			 
0f8c			toUpper: 
0f8c			;A is the char. 
0f8c			;If A is a lowercase letter, this sets it to the matching uppercase 
0f8c			;18cc or 30cc or 41cc 
0f8c			;avg: 26.75cc 
0f8c fe 61		  cp 'a' 
0f8e d8			  ret c 
0f8f fe 7b		  cp 'z'+1 
0f91 d0			  ret nc 
0f92 d6 20		  sub 'a'-'A' 
0f94 c9			  ret 
