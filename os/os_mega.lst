6a42			; **********************************************************************  
6a42			; **  Alphanumeric LCD support                  by Stephen C Cousins  **  
6a42			; **********************************************************************  
6a42			;  
6a42			; **  Written as a Small Computer Monitor App   
6a42			; **  Version 0.1 SCC 2018-05-16  
6a42			; **  www.scc.me.uk  
6a42			;  
6a42			; **********************************************************************  
6a42			;  
6a42			; This module provides support for alphanumeric LCD modules using with  
6a42			; *  HD44780 (or compatible) controller  
6a42			; *  5 x 7 pixel fonts  
6a42			; *  Up to 80 characters in total (eg. 4 lines of 20 characters)  
6a42			; *  Interface via six digital outputs to the display (see below)  
6a42			;  
6a42			; LCD module pinout:  
6a42			;   1  Vss   0v supply  
6a42			;   2  Vdd   5v supply  
6a42			;   3  Vo    LCD input voltage (near zero volts via potentiometer)  
6a42			;   4  RS    High = data, Low = instruction  
6a42			;   5  R/W   High = Read, Low = Write  
6a42			;   6  E     Enable signal (active high)  
6a42			;   7  DB0   Data bit 0  
6a42			;   8  DB1   Data bit 1  
6a42			;   9  DB2   Data bit 2  
6a42			;  10  DB3   Data bit 3  
6a42			;  11  DB4   Data bit 4  
6a42			;  12  DB5   Data bit 5  
6a42			;  13  DB6   Data bit 6  
6a42			;  14  DB7   Data bit 7  
6a42			;  15  A     Backlight anode (+)  
6a42			;  16  K     Backlight cathode (-)  
6a42			;  
6a42			; This interfacing method uses 4-bit data mode and uses time delays  
6a42			; rather than polling the display's ready status. As a result the   
6a42			; interface only requires 6 simple output lines:  
6a42			;   LCD E   = Microcomputer output port bit <kLCDBitE>  
6a42			;   LCD RS  = Microcomputer output port bit <kLCDBitRS>  
6a42			;   LCD DB4 = Microcomputer output port bit 4  
6a42			;   LCD DB5 = Microcomputer output port bit 5  
6a42			;   LCD DB6 = Microcomputer output port bit 6  
6a42			;   LCD DB7 = Microcomputer output port bit 7  
6a42			; Display's R/W is connected to 0v so it is always in write mode  
6a42			; All 6 connections must be on the same port address <kLCDPrt>  
6a42			; This method also allows a decent length of cable from micro to LCD  
6a42			;  
6a42			; **********************************************************************  
6a42			;  
6a42			; To include the code for any given function provided by this module,   
6a42			; add the appropriate #REQUIRES <FunctionName> statement at the top of   
6a42			; the parent source file.  
6a42			; For example:  #REQUIRES   uHexPrefix  
6a42			;  
6a42			; Also #INCLUDE this file at some point after the #REQUIRES statements  
6a42			; in the parent source file.  
6a42			; For example:  #INCLUDE    ..\_CodeLibrary\Utilities.asm  
6a42			;  
6a42			; These are the function names provided by this module:  
6a42			; fLCD_Init                     ;Initialise LCD  
6a42			; fLCD_Inst                     ;Send instruction to LCD  
6a42			; fLCD_Data                     ;Send data byte to LCD  
6a42			; fLCD_Pos                      ;Position cursor  
6a42			; fLCD_Str                      ;Display string  
6a42			; fLCD_Def                      ;Define custom character  
6a42			;  
6a42			; **********************************************************************  
6a42			;  
6a42			; Requires SCMonAPI.asm to also be included in the project  
6a42			;  
6a42			  
6a42			  
6a42			; **********************************************************************  
6a42			; **  Constants  
6a42			; **********************************************************************  
6a42			  
6a42			; Constants that must be defined externally  
6a42			;kLCDPrt:   EQU 0xc0           ;Port address used for LCD  
6a42			;kLCDBitRS: EQU 2              ;Port bit for LCD RS signal  
6a42			;kLCDBitE:  EQU 3              ;Port bit for LCD E signal  
6a42			;kLCDWidth: EQU 20             ;Width in characters  
6a42			  
6a42			; general line offsets in any frame buffer  
6a42			  
6a42			  
6a42			display_row_1: equ 0  
6a42			display_row_2: equ display_row_1+display_cols  
6a42			display_row_3: equ display_row_2 + display_cols  
6a42			display_row_4: equ display_row_3 + display_cols  
6a42			;display_row_4_eol:   
6a42			  
6a42			  
6a42			; Cursor position values for the start of each line  
6a42			  
6a42			; E  
6a42			kLCD_Line1: EQU 0x00   
6a42			kLCD_Line2: EQU kLCD_Line1+kLCDWidth  
6a42			; E1  
6a42			kLCD_Line3: EQU kLCD_Line2+kLCDWidth  
6a42			kLCD_Line4: EQU kLCD_Line3+kLCDWidth   
6a42			  
6a42			; Instructions to send as A register to fLCD_Inst  
6a42			kLCD_Clear: EQU 00000001b     ;LCD clear  
6a42			kLCD_Off:   EQU 00001000b     ;LCD off  
6a42			kLCD_On:    EQU 00001100b     ;LCD on, no cursor or blink  
6a42			kLCD_Under: EQU 00001110b     ;LCD on, cursor = underscore  
6a42			kLCD_Blink: EQU 00001101b     ;LCD on, cursor = blink block  
6a42			kLCD_Both:  EQU 00001111b     ;LCD on, cursor = under+blink  
6a42			  
6a42			; Constants used by this code module  
6a42			kLCD_Clr:   EQU 00000001b     ;LCD command: Clear display  
6a42			kLCD_Pos:   EQU 10000000b     ;LCD command: Position cursor  
6a42			kLCD_Def:   EQU 01000000b     ;LCD command: Define character  
6a42			  
6a42			  
6a42			  
6a42			; **********************************************************************  
6a42			; **  LCD support functions  
6a42			; **********************************************************************  
6a42			  
6a42			; Initialise alphanumeric LCD module  
6a42			; LCD control register codes:  
6a42			;   DL   0 = 4-bit mode        1 = 8-bit mode  
6a42			;   N    0 = 1-line mode       1 = 2-line mode  
6a42			;   F    0 = Font 5 x 8        1 = Font 5 x 11  
6a42			;   D    0 = Display off       1 = Display on  
6a42			;   C    0 = Cursor off        1 = Cursor on  
6a42			;   B    0 = Blinking off      1 = Blinking on  
6a42			;   ID   0 = Decrement mode    1 = Increment mode  
6a42			;   SH   0 = Entire shift off  1 = Entire shift on  
6a42 3e 28		fLCD_Init:  LD   A, 40  
6a44 cd 85 6b		            CALL LCDDelay       ;Delay 40ms after power up  
6a47			; For reliable reset set 8-bit mode - 3 times  
6a47 cd 55 6b		            CALL WrFn8bit       ;Function = 8-bit mode  
6a4a cd 55 6b		            CALL WrFn8bit       ;Function = 8-bit mode  
6a4d cd 55 6b		            CALL WrFn8bit       ;Function = 8-bit mode  
6a50			; Set 4-bit mode  
6a50 cd 51 6b		            CALL WrFn4bit       ;Function = 4-bit mode  
6a53 cd 83 6b		            CALL LCDDelay1      ;Delay 37 us or more  
6a56			; Function set  
6a56 3e 28		            LD   A, 00101000b  ;Control reg:  0  0  1  DL N  F  x  x  
6a58 cd 7b 6a		            CALL fLCD_Inst      ;2 line, display on  
6a5b			; Display On/Off control  
6a5b 3e 0c		            LD   A, 00001100b  ;Control reg:  0  0  0  0  1  D  C  B   
6a5d cd 7b 6a		            CALL fLCD_Inst      ;Display on, cursor on, blink off  
6a60			; Display Clear  
6a60 3e 01		            LD   A, 00000001b  ;Control reg:  0  0  0  0  0  0  0  1  
6a62 cd 7b 6a		            CALL fLCD_Inst      ;Clear display  
6a65			; Entry mode  
6a65 3e 06		            LD   A, 00000110b  ;Control reg:  0  0  0  0  0  1  ID SH  
6a67 cd 7b 6a		            CALL fLCD_Inst      ;Increment mode, shift off  
6a6a			; Display module now initialised  
6a6a c9			            RET  
6a6b			; ok to here  
6a6b			  
6a6b			; decide on setting bit for LED on or off  
6a6b			; Set correct bit in A  
6a6b e5			IsLED: push hl  
6a6c 21 ad fd			ld hl, hardware_word+1  
6a6f cb 56			bit 2, (hl)    ; led bit  
6a71 20 04			jr nz, .isled1  
6a73 cb 8f			res kLCDBitLED, a  
6a75 18 02			jr .isleddone  
6a77 cb cf		.isled1: set kLCDBitLED, a  
6a79			.isleddone:  	  
6a79 e1				pop hl  
6a7a			  
6a7a c9				ret  
6a7b			  
6a7b			  
6a7b			; Write instruction to LCD  
6a7b			;   On entry: A = Instruction byte to be written  
6a7b			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6a7b f5			fLCD_Inst:  PUSH AF  
6a7c f5			            PUSH AF  
6a7d cd 8f 6a		            CALL Wr4bits       ;Write bits 4 to 7 of instruction  
6a80 f1			            POP  AF  
6a81 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6a82 17			            RLA  
6a83 17			            RLA  
6a84 17			            RLA  
6a85 cd 8f 6a		            CALL Wr4bits       ;Write bits 0 to 3 of instruction  
6a88 3e 02		            LD   A, 2  
6a8a cd 85 6b		            CALL LCDDelay       ;Delay 2 ms to complete   
6a8d f1			            POP  AF  
6a8e c9			            RET  
6a8f			Wr4bits:   
6a8f f5					push af  
6a90 3a fb fa				ld a, (display_lcde1e2)  
6a93 fe 00				cp 0     ; e  
6a95 20 13				jr nz, .wea2	  
6a97 f1					pop af  
6a98 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6a9a cd 6b 6a				call IsLED  
6a9d d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a9f cb df		            SET  kLCDBitE, A	    ; TODO decide which E is being set  
6aa1 cb 87		            res  kLCDBitE2, A	    ; TODO decide which E is being set  
6aa3 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6aa5 cb 9f		            RES  kLCDBitE, A        ; TODO decide which E is being set  
6aa7 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6aa9 c9			            RET  
6aaa f1			.wea2:		pop af  
6aab e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6aad cd 6b 6a				call IsLED  
6ab0 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6ab2 cb c7		            SET  kLCDBitE2, A	    ; TODO decide which E is being set  
6ab4 cb 9f		            res  kLCDBitE, A	    ; TODO decide which E is being set  
6ab6 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6ab8 cb 87		            RES  kLCDBitE2, A        ; TODO decide which E is being set  
6aba d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6abc c9			            RET  
6abd			  
6abd			  
6abd			; Write data to LCD  
6abd			;   On entry: A = Data byte to be written  
6abd			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6abd f5			fLCD_Data:  PUSH AF  
6abe f5			            PUSH AF  
6abf cd d1 6a		            CALL Wr4bitsa       ;Write bits 4 to 7 of data byte  
6ac2 f1			            POP  AF  
6ac3 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6ac4 17			            RLA  
6ac5 17			            RLA  
6ac6 17			            RLA  
6ac7 cd d1 6a		            CALL Wr4bitsa       ;Write bits 0 to 3 of data byte  
6aca 3e 96		            LD   A, 150  
6acc 3d			Wait:      DEC  A              ;Wait a while to allow data   
6acd 20 fd		            JR   NZ, Wait      ;  write to complete  
6acf f1			            POP  AF  
6ad0 c9			            RET  
6ad1			Wr4bitsa:     
6ad1 f5					push af  
6ad2 3a fb fa				ld a, (display_lcde1e2)  
6ad5 fe 00				cp 0     ; e1  
6ad7 20 19				jr nz, .we2	  
6ad9 f1					pop af  
6ada e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6adc cd 6b 6a				call IsLED  
6adf cb d7		            SET  kLCDBitRS, A  
6ae1 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6ae3 cb df		            SET  kLCDBitE, A      ; TODO Decide which E is being set  
6ae5 cb 87		            res  kLCDBitE2, A      ; TODO Decide which E is being set  
6ae7 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6ae9 cb 9f		            RES  kLCDBitE, A       ; TODO Decide which E is being set  
6aeb d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6aed cb 97		            RES  kLCDBitRS, A  
6aef d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6af1 c9			            RET  
6af2 f1			.we2:		pop af  
6af3 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6af5 cd 6b 6a				call IsLED  
6af8 cb d7		            SET  kLCDBitRS, A  
6afa d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6afc cb c7		            SET  kLCDBitE2, A      ; TODO Decide which E is being set  
6afe cb 9f		            res  kLCDBitE, A      ; TODO Decide which E is being set  
6b00 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6b02 cb 87		            RES  kLCDBitE2, A       ; TODO Decide which E is being set  
6b04 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6b06 cb 97		            RES  kLCDBitRS, A  
6b08 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b0a c9			            RET  
6b0b			  
6b0b			  
6b0b			; Position cursor to specified location  
6b0b			;   On entry: A = Cursor position  
6b0b			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6b0b f5			fLCD_Pos:   PUSH AF  
6b0c					; at this point set the E1 or E2 flag depending on position  
6b0c			  
6b0c c5					push bc  
6b0d			;		push af  
6b0d 06 00				ld b, 0  
6b0f 4f					ld c, a  
6b10 3e 4f				ld a, kLCD_Line3-1  
6b12 b7			 		or a      ;clear carry flag  
6b13 99					sbc a,c    ; TODO may need to sub 80 from a to put in context of current frame    
6b14 38 04				jr c, .pe1  
6b16			  
6b16					; E selection  
6b16 cb 80				res 0, b         ; bit 0 unset e  
6b18			;		pop af    ; before line 3 so recover orig pos  
6b18			;		ld c, a    ; save for poking back  
6b18 18 06				jr .peset	          
6b1a			.pe1:          	; E2 selection  
6b1a cb c0				set 0, b         ; bit 0 set e1  
6b1c 79					ld a, c  
6b1d de 4f				sbc a, kLCD_Line3-1  
6b1f 4f					ld c, a	         ; save caculated offset  
6b20			;		pop af     ; bin this original value now we have calculated form  
6b20			  
6b20			.peset:		; set bit  
6b20 78					ld a, b  
6b21 32 fb fa				ld (display_lcde1e2), a 	  
6b24 79					ld a, c  
6b25 c1					pop bc  
6b26			  
6b26 f6 80		            OR   kLCD_Pos       ;Prepare position cursor instruction  
6b28 cd 7b 6a		            CALL fLCD_Inst      ;Write instruction to LCD  
6b2b f1			            POP  AF  
6b2c c9			            RET  
6b2d			  
6b2d			  
6b2d			; Output text string to LCD  
6b2d			;   On entry: DE = Pointer to null terminated text string  
6b2d			;   On exit:  BC HL IX IY I AF' BC' DE' HL' preserved  
6b2d 1a			fLCD_Str:   LD   A, (DE)        ;Get character from string  
6b2e b7			            OR   A              ;Null terminator?  
6b2f c8			            RET  Z              ;Yes, so finished  
6b30 cd bd 6a		            CALL fLCD_Data      ;Write character to display  
6b33 13			            INC  DE             ;Point to next character  
6b34 18 f7		            JR   fLCD_Str       ;Repeat  
6b36 c9					ret  
6b37			  
6b37			; Define custom character  
6b37			;   On entry: A = Character number (0 to 7)  
6b37			;             DE = Pointer to character bitmap data  
6b37			;   On exit:  A = Next character number  
6b37			;             DE = Next location following bitmap  
6b37			;             BC HL IX IY I AF' BC' DE' HL' preserved  
6b37			; Character is   
6b37 c5			fLCD_Def:   PUSH BC  
6b38 f5			            PUSH AF  
6b39 07			            RLCA                ;Calculate location  
6b3a 07			            RLCA                ;  for bitmap data  
6b3b 07			            RLCA                ;  = 8 x CharacterNumber  
6b3c f6 40		            OR   kLCD_Def       ;Prepare define character instruction  
6b3e cd 7b 6a		            CALL fLCD_Inst      ;Write instruction to LCD  
6b41 06 00		            LD   B, 0  
6b43 1a			Loop:      LD   A, (DE)        ;Get byte from bitmap  
6b44 cd bd 6a		            CALL fLCD_Data      ;Write byte to display  
6b47 13			            INC  DE             ;Point to next byte  
6b48 04			            INC  B              ;Count bytes  
6b49 cb 58		            BIT  3, B           ;Finish all 8 bytes?  
6b4b 28 f6		            JR   Z, Loop       ;No, so repeat  
6b4d f1			            POP  AF  
6b4e 3c			            INC  A              ;Increment character number  
6b4f c1			            POP  BC  
6b50 c9			            RET  
6b51			  
6b51			  
6b51			; **********************************************************************  
6b51			; **  Private functions  
6b51			; **********************************************************************  
6b51			  
6b51			; Write function to LCD  
6b51			;   On entry: A = Function byte to be written  
6b51			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6b51 3e 20		WrFn4bit:   LD   A, 00100000b  ;4-bit mode  
6b53 18 02		            JR   WrFunc  
6b55 3e 30		WrFn8bit:   LD   A, 00110000b  ;8-bit mode  
6b57 f5			WrFunc:     PUSH AF  
6b58 f5					push af  
6b59 3a fb fa				ld a, (display_lcde1e2)  
6b5c fe 00				cp 0     ; e1  
6b5e 20 0f				jr nz, .wfea2	  
6b60 f1					pop af  
6b61 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b63 cb df		            SET  kLCDBitE, A     ; TODO Decide which E is being set  
6b65 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6b67 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b69 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6b6b d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b6d 18 0d			jr .wfskip  
6b6f f1			.wfea2:		pop af  
6b70 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b72 cb c7		            SET  kLCDBitE2, A     ; TODO Decide which E is being set  
6b74 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6b76 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b78 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6b7a d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b7c 3e 05		.wfskip:            LD  A, 5  
6b7e cd 85 6b		            CALL LCDDelay       ;Delay 5 ms to complete  
6b81 f1			            POP  AF  
6b82 c9			            RET  
6b83			  
6b83			  
6b83			; Delay in milliseconds  
6b83			;   On entry: A = Number of milliseconds delay  
6b83			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6b83 3e 01		LCDDelay1:  LD   A, 1           ;Delay by 1 ms  
6b85 d5			LCDDelay:   PUSH DE  
6b86 5f			            LD   E, A           ;Delay by 'A' ms  
6b87 16 00		            LD   D, 0  
6b89 cd 62 0a		            CALL aDelayInMS  
6b8c d1			            POP  DE  
6b8d c9			            RET  
