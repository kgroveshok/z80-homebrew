10dc			; https://tutorials.eeems.ca/ASMin28Days/lesson/day16.html#cmp 
10dc			 
10dc			; String Length 
10dc			;With a length-prefixed string, finding the length is trivial. For a null-terminated string, the process is decidedly more involved. This is where CPIR comes in. 
10dc			 
10dc			; Get the length of the null-terminated string starting at $8000 hl 
10dc			;    LD     HL, $8000 
10dc			 
10dc			strlenz: 
10dc			 
10dc af			    XOR    A               ; Zero is the value we are looking for. 
10dd 47			    LD     B, A             ; Since we haven't the slightest clue as to the  
10de 4f			    LD     C, A             ; actual size of the string, put 0 in BC to search 
10df			                           ; 65, 536 bytes (the entire addressable memory space). 
10df ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
10e1			 
10e1			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
10e1 67			    LD     H, A             ; Zero HL (basically set it to 65, 536) to get the 
10e2 6f			    LD     L, A             ; number of bytes 
10e3 ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
10e5 2b			    DEC    HL              ; Compensate for null. 
10e6 c9				ret 
10e7			 
10e7			; Get the length of the A terminated string starting at $8000 hl 
10e7			;    LD     HL, $8000 
10e7			 
10e7			strlent: 
10e7			 
10e7			                  ; A is the value we are looking for. 
10e7 06 00		    LD     B, 0             ; Since we haven't the slightest clue as to the  
10e9 0e 00		    LD     C, 0             ; actual size of the string, put 0 in BC to search 
10eb			                           ; 65, 536 bytes (the entire addressable memory space). 
10eb ed b1		    CPIR                   ; Begin search for a byte equalling zero. 
10ed			 
10ed			; BC has been decremented so that it holds -length. Now need to synthesize a NEG BC. 
10ed 26 00		    LD     H, 0             ; Zero HL (basically set it to 65, 536) to get the 
10ef 2e 00		    LD     L, 0             ; number of bytes 
10f1 ed 42		    SBC    HL, BC           ; Find the size. CPIR doesn't affect carry. 
10f3 2b			    DEC    HL              ; Compensate for null. 
10f4 c9				ret 
10f5			 
10f5			 
10f5			;Comparing Strings 
10f5			 
10f5			;IN    HL     Address of string1. 
10f5			;      DE     Address of string2. 
10f5			 
10f5			; doc given but wrong??? 
10f5			;OUT   zero   Set if string1 = string2, reset if string1 != string2. 
10f5			;      carry  Set if string1 > string2, reset if string1 <= string2. 
10f5			; tested 
10f5			;OUT   carry set  if string1 = string2, carry  reset if string1 != string2. 
10f5			 
10f5			strcmp_old: 
10f5 e5			    PUSH   HL 
10f6 d5			    PUSH   DE 
10f7			 
10f7 1a			    LD     A, (DE)          ; Compare lengths to determine smaller string 
10f8 be			    CP     (HL)            ; (want to minimize work). 
10f9 38 01		    JR     C, Str1IsBigger 
10fb 7e			    LD     A, (HL) 
10fc			 
10fc			Str1IsBigger: 
10fc 4f			    LD     C, A             ; Put length in BC 
10fd 06 00		    LD     B, 0 
10ff 13			    INC    DE              ; Increment pointers to meat of string. 
1100 23			    INC    HL 
1101			 
1101			CmpLoop: 
1101 1a			    LD     A, (DE)          ; Compare bytes. 
1102 ed a1		    CPI 
1104 20 09		    JR     NZ, NoMatch      ; If (HL) != (DE), abort. 
1106 13			    INC    DE              ; Update pointer. 
1107 ea 01 11		    JP     PE, CmpLoop 
110a			 
110a d1			    POP    DE 
110b e1			    POP    HL 
110c 1a			    LD     A, (DE)          ; Check string lengths to see if really equal. 
110d be			    CP     (HL) 
110e c9			    RET 
110f			 
110f			NoMatch: 
110f 2b			    DEC    HL 
1110 be			    CP     (HL)            ; Compare again to affect carry. 
1111 d1			    POP    DE 
1112 e1			    POP    HL 
1113 c9			    RET 
