d597			display_row_3: equ display_row_2 + display_cols 
d597			display_row_4: equ display_row_3 + display_cols 
d597			 
d597			kLCDWidth:  EQU display_cols             ;Width in characters 
d597			kLCD_Line1: EQU 0x00  
