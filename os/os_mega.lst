11f1 dd 6e 00		      ld    L, (IX+0)               ; next_free to HL 
11f4 dd 66 01		      ld    H, (IX+1) 
11f7			 
11f7 dd 75 02		      ld    (IX+2), L               ; HL to this_free 
11fa dd 74 03		      ld    (IX+3), H 
