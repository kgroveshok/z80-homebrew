8e41			;      call  malloc            ; Allocates 0x9004 
8e41			; 
8e41			;      ld    HL, 12 
8e41			;      call  malloc            ; Allocates 0x9014 
8e41			; 
8e41			;      ld    HL, 12 
8e41			;      call  malloc            ; Allocates 0x9024 
8e41			; 
8e41			;      ; Free some allocations 
8e41			;      ld    HL, 0x9014 
8e41			;      call  free 
8e41			; 
8e41			;      ld    HL, 0x9004 
8e41			;      call  free 
8e41			; 
8e41			;      ld    HL, 0x9024 
8e41			;      call  free 
8e41			; 
8e41			; 
8e41			;      halt 
