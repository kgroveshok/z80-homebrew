1d74			include "firmware_595shiftreg.asm"  
1d74			; common code for handling a 595 shift reg out on whatever output port 
1d74			 
1d74			; port in c 
1d74			; byte in a 
1d74			 
1d74			 
1d74			shift_bit_data: equ 0 
1d74			shift_bit_clk: equ 1 
1d74			shift_bit_latch: equ 2 
1d74			 
1d74			 
1d74			; shift out a byte to the sound chip 
1d74			 
1d74			; A contains byte to send 
1d74			 
1d74			shift_byte: 
1d74			 
1d74 06 08			ld b, 8   ; 8 bits to shift 
1d76			 
1d76 16 00		.nb1:	ld d, 0    ; our work byte to send to the device with flags 
1d78			 
1d78				; set data bit state 
1d78			 
1d78 cb 7f			bit 7, a 
1d7a				; high bit is set 
1d7a 28 02			jr z, .nb2 
1d7c cb c2			set shift_bit_data, d 
1d7e			 
1d7e				; set latches state  
1d7e cb ca		.nb2:	set shift_bit_clk, d 
1d80 cb 92			res shift_bit_latch, d    ; latch is inverted 
1d82 ed 51			out (c), d 
1d84				 
1d84				; clock the bit out 
1d84 cb 8a			res shift_bit_clk, d 
1d86 ed 51			out (c), d 
1d88			 
1d88				; shift a left one bit and repeat 
1d88 17				rla 
1d89			 
1d89 10 eb			djnz .nb1 
1d8b			 
1d8b				; latch 
1d8b cb d2			set shift_bit_latch, d 
1d8d ed 51			out (c), d 
1d8f					 
1d8f			 
1d8f				; set  
1d8f c9				ret 
# End of file firmware_595shiftreg.asm
