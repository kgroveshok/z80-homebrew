c060			; var handler 
c060			 
c060			 
c060			.VARS: 
c060				CWHEAD .V0 99 "VAR" 3 WORD_FLAG_CODE 
c060 77				db WORD_SYS_CORE+99             
c061 c8 c0			dw .V0            
c063 04				db 3 + 1 
c064 .. 00			db "VAR",0              
c068				endm 
# End of macro CWHEAD
c068			; | VAR ( u1 -- )  Get the address of the (word) variable referenced on TOS  | DONE 
c068			; | 
c068			; | | The variable name should consist of a single letter (a-z). e.g. "a" 
c068			; | |  
c068			; | | e.g. 
c068			; | |         #30 a var ! 
c068			; | |         a var @ . 
c068			; | |   
c068			; | |     Displays the number 30 
c068			; | | 
c068			; | | Each variable pointer is a word so can use for any words that use that:  
c068			; | |  
c068			; | | e.g. 
c068			; | |  
c068			; | |         #30 a var 2! 
c068			; | |         a var 2@ . 
c068			; | |   
c068			; | |     Displays the number 30 
c068			; | |  
c068			; | | > [!NOTE]  
c068			; ! | > If a full string is passed then only the first char is looked at 
c068			; | | > Any other char could exceed bounds checks!  
c068			; | | > 
c068			; | | > Each variable location follows the previous. Watch you don't clobber any others. 
c068			 
c068					if DEBUG_FORTH_WORDS_KEY 
c068						DMARK "VAR" 
c068				if DEMARK_VERSION = 1  
c068 e5					push hl  
c069 21 71 c0				ld hl, .dmark  
c06c 22 60 ee				ld (debug_mark), hl  
c06f				endif  
c06f				if DEMARK_VERSION = 0  
c06f					push af  
c06f					ld a, (.dmark)  
c06f					ld (debug_mark),a  
c06f					ld a, (.dmark+1)  
c06f					ld (debug_mark+1),a  
c06f					ld a, (.dmark+2)  
c06f					ld (debug_mark+2),a  
c06f				endif  
c06f 18 04			jr .pastdmark  
c071 ..			.dmark: db "VAR"  
c074				if DEMARK_VERSION = 1  
c074 00					db 0  
c075				endif  
c075				if DEMARK_VERSION = 1  
c075 e1			.pastdmark: pop hl  
c076				endif  
c076				if DEMARK_VERSION = 0  
c076			.pastdmark: pop af  
c076				endif  
c076			endm  
# End of macro DMARK
c076						CALLMONITOR 
c076				if BASE_CPM=1  
c076					call debug_vector  
c076				endif  
c076				if BASE_KEV=1  
c076					rst 8  
c076				endif  
c076				endm  
# End of macro CALLMONITOR
c076					endif 
c076			 
c076					FORTH_DSP_VALUEHL 
c076				if BASE_CPM=1 
c076				call macro_dsp_valuehl 
c076				endif 
c076				if BASE_KEV=1 
c076					rst $18 
c076				endif 
c076				endm 
# End of macro FORTH_DSP_VALUEHL
c076			 
