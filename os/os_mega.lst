1073			 
1073			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/string_to_uint16.z80 
1073			 
1073			 
1073			;Converts an ASCII string to an unsigned 16-bit integer 
1073			;Quits when it reaches a non-decimal digit 
1073			 
1073			string_to_uint16: 
1073			atoui_16: 
1073			;Input: 
1073			;     DE points to the string 
1073			;Outputs: 
1073			;     HL is the result 
1073			;     A is the 8-bit value of the number 
1073			;     DE points to the byte after the number 
1073			;Destroys: 
1073			;     BC 
1073			;       if the string is non-empty, BC is HL/10 
1073			;Size:  24 bytes 
1073			;Speed: 42+d(104+{0,9}) 
1073			;       d is the number of digits in the number 
1073			;       max is 640 cycles for a 5 digit number 
1073			;Assuming no leading zeros: 
1073			;1 digit:  146cc 
1073			;2 digit:  250cc 
1073			;3 digit:  354cc or 363cc (avg: 354.126cc) 
1073			;4 digit:  458cc or 467cc (avg: 458.27cc) 
1073			;5 digit:  562cc or 571cc or 580cc (avg: 562.4104cc) 
1073			;avg: 544.81158447265625cc (544+13297/16384) 
1073			;=============================================================== 
1073 21 00 00		  ld hl,0 
1076			.u16a: 
1076 1a			  ld a,(de) 
1077 d6 30		  sub 30h 
1079 fe 0a		  cp 10 
107b d0			  ret nc 
107c 13			  inc de 
107d 44			  ld b,h 
107e 4d			  ld c,l 
107f 29			  add hl,hl 
1080 29			  add hl,hl 
1081 09			  add hl,bc 
1082 29			  add hl,hl 
1083 85			  add a,l 
1084 6f			  ld l,a 
1085 30 ef		  jr nc,.u16a 
1087 24			  inc h 
1088 c3 76 10		  jp .u16a 
108b			 
108b			 
108b			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/string_to_uint16.z80 
108b			 
108b			;written by Zeda 
108b			;Converts a 16-bit unsigned integer to an ASCII string. 
108b			 
108b			uitoa_16: 
108b			;Input: 
108b			;   DE is the number to convert 
108b			;   HL points to where to write the ASCII string (up to 6 bytes needed). 
108b			;Output: 
108b			;   HL points to the null-terminated ASCII string 
108b			;      NOTE: This isn't necessarily the same as the input HL. 
108b d5			  push de 
108c c5			  push bc 
108d f5			  push af 
108e eb			  ex de,hl 
108f			 
108f 01 f0 d8		  ld bc,-10000 
1092 3e 2f		  ld a,'0'-1 
1094 3c			  inc a 
1095 09			  add hl,bc  
1096 38 fc		   jr c,$-2 
1098 12			  ld (de),a 
1099 13			  inc de 
109a			 
109a 01 e8 03		  ld bc,1000 
109d 3e 3a		  ld a,'9'+1 
109f 3d			  dec a  
10a0 09			  add hl,bc  
10a1 30 fc		   jr nc,$-2 
10a3 12			  ld (de),a 
10a4 13			  inc de 
10a5			 
10a5 01 9c ff		  ld bc,-100 
10a8 3e 2f		  ld a,'0'-1 
10aa 3c			  inc a  
10ab 09			  add hl,bc  
10ac 38 fc		   jr c,$-2 
10ae 12			  ld (de),a 
10af 13			  inc de 
10b0			 
10b0 7d			  ld a,l 
10b1 26 3a		  ld h,'9'+1 
10b3 25			  dec h  
10b4 c6 0a		  add a,10  
10b6 30 fb		   jr nc,$-3 
10b8 c6 30		  add a,'0' 
10ba eb			  ex de,hl 
10bb 72			  ld (hl),d 
10bc 23			  inc hl 
10bd 77			  ld (hl),a 
10be 23			  inc hl 
10bf 36 00		  ld (hl),0 
10c1			 
10c1			;Now strip the leading zeros 
10c1 0e fa		  ld c,-6 
10c3 09			  add hl,bc 
10c4 3e 30		  ld a,'0' 
10c6 23			  inc hl  
10c7 be			  cp (hl)  
10c8 28 fc		  jr z,$-2 
10ca			 
10ca			;Make sure that the string is non-empty! 
10ca 7e			  ld a,(hl) 
10cb b7			  or a 
10cc 20 01		  jr nz,.atoub 
10ce 2b			  dec hl 
10cf			.atoub: 
10cf			 
10cf f1			  pop af 
10d0 c1			  pop bc 
10d1 d1			  pop de 
10d2 c9			  ret 
10d3			 
10d3			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/toUpper.z80 
10d3			 
10d3			toUpper: 
10d3			;A is the char. 
10d3			;If A is a lowercase letter, this sets it to the matching uppercase 
10d3			;18cc or 30cc or 41cc 
10d3			;avg: 26.75cc 
10d3 fe 61		  cp 'a' 
10d5 d8			  ret c 
10d6 fe 7b		  cp 'z'+1 
10d8 d0			  ret nc 
10d9 d6 20		  sub 'a'-'A' 
10db c9			  ret 
