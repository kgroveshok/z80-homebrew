6ab6 cd c4 6b		            CALL fLCD_Pos       ;Position cursor to location in A  
6ab9 06 28			ld b, display_cols  
6abb ed 5b f9 fa		ld de, (display_write_tmp)  
6abf cd f3 6a			call write_len_string  
6ac2				  
6ac2 2a f9 fa			ld hl, (display_write_tmp)  
6ac5 11 28 00			ld de, display_cols  
6ac8 19				add hl,de  
