6569			; stack over and underflow checks 
6569			 
6569			; init the words to detect the under/overflow 
6569			 
6569			chk_stk_init: 
6569				; a vague random number to check so we dont get any "lucky" hits 
6569 3e 2d			ld a, 45 
656b 6f				ld l, a 
656c 00				nop 
656d 3e 17			ld a, 23 
656f 67				ld h, a 
6570			 
6570 22 b4 f0			ld (chk_word), hl     ; the word we need to check against 
6573			 
6573			;	ld (chk_stund), hl	; stack points.... 
6573 22 3b fe			ld (chk_stovr), hl 
6576 22 03 f9			ld (chk_ret_und), hl 
6579 22 c1 f8			ld (chk_ret_ovr), hl 
657c 22 3f f8			ld (chk_loop_ovr), hl 
657f 22 3d f6			ld (chk_data_ovr), hl 
6582 c9				ret 
6583				 
6583			check_stacks: 
6583				; check all stack words for corruption 
6583			 
6583				; Stack checks  
6583			 
6583			 
6583				; stack over 
6583				; return under 
6583				; return over 
6583				; loop over 
6583				; data over 
6583			 
6583			 
6583 e5				push hl 
6584 2a af fd			ld hl, (hardware_config+1) 
6587 cb 7e			bit 7, (hl) 
6589			 
6589 20 02			jr nz, .dochecks 
658b			 
658b e1				pop hl 
658c c9				ret 
658d			 
658d			.dochecks: 
658d			 
658d d5				push de 
658e			 
658e			;	ld de,(chk_word) 
658e			;	ld hl, (chk_stund)	; stack points.... 
658e			;	if DEBUG_STK_FAULT 
658e			;		DMARK "FAa" 
658e			;		CALLMONITOR 
658e			;	endif 
658e			;	call cmp16 
658e			;	jp z, .chk_faulta 
658e			; 
658e			;	ld de, sfaultsu 
658e			;	jp .chk_fault 
658e			 
658e 2a 3b fe		.chk_faulta: ld hl, (chk_stovr) 
6591 ed 5b b4 f0		ld de,(chk_word) 
6595				if DEBUG_STK_FAULT 
6595					DMARK "FAb" 
6595					CALLMONITOR 
6595				endif 
6595 cd d9 0d			call cmp16 
6598 28 06			jr z, .chk_fault1 
659a 11 3f 66			ld de, sfaultso 
659d c3 ef 65			jp .chk_fault 
65a0			.chk_fault1:  
65a0 2a 03 f9			ld hl, (chk_ret_und) 
65a3 ed 5b b4 f0		ld de,(chk_word) 
65a7				if DEBUG_STK_FAULT 
65a7					DMARK "FAU" 
65a7					CALLMONITOR 
65a7				endif 
65a7 cd d9 0d			call cmp16 
65aa ca b3 65			jp z, .chk_fault2 
65ad 11 4f 66			ld de, sfaultru 
65b0 c3 ef 65			jp .chk_fault 
65b3			.chk_fault2:  
65b3 2a c1 f8			ld hl, (chk_ret_ovr) 
65b6 ed 5b b4 f0		ld de,(chk_word) 
65ba				if DEBUG_STK_FAULT 
65ba					DMARK "FA1" 
65ba					CALLMONITOR 
65ba				endif 
65ba cd d9 0d			call cmp16 
65bd ca c6 65			jp z, .chk_fault3 
65c0 11 5d 66			ld de, sfaultro 
65c3 c3 ef 65			jp .chk_fault 
65c6			.chk_fault3:  
