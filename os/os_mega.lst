15c4 cd da 15			call note_send_byte 
15c7 cd 71 0a			call delay250ms 
15ca 3e 05			ld a, SOUND_DATA | SOUND_CH0 | SOUND_TONE | 0101B 
15cc cd da 15			call note_send_byte 
15cf cd 71 0a			call delay250ms 
15d2 c9				ret 
