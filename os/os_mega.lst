0d45			 
0d45			 
0d45			;;;; int maths 
0d45			 
0d45			; https://map.grauw.nl/articles/mult_div_shifts.php 
0d45			; Divide 16-bit values (with 16-bit result) 
0d45			; In: Divide BC by divider DE 
0d45			; Out: BC = result, HL = rest 
0d45			; 
0d45			Div16: 
0d45 21 00 00		    ld hl,0 
0d48 78			    ld a,b 
0d49 06 08		    ld b,8 
0d4b			Div16_Loop1: 
0d4b 17			    rla 
0d4c ed 6a		    adc hl,hl 
0d4e ed 52		    sbc hl,de 
0d50 30 01		    jr nc,Div16_NoAdd1 
0d52 19			    add hl,de 
0d53			Div16_NoAdd1: 
0d53 10 f6		    djnz Div16_Loop1 
0d55 17			    rla 
0d56 2f			    cpl 
0d57 47			    ld b,a 
0d58 79			    ld a,c 
0d59 48			    ld c,b 
0d5a 06 08		    ld b,8 
0d5c			Div16_Loop2: 
0d5c 17			    rla 
0d5d ed 6a		    adc hl,hl 
0d5f ed 52		    sbc hl,de 
0d61 30 01		    jr nc,Div16_NoAdd2 
0d63 19			    add hl,de 
0d64			Div16_NoAdd2: 
0d64 10 f6		    djnz Div16_Loop2 
0d66 17			    rla 
0d67 2f			    cpl 
0d68 41			    ld b,c 
0d69 4f			    ld c,a 
0d6a c9			ret 
0d6b			 
0d6b			 
0d6b			;http://z80-heaven.wikidot.com/math 
0d6b			; 
0d6b			;Inputs: 
0d6b			;     DE and A are factors 
0d6b			;Outputs: 
0d6b			;     A is not changed 
0d6b			;     B is 0 
0d6b			;     C is not changed 
0d6b			;     DE is not changed 
0d6b			;     HL is the product 
