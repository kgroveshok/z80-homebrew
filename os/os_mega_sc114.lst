8e85 c5			      push  BC 
8e86 d5			      push  DE 
8e87 dd e5		      push  IX 
8e89			if DEBUG_FORTH_MALLOC_HIGH 
8e89			call malloc_guard_entry 
8e89			endif 
8e89			 
8e89					if DEBUG_FORTH_MALLOC 
8e89						DMARK "mal" 
8e89						CALLMONITOR 
8e89					endif 
8e89 7c			      ld    A, H                    ; Exit if no space requested 
8e8a b5			      or    L 
8e8b ca 4a 8f		      jp    Z, malloc_early_exit 
8e8e			 
8e8e			;inc hl 
8e8e			;inc hl 
8e8e			;inc hl 
8e8e			; 
8e8e			;inc hl 
8e8e			;inc hl 
8e8e			;inc hl 
8e8e			;inc hl 
8e8e			;inc hl 
8e8e			;inc hl 
8e8e			;inc hl 
8e8e			;inc hl 
8e8e			;inc hl 
8e8e			 
8e8e			 
8e8e			 
8e8e			 
8e8e					if DEBUG_FORTH_MALLOC 
8e8e						DMARK "maA" 
8e8e						CALLMONITOR 
8e8e					endif 
8e8e			      ; Set up stack frame 
8e8e eb			      ex    DE, HL 
8e8f 21 fa ff		      ld    HL, -6                  ; Reserve 6 bytes for stack frame 
8e92 39			      add   HL, SP 
8e93 f9			      ld    SP, HL 
8e94 dd 21 00 00	      ld    IX, 0                   ; Use IX as a frame pointer 
8e98 dd 39		      add   IX, SP 
8e9a			 
8e9a			      ; Setup initial state 
8e9a 21 04 00		      ld    HL, 4                   ; want must also include space used by block struct 
8e9d 19			      add   HL, DE 
8e9e			 
8e9e 44			      ld    B, H                    ; Move want to BC 
8e9f 4d			      ld    C, L 
8ea0			 
8ea0 21 e3 d6		      ld    HL, free_list           ; Store prev_free ptr to stack 
8ea3 dd 75 04		      ld    (IX+4), L 
8ea6 dd 74 05		      ld    (IX+5), H 
8ea9			 
8ea9 5e			      ld    E, (HL)                 ; Store this_free ptr to stack 
8eaa 23			      inc   HL 
8eab 56			      ld    D, (HL) 
8eac dd 73 02		      ld    (IX+2), E 
8eaf dd 72 03		      ld    (IX+3), D 
8eb2 eb			      ex    DE, HL                  ; this_free ptr into HL 
8eb3			 
8eb3					if DEBUG_FORTH_MALLOC 
8eb3						DMARK "maB" 
8eb3						CALLMONITOR 
8eb3					endif 
8eb3			      ; Loop through free block list to find some space 
8eb3			malloc_find_space: 
8eb3 5e			      ld    E, (HL)                 ; Load next_free ptr into DE 
8eb4 23			      inc   HL 
8eb5 56			      ld    D, (HL) 
8eb6			 
8eb6 7a			      ld    A, D                    ; Check for null next_free ptr - end of free list 
8eb7 b3			      or    E 
8eb8 ca 44 8f		      jp    Z, malloc_no_space 
8ebb			 
8ebb dd 73 00		      ld    (IX+0), E               ; Store next_free ptr to stack 
8ebe dd 72 01		      ld    (IX+1), D 
8ec1			 
8ec1			      ; Does this block have enough space to make the allocation? 
8ec1 23			      inc   HL                      ; Load free block size into DE 
8ec2 5e			      ld    E, (HL) 
8ec3 23			      inc   HL 
8ec4 56			      ld    D, (HL) 
8ec5			 
8ec5 eb			      ex    DE, HL                  ; Check size of block against want 
8ec6 b7			      or    A                       ; Ensure carry flag clear 
8ec7 ed 42		      sbc   HL, BC 
8ec9 e5			      push  HL                      ; Store the result for later (new block size) 
8eca			 
8eca ca 19 8f		      jp   Z, malloc_alloc_fit     ; Z means block size matches want - can allocate 
8ecd 30 1b		      jr    NC, malloc_alloc_split  ; NC means block is bigger than want - can allocate 
8ecf			 
8ecf			      ; this_free block is not big enough, setup ptrs to test next free block 
8ecf e1			      pop   HL                      ; Discard previous result 
8ed0			 
8ed0 dd 6e 02		      ld    L, (IX+2)               ; Move this_free ptr into prev_free 
8ed3 dd 66 03		      ld    H, (IX+3) 
8ed6 dd 75 04		      ld    (IX+4), L 
8ed9 dd 74 05		      ld    (IX+5), H 
8edc			 
8edc dd 6e 00		      ld    L, (IX+0)               ; Move next_free ptr into this_free 
8edf dd 66 01		      ld    H, (IX+1) 
8ee2 dd 75 02		      ld    (IX+2), L 
8ee5 dd 74 03		      ld    (IX+3), H 
8ee8			 
8ee8					if DEBUG_FORTH_MALLOC 
8ee8						DMARK "MA>" 
8ee8						CALLMONITOR 
8ee8					endif 
8ee8 18 c9		      jr    malloc_find_space 
8eea			 
8eea			      ; split a bigger block into two - requested size and remaining size 
8eea			malloc_alloc_split: 
8eea					if DEBUG_FORTH_MALLOC 
8eea						DMARK "MAs" 
8eea						CALLMONITOR 
8eea					endif 
8eea eb			      ex    DE, HL                  ; Calculate address of new free block 
8eeb 2b			      dec   HL 
8eec 2b			      dec   HL 
8eed 2b			      dec   HL 
8eee 09			      add   HL, BC 
8eef			 
8eef			      ; Create a new block and point it at next_free 
8eef dd 5e 00		      ld    E, (IX+0)               ; Load next_free ptr into DE 
8ef2 dd 56 01		      ld    D, (IX+1) 
8ef5			 
8ef5 73			      ld    (HL), E                 ; Store next_free ptr into new block 
8ef6 23			      inc   HL 
8ef7 72			      ld    (HL), D 
8ef8			 
8ef8 d1			      pop   DE                      ; Store size of new block into new block 
8ef9 23			      inc   HL 
8efa 73			      ld    (HL), E 
8efb 23			      inc   HL 
8efc 72			      ld    (HL), D 
8efd			 
8efd			      ; Update this_free ptr to point to new block 
8efd 2b			      dec   HL 
8efe 2b			      dec   HL 
8eff 2b			      dec   HL 
8f00			 
8f00 dd 5e 02		      ld    E, (IX+2)               ; Take a copy of current this_free ptr 
8f03 dd 56 03		      ld    D, (IX+3) 
8f06			 
8f06 dd 75 02		      ld    (IX+2), L               ; Store new block addr as this_free ptr 
8f09 dd 74 03		      ld    (IX+3), H 
8f0c			 
8f0c			      ; Modify this_free block to be allocation 
8f0c eb			      ex    DE, HL 
8f0d af			      xor   A                       ; Null the next block ptr of allocated block 
8f0e 77			      ld    (HL), A 
8f0f 23			      inc   HL 
8f10 77			      ld    (HL), A 
8f11			 
8f11 23			      inc   HL                      ; Store want size into allocated block 
8f12 71			      ld    (HL), C 
8f13 23			      inc   HL 
8f14 70			      ld    (HL), B 
8f15 23			      inc   HL 
8f16 e5			      push  HL                      ; Address of allocation to return 
8f17			 
8f17 18 19		      jr    malloc_update_links 
8f19			 
8f19			malloc_alloc_fit: 
8f19 e1			      pop   HL                      ; Dont need new block size, want is exact fit 
8f1a			 
8f1a					if DEBUG_FORTH_MALLOC 
8f1a						DMARK "MAf" 
8f1a						CALLMONITOR 
8f1a					endif 
8f1a			      ; Modify this_free block to be allocation 
8f1a eb			      ex    DE, HL 
8f1b 2b			      dec   HL 
8f1c 2b			      dec   HL 
8f1d 2b			      dec   HL 
8f1e			 
8f1e af			      xor   A                       ; Null the next block ptr of allocated block 
8f1f 77			      ld    (HL), A 
8f20 23			      inc   HL 
8f21 77			      ld    (HL), A 
8f22			 
8f22 23			      inc   HL                      ; Store address of allocation to return 
8f23 23			      inc   HL 
8f24 23			      inc   HL 
8f25 e5			      push  HL 
8f26			 
8f26			      ; Copy next_free ptr to this_free, remove allocated block from free list 
8f26 dd 6e 00		      ld    L, (IX+0)               ; next_free to HL 
8f29 dd 66 01		      ld    H, (IX+1) 
8f2c			 
8f2c dd 75 02		      ld    (IX+2), L               ; HL to this_free 
8f2f dd 74 03		      ld    (IX+3), H 
