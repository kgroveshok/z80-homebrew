8ceb			; 
8ceb			; Get a word (16 bit) in hexadecimal notation. The result is returned in HL. 
8ceb			; Since the routines get_byte and therefore get_nibble are called, only valid 
8ceb			; characters (0-9a-f) are accepted. 
8ceb			; 
8ceb			;get_word        push    af 
8ceb			;                call    get_byte        ; Get the upper byte 
8ceb			;                ld      h, a 
8ceb			;                call    get_byte        ; Get the lower byte 
8ceb			;                ld      l, a 
8ceb			;                pop     af 
8ceb			;                ret 
8ceb			; 
8ceb			; Get a byte in hexadecimal notation. The result is returned in A. Since 
8ceb			; the routine get_nibble is used only valid characters are accepted - the  
8ceb			; input routine only accepts characters 0-9a-f. 
8ceb			; 
8ceb c5			get_byte:        push    bc              ; Save contents of B (and C) 
8cec 7e					ld a,(hl) 
8ced 23					inc hl 
8cee cd 13 8d		                call    nibble2val      ; Get upper nibble 
8cf1 cb 07		                rlc     a 
8cf3 cb 07		                rlc     a 
8cf5 cb 07		                rlc     a 
8cf7 cb 07		                rlc     a 
8cf9 47			                ld      b, a            ; Save upper four bits 
8cfa 7e					ld a,(hl) 
8cfb cd 13 8d		                call    nibble2val      ; Get lower nibble 
8cfe b0			                or      b               ; Combine both nibbles 
8cff c1			                pop     bc              ; Restore B (and C) 
8d00 c9			                ret 
