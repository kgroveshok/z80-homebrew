0b35			;-----> Generate a random number 
0b35			; output a=answer 0<=a<=255 
0b35			; all registers are preserved except: af 
0b35			random: 
0b35 e5			        push    hl 
0b36 d5			        push    de 
0b37 2a a0 eb		        ld      hl,(randData) 
0b3a ed 5f		        ld      a,r 
0b3c 57			        ld      d,a 
0b3d 5e			        ld      e,(hl) 
0b3e 19			        add     hl,de 
0b3f 85			        add     a,l 
0b40 ac			        xor     h 
0b41 22 a0 eb		        ld      (randData),hl 
0b44 d1			        pop     de 
0b45 e1			        pop     hl 
0b46 c9			        ret 
0b47			 
0b47			 
0b47			; randData here must be a 2 byte seed located in ram. While this is a fast generator, it's generally not considered very good in terms of randomness. 
0b47			 
0b47			 
0b47			 
0b47			;------LFSR------ 
0b47			;James Montelongo 
0b47			;optimized by Spencer Putt 
0b47			;out: 
0b47			; a = 8 bit random number 
0b47			RandLFSR: 
0b47 21 a6 eb		        ld hl,LFSRSeed+4 
0b4a 5e			        ld e,(hl) 
0b4b 23			        inc hl 
0b4c 56			        ld d,(hl) 
0b4d 23			        inc hl 
0b4e 4e			        ld c,(hl) 
0b4f 23			        inc hl 
0b50 7e			        ld a,(hl) 
0b51 47			        ld b,a 
0b52 cb 13		        rl e  
0b54 cb 12			rl d 
0b56 cb 11		        rl c  
0b58 17				rla 
0b59 cb 13		        rl e  
0b5b cb 12			rl d 
0b5d cb 11		        rl c  
0b5f 17				rla 
0b60 cb 13		        rl e  
0b62 cb 12			rl d 
0b64 cb 11		        rl c  
0b66 17				rla 
0b67 67			        ld h,a 
0b68 cb 13		        rl e  
0b6a cb 12			rl d 
0b6c cb 11		        rl c  
0b6e 17				rla 
0b6f a8			        xor b 
0b70 cb 13		        rl e  
0b72 cb 12			rl d 
0b74 ac			        xor h 
0b75 a9			        xor c 
0b76 aa			        xor d 
0b77 21 a8 eb		        ld hl,LFSRSeed+6 
0b7a 11 a9 eb		        ld de,LFSRSeed+7 
0b7d 01 07 00		        ld bc,7 
0b80 ed b8		        lddr 
0b82 12			        ld (de),a 
0b83 c9			        ret 
0b84			 
0b84			;While this may produces better numbers, it is slower, larger and requires a bigger seed than ionrandom. Assuming theres is a good seed to start, it should generate ~2^56 bytes before repeating. However if there is not a good seed(0 for example), then the numbers created will not be adequate. Unlike Ionrandom and its use of the r register, starting with the same seed the same numbers will be generated. With Ionrandom the code running may have an impact on the number generated. This means this method requires more initialization. 
0b84			 
0b84			;You can initialize with TI-OS's seeds, stored at seed1 and seed2, both are ti-floats but will serve the purpose.  
0b84			 
0b84			 
0b84			;This is a very fast, quality pseudo-random number generator. It combines a 16-bit Linear Feedback Shift Register and a 16-bit LCG. 
0b84			 
0b84			prng16: 
0b84			;Inputs: 
0b84			;   (seed1) contains a 16-bit seed value 
0b84			;   (seed2) contains a NON-ZERO 16-bit seed value 
0b84			;Outputs: 
0b84			;   HL is the result 
0b84			;   BC is the result of the LCG, so not that great of quality 
0b84			;   DE is preserved 
0b84			;Destroys: 
0b84			;   AF 
0b84			;cycle: 4,294,901,760 (almost 4.3 billion) 
0b84			;160cc 
0b84			;26 bytes 
0b84 2a 9a eb		    ld hl,(seed1) 
0b87 44			    ld b,h 
0b88 4d			    ld c,l 
0b89 29			    add hl,hl 
0b8a 29			    add hl,hl 
0b8b 2c			    inc l 
0b8c 09			    add hl,bc 
0b8d 22 9a eb		    ld (seed1),hl 
0b90 2a 98 eb		    ld hl,(seed2) 
0b93 29			    add hl,hl 
0b94 9f			    sbc a,a 
0b95 e6 2d		    and %00101101 
0b97 ad			    xor l 
0b98 6f			    ld l,a 
0b99 22 98 eb		    ld (seed2),hl 
0b9c 09			    add hl,bc 
0b9d c9			    ret 
0b9e			 
0b9e			;On their own, LCGs and LFSRs don't produce great results and are generally very cyclical, but they are very fast to compute. The 16-bit LCG in the above example will bounce around and reach each number from 0 to 65535, but the lower bits are far more predictable than the upper bits. The LFSR mixes up the predictability of a given bit's state, but it hits every number except 0, meaning there is a slightly higher chance of any given bit in the result being a 1 instead of a 0. It turns out that by adding together the outputs of these two generators, we can lose the predictability of a bit's state, while ensuring it has a 50% chance of being 0 or 1. As well, since the periods, 65536 and 65535 are coprime, then the overall period of the generator is 65535*65536, which is over 4 billion.  
0b9e			 
0b9e			rand32: 
0b9e			;Inputs: 
0b9e			;   (seed1_0) holds the lower 16 bits of the first seed 
0b9e			;   (seed1_1) holds the upper 16 bits of the first seed 
0b9e			;   (seed2_0) holds the lower 16 bits of the second seed 
0b9e			;   (seed2_1) holds the upper 16 bits of the second seed 
0b9e			;   **NOTE: seed2 must be non-zero 
0b9e			;Outputs: 
0b9e			;   HL is the result 
0b9e			;   BC,DE can be used as lower quality values, but are not independent of HL. 
0b9e			;Destroys: 
0b9e			;   AF 
0b9e			;Tested and passes all CAcert tests 
0b9e			;Uses a very simple 32-bit LCG and 32-bit LFSR 
0b9e			;it has a period of 18,446,744,069,414,584,320 
0b9e			;roughly 18.4 quintillion. 
0b9e			;LFSR taps: 0,2,6,7  = 11000101 
0b9e			;291cc 
0b9e			;seed1_0=$+1 
0b9e			;    ld hl,12345 
0b9e			;seed1_1=$+1 
0b9e			;    ld de,6789 
0b9e			;    ld b,h 
0b9e			;    ld c,l 
0b9e			;    add hl,hl \ rl e \ rl d 
0b9e			;    add hl,hl \ rl e \ rl d 
0b9e			;    inc l 
0b9e			;    add hl,bc 
0b9e			;    ld (seed1_0),hl 
0b9e			;    ld hl,(seed1_1) 
0b9e			;    adc hl,de 
0b9e			;    ld (seed1_1),hl 
0b9e			;    ex de,hl 
0b9e			;seed2_0=$+1 
0b9e			;    ld hl,9876 
0b9e			;seed2_1=$+1 
0b9e			;    ld bc,54321 
0b9e			;    add hl,hl \ rl c \ rl b 
0b9e			;    ld (seed2_1),bc 
0b9e			;    sbc a,a 
0b9e			;    and %11000101 
0b9e			;    xor l 
0b9e			;    ld l,a 
0b9e			;    ld (seed2_0),hl 
0b9e			;    ex de,hl 
0b9e			;    add hl,bc 
0b9e			;    ret 
0b9e			; 
0b9e			 
0b9e			; 16-bit xorshift pseudorandom number generator by John Metcalf 
0b9e			; 20 bytes, 86 cycles (excluding ret) 
0b9e			 
0b9e			; returns   hl = pseudorandom number 
0b9e			; corrupts   a 
0b9e			 
0b9e			; generates 16-bit pseudorandom numbers with a period of 65535 
0b9e			; using the xorshift method: 
0b9e			 
0b9e			; hl ^= hl << 7 
0b9e			; hl ^= hl >> 9 
0b9e			; hl ^= hl << 8 
0b9e			 
0b9e			; some alternative shift triplets which also perform well are: 
0b9e			; 6, 7, 13; 7, 9, 13; 9, 7, 13. 
0b9e			 
0b9e			;  org 32768 
0b9e			 
0b9e			xrnd: 
0b9e 2a 9e eb		  ld hl,(xrandc)       ; seed must not be 0 
0ba1 3e 00		  ld a,0 
0ba3 bd			  cp l 
0ba4 20 02		  jr nz, .xrnd1 
0ba6 2e 01		  ld l, 1 
0ba8			.xrnd1: 
0ba8			 
0ba8 7c			  ld a,h 
0ba9 1f			  rra 
0baa 7d			  ld a,l 
0bab 1f			  rra 
0bac ac			  xor h 
0bad 67			  ld h,a 
0bae 7d			  ld a,l 
0baf 1f			  rra 
0bb0 7c			  ld a,h 
0bb1 1f			  rra 
0bb2 ad			  xor l 
0bb3 6f			  ld l,a 
0bb4 ac			  xor h 
0bb5 67			  ld h,a 
0bb6			 
0bb6 22 9e eb		  ld (xrandc),hl 
0bb9			 
0bb9 c9			  ret 
