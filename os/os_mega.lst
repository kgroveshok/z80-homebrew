1200 dd 66 05		      ld    H, (IX+5) 
1203			 
1203 dd 5e 02		      ld    E, (IX+2)               ; this_free ptr to DE 
1206 dd 56 03		      ld    D, (IX+3) 
1209			 
1209 73			      ld    (HL), E                 ; this_free ptr into prev_free 
120a 23			      inc   HL 
120b 72			      ld    (HL), D 
