69e0			; **********************************************************************  
69e0			; **  Alphanumeric LCD support                  by Stephen C Cousins  **  
69e0			; **********************************************************************  
69e0			;  
69e0			; **  Written as a Small Computer Monitor App   
69e0			; **  Version 0.1 SCC 2018-05-16  
69e0			; **  www.scc.me.uk  
69e0			;  
69e0			; **********************************************************************  
69e0			;  
69e0			; This module provides support for alphanumeric LCD modules using with  
69e0			; *  HD44780 (or compatible) controller  
69e0			; *  5 x 7 pixel fonts  
69e0			; *  Up to 80 characters in total (eg. 4 lines of 20 characters)  
69e0			; *  Interface via six digital outputs to the display (see below)  
69e0			;  
69e0			; LCD module pinout:  
69e0			;   1  Vss   0v supply  
69e0			;   2  Vdd   5v supply  
69e0			;   3  Vo    LCD input voltage (near zero volts via potentiometer)  
69e0			;   4  RS    High = data, Low = instruction  
69e0			;   5  R/W   High = Read, Low = Write  
69e0			;   6  E     Enable signal (active high)  
69e0			;   7  DB0   Data bit 0  
69e0			;   8  DB1   Data bit 1  
69e0			;   9  DB2   Data bit 2  
69e0			;  10  DB3   Data bit 3  
69e0			;  11  DB4   Data bit 4  
69e0			;  12  DB5   Data bit 5  
69e0			;  13  DB6   Data bit 6  
69e0			;  14  DB7   Data bit 7  
69e0			;  15  A     Backlight anode (+)  
69e0			;  16  K     Backlight cathode (-)  
69e0			;  
69e0			; This interfacing method uses 4-bit data mode and uses time delays  
69e0			; rather than polling the display's ready status. As a result the   
69e0			; interface only requires 6 simple output lines:  
69e0			;   LCD E   = Microcomputer output port bit <kLCDBitE>  
69e0			;   LCD RS  = Microcomputer output port bit <kLCDBitRS>  
69e0			;   LCD DB4 = Microcomputer output port bit 4  
69e0			;   LCD DB5 = Microcomputer output port bit 5  
69e0			;   LCD DB6 = Microcomputer output port bit 6  
69e0			;   LCD DB7 = Microcomputer output port bit 7  
69e0			; Display's R/W is connected to 0v so it is always in write mode  
69e0			; All 6 connections must be on the same port address <kLCDPrt>  
69e0			; This method also allows a decent length of cable from micro to LCD  
69e0			;  
69e0			; **********************************************************************  
69e0			;  
69e0			; To include the code for any given function provided by this module,   
69e0			; add the appropriate #REQUIRES <FunctionName> statement at the top of   
69e0			; the parent source file.  
69e0			; For example:  #REQUIRES   uHexPrefix  
69e0			;  
69e0			; Also #INCLUDE this file at some point after the #REQUIRES statements  
69e0			; in the parent source file.  
69e0			; For example:  #INCLUDE    ..\_CodeLibrary\Utilities.asm  
69e0			;  
69e0			; These are the function names provided by this module:  
69e0			; fLCD_Init                     ;Initialise LCD  
69e0			; fLCD_Inst                     ;Send instruction to LCD  
69e0			; fLCD_Data                     ;Send data byte to LCD  
69e0			; fLCD_Pos                      ;Position cursor  
69e0			; fLCD_Str                      ;Display string  
69e0			; fLCD_Def                      ;Define custom character  
69e0			;  
69e0			; **********************************************************************  
69e0			;  
