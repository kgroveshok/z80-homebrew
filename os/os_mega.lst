6a86			;		call curptr  
6a86			;		ret  
6a86			  
6a86			  
6a86			; take current custor pos in de (d=row,e=col) and return a pointer to the frame buffer  
6a86			  
6a86			curptr:  
6a86 c5				push bc  
6a87 21 e1 fc			ld hl, display_fb0  
6a8a			cpr:	  
6a8a				; loop for cursor whole row  
6a8a 0e 28			ld c, display_cols  
6a8c 23			cpr1:	inc hl  
6a8d 0d				dec c  
6a8e 20 fc			jr nz, cpr1  
6a90 05				dec b  
6a91 20 f7			jr nz, cpr  
6a93			  
6a93				; add col	  
6a93			  
6a93 23			cpr2:	inc hl  
6a94 1d				dec e  
6a95 20 fc			jr nz, cpr2  
6a97			  
6a97 c1				pop bc  
6a98 c9				ret  
