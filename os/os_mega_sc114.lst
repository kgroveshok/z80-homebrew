901e			if MALLOC_4 
901e			 
901e			; My memory allocation code. Very very simple.... 
901e			; allocate space under 250 chars 
901e			 
901e			heap_init: 
901e				; init start of heap as zero 
901e				;  
901e			 
901e				ld hl, heap_start 
901e			;	ld a, 0 
901e				ld (hl), 0      ; empty block 
901e				inc hl 
901e			;	ld a, 0 
901e				ld (hl), 0      ; length of block 
901e				; write end of list 
901e				inc hl 
901e				ld a,(hl) 
901e				inc hl 
901e				ld a,(hl) 
901e				 
901e			 
901e				; init some malloc vars 
901e			 
901e				ld hl, 0 
901e				ld (free_list), hl       ; store last malloc location 
901e			 
901e				ld hl, free_list+3      ; flag for 'free' being used and force a rescan for reuse of block  
901e			;	ld a, 0 
901e				ld (hl), 0 
901e			 
901e			 
901e				ld hl, heap_start 
901e				;  
901e				  
901e				ret 
901e			 
901e			 
901e			;    free block marker 
901e			;    requested size  
901e			;    pointer to next block 
901e			;    .... 
901e			;    next block marker 
901e			 
901e			 
901e			; TODO add a flag that is reset on use of free. if flag is reset then start scan from start of heap otherwise use last location 
901e			; 
901e			 
901e			 
901e			malloc:  
901e				push de 
901e				push bc 
901e				push af 
901e			 
901e				; hl space required 
901e				 
901e				ld c, l    ; hold space   (TODO only a max of 255) 
901e			 
901e			;	inc c     ; TODO BUG need to fix memory leak on push str 
901e			;	inc c 
901e			;	inc c 
901e			;	inc c 
901e			;	inc c 
901e			;	inc c 
901e			;	inc c 
901e			 
901e			 
901e			 
901e				; start at heap if a free has been issued so we can reclaim it otherwise continue from last time 
901e			 
901e				ld a, (free_list+3) 
901e			;	cp 0 
901e				or a 
901e				jr z, .contheap 
901e			 
901e				ld hl, (free_list)     ; get last alloc 
901e					if DEBUG_FORTH_MALLOC_INT 
901e						DMARK "mrs" 
901e						CALLMONITOR 
901e					endif 
901e				jr .startalloc 
901e			 
901e			.contheap: 
901e				ld hl, heap_start 
901e			 
901e			.startalloc: 
901e			 
901e					if DEBUG_FORTH_MALLOC_INT 
901e						DMARK "mym" 
901e						CALLMONITOR 
901e					endif 
901e			.findblock: 
901e					if DEBUG_FORTH_MALLOC_INT 
901e						DMARK "mmf" 
901e						CALLMONITOR 
901e					endif 
901e			 
901e				ld a,(hl)  
901e				; if byte is zero then clear to use 
901e			 
901e			;	cp 0 
901e				or a 
901e				jr z, .foundemptyblock 
901e			 
901e				; if byte is not clear 
901e				;     then byte is offset to next block 
901e			 
901e				inc hl 
901e				ld a, (hl) ; get size 
901e			.nextblock:	inc hl 
901e					ld e, (hl) 
901e					inc hl 
901e					ld d, (hl) 
901e					ex de, hl 
901e			;	inc hl  ; move past the store space 
901e			;	inc hl  ; move past zero index  
901e			 
901e				; TODO detect no more space 
901e			 
901e				push hl 
901e				ld de, heap_end 
901e				call cmp16 
901e				pop hl 
901e				jr nc, .nospace 
901e			 
901e				jr .findblock 
901e			 
901e			.nospace: ld hl, 0 
901e				jp .exit 
901e			 
901e			 
901e			.foundemptyblock:	 
901e					if DEBUG_FORTH_MALLOC_INT 
901e						DMARK "mme" 
901e						CALLMONITOR 
901e					endif 
901e			 
901e			; TODO has block enough space if reusing??? 
901e			 
901e				;  
901e			 
901e			; see if this block has been previously used 
901e				inc hl 
901e				ld a, (hl) 
901e				dec hl 
901e			;	cp 0 
901e				or a 
901e				jr z, .newblock 
901e			 
901e					if DEBUG_FORTH_MALLOC_INT 
901e						DMARK "meR" 
901e						CALLMONITOR 
901e					endif 
901e			 
901e			; no reusing previously allocated block 
901e			 
901e			; is it smaller than previously used? 
901e				 
901e				inc hl    ; move to size 
901e				ld a, c 
901e				sub (hl)        ; we want c < (hl) 
901e				dec hl    ; move back to marker 
901e			        jr z, .findblock 
901e			 
901e				; update with the new size which should be lower 
901e			 
901e			        ;inc  hl   ; negate next move. move back to size  
901e			 
901e			.newblock: 
901e				; need to be at marker here 
901e			 
901e					if DEBUG_FORTH_MALLOC_INT 
901e						DMARK "meN" 
901e						CALLMONITOR 
901e					endif 
901e			 
901e			 
901e				ld a, c 
901e			 
901e				ld (free_list+3), a	 ; flag resume from last malloc  
901e				ld (free_list), hl    ; save out last location 
901e			 
901e			 
901e				;inc a     ; space for length byte 
901e				ld (hl), a     ; save block in use marker 
901e			 
901e				inc hl   ; move to space marker 
901e				ld (hl), a    ; save new space 
901e			 
901e				inc hl   ; move to start of allocated area 
901e				 
901e			;	push hl     ; save where we are - 1  
901e			 
901e			;	inc hl  ; move past zero index  
901e				; skip space to set down new marker 
901e			 
901e				; provide some extra space for now 
901e			 
901e				inc a    ; actual is one fewer than bytes requested. correct if zero index is taken into account 
901e				inc a 
901e				inc a 
901e			 
901e				push hl   ; save where we are in the node block 
901e			 
901e				call addatohl 
901e			 
901e				; write linked list point 
901e			 
901e				pop de     ; get our node position 
901e				ex de, hl 
901e			 
901e				ld (hl), e 
901e				inc hl 
901e				ld (hl), d 
901e			 
901e				inc hl 
901e			 
901e				; now at start of allocated data so save pointer 
901e			 
901e				push hl 
901e			 
901e				; jump to position of next node and setup empty header in DE 
901e			 
901e				ex de, hl 
901e			 
901e			;	inc hl ; move past end of block 
901e			 
901e			;	ld a, 0 
901e				ld (hl), 0   ; empty marker 
901e				inc hl 
901e				ld (hl), 0   ; size 
901e				inc hl  
901e				ld (hl), 0   ; ptr 
901e				inc hl 
901e				ld (hl), 0   ; ptr 
901e			 
901e			 
901e				pop hl 
901e			 
901e					if DEBUG_FORTH_MALLOC_INT 
901e						DMARK "mmr" 
901e						CALLMONITOR 
901e					endif 
901e			 
901e			.exit: 
901e				pop af 
901e				pop bc 
901e				pop de  
901e				ret 
901e			 
901e			 
901e			 
901e			 
901e			free:  
901e				push hl 
901e				push af 
901e				; get address in hl 
901e			 
901e					if DEBUG_FORTH_MALLOC_INT 
901e						DMARK "fre" 
901e						CALLMONITOR 
901e					endif 
901e				; data is at hl - move to block count 
901e				dec hl 
901e				dec hl    ; get past pointer 
901e				dec hl 
901e			 
901e				ld a, (hl)    ; need this for a validation check 
901e			 
901e				dec hl    ; move to block marker 
901e			 
901e				; now check that the block count and block marker are the same  
901e			        ; this checks that we are on a malloc node and not random memory 
901e			        ; OK a faint chance this could be a problem but rare - famous last words! 
901e			 
901e				ld c, a 
901e				ld a, (hl)    
901e			 
901e				cp c 
901e				jr nz, .freeignore      ; not a valid malloc node in use so dont break anything 
901e			 
901e				; yes good chance we are on a malloc node 
901e			 
901e			;	ld a, 0      
901e				ld (hl), 0   ; mark as free 
901e			 
901e				ld (free_list+3), a	 ; flag reuse of existing block on next malloc 
901e			 
901e			.freeignore:  
901e			 
901e				pop af 
901e				pop hl 
901e			 
901e				ret 
901e			 
901e			 
901e			 
901e			endif 
