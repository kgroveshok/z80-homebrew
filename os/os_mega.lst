1d50			include "firmware_595shiftreg.asm"  
1d50			; common code for handling a 595 shift reg out on whatever output port 
1d50			 
1d50			; port in c 
1d50			; byte in a 
1d50			 
1d50			 
1d50			shift_bit_data: equ 0 
1d50			shift_bit_clk: equ 1 
1d50			shift_bit_latch: equ 2 
1d50			 
1d50			 
1d50			; shift out a byte to the sound chip 
1d50			 
1d50			; A contains byte to send 
1d50			 
1d50			shift_byte: 
1d50			 
1d50 06 08			ld b, 8   ; 8 bits to shift 
1d52			 
1d52 16 00		.nb1:	ld d, 0    ; our work byte to send to the device with flags 
1d54			 
1d54				; set data bit state 
1d54			 
1d54 cb 7f			bit 7, a 
1d56				; high bit is set 
1d56 28 02			jr z, .nb2 
1d58 cb c2			set shift_bit_data, d 
1d5a			 
1d5a				; set latches state  
1d5a cb ca		.nb2:	set shift_bit_clk, d 
1d5c cb 92			res shift_bit_latch, d    ; latch is inverted 
1d5e ed 51			out (c), d 
1d60				 
1d60				; clock the bit out 
1d60 cb 8a			res shift_bit_clk, d 
1d62 ed 51			out (c), d 
1d64			 
1d64				; shift a left one bit and repeat 
1d64 17				rla 
1d65			 
1d65 10 eb			djnz .nb1 
1d67			 
1d67				; latch 
1d67 cb d2			set shift_bit_latch, d 
1d69 ed 51			out (c), d 
1d6b					 
1d6b			 
1d6b				; set  
1d6b c9				ret 
# End of file firmware_595shiftreg.asm
