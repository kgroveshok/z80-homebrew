18db			; 
18db			; kernel to the forth OS 
18db			 
18db			DS_TYPE_STR: equ 1     ; string type 
18db			DS_TYPE_INUM: equ 2     ; $ 16 bit unsigned int usually a hex address 
18db			DS_TYPE_SNUM: equ 3     ; $ 16 bit signed int  
18db			DS_TYPE_CONST: equ 4     ; string type that won't be freed on a POP 
18db			;DS_TYPE_FNUM: equ 3      ; 24/32 bit floating point  do string conversion instead of a new type 
18db			 
18db			FORTH_PARSEV1: equ 0 
18db			FORTH_PARSEV2: equ 0 
18db			FORTH_PARSEV3: equ 0 
18db			FORTH_PARSEV4: equ 0 
18db			FORTH_PARSEV5: equ 0 
18db			FORTH_PARSEV6: equ 1 
18db			 
18db			;if FORTH_PARSEV5 
18db			;	FORTH_END_BUFFER: equ 0 
18db			;else 
18db			FORTH_END_BUFFER: equ 127 
18db			;endif 
18db			 
18db			FORTH_TRUE: equ 1 
18db			FORTH_FALSE: equ 0 
