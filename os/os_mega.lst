1190			if MALLOC_2 
1190			; Z80 Malloc and Free Functions 
1190			 
1190			; Malloc Function: 
1190			; Input: 
1190			;   HL: Size of block to allocate 
1190			; Output: 
1190			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
1190			 
1190			malloc: 
1190				 
1190			if DEBUG_FORTH_MALLOC_HIGH 
1190			call malloc_guard_entry 
1190			endif 
1190			 
1190			 
1190			 
1190			 
1190					if DEBUG_FORTH_MALLOC 
1190						DMARK "mal" 
1190						CALLMONITOR 
1190					endif 
1190			    push af            ; Save AF register 
1190			    ld a, l            ; Load low byte of size into A 
1190			    or h               ; Check if size is zero 
1190			    jp z, malloc_exit  ; If size is zero, exit with NULL pointer 
1190			 
1190			    ; Allocate memory 
1190			    ld hl, (heap_start) ; Load start of heap into HL 
1190					if DEBUG_FORTH_MALLOC 
1190						DMARK "ma1" 
1190						CALLMONITOR 
1190					endif 
1190			    call malloc_internal ; Call internal malloc function 
1190			    pop af             ; Restore AF register 
1190			if DEBUG_FORTH_MALLOC_HIGH 
1190			call malloc_guard_exit 
1190			call malloc_guard_zerolen 
1190			endif 
1190			    ret                ; Return 
1190			 
1190			; Free Function: 
1190			; Input: 
1190			;   HL: Pointer to memory block to free 
1190			; Output: 
1190			;   None 
1190			 
1190			free: 
1190			    push af            ; Save AF register 
1190			    ld a, l            ; Load low byte of pointer into A 
1190			    or h               ; Check if pointer is NULL 
1190			    jp z, free_exit    ; If pointer is NULL, exit 
1190			 
1190			    ; Free memory 
1190			    ld hl, (heap_start) ; Load start of heap into HL 
1190			    call free_internal  ; Call internal free function 
1190			    pop af             ; Restore AF register 
1190			    ret                ; Return 
1190			 
1190			; Internal Malloc Function: 
1190			; Input: 
1190			;   HL: Size of block to allocate 
1190			; Output: 
1190			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
1190			 
1190			malloc_internal: 
1190			    ld bc, 2           ; Number of bytes to allocate for management overhead 
1190			    add hl, bc         ; Add management overhead to requested size 
1190			    ex de, hl          ; Save total size in DE, and keep it in HL 
1190					if DEBUG_FORTH_MALLOC 
1190						DMARK "ma2" 
1190						CALLMONITOR 
1190					endif 
1190			 
1190			    ; Search for free memory block 
1190			    ld de, (heap_end)  ; Load end of heap into DE 
1190			    ld bc, 0           ; Initialize counter 
1190			 
1190					if DEBUG_FORTH_MALLOC 
1190						DMARK "ma2" 
1190						CALLMONITOR 
1190					endif 
1190			malloc_search_loop: 
1190			    ; Check if current block is free 
1190			    ld a, (hl)         ; Load current block's status (free or used) 
1190			;    cp 0               ; Compare with zero (free) 
1190				or a 
1190			    jr nz, malloc_skip_block_check  ; If not free, skip to the next block 
1190			 
1190			    ; Check if current block is large enough 
1190			    ld a, (hl+1)       ; Load high byte of block size 
1190			    cp l               ; Compare with low byte of requested size 
1190			    jr nz, malloc_skip_block_check  ; If not large enough, skip to the next block 
1190			 
1190			    ld a, (hl+2)       ; Load low byte of block size 
1190			    cp h               ; Compare with high byte of requested size 
1190			    jr c, malloc_skip_block_check   ; If not large enough, skip to the next block 
1190			 
1190			    ; Mark block as used 
1190			    ld (hl), 0xFF      ; Set status byte to indicate used block 
1190			 
1190			    ; Calculate remaining space in block 
1190			    ld bc, 0           ; Clear BC 
1190			    add hl, bc         ; Increment HL to point to start of data block 
1190			    add hl, de         ; HL = HL + DE (total size) 
1190			    ld bc, 1           ; Number of bytes to allocate for management overhead 
1190			    add hl, bc         ; Add management overhead to start of data block 
1190			 
1190			    ; Save pointer to allocated block in HL 
1190			if DEBUG_FORTH_MALLOC_HIGH 
1190						DMARK "ma5" 
1190			call malloc_guard_exit 
1190			call malloc_guard_zerolen 
1190			endif 
1190			    ret 
1190			 
1190			malloc_skip_block_check: 
1190			    ; Move to the next block 
1190			    ld bc, 3           ; Size of management overhead 
1190			    add hl, bc         ; Move to the next block 
1190			    inc de             ; Increment counter 
1190			 
1190			    ; Check if we have reached the end of heap 
1190			    ld a, e            ; Load low byte of heap end address 
1190			    cp (hl)            ; Compare with low byte of current address 
1190			    jr nz, malloc_search_loop  ; If not equal, continue searching 
1190			    ld a, d            ; Load high byte of heap end address 
1190			;    cp 0               ; Check if it's zero (end of memory) 
1190				or a 
1190			    jr nz, malloc_search_loop  ; If not zero, continue searching 
1190			 
1190			    ; If we reached here, allocation failed 
1190			    xor a              ; Set result to NULL 
1190			if DEBUG_FORTH_MALLOC_HIGH 
1190						DMARK "ma6" 
1190			call malloc_guard_exit 
1190			call malloc_guard_zerolen 
1190			endif 
1190			    ret 
1190			malloc_exit: 
1190			if DEBUG_FORTH_MALLOC_HIGH 
1190						DMARK "ma7" 
1190			call malloc_guard_exit 
1190			call malloc_guard_zerolen 
1190			endif 
1190			    ret 
1190			 
1190			; Internal Free Function: 
1190			; Input: 
1190			;   HL: Pointer to memory block to free 
1190			; Output: 
1190			;   None 
1190			 
1190			free_internal: 
1190			    ld de, (heap_start) ; Load start of heap into DE 
1190			    ld bc, 0            ; Initialize counter 
1190			 
1190			free_search_loop: 
1190			    ; Check if current block contains the pointer 
1190			    ld a, l             ; Load low byte of pointer 
1190			    cp (hl+1)           ; Compare with high byte of current block's address 
1190			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
1190			    ld a, h             ; Load high byte of pointer 
1190			    cp (hl+2)           ; Compare with low byte of current block's address 
1190			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
1190			 
1190			    ; Mark block as free 
1190			    ld (hl), 0          ; Set status byte to indicate free block 
1190			    ret                 ; Return 
1190			 
1190			free_skip_block_check: 
1190			    ; Move to the next block 
1190			    ld bc, 3            ; Size of management overhead 
1190			    add hl, bc          ; Move to the next block 
1190			    inc de              ; Increment counter 
1190			 
1190			    ; Check if we have reached the end of heap 
1190			    ld a, e             ; Load low byte of heap end address 
1190			    cp (hl)             ; Compare with low byte of current address 
1190			    jr nz, free_search_loop  ; If not equal, continue searching 
1190			    ld a, d             ; Load high byte of heap end address 
1190			;    cp 0                ; Check if it's zero (end of memory) 
1190				or a 
1190			    jr nz, free_search_loop  ; If not zero, continue searching 
1190			 
1190			    ; If we reached here, pointer is not found in heap 
1190			    ret 
1190			 
1190			free_exit: 
1190			    ret                 ; Return 
1190			 
1190			; Define heap start and end addresses 
1190			;heap_start:    .dw 0xC000   ; Start of heap 
1190			;heap_end:      .dw 0xE000   ; End of heap 
1190			 
1190			endif 
