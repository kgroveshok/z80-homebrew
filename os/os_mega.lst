5348			; | VAR ( u1 -- )  Get the address of the (word) variable referenced on TOS  | DONE 
5348			; | 
5348			; | | The variable name should consist of a single letter (a-z). e.g. "a" 
5348			; | |  
5348			; | | e.g. 
5348			; | |         #30 a var ! 
5348			; | |         a var @ . 
5348			; | |   
5348			; | |     Displays the number 30 
5348			; | | 
5348			; | | Each variable pointer is a word so can use for any words that use that:  
5348			; | |  
5348			; | | e.g. 
5348			; | |  
5348			; | |         #30 a var 2! 
5348			; | |         a var 2@ . 
5348			; | |   
5348			; | |     Displays the number 30 
5348			; | |  
5348			; | | > [!NOTE]  
5348			; ! | > If a full string is passed then only the first char is looked at 
5348			; | | > Any other char could exceed bounds checks!  
5348			; | | > 
5348			; | | > Each variable location follows the previous. Watch you don't clobber any others. 
5348			 
5348					if DEBUG_FORTH_WORDS_KEY 
5348						DMARK "VAR" 
5348				if DEMARK_VERSION = 1  
5348 e5					push hl  
5349 21 51 53				ld hl, .dmark  
534c 22 9b fd				ld (debug_mark), hl  
534f				endif  
