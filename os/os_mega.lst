1190			; from https://gist.github.com/tomstorey/947a8b084bad69391a4b2a1c5b6d69ca 
1190			 
1190			;moved to firmware.asm 
1190			;heap_start        .equ  0x9000      ; Starting address of heap 
1190			;heap_size         .equ  0x0100      ; Number of bytes available in heap 
1190			 
1190			;      .org 0 
1190			;      jp    main 
1190			 
1190			 
1190			;      .org  0x100 
1190			;main: 
1190			;      ld    HL, 0x8100 
1190			;      ld    SP, HL 
1190			; 
1190			;      call  heap_init 
1190			; 
1190			;      ; Make some allocations 
1190			;      ld    HL, 12 
1190			;      call  malloc            ; Allocates 0x9004 
1190			; 
1190			;      ld    HL, 12 
1190			;      call  malloc            ; Allocates 0x9014 
1190			; 
1190			;      ld    HL, 12 
1190			;      call  malloc            ; Allocates 0x9024 
1190			; 
1190			;      ; Free some allocations 
1190			;      ld    HL, 0x9014 
1190			;      call  free 
1190			; 
1190			;      ld    HL, 0x9004 
1190			;      call  free 
1190			; 
1190			;      ld    HL, 0x9024 
1190			;      call  free 
1190			; 
1190			; 
1190			;      halt 
