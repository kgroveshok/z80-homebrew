1628 cd 3e 16			call note_send_byte 
162b cd 71 0a			call delay250ms 
162e 3e 05			ld a, SOUND_DATA | SOUND_CH0 | SOUND_TONE | 0101B 
1630 cd 3e 16			call note_send_byte 
1633 cd 71 0a			call delay250ms 
1636 c9				ret 
