905b 3a 4a ea			ld a, (tape_pulse_low) 
905e 47				ld b, a 
905f 2a 45 ea		.tl:	ld hl, (tape_tm_high) 
9062			; keep the same pulse size and instead use count of pulse rather than length of pulse 
9062			;	ld hl, (tape_tm_low) 
9062 cd 25 90			call tape_osc 
9065 10 f8			djnz .tl 
9067 c9				 ret 
9068			 
