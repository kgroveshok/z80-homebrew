0fe5			if MALLOC_2 
0fe5			; Z80 Malloc and Free Functions 
0fe5			 
0fe5			; Malloc Function: 
0fe5			; Input: 
0fe5			;   HL: Size of block to allocate 
0fe5			; Output: 
0fe5			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
0fe5			 
0fe5			malloc: 
0fe5				 
0fe5			if DEBUG_FORTH_MALLOC_HIGH 
0fe5			call malloc_guard_entry 
0fe5			endif 
0fe5			 
0fe5			 
0fe5			 
0fe5			 
0fe5					if DEBUG_FORTH_MALLOC 
0fe5						DMARK "mal" 
0fe5						CALLMONITOR 
0fe5					endif 
0fe5			    push af            ; Save AF register 
0fe5			    ld a, l            ; Load low byte of size into A 
0fe5			    or h               ; Check if size is zero 
0fe5			    jp z, malloc_exit  ; If size is zero, exit with NULL pointer 
0fe5			 
0fe5			    ; Allocate memory 
0fe5			    ld hl, (heap_start) ; Load start of heap into HL 
0fe5					if DEBUG_FORTH_MALLOC 
0fe5						DMARK "ma1" 
0fe5						CALLMONITOR 
0fe5					endif 
0fe5			    call malloc_internal ; Call internal malloc function 
0fe5			    pop af             ; Restore AF register 
0fe5			if DEBUG_FORTH_MALLOC_HIGH 
0fe5			call malloc_guard_exit 
0fe5			call malloc_guard_zerolen 
0fe5			endif 
0fe5			    ret                ; Return 
0fe5			 
0fe5			; Free Function: 
0fe5			; Input: 
0fe5			;   HL: Pointer to memory block to free 
0fe5			; Output: 
0fe5			;   None 
0fe5			 
0fe5			free: 
0fe5			    push af            ; Save AF register 
0fe5			    ld a, l            ; Load low byte of pointer into A 
0fe5			    or h               ; Check if pointer is NULL 
0fe5			    jp z, free_exit    ; If pointer is NULL, exit 
0fe5			 
0fe5			    ; Free memory 
0fe5			    ld hl, (heap_start) ; Load start of heap into HL 
0fe5			    call free_internal  ; Call internal free function 
0fe5			    pop af             ; Restore AF register 
0fe5			    ret                ; Return 
0fe5			 
0fe5			; Internal Malloc Function: 
0fe5			; Input: 
0fe5			;   HL: Size of block to allocate 
0fe5			; Output: 
0fe5			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
0fe5			 
0fe5			malloc_internal: 
0fe5			    ld bc, 2           ; Number of bytes to allocate for management overhead 
0fe5			    add hl, bc         ; Add management overhead to requested size 
0fe5			    ex de, hl          ; Save total size in DE, and keep it in HL 
0fe5					if DEBUG_FORTH_MALLOC 
0fe5						DMARK "ma2" 
0fe5						CALLMONITOR 
0fe5					endif 
0fe5			 
0fe5			    ; Search for free memory block 
0fe5			    ld de, (heap_end)  ; Load end of heap into DE 
0fe5			    ld bc, 0           ; Initialize counter 
0fe5			 
0fe5					if DEBUG_FORTH_MALLOC 
0fe5						DMARK "ma2" 
0fe5						CALLMONITOR 
0fe5					endif 
0fe5			malloc_search_loop: 
0fe5			    ; Check if current block is free 
0fe5			    ld a, (hl)         ; Load current block's status (free or used) 
0fe5			;    cp 0               ; Compare with zero (free) 
0fe5				or a 
0fe5			    jr nz, malloc_skip_block_check  ; If not free, skip to the next block 
0fe5			 
0fe5			    ; Check if current block is large enough 
0fe5			    ld a, (hl+1)       ; Load high byte of block size 
0fe5			    cp l               ; Compare with low byte of requested size 
0fe5			    jr nz, malloc_skip_block_check  ; If not large enough, skip to the next block 
0fe5			 
0fe5			    ld a, (hl+2)       ; Load low byte of block size 
0fe5			    cp h               ; Compare with high byte of requested size 
0fe5			    jr c, malloc_skip_block_check   ; If not large enough, skip to the next block 
0fe5			 
0fe5			    ; Mark block as used 
0fe5			    ld (hl), 0xFF      ; Set status byte to indicate used block 
0fe5			 
0fe5			    ; Calculate remaining space in block 
0fe5			    ld bc, 0           ; Clear BC 
0fe5			    add hl, bc         ; Increment HL to point to start of data block 
0fe5			    add hl, de         ; HL = HL + DE (total size) 
0fe5			    ld bc, 1           ; Number of bytes to allocate for management overhead 
0fe5			    add hl, bc         ; Add management overhead to start of data block 
0fe5			 
0fe5			    ; Save pointer to allocated block in HL 
0fe5			if DEBUG_FORTH_MALLOC_HIGH 
0fe5						DMARK "ma5" 
0fe5			call malloc_guard_exit 
0fe5			call malloc_guard_zerolen 
0fe5			endif 
0fe5			    ret 
0fe5			 
0fe5			malloc_skip_block_check: 
0fe5			    ; Move to the next block 
0fe5			    ld bc, 3           ; Size of management overhead 
0fe5			    add hl, bc         ; Move to the next block 
0fe5			    inc de             ; Increment counter 
0fe5			 
0fe5			    ; Check if we have reached the end of heap 
0fe5			    ld a, e            ; Load low byte of heap end address 
0fe5			    cp (hl)            ; Compare with low byte of current address 
0fe5			    jr nz, malloc_search_loop  ; If not equal, continue searching 
0fe5			    ld a, d            ; Load high byte of heap end address 
0fe5			;    cp 0               ; Check if it's zero (end of memory) 
0fe5				or a 
0fe5			    jr nz, malloc_search_loop  ; If not zero, continue searching 
0fe5			 
0fe5			    ; If we reached here, allocation failed 
0fe5			    xor a              ; Set result to NULL 
0fe5			if DEBUG_FORTH_MALLOC_HIGH 
0fe5						DMARK "ma6" 
0fe5			call malloc_guard_exit 
0fe5			call malloc_guard_zerolen 
0fe5			endif 
0fe5			    ret 
0fe5			malloc_exit: 
0fe5			if DEBUG_FORTH_MALLOC_HIGH 
0fe5						DMARK "ma7" 
0fe5			call malloc_guard_exit 
0fe5			call malloc_guard_zerolen 
0fe5			endif 
0fe5			    ret 
0fe5			 
0fe5			; Internal Free Function: 
0fe5			; Input: 
0fe5			;   HL: Pointer to memory block to free 
0fe5			; Output: 
0fe5			;   None 
0fe5			 
0fe5			free_internal: 
0fe5			    ld de, (heap_start) ; Load start of heap into DE 
0fe5			    ld bc, 0            ; Initialize counter 
0fe5			 
0fe5			free_search_loop: 
0fe5			    ; Check if current block contains the pointer 
0fe5			    ld a, l             ; Load low byte of pointer 
0fe5			    cp (hl+1)           ; Compare with high byte of current block's address 
0fe5			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
0fe5			    ld a, h             ; Load high byte of pointer 
0fe5			    cp (hl+2)           ; Compare with low byte of current block's address 
0fe5			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
0fe5			 
0fe5			    ; Mark block as free 
0fe5			    ld (hl), 0          ; Set status byte to indicate free block 
0fe5			    ret                 ; Return 
0fe5			 
0fe5			free_skip_block_check: 
0fe5			    ; Move to the next block 
0fe5			    ld bc, 3            ; Size of management overhead 
0fe5			    add hl, bc          ; Move to the next block 
0fe5			    inc de              ; Increment counter 
0fe5			 
0fe5			    ; Check if we have reached the end of heap 
0fe5			    ld a, e             ; Load low byte of heap end address 
0fe5			    cp (hl)             ; Compare with low byte of current address 
0fe5			    jr nz, free_search_loop  ; If not equal, continue searching 
0fe5			    ld a, d             ; Load high byte of heap end address 
0fe5			;    cp 0                ; Check if it's zero (end of memory) 
0fe5				or a 
0fe5			    jr nz, free_search_loop  ; If not zero, continue searching 
0fe5			 
0fe5			    ; If we reached here, pointer is not found in heap 
0fe5			    ret 
0fe5			 
0fe5			free_exit: 
0fe5			    ret                 ; Return 
0fe5			 
0fe5			; Define heap start and end addresses 
0fe5			;heap_start:    .dw 0xC000   ; Start of heap 
0fe5			;heap_end:      .dw 0xE000   ; End of heap 
0fe5			 
0fe5			endif 
