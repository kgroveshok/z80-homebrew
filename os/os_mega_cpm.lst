11d3			 
11d3					ld (store_page+STORE_0_FILERUN),a 
11d3					 
11d3					; save bank id 
11d3			 
11d3					ld a,(spi_device) 
11d3					ld (store_page+STORE_0_BANKRUN),a 
11d3			 
11d3					; enable auto run of store file 
11d3			 
11d3					ld a, 1 
11d3					ld (store_page+STORE_0_AUTOFILE),a 
11d3			 
11d3					; save buffer 
11d3			 
11d3					ld hl, 0 
11d3					ld de, store_page 
11d3					if DEBUG_FORTH_WORDS 
11d3						DMARK "ALw" 
11d3						CALLMONITOR 
11d3					endif 
11d3				call storage_write_block	 ; save update 
