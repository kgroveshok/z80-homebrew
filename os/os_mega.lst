6aef			; **********************************************************************  
6aef			  
6aef			; Write function to LCD  
6aef			;   On entry: A = Function byte to be written  
6aef			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6aef 3e 20		WrFn4bit:   LD   A, 00100000b  ;4-bit mode  
6af1 18 02		            JR   WrFunc  
6af3 3e 30		WrFn8bit:   LD   A, 00110000b  ;8-bit mode  
6af5 f5			WrFunc:     PUSH AF  
6af6 f5					push af  
6af7 3a fb fa				ld a, (display_lcde1e2)  
6afa fe 00				cp 0     ; e1  
6afc 20 0f				jr nz, .wfea2	  
6afe f1					pop af  
6aff d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b01 cb df		            SET  kLCDBitE, A     ; TODO Decide which E is being set  
6b03 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6b05 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b07 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6b09 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b0b 18 0d			jr .wfskip  
6b0d f1			.wfea2:		pop af  
6b0e d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b10 cb c7		            SET  kLCDBitE2, A     ; TODO Decide which E is being set  
6b12 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6b14 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b16 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6b18 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b1a 3e 05		.wfskip:            LD  A, 5  
6b1c cd 23 6b		            CALL LCDDelay       ;Delay 5 ms to complete  
6b1f f1			            POP  AF  
6b20 c9			            RET  
6b21			  
6b21			  
6b21			; Delay in milliseconds  
6b21			;   On entry: A = Number of milliseconds delay  
6b21			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6b21 3e 01		LCDDelay1:  LD   A, 1           ;Delay by 1 ms  
6b23 d5			LCDDelay:   PUSH DE  
6b24 5f			            LD   E, A           ;Delay by 'A' ms  
6b25 16 00		            LD   D, 0  
6b27 cd 99 0a		            CALL aDelayInMS  
6b2a d1			            POP  DE  
6b2b c9			            RET  
