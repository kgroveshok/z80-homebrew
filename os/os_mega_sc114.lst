8971			 
8971			;-----> Generate a random number 
8971			; output a=answer 0<=a<=255 
8971			; all registers are preserved except: af 
8971			random: 
8971 e5			        push    hl 
8972 d5			        push    de 
8973 2a a0 eb		        ld      hl,(randData) 
8976 ed 5f		        ld      a,r 
8978 57			        ld      d,a 
8979 5e			        ld      e,(hl) 
897a 19			        add     hl,de 
897b 85			        add     a,l 
897c ac			        xor     h 
897d 22 a0 eb		        ld      (randData),hl 
8980 d1			        pop     de 
8981 e1			        pop     hl 
8982 c9			        ret 
8983			 
8983			 
8983			; randData here must be a 2 byte seed located in ram. While this is a fast generator, it's generally not considered very good in terms of randomness. 
8983			 
8983			 
8983			 
8983			;------LFSR------ 
8983			;James Montelongo 
8983			;optimized by Spencer Putt 
8983			;out: 
8983			; a = 8 bit random number 
8983			RandLFSR: 
8983 21 a6 eb		        ld hl,LFSRSeed+4 
8986 5e			        ld e,(hl) 
8987 23			        inc hl 
8988 56			        ld d,(hl) 
8989 23			        inc hl 
898a 4e			        ld c,(hl) 
898b 23			        inc hl 
898c 7e			        ld a,(hl) 
898d 47			        ld b,a 
898e cb 13		        rl e  
8990 cb 12			rl d 
8992 cb 11		        rl c  
8994 17				rla 
8995 cb 13		        rl e  
8997 cb 12			rl d 
8999 cb 11		        rl c  
899b 17				rla 
899c cb 13		        rl e  
899e cb 12			rl d 
89a0 cb 11		        rl c  
89a2 17				rla 
89a3 67			        ld h,a 
89a4 cb 13		        rl e  
89a6 cb 12			rl d 
89a8 cb 11		        rl c  
89aa 17				rla 
89ab a8			        xor b 
89ac cb 13		        rl e  
89ae cb 12			rl d 
89b0 ac			        xor h 
89b1 a9			        xor c 
89b2 aa			        xor d 
89b3 21 a8 eb		        ld hl,LFSRSeed+6 
89b6 11 a9 eb		        ld de,LFSRSeed+7 
89b9 01 07 00		        ld bc,7 
89bc ed b8		        lddr 
89be 12			        ld (de),a 
89bf c9			        ret 
89c0			 
89c0			;While this may produces better numbers, it is slower, larger and requires a bigger seed than ionrandom. Assuming theres is a good seed to start, it should generate ~2^56 bytes before repeating. However if there is not a good seed(0 for example), then the numbers created will not be adequate. Unlike Ionrandom and its use of the r register, starting with the same seed the same numbers will be generated. With Ionrandom the code running may have an impact on the number generated. This means this method requires more initialization. 
89c0			 
89c0			;You can initialize with TI-OS's seeds, stored at seed1 and seed2, both are ti-floats but will serve the purpose.  
89c0			 
89c0			 
89c0			;This is a very fast, quality pseudo-random number generator. It combines a 16-bit Linear Feedback Shift Register and a 16-bit LCG. 
89c0			 
89c0			prng16: 
89c0			;Inputs: 
89c0			;   (seed1) contains a 16-bit seed value 
89c0			;   (seed2) contains a NON-ZERO 16-bit seed value 
89c0			;Outputs: 
89c0			;   HL is the result 
89c0			;   BC is the result of the LCG, so not that great of quality 
89c0			;   DE is preserved 
89c0			;Destroys: 
89c0			;   AF 
89c0			;cycle: 4,294,901,760 (almost 4.3 billion) 
89c0			;160cc 
89c0			;26 bytes 
89c0 2a 9a eb		    ld hl,(seed1) 
89c3 44			    ld b,h 
89c4 4d			    ld c,l 
89c5 29			    add hl,hl 
89c6 29			    add hl,hl 
89c7 2c			    inc l 
89c8 09			    add hl,bc 
89c9 22 9a eb		    ld (seed1),hl 
89cc 2a 98 eb		    ld hl,(seed2) 
89cf 29			    add hl,hl 
89d0 9f			    sbc a,a 
89d1 e6 2d		    and %00101101 
89d3 ad			    xor l 
89d4 6f			    ld l,a 
89d5 22 98 eb		    ld (seed2),hl 
89d8 09			    add hl,bc 
89d9 c9			    ret 
89da			 
89da			;On their own, LCGs and LFSRs don't produce great results and are generally very cyclical, but they are very fast to compute. The 16-bit LCG in the above example will bounce around and reach each number from 0 to 65535, but the lower bits are far more predictable than the upper bits. The LFSR mixes up the predictability of a given bit's state, but it hits every number except 0, meaning there is a slightly higher chance of any given bit in the result being a 1 instead of a 0. It turns out that by adding together the outputs of these two generators, we can lose the predictability of a bit's state, while ensuring it has a 50% chance of being 0 or 1. As well, since the periods, 65536 and 65535 are coprime, then the overall period of the generator is 65535*65536, which is over 4 billion.  
89da			 
89da			rand32: 
89da			;Inputs: 
89da			;   (seed1_0) holds the lower 16 bits of the first seed 
89da			;   (seed1_1) holds the upper 16 bits of the first seed 
89da			;   (seed2_0) holds the lower 16 bits of the second seed 
89da			;   (seed2_1) holds the upper 16 bits of the second seed 
89da			;   **NOTE: seed2 must be non-zero 
89da			;Outputs: 
89da			;   HL is the result 
89da			;   BC,DE can be used as lower quality values, but are not independent of HL. 
89da			;Destroys: 
89da			;   AF 
89da			;Tested and passes all CAcert tests 
89da			;Uses a very simple 32-bit LCG and 32-bit LFSR 
89da			;it has a period of 18,446,744,069,414,584,320 
89da			;roughly 18.4 quintillion. 
89da			;LFSR taps: 0,2,6,7  = 11000101 
89da			;291cc 
89da			;seed1_0=$+1 
89da			;    ld hl,12345 
89da			;seed1_1=$+1 
89da			;    ld de,6789 
89da			;    ld b,h 
89da			;    ld c,l 
89da			;    add hl,hl \ rl e \ rl d 
89da			;    add hl,hl \ rl e \ rl d 
89da			;    inc l 
89da			;    add hl,bc 
89da			;    ld (seed1_0),hl 
89da			;    ld hl,(seed1_1) 
89da			;    adc hl,de 
89da			;    ld (seed1_1),hl 
89da			;    ex de,hl 
89da			;seed2_0=$+1 
89da			;    ld hl,9876 
89da			;seed2_1=$+1 
89da			;    ld bc,54321 
89da			;    add hl,hl \ rl c \ rl b 
89da			;    ld (seed2_1),bc 
89da			;    sbc a,a 
89da			;    and %11000101 
89da			;    xor l 
89da			;    ld l,a 
89da			;    ld (seed2_0),hl 
89da			;    ex de,hl 
89da			;    add hl,bc 
89da			;    ret 
89da			; 
89da			 
89da			; 16-bit xorshift pseudorandom number generator by John Metcalf 
89da			; 20 bytes, 86 cycles (excluding ret) 
89da			 
89da			; returns   hl = pseudorandom number 
89da			; corrupts   a 
89da			 
89da			; generates 16-bit pseudorandom numbers with a period of 65535 
89da			; using the xorshift method: 
89da			 
89da			; hl ^= hl << 7 
89da			; hl ^= hl >> 9 
89da			; hl ^= hl << 8 
89da			 
89da			; some alternative shift triplets which also perform well are: 
89da			; 6, 7, 13; 7, 9, 13; 9, 7, 13. 
89da			 
89da			;  org 32768 
89da			 
89da			xrnd: 
89da 2a 9e eb		  ld hl,(xrandc)       ; seed must not be 0 
89dd 3e 00		  ld a,0 
89df bd			  cp l 
89e0 20 02		  jr nz, .xrnd1 
89e2 2e 01		  ld l, 1 
89e4			.xrnd1: 
89e4			 
89e4 7c			  ld a,h 
89e5 1f			  rra 
89e6 7d			  ld a,l 
89e7 1f			  rra 
89e8 ac			  xor h 
89e9 67			  ld h,a 
89ea 7d			  ld a,l 
89eb 1f			  rra 
89ec 7c			  ld a,h 
89ed 1f			  rra 
89ee ad			  xor l 
89ef 6f			  ld l,a 
89f0 ac			  xor h 
89f1 67			  ld h,a 
89f2			 
89f2 22 9e eb		  ld (xrandc),hl 
89f5			 
89f5 c9			  ret 
89f6			;  
89f6			 
89f6			 
89f6			;;;; int maths 
89f6			 
89f6			; https://map.grauw.nl/articles/mult_div_shifts.php 
89f6			; Divide 16-bit values (with 16-bit result) 
89f6			; In: Divide BC by divider DE 
89f6			; Out: BC = result, HL = rest 
89f6			; 
89f6			Div16: 
89f6 21 00 00		    ld hl,0 
89f9 78			    ld a,b 
89fa 06 08		    ld b,8 
89fc			Div16_Loop1: 
89fc 17			    rla 
89fd ed 6a		    adc hl,hl 
89ff ed 52		    sbc hl,de 
8a01 30 01		    jr nc,Div16_NoAdd1 
8a03 19			    add hl,de 
8a04			Div16_NoAdd1: 
8a04 10 f6		    djnz Div16_Loop1 
8a06 17			    rla 
8a07 2f			    cpl 
8a08 47			    ld b,a 
8a09 79			    ld a,c 
8a0a 48			    ld c,b 
8a0b 06 08		    ld b,8 
8a0d			Div16_Loop2: 
8a0d 17			    rla 
8a0e ed 6a		    adc hl,hl 
8a10 ed 52		    sbc hl,de 
8a12 30 01		    jr nc,Div16_NoAdd2 
8a14 19			    add hl,de 
8a15			Div16_NoAdd2: 
8a15 10 f6		    djnz Div16_Loop2 
8a17 17			    rla 
8a18 2f			    cpl 
8a19 41			    ld b,c 
8a1a 4f			    ld c,a 
8a1b c9			ret 
8a1c			 
8a1c			 
8a1c			;http://z80-heaven.wikidot.com/math 
8a1c			; 
8a1c			;Inputs: 
8a1c			;     DE and A are factors 
8a1c			;Outputs: 
8a1c			;     A is not changed 
8a1c			;     B is 0 
8a1c			;     C is not changed 
8a1c			;     DE is not changed 
8a1c			;     HL is the product 
8a1c			;Time: 
8a1c			;     342+6x 
8a1c			; 
8a1c			Mult16: 
8a1c			 
8a1c 06 08		     ld b,8          ;7           7 
8a1e 21 00 00		     ld hl,0         ;10         10 
8a21 29			       add hl,hl     ;11*8       88 
8a22 07			       rlca          ;4*8        32 
8a23 30 01		       jr nc,$+3     ;(12|18)*8  96+6x 
8a25 19			         add hl,de   ;--         -- 
8a26 10 f9		       djnz $-5      ;13*7+8     99 
8a28 c9			ret 
8a29			 
8a29			; 
8a29			; Square root of 16-bit value 
8a29			; In:  HL = value 
8a29			; Out:  D = result (rounded down) 
8a29			; 
8a29			;Sqr16: 
8a29			;    ld de,#0040 
8a29			;    ld a,l 
8a29			;    ld l,h 
8a29			;    ld h,d 
8a29			;    or a 
8a29			;    ld b,8 
8a29			;Sqr16_Loop: 
8a29			;    sbc hl,de 
8a29			;    jr nc,Sqr16_Skip 
8a29			;    add hl,de 
8a29			;Sqr16_Skip: 
8a29			;    ccf 
8a29			;    rl d 
8a29			;    add a,a 
8a29			;    adc hl,hl 
8a29			;    add a,a 
8a29			;    adc hl,hl 
8a29			;    djnz Sqr16_Loop 
8a29			;    ret 
8a29			; 
8a29			; 
8a29			; Divide 8-bit values 
8a29			; In: Divide E by divider C 
8a29			; Out: A = result, B = rest 
8a29			; 
8a29			Div8: 
8a29 af			    xor a 
8a2a 06 08		    ld b,8 
8a2c			Div8_Loop: 
8a2c cb 13		    rl e 
8a2e 17			    rla 
8a2f 91			    sub c 
8a30 30 01		    jr nc,Div8_NoAdd 
8a32 81			    add a,c 
8a33			Div8_NoAdd: 
8a33 10 f7		    djnz Div8_Loop 
8a35 47			    ld b,a 
8a36 7b			    ld a,e 
8a37 17			    rla 
8a38 2f			    cpl 
8a39 c9			    ret 
8a3a			 
8a3a			; 
8a3a			; Multiply 8-bit value with a 16-bit value (unrolled) 
8a3a			; In: Multiply A with DE 
8a3a			; Out: HL = result 
8a3a			; 
8a3a			Mult12U: 
8a3a 2e 00		    ld l,0 
8a3c 87			    add a,a 
8a3d 30 01		    jr nc,Mult12U_NoAdd0 
8a3f 19			    add hl,de 
8a40			Mult12U_NoAdd0: 
8a40 29			    add hl,hl 
8a41 87			    add a,a 
8a42 30 01		    jr nc,Mult12U_NoAdd1 
8a44 19			    add hl,de 
8a45			Mult12U_NoAdd1: 
8a45 29			    add hl,hl 
8a46 87			    add a,a 
8a47 30 01		    jr nc,Mult12U_NoAdd2 
8a49 19			    add hl,de 
8a4a			Mult12U_NoAdd2: 
8a4a 29			    add hl,hl 
8a4b 87			    add a,a 
8a4c 30 01		    jr nc,Mult12U_NoAdd3 
8a4e 19			    add hl,de 
8a4f			Mult12U_NoAdd3: 
8a4f 29			    add hl,hl 
8a50 87			    add a,a 
8a51 30 01		    jr nc,Mult12U_NoAdd4 
8a53 19			    add hl,de 
8a54			Mult12U_NoAdd4: 
8a54 29			    add hl,hl 
8a55 87			    add a,a 
8a56 30 01		    jr nc,Mult12U_NoAdd5 
8a58 19			    add hl,de 
8a59			Mult12U_NoAdd5: 
8a59 29			    add hl,hl 
8a5a 87			    add a,a 
8a5b 30 01		    jr nc,Mult12U_NoAdd6 
8a5d 19			    add hl,de 
8a5e			Mult12U_NoAdd6: 
8a5e 29			    add hl,hl 
8a5f 87			    add a,a 
8a60 d0			    ret nc 
8a61 19			    add hl,de 
8a62 c9			    ret 
8a63			 
8a63			; 
8a63			; Multiply 8-bit value with a 16-bit value (right rotating) 
8a63			; In: Multiply A with DE 
8a63			;      Put lowest value in A for most efficient calculation 
8a63			; Out: HL = result 
8a63			; 
8a63			Mult12R: 
8a63 21 00 00		    ld hl,0 
8a66			Mult12R_Loop: 
8a66 cb 3f		    srl a 
8a68 30 01		    jr nc,Mult12R_NoAdd 
8a6a 19			    add hl,de 
8a6b			Mult12R_NoAdd: 
8a6b cb 23		    sla e 
8a6d cb 12		    rl d 
8a6f b7			    or a 
8a70 c2 66 8a		    jp nz,Mult12R_Loop 
8a73 c9			    ret 
8a74			 
8a74			; 
8a74			; Multiply 16-bit values (with 32-bit result) 
8a74			; In: Multiply BC with DE 
8a74			; Out: BCHL = result 
8a74			; 
8a74			Mult32: 
8a74 79			    ld a,c 
8a75 48			    ld c,b 
8a76 21 00 00		    ld hl,0 
8a79 06 10		    ld b,16 
8a7b			Mult32_Loop: 
8a7b 29			    add hl,hl 
8a7c 17			    rla 
8a7d cb 11		    rl c 
8a7f 30 07		    jr nc,Mult32_NoAdd 
8a81 19			    add hl,de 
8a82 ce 00		    adc a,0 
8a84 d2 88 8a		    jp nc,Mult32_NoAdd 
8a87 0c			    inc c 
8a88			Mult32_NoAdd: 
8a88 10 f1		    djnz Mult32_Loop 
8a8a 41			    ld b,c 
8a8b 4f			    ld c,a 
8a8c c9			    ret 
