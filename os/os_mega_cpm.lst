0e4b			; 
0e4b			; Get a word (16 bit) in hexadecimal notation. The result is returned in HL. 
0e4b			; Since the routines get_byte and therefore get_nibble are called, only valid 
0e4b			; characters (0-9a-f) are accepted. 
0e4b			; 
0e4b			;get_word        push    af 
0e4b			;                call    get_byte        ; Get the upper byte 
0e4b			;                ld      h, a 
0e4b			;                call    get_byte        ; Get the lower byte 
0e4b			;                ld      l, a 
0e4b			;                pop     af 
0e4b			;                ret 
0e4b			; 
0e4b			; Get a byte in hexadecimal notation. The result is returned in A. Since 
0e4b			; the routine get_nibble is used only valid characters are accepted - the  
