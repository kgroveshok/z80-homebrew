5acf				; get file id to load from and get the file name to display 
5acf			 
5acf					ld a, (store_page+STORE_0_FILERUN) 
5acf			 
5acf					ld l, 0 
5acf					ld h, a 
5acf					ld de, store_page 
5acf			 
5acf					if DEBUG_FORTH_WORDS 
