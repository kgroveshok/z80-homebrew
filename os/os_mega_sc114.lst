9065 4f				ld c, a 
9066 16 ff			ld d, 255 
9068 3a 4b ea			ld a, (tape_pulse_high) 
906b 47				ld b, a 
906c 2a 45 ea		.th:	ld hl, (tape_tm_high) 
906f cd 45 90			call tape_osc 
9072 10 f8			djnz .th 
9074 c9				 ret 
9075			 
