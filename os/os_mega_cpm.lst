5935			; handle the auto run of code from files in storage 
5935			 
5935			 
5935			include "forth_startup.asm" 
5935			; Which startup method to use? 
5935			; 
5935			; version 1 - allows for a single stored file to be selected to run at start up (if se storage is enabled) 
5935			; followed by loading of a list of scripts in eeprom 
5935			 
5935			; version 2 - if se storage is enabled then auto load all files which begin with a '*' else use loading 
5935			; from eeprom 
5935			 
5935			; Select with define in main stubs 
5935			 
5935			if STARTUP_V1 
5935				include "forth_startupv1.asm" 
5935			; Startup script loading version 1 
5935			 
5935			; If SE storage is available first stage is to use the selected file 
5935			; then go through the eeprom list 
5935			 
5935 .. 00		sprompt1: db "Startup load...",0 
5945 .. 00		sprompt2: db "Run? 1=No *=End #=All",0 
