8e61			if MALLOC_2 
8e61			; Z80 Malloc and Free Functions 
8e61			 
8e61			; Malloc Function: 
8e61			; Input: 
8e61			;   HL: Size of block to allocate 
8e61			; Output: 
8e61			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
8e61			 
8e61			malloc: 
8e61				 
8e61			if DEBUG_FORTH_MALLOC_HIGH 
8e61			call malloc_guard_entry 
8e61			endif 
8e61			 
8e61			 
8e61			 
8e61			 
8e61					if DEBUG_FORTH_MALLOC 
8e61						DMARK "mal" 
8e61						CALLMONITOR 
8e61					endif 
8e61			    push af            ; Save AF register 
8e61			    ld a, l            ; Load low byte of size into A 
8e61			    or h               ; Check if size is zero 
8e61			    jp z, malloc_exit  ; If size is zero, exit with NULL pointer 
8e61			 
8e61			    ; Allocate memory 
8e61			    ld hl, (heap_start) ; Load start of heap into HL 
8e61					if DEBUG_FORTH_MALLOC 
8e61						DMARK "ma1" 
8e61						CALLMONITOR 
8e61					endif 
8e61			    call malloc_internal ; Call internal malloc function 
8e61			    pop af             ; Restore AF register 
8e61			if DEBUG_FORTH_MALLOC_HIGH 
8e61			call malloc_guard_exit 
8e61			call malloc_guard_zerolen 
8e61			endif 
8e61			    ret                ; Return 
8e61			 
8e61			; Free Function: 
8e61			; Input: 
8e61			;   HL: Pointer to memory block to free 
8e61			; Output: 
8e61			;   None 
8e61			 
8e61			free: 
8e61			    push af            ; Save AF register 
8e61			    ld a, l            ; Load low byte of pointer into A 
8e61			    or h               ; Check if pointer is NULL 
8e61			    jp z, free_exit    ; If pointer is NULL, exit 
8e61			 
8e61			    ; Free memory 
8e61			    ld hl, (heap_start) ; Load start of heap into HL 
8e61			    call free_internal  ; Call internal free function 
8e61			    pop af             ; Restore AF register 
8e61			    ret                ; Return 
8e61			 
8e61			; Internal Malloc Function: 
8e61			; Input: 
8e61			;   HL: Size of block to allocate 
8e61			; Output: 
8e61			;   HL: Pointer to allocated memory block (NULL if allocation fails) 
8e61			 
8e61			malloc_internal: 
8e61			    ld bc, 2           ; Number of bytes to allocate for management overhead 
8e61			    add hl, bc         ; Add management overhead to requested size 
8e61			    ex de, hl          ; Save total size in DE, and keep it in HL 
8e61					if DEBUG_FORTH_MALLOC 
8e61						DMARK "ma2" 
8e61						CALLMONITOR 
8e61					endif 
8e61			 
8e61			    ; Search for free memory block 
8e61			    ld de, (heap_end)  ; Load end of heap into DE 
8e61			    ld bc, 0           ; Initialize counter 
8e61			 
8e61					if DEBUG_FORTH_MALLOC 
8e61						DMARK "ma2" 
8e61						CALLMONITOR 
8e61					endif 
8e61			malloc_search_loop: 
8e61			    ; Check if current block is free 
8e61			    ld a, (hl)         ; Load current block's status (free or used) 
8e61			;    cp 0               ; Compare with zero (free) 
8e61				or a 
8e61			    jr nz, malloc_skip_block_check  ; If not free, skip to the next block 
8e61			 
8e61			    ; Check if current block is large enough 
8e61			    ld a, (hl+1)       ; Load high byte of block size 
8e61			    cp l               ; Compare with low byte of requested size 
8e61			    jr nz, malloc_skip_block_check  ; If not large enough, skip to the next block 
8e61			 
8e61			    ld a, (hl+2)       ; Load low byte of block size 
8e61			    cp h               ; Compare with high byte of requested size 
8e61			    jr c, malloc_skip_block_check   ; If not large enough, skip to the next block 
8e61			 
8e61			    ; Mark block as used 
8e61			    ld (hl), 0xFF      ; Set status byte to indicate used block 
8e61			 
8e61			    ; Calculate remaining space in block 
8e61			    ld bc, 0           ; Clear BC 
8e61			    add hl, bc         ; Increment HL to point to start of data block 
8e61			    add hl, de         ; HL = HL + DE (total size) 
8e61			    ld bc, 1           ; Number of bytes to allocate for management overhead 
8e61			    add hl, bc         ; Add management overhead to start of data block 
8e61			 
8e61			    ; Save pointer to allocated block in HL 
8e61			if DEBUG_FORTH_MALLOC_HIGH 
8e61						DMARK "ma5" 
8e61			call malloc_guard_exit 
8e61			call malloc_guard_zerolen 
8e61			endif 
8e61			    ret 
8e61			 
8e61			malloc_skip_block_check: 
8e61			    ; Move to the next block 
8e61			    ld bc, 3           ; Size of management overhead 
8e61			    add hl, bc         ; Move to the next block 
8e61			    inc de             ; Increment counter 
8e61			 
8e61			    ; Check if we have reached the end of heap 
8e61			    ld a, e            ; Load low byte of heap end address 
8e61			    cp (hl)            ; Compare with low byte of current address 
8e61			    jr nz, malloc_search_loop  ; If not equal, continue searching 
8e61			    ld a, d            ; Load high byte of heap end address 
8e61			;    cp 0               ; Check if it's zero (end of memory) 
8e61				or a 
8e61			    jr nz, malloc_search_loop  ; If not zero, continue searching 
8e61			 
8e61			    ; If we reached here, allocation failed 
8e61			    xor a              ; Set result to NULL 
8e61			if DEBUG_FORTH_MALLOC_HIGH 
8e61						DMARK "ma6" 
8e61			call malloc_guard_exit 
8e61			call malloc_guard_zerolen 
8e61			endif 
8e61			    ret 
8e61			malloc_exit: 
8e61			if DEBUG_FORTH_MALLOC_HIGH 
8e61						DMARK "ma7" 
8e61			call malloc_guard_exit 
8e61			call malloc_guard_zerolen 
8e61			endif 
8e61			    ret 
8e61			 
8e61			; Internal Free Function: 
8e61			; Input: 
8e61			;   HL: Pointer to memory block to free 
8e61			; Output: 
8e61			;   None 
8e61			 
8e61			free_internal: 
8e61			    ld de, (heap_start) ; Load start of heap into DE 
8e61			    ld bc, 0            ; Initialize counter 
8e61			 
8e61			free_search_loop: 
8e61			    ; Check if current block contains the pointer 
8e61			    ld a, l             ; Load low byte of pointer 
8e61			    cp (hl+1)           ; Compare with high byte of current block's address 
8e61			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
8e61			    ld a, h             ; Load high byte of pointer 
8e61			    cp (hl+2)           ; Compare with low byte of current block's address 
8e61			    jr nz, free_skip_block_check  ; If not equal, skip to the next block 
8e61			 
8e61			    ; Mark block as free 
8e61			    ld (hl), 0          ; Set status byte to indicate free block 
8e61			    ret                 ; Return 
8e61			 
8e61			free_skip_block_check: 
8e61			    ; Move to the next block 
8e61			    ld bc, 3            ; Size of management overhead 
8e61			    add hl, bc          ; Move to the next block 
8e61			    inc de              ; Increment counter 
8e61			 
8e61			    ; Check if we have reached the end of heap 
8e61			    ld a, e             ; Load low byte of heap end address 
8e61			    cp (hl)             ; Compare with low byte of current address 
8e61			    jr nz, free_search_loop  ; If not equal, continue searching 
8e61			    ld a, d             ; Load high byte of heap end address 
8e61			;    cp 0                ; Check if it's zero (end of memory) 
8e61				or a 
8e61			    jr nz, free_search_loop  ; If not zero, continue searching 
8e61			 
8e61			    ; If we reached here, pointer is not found in heap 
8e61			    ret 
8e61			 
8e61			free_exit: 
8e61			    ret                 ; Return 
8e61			 
