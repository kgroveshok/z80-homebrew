0e91			;; 	ASCII char code for 0-9,A-F in A to single hex digit 
0e91			;;    subtract $30, if result > 9 then subtract $7 more 
0e91			;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; 
0e91			atohex: 
0e91 d6 30				SUB $30 
0e93 fe 0a				CP 10 
0e95 f8					RET M		; If result negative it was 0-9 so we're done 
0e96 d6 07				SUB $7		; otherwise, subtract $7 more to get to $0A-$0F 
0e98 c9					RET		 
