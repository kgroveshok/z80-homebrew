20ca			; forth parser 
20ca			 
20ca			; My forth kernel 
20ca			include "forth_kernel.asm" 
20ca			; 
20ca			; kernel to the forth OS 
20ca			 
20ca			DS_TYPE_STR: equ 1     ; string type 
20ca			DS_TYPE_INUM: equ 2     ; $ 16 bit unsigned int usually a hex address 
20ca			DS_TYPE_SNUM: equ 3     ; $ 16 bit signed int  
20ca			DS_TYPE_CONST: equ 4     ; string type that won't be freed on a POP 
20ca			;DS_TYPE_FNUM: equ 3      ; 24/32 bit floating point  do string conversion instead of a new type 
20ca			 
20ca			FORTH_PARSEV1: equ 0 
20ca			FORTH_PARSEV2: equ 0 
20ca			FORTH_PARSEV3: equ 0 
20ca			FORTH_PARSEV4: equ 0 
20ca			FORTH_PARSEV5: equ 0 
20ca			FORTH_PARSEV6: equ 1 
20ca			 
20ca			;if FORTH_PARSEV5 
20ca			;	FORTH_END_BUFFER: equ 0 
20ca			;else 
20ca			FORTH_END_BUFFER: equ 127 
20ca			;endif 
20ca			 
20ca			FORTH_TRUE: equ 1 
20ca			FORTH_FALSE: equ 0 
20ca			 
20ca			if FORTH_PARSEV4 
20ca			include "forth_stackops.asm" 
20ca			endif 
20ca			 
20ca			if FORTH_PARSEV5 
20ca			include "forth_stackopsv5.asm" 
20ca			endif 
20ca			 
20ca			if FORTH_PARSEV6 
20ca			include "forth_stackopsv5.asm" 
20ca			 
20ca			; Stack operations for v5 parser on wards 
20ca			; * DATA stack 
20ca			; * LOOP stack 
20ca			; * RETURN stack 
20ca			 
20ca			 
20ca			 
20ca			FORTH_CHK_DSP_UNDER: macro 
20ca				push hl 
20ca				push de 
20ca				ld hl,(cli_data_sp) 
20ca				ld de, cli_data_stack 
20ca				call cmp16 
20ca				jp c, fault_dsp_under 
20ca				pop de 
20ca				pop hl 
20ca				endm 
20ca			 
20ca			 
20ca			FORTH_CHK_RSP_UNDER: macro 
20ca				push hl 
20ca				push de 
20ca				ld hl,(cli_ret_sp) 
20ca				ld de, cli_ret_stack 
20ca				call cmp16 
20ca				jp c, fault_rsp_under 
20ca				pop de 
20ca				pop hl 
20ca				endm 
20ca			 
20ca			FORTH_CHK_LOOP_UNDER: macro 
20ca				push hl 
20ca				push de 
20ca				ld hl,(cli_loop_sp) 
20ca				ld de, cli_loop_stack 
20ca				call cmp16 
20ca				jp c, fault_loop_under 
20ca				pop de 
20ca				pop hl 
20ca				endm 
20ca			 
20ca			FORTH_ERR_TOS_NOTSTR: macro 
20ca				; TOSO might need more for checks when used 
20ca				push af 
20ca				ld a,(hl) 
20ca				cp DS_TYPE_STR 
20ca				jp nz, type_faultn   
20ca				pop af 
20ca				endm 
20ca			 
20ca			FORTH_ERR_TOS_NOTNUM: macro 
20ca				push af 
20ca				ld a,(hl) 
20ca				cp DS_TYPE_INUM 
20ca				jp nz, type_faultn   
20ca				pop af 
20ca				endm 
20ca			 
20ca			 
20ca			; increase data stack pointer and save hl to it 
20ca				 
20ca			FORTH_DSP_NEXT: macro 
20ca				call macro_forth_dsp_next 
20ca				endm 
20ca			 
20ca			 
20ca			macro_forth_dsp_next: 
20ca				if DEBUG_FORTH_STACK_GUARD 
20ca cd 79 65				call check_stacks 
20cd				endif 
20cd e5				push hl 
20ce d5				push de 
20cf eb				ex de,hl 
20d0 2a 05 f9			ld hl,(cli_data_sp) 
20d3 23				inc hl 
20d4 23				inc hl 
20d5			 
20d5			; PARSEV5 
20d5 23				inc hl 
20d6 22 05 f9			ld (cli_data_sp),hl 
20d9 73				ld (hl), e 
20da 23				inc hl 
20db 72				ld (hl), d 
20dc d1				pop de 
20dd e1				pop hl 
20de				if DEBUG_FORTH_STACK_GUARD 
20de cd 79 65				call check_stacks 
20e1				endif 
20e1 c9				ret 
20e2			 
20e2			 
20e2			; increase ret stack pointer and save hl to it 
20e2				 
20e2			FORTH_RSP_NEXT: macro 
20e2				call macro_forth_rsp_next 
20e2				endm 
20e2			 
20e2			macro_forth_rsp_next: 
