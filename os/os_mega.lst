112c			malloc_guard_zerolen: 
112c				push hl 
112c				push de 
112c				push af 
112c			 
112c				ld de, 0 
112c			        call cmp16 
112c				jr nz, .lowalloz 
112c			 
112c				push hl 
112c				push de 
112c					ld hl, display_fb0 
112c					ld (display_fb_active), hl 
112c				call clear_display 
112c				ld a, 0 
112c				ld de, .malloczero 
112c				call str_at_display 
112c				call update_display 
112c				call delay1s 
112c				call delay1s 
112c				call bp_on 
112c			;	ld a, 0 
112c			;	ld (os_view_disable), a 
112c			 
112c				pop de 
112c				pop hl 
112c			 
112c				 
112c			 
112c				CALLMONITOR 
112c			.lowalloz: 
112c			 
112c			 
112c				pop af 
112c				pop de 
112c				pop hl 
112c			ret 
