0fdf			tohex: 
0fdf e5					PUSH HL 
0fe0 d5					PUSH DE 
0fe1 16 00				LD D, 0 
0fe3 5f					LD E, A 
0fe4 21 ec 0f				LD HL, .DATA 
0fe7 19					ADD HL, DE 
0fe8 7e					LD A, (HL) 
0fe9 d1					POP DE 
0fea e1					POP HL 
0feb c9					RET 
