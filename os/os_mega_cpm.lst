1211			config_fdir: 
1211				; using the scratch dir go through and release the memory allocated for each string 
1211				 
1211				ld hl, scratch 
1211			.cfdir:	ld e,(hl) 
1211				inc hl 
1211				ld d,(hl) 
1211				inc hl 
1211			 
1211				ex de, hl 
1211				call ishlzero 
1211				ret z     ; return on null pointer 
1211				call free 
1211				ex de, hl 
1211				jr .cfdir 
1211			 
1211			 
1211				ret 
1211			 
1211			 
1211			config_dir: 
1211			 
1211				; for the config menus that need to build a directory of storage call this routine 
1211				; it will construct a menu in scratch to pass to menu 
1211			 
1211				; open storage device 
1211			 
1211				; execute DIR to build a list of files and their ids into scratch in menu format 
1211				; once the menu has finished then will need to call config_fdir to release the strings 
1211				 
1211				; c = number items 
1211			 
1211				 
1211				call storage_get_block_0 
1211			 
1211				ld hl, store_page     ; get current id count 
1211				ld b, (hl) 
1211				ld c, 0    ; count of files   
1211			 
1211			 
1211				ld hl, scratch 
1211				ld (store_tmp2), hl    ; location to poke strings 
1211			 
1211				; check for empty drive 
1211			 
1211				ld a, 0 
1211				cp b 
1211				jp z, .dirdone 
1211			 
1211				 
1211					if DEBUG_FORTH_WORDS 
1211						DMARK "Cdc" 
1211						CALLMONITOR 
1211					endif 
1211			 
1211			 
1211			.diritem:	 
1211				push bc 
1211				; for each of the current ids do a search for them and if found push to stack 
1211			 
1211					ld hl, STORE_BLOCK_PHY 
1211					ld d, 0		 ; look for extent 0 of block id as this contains file name 
1211					ld e,b 
1211			 
1211					call storage_findnextid 
1211			 
1211			 
1211					; if found hl will be non zero 
1211			 
1211					call ishlzero 
1211					jr z, .dirnotfound 
1211			 
1211					; increase count 
1211			 
1211					pop bc	 
1211					inc c 
1211					push bc 
1211					 
1211			 
1211					; get file header and push the file name 
1211			 
1211					ld de, store_page 
1211					call storage_read_block 
1211			 
1211					; push file id to stack 
1211				 
1211					ld a, (store_page) 
1211					ld h, 0 
1211					ld l, a 
1211			 
1211					;call forth_push_numhl 
1211					; TODO store id 
1211			 
1211					push hl 
1211			 
1211					; push extent count to stack  
1211				 
1211					ld hl, store_page+3 
1211			 
1211					; get file name length 
1211			 
1211					call strlenz   
1211			 
1211					inc hl   ; cover zero term 
1211					inc hl  ; stick the id at the end of the area 
1211			 
1211					push hl 
1211					pop bc    ; move length to bc 
1211			 
1211					call malloc 
1211			 
1211					; TODO save malloc area to scratch 
1211			 
1211					ex de, hl 
1211					ld hl, (store_tmp2) 
1211					ld (hl), e 
1211					inc hl 
1211					ld (hl), d 
1211					inc hl 
1211					ld (store_tmp2), hl 
1211			 
1211					 
1211			 
1211					;pop hl   ; get source 
1211			;		ex de, hl    ; swap aronund	 
1211			 
1211					ld hl, store_page+3 
1211					if DEBUG_FORTH_WORDS 
1211						DMARK "CFd" 
1211						CALLMONITOR 
1211					endif 
1211					ldir 
1211			 
1211					; de is past string, move back one and store id 
1211					 
1211					dec de 
1211			 
1211					; store file id 
1211			 
1211					pop hl 
1211					ex de,hl 
1211					ld (hl), e 
1211			 
1211					if DEBUG_FORTH_WORDS 
1211						DMARK "Cdi" 
1211						CALLMONITOR 
1211					endif 
1211					 
1211			.dirnotfound: 
1211					pop bc     
1211					djnz .diritem 
1211				 
1211			.dirdone:	 
1211			 
1211			;		ld a, 0 
1211					ld hl, (store_tmp2) 
1211					ld (hl), 0 
1211					inc hl 
1211					ld (hl), 0 
1211					inc hl 
1211					; push a count of the dir items found 
1211			 
1211			;		ld h, 0 
1211			;		ld l, c 
1211			 
1211				ret 
1211			 
1211			endif 
