69b4			include "firmware_lcd_4x40.asm" 
69b4			; **********************************************************************  
69b4			; **  Alphanumeric LCD example                  by Stephen C Cousins  **  
69b4			; **********************************************************************  
69b4			;  
69b4			; **  Written as a Small Computer Monitor App  
69b4			; **  www.scc.me.uk  
69b4			;  
69b4			; History  
69b4			; 2018-05-20  v0.2.0  SCC  Example for LiNC80 SBC1 only  
69b4			; 2018-06-28  v0.3.0  SCC  Added support for RC2014 and Z280RC  
69b4			; 2019-09-14  v0.4.0  SCC  Added support for SC129 digital I/O module  
69b4			;  
69b4			; **********************************************************************  
69b4			;  
69b4			; This program is an example of one of the methods of interfacing an   
69b4			; alphanumeric LCD module.   
69b4			;  
69b4			; In this example the display is connected to either a Z80 PIO or a   
69b4			; simple 8-bit output port.   
69b4			;  
69b4			; This interfacing method uses 4-bit data mode and uses time delays  
69b4			; rather than polling the display's ready status. As a result the   
69b4			; interface only requires 6 simple output lines:  
69b4			;   Output bit 0 = not used  
69b4			;   Output bit 1 = not used  
69b4			;   Output bit 2 = RS         High = data, Low = instruction  
69b4			;   Output bit 3 = E          Active high  
69b4			;   Output bit 4 = DB4  
69b4			;   Output bit 5 = DB5  
69b4			;   Output bit 6 = DB6  
69b4			;   Output bit 7 = DB7  
69b4			; Display's R/W is connected to 0v so it is always in write mode  
69b4			;  
69b4			; This set up should work with any system supporting the RC2014 bus  
69b4			  
69b4			; To set up PIO port A in mode 3 (control) using LiNC80 as example  
69b4			;   I/O address 0x1A = 0b11001111 (0xCF)   Select mode 3 (control)  
69b4			;   I/O address 0x1A = 0b00000000 (0x00)   All pins are output  
69b4			;  
69b4			; **********************************************************************  
69b4			  
69b4			; Additonal for 4x40. E1 and E2 instead of just E   
69b4			; TODO swipe vidout signal on port a to activate E2  
69b4			  
69b4			; **********************************************************************  
69b4			; **  Constants  
69b4			; **********************************************************************  
69b4			; LCD constants required by LCD support module  
69b4			kLCDPrt:    EQU kDataReg       ;LCD port is the PIO port A data reg  
69b4			kLCDBitRS:  EQU 2              ;Port bit for LCD RS signal  
69b4			kLCDBitE:   EQU 3              ;Port bit for LCD E signal             
69b4			kLCDBitE2:   EQU 0              ;Port bit for LCD E2 signal            VICLK  
69b4			kLCDBitLED:   EQU 1              ;Port bit for LCD E2 signal            VIDDO  
69b4			; TODO Decide which E is being set  
69b4			kLCDWidth:  EQU display_cols             ;Width in characters  
69b4			  
69b4			; **********************************************************************  
69b4			; **  Code library usage  
69b4			; **********************************************************************  
69b4			  
69b4			; send character to current cursor position  
69b4			; wraps and/or scrolls screen automatically  
69b4			  
69b4			  
69b4			  
69b4			lcd_init:  
69b4			  
69b4			; SCMonAPI functions used  
69b4			  
69b4			; Alphanumeric LCD functions used  
69b4			; no need to specify specific functions for this module  
69b4			  
69b4 3e cf		            LD   A, 11001111b  
69b6 d3 c2		            OUT  (kContReg), A  ;Port A = PIO 'control' mode  
69b8 3e 00		            LD   A, 00000000b  
69ba d3 c2		            OUT  (kContReg),A   ;Port A = all lines are outputs  
69bc			  
69bc			; Initialise alphanumeric LCD module  
69bc 3e 00				ld a, 0  
69be 32 fb fa				ld (display_lcde1e2), a  
69c1 cd 42 6a		            CALL fLCD_Init      ;Initialise LCD module  
69c4 3e 01				ld a, 1  
69c6 32 fb fa				ld (display_lcde1e2), a  
