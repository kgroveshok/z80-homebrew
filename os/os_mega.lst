2634					ld (debug_mark+1),a  
2634					ld a, (.dmark+2)  
2634					ld (debug_mark+2),a  
2634				endif  
2634 18 04			jr .pastdmark  
2636 ..			.dmark: db "HEP"  
2639				if DEMARK_VERSION = 1  
2639 00					db 0  
263a				endif  
263a				if DEMARK_VERSION = 1  
263a e1			.pastdmark: pop hl  
263b				endif  
