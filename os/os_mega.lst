6afc			  
6afc			; **********************************************************************  
6afc			; **  Alphanumeric LCD support                  by Stephen C Cousins  **  
6afc			; **********************************************************************  
6afc			;  
6afc			; **  Written as a Small Computer Monitor App   
6afc			; **  Version 0.1 SCC 2018-05-16  
6afc			; **  www.scc.me.uk  
6afc			;  
6afc			; **********************************************************************  
6afc			;  
6afc			; This module provides support for alphanumeric LCD modules using with  
6afc			; *  HD44780 (or compatible) controller  
6afc			; *  5 x 7 pixel fonts  
6afc			; *  Up to 80 characters in total (eg. 4 lines of 20 characters)  
6afc			; *  Interface via six digital outputs to the display (see below)  
6afc			;  
6afc			; LCD module pinout:  
6afc			;   1  Vss   0v supply  
6afc			;   2  Vdd   5v supply  
6afc			;   3  Vo    LCD input voltage (near zero volts via potentiometer)  
6afc			;   4  RS    High = data, Low = instruction  
6afc			;   5  R/W   High = Read, Low = Write  
6afc			;   6  E     Enable signal (active high)  
6afc			;   7  DB0   Data bit 0  
6afc			;   8  DB1   Data bit 1  
6afc			;   9  DB2   Data bit 2  
6afc			;  10  DB3   Data bit 3  
6afc			;  11  DB4   Data bit 4  
6afc			;  12  DB5   Data bit 5  
6afc			;  13  DB6   Data bit 6  
6afc			;  14  DB7   Data bit 7  
6afc			;  15  A     Backlight anode (+)  
6afc			;  16  K     Backlight cathode (-)  
6afc			;  
6afc			; This interfacing method uses 4-bit data mode and uses time delays  
6afc			; rather than polling the display's ready status. As a result the   
6afc			; interface only requires 6 simple output lines:  
6afc			;   LCD E   = Microcomputer output port bit <kLCDBitE>  
6afc			;   LCD RS  = Microcomputer output port bit <kLCDBitRS>  
6afc			;   LCD DB4 = Microcomputer output port bit 4  
6afc			;   LCD DB5 = Microcomputer output port bit 5  
6afc			;   LCD DB6 = Microcomputer output port bit 6  
6afc			;   LCD DB7 = Microcomputer output port bit 7  
6afc			; Display's R/W is connected to 0v so it is always in write mode  
6afc			; All 6 connections must be on the same port address <kLCDPrt>  
6afc			; This method also allows a decent length of cable from micro to LCD  
6afc			;  
6afc			; **********************************************************************  
6afc			;  
6afc			; To include the code for any given function provided by this module,   
6afc			; add the appropriate #REQUIRES <FunctionName> statement at the top of   
6afc			; the parent source file.  
6afc			; For example:  #REQUIRES   uHexPrefix  
6afc			;  
6afc			; Also #INCLUDE this file at some point after the #REQUIRES statements  
6afc			; in the parent source file.  
6afc			; For example:  #INCLUDE    ..\_CodeLibrary\Utilities.asm  
6afc			;  
6afc			; These are the function names provided by this module:  
6afc			; fLCD_Init                     ;Initialise LCD  
6afc			; fLCD_Inst                     ;Send instruction to LCD  
6afc			; fLCD_Data                     ;Send data byte to LCD  
6afc			; fLCD_Pos                      ;Position cursor  
6afc			; fLCD_Str                      ;Display string  
6afc			; fLCD_Def                      ;Define custom character  
6afc			;  
6afc			; **********************************************************************  
6afc			;  
6afc			; Requires SCMonAPI.asm to also be included in the project  
6afc			;  
6afc			  
6afc			  
6afc			; **********************************************************************  
6afc			; **  Constants  
6afc			; **********************************************************************  
6afc			  
6afc			; Constants that must be defined externally  
6afc			;kLCDPrt:   EQU 0xc0           ;Port address used for LCD  
6afc			;kLCDBitRS: EQU 2              ;Port bit for LCD RS signal  
6afc			;kLCDBitE:  EQU 3              ;Port bit for LCD E signal  
6afc			;kLCDWidth: EQU 20             ;Width in characters  
6afc			  
6afc			; general line offsets in any frame buffer  
6afc			  
6afc			  
6afc			display_row_1: equ 0  
6afc			display_row_2: equ display_row_1+display_cols  
6afc			display_row_3: equ display_row_2 + display_cols  
6afc			display_row_4: equ display_row_3 + display_cols  
6afc			;display_row_4_eol:   
6afc			  
6afc			  
6afc			; Cursor position values for the start of each line  
6afc			  
6afc			; E  
6afc			kLCD_Line1: EQU 0x00   
6afc			kLCD_Line2: EQU kLCD_Line1+kLCDWidth  
6afc			; E1  
6afc			kLCD_Line3: EQU kLCD_Line2+kLCDWidth  
6afc			kLCD_Line4: EQU kLCD_Line3+kLCDWidth   
6afc			  
6afc			; Instructions to send as A register to fLCD_Inst  
6afc			kLCD_Clear: EQU 00000001b     ;LCD clear  
6afc			kLCD_Off:   EQU 00001000b     ;LCD off  
6afc			kLCD_On:    EQU 00001100b     ;LCD on, no cursor or blink  
6afc			kLCD_Under: EQU 00001110b     ;LCD on, cursor = underscore  
6afc			kLCD_Blink: EQU 00001101b     ;LCD on, cursor = blink block  
6afc			kLCD_Both:  EQU 00001111b     ;LCD on, cursor = under+blink  
6afc			  
6afc			; Constants used by this code module  
6afc			kLCD_Clr:   EQU 00000001b     ;LCD command: Clear display  
6afc			kLCD_Pos:   EQU 10000000b     ;LCD command: Position cursor  
6afc			kLCD_Def:   EQU 01000000b     ;LCD command: Define character  
6afc			  
6afc			  
6afc			  
6afc			; **********************************************************************  
6afc			; **  LCD support functions  
6afc			; **********************************************************************  
6afc			  
6afc			; Initialise alphanumeric LCD module  
6afc			; LCD control register codes:  
6afc			;   DL   0 = 4-bit mode        1 = 8-bit mode  
6afc			;   N    0 = 1-line mode       1 = 2-line mode  
6afc			;   F    0 = Font 5 x 8        1 = Font 5 x 11  
6afc			;   D    0 = Display off       1 = Display on  
6afc			;   C    0 = Cursor off        1 = Cursor on  
6afc			;   B    0 = Blinking off      1 = Blinking on  
6afc			;   ID   0 = Decrement mode    1 = Increment mode  
6afc			;   SH   0 = Entire shift off  1 = Entire shift on  
6afc 3e 28		fLCD_Init:  LD   A, 40  
6afe cd 3f 6c		            CALL LCDDelay       ;Delay 40ms after power up  
6b01			; For reliable reset set 8-bit mode - 3 times  
6b01 cd 0f 6c		            CALL WrFn8bit       ;Function = 8-bit mode  
6b04 cd 0f 6c		            CALL WrFn8bit       ;Function = 8-bit mode  
6b07 cd 0f 6c		            CALL WrFn8bit       ;Function = 8-bit mode  
6b0a			; Set 4-bit mode  
6b0a cd 0b 6c		            CALL WrFn4bit       ;Function = 4-bit mode  
6b0d cd 3d 6c		            CALL LCDDelay1      ;Delay 37 us or more  
6b10			; Function set  
6b10 3e 28		            LD   A, 00101000b  ;Control reg:  0  0  1  DL N  F  x  x  
6b12 cd 35 6b		            CALL fLCD_Inst      ;2 line, display on  
6b15			; Display On/Off control  
6b15 3e 0c		            LD   A, 00001100b  ;Control reg:  0  0  0  0  1  D  C  B   
6b17 cd 35 6b		            CALL fLCD_Inst      ;Display on, cursor on, blink off  
6b1a			; Display Clear  
6b1a 3e 01		            LD   A, 00000001b  ;Control reg:  0  0  0  0  0  0  0  1  
6b1c cd 35 6b		            CALL fLCD_Inst      ;Clear display  
6b1f			; Entry mode  
6b1f 3e 06		            LD   A, 00000110b  ;Control reg:  0  0  0  0  0  1  ID SH  
6b21 cd 35 6b		            CALL fLCD_Inst      ;Increment mode, shift off  
6b24			; Display module now initialised  
6b24 c9			            RET  
6b25			; ok to here  
6b25			  
6b25			; decide on setting bit for LED on or off  
6b25			; Set correct bit in A  
6b25 e5			IsLED: push hl  
6b26 21 ad fd			ld hl, hardware_word+1  
6b29 cb 56			bit 2, (hl)    ; led bit  
6b2b 20 04			jr nz, .isled1  
6b2d cb 8f			res kLCDBitLED, a  
6b2f 18 02			jr .isleddone  
6b31 cb cf		.isled1: set kLCDBitLED, a  
6b33			.isleddone:  	  
6b33 e1				pop hl  
6b34			  
6b34 c9				ret  
6b35			  
6b35			  
6b35			; Write instruction to LCD  
6b35			;   On entry: A = Instruction byte to be written  
6b35			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6b35 f5			fLCD_Inst:  PUSH AF  
6b36 f5			            PUSH AF  
6b37 cd 49 6b		            CALL Wr4bits       ;Write bits 4 to 7 of instruction  
6b3a f1			            POP  AF  
6b3b 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6b3c 17			            RLA  
6b3d 17			            RLA  
6b3e 17			            RLA  
6b3f cd 49 6b		            CALL Wr4bits       ;Write bits 0 to 3 of instruction  
6b42 3e 02		            LD   A, 2  
6b44 cd 3f 6c		            CALL LCDDelay       ;Delay 2 ms to complete   
6b47 f1			            POP  AF  
6b48 c9			            RET  
6b49			Wr4bits:   
6b49 f5					push af  
6b4a 3a fb fa				ld a, (display_lcde1e2)  
6b4d fe 00				cp 0     ; e  
6b4f 20 13				jr nz, .wea2	  
6b51 f1					pop af  
6b52 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6b54 cd 25 6b				call IsLED  
6b57 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b59 cb df		            SET  kLCDBitE, A	    ; TODO decide which E is being set  
6b5b cb 87		            res  kLCDBitE2, A	    ; TODO decide which E is being set  
6b5d d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b5f cb 9f		            RES  kLCDBitE, A        ; TODO decide which E is being set  
6b61 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b63 c9			            RET  
6b64 f1			.wea2:		pop af  
6b65 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6b67 cd 25 6b				call IsLED  
6b6a d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b6c cb c7		            SET  kLCDBitE2, A	    ; TODO decide which E is being set  
6b6e cb 9f		            res  kLCDBitE, A	    ; TODO decide which E is being set  
6b70 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b72 cb 87		            RES  kLCDBitE2, A        ; TODO decide which E is being set  
6b74 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b76 c9			            RET  
6b77			  
6b77			  
6b77			; Write data to LCD  
6b77			;   On entry: A = Data byte to be written  
6b77			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6b77 f5			fLCD_Data:  PUSH AF  
6b78 f5			            PUSH AF  
6b79 cd 8b 6b		            CALL Wr4bitsa       ;Write bits 4 to 7 of data byte  
6b7c f1			            POP  AF  
6b7d 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6b7e 17			            RLA  
6b7f 17			            RLA  
6b80 17			            RLA  
6b81 cd 8b 6b		            CALL Wr4bitsa       ;Write bits 0 to 3 of data byte  
6b84 3e 96		            LD   A, 150  
6b86 3d			Wait:      DEC  A              ;Wait a while to allow data   
6b87 20 fd		            JR   NZ, Wait      ;  write to complete  
6b89 f1			            POP  AF  
6b8a c9			            RET  
6b8b			Wr4bitsa:     
6b8b f5					push af  
6b8c 3a fb fa				ld a, (display_lcde1e2)  
6b8f fe 00				cp 0     ; e1  
6b91 20 19				jr nz, .we2	  
6b93 f1					pop af  
6b94 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6b96 cd 25 6b				call IsLED  
6b99 cb d7		            SET  kLCDBitRS, A  
6b9b d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6b9d cb df		            SET  kLCDBitE, A      ; TODO Decide which E is being set  
6b9f cb 87		            res  kLCDBitE2, A      ; TODO Decide which E is being set  
6ba1 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6ba3 cb 9f		            RES  kLCDBitE, A       ; TODO Decide which E is being set  
6ba5 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6ba7 cb 97		            RES  kLCDBitRS, A  
6ba9 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6bab c9			            RET  
6bac f1			.we2:		pop af  
6bad e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6baf cd 25 6b				call IsLED  
6bb2 cb d7		            SET  kLCDBitRS, A  
6bb4 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6bb6 cb c7		            SET  kLCDBitE2, A      ; TODO Decide which E is being set  
6bb8 cb 9f		            res  kLCDBitE, A      ; TODO Decide which E is being set  
6bba d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6bbc cb 87		            RES  kLCDBitE2, A       ; TODO Decide which E is being set  
6bbe d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6bc0 cb 97		            RES  kLCDBitRS, A  
6bc2 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6bc4 c9			            RET  
6bc5			  
6bc5			  
6bc5			; Position cursor to specified location  
6bc5			;   On entry: A = Cursor position  
6bc5			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6bc5 f5			fLCD_Pos:   PUSH AF  
6bc6					; at this point set the E1 or E2 flag depending on position  
6bc6			  
6bc6 c5					push bc  
6bc7			;		push af  
6bc7 06 00				ld b, 0  
6bc9 4f					ld c, a  
6bca 3e 4f				ld a, kLCD_Line3-1  
6bcc b7			 		or a      ;clear carry flag  
6bcd 99					sbc a,c    ; TODO may need to sub 80 from a to put in context of current frame    
6bce 38 04				jr c, .pe1  
6bd0			  
6bd0					; E selection  
6bd0 cb 80				res 0, b         ; bit 0 unset e  
6bd2			;		pop af    ; before line 3 so recover orig pos  
6bd2			;		ld c, a    ; save for poking back  
6bd2 18 06				jr .peset	          
6bd4			.pe1:          	; E2 selection  
6bd4 cb c0				set 0, b         ; bit 0 set e1  
6bd6 79					ld a, c  
6bd7 de 4f				sbc a, kLCD_Line3-1  
6bd9 4f					ld c, a	         ; save caculated offset  
6bda			;		pop af     ; bin this original value now we have calculated form  
6bda			  
6bda			.peset:		; set bit  
6bda 78					ld a, b  
6bdb 32 fb fa				ld (display_lcde1e2), a 	  
6bde 79					ld a, c  
6bdf c1					pop bc  
6be0			  
6be0 f6 80		            OR   kLCD_Pos       ;Prepare position cursor instruction  
6be2 cd 35 6b		            CALL fLCD_Inst      ;Write instruction to LCD  
6be5 f1			            POP  AF  
6be6 c9			            RET  
6be7			  
6be7			  
6be7			; Output text string to LCD  
6be7			;   On entry: DE = Pointer to null terminated text string  
6be7			;   On exit:  BC HL IX IY I AF' BC' DE' HL' preserved  
6be7 1a			fLCD_Str:   LD   A, (DE)        ;Get character from string  
6be8 b7			            OR   A              ;Null terminator?  
6be9 c8			            RET  Z              ;Yes, so finished  
6bea cd 77 6b		            CALL fLCD_Data      ;Write character to display  
6bed 13			            INC  DE             ;Point to next character  
6bee 18 f7		            JR   fLCD_Str       ;Repeat  
6bf0 c9					ret  
6bf1			  
6bf1			; Define custom character  
6bf1			;   On entry: A = Character number (0 to 7)  
6bf1			;             DE = Pointer to character bitmap data  
6bf1			;   On exit:  A = Next character number  
6bf1			;             DE = Next location following bitmap  
6bf1			;             BC HL IX IY I AF' BC' DE' HL' preserved  
6bf1			; Character is   
6bf1 c5			fLCD_Def:   PUSH BC  
6bf2 f5			            PUSH AF  
6bf3 07			            RLCA                ;Calculate location  
6bf4 07			            RLCA                ;  for bitmap data  
6bf5 07			            RLCA                ;  = 8 x CharacterNumber  
6bf6 f6 40		            OR   kLCD_Def       ;Prepare define character instruction  
6bf8 cd 35 6b		            CALL fLCD_Inst      ;Write instruction to LCD  
6bfb 06 00		            LD   B, 0  
6bfd 1a			Loop:      LD   A, (DE)        ;Get byte from bitmap  
6bfe cd 77 6b		            CALL fLCD_Data      ;Write byte to display  
6c01 13			            INC  DE             ;Point to next byte  
6c02 04			            INC  B              ;Count bytes  
6c03 cb 58		            BIT  3, B           ;Finish all 8 bytes?  
6c05 28 f6		            JR   Z, Loop       ;No, so repeat  
6c07 f1			            POP  AF  
6c08 3c			            INC  A              ;Increment character number  
6c09 c1			            POP  BC  
6c0a c9			            RET  
6c0b			  
6c0b			  
