5acf			 
5acf				call update_display 
5acf			 
5acf				call cin_wait 
5acf				cp 'n' 
5acf				ret z 
5acf				cp 'N' 
5acf				ret z 
5acf			 
5acf				call delay1s 
5acf			 
5acf				ld a, (store_page+2) 
5acf				ld (store_openmaxext), a    ; save count of ext 
5acf				ld a, 1  
5acf				ld (store_openext), a    ; save count of ext 
