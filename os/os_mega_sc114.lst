9649			include "firmware_595shiftreg.asm"  
9649			; common code for handling a 595 shift reg out on whatever output port 
9649			 
9649			; port in c 
9649			; byte in a 
9649			 
9649			 
9649			shift_bit_data: equ 0 
9649			shift_bit_clk: equ 1 
9649			shift_bit_latch: equ 2 
9649			 
9649			 
9649			; shift out a byte to the sound chip 
9649			 
9649			; A contains byte to send 
9649			 
9649			shift_byte: 
9649			 
9649 06 08			ld b, 8   ; 8 bits to shift 
964b			 
964b 16 00		.nb1:	ld d, 0    ; our work byte to send to the device with flags 
964d			 
964d				; set data bit state 
964d			 
964d cb 7f			bit 7, a 
964f				; high bit is set 
964f 28 02			jr z, .nb2 
9651 cb c2			set shift_bit_data, d 
9653			 
9653				; set latches state  
9653 cb ca		.nb2:	set shift_bit_clk, d 
9655 cb 92			res shift_bit_latch, d    ; latch is inverted 
9657 ed 51			out (c), d 
9659				 
9659				; clock the bit out 
9659 cb 8a			res shift_bit_clk, d 
965b ed 51			out (c), d 
965d			 
965d				; shift a left one bit and repeat 
965d 17				rla 
965e			 
965e 10 eb			djnz .nb1 
9660			 
9660				; latch 
9660 cb d2			set shift_bit_latch, d 
9662 ed 51			out (c), d 
9664					 
9664			 
9664				; set  
9664 c9				ret 
# End of file firmware_595shiftreg.asm
