6da5 cb 87		            res  kLCDBitE2, A      ; TODO Decide which E is being set  
6da7 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6da9 cb 9f		            RES  kLCDBitE, A       ; TODO Decide which E is being set  
6dab d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6dad cb 97		            RES  kLCDBitRS, A  
