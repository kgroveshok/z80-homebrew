57d0			chk_stk_init: 
57d0				; a vague random number to check so we dont get any "lucky" hits 
57d0 3e 2d			ld a, 45 
57d2 6f				ld l, a 
57d3 00				nop 
57d4 3e 17			ld a, 23 
57d6 67				ld h, a 
57d7			 
