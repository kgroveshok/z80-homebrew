69b3 cd a9 6a		            CALL fLCD_Pos       ;Position cursor to location in A  
69b6 06 28			ld b, display_cols  
69b8 ed 5b f9 fa		ld de, (display_write_tmp)  
69bc cd d8 69			call write_len_string  
69bf				  
69bf 2a f9 fa			ld hl, (display_write_tmp)  
69c2 11 28 00			ld de, display_cols  
69c5 19				add hl,de  
69c6 22 f9 fa			ld (display_write_tmp),hl  
69c9			  
69c9				  
69c9 3e 78			ld a, kLCD_Line4  
69cb cd a9 6a		            CALL fLCD_Pos       ;Position cursor to location in A  
69ce 06 28			ld b, display_cols  
