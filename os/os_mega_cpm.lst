0fae			 
0fae			;Comparing Strings 
0fae			 
0fae			;IN    HL     Address of string1. 
0fae			;      DE     Address of string2. 
0fae			 
0fae			; doc given but wrong??? 
0fae			;OUT   zero   Set if string1 = string2, reset if string1 != string2. 
0fae			;      carry  Set if string1 > string2, reset if string1 <= string2. 
0fae			; tested 
0fae			;OUT   carry set  if string1 = string2, carry  reset if string1 != string2. 
0fae			 
0fae			strcmp_old: 
0fae e5			    PUSH   HL 
0faf d5			    PUSH   DE 
0fb0			 
0fb0 1a			    LD     A, (DE)          ; Compare lengths to determine smaller string 
0fb1 be			    CP     (HL)            ; (want to minimize work). 
0fb2 38 01		    JR     C, Str1IsBigger 
0fb4 7e			    LD     A, (HL) 
0fb5			 
0fb5			Str1IsBigger: 
0fb5 4f			    LD     C, A             ; Put length in BC 
0fb6 06 00		    LD     B, 0 
0fb8 13			    INC    DE              ; Increment pointers to meat of string. 
0fb9 23			    INC    HL 
0fba			 
0fba			CmpLoop: 
0fba 1a			    LD     A, (DE)          ; Compare bytes. 
0fbb ed a1		    CPI 
0fbd 20 09		    JR     NZ, NoMatch      ; If (HL) != (DE), abort. 
0fbf 13			    INC    DE              ; Update pointer. 
0fc0 ea ba 0f		    JP     PE, CmpLoop 
0fc3			 
0fc3 d1			    POP    DE 
0fc4 e1			    POP    HL 
0fc5 1a			    LD     A, (DE)          ; Check string lengths to see if really equal. 
0fc6 be			    CP     (HL) 
0fc7 c9			    RET 
0fc8			 
0fc8			NoMatch: 
0fc8 2b			    DEC    HL 
0fc9 be			    CP     (HL)            ; Compare again to affect carry. 
0fca d1			    POP    DE 
0fcb e1			    POP    HL 
0fcc c9			    RET 
