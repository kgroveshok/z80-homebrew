261c				include "forth_wordsv4.asm" 
261c			 
261c			; the core word dictionary v4 
261c			; https://www.complang.tuwien.ac.at/forth/gforth/Docs-html/Notation.html#Notation 
261c			 
261c			; this is a linked list for each of the system words used 
261c			; user defined words will follow the same format but will be in ram 
261c			 
261c			 
261c			; 
261c			; 
261c			; define linked list: 
261c			; 
261c			; 1. compiled byte op code 
261c			; 2. len of text word 
261c			; 3. text word 
261c			; 4. ptr to next dictionary word 
261c			; 5. asm, calls etc for the word 
261c			; 
261c			;  if 1 == 0 then last word in dict  
261c			;   
261c			; set the start of dictionary scanning to be in ram and the last word point to the system dict 
261c			;  
261c			;  
261c			; create basic standard set of words 
261c			; 
261c			;  
261c			; + - / * DUP EMIT . SWAP IF..THEN..ELSE DO..LOOP  : ; DROP  
261c			; 2DUP 2DROP 2SWAP  
261c			; @ C@ - get byte  
261c			; ! C! - store byte 
261c			; 0< true if less than zero 
261c			; 0= true if zero 
261c			; < >  
261c			; = true if same 
261c			; variables 
261c			 
261c			 
261c			; Hardware specific words I may need 
261c			; 
261c			; IN OUT  
261c			; calls to key util functions 
261c			; calls to hardward abstraction stuff 
261c			; easy control of frame buffers and lcd i/o 
261c			; keyboard  
261c			 
261c			 
261c			;DICT: macro 
261c			; op_code, len, word, next 
261c			;    word: 
261c			;    db op_code 
261c			;    ds word zero term 
261c			;    dw next 
261c			;    endm 
261c			 
261c			 
261c			 
261c			 
261c			; op code 1 is a flag for user define words which are to be handled differently 
261c			 
261c			 
261c			; 
261c			; 
261c			;    TODO on entry to a word this should be the expected environment 
261c			;    hl - tos value if number then held, if string this is the ptr 
261c			;    de -  
261c			 
