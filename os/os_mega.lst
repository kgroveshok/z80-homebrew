4ce4				if DEMARK_VERSION = 1  
4ce4 00					db 0  
4ce5				endif  
4ce5				if DEMARK_VERSION = 1  
4ce5 e1			.pastdmark: pop hl  
4ce6				endif  
4ce6				if DEMARK_VERSION = 0  
4ce6			.pastdmark: pop af  
4ce6				endif  
4ce6			endm  
# End of macro DMARK
4ce6						CALLMONITOR 
4ce6				if BASE_CPM=1  
4ce6					call debug_vector  
4ce6				endif  
