69df			; **********************************************************************  
69df			; **  Alphanumeric LCD support                  by Stephen C Cousins  **  
69df			; **********************************************************************  
69df			;  
69df			; **  Written as a Small Computer Monitor App   
69df			; **  Version 0.1 SCC 2018-05-16  
69df			; **  www.scc.me.uk  
69df			;  
69df			; **********************************************************************  
69df			;  
69df			; This module provides support for alphanumeric LCD modules using with  
69df			; *  HD44780 (or compatible) controller  
69df			; *  5 x 7 pixel fonts  
69df			; *  Up to 80 characters in total (eg. 4 lines of 20 characters)  
69df			; *  Interface via six digital outputs to the display (see below)  
69df			;  
69df			; LCD module pinout:  
69df			;   1  Vss   0v supply  
69df			;   2  Vdd   5v supply  
69df			;   3  Vo    LCD input voltage (near zero volts via potentiometer)  
69df			;   4  RS    High = data, Low = instruction  
69df			;   5  R/W   High = Read, Low = Write  
69df			;   6  E     Enable signal (active high)  
69df			;   7  DB0   Data bit 0  
69df			;   8  DB1   Data bit 1  
69df			;   9  DB2   Data bit 2  
69df			;  10  DB3   Data bit 3  
69df			;  11  DB4   Data bit 4  
69df			;  12  DB5   Data bit 5  
69df			;  13  DB6   Data bit 6  
69df			;  14  DB7   Data bit 7  
69df			;  15  A     Backlight anode (+)  
69df			;  16  K     Backlight cathode (-)  
69df			;  
69df			; This interfacing method uses 4-bit data mode and uses time delays  
69df			; rather than polling the display's ready status. As a result the   
69df			; interface only requires 6 simple output lines:  
69df			;   LCD E   = Microcomputer output port bit <kLCDBitE>  
69df			;   LCD RS  = Microcomputer output port bit <kLCDBitRS>  
69df			;   LCD DB4 = Microcomputer output port bit 4  
69df			;   LCD DB5 = Microcomputer output port bit 5  
69df			;   LCD DB6 = Microcomputer output port bit 6  
69df			;   LCD DB7 = Microcomputer output port bit 7  
69df			; Display's R/W is connected to 0v so it is always in write mode  
69df			; All 6 connections must be on the same port address <kLCDPrt>  
69df			; This method also allows a decent length of cable from micro to LCD  
69df			;  
69df			; **********************************************************************  
69df			;  
69df			; To include the code for any given function provided by this module,   
69df			; add the appropriate #REQUIRES <FunctionName> statement at the top of   
69df			; the parent source file.  
69df			; For example:  #REQUIRES   uHexPrefix  
69df			;  
69df			; Also #INCLUDE this file at some point after the #REQUIRES statements  
69df			; in the parent source file.  
69df			; For example:  #INCLUDE    ..\_CodeLibrary\Utilities.asm  
69df			;  
69df			; These are the function names provided by this module:  
69df			; fLCD_Init                     ;Initialise LCD  
69df			; fLCD_Inst                     ;Send instruction to LCD  
69df			; fLCD_Data                     ;Send data byte to LCD  
69df			; fLCD_Pos                      ;Position cursor  
69df			; fLCD_Str                      ;Display string  
69df			; fLCD_Def                      ;Define custom character  
69df			;  
69df			; **********************************************************************  
69df			;  
69df			; Requires SCMonAPI.asm to also be included in the project  
69df			;  
69df			  
69df			  
69df			; **********************************************************************  
69df			; **  Constants  
69df			; **********************************************************************  
69df			  
69df			; Constants that must be defined externally  
69df			;kLCDPrt:   EQU 0xc0           ;Port address used for LCD  
69df			;kLCDBitRS: EQU 2              ;Port bit for LCD RS signal  
69df			;kLCDBitE:  EQU 3              ;Port bit for LCD E signal  
69df			;kLCDWidth: EQU 20             ;Width in characters  
69df			  
69df			; general line offsets in any frame buffer  
69df			  
69df			  
69df			display_row_1: equ 0  
69df			display_row_2: equ display_row_1+display_cols  
69df			display_row_3: equ display_row_2 + display_cols  
69df			display_row_4: equ display_row_3 + display_cols  
69df			;display_row_4_eol:   
69df			  
69df			  
69df			; Cursor position values for the start of each line  
69df			  
69df			; E  
69df			kLCD_Line1: EQU 0x00   
69df			kLCD_Line2: EQU kLCD_Line1+kLCDWidth  
69df			; E1  
69df			kLCD_Line3: EQU kLCD_Line2+kLCDWidth  
69df			kLCD_Line4: EQU kLCD_Line3+kLCDWidth   
69df			  
69df			; Instructions to send as A register to fLCD_Inst  
69df			kLCD_Clear: EQU 00000001b     ;LCD clear  
69df			kLCD_Off:   EQU 00001000b     ;LCD off  
69df			kLCD_On:    EQU 00001100b     ;LCD on, no cursor or blink  
69df			kLCD_Under: EQU 00001110b     ;LCD on, cursor = underscore  
69df			kLCD_Blink: EQU 00001101b     ;LCD on, cursor = blink block  
69df			kLCD_Both:  EQU 00001111b     ;LCD on, cursor = under+blink  
69df			  
69df			; Constants used by this code module  
69df			kLCD_Clr:   EQU 00000001b     ;LCD command: Clear display  
69df			kLCD_Pos:   EQU 10000000b     ;LCD command: Position cursor  
69df			kLCD_Def:   EQU 01000000b     ;LCD command: Define character  
69df			  
69df			  
69df			  
69df			; **********************************************************************  
69df			; **  LCD support functions  
69df			; **********************************************************************  
69df			  
69df			; Initialise alphanumeric LCD module  
69df			; LCD control register codes:  
69df			;   DL   0 = 4-bit mode        1 = 8-bit mode  
69df			;   N    0 = 1-line mode       1 = 2-line mode  
69df			;   F    0 = Font 5 x 8        1 = Font 5 x 11  
69df			;   D    0 = Display off       1 = Display on  
69df			;   C    0 = Cursor off        1 = Cursor on  
69df			;   B    0 = Blinking off      1 = Blinking on  
69df			;   ID   0 = Decrement mode    1 = Increment mode  
69df			;   SH   0 = Entire shift off  1 = Entire shift on  
69df 3e 28		fLCD_Init:  LD   A, 40  
69e1 cd 22 6b		            CALL LCDDelay       ;Delay 40ms after power up  
69e4			; For reliable reset set 8-bit mode - 3 times  
69e4 cd f2 6a		            CALL WrFn8bit       ;Function = 8-bit mode  
69e7 cd f2 6a		            CALL WrFn8bit       ;Function = 8-bit mode  
69ea cd f2 6a		            CALL WrFn8bit       ;Function = 8-bit mode  
69ed			; Set 4-bit mode  
69ed cd ee 6a		            CALL WrFn4bit       ;Function = 4-bit mode  
69f0 cd 20 6b		            CALL LCDDelay1      ;Delay 37 us or more  
69f3			; Function set  
69f3 3e 28		            LD   A, 00101000b  ;Control reg:  0  0  1  DL N  F  x  x  
69f5 cd 18 6a		            CALL fLCD_Inst      ;2 line, display on  
69f8			; Display On/Off control  
69f8 3e 0c		            LD   A, 00001100b  ;Control reg:  0  0  0  0  1  D  C  B   
69fa cd 18 6a		            CALL fLCD_Inst      ;Display on, cursor on, blink off  
69fd			; Display Clear  
69fd 3e 01		            LD   A, 00000001b  ;Control reg:  0  0  0  0  0  0  0  1  
69ff cd 18 6a		            CALL fLCD_Inst      ;Clear display  
6a02			; Entry mode  
6a02 3e 06		            LD   A, 00000110b  ;Control reg:  0  0  0  0  0  1  ID SH  
6a04 cd 18 6a		            CALL fLCD_Inst      ;Increment mode, shift off  
6a07			; Display module now initialised  
6a07 c9			            RET  
6a08			; ok to here  
6a08			  
6a08			; decide on setting bit for LED on or off  
6a08			; Set correct bit in A  
6a08 e5			IsLED: push hl  
6a09 21 ad fd			ld hl, hardware_word+1  
6a0c cb 56			bit 2, (hl)    ; led bit  
6a0e 20 04			jr nz, .isled1  
6a10 cb 8f			res kLCDBitLED, a  
6a12 18 02			jr .isleddone  
6a14 cb cf		.isled1: set kLCDBitLED, a  
6a16			.isleddone:  	  
6a16 e1				pop hl  
6a17			  
6a17 c9				ret  
6a18			  
6a18			  
6a18			; Write instruction to LCD  
6a18			;   On entry: A = Instruction byte to be written  
6a18			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6a18 f5			fLCD_Inst:  PUSH AF  
6a19 f5			            PUSH AF  
6a1a cd 2c 6a		            CALL Wr4bits       ;Write bits 4 to 7 of instruction  
6a1d f1			            POP  AF  
6a1e 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6a1f 17			            RLA  
6a20 17			            RLA  
6a21 17			            RLA  
6a22 cd 2c 6a		            CALL Wr4bits       ;Write bits 0 to 3 of instruction  
6a25 3e 02		            LD   A, 2  
6a27 cd 22 6b		            CALL LCDDelay       ;Delay 2 ms to complete   
6a2a f1			            POP  AF  
6a2b c9			            RET  
6a2c			Wr4bits:   
6a2c f5					push af  
6a2d 3a fb fa				ld a, (display_lcde1e2)  
6a30 fe 00				cp 0     ; e  
6a32 20 13				jr nz, .wea2	  
6a34 f1					pop af  
6a35 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6a37 cd 08 6a				call IsLED  
6a3a d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a3c cb df		            SET  kLCDBitE, A	    ; TODO decide which E is being set  
6a3e cb 87		            res  kLCDBitE2, A	    ; TODO decide which E is being set  
6a40 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6a42 cb 9f		            RES  kLCDBitE, A        ; TODO decide which E is being set  
6a44 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a46 c9			            RET  
6a47 f1			.wea2:		pop af  
6a48 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6a4a cd 08 6a				call IsLED  
6a4d d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a4f cb c7		            SET  kLCDBitE2, A	    ; TODO decide which E is being set  
6a51 cb 9f		            res  kLCDBitE, A	    ; TODO decide which E is being set  
6a53 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6a55 cb 87		            RES  kLCDBitE2, A        ; TODO decide which E is being set  
6a57 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a59 c9			            RET  
6a5a			  
6a5a			  
6a5a			; Write data to LCD  
6a5a			;   On entry: A = Data byte to be written  
6a5a			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6a5a f5			fLCD_Data:  PUSH AF  
6a5b f5			            PUSH AF  
6a5c cd 6e 6a		            CALL Wr4bitsa       ;Write bits 4 to 7 of data byte  
6a5f f1			            POP  AF  
6a60 17			            RLA                 ;Rotate bits 0-3 into bits 4-7...  
6a61 17			            RLA  
6a62 17			            RLA  
6a63 17			            RLA  
6a64 cd 6e 6a		            CALL Wr4bitsa       ;Write bits 0 to 3 of data byte  
6a67 3e 96		            LD   A, 150  
6a69 3d			Wait:      DEC  A              ;Wait a while to allow data   
6a6a 20 fd		            JR   NZ, Wait      ;  write to complete  
6a6c f1			            POP  AF  
6a6d c9			            RET  
6a6e			Wr4bitsa:     
6a6e f5					push af  
6a6f 3a fb fa				ld a, (display_lcde1e2)  
6a72 fe 00				cp 0     ; e1  
6a74 20 19				jr nz, .we2	  
6a76 f1					pop af  
6a77 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6a79 cd 08 6a				call IsLED  
6a7c cb d7		            SET  kLCDBitRS, A  
6a7e d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6a80 cb df		            SET  kLCDBitE, A      ; TODO Decide which E is being set  
6a82 cb 87		            res  kLCDBitE2, A      ; TODO Decide which E is being set  
6a84 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6a86 cb 9f		            RES  kLCDBitE, A       ; TODO Decide which E is being set  
6a88 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6a8a cb 97		            RES  kLCDBitRS, A  
6a8c d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6a8e c9			            RET  
6a8f f1			.we2:		pop af  
6a90 e6 f0			    AND  0xF0           ;Mask so we only have D4 to D7  
6a92 cd 08 6a				call IsLED  
6a95 cb d7		            SET  kLCDBitRS, A  
6a97 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6a99 cb c7		            SET  kLCDBitE2, A      ; TODO Decide which E is being set  
6a9b cb 9f		            res  kLCDBitE, A      ; TODO Decide which E is being set  
6a9d d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=High  
6a9f cb 87		            RES  kLCDBitE2, A       ; TODO Decide which E is being set  
6aa1 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=High  
6aa3 cb 97		            RES  kLCDBitRS, A  
6aa5 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6aa7 c9			            RET  
6aa8			  
6aa8			  
6aa8			; Position cursor to specified location  
6aa8			;   On entry: A = Cursor position  
6aa8			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6aa8 f5			fLCD_Pos:   PUSH AF  
6aa9					; at this point set the E1 or E2 flag depending on position  
6aa9			  
6aa9 c5					push bc  
6aaa			;		push af  
6aaa 06 00				ld b, 0  
6aac 4f					ld c, a  
6aad 3e 4f				ld a, kLCD_Line3-1  
6aaf b7			 		or a      ;clear carry flag  
6ab0 99					sbc a,c    ; TODO may need to sub 80 from a to put in context of current frame    
6ab1 38 04				jr c, .pe1  
6ab3			  
6ab3					; E selection  
6ab3 cb 80				res 0, b         ; bit 0 unset e  
6ab5			;		pop af    ; before line 3 so recover orig pos  
6ab5			;		ld c, a    ; save for poking back  
6ab5 18 06				jr .peset	          
6ab7			.pe1:          	; E2 selection  
6ab7 cb c0				set 0, b         ; bit 0 set e1  
6ab9 79					ld a, c  
6aba de 4f				sbc a, kLCD_Line3-1  
6abc 4f					ld c, a	         ; save caculated offset  
6abd			;		pop af     ; bin this original value now we have calculated form  
6abd			  
6abd			.peset:		; set bit  
6abd 78					ld a, b  
6abe 32 fb fa				ld (display_lcde1e2), a 	  
6ac1 79					ld a, c  
6ac2 c1					pop bc  
6ac3			  
6ac3 f6 80		            OR   kLCD_Pos       ;Prepare position cursor instruction  
6ac5 cd 18 6a		            CALL fLCD_Inst      ;Write instruction to LCD  
6ac8 f1			            POP  AF  
6ac9 c9			            RET  
6aca			  
6aca			  
6aca			; Output text string to LCD  
6aca			;   On entry: DE = Pointer to null terminated text string  
6aca			;   On exit:  BC HL IX IY I AF' BC' DE' HL' preserved  
6aca 1a			fLCD_Str:   LD   A, (DE)        ;Get character from string  
6acb b7			            OR   A              ;Null terminator?  
6acc c8			            RET  Z              ;Yes, so finished  
6acd cd 5a 6a		            CALL fLCD_Data      ;Write character to display  
6ad0 13			            INC  DE             ;Point to next character  
6ad1 18 f7		            JR   fLCD_Str       ;Repeat  
6ad3 c9					ret  
6ad4			  
6ad4			; Define custom character  
6ad4			;   On entry: A = Character number (0 to 7)  
6ad4			;             DE = Pointer to character bitmap data  
6ad4			;   On exit:  A = Next character number  
6ad4			;             DE = Next location following bitmap  
6ad4			;             BC HL IX IY I AF' BC' DE' HL' preserved  
6ad4			; Character is   
6ad4 c5			fLCD_Def:   PUSH BC  
6ad5 f5			            PUSH AF  
6ad6 07			            RLCA                ;Calculate location  
6ad7 07			            RLCA                ;  for bitmap data  
6ad8 07			            RLCA                ;  = 8 x CharacterNumber  
6ad9 f6 40		            OR   kLCD_Def       ;Prepare define character instruction  
6adb cd 18 6a		            CALL fLCD_Inst      ;Write instruction to LCD  
6ade 06 00		            LD   B, 0  
6ae0 1a			Loop:      LD   A, (DE)        ;Get byte from bitmap  
6ae1 cd 5a 6a		            CALL fLCD_Data      ;Write byte to display  
6ae4 13			            INC  DE             ;Point to next byte  
6ae5 04			            INC  B              ;Count bytes  
6ae6 cb 58		            BIT  3, B           ;Finish all 8 bytes?  
6ae8 28 f6		            JR   Z, Loop       ;No, so repeat  
6aea f1			            POP  AF  
6aeb 3c			            INC  A              ;Increment character number  
6aec c1			            POP  BC  
6aed c9			            RET  
6aee			  
6aee			  
6aee			; **********************************************************************  
6aee			; **  Private functions  
6aee			; **********************************************************************  
6aee			  
6aee			; Write function to LCD  
6aee			;   On entry: A = Function byte to be written  
6aee			;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved  
6aee 3e 20		WrFn4bit:   LD   A, 00100000b  ;4-bit mode  
6af0 18 02		            JR   WrFunc  
6af2 3e 30		WrFn8bit:   LD   A, 00110000b  ;8-bit mode  
6af4 f5			WrFunc:     PUSH AF  
6af5 f5					push af  
6af6 3a fb fa				ld a, (display_lcde1e2)  
6af9 fe 00				cp 0     ; e1  
6afb 20 0f				jr nz, .wfea2	  
6afd f1					pop af  
6afe d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b00 cb df		            SET  kLCDBitE, A     ; TODO Decide which E is being set  
6b02 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6b04 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b06 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6b08 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b0a 18 0d			jr .wfskip  
6b0c f1			.wfea2:		pop af  
6b0d d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b0f cb c7		            SET  kLCDBitE2, A     ; TODO Decide which E is being set  
6b11 cb 9f		            RES  kLCDBitE, A      ; TODO Decide which E is being set  
6b13 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=High and RS=Low  
6b15 cb 87		            RES  kLCDBitE2, A      ; TODO Decide which E is being set  
6b17 d3 c0		            OUT  (kLCDPrt), A   ;Output with E=Low and RS=Low  
6b19 3e 05		.wfskip:            LD  A, 5  
6b1b cd 22 6b		            CALL LCDDelay       ;Delay 5 ms to complete  
