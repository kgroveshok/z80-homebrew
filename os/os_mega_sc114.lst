8d71			;Number in a to decimal ASCII 
8d71			;adapted from 16 bit found in z80 Bits to 8 bit by Galandros 
8d71			;Example: display a=56 as "056" 
8d71			;input: a = number 
8d71			;Output: a=0,value of a in the screen 
8d71			;destroys af,bc (don't know about hl and de) 
8d71			DispAToASCII: 
8d71 0e 9c			ld	c,-100 
8d73 cd 7d 8d			call	.Na1 
8d76 0e f6			ld	c,-10 
8d78 cd 7d 8d			call	.Na1 
8d7b 0e ff			ld	c,-1 
8d7d 06 2f		.Na1:	ld	b,'0'-1 
8d7f 04			.Na2:	inc	b 
8d80 81				add	a,c 
8d81 38 fc			jr	c,.Na2 
8d83 91				sub	c		;works as add 100/10/1 
8d84 f5				push af		;safer than ld c,a 
8d85 78				ld	a,b		;char is in b 
8d86			;TODO	CALL	PUTCHAR	;plot a char. Replace with bcall(_PutC) or similar. 
8d86 f1				pop af		;safer than ld a,c 
8d87 c9				ret 
8d88			 
8d88			; Decimal Signed Version 
8d88			 
8d88			; DispA 
8d88			; -------------------------------------------------------------- 
8d88			; Converts a signed integer value to a zero-terminated ASCII 
8d88			; string representative of that value (using radix 10). 
8d88			; -------------------------------------------------------------- 
8d88			; INPUTS: 
8d88			;     HL     Value to convert (two's complement integer). 
8d88			;     DE     Base address of string destination. (pointer). 
8d88			; -------------------------------------------------------------- 
8d88			; OUTPUTS: 
8d88			;     None 
8d88			; -------------------------------------------------------------- 
8d88			; REGISTERS/MEMORY DESTROYED 
8d88			; AF HL 
8d88			; -------------------------------------------------------------- 
8d88			 
8d88			;DispHLToASCII: 
8d88			;   push    de 
8d88			;   push    bc 
8d88			; 
8d88			;; Detect sign of HL. 
8d88			;    bit    7, h 
8d88			;    jr     z, ._DoConvert 
8d88			; 
8d88			;; HL is negative. Output '-' to string and negate HL. 
8d88			;    ld     a, '-' 
8d88			;    ld     (de), a 
8d88			;    inc    de 
8d88			; 
8d88			;; Negate HL (using two's complement) 
8d88			;    xor    a 
8d88			;    sub    l 
8d88			;    ld     l, a 
8d88			;    ld     a, 0     ; Note that XOR A or SUB A would disturb CF 
8d88			;    sbc    a, h 
8d88			;    ld     h, a 
8d88			; 
8d88			;; Convert HL to digit characters 
8d88			;._DoConvert: 
8d88			;    ld     b, 0     ; B will count character length of number 
8d88			;-   ld     a, 10 
8d88			;    syscall  .DivHLByA  ; HL = HL / A, A = remainder 
8d88			;    push   af 
8d88			;    inc    b 
8d88			;    ld     a, h 
8d88			;    or     l 
8d88			;    jr     nz, - 
8d88			; 
8d88			;; Retrieve digits from stack 
8d88			;-   pop    af 
8d88			;    or     $30 
8d88			;    ld     (de), a 
8d88			;    inc    de 
8d88			;    djnz   - 
8d88			; 
8d88			;; Terminate string with NULL 
8d88			;    xor    a 
8d88			;    ld     (de), a 
8d88			; 
8d88			;    pop    bc 
8d88			;    pop    de 
8d88			;    ret 
8d88			 
8d88			;Comments 
8d88			; 
8d88			;    This routine uses the common positive-integer radix conversion algorithm of repeatedly dividing a value by the desired radix (base case: the value is zero) and saving the remainders of each division. 
8d88			;    As this algorithm gives the digits in reverse order, they are pushed onto the hardware stack so that subsequently popping them yields the correct order. 
8d88			;    Note that the output string will not be fixed-width. 
8d88			; 
8d88			;Example Usage 
8d88			; 
8d88			;    ld    hl, -1004 
8d88			;    ld    de, OP1 
8d88			;    call  DispA 
8d88			;    ld    hl, OP1 
8d88			;    syscall  PutS 
8d88			 
8d88			 
8d88			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/string_to_uint16.z80 
8d88			 
8d88			 
8d88			;Converts an ASCII string to an unsigned 16-bit integer 
8d88			;Quits when it reaches a non-decimal digit 
8d88			 
8d88			string_to_uint16: 
8d88			atoui_16: 
8d88			;Input: 
8d88			;     DE points to the string 
8d88			;Outputs: 
8d88			;     HL is the result 
8d88			;     A is the 8-bit value of the number 
8d88			;     DE points to the byte after the number 
8d88			;Destroys: 
8d88			;     BC 
8d88			;       if the string is non-empty, BC is HL/10 
8d88			;Size:  24 bytes 
8d88			;Speed: 42+d(104+{0,9}) 
8d88			;       d is the number of digits in the number 
8d88			;       max is 640 cycles for a 5 digit number 
8d88			;Assuming no leading zeros: 
8d88			;1 digit:  146cc 
8d88			;2 digit:  250cc 
8d88			;3 digit:  354cc or 363cc (avg: 354.126cc) 
8d88			;4 digit:  458cc or 467cc (avg: 458.27cc) 
8d88			;5 digit:  562cc or 571cc or 580cc (avg: 562.4104cc) 
8d88			;avg: 544.81158447265625cc (544+13297/16384) 
8d88			;=============================================================== 
8d88 21 00 00		  ld hl,0 
8d8b			.u16a: 
8d8b 1a			  ld a,(de) 
8d8c d6 30		  sub 30h 
8d8e fe 0a		  cp 10 
8d90 d0			  ret nc 
8d91 13			  inc de 
8d92 44			  ld b,h 
8d93 4d			  ld c,l 
8d94 29			  add hl,hl 
8d95 29			  add hl,hl 
8d96 09			  add hl,bc 
8d97 29			  add hl,hl 
8d98 85			  add a,l 
8d99 6f			  ld l,a 
8d9a 30 ef		  jr nc,.u16a 
8d9c 24			  inc h 
8d9d c3 8b 8d		  jp .u16a 
