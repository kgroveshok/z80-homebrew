10a0			; from https://wikiti.brandonw.net/index.php?title=Z80_Routines:Other:DispA 
10a0			 
10a0			; Decimal Unsigned Version 
10a0			 
10a0			;Number in a to decimal ASCII 
10a0			;adapted from 16 bit found in z80 Bits to 8 bit by Galandros 
10a0			;Example: display a=56 as "056" 
10a0			;input: a = number 
10a0			;Output: a=0,value of a in the screen 
10a0			;destroys af,bc (don't know about hl and de) 
10a0			DispAToASCII: 
10a0 0e 9c			ld	c,-100 
10a2 cd ac 10			call	.Na1 
10a5 0e f6			ld	c,-10 
10a7 cd ac 10			call	.Na1 
10aa 0e ff			ld	c,-1 
10ac 06 2f		.Na1:	ld	b,'0'-1 
10ae 04			.Na2:	inc	b 
10af 81				add	a,c 
10b0 38 fc			jr	c,.Na2 
10b2 91				sub	c		;works as add 100/10/1 
10b3 f5				push af		;safer than ld c,a 
10b4 78				ld	a,b		;char is in b 
10b5			;TODO	CALL	PUTCHAR	;plot a char. Replace with bcall(_PutC) or similar. 
10b5 f1				pop af		;safer than ld a,c 
10b6 c9				ret 
10b7			 
10b7			; Decimal Signed Version 
10b7			 
10b7			; DispA 
10b7			; -------------------------------------------------------------- 
10b7			; Converts a signed integer value to a zero-terminated ASCII 
10b7			; string representative of that value (using radix 10). 
10b7			; -------------------------------------------------------------- 
10b7			; INPUTS: 
10b7			;     HL     Value to convert (two's complement integer). 
10b7			;     DE     Base address of string destination. (pointer). 
10b7			; -------------------------------------------------------------- 
10b7			; OUTPUTS: 
10b7			;     None 
10b7			; -------------------------------------------------------------- 
10b7			; REGISTERS/MEMORY DESTROYED 
10b7			; AF HL 
10b7			; -------------------------------------------------------------- 
10b7			 
10b7			;DispHLToASCII: 
10b7			;   push    de 
10b7			;   push    bc 
10b7			; 
10b7			;; Detect sign of HL. 
10b7			;    bit    7, h 
10b7			;    jr     z, ._DoConvert 
10b7			; 
10b7			;; HL is negative. Output '-' to string and negate HL. 
10b7			;    ld     a, '-' 
10b7			;    ld     (de), a 
10b7			;    inc    de 
10b7			; 
10b7			;; Negate HL (using two's complement) 
10b7			;    xor    a 
10b7			;    sub    l 
10b7			;    ld     l, a 
10b7			;    ld     a, 0     ; Note that XOR A or SUB A would disturb CF 
10b7			;    sbc    a, h 
10b7			;    ld     h, a 
10b7			; 
10b7			;; Convert HL to digit characters 
10b7			;._DoConvert: 
10b7			;    ld     b, 0     ; B will count character length of number 
10b7			;-   ld     a, 10 
10b7			;    syscall  .DivHLByA  ; HL = HL / A, A = remainder 
10b7			;    push   af 
10b7			;    inc    b 
10b7			;    ld     a, h 
10b7			;    or     l 
10b7			;    jr     nz, - 
10b7			; 
10b7			;; Retrieve digits from stack 
10b7			;-   pop    af 
10b7			;    or     $30 
10b7			;    ld     (de), a 
10b7			;    inc    de 
10b7			;    djnz   - 
10b7			; 
10b7			;; Terminate string with NULL 
10b7			;    xor    a 
10b7			;    ld     (de), a 
10b7			; 
10b7			;    pop    bc 
10b7			;    pop    de 
10b7			;    ret 
10b7			 
10b7			;Comments 
10b7			; 
10b7			;    This routine uses the common positive-integer radix conversion algorithm of repeatedly dividing a value by the desired radix (base case: the value is zero) and saving the remainders of each division. 
10b7			;    As this algorithm gives the digits in reverse order, they are pushed onto the hardware stack so that subsequently popping them yields the correct order. 
10b7			;    Note that the output string will not be fixed-width. 
10b7			; 
10b7			;Example Usage 
10b7			; 
10b7			;    ld    hl, -1004 
10b7			;    ld    de, OP1 
10b7			;    call  DispA 
10b7			;    ld    hl, OP1 
10b7			;    syscall  PutS 
10b7			 
10b7			 
10b7			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/string_to_uint16.z80 
10b7			 
10b7			 
10b7			;Converts an ASCII string to an unsigned 16-bit integer 
10b7			;Quits when it reaches a non-decimal digit 
10b7			 
10b7			string_to_uint16: 
10b7			atoui_16: 
10b7			;Input: 
10b7			;     DE points to the string 
10b7			;Outputs: 
10b7			;     HL is the result 
10b7			;     A is the 8-bit value of the number 
10b7			;     DE points to the byte after the number 
10b7			;Destroys: 
10b7			;     BC 
10b7			;       if the string is non-empty, BC is HL/10 
10b7			;Size:  24 bytes 
10b7			;Speed: 42+d(104+{0,9}) 
10b7			;       d is the number of digits in the number 
10b7			;       max is 640 cycles for a 5 digit number 
10b7			;Assuming no leading zeros: 
10b7			;1 digit:  146cc 
10b7			;2 digit:  250cc 
10b7			;3 digit:  354cc or 363cc (avg: 354.126cc) 
10b7			;4 digit:  458cc or 467cc (avg: 458.27cc) 
10b7			;5 digit:  562cc or 571cc or 580cc (avg: 562.4104cc) 
10b7			;avg: 544.81158447265625cc (544+13297/16384) 
10b7			;=============================================================== 
10b7 21 00 00		  ld hl,0 
10ba			.u16a: 
10ba 1a			  ld a,(de) 
10bb d6 30		  sub 30h 
10bd fe 0a		  cp 10 
10bf d0			  ret nc 
10c0 13			  inc de 
10c1 44			  ld b,h 
10c2 4d			  ld c,l 
10c3 29			  add hl,hl 
10c4 29			  add hl,hl 
10c5 09			  add hl,bc 
10c6 29			  add hl,hl 
10c7 85			  add a,l 
10c8 6f			  ld l,a 
10c9 30 ef		  jr nc,.u16a 
10cb 24			  inc h 
10cc c3 ba 10		  jp .u16a 
10cf			 
10cf			 
10cf			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/string_to_uint16.z80 
10cf			 
10cf			;written by Zeda 
10cf			;Converts a 16-bit unsigned integer to an ASCII string. 
10cf			 
10cf			uitoa_16: 
10cf			;Input: 
10cf			;   DE is the number to convert 
10cf			;   HL points to where to write the ASCII string (up to 6 bytes needed). 
10cf			;Output: 
10cf			;   HL points to the null-terminated ASCII string 
10cf			;      NOTE: This isn't necessarily the same as the input HL. 
10cf d5			  push de 
10d0 c5			  push bc 
10d1 f5			  push af 
10d2 eb			  ex de,hl 
10d3			 
10d3 01 f0 d8		  ld bc,-10000 
10d6 3e 2f		  ld a,'0'-1 
10d8 3c			  inc a 
10d9 09			  add hl,bc  
10da 38 fc		   jr c,$-2 
10dc 12			  ld (de),a 
10dd 13			  inc de 
10de			 
10de 01 e8 03		  ld bc,1000 
10e1 3e 3a		  ld a,'9'+1 
10e3 3d			  dec a  
10e4 09			  add hl,bc  
10e5 30 fc		   jr nc,$-2 
10e7 12			  ld (de),a 
10e8 13			  inc de 
10e9			 
10e9 01 9c ff		  ld bc,-100 
10ec 3e 2f		  ld a,'0'-1 
10ee 3c			  inc a  
10ef 09			  add hl,bc  
10f0 38 fc		   jr c,$-2 
10f2 12			  ld (de),a 
10f3 13			  inc de 
10f4			 
10f4 7d			  ld a,l 
10f5 26 3a		  ld h,'9'+1 
10f7 25			  dec h  
10f8 c6 0a		  add a,10  
10fa 30 fb		   jr nc,$-3 
10fc c6 30		  add a,'0' 
10fe eb			  ex de,hl 
10ff 72			  ld (hl),d 
1100 23			  inc hl 
1101 77			  ld (hl),a 
1102 23			  inc hl 
1103 36 00		  ld (hl),0 
1105			 
1105			;Now strip the leading zeros 
1105 0e fa		  ld c,-6 
1107 09			  add hl,bc 
1108 3e 30		  ld a,'0' 
110a 23			  inc hl  
110b be			  cp (hl)  
110c 28 fc		  jr z,$-2 
110e			 
110e			;Make sure that the string is non-empty! 
110e 7e			  ld a,(hl) 
110f b7			  or a 
1110 20 01		  jr nz,.atoub 
1112 2b			  dec hl 
1113			.atoub: 
1113			 
1113 f1			  pop af 
1114 c1			  pop bc 
1115 d1			  pop de 
1116 c9			  ret 
1117			 
1117			; from https://github.com/Zeda/Z80-Optimized-Routines/blob/master/conversion/toUpper.z80 
1117			 
1117			toUpper: 
1117			;A is the char. 
1117			;If A is a lowercase letter, this sets it to the matching uppercase 
1117			;18cc or 30cc or 41cc 
1117			;avg: 26.75cc 
1117 fe 61		  cp 'a' 
1119 d8			  ret c 
111a fe 7b		  cp 'z'+1 
111c d0			  ret nc 
111d d6 20		  sub 'a'-'A' 
111f c9			  ret 
