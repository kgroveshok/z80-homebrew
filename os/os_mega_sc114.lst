8a99			addatohl: 
8a99 85			    add   a, l    ; A = A+L 
8a9a 6f			    ld    l, a    ; L = A+L 
8a9b 8c			    adc   a, h    ; A = A+L+H+carry 
8a9c 95			    sub   l       ; A = H+carry 
8a9d 67			    ld    h, a    ; H = H+carry 
8a9e c9			ret 
8a9f			 
8a9f			addatode: 
8a9f 83			    add   a, e    ; A = A+L 
8aa0 5f			    ld    e, a    ; L = A+L 
8aa1 8a			    adc   a, d    ; A = A+L+H+carry 
8aa2 93			    sub   e       ; A = H+carry 
8aa3 57			    ld    d, a    ; H = H+carry 
8aa4 c9			ret 
8aa5			 
8aa5			 
8aa5			addatobc: 
8aa5 81			    add   a, c    ; A = A+L 
8aa6 4f			    ld    c, a    ; L = A+L 
8aa7 88			    adc   a, b    ; A = A+L+H+carry 
8aa8 91			    sub   c       ; A = H+carry 
8aa9 47			    ld    b, a    ; H = H+carry 
8aaa c9			ret 
8aab			 
8aab			subafromhl: 
8aab			   ; If A=0 do nothing 
8aab			    ; Otherwise flip A's sign. Since 
8aab			    ; the upper byte becomes -1, also 
8aab			    ; substract 1 from H. 
8aab ed 44		    neg 
8aad ca b6 8a		    jp    z, Skip 
8ab0 25			    dec   h 
8ab1			     
8ab1			    ; Now add the low byte as usual 
8ab1			    ; Two's complement takes care of 
8ab1			    ; ensuring the result is correct 
8ab1 85			    add   a, l 
8ab2 6f			    ld    l, a 
8ab3 8c			    adc   a, h 
8ab4 95			    sub   l 
8ab5 67			    ld    h, a 
8ab6			Skip: 
8ab6 c9				ret 
8ab7			 
8ab7			 
8ab7			; compare hl and de 
8ab7			; returns:  
8ab7			; if hl = de, z=1, s=0, c0=0 
8ab7			; if hl > de, z=0, s=0, c=0 
8ab7			; if hl < de, z=0, s=1, c=1 
8ab7			cmp16:	 
8ab7 b7				or a 
8ab8 ed 52			sbc hl,de 
8aba e0				ret po 
8abb 7c				ld a,h 
8abc 1f				rra 
8abd ee 40			xor 01000000B 
8abf 37				scf 
8ac0 8f				adc a,a 
8ac1 c9				ret 
8ac2			 
8ac2			 
8ac2			; test if hl contains zero   - A is destroyed 
8ac2			 
8ac2			ishlzero:    
8ac2 b7				or a     ; reset flags 
8ac3 7c				ld a, h 
8ac4 b5				or l        	 
8ac5			 
8ac5 c9				ret 
