8f97			free_found_higher_block: 
8f97			      ; Insert freed block between prev and next free blocks 
8f97 71			      ld    (HL), C                 ; Point prev free block to freed block 
8f98 23			      inc   HL 
8f99 70			      ld    (HL), B 
8f9a			 
8f9a 60			      ld    H, B                    ; Point freed block at next free block 
8f9b 69			      ld    L, C 
8f9c 73			      ld    (HL), E 
8f9d 23			      inc   HL 
8f9e 72			      ld    (HL), D 
8f9f			 
8f9f			      ; Check if the freed block is adjacent to the next free block 
8f9f 23			      inc   HL                      ; Load size of freed block into HL 
8fa0 5e			      ld    E, (HL) 
8fa1 23			      inc   HL 
8fa2 56			      ld    D, (HL) 
8fa3 eb			      ex    DE, HL 
8fa4			 
8fa4 09			      add   HL, BC                  ; Add addr of freed block and its size 
8fa5			 
