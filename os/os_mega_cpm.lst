0bba			; Out: BC = result, HL = rest 
0bba			; 
0bba			Div16: 
0bba 21 00 00		    ld hl,0 
0bbd 78			    ld a,b 
0bbe 06 08		    ld b,8 
0bc0			Div16_Loop1: 
0bc0 17			    rla 
0bc1 ed 6a		    adc hl,hl 
0bc3 ed 52		    sbc hl,de 
0bc5 30 01		    jr nc,Div16_NoAdd1 
0bc7 19			    add hl,de 
0bc8			Div16_NoAdd1: 
0bc8 10 f6		    djnz Div16_Loop1 
0bca 17			    rla 
0bcb 2f			    cpl 
0bcc 47			    ld b,a 
0bcd 79			    ld a,c 
0bce 48			    ld c,b 
0bcf 06 08		    ld b,8 
0bd1			Div16_Loop2: 
0bd1 17			    rla 
0bd2 ed 6a		    adc hl,hl 
0bd4 ed 52		    sbc hl,de 
0bd6 30 01		    jr nc,Div16_NoAdd2 
0bd8 19			    add hl,de 
0bd9			Div16_NoAdd2: 
0bd9 10 f6		    djnz Div16_Loop2 
0bdb 17			    rla 
0bdc 2f			    cpl 
0bdd 41			    ld b,c 
0bde 4f			    ld c,a 
0bdf c9			ret 
