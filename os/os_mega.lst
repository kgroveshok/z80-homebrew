706b			; clock      ce       reset     output  
706b			; 0          x        0         n  
706b			; x          1        0         n  
706b			; x          x        1         q0  
706b			; rising     0        0         n+1  
706b			; falling    x        0         n  
706b			; x          rising   0         n  
706b			; 1          falling  0         x+1  
