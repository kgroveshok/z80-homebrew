0d25			 
0d25			 
0d25			;;;; int maths 
0d25			 
0d25			; https://map.grauw.nl/articles/mult_div_shifts.php 
0d25			; Divide 16-bit values (with 16-bit result) 
0d25			; In: Divide BC by divider DE 
0d25			; Out: BC = result, HL = rest 
0d25			; 
0d25			Div16: 
0d25 21 00 00		    ld hl,0 
0d28 78			    ld a,b 
0d29 06 08		    ld b,8 
0d2b			Div16_Loop1: 
0d2b 17			    rla 
0d2c ed 6a		    adc hl,hl 
0d2e ed 52		    sbc hl,de 
0d30 30 01		    jr nc,Div16_NoAdd1 
0d32 19			    add hl,de 
0d33			Div16_NoAdd1: 
0d33 10 f6		    djnz Div16_Loop1 
0d35 17			    rla 
0d36 2f			    cpl 
0d37 47			    ld b,a 
0d38 79			    ld a,c 
0d39 48			    ld c,b 
0d3a 06 08		    ld b,8 
0d3c			Div16_Loop2: 
0d3c 17			    rla 
0d3d ed 6a		    adc hl,hl 
0d3f ed 52		    sbc hl,de 
0d41 30 01		    jr nc,Div16_NoAdd2 
0d43 19			    add hl,de 
0d44			Div16_NoAdd2: 
0d44 10 f6		    djnz Div16_Loop2 
0d46 17			    rla 
0d47 2f			    cpl 
0d48 41			    ld b,c 
0d49 4f			    ld c,a 
0d4a c9			ret 
0d4b			 
0d4b			 
0d4b			;http://z80-heaven.wikidot.com/math 
0d4b			; 
0d4b			;Inputs: 
0d4b			;     DE and A are factors 
0d4b			;Outputs: 
0d4b			;     A is not changed 
0d4b			;     B is 0 
0d4b			;     C is not changed 
0d4b			;     DE is not changed 
0d4b			;     HL is the product 
0d4b			;Time: 
0d4b			;     342+6x 
0d4b			; 
0d4b			Mult16: 
0d4b			 
0d4b 06 08		     ld b,8          ;7           7 
0d4d 21 00 00		     ld hl,0         ;10         10 
0d50 29			       add hl,hl     ;11*8       88 
0d51 07			       rlca          ;4*8        32 
0d52 30 01		       jr nc,$+3     ;(12|18)*8  96+6x 
0d54 19			         add hl,de   ;--         -- 
0d55 10 f9		       djnz $-5      ;13*7+8     99 
0d57 c9			ret 
0d58			 
0d58			; 
0d58			; Square root of 16-bit value 
0d58			; In:  HL = value 
0d58			; Out:  D = result (rounded down) 
0d58			; 
0d58			;Sqr16: 
0d58			;    ld de,#0040 
0d58			;    ld a,l 
0d58			;    ld l,h 
